function state.slotGuardianProtectionActive()
	-- The Guardian now tracks the CURRENT selected slot for the entire lifetime
	-- of the Hub. A manual Reset-to-Menu is safe because recovery waits 60s and
	-- any newly selected animal replaces the remembered target immediately.
	return state.alive == true
end

function state.slotGuardianMarkPlanned(
	reason,
	seconds
)
	local guardian =
		state.slotGuardian

	if not guardian then
		return
	end

	guardian.plannedUntil =
		math.max(
			guardian.plannedUntil or 0,
			tick()
				+ (
					tonumber(seconds)
						or 20
				)
		)

	guardian.plannedReason =
		reason
			or "script slot transition"

	guardian.missingSince =
		nil

	guardian.pendingDeadCharacter =
		nil

	guardian.pendingDeathAt =
		0

	guardian.pendingDeathReason =
		nil

	guardian.pendingDeathReported =
		false
end

function state.slotGuardianPlannedActive()
	local guardian =
		state.slotGuardian

	return guardian
		and tick()
			< (
				guardian.plannedUntil
					or 0
			)
end

function state.slotGuardianCaptureModes()
	return {
		growExisting =
			state.growExisting == true,

		growExistingAutomaticAll =
			state.growExistingAutomaticAll == true,

		growAllSlots =
			state.growAllSlots == true,

		growNew =
			state.growNew == true,

		autoQuests =
			state.autoQuests == true,

		autoClaimQuests =
			state.autoClaimQuests == true,

		farmCoins =
			state.farmCoins == true,

		coinFarmAllowAutoQuests =
			state.coinFarmAllowAutoQuests == true,

		growthPrideEnabled =
			state.growthPrideEnabled ~= false,
	}
end

function state.slotGuardianRestoreModes(
	snapshot
)
	if type(snapshot)
		~= "table" then
		return
	end

	-- Only restore modes that were ON. Never turn off something the user may
	-- have enabled manually while recovery was running.
	for _, key in ipairs({
		"growExisting",
		"growExistingAutomaticAll",
		"growAllSlots",
		"growNew",
		"autoQuests",
		"autoClaimQuests",
		"farmCoins",
		"coinFarmAllowAutoQuests",
	}) do
		if snapshot[key] == true
			and not (isDinoLife and key == "growAllSlots") then
			state[key] = true
		end
	end

	if snapshot.growthPrideEnabled
		~= nil then

		state.growthPrideEnabled =
			snapshot.growthPrideEnabled
				== true
	end
end

function state.slotGuardianResolveCurrentSlot(
	character,
	records
)
	if not character then
		return nil
	end

	records =
		records
		or savedCharacters()

	local characterName =
		character:GetAttribute(
			"CharacterName"
		)

	local uniqueName =
		character:GetAttribute(
			"UniqueCharacterName"
		)
		or character:GetAttribute(
			"CharacterUniqueName"
		)

	for _, entry in ipairs(
		records
	) do
		if type(entry)
			== "table" then

			local sameCharacter =
				type(characterName)
					== "string"
				and (
					entry.CharacterName
						== characterName
					or entry.UniqueCharacterName
						== characterName
				)

			local sameUnique =
				type(uniqueName)
					== "string"
				and (
					entry.UniqueCharacterName
						== uniqueName
					or entry.CharacterName
						== uniqueName
				)

			if sameCharacter
				or sameUnique then
				return entry
			end
		end
	end

	return nil
end

function state.slotGuardianResolvePlayableSlot(
	character
)
	if not character
		or not character.Parent
		or not character:IsDescendantOf(workspace) then
		return nil
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not root
		or not root:IsDescendantOf(workspace)
		or not humanoid
		or humanoid.Health <= 0 then
		return nil
	end

	-- Menu/preview rigs may still have Humanoid + HRP. A playable animal must
	-- expose the identity/state attributes used everywhere else by the Hub.
	local animalName =
		character:GetAttribute(
			"AnimalName"
		)

	local characterName =
		character:GetAttribute(
			"CharacterName"
		)
		or character:GetAttribute(
			"UniqueCharacterName"
		)
		or character:GetAttribute(
			"CharacterUniqueName"
		)

	if type(animalName) ~= "string"
		or animalName == ""
		or type(characterName) ~= "string"
		or characterName == "" then
		return nil
	end

	return state.slotGuardianResolveCurrentSlot(
		character,
		savedCharacters()
	)
end

function state.slotGuardianRemember(
	character,
	allowDead
)
	local guardian =
		state.slotGuardian

	if not guardian
		or not character
		or not character.Parent then
		return false
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not root
		or not humanoid
		or (
			humanoid.Health <= 0
			and allowDead ~= true
		) then
		return false
	end

	local entry =
		state.slotGuardianResolveCurrentSlot(
			character,
			savedCharacters()
		)

	if not entry then
		return false
	end

	guardian.lastSlot = {
		CharacterName =
			entry.CharacterName,

		UniqueCharacterName =
			entry.UniqueCharacterName,

		AnimalName =
			entry.AnimalName,

		Gender =
			entry.Gender,

		Skin =
			entry.Skin,
	}

	guardian.lastCharacter =
		character

	guardian.lastCharacterName =
		entry.CharacterName
			or character:GetAttribute(
				"CharacterName"
			)

	guardian.lastAnimalName =
		entry.AnimalName
			or character:GetAttribute(
				"AnimalName"
			)

	guardian.lastModes =
		state.slotGuardianCaptureModes()

	return true
end

function state.slotGuardianFindRememberedSlot()
	local guardian =
		state.slotGuardian

	local remembered =
		guardian
		and guardian.lastSlot

	if type(remembered)
		~= "table" then
		return nil
	end

	local records =
		savedCharacters()

	for _, entry in ipairs(
		records
	) do
		if type(entry)
			== "table" then

			local sameUnique =
				type(
					remembered.UniqueCharacterName
				) == "string"
				and remembered.UniqueCharacterName
					~= ""
				and entry.UniqueCharacterName
					== remembered.UniqueCharacterName

			local sameName =
				type(
					remembered.CharacterName
				) == "string"
				and remembered.CharacterName
					~= ""
				and entry.CharacterName
					== remembered.CharacterName

			if sameUnique
				or sameName then
				return entry
			end
		end
	end

	return nil
end

function state.slotGuardianTimestamp()
	local ok,
		value =
			pcall(function()
				return DateTime.now():FormatLocalTime(
					"DD/MM/YYYY HH:mm:ss",
					"pt-br"
				)
			end)

	if ok
		and type(value)
			== "string"
		and value ~= "" then

		return value
	end

	return os.date(
		"%d/%m/%Y %H:%M:%S"
	)
end

function state.slotGuardianRecordDeath(
	character,
	reason
)
	local guardian =
		state.slotGuardian

	if not guardian
		or not state.slotGuardianProtectionActive()
		or state.slotGuardianPlannedActive() then
		return false
	end

	local now =
		tick()

	if guardian.lastDeathCharacter
			== character
		and now
			- (
				guardian.lastDeathAt
					or 0
			) < 8 then

		return false
	end

	guardian.lastDeathCharacter =
		character

	guardian.lastDeathAt =
		now

	local slotName =
		guardian.lastCharacterName

	local animalName =
		guardian.lastAnimalName

	if character then
		slotName =
			character:GetAttribute(
				"CharacterName"
			)
			or slotName

		animalName =
			character:GetAttribute(
				"AnimalName"
			)
			or animalName
	end

	slotName =
		tostring(
			slotName
				or "Unknown slot"
		)

	animalName =
		tostring(
			animalName
				or "Unknown animal"
		)

	local report = {
		slot =
			slotName,

		animal =
			animalName,

		when =
			state.slotGuardianTimestamp(),

		reason =
			reason
				or "Death detected",
	}

	table.insert(
		guardian.deathReports,
		1,
		report
	)

	while #guardian.deathReports
		> (
			guardian.maxReports
				or 30
		) do

		table.remove(
			guardian.deathReports
		)
	end

	guardian.reportVersion += 1

	if state.deathReportUI.render then
		pcall(
			state.deathReportUI.render
		)
	end

	return true
end

function state.slotGuardianPrepareRecovery()
	-- Stop only competing movement transactions. Automation toggles themselves
	-- stay alive; Grow/Quests/AFK are NOT disabled.
	if state.safeMove then
		state.safeMove.cancelToken += 1
	end

	questTravelWanted =
		false

	state.questTravelActive =
		false

	state.questLandInputActive =
		false

	state.questSwimActive =
		false

	state.questSwimReady =
		false

	if state.questSetW then
		pcall(
			state.questSetW,
			false
		)
	end

	state.releaseMovementNow(
		player.Character,
		true
	)

	eatingToFull =
		false

	drinkingToFull =
		false

	clearActiveCarcass(true)

	eatingSourcePosition =
		nil

	drinkingSourcePosition =
		nil

	if state.survivalArbiterReset then
		state.survivalArbiterReset(
			"slot guardian recovery"
		)
	end
end

function state.slotGuardianRecoveryStep()
	local guardian =
		state.slotGuardian

	if not guardian then
		return
	end

	-- Once a loss was armed while protection was active, keep the 60-second
	-- transaction alive even if another automation temporarily changes state
	-- while the game is on the animal menu.
	local pendingRecovery =
		guardian.pendingDeadCharacter ~= nil
			or guardian.missingSince ~= nil
			or guardian.recovering == true

	if not state.slotGuardianProtectionActive()
		and not pendingRecovery then
		return
	end

	local character =
		player.Character

	local root =
		character
		and character:FindFirstChild(
			"HumanoidRootPart"
		)

	local humanoid =
		character
		and character:FindFirstChildOfClass(
			"Humanoid"
		)

	local aliveCharacter =
		character
		and character.Parent
		and character:IsDescendantOf(workspace)
		and root
		and root:IsDescendantOf(workspace)
		and humanoid
		and humanoid.Health > 0

	-- IMPORTANT: a menu/placeholder character can still have a Humanoid +
	-- HumanoidRootPart and Health > 0. It is only considered a selected animal
	-- when it resolves to a real SavedCharacters slot.
	local resolvedLiveSlot =
		aliveCharacter
		and state.slotGuardianResolvePlayableSlot(
			character
		)
		or nil

	local hadPendingMenuLoss =
		guardian.missingSince ~= nil
			or guardian.pendingDeadCharacter ~= nil
			or guardian.recovering == true

	if resolvedLiveSlot then
		-- Humanoid.Died may be followed by the SAME character instance becoming
		-- usable enough to pass ordinary "alive" checks while the menu is still
		-- open. Never let that same instance cancel its own pending recovery.
		local sameDeadInstance =
			guardian.pendingDeadCharacter ~= nil
				and character
					== guardian.pendingDeadCharacter

		if not hadPendingMenuLoss
			or not sameDeadInstance then

			local previousSlotName =
				guardian.lastCharacterName

			guardian.missingSince =
				nil

			guardian.recovering =
				false

			guardian.retryAt =
				0

			guardian.plannedUntil =
				0

			guardian.plannedReason =
				nil

			guardian.pendingDeadCharacter =
				nil

			guardian.pendingDeathAt =
				0

			guardian.pendingDeathReason =
				nil

			guardian.pendingDeathReported =
				false

			local rememberedCurrent =
				state.slotGuardianRemember(
					character
				)

			if hadPendingMenuLoss
				and rememberedCurrent then

				local currentSlotName =
					guardian.lastCharacterName

				if currentSlotName
					and previousSlotName
					and currentSlotName
						~= previousSlotName then

					runtimeMessage =
						"Slot Guardian: new animal selected; now protecting current slot"
				else
					runtimeMessage =
						"Slot Guardian: animal selected; menu recovery cancelled"
				end
			end

			return
		end
	end

	if state.slotGuardianPlannedActive()
		and not pendingRecovery then
		return
	end

	-- A dead/missing character is only a menu-loss candidate here. Do NOT
	-- report or respawn instantly because a deliberate Reset-to-Menu also
	-- fires Humanoid.Died in Savannah Life.
	if guardian.recovering
		or tick()
			< (
				guardian.retryAt
					or 0
			) then
		return
	end

	local startingMenuGrace =
		guardian.missingSince == nil

	guardian.missingSince =
		guardian.missingSince
		or tick()

	if startingMenuGrace then
		runtimeMessage =
			"Slot Guardian: menu detected; waiting 60s before restoring current slot"
	end

	local waitTime =
		math.max(
			60,
			tonumber(
				guardian.menuGraceSeconds
			) or 60
		)

	if tick()
		- guardian.missingSince
		< waitTime then

		return
	end

	-- Only now, after a full minute without choosing any animal, treat a
	-- confirmed Died event as an unexpected death for the report.
	if guardian.pendingDeadCharacter
		and not guardian.pendingDeathReported then

		guardian.pendingDeathReported =
			true

		state.slotGuardianRecordDeath(
			guardian.pendingDeadCharacter,
			guardian.pendingDeathReason
				or "Humanoid died; remained in menu for 60s"
		)
	end

	local target =
		state.slotGuardianFindRememberedSlot()

	if not target then
		guardian.retryAt =
			tick() + 4

		runtimeMessage =
			"Slot Guardian: saved slot not found; retrying"

		return
	end

	local snapshot =
		guardian.lastModes
			or state.slotGuardianCaptureModes()

	-- Preserve the character instance that originally died before
	-- slotGuardianMarkPlanned clears the pending fields.
	local recoveryDeadCharacter =
		guardian.pendingDeadCharacter

	guardian.recovering =
		true

	-- Keep the timestamp until recovery is actually committed. If the user
	-- selects an animal in this small race window, the live-animal branch wins.
	state.slotGuardianMarkPlanned(
		"Slot Guardian same-slot respawn",
		28
	)

	state.slotGuardianPrepareRecovery()

	local targetName =
		tostring(
			target.CharacterName
				or target.UniqueCharacterName
				or "slot"
		)

	local targetAnimal =
		tostring(
			target.AnimalName
				or guardian.lastAnimalName
				or "animal"
		)

	runtimeMessage =
		"Slot Guardian: respawning "
		.. targetName
		.. " ("
		.. targetAnimal
		.. ")"

	questStatusText =
		"Recovering same slot: "
		.. targetName

	task.spawn(function()
		local oldQuestSwitch =
			questSwitchingAnimal

		questSwitchingAnimal =
			true

		local function adoptLiveSelectionIfPresent()
			local liveCharacter =
				player.Character

			local liveHumanoid =
				liveCharacter
				and liveCharacter:FindFirstChildOfClass(
					"Humanoid"
				)

			local liveRoot =
				liveCharacter
				and liveCharacter:FindFirstChild(
					"HumanoidRootPart"
				)

			local resolvedSelection =
				liveCharacter
				and liveCharacter.Parent
				and liveHumanoid
				and liveHumanoid.Health > 0
				and liveRoot
				and liveCharacter
					~= recoveryDeadCharacter
				and state.slotGuardianResolvePlayableSlot(
					liveCharacter
				)

			if resolvedSelection then
				questSwitchingAnimal =
					oldQuestSwitch

				guardian.recovering =
					false

				guardian.retryAt =
					0

				guardian.plannedUntil =
					0

				guardian.plannedReason =
					nil

				guardian.missingSince =
					nil

				guardian.pendingDeadCharacter =
					nil

				guardian.pendingDeathAt =
					0

				guardian.pendingDeathReason =
					nil

				guardian.pendingDeathReported =
					false

				state.slotGuardianRemember(
					liveCharacter
				)

				runtimeMessage =
					"Slot Guardian: player selected an animal; old-slot recovery cancelled"

				return true
			end

			return false
		end

		if adoptLiveSelectionIfPresent() then
			return
		end

		local deadCharacter =
			player.Character

		local deadHumanoid =
			deadCharacter
			and deadCharacter:FindFirstChildOfClass(
				"Humanoid"
			)

		if deadCharacter
			and deadCharacter.Parent
			and deadHumanoid
			and deadHumanoid.Health <= 0
			and ResetRemote then

			state.slotGuardianMarkPlanned(
				"Slot Guardian clearing dead character",
				12
			)

			pcall(
				ResetRemote.InvokeServer,
				ResetRemote
			)

			task.wait(
				1.0
			)
		end

		if adoptLiveSelectionIfPresent() then
			return
		end

		local spawned =
			spawnSlot(
				target,
				true,
				true
			)

		questSwitchingAnimal =
			oldQuestSwitch

		guardian.recovering =
			false

		if spawned then
			guardian.retryAt =
				0

			guardian.plannedUntil =
				0

			guardian.plannedReason =
				nil

			guardian.missingSince =
				nil

			guardian.pendingDeadCharacter =
				nil

			guardian.pendingDeathAt =
				0

			guardian.pendingDeathReason =
				nil

			guardian.pendingDeathReported =
				false

			-- Restore every automation that was active before the loss.
			state.slotGuardianRestoreModes(
				snapshot
			)

			-- Survival ALWAYS comes back after a death/menu recovery.
			state.autoEatManualDisabled =
				false

			state.autoDrinkManualDisabled =
				false

			state.autoEat =
				true

			state.autoDrink =
				true

			eatingToFull =
				false

			drinkingToFull =
				false

			if state.aquaticRiverEscape then
				state.aquaticRiverEscape.busy =
					false

				state.aquaticRiverEscape.retryAt =
					0

				state.aquaticRiverEscape.survivalSuspended =
					false
			end

			state.applySurvivalDefaults(
				false
			)

			state.questForceFastRecheckUntil =
				tick() + 25

			DAMAGE.cooldownUntil =
				math.max(
					DAMAGE.cooldownUntil
						or 0,
					tick() + 3
				)

			local live =
				player.Character

			if live then
				state.releaseMovementNow(
					live,
					true
				)

				state.oxygenGuardApply(
					live
				)

				state.staminaGuardApply(
					live
				)

				if state.questSlotsNormalizeControl then
					state.questSlotsNormalizeControl(
						live
					)
				end

				if state.enforceCrocHippoMainWaterCollision then
					state.enforceCrocHippoMainWaterCollision(
						live
					)
				end

				state.slotGuardianRemember(
					live
				)
			end

			runtimeMessage =
				"Slot Guardian: same slot restored; automations resumed"

			questStatusText =
				state.autoQuests
					and "Auto Quests resumed after slot recovery"
					or (
						state.growExisting
						or state.growAllSlots
						or state.growNew
						or state.growExistingAutomaticAll
					)
						and "Auto Grow resumed after slot recovery"
					or state.farmCoins
						and "AFK Coin resumed after slot recovery"
					or "Slot restored; Survival resumed"

			if renders then
				for _, key in ipairs({
					"autoEat",
					"autoDrink",
					"growExisting",
					"growAllSlots",
					"growNew",
					"autoQuests",
					"autoClaimQuests",
					"farmCoins",
				}) do

					if renders[key] then
						pcall(
							renders[key]
						)
					end
				end
			end
		else
			guardian.retryAt =
				tick() + 4

			guardian.plannedUntil =
				0

			runtimeMessage =
				"Slot Guardian: respawn not confirmed; retrying same slot"
		end
	end)
end

function state.slotGuardianBindCharacter(
	character
)
	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)
		or character:WaitForChild(
			"Humanoid",
			5
		)

	if not humanoid then
		return
	end

	local function rememberBoundCharacter()
		if state.alive
			and character
				== player.Character then

			local guardian =
				state.slotGuardian

			-- The same character instance that fired Humanoid.Died must not clear
			-- its own 60-second menu grace if the game keeps/revives that model
			-- while the animal-selection menu is open.
			if guardian
				and guardian.pendingDeadCharacter
					== character then
				return
			end

			local playableSlot =
				state.slotGuardianResolvePlayableSlot(
					character
				)

			local remembered =
				playableSlot
				and state.slotGuardianRemember(
					character
				)

			if remembered and guardian then
				guardian.missingSince =
					nil

				guardian.recovering =
					false

				guardian.retryAt =
					0

				guardian.plannedUntil =
					0

				guardian.plannedReason =
					nil

				guardian.pendingDeadCharacter =
					nil

				guardian.pendingDeathAt =
					0

				guardian.pendingDeathReason =
					nil

				guardian.pendingDeathReported =
					false
			end
		end
	end

	mmbTaskDelay(
		0.55,
		rememberBoundCharacter
	)

	-- Some executors receive CharacterAdded before SavedCharacters/attributes
	-- finish replicating. Retry once so a manually selected NEW slot becomes
	-- the guardian target instead of leaving the previous slot remembered.
	mmbTaskDelay(
		1.65,
		rememberBoundCharacter
	)

	local diedConnection

	diedConnection =
		humanoid.Died:Connect(function()
			if not state.alive
				or state.slotGuardianPlannedActive()
				or not state.slotGuardianProtectionActive() then
				return
			end

			local guardian =
				state.slotGuardian

			-- Capture the exact slot at the death/reset edge, even if the ordinary
			-- periodic remember pass had not run recently.
			state.slotGuardianRemember(
				character,
				true
			)

			guardian.pendingDeadCharacter =
				character

			guardian.pendingDeathAt =
				tick()

			guardian.pendingDeathReason =
				"Humanoid died"

			guardian.pendingDeathReported =
				false

			-- Dino Life does not need Savannah's 60-second death-report delay.
			-- The delay exists because Savannah can fire Humanoid.Died for an
			-- intentional return to the animal menu. In Dino, waiting that long let
			-- the new Character clear the pending death before the report was ever
			-- created. Record the unexpected death immediately, while the exact
			-- Character/slot information is still available. Script-planned resets
			-- are already filtered at the top of this Died handler.
			if isDinoLife then
				guardian.pendingDeathReported =
					state.slotGuardianRecordDeath(
						character,
						"Humanoid died (Dino Life)"
					) == true
			end

			guardian.missingSince =
				tick()

			runtimeMessage =
				isDinoLife
					and "Slot Guardian: Dino death recorded; waiting for recovery"
					or "Slot Guardian: animal left; waiting 60s for menu selection"
		end)

	table.insert(
		connections,
		diedConnection
	)
end

table.insert(
	connections,
	player.CharacterAdded:Connect(function(
		character
	)
		state.slotGuardianBindCharacter(
			character
		)
	end)
)

if player.Character then
	state.slotGuardianBindCharacter(
		player.Character
	)
end

task.spawn(function()
	while state.alive do
		pcall(
			state.slotGuardianRecoveryStep
		)

		task.wait(
			0.35
		)
	end
end)

local function normalizeQuestBucket(bucket)
	local result = {}
	if type(bucket) ~= "table" then return result end
	for index, entry in pairs(bucket) do
		if type(entry) == "table" and type(entry.QuestUniqueKey) == "string" then
			table.insert(result, {
				index = index,
				data = entry,
			})
		end
	end
	table.sort(result, function(a, b)
		local an, bn = tonumber(a.index), tonumber(b.index)
		if an and bn then return an < bn end
		return tostring(a.index) < tostring(b.index)
	end)
	return result
end

local function getQuestBucket(key)
	local replication = resolveReplication()
	if not replication then return {} end
	local ok, bucket = pcall(replication.GetKeyData, key)
	if not ok or type(bucket) ~= "table" then
		if type(replication.GetData) == "function" then
			local dataOk, allData = pcall(replication.GetData)
			if dataOk and type(allData) == "table" then bucket = allData[key] end
		end
	end
	return normalizeQuestBucket(bucket)
end

local function getAllQuests()
	local result = {}
	for _, spec in ipairs({
		{ category = "Daily", dataKey = "DailyQuests" },
		{ category = "Weekly", dataKey = "WeeklyQuests" },
	}) do
		for _, wrapped in ipairs(getQuestBucket(spec.dataKey)) do
			local entry = wrapped.data
			local storageBucket = QuestsStorage and QuestsStorage[spec.dataKey]
			local props = storageBucket and storageBucket[entry.QuestUniqueKey]
			if props then
				local id = spec.category .. "|" .. entry.QuestUniqueKey
				if not questSessionClaimed[id] then
					table.insert(result, {
						id = id,
						category = spec.category,
						dataKey = spec.dataKey,
						entry = entry,
						props = props,
					})
				end
			end
		end
	end
	return result
end


