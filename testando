function CROC.getAnimalName(character)
	local model = workspace:FindFirstChild(player.Name)
	local target = (model and model:IsA("Model") and model) or character or player.Character
	if not target then return nil end

	local animal = target:GetAttribute("AnimalName")
	if type(animal) == "string" and animal ~= "" then return animal end

	local valueObject = target:FindFirstChild("AnimalName")
	if valueObject and valueObject:IsA("StringValue") and valueObject.Value ~= "" then
		return valueObject.Value
	end
	return nil
end

local function isGiraffeCharacter(character)
	local animal = CROC.getAnimalName(character)
	return type(animal) == "string"
		and animal:lower() == "giraffe"
end


local function isBaboonCharacter(character)
	local animal = CROC.getAnimalName(character)
	return type(animal) == "string"
		and animal:lower() == "baboon"
end


function CROC.isCharacter(character)
	local animal = CROC.getAnimalName(character)
	return type(animal) == "string" and animal:lower():find("croc", 1, true) ~= nil
end

local function isAquaticCharacter(character)
	local animal = CROC.getAnimalName(character)
	return type(animal) == "string" and AQUATIC_ANIMALS[animal:lower()] == true
end

local function setAquaticWaterCollision(character, enabled)
	if not isAquaticCharacter(character) then return end

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	if waterPart and waterPart:IsA("BasePart") then
		waterPart.CanCollide = enabled == true
	end
end

-- Lê o AnimalClass direto do model do jogador na workspace (acha pelo nome
-- do jogador, sempre na hora — nunca cacheia, então funciona certinho
-- mesmo depois de trocar de animal). É a fonte mais confiável de dieta:
-- "Herbivore" come grama, "Carnivore" come carcaça.
local function getAnimalClass(character)
	local model = workspace:FindFirstChild(player.Name)
	local target = (model and model:IsA("Model") and model) or character
	if not target then return nil end
	local class = target:GetAttribute("AnimalClass")
	if type(class) == "string" and class ~= "" then return class end
	return nil
end

function state.questCurrentZoneName()
	local zone = player:GetAttribute("ZoneName")
	if type(zone) == "string" and zone ~= "" then return zone end

	local value = player:FindFirstChild("ZoneName")
	if value and value:IsA("StringValue") and value.Value ~= "" then
		return value.Value
	end

	local character = player.Character or workspace:FindFirstChild(player.Name)
	if character then
		zone = character:GetAttribute("ZoneName")
		if type(zone) == "string" and zone ~= "" then return zone end

		value = character:FindFirstChild("ZoneName")
		if value and value:IsA("StringValue") and value.Value ~= "" then
			return value.Value
		end
	end
end

function state.questRememberZoneBeforeFeeding(reason)
	if not state.autoQuests or state.questReturnZone.name then return end

	local zone = state.questCurrentZoneName()
	if type(zone) ~= "string" or zone == "" then return end

	state.questReturnZone.name = zone
	state.questReturnZone.reason = reason or "feeding"
	state.questReturnZone.capturedAt = tick()
	state.questReturnZone.lastMoveAt = 0
end

function state.questClearReturnZone()
	state.questReturnZone.name = nil
