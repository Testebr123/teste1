state.createAutoDrinkModeButton = function(
	mode,
	titleText,
	descriptionText,
	order,
	height,
	warning
)
	local button =
		Instance.new(
			"TextButton"
		)

	button.Size =
		UDim2.new(
			1,
			0,
			0,
			height
		)

	button.LayoutOrder = order
	button.BackgroundColor3 = COLOR_CARD
	button.BorderSizePixel = 0
	button.Text = ""
	button.AutoButtonColor = false
	button.ClipsDescendants = true
	button.Parent =
		tabContents.Survival

	corner(button, 12)

	local buttonStroke =
		stroke(
			button,
			Color3.fromRGB(
				48,
				24,
				42
			),
			1
		)

	local radio =
		Instance.new(
			"TextLabel"
		)

	radio.Size =
		UDim2.fromOffset(
			28,
			28
		)

	radio.Position =
		UDim2.new(
			1,
			-40,
			0,
			10
		)

	radio.BackgroundTransparency = 1
	radio.Font =
		Enum.Font.GothamBold
	radio.Text = "○"
	radio.TextSize = 20
	radio.TextColor3 = COLOR_SUBTEXT
	radio.Parent = button

	local title =
		Instance.new(
			"TextLabel"
		)

	title.Size =
		UDim2.new(
			1,
			-58,
			0,
			24
		)

	title.Position =
		UDim2.fromOffset(
			14,
			8
		)

	title.BackgroundTransparency = 1
	title.Font = FONT_BUTTON
	title.Text = titleText
	title.TextSize =
		UserInputService.TouchEnabled
			and 11
			or 12
	title.TextColor3 = COLOR_TEXT
	title.TextXAlignment =
		Enum.TextXAlignment.Left
	title.TextYAlignment =
		Enum.TextYAlignment.Center
	title.TextWrapped = true
	title.Parent = button

	local description =
		Instance.new(
			"TextLabel"
		)

	description.Size =
		UDim2.new(
			1,
			-28,
			1,
			-38
		)

	description.Position =
		UDim2.fromOffset(
			14,
			34
		)

	description.BackgroundTransparency = 1
	description.Font = FONT_BODY
	description.Text = descriptionText
	description.TextSize =
		UserInputService.TouchEnabled
			and 9
			or 10
	description.TextColor3 =
		warning
			and Color3.fromRGB(
				220,
				153,
				187
			)
			or COLOR_SUBTEXT
	description.TextXAlignment =
		Enum.TextXAlignment.Left
	description.TextYAlignment =
		Enum.TextYAlignment.Top
	description.TextWrapped = true
	description.Parent = button

	state.autoDrinkModeButtons[mode] = {
		button = button,
		stroke = buttonStroke,
		title = title,
		description = description,
		radio = radio,
	}

	button.MouseEnter:Connect(function()
		if state.autoDrinkMode ~= mode then
			button.BackgroundColor3 =
				Color3.fromRGB(
					38,
					20,
					34
				)
		end
	end)

	button.MouseLeave:Connect(function()
		state.renderAutoDrinkModeButtons()
	end)

	button.Activated:Connect(function()
		if mode == "underground" and CROC.isCharacter(player.Character) then
			state.autoDrinkPreferredMode = "surface"
			state.autoDrinkMode = "surface"
			runtimeMessage = "Underground Drink is unavailable for Crocodile"
			state.renderAutoDrinkModeButtons()
			return
		end

		local overrideActive =
			state.questZoneDrinkOverride
				and state.questZoneDrinkOverride.active

		-- Always remember what the PLAYER wants.
		state.autoDrinkPreferredMode = mode
		state.drinkTest.retryAfter = 0

		if overrideActive then
			state.autoDrinkMode = "underground"

			if mode == "surface" then
				runtimeMessage =
					"Surface Water preference saved; Survive in Zone still forces Underground Drink"
			else
				runtimeMessage =
					"Underground Drink preference saved"
			end

			state.renderAutoDrinkModeButtons()
			return
		end

		if state.autoDrinkMode == mode then
			state.renderAutoDrinkModeButtons()
			return
		end

		state.autoDrinkMode = mode

		if state.safeMove
			and state.safeMove.active
			and state.safeMove.reason == "water" then
			state.safeMove.cancelToken += 1
		end

		if mode == "surface" then
			if state.drinkTest.active then
				state.drinkTest.cancelRequested = true
				runtimeMessage =
					"Surface Water mode selected; exiting Underground Drink vertically"
			else
				state.drinkClearUndergroundMode()
				runtimeMessage =
					"Auto Drink mode: puddles and rivers"
			end
		else
			state.drinkSearch.currentWaterPoint = nil
			state.drinkSearch.failedCount = 0
			state.drinkSearch.retryAfter = 0
			state.drinkProgressReset()
			runtimeMessage =
				"Auto Drink mode: below Terrain"
		end

		state.renderAutoDrinkModeButtons()
	end)

	return button
end

