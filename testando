function state.drinkTestGhostCharacter(character, enabled)
	local test = state.drinkTest

	if enabled then
		if test.collisionSnapshot then
			-- Reassert clipping even if Roblox or another controller changed a
			-- character part after the original snapshot was captured.
			for _, object in ipairs(
				character:GetDescendants()
			) do
				if object:IsA("BasePart")
					and object.CanCollide then
					object.CanCollide = false
				end
			end

			return true
		end

		local snapshot = {}

		for _, object in ipairs(
			character:GetDescendants()
		) do
			if object:IsA("BasePart") then
				snapshot[#snapshot + 1] = {
					part = object,
					canCollide = object.CanCollide,
				}

				-- Only clipping mechanism used by this test.
				-- Position is still changed only by SafeMove/velocity.
				object.CanCollide = false
			end
		end

		test.collisionSnapshot = snapshot
		return #snapshot > 0
	end

	local snapshot =
		test.collisionSnapshot

	if snapshot then
		for _, record in ipairs(snapshot) do
			local part = record.part

			if part and part.Parent then
				pcall(function()
					part.CanCollide =
						record.canCollide == true
				end)
			end
		end
	end

	test.collisionSnapshot = nil
	return true
end

function state.drinkTestSetTransitPhysics(
	character,
	humanoid,
	enabled
)
	local test = state.drinkTest

	if not character or not humanoid then
		return false
	end

	if enabled then
		local root = character:FindFirstChild("HumanoidRootPart")

		if not test.humanoidSnapshot then
			local freefallEnabled
			local fallingDownEnabled
			local ragdollEnabled

			pcall(function()
				freefallEnabled = humanoid:GetStateEnabled(
					Enum.HumanoidStateType.Freefall
				)
				fallingDownEnabled = humanoid:GetStateEnabled(
					Enum.HumanoidStateType.FallingDown
				)
				ragdollEnabled = humanoid:GetStateEnabled(
					Enum.HumanoidStateType.Ragdoll
				)
			end)

			test.humanoidSnapshot = {
				platformStand = humanoid.PlatformStand,
				autoRotate = humanoid.AutoRotate,
				sit = humanoid.Sit,
				movementDisabled = character:GetAttribute(
					"MovementDisabled"
				),
				freefallEnabled = freefallEnabled,
				fallingDownEnabled = fallingDownEnabled,
				ragdollEnabled = ragdollEnabled,
			}
		end

		-- Underground Drink must NEVER use Physics, PlatformStand OR Anchored.
		-- Anchoring can stop Savannah from accepting Eating/Drinking. Keep the
		-- assembly live, disable ragdoll/fall states, and pin CFrame every frame.
		pcall(function()
			humanoid:SetStateEnabled(
				Enum.HumanoidStateType.Freefall,
				false
			)
			humanoid:SetStateEnabled(
				Enum.HumanoidStateType.FallingDown,
				false
			)
			humanoid:SetStateEnabled(
				Enum.HumanoidStateType.Ragdoll,
				false
			)
			humanoid.PlatformStand = false
			humanoid.Sit = false
			humanoid.AutoRotate = false

			local currentState = humanoid:GetState()
			if currentState == Enum.HumanoidStateType.Physics
				or currentState == Enum.HumanoidStateType.Ragdoll
				or currentState == Enum.HumanoidStateType.FallingDown
				or currentState == Enum.HumanoidStateType.Freefall then

				humanoid:ChangeState(
					Enum.HumanoidStateType.GettingUp
				)
			end
		end)

		if root then
			pcall(function()
				root.Anchored = false
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
			end)
		end

		character:SetAttribute(
			"MovementDisabled",
			true
		)

		return true
	end

	local snapshot =
		test.humanoidSnapshot

	if snapshot then
		local root = character:FindFirstChild("HumanoidRootPart")

		-- Underground Drink never anchors the character. Keep it unanchored on
		-- restore as well; the surface exit already places it at supported height.
		if root then
			pcall(function()
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
				root.Anchored = false
			end)
		end

		pcall(function()
			if snapshot.freefallEnabled ~= nil then
				humanoid:SetStateEnabled(
					Enum.HumanoidStateType.Freefall,
					snapshot.freefallEnabled == true
				)
			end

			if snapshot.fallingDownEnabled ~= nil then
				humanoid:SetStateEnabled(
					Enum.HumanoidStateType.FallingDown,
					snapshot.fallingDownEnabled == true
				)
			end

			if snapshot.ragdollEnabled ~= nil then
				humanoid:SetStateEnabled(
					Enum.HumanoidStateType.Ragdoll,
					snapshot.ragdollEnabled == true
				)
			end

			humanoid.PlatformStand = snapshot.platformStand == true
			humanoid.Sit = snapshot.sit == true
			humanoid.AutoRotate = snapshot.autoRotate ~= false
			humanoid:ChangeState(
				Enum.HumanoidStateType.GettingUp
			)
		end)

		if snapshot.movementDisabled == nil then
			character:SetAttribute(
				"MovementDisabled",
				false
			)
		else
			character:SetAttribute(
				"MovementDisabled",
				snapshot.movementDisabled
			)
		end
	else
		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			pcall(function()
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
				root.Anchored = false
			end)
		end

		pcall(function()
			humanoid:SetStateEnabled(
				Enum.HumanoidStateType.Freefall,
				true
			)
			humanoid:SetStateEnabled(
				Enum.HumanoidStateType.FallingDown,
				true
			)
			humanoid:SetStateEnabled(
				Enum.HumanoidStateType.Ragdoll,
				true
			)
			humanoid.PlatformStand = false
			humanoid.Sit = false
			humanoid.AutoRotate = true
			humanoid:ChangeState(
				Enum.HumanoidStateType.GettingUp
			)
		end)

		character:SetAttribute(
			"MovementDisabled",
			false
		)
	end

	test.humanoidSnapshot = nil
	return true
end

function state.drinkTestMaintainTransit(
	character,
	root,
	humanoid
)
	if not character
		or not root
		or not humanoid then
		return false
	end

	for _, object in ipairs(
		character:GetDescendants()
	) do
		if object:IsA("BasePart")
			and object.CanCollide then
			object.CanCollide = false
		end
	end

	state.drinkTestSetTransitPhysics(
		character,
		humanoid,
		true
	)

	-- Reassert an upright LIVE assembly. Position locking is done by CFrame/PivotTo
	-- every frame; never Anchor because Savannah can reject Drinking/Eating then.
	pcall(function()
		root.Anchored = false
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		humanoid.PlatformStand = false
		humanoid.Sit = false

		local currentState = humanoid:GetState()
		if currentState == Enum.HumanoidStateType.Physics
			or currentState == Enum.HumanoidStateType.Ragdoll
			or currentState == Enum.HumanoidStateType.FallingDown
			or currentState == Enum.HumanoidStateType.Freefall then

			humanoid:ChangeState(
				Enum.HumanoidStateType.GettingUp
			)
		end
	end)

	return true
end

function state.drinkTestSmoothMove(
	targetPosition,
	label,
	ignoreCancel,
	maxDuration
)
	local test = state.drinkTest

	if typeof(targetPosition) ~= "Vector3" then
		return false, "invalid_target"
	end

	local character, root, humanoid =
		characterParts()

	if not character
		or character ~= test.character
		or not root
		or not humanoid
		or humanoid.Health <= 0 then
		return false, "character"
	end

	if not state.drinkTestGhostCharacter(character, true) then
		return false, "collision"
	end

	state.drinkTestMaintainTransit(character, root, humanoid)

	if state.questSetW then
		pcall(state.questSetW, false)
	end

	local startRootCFrame = root.CFrame
	local goalRootCFrame =
		CFrame.new(targetPosition)
		* startRootCFrame.Rotation

	-- Preserve the complete rig relative to HRP. Moving only HRP can visually
	-- compress large custom rigs against Terrain; PivotTo translates the whole
	-- animal as one assembly while collision is disabled.
	local rootToPivot
	pcall(function()
		rootToPivot =
			startRootCFrame:ToObjectSpace(
				character:GetPivot()
			)
	end)

	local function placeWholeRig(desiredRootCFrame)
		if not character.Parent or not root.Parent then
			return false
		end

		state.drinkTestGhostCharacter(character, true)
		state.drinkTestMaintainTransit(character, root, humanoid)

		local placed = false
		if rootToPivot then
			placed = pcall(function()
				character:PivotTo(
					desiredRootCFrame * rootToPivot
				)
			end)
		end

		if not placed then
			pcall(function()
				root.CFrame = desiredRootCFrame
			end)
		end

		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		return true
	end

	local distance =
		(targetPosition - root.Position).Magnitude

	local transitSpeed =
		math.max(
			260,
			state.safeMovementSpeed(character) * 5
		)

	local duration
	if label == "descent" then
		-- Crossing Terrain must be decisive. A long interpolation lets the game
		-- controller keep pushing a huge animal back onto the surface.
		duration = math.clamp(
			distance / transitSpeed,
			0.05,
			0.18
		)
	else
		duration = math.clamp(
			distance / transitSpeed,
			0.06,
			0.32
		)
	end

	if tonumber(maxDuration) then
		duration = math.min(duration, math.max(0.05, tonumber(maxDuration)))
	end

	local startedAt = tick()
	local lastActualPosition = root.Position
	local lastActualProgressAt = tick()
	local lastDistance = distance

	while state.alive
		and character.Parent
		and root.Parent
		and humanoid.Parent
		and humanoid.Health > 0 do

		if test.cancelRequested and not ignoreCancel then
			return false, "cancel"
		end

		local abort =
			state.drinkTestTransitAbortReason(
				character,
				root,
				humanoid
			)

		if abort
			and not (ignoreCancel and abort == "cancel") then
			return false, abort
		end

		local alpha =
			math.clamp(
				(tick() - startedAt) / duration,
				0,
				1
			)

		local desired =
			startRootCFrame:Lerp(
				goalRootCFrame,
				alpha
			)

		if not placeWholeRig(desired) then
			return false, "character"
		end

		local actualDistance =
			(targetPosition - root.Position).Magnitude

		if actualDistance < lastDistance - 0.35 then
			lastDistance = actualDistance
			lastActualProgressAt = tick()
			lastActualPosition = root.Position
		elseif (root.Position - lastActualPosition).Magnitude >= 0.75 then
			lastActualPosition = root.Position
			lastActualProgressAt = tick()
		end

		if tick() - lastActualProgressAt >= 1.25 then
			break
		end

		if alpha >= 1 then
			break
		end

		RunService.Heartbeat:Wait()
	end

	-- Endpoint authority: reassert the entire rig for several frames. This is
	-- important for Elephant because its custom controller may correct one frame
	-- back toward the Terrain surface.
	for _ = 1, 12 do
		if not character.Parent or not root.Parent or not humanoid.Parent then
			break
		end
		placeWholeRig(goalRootCFrame)
		RunService.Heartbeat:Wait()
	end

	local finalDistance =
		root.Parent
		and (root.Position - targetPosition).Magnitude
		or math.huge

	if finalDistance > 4 then
		-- One final hard reassertion before declaring failure. Never remain half
		-- embedded at the Terrain surface.
		for _ = 1, 10 do
			if not placeWholeRig(goalRootCFrame) then break end
			RunService.Heartbeat:Wait()
		end
		finalDistance =
			root.Parent
			and (root.Position - targetPosition).Magnitude
			or math.huge
	end

	if finalDistance > 4 then
		return false,
			string.format(
				"whole_rig_final_distance_%.1f",
				finalDistance
			)
	end

	return true, "arrived"
end

function state.drinkTestFindLocalSpot(origin, character)
	if not isSavannahLife
		or typeof(origin) ~= "Vector3"
		or not character then
		return nil
	end

	local waterPart =
		workspace:FindFirstChild(
			"MainWaterPart"
		)

	if not waterPart
		or not waterPart:IsA("BasePart") then
		return nil
	end

	local waterY =
		waterPart.Position.Y
		+ waterPart.Size.Y * 0.5

	if waterY <= config.dangerY + 8 then
		return nil
	end

	local _, root, humanoid =
		characterParts()

	local lift =
		humanoid
			and math.max(
				humanoid.HipHeight,
				1.5
			)
			or 2.5

	local head =
		character:FindFirstChild(
			"Head"
		)

	local headOffset =
		root
			and head
			and math.max(
				0,
				head.Position.Y - root.Position.Y
			)
			or 0

	local bodyHeight =
		state.movementBodySize(
			character
		).Y

	-- Drinking is decided around the animal's interaction/head height, not by
	-- forcing the HRP to a generic body-depth. For Elephant the head can be many
	-- studs above HRP, so HRP must cross Terrain decisively until the head is
	-- actually a few studs inside MainWaterPart.
	local interactionOffset =
		headOffset > 0.5
			and headOffset
			or math.max(
				lift,
				bodyHeight * 0.18
			)

	local submergeDepth =
		math.clamp(
			waterPart.Size.Y * 0.18,
			1.75,
			3.5
		)

	local desiredInteractionY =
		waterY - submergeDepth

	local undergroundStandY =
		math.max(
			desiredInteractionY - interactionOffset,
			config.dangerY + 16
		)

	-- Collision is disabled during the transaction, so large HipHeight must NOT
	-- increase the required Terrain cover. That old rule rejected the local point
	-- for adult Elephant and made the controller appear to press into the floor.
	local minimumCover = 6
	local maximumCover = 110
	local angleOffset =
		(player.UserId % 360)
		* math.pi / 180

	local best
	local bestScore = math.huge

	for radius = 0, 160, 10 do
		local samples =
			radius == 0 and 1
			or radius <= 60 and 16
			or 20

		for index = 0, samples - 1 do
			local angle =
				angleOffset
				+ index / samples
					* math.pi * 2

			local x =
				origin.X
				+ math.cos(angle)
					* radius

			local z =
				origin.Z
				+ math.sin(angle)
					* radius

			if state.drinkMainWaterContainsXZ(
				waterPart,
				x,
				z
			) then
				local castY =
					math.max(
						origin.Y,
						waterY
					) + 500

				local surfaceHit =
					state.drinkSolidTerrainHit(
						x,
						z,
						castY
					)

				if surfaceHit then
					local cover =
						surfaceHit.Position.Y
						- waterY

					if cover >= minimumCover
						and cover <= maximumCover
						and undergroundStandY
							>= config.dangerY + 12 then

						-- Favor local X/Z strongly; cover depth is secondary.
						local score =
							radius
							+ cover * 0.12

						if score < bestScore then
							bestScore = score

							best = {
								water =
									Vector3.new(
										x,
										waterY,
										z
									),

								-- Stable current-body depth; no shoreline micro-adjust loop.
								stand =
									Vector3.new(
										x,
										undergroundStandY,
										z
									),

								surfaceHit =
									surfaceHit.Position,

								exit =
									Vector3.new(
										x,
										surfaceHit.Position.Y
											+ lift
											+ 7,
										z
									),

								coverDepth = cover,
								radius = radius,
								waterPart = waterPart,
							}
						end
					end
				end
			end
		end

		-- Prefer the current locality aggressively. Direct vertical descent at the
		-- same/near XZ is safer than a diagonal underground translation.
		if best and radius <= 20 then
			break
		end
	end

	return best
end

function state.drinkTestAboveTerrainConfirmed()
	local test = state.drinkTest
	local character, root =
		characterParts()

	if not character or not root then
		return false
	end

	if root.Position.Y < config.dangerY then
		return false
	end

	if state.drinkIsBuriedUnderTerrain(
		root
	) then
		return false
	end

	if test.surfaceY
		and root.Position.Y
			< test.surfaceY + 1.5 then
		return false
	end

	return true
end

function state.drinkTestTransitAbortReason(
	character,
	root,
	humanoid
)
	local test = state.drinkTest

	if test.cancelRequested then
		return "cancel"
	end

	if not character
		or character ~= test.character
		or not root
		or not humanoid
		or humanoid.Health <= 0 then
		return "character"
	end

	if root.Position.Y
		< config.dangerY + 4 then
		return "void"
	end

	local startHealth =
		tonumber(test.startHealth)
		or humanoid.Health

	local maxHealth =
		math.max(
			humanoid.MaxHealth,
			1
		)

	if startHealth - humanoid.Health
		>= maxHealth * 0.025 then
		return "health"
	end

	return nil
end


local function escapeDinoToSafety(label)
	label = label or "solo seguro"

	-- REGRA ABSOLUTA: o AquaticNestRock é EXCLUSIVO do watchdog de void.
	-- Se o personagem não estiver abaixo do dangerY, essa função não faz nada.
	local _, root = characterParts()
	if not root or root.Position.Y >= config.dangerY then
		return false
	end

	runtimeMessage = "VOID detectado; usando rota AquaticNestRock"

	local aquatic = findAquaticNestRock()
	if aquatic then
		ensureOnSolidGround(aquatic.Position, "AquaticNestRock (saindo do void)")
	end

	local nestRock1 = findNestRock1()
	if nestRock1 then
		return ensureOnSolidGround(nestRock1.Position, "NestRock1")
	end

	if not aquatic then
		runtimeMessage = "Void: nem AquaticNestRock nem NestRock1 encontrados"
	end
	return aquatic ~= nil
end


function DAMAGE.modeName()
	if state.growExisting then return "Grow Existing Slots" end
	if state.growNew then return "Grow New Slots" end
	if state.farmCoins then return "AFK Coin Farm" end
	return "modo atual"
end

function DAMAGE.isSafeSpawn(part)
	if not part or not part:IsA("BasePart") or not part.Parent then return false end

	local name = part.Name:lower()
	if name:find("aquatic", 1, true)
		or name:find("water", 1, true)
		or name:find("ocean", 1, true)
		or name:find("river", 1, true)
		or name:find("priderock", 1, true) then
		-- Pride Rock is a Growth/slot-staging destination, not a watchdog escape.
		return false
	end

	return true
end

function DAMAGE.getNearestSafeSpawns(root, maxDistance)
	refreshCompletionSpawns()

	maxDistance = tonumber(maxDistance)
		or DAMAGE.maxEmergencySpawnDistance
		or 380

	local candidates = {}
	for _, part in ipairs(completionSpawnParts) do
		if DAMAGE.isSafeSpawn(part) then
			local distance =
				(part.Position - root.Position).Magnitude

			if distance <= maxDistance then
				table.insert(candidates, part)
			end
		end
	end

	table.sort(candidates, function(a, b)
		return (a.Position - root.Position).Magnitude
			< (b.Position - root.Position).Magnitude
	end)

	return candidates
end

function DAMAGE.tryLocalDryEscape(character, root, label)
	if not character or not root then return false end

	local localExit =
		state.findNearestDryWaterExit
		and state.findNearestDryWaterExit(root)

	if not localExit then
		localExit = findSafeTerrainSpot(
			root.Position,
			18,
			DAMAGE.localEscapeRadius or 170
		)
	end

	if not localExit then
		return false
	end

	local flatDistance = Vector3.new(
		localExit.X - root.Position.X,
		0,
		localExit.Z - root.Position.Z
	).Magnitude

	if flatDistance > (DAMAGE.localEscapeRadius or 170) then
		return false
	end

	local buried =
		root.Position.Y < config.dangerY
		or (
			not isDinoLife
			and state.drinkIsBuriedUnderTerrain(root)
		)

	local startsInWater = isStandingInWater(root)

	runtimeMessage = label
		or string.format(
			"Watchdog: local dry escape (%.0f studs)",
			flatDistance
		)

	local moved = safeMoveToPosition(
		localExit,
		7,
		nil,
		{
			purpose = "safety",
			tolerance = 14,
			vertical = buried,
			forceMoveToLand = not buried,
			constantSpeed = not buried,
			-- Water/void escape may finish on the first verified dry patch. A damage
			-- watchdog that already started on land must actually walk away instead.
			stopOnDryGround = startsInWater or buried,
			maxDuration = 180,
		}
	)

	task.wait(0.18)

	local liveCharacter, liveRoot = characterParts()
	return moved == true
		and liveCharacter ~= nil
		and liveRoot ~= nil
		and liveRoot.Position.Y >= config.dangerY
		and not isStandingInWater(liveRoot)
		and (
			isDinoLife
			or not state.drinkIsBuriedUnderTerrain(liveRoot)
		)
end

function DAMAGE.moveToSafety()
	local character, root = characterParts()
	if not character or not root then return false, nil end

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	if waterPart and waterPart:IsA("BasePart") then
		waterPart.CanCollide = isAquaticCharacter(character)
	end

	if isAquaticCharacter(
		character
	) and state.moveAquaticToDryTerrain then

		local aquaticEscaped =
			state.moveAquaticToDryTerrain(
				character,
				root
			)

		if aquaticEscaped then
			setAquaticWaterCollision(
				character,
				false
			)

			state.releaseMovementNow(
				character,
				true
			)

			return true, nil
		end
	end

	-- Local Terrain is always preferred. Do not walk to a spawn when a dry
	-- patch is available beside the animal.
	if DAMAGE.tryLocalDryEscape(
		character,
		root,
		"Watchdog: escaping to nearby dry Terrain"
	) then
		if isAquaticCharacter(character) then
			setAquaticWaterCollision(character, false)
		end
		state.releaseMovementNow(character, true)
		return true, nil
	end

	local candidates = DAMAGE.getNearestSafeSpawns(
		root,
		DAMAGE.maxEmergencySpawnDistance
	)
	for _, spawnPart in ipairs(candidates) do
		runtimeMessage = "Watchdog: fugindo para " .. spawnPart.Name

		local _, routeRoot = characterParts()
		local buried =
			routeRoot
			and (
				routeRoot.Position.Y < config.dangerY
				or (
					not isDinoLife
					and state.drinkIsBuriedUnderTerrain(routeRoot)
				)
			)
			or false

		local ok = safeMoveToPosition(
			spawnPart.Position,
			7,
			nil,
			{
				purpose = "safety",
				tolerance = 20,
				vertical = buried,
				forceMoveToLand = not buried,
				constantSpeed = not buried,
				maxDuration = 300,
			}
		)
		task.wait(0.25)

		local _, newRoot = characterParts()
		if ok
			and newRoot
			and not isStandingInWater(
				newRoot
			) then

			if isAquaticCharacter(
				character
			) then
				setAquaticWaterCollision(
					character,
					false
				)
			end

			state.releaseMovementNow(
				character,
				true
			)

			return true, spawnPart
		end
	end

	-- No global farm/Pride fallback here. If nearby spawns fail, retry local Terrain.

	local retryCharacter, retryRoot = characterParts()
	if retryCharacter and retryRoot
		and DAMAGE.tryLocalDryEscape(
			retryCharacter,
			retryRoot,
			"Watchdog: retrying local Terrain instead of crossing the map"
		) then
		state.releaseMovementNow(retryCharacter, true)
		return true, nil
	end

	return false, nil
end

function DAMAGE.recover(character, humanoid, healthBefore, healthAfter, reason, forceMinimumWait)
	if state.questGrowthReset.exclusive then return end
	if DAMAGE.active or tick() < DAMAGE.cooldownUntil then return end
	if character ~= player.Character or not humanoid.Parent or humanoid.Health <= 0 then return end

	DAMAGE.active = true

	local previousCriticalRecovery = criticalRecoveryActive
	local previousMode = DAMAGE.modeName()

	criticalRecoveryActive = true

	-- IMPORTANT: watchdog recovery must NEVER change the user's Survival toggles.
	-- DAMAGE.active + criticalRecoveryActive already pause competing Auto Eat /
	-- Auto Drink / quest movement controllers while the escape is running.
	-- Keeping the toggles untouched means they resume automatically when the
	-- recovery lock ends instead of being accidentally restored as false.
	removeSwimBarrier()
	drinkingToFull = false
	eatingToFull = false
	activeCarcass = nil
	state.questBaboonFeeding = false
	state.questGiraffeFeeding = false
	BABOON.cancel()
	GIRAFFE.cancel()
	drinkingSourcePosition = nil

	if renders then
		if renders.autoEat then renders.autoEat() end
		if renders.autoDrink then renders.autoDrink() end
	end

	local maxHealth = math.max(humanoid.MaxHealth, 1)
	local lostPercent = math.max(0, math.floor(((healthBefore - healthAfter) / maxHealth) * 100 + 0.5))

	if reason == "critical" then
		runtimeMessage = string.format(
			"Watchdog CRITICO: vida em %d%%; fugindo agora",
			math.floor((healthAfter / maxHealth) * 100)
		)
	elseif reason == "slow" then
		runtimeMessage = string.format(
			"Watchdog: vida caindo sem controle (-%d%%); fugindo",
			lostPercent
		)
	else
		runtimeMessage = string.format("Watchdog: dano alto (-%d%%); fugindo", lostPercent)
	end

	-- Espera brevemente uma ação anterior liberar state.busy.
	local busyDeadline = tick() + 2
	while state.busy and tick() < busyDeadline and state.alive do
		task.wait(0.05)
	end

	-- Emergência tem prioridade.
	if state.busy then
		state.busy = false
	end

	local escaped, safeSpawn = DAMAGE.moveToSafety()

	character = player.Character
	humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if escaped and character and humanoid and humanoid.Health > 0 then
		local food = character:GetAttribute("Food") or 0
		local water = character:GetAttribute("Water") or 0
		local waitStartedAt = tick()
		local minimumWaitUntil = waitStartedAt + DAMAGE.criticalMinWait

		while state.alive
			and character == player.Character
			and humanoid.Parent
			and humanoid.Health > 0
			and tick() < minimumWaitUntil do

			food = character:GetAttribute("Food") or 0
			water = character:GetAttribute("Water") or 0

			-- Não mata um slot de fome/sede só para cumprir o timer.
			-- Se um recurso ficar realmente baixo, libera o survival mais cedo.
			if food <= 45 or water <= 45 then
				runtimeMessage = string.format(
					"Watchdog: seguro, mas Food %d%% Water %d%%; liberando survival",
					math.floor(food),
					math.floor(water)
				)
				break
			end

			runtimeMessage = string.format(
				"Watchdog: protegido em %s (%ds) | HP %d%%",
				safeSpawn and safeSpawn.Name or "local seguro",
				math.max(0, math.ceil(minimumWaitUntil - tick())),
				math.floor((humanoid.Health / math.max(humanoid.MaxHealth, 1)) * 100)
			)
			task.wait(0.5)
		end

		food = character:GetAttribute("Food") or 0
		water = character:GetAttribute("Water") or 0

		if food >= DAMAGE.safeFoodWater and water >= DAMAGE.safeFoodWater then
			local startHealth = humanoid.Health
			local targetHealth = math.min(
				humanoid.MaxHealth,
				startHealth + humanoid.MaxHealth * DAMAGE.targetHealFraction
			)
			local deadline = tick() + DAMAGE.maxRecoveryWait

			while state.alive
				and character == player.Character
				and humanoid.Parent
				and humanoid.Health > 0
				and tick() < deadline
				and humanoid.Health < targetHealth do

				food = character:GetAttribute("Food") or 0
				water = character:GetAttribute("Water") or 0

				if food < DAMAGE.safeFoodWater or water < DAMAGE.safeFoodWater then
					break
				end

				runtimeMessage = string.format(
					"Watchdog: recuperando vida em %s (%ds)",
					safeSpawn and safeSpawn.Name or "local seguro",
					math.max(0, math.ceil(deadline - tick()))
				)
				task.wait(0.5)
			end
		elseif not forceMinimumWait then
			runtimeMessage = string.format(
				"Watchdog: Food %d%% Water %d%%; retomando para repor",
				math.floor(food),
				math.floor(water)
			)
			task.wait(1)
		end
	elseif not escaped then
		runtimeMessage = "Watchdog: nenhum spawn seguro confirmado"
		task.wait(0.5)
	end

	-- Do not restore/rewrite Auto Eat or Auto Drink here. Their values were
	-- intentionally preserved throughout the watchdog transaction.
	if renders then
		if renders.autoEat then renders.autoEat() end
		if renders.autoDrink then renders.autoDrink() end
	end

	criticalRecoveryActive = previousCriticalRecovery
	DAMAGE.active = false
	DAMAGE.cooldownUntil = tick() + 2
	runtimeMessage = "Watchdog: seguro; retomando " .. previousMode
end

function DAMAGE.bind(character)
	if DAMAGE.connection then
		DAMAGE.connection:Disconnect()
		DAMAGE.connection = nil
	end

	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
		or character:WaitForChild("Humanoid", 10)
	if not humanoid then return end

	local lastHealth = humanoid.Health
	local windowStartHealth = nil
	local windowStartedAt = nil

	-- Maior vida observada na janela lenta.
	local slowPeakHealth = humanoid.Health
	local slowPeakAt = tick()

	DAMAGE.connection = humanoid.HealthChanged:Connect(function(newHealth)
		if not state.alive or character ~= player.Character then return end

		if state.questGrowthReset.exclusive then
			lastHealth = newHealth
			windowStartHealth = nil
			windowStartedAt = nil
			slowPeakHealth = newHealth
			slowPeakAt = tick()
			return
		end

		if newHealth <= 0 then
			lastHealth = newHealth
			return
		end

		local now = tick()
		local maxHealth = math.max(humanoid.MaxHealth, 1)

		-- Emergência ignora cooldown. O cooldown só bloqueia duplicatas normais.
		if not DAMAGE.active
			and newHealth <= maxHealth * DAMAGE.criticalHealthFraction then
			local before = math.max(lastHealth, slowPeakHealth, newHealth)
			lastHealth = newHealth
			windowStartHealth = nil
			windowStartedAt = nil
			slowPeakHealth = newHealth
			slowPeakAt = now
			task.spawn(DAMAGE.recover, character, humanoid, before, newHealth, "critical", true)
			return
		end

		if DAMAGE.active or now < DAMAGE.cooldownUntil then
			lastHealth = newHealth
			windowStartHealth = nil
			windowStartedAt = nil
			slowPeakHealth = math.max(slowPeakHealth, newHealth)
			return
		end

		-- Atualiza/reinicia a referência de vida alta da janela lenta.
		if newHealth > slowPeakHealth then
			slowPeakHealth = newHealth
			slowPeakAt = now
		elseif now - slowPeakAt > DAMAGE.slowWindowSeconds then
			-- A cada janela, carrega a vida atual como nova referência.
			-- Assim detecta uma queda prolongada em "degraus" sem depender de hit grande.
			slowPeakHealth = math.max(newHealth, lastHealth)
			slowPeakAt = now
		end

		-- Dano rápido: mantém a lógica anterior de 35% em até 4 segundos.
		if newHealth < lastHealth then
			if not windowStartedAt or now - windowStartedAt > DAMAGE.windowSeconds then
				windowStartedAt = now
				windowStartHealth = lastHealth
			end

			local baseline = windowStartHealth or lastHealth
			local loss = baseline - newHealth
			local fastThreshold = maxHealth * DAMAGE.dropFraction

			if loss >= fastThreshold then
				windowStartHealth = nil
				windowStartedAt = nil
				lastHealth = newHealth
				task.spawn(DAMAGE.recover, character, humanoid, baseline, newHealth, "fast", true)
				return
			end

			-- Dano lento/descontrolado: a vida pode ir caindo pouco a pouco.
			local slowLoss = slowPeakHealth - newHealth
			local slowThreshold = maxHealth * DAMAGE.slowDropFraction

			if slowLoss >= slowThreshold then
				local before = slowPeakHealth
				windowStartHealth = nil
				windowStartedAt = nil
				lastHealth = newHealth
				slowPeakHealth = newHealth
				slowPeakAt = now
				task.spawn(DAMAGE.recover, character, humanoid, before, newHealth, "slow", true)
				return
			end
		elseif newHealth > lastHealth then
			-- Regenerou: zera a janela rápida. A lenta conserva o novo pico.
			windowStartHealth = nil
			windowStartedAt = nil
			if newHealth >= slowPeakHealth then
				slowPeakHealth = newHealth
				slowPeakAt = now
			end
		end

		lastHealth = newHealth
	end)
end

DAMAGE.bind(player.Character)

task.spawn(function()
	local trackedCharacter
	local trackedHumanoid
	local peakHealth
	local peakAt

	while state.alive do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		if character ~= trackedCharacter or humanoid ~= trackedHumanoid then
			trackedCharacter = character
			trackedHumanoid = humanoid
			peakHealth = humanoid and humanoid.Health or nil
			peakAt = tick()
		elseif humanoid
			and humanoid.Parent
			and humanoid.Health > 0
			and not state.questGrowthReset.exclusive then
			local now = tick()
			local maxHealth = math.max(humanoid.MaxHealth, 1)
			local currentHealth = humanoid.Health

			if not peakHealth or currentHealth > peakHealth then
				peakHealth = currentHealth
				peakAt = now
			elseif now - (peakAt or now) > DAMAGE.pollWindow then
				-- Carry current HP forward so repeated small drops continue
				-- being detectable instead of keeping a stale lifetime peak.
				peakHealth = math.max(currentHealth, peakHealth - maxHealth * 0.05)
				peakAt = now
			end

			if not DAMAGE.active then
				-- Layer 1: current HP alone is enough to trigger safety.
				if currentHealth <= maxHealth * DAMAGE.criticalHealthFraction then
					task.spawn(
						DAMAGE.recover,
						character,
						humanoid,
						math.max(peakHealth or currentHealth, currentHealth),
						currentHealth,
						"critical",
						true
					)
				else
					-- Layer 2: continuous small loss in the polling window.
					local pollLoss = (peakHealth or currentHealth) - currentHealth
					if pollLoss >= maxHealth * DAMAGE.pollDropFraction
						and now - (peakAt or now) <= DAMAGE.pollWindow then

						local before = peakHealth or currentHealth
						peakHealth = currentHealth
						peakAt = now

						task.spawn(
							DAMAGE.recover,
							character,
							humanoid,
							before,
							currentHealth,
							"slow",
							true
						)
					end
				end
			end
		end

		task.wait(DAMAGE.pollInterval)
	end
end)

