local function giraffeEatLockedTree(selected)
	if GIRAFFE.busy
		or state.questGrowthReset.exclusive
		or type(selected) ~= "table"
		or not selected.tree
		or not selected.leafPart then
		return
	end

	local myToken = GIRAFFE.cancelToken
	GIRAFFE.busy = true
	GIRAFFE.targetTree = selected.tree
	GIRAFFE.targetLeaves = selected.leaves
	GIRAFFE.targetLeafPart = selected.leafPart
	GIRAFFE.targetStartedAt = GIRAFFE.targetStartedAt > 0
		and GIRAFFE.targetStartedAt
		or tick()

	local function cancelled()
		return myToken ~= GIRAFFE.cancelToken
			or state.questGrowthReset.exclusive
			or not state.autoEat
			or drinkingToFull
			or criticalRecoveryActive
	end

	local character, root = characterParts()
	if not character or not root or cancelled() then
		GIRAFFE.busy = false
		return
	end

	-- Re-check depletion BEFORE moving. A different player may have finished
	-- this tree after we selected it.
	local leafPart, info, initialApproach = giraffeBestReachableLeaf(
		selected.tree,
		character,
		root
	)
	if not info or info.depleted then
		runtimeMessage = "Giraffe: tree leaves are depleted; selecting another tree"
		GIRAFFE.clearTarget()
		GIRAFFE.busy = false
		return
	end

	if not leafPart then
		giraffeIgnoreTree(selected.tree, 75)
		runtimeMessage = "Giraffe: tree still has leaves, but they are above reach"
		GIRAFFE.clearTarget()
		GIRAFFE.busy = false
		return
	end

	selected.leafPart = leafPart
	selected.approach = initialApproach
	GIRAFFE.targetLeafPart = leafPart

	runtimeMessage = string.format(
		"Giraffe: locked tree with available leaves (%.0f studs)",
		selected.distance or 0
	)

	if (root.Position - giraffeTreeAnchorPart(selected.tree, leafPart).Position).Magnitude > 12 then
		giraffeApproachLockedTree(selected, GIRAFFE.repositionAttempts)
		task.wait(0.30)
	end

	character, root = characterParts()
	if not character or not root or cancelled() then
		GIRAFFE.busy = false
		return
	end

	local holdPosition = root.Position
	local lastFood = character:GetAttribute("Food") or 0
	local lastProgressAt = tick()
	local startedAt = tick()
	local nextStateAt = 0
	local nextKeyAt = 0
	local sawEatPrompt = false
	local progressEver = false

	GIRAFFE.lastFood = lastFood
	GIRAFFE.lastProgressAt = lastProgressAt

	while state.alive and tick() - startedAt < 35 do
		if cancelled() then break end

		character, root = characterParts()
		if not character or not root then break end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then break end

		-- Water always wins over feeding.
		if humanoid:GetState() == Enum.HumanoidStateType.Swimming
			or isPositionUnderwater(root.Position) then
			runtimeMessage = "Giraffe: tree position entered water; aborting leaf feed"
			break
		end

		-- CRITICAL tree depletion check:
		-- switch ONLY when every BasePart under this tree's Leaves is transparent.
		local currentLeaf, currentInfo, currentApproach = giraffeBestReachableLeaf(
			selected.tree,
			character,
			root
		)

		if not currentInfo then
			runtimeMessage = "Giraffe: tree lost its Leaves model; selecting another tree"
			GIRAFFE.clearTarget()
			break
		end

		if currentInfo.depleted then
			runtimeMessage = "Giraffe: all Leaves meshes reached Transparency 1; switching tree"
			GIRAFFE.clearTarget()
			break
		end

		if not currentLeaf then
			giraffeIgnoreTree(selected.tree, 75)
			runtimeMessage = "Giraffe: visible leaves remain, but none are within reach; switching tree"
			GIRAFFE.clearTarget()
			break
		end

		-- Individual leaf meshes disappear while the tree is consumed.
		-- Update the target INSIDE the same tree instead of switching trees.
		if currentLeaf and currentLeaf ~= GIRAFFE.targetLeafPart then
			GIRAFFE.targetLeafPart = currentLeaf
			selected.leafPart = currentLeaf
			selected.approach = currentApproach
		end

		local currentFood = character:GetAttribute("Food") or 0
		local targetFood = (
			state.autoQuests
			and state.questGiraffeFeeding
			and not preSwitchFoodTarget
		) and 100 or (preSwitchFoodTarget or 92)

		if currentFood >= targetFood then
			runtimeMessage = "Giraffe finished feeding from tree leaves"
			break
		end

		if currentFood > lastFood + 0.01 then
			lastFood = currentFood
			lastProgressAt = tick()
			progressEver = true
			GIRAFFE.lastFood = currentFood
			GIRAFFE.lastProgressAt = lastProgressAt
			GIRAFFE.repositionAttempts = 0
		end

		local available = detectAvailableFood(character)
		if available == "Eat" then
			sawEatPrompt = true
		end

		-- Hold near THIS tree. Never chase a different tree just because the
		-- current leaf mesh disappeared; currentLeaf above keeps us on the tree.
		root.AssemblyLinearVelocity = Vector3.new(
			0,
			root.AssemblyLinearVelocity.Y,
			0
		)

		if (root.Position - holdPosition).Magnitude > 6 then
			root.CFrame = CFrame.lookAt(
				holdPosition,
				Vector3.new(
					GIRAFFE.targetLeafPart.Position.X,
					holdPosition.Y,
					GIRAFFE.targetLeafPart.Position.Z
				),
				Vector3.yAxis
			)
		end

		if RAGDOLL_STATES[humanoid:GetState()] then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end

		if tick() >= nextStateAt then
			nextStateAt = tick() + 0.45
			setSubState("Eating")
		end

		-- Press E only when the game explicitly offers Eat. This avoids
		-- accidentally toggling Eating OFF while "Click E to stop eating" is up.
		if available == "Eat" and tick() >= nextKeyAt then
			nextKeyAt = tick() + 1.0
			giraffeTapEatKey()
		end

		-- No Food progress does NOT immediately switch trees.
		-- First verify the Leaves meshes, then reposition around the SAME tree.
		if tick() - lastProgressAt >= 6.5 then
			local verifyLeaf, verifyInfo, verifyApproach = giraffeBestReachableLeaf(
				selected.tree,
				character,
				root,
				GIRAFFE.repositionAttempts + 1
			)

			if verifyInfo and verifyInfo.depleted then
				runtimeMessage = "Giraffe: verified all Leaves depleted; switching tree"
				GIRAFFE.clearTarget()
				break
			end

			if verifyInfo and not verifyInfo.depleted and not verifyLeaf then
				giraffeIgnoreTree(selected.tree, 75)
				runtimeMessage = "Giraffe: remaining leaves are too high; switching tree"
				GIRAFFE.clearTarget()
				break
			end

			GIRAFFE.repositionAttempts += 1

			if GIRAFFE.repositionAttempts <= 3
				and verifyLeaf then

				selected.leafPart = verifyLeaf
				selected.approach = verifyApproach
				GIRAFFE.targetLeafPart = verifyLeaf

				runtimeMessage = string.format(
					"Giraffe: leaves remain; repositioning on same tree (%d/3)",
					GIRAFFE.repositionAttempts
				)

				giraffeApproachLockedTree(
					selected,
					GIRAFFE.repositionAttempts
				)
				task.wait(0.35)

				character, root = characterParts()
				if not character or not root then break end

				holdPosition = root.Position
				lastProgressAt = tick()
				nextStateAt = 0
				nextKeyAt = 0
			else
				-- Leaves are still visible, so this tree is NOT considered
				-- depleted. Temporarily skip only after several failed angles.
				giraffeIgnoreTree(selected.tree, 45)
				runtimeMessage = "Giraffe: leaves still visible but interaction stalled; temporarily skipping this tree"
				GIRAFFE.clearTarget()
				break
			end
		end

		runtimeMessage = string.format(
			"Giraffe eating tree leaves - Food %d%%",
			math.floor(currentFood)
		)

		task.wait(0.20)
	end

	character, root = characterParts()
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	local foodAfter = character and (character:GetAttribute("Food") or 0) or 0
	local targetFood = (
		state.autoQuests
		and state.questGiraffeFeeding
		and not preSwitchFoodTarget
	) and 100 or (preSwitchFoodTarget or 92)

	if foodAfter >= targetFood then
		GIRAFFE.clearTarget()
	elseif GIRAFFE.targetTree and GIRAFFE.targetTree.Parent then
		local finalLeaf, finalInfo = giraffeBestReachableLeaf(
			GIRAFFE.targetTree,
			character,
			root
		)

		if finalInfo and finalInfo.depleted then
			runtimeMessage = "Giraffe: current tree exhausted; next feed will use another tree"
			GIRAFFE.clearTarget()
		elseif finalInfo and not finalInfo.depleted and not finalLeaf then
			giraffeIgnoreTree(GIRAFFE.targetTree, 75)
			runtimeMessage = "Giraffe: remaining tree leaves are outside reach; selecting another tree"
			GIRAFFE.clearTarget()
		elseif not finalInfo then
			GIRAFFE.clearTarget()
		elseif progressEver then
			-- Keep the same tree locked if it did feed and still has leaves.
			-- The next pass continues here instead of choosing a closer tree.
			GIRAFFE.targetStartedAt = GIRAFFE.targetStartedAt > 0
				and GIRAFFE.targetStartedAt
				or tick()
		elseif not sawEatPrompt and GIRAFFE.repositionAttempts >= 3 then
			giraffeIgnoreTree(GIRAFFE.targetTree, 45)
			GIRAFFE.clearTarget()
		end
	end

	GIRAFFE.busy = false
end


local function baboonTapEatKey()
	pcall(function()
		VirtualInputManager:SendKeyEvent(
			true,
			Enum.KeyCode.E,
			false,
			game
		)
		task.wait(0.045)
		VirtualInputManager:SendKeyEvent(
			false,
			Enum.KeyCode.E,
			false,
			game
		)
	end)
end

local function baboonApproachFood(targetPart, distance)
	local character, root = characterParts()
	if not character or not root or not targetPart or not targetPart.Parent then
		return false
	end

	local flat = Vector3.new(
		root.Position.X - targetPart.Position.X,
		0,
		root.Position.Z - targetPart.Position.Z
	)

	if flat.Magnitude < 0.5 then
		flat = Vector3.new(
			-root.CFrame.LookVector.X,
			0,
			-root.CFrame.LookVector.Z
		)
	end

	if flat.Magnitude < 0.1 then
		flat = Vector3.new(1, 0, 0)
	else
		flat = flat.Unit
	end

	local desired = targetPart.Position + flat * (distance or 4)

	-- Always land on real Terrain next to the AntHill. The old code preserved
	-- the AntHill mesh Y, which could put the Baboon on top of/inside the model.
	local castY = math.max(
		targetPart.Position.Y + 120,
		root.Position.Y + 120,
		250
	)

	local hit = workspace:Raycast(
		Vector3.new(desired.X, castY, desired.Z),
		Vector3.new(0, -500, 0),
		terrainOnlyRayParams
	)

	if not hit or hit.Material == Enum.Material.Water then
		return false
	end

	return safeMoveToPosition(
		hit.Position,
		7,
		targetPart.Position,
		{ purpose = "food", tolerance = 8 }
	)
end

local function baboonEatLockedTarget(selected)
	if BABOON.busy
		or state.questGrowthReset.exclusive
		or type(selected) ~= "table"
		or not selected.object
		or not selected.part then
		return
	end

	local myToken = BABOON.cancelToken
	BABOON.busy = true
	BABOON.targetKind = selected.kind
	BABOON.targetObject = selected.object
	BABOON.targetPart = selected.part
	BABOON.targetStartedAt = tick()

	local function cancelled()
		local liveCharacter = player.Character
		local liveWater = liveCharacter
			and (liveCharacter:GetAttribute("Water") or 100)
			or 100

		return myToken ~= BABOON.cancelToken
			or state.questGrowthReset.exclusive
			or not state.autoEat
			or drinkingToFull
			or liveWater <= 75
			or criticalRecoveryActive
	end

	local character, root = characterParts()
	if not character or not root or cancelled() then
		BABOON.busy = false
		BABOON.clearTarget()
		return
	end

	-- ========================================================
	-- CARCASS
	-- ========================================================
	if selected.kind == "Carcass" then
		runtimeMessage = string.format(
			"Baboon: locked nearest food -> carcass (%.0f studs)",
			selected.distance or 0
		)

		-- Keep the Baboon lock around the existing, battle-tested carcass
		-- routine. It cannot switch to an AntHill mid-attempt.
		eatCarcass(selected.object, selected.part)

		local liveCharacter = player.Character
		local foodAfter = liveCharacter and (liveCharacter:GetAttribute("Food") or 0) or 0
		local targetFood = (
			state.autoQuests
			and state.questBaboonFeeding
			and not preSwitchFoodTarget
		) and 100 or (preSwitchFoodTarget or 92)

		if foodAfter >= targetFood then
			BABOON.clearTarget()
		elseif not selected.object.Parent or carcassIsIgnored(selected.object) then
			BABOON.clearTarget()
		else
			-- If carcass routine returned without finishing but did not mark it
			-- bad, keep the SAME source locked for the next pass.
			BABOON.targetObject = selected.object
			BABOON.targetPart = selected.part
			BABOON.targetKind = "Carcass"
		end

		BABOON.busy = false
		return
	end

	-- ========================================================
	-- ANT HILL
	-- ========================================================
	if selected.kind ~= "AntHill"
		or not selected.object.Parent
		or not selected.part.Parent then

		BABOON.busy = false
		BABOON.clearTarget()
		return
	end

	runtimeMessage = string.format(
		"Baboon: locked nearest food -> AntHill (%.0f studs)",
		selected.distance or 0
	)

	-- ONE positioning action only.
	-- If already close, do not move at all.
	if (root.Position - selected.part.Position).Magnitude > 9 then
		local approached = baboonApproachFood(selected.part, 4)

		if not approached then
			baboonIgnoreAntHill(selected.object, 60)
			BABOON.busy = false
			BABOON.clearTarget()
			runtimeMessage = "Baboon: could not find safe ground beside AntHill"
			return
		end

		task.wait(0.35)
	end

	character, root = characterParts()
	if not character or not root or cancelled() then
		BABOON.busy = false
		BABOON.clearTarget()
		return
	end

	-- IMPORTANT:
	-- AntHill is a special Baboon food source. The generic
	-- DetectMeatGrassWater helper is not authoritative for it, so do not reject
	-- a valid AntHill just because that helper does not return "Eat".
	--
	-- Start the interaction exactly ONCE. The order matches normal player use:
	-- press E once, then reinforce the Eating substate once.
	local startFood = character:GetAttribute("Food") or 0
	local lastFood = startFood
	local lastProgressAt = tick()
	local foodEverRose = false

	BABOON.lastFood = startFood
	BABOON.lastProgressAt = lastProgressAt

	baboonTapEatKey()
	task.wait(0.08)

	if cancelled() then
		BABOON.busy = false
		BABOON.clearTarget()
		return
	end

	setSubState("Eating")

	runtimeMessage = string.format(
		"Baboon eating AntHill - Food %d%%",
		math.floor(startFood)
	)

	-- From this point onward there are NO more E presses and NO forced relocations.
	-- We only observe Food and the safety state.
	while state.alive do
		if cancelled() then break end
		if not selected.object.Parent or not selected.part.Parent then break end

		character, root = characterParts()
		if not character or not root then break end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then break end

		if humanoid:GetState() == Enum.HumanoidStateType.Swimming
			or isPositionUnderwater(root.Position) then

			baboonIgnoreAntHill(selected.object, 120)
			runtimeMessage = "Baboon: AntHill became unsafe near water; target blacklisted"
			break
		end

		local currentFood = character:GetAttribute("Food") or 0
		local targetFood = (
			state.autoQuests
			and state.questBaboonFeeding
			and not preSwitchFoodTarget
		) and 100 or (preSwitchFoodTarget or 92)

		if currentFood >= targetFood then
			break
		end

		if currentFood > lastFood + 0.01 then
			lastFood = currentFood
			lastProgressAt = tick()
			foodEverRose = true
			BABOON.lastFood = currentFood
			BABOON.lastProgressAt = lastProgressAt

			runtimeMessage = string.format(
				"Baboon eating AntHill - Food %d%%",
				math.floor(currentFood)
			)
		end

		-- If the Baboon gets displaced away from the AntHill, do NOT snap it back
		-- it back on top. End this attempt cleanly and reacquire later.
		if (root.Position - selected.part.Position).Magnitude > 13 then
			runtimeMessage = "Baboon moved away from AntHill; ending feed attempt without moving"
			break
		end

		-- One E press should start the entire feeding session. If Food never
		-- moves, this AntHill is simply not usable from this position.
		if tick() - lastProgressAt >= 7 then
			baboonIgnoreAntHill(selected.object, 90)
			runtimeMessage = foodEverRose
				and "Baboon: AntHill stopped giving Food for 7s; switching source"
				or "Baboon: AntHill gave no Food after one Eat press; switching source"
			break
		end

		task.wait(0.20)
	end

	character, root = characterParts()

	local foodAfter = character
		and (character:GetAttribute("Food") or 0)
		or 0

	local targetFood = (
		state.autoQuests
		and state.questBaboonFeeding
		and not preSwitchFoodTarget
	) and 100 or (preSwitchFoodTarget or 92)

	if foodAfter >= targetFood then
		runtimeMessage = "Baboon finished feeding from AntHill"
		BABOON.clearTarget()

	elseif not selected.object.Parent
		or baboonAntHillIsIgnored(selected.object)
		or not foodEverRose then

		if not foodEverRose and selected.object.Parent then
			baboonIgnoreAntHill(selected.object, 90)
		end

		BABOON.clearTarget()

	else
		-- It was a valid source and Food increased. Keep the same AntHill locked
		-- if the attempt ended for an external reason; do not compare distances
		-- again and do not force-position it while already eating.
		BABOON.targetKind = "AntHill"
		BABOON.targetObject = selected.object
		BABOON.targetPart = selected.part
	end

	BABOON.busy = false

	if not state.questGrowthReset.exclusive
		and not drinkingToFull then
		blockClientSubState = false
	end
end


local function virtualEatKick()
	if state.questGrowthReset.exclusive then return end
	local character, root = characterParts()
	if not character or not root then return end

	local animal = character:GetAttribute("AnimalName") or ""

	if isGiraffeCharacter(character) then
		if GIRAFFE.busy then return end

		local selected = nearestGiraffeTree(root)
		if selected then
			runtimeMessage = "Giraffe: Eat stalled; retrying locked tree leaves"
			task.spawn(giraffeEatLockedTree, selected)
		else
			runtimeMessage = "Giraffe: no non-depleted tree leaves found"
		end

		eatingStuckSince = nil
		return
	end

	if isBaboonCharacter(character) then
		-- Water has absolute priority for Baboon.
		if (character:GetAttribute("Water") or 100) <= 75 then
			state.questBaboonFeeding = false
			eatingToFull = false
			BABOON.cancel()
			eatingStuckSince = nil
			return
		end

		-- The dedicated Baboon routine owns AntHill interaction. Never use the
		-- generic watchdog to spam E or reposition while that routine is active.
		if BABOON.busy then
			eatingStuckSince = nil
			return
		end

		local selected = chooseBaboonFood(root)
		if selected then
			runtimeMessage = "Baboon: feed attempt ended; reacquiring locked food source"
			task.spawn(baboonEatLockedTarget, selected)
		else
			runtimeMessage = "Baboon: no carcass or AntHill available"
		end

		eatingStuckSince = nil
		return
	end

	if isCarnivoreCharacter(character) then
		runtimeMessage = "Comer sumiu (carnivoro); refazendo movimento na carcaça"
		activeCarcass = nil -- força procurar carcaça de novo, pode ter sido consumida/sumido
		local carcass, carcassRoot = nearestCarcass(root)
		if carcass and carcassRoot and not carcassEatBusy then
			task.spawn(eatCarcass, carcass, carcassRoot)
		elseif not carcass then
			runtimeMessage = "Comer sumiu (carnivoro); nenhuma carcaça encontrada por perto"
		end

		eatingStuckSince = nil
		return
	end

	runtimeMessage =
		"Eat travou; procurando uma grama realmente utilizavel"

	local food =
		tonumber(
			character:GetAttribute(
				"Food"
			)
		) or 100

	local grass =
		findNearestGrass(
			root.Position
		)

	if not grass
		and food <= 35 then

		grass =
			findDistantGrass(
				root.Position
			)
	end

	if grass then
		local moved =
			moveToGrass(
				grass
			)

		if moved then
			task.wait(0.15)
			character, root = characterParts()

			if character and root
				and startGrassEatingIfAvailable(
					character,
					root,
					grass
				) then

				eatingSourcePosition = grass
				eatingTargetReachedAt = tick()
				runtimeMessage =
					"Eat recuperado em nova grama"
			else
				temporarilyIgnoreGrass(grass, 4)
				runtimeMessage =
					"Grama sem prompt Eat; procurando outra"
			end
		else
			temporarilyIgnoreGrass(grass, 4)
		end
	end

	eatingStuckSince = nil
end

-- ============================================================
-- SURVIVAL ARBITER
-- Food and Water are mutually exclusive long-running jobs. Once one need owns
-- survival, the other may not steal movement just because its percentage changes
-- by a few points. Only critical thirst may preempt an active food job.
-- ============================================================
state.survivalArbiter = state.survivalArbiter or {
	owner = nil,
	ownerSince = 0,
	lastOwner = nil,
	handoffNotBefore = 0,
	lastProgressAt = 0,
	lastValue = nil,
	preemptions = 0,
}

function state.survivalArbiterReset(reason)
	local arbiter = state.survivalArbiter
	arbiter.owner = nil
	arbiter.ownerSince = 0
	arbiter.lastOwner = nil
	arbiter.handoffNotBefore = 0
	arbiter.lastProgressAt = tick()
	arbiter.lastValue = nil
	arbiter.preemptions = 0
end

function state.survivalArbiterChoose(food, water)
	food = tonumber(food) or 100
	water = tonumber(water) or 100

	-- Critical thirst always wins. Otherwise use hysteresis: Water only steals
	-- initial ownership when it is meaningfully worse than Food.
	if state.autoDrink and water <= 45 then
		return "water"
	end

	local waterNeed = state.autoDrink and water <= 75
	local foodNeed = state.autoEat and food < 92

	if waterNeed and foodNeed then
		if water <= 60 or water <= food - 8 then
			return "water"
		end
		return "food"
	elseif waterNeed then
		return "water"
	elseif foodNeed then
		return "food"
	end

	return nil
end

function state.survivalArbiterAcquire(kind, food, water, reason)
	if kind ~= "food" and kind ~= "water" then
		return false
	end

	local arbiter = state.survivalArbiter
	local now = tick()
	food = tonumber(food) or 100
	water = tonumber(water) or 100

	if arbiter.owner == kind then
		return true
	end

	if arbiter.owner ~= nil then
		-- Food may only be interrupted for genuinely dangerous thirst. Normal
		-- Water <=75 is NOT enough to abandon a grass/tree/carcass route.
		local emergencyWaterPreempt =
			kind == "water"
			and arbiter.owner == "food"
			and state.autoDrink
			and water <= 45

		if not emergencyWaterPreempt then
			return false
		end

		arbiter.preemptions = (arbiter.preemptions or 0) + 1
	end

	-- Small dead-band after a completed job prevents Eat/Drink from swapping on
	-- adjacent scheduler frames. Critical Water bypasses it.
	if now < (arbiter.handoffNotBefore or 0)
		and kind ~= arbiter.lastOwner
		and not (kind == "water" and water <= 45) then
		return false
	end

	arbiter.owner = kind
	arbiter.ownerSince = now
	arbiter.lastProgressAt = now
	arbiter.lastValue = kind == "water" and water or food

	return true
end

function state.survivalArbiterNoteProgress(kind, value)
	local arbiter = state.survivalArbiter
	if arbiter.owner ~= kind then return end

	value = tonumber(value)
	if not value then return end

	if arbiter.lastValue == nil or value > arbiter.lastValue + 0.01 then
		arbiter.lastValue = value
		arbiter.lastProgressAt = tick()
	end
end

function state.survivalArbiterComplete(kind)
	local arbiter = state.survivalArbiter
	if arbiter.owner ~= kind then return false end

	arbiter.lastOwner = kind
	arbiter.owner = nil
	arbiter.ownerSince = 0
	arbiter.lastProgressAt = tick()
	arbiter.lastValue = nil
	arbiter.handoffNotBefore = tick() + 1.1
	return true
end

local function autoEatStep()
	if state.questGrowthReset.exclusive then return end
	-- v65: Swim quests do not disable survival. If Food is low, eating pauses
	-- the Swim route; after feeding, the quest returns to the saved Swim point.
	if not state.autoEat or state.busy or drinkingToFull or criticalRecoveryActive then return end
	local character, root = characterParts()
	if not character or not root then return end
	if carcassEatBusy or BABOON.busy or GIRAFFE.busy then return end

	local food = character:GetAttribute("Food") or 100
	local water = character:GetAttribute("Water") or 100

	state.survivalArbiterNoteProgress("food", food)
	state.survivalArbiterNoteProgress("water", water)

	local survivalOwner = state.survivalArbiter.owner
	if survivalOwner == "water" then
		-- A committed Drink job keeps ownership until it actually completes or
		-- its own watchdog proves the source bad. Do not start walking to grass.
		return
	end

	if survivalOwner == nil then
		local preferredNeed = state.survivalArbiterChoose(food, water)
		if preferredNeed == "water" then
			state.survivalArbiterAcquire("water", food, water, "initial arbitration")
			return
		end
	end

	-- v80: after an herbivore leaves Pride Rock to drink, it must return to
	-- Pride Rock BEFORE looking for grass/tree food. Drinking is the sole
	-- automatic exception to the Pride Growth leash.
	if state.growthPrideRestrictionActive(character)
		and not state.growthPrideInside(
			character,
			root
		) then

		state.growthPride.returnRequested = true

		runtimeMessage =
			water <= 75
			and "Growth herbivore: outside Pride Rock only for water"
			or "Growth herbivore: returning to Pride Rock before eating"

		return
	end
	local giraffe = isGiraffeCharacter(character)
	local baboon = not giraffe and isBaboonCharacter(character)
	local carnivore = not giraffe and not baboon and isCarnivoreCharacter(character)

	-- v108:
	-- The "wait until <=70%, then feed to 100%" policy exists ONLY while an
	-- actual Survive in Zone / ZoneTime cycle is being protected.
	-- For TravelDistance, Growth debt, GroupTime, post-quest Growth, etc.,
	-- Auto Eat behaves normally and does not wait for ~70%.
	local zoneSurvivalFeeding =
		state.autoQuests
			and state.questZoneDrinkOverride
			and state.questZoneDrinkOverride.active
			and not preSwitchFoodTarget

	local questCarnivore =
		zoneSurvivalFeeding and carnivore

	local questBaboon =
		zoneSurvivalFeeding and baboon

	local questGiraffe =
		zoneSurvivalFeeding and giraffe

	-- v109:
	-- During pure TravelDistance, grass-eating herbivores should not abandon
	-- Auto Run every time Food drops a little. Start a real feeding route only
	-- at <=60%, then recover to 85% so the next stop is not immediate.
	local travelHerbivoreFeeding =
		state.autoQuests
			and state.questTravelActive
			and not state.questSwimActive
			and not (
				state.questZoneDrinkOverride
				and state.questZoneDrinkOverride.active
			)
			and not carnivore
			and not baboon
			and not giraffe
			and not preSwitchFoodTarget

	if travelHerbivoreFeeding then
		if not state.questTravelHerbivoreFeed.active
			and food <= 60 then

			state.questTravelHerbivoreFeed.active = true

		elseif state.questTravelHerbivoreFeed.active
			and food >= 85 then

			state.questTravelHerbivoreFeed.active = false
		end
	else
		state.questTravelHerbivoreFeed.active = false
	end

	-- Baboon never competes with Auto Drink. If Water needs service, drop all
	-- Baboon food ownership immediately and let autoDrinkStep take over.
	if baboon and water <= 75 then
		state.questBaboonFeeding = false
		eatingToFull = false
		BABOON.cancel()
		eatingStuckSince = nil
		lastEatWatchdogFood = food
		return
	end

	-- Giraffe eats ONLY tree Leaves from workspace.MapAssets.MainAssets.
	-- During an active ZoneTime it may delay feeding to <=70% to avoid leaving the zone.
	if questGiraffe then
		if not state.questGiraffeFeeding and food <= 70 then
			state.questRememberZoneBeforeFeeding("Giraffe feeding")
			state.questGiraffeFeeding = true
			eatingToFull = true
			runtimeMessage = "Giraffe: Food <= 70%; pausing quests to eat tree leaves"
		end

		if state.questGiraffeFeeding then
			if food >= 100 then
				state.questGiraffeFeeding = false
				eatingToFull = false
				state.survivalArbiterComplete("food")
				resetEatingSearch(food)
				GIRAFFE.cancel()
				eatingStuckSince = nil
				runtimeMessage = "Giraffe full; returning to quests"
				return
			end
		else
			return
		end
	elseif state.questGiraffeFeeding then
		state.questGiraffeFeeding = false
		GIRAFFE.cancel()
	end

	-- Baboon is an omnivore with an EXCLUSIVE dual-food controller:
	-- nearest Carcass OR workspace.MapAssets.AntHills. Once selected, that
	-- source remains locked until it feeds successfully or is proven bad.
	if questBaboon then
		if not state.questBaboonFeeding and food <= 70 then
			state.questRememberZoneBeforeFeeding("Baboon feeding")
			state.questBaboonFeeding = true
			eatingToFull = true
			runtimeMessage = "Baboon: Food <= 70%; pausing quests to feed"
		end

		if state.questBaboonFeeding then
			if food >= 100 then
				state.questBaboonFeeding = false
				eatingToFull = false
				state.survivalArbiterComplete("food")
				resetEatingSearch(food)
				BABOON.cancel()
				eatingStuckSince = nil
				runtimeMessage = "Baboon full; returning to quests"
				return
			end
		else
			-- Above 70%, do not abandon Auto Run/Zone just to feed.
			return
		end
	elseif state.questBaboonFeeding then
		state.questBaboonFeeding = false
		BABOON.cancel()
	end

	-- Carnivore during active ZoneTime:
	-- only leaves the protected zone for food at <=70%; once started, feeds to 100%.
	if questCarnivore then
		if not state.questCarnivoreFeeding and food <= 70 then
			state.questRememberZoneBeforeFeeding("Carnivore feeding")
			state.questCarnivoreFeeding = true
			eatingToFull = true
			runtimeMessage = "Carnivore: Food <= 70%; pausing quests to eat"
		end

		if state.questCarnivoreFeeding then
			if food >= 100 then
				state.questCarnivoreFeeding = false
				eatingToFull = false
				state.survivalArbiterComplete("food")
				resetEatingSearch(food)
				activeCarcass = nil
				eatingStuckSince = nil
				runtimeMessage = "Carnivore full; returning to quests"
				return
			end
		else
			-- Acima de 70% o carnívoro não abandona Auto Run/Zone para caçar.
			return
		end
	elseif state.questCarnivoreFeeding then
		state.questCarnivoreFeeding = false
	end

	local foodCap =
		(questCarnivore or questBaboon or questGiraffe)
			and 100
			or (
				travelHerbivoreFeeding
					and state.questTravelHerbivoreFeed.active
					and 85
			)
			or (preSwitchFoodTarget or 92)

	if food < foodCap then
		if not state.survivalArbiterAcquire(
			"food",
			food,
			water,
			"Auto Eat committed"
		) then
			return
		end
	end

	if food >= foodCap then
		local wasEating = eatingToFull
		eatingToFull = false
		state.survivalArbiterNoteProgress("food", food)
		state.survivalArbiterComplete("food")
		resetEatingSearch(food)
		activeCarcass = nil
		eatingStuckSince = nil

		if state.questTravelHerbivoreFeed
			and state.questTravelHerbivoreFeed.active
			and food >= 85 then

			state.questTravelHerbivoreFeed.active =
				false

			runtimeMessage =
				"Auto Run food break complete; resuming TravelDistance"
		end

		if wasEating and state.autoQuests then
			state.questForceFastRecheckUntil = tick() + 12
			runtimeMessage =
				"Food stable; resuming quest controller"
		end

		return
	end

	local availableFood = detectAvailableFood(character)
	local movementInteraction

	if state.questMovementOpportunisticInteract then
		movementInteraction =
			state.questMovementOpportunisticInteract(
				character,
				root
			)
	end

	-- TravelDistance grass policy:
	-- if grass is already under the running herbivore, use it in-place while
	-- Auto Run keeps owning movement. A real grass route is allowed only after
	-- that on-path opportunity/grace is gone.
	if travelHerbivoreFeeding then
		local grassOnPath =
			availableFood == "Eat"
				and state.questMotionMoving
				and state.questMotionMode == "Land"

		local grassGrace =
			state.questMoveInteract
				and tick()
					< (
						state.questMoveInteract.grassGraceUntil
							or 0
					)

		if grassOnPath
			or movementInteraction == "eat"
			or movementInteraction == "eat_grace"
			or grassGrace then

			eatingToFull = false
			eatingSourcePosition = nil
			eatingTargetReachedAt = nil
			eatingStuckSince = nil

			runtimeMessage =
				"Auto Run: eating grass while moving"

			return
		end

		if not state.questTravelHerbivoreFeed.active then
			-- Food is still comfortable. Keep running and do NOT create a
			-- moveToGrass/SafeMove food route.
			return
		end

		eatingToFull = true

		runtimeMessage =
			string.format(
				"Auto Run food break (%d%% -> 85%%)",
				math.floor(food)
			)
	end

	if not eatingToFull then
		state.questRememberZoneBeforeFeeding("feeding")
	end
	eatingToFull = true

	if lastEatWatchdogFood == nil or food > lastEatWatchdogFood then
		lastEatWatchdogFood = food
		eatingStuckSince = tick()
	elseif not eatingStuckSince then
		eatingStuckSince = tick()
	end
	if eatingStuckSince and tick() - eatingStuckSince >= 15 then
		lastEatWatchdogFood = food
		eatingStuckSince = tick()
		virtualEatKick()
		return
	end

	if giraffe then
		if GIRAFFE.busy then return end

		local selected = nearestGiraffeTree(root)
		if selected then
			runtimeMessage = string.format(
				"Giraffe: using %s tree leaves (%.0f studs)",
				selected.locked and "locked" or "nearest available",
				selected.distance or 0
			)
			task.spawn(giraffeEatLockedTree, selected)
		else
			runtimeMessage = "Giraffe: no tree with visible Leaves meshes found"
		end
		return
	end

	if baboon then
		if BABOON.busy then return end

		local selected = chooseBaboonFood(root)
		if selected then
			runtimeMessage = string.format(
				"Baboon: nearest food is %s (%.0f studs); target locked",
				selected.kind,
				selected.distance or 0
			)
			task.spawn(baboonEatLockedTarget, selected)
		else
			runtimeMessage = "Baboon: no carcass or AntHill currently available"
		end
		return
	end

	if carnivore then
		if carcassEatBusy then return end

		local carcass = activeCarcass
		local carcassRoot = carcass and (
			carcass:FindFirstChild("HumanoidRootPart")
			or carcass:FindFirstChildWhichIsA("BasePart", true)
		)

		if not carcassRoot then
			carcass, carcassRoot = nearestCarcass(root)
		end

		if carcass and carcassRoot then
			runtimeMessage = questCarnivore
				and string.format("Carnivore feeding to 100%% (Food %d%%)", math.floor(food))
				or "Indo comer carcaça"
			task.spawn(eatCarcass, carcass, carcassRoot)
		else
			runtimeMessage = questCarnivore
				and string.format("Carnivore feeding: searching carcass (Food %d%%)", math.floor(food))
				or "Carnivoro sem carcaça por perto"

			if isSavannahLife then
				exploreSavannahCarcassSpawns()
			elseif tick() >= nextCarnivoreExploreCheck then
				nextCarnivoreExploreCheck = tick() + 20
				local spot = findSafeTerrainSpot(root.Position, 20, 60)
				if spot then
					runtimeMessage = "Procurando carcaça em outra area (terreno seguro)"
					safeMoveToPosition(
					spot,
					7,
					nil,
					{ purpose = "food", tolerance = 14 }
				)
				end
			end
		end
		return
	end

	if availableFood == "Eat" then
		eatingSourcePosition = root.Position
		eatingTargetReachedAt = tick()
		runtimeMessage = "Comendo a grama proxima"
		startGrassEatingIfAvailable(character, root, eatingSourcePosition)
		return
	end

	-- v124: verified grass controller.
	if eatingSourcePosition
		and eatingTargetReachedAt then

		if state.grassEatAvailable(
			character
		) then
			if startGrassEatingIfAvailable(
				character,
				root,
				eatingSourcePosition
			) then

				runtimeMessage =
					"Eat confirmado na grama atual"

				return
			end
		end

		-- Do not remain stuck claiming a non-working grass point.
		if tick()
				- eatingTargetReachedAt
				> 0.85 then

			temporarilyIgnoreGrass(
				eatingSourcePosition,
				7,
				14
			)

			eatingSourcePosition = nil
			eatingTargetReachedAt = nil
		else
			faceGrassPoint(
				root,
				eatingSourcePosition
			)

			runtimeMessage =
				"Aguardando confirmacao Eat na grama"

			return
		end
	end

	local grass,
		grassDistance,
		grassSamples =
			findNearestGrass(
				root.Position
			)

	-- Do not run across the map at 55-60% Food. A distant emergency route is
	-- allowed only when hunger is genuinely critical.
	if not grass
		and food <= 35
		and tick()
			>= nextEmergencyGrassCheck then

		nextEmergencyGrassCheck =
			tick() + 90

		local distantGrass =
			findDistantGrass(
				root.Position
			)

		if distantGrass then
			runtimeMessage =
				"Fome critica; nenhuma grama verificada em 120 studs, usando fallback"

			local moved,
				moveReason =
					moveToGrass(
						distantGrass
					)

			if moved then
				task.wait(0.12)

				local liveCharacter,
					liveRoot =
					characterParts()

				if liveCharacter
					and liveRoot
					and state.grassEatAvailable(
						liveCharacter
					) then

					eatingSourcePosition =
						liveRoot.Position

					eatingTargetReachedAt =
						tick()

					startGrassEatingIfAvailable(
						liveCharacter,
						liveRoot,
						distantGrass
					)
				else
					temporarilyIgnoreGrass(
						distantGrass,
						10,
						18
					)
				end
			else
				temporarilyIgnoreGrass(
					distantGrass,
					8,
					18
				)

				runtimeMessage =
					"Fallback de grama cancelado: "
					.. tostring(
						moveReason
					)
			end

			return
		end
	end

	if not grass then
		runtimeMessage =
			food <= 35
				and "Nenhuma grama verificada localmente; fallback tambem falhou"
				or "Nenhuma grama utilizavel verificada em ate 120 studs"

		return
	end

	runtimeMessage =
		string.format(
			"Grama verificada: %.0f studs (%d/9 Terrain Grass)",
			grassDistance or 0,
			grassSamples or 0
		)

	local moved,
		moveReason =
			moveToGrass(
				grass
			)

	if not moved then
		temporarilyIgnoreGrass(
			grass,
			8,
			14
		)

		eatingSourcePosition = nil
		eatingTargetReachedAt = nil

		runtimeMessage =
			"Rota da grama rejeitada: "
			.. tostring(
				moveReason
			)

		return
	end

	task.wait(0.10)

	character, root =
		characterParts()

	if not character or not root then
		return
	end

	if state.grassEatAvailable(
		character
	) then
		eatingSourcePosition =
			root.Position

		eatingTargetReachedAt =
			tick()

		if startGrassEatingIfAvailable(
			character,
			root,
			grass
		) then

			runtimeMessage =
				"Eat confirmado; comecando a comer"

			return
		end
	end

	-- Reaching a Terrain coordinate without Eat is NOT success.
	temporarilyIgnoreGrass(
		grass,
		8,
		14
	)

	eatingSourcePosition = nil
	eatingTargetReachedAt = nil

	runtimeMessage =
		"Terrain Grass confirmado, mas sem prompt Eat; tentando outro ponto"

end

local function isPositionInWaterTerrain(position, radiusXZ, radiusY)
	radiusXZ = radiusXZ or 5
	radiusY = radiusY or 7

	local ok, materials, occupancies = pcall(function()
		local half = Vector3.new(radiusXZ, radiusY, radiusXZ)
		local region = Region3.new(position - half, position + half):ExpandToGrid(4)
		return workspace.Terrain:ReadVoxels(region, 4)
	end)
	if not ok or type(materials) ~= "table" then return false end

	-- ReadVoxels returns a 3D matrix. The old check only inspected [1][1][1],
	-- so it could report false even with the animal visibly inside water.
	for x = 1, #materials do
		local ys = materials[x]
		if type(ys) == "table" then
			for y = 1, #ys do
				local zs = ys[y]
				if type(zs) == "table" then
					for z = 1, #zs do
						if zs[z] == Enum.Material.Water then
							local occupancy = occupancies
								and occupancies[x]
								and occupancies[x][y]
								and occupancies[x][y][z]
							if occupancy == nil or occupancy > 0.05 then
								return true
							end
						end
					end
				end
			end
		end
	end

	return false
end

local function isStandingInWater(root)
	if not root then return false end

	local _, _, humanoid = characterParts()
	if humanoid and humanoid:GetState() == Enum.HumanoidStateType.Swimming then
		return true
	end

	if isPositionInWaterTerrain(root.Position, 6, 9) then
		return true
	end

	-- Probe several points around the body instead of one tiny 3-stud ray.
	local offsets = {
		Vector3.new(0, 5, 0),
		Vector3.new(0, 2, 0),
		Vector3.new(3, 3, 0),
		Vector3.new(-3, 3, 0),
		Vector3.new(0, 3, 3),
		Vector3.new(0, 3, -3),
	}
	for _, offset in ipairs(offsets) do
		local hit = workspace:Raycast(
			root.Position + offset,
			Vector3.new(0, -14, 0),
			terrainParams
		)
		if hit and hit.Material == Enum.Material.Water then
			return true
		end
	end

	return false
end

function state.isDirectWaterContact(root)
	if not root then return false end

	-- Use the FIRST Terrain surface directly below the body.
	-- If the animal is already on a dry bank, this hits Sand/Grass/Ground and
	-- does not get confused by nearby water or a stale Swimming humanoid state.
	local hit = workspace:Raycast(
		root.Position + Vector3.new(0, 5, 0),
		Vector3.new(0, -34, 0),
		terrainParams
	)

	return hit ~= nil
		and hit.Material == Enum.Material.Water
end

function state.isBodyActuallyInWater(character, root)
	if not character or not root then return false end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	-- The normal Roblox state is authoritative when it is available.
	if humanoid
		and humanoid:GetState()
			== Enum.HumanoidStateType.Swimming then
		return true
	end

	-- Terrain water around the BODY, not a broad area around the shoreline.
	-- Sample root + lower body so standing/submerged animals are caught.
	if isPositionInWaterTerrain(
		root.Position,
		3.25,
		4.5
	) then
		return true
	end

	if isPositionInWaterTerrain(
		root.Position - Vector3.new(0, 2.25, 0),
		2.75,
		3.5
	) then
		return true
	end

	if state.isDirectWaterContact(root) then
		return true
	end

	-- Some Savannah water is represented by MainWaterPart. Only count it when
	-- the body is geometrically at the part's surface/volume; being above dry
	-- Terrain elsewhere in the huge X/Z footprint must NOT count as water.
	local waterPart =
		workspace:FindFirstChild("MainWaterPart")

	if waterPart and waterPart:IsA("BasePart") then
		local localPoint =
			waterPart.CFrame:PointToObjectSpace(
				root.Position
			)

		local half =
			waterPart.Size * 0.5

		local insideXZ =
			math.abs(localPoint.X) <= half.X + 1.5
			and math.abs(localPoint.Z) <= half.Z + 1.5

		local nearSurface =
			localPoint.Y <= half.Y + 5
			and localPoint.Y >= -half.Y - 4

		if insideXZ and nearSurface then
			return true
		end
	end

	return false
end

function state.dryGroundUnderCharacter(character, root)
	if not character or not root then return false end
	if root.Position.Y < config.dangerY then return false end

	-- v78 CRITICAL:
	-- Never call this "dry ground" while the animal's body is still inside
	-- Terrain water / MainWaterPart, even if solid Terrain also exists below.
	if state.isBodyActuallyInWater(
		character,
		root
	) then
		return false
	end

	if not isDinoLife
		and state.drinkIsBuriedUnderTerrain(root) then
		return false
	end

	if state.isDirectWaterContact(root) then
		return false
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = false

	local hit = workspace:Raycast(
		root.Position + Vector3.new(0, 5, 0),
		Vector3.new(0, -42, 0),
		params
	)

	return hit ~= nil
		and hit.Material ~= Enum.Material.Water
end

function state.normalizeDryLandState(character, root)
	if not state.dryGroundUnderCharacter(character, root) then
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	-- Swimming can remain stale for a moment after reaching the bank.
	-- Dry Terrain beneath the animal wins.
	if humanoid
		and humanoid:GetState()
			== Enum.HumanoidStateType.Swimming then

		pcall(
			humanoid.ChangeState,
			humanoid,
			Enum.HumanoidStateType.GettingUp
		)
	end

	return true
end

function state.findNearestDryWaterExit(root)
	if not root then return nil end

	local origin = root.Position
	local best
	local bestScore = math.huge
	local angleOffset =
		(player.UserId % 360) * math.pi / 180

	for _, radius in ipairs({
		10, 16, 24, 34, 46, 62, 82, 110, 145
	}) do
		local samples =
			radius <= 34 and 16 or 20

		for index = 0, samples - 1 do
			local angle =
				angleOffset
				+ index / samples * math.pi * 2

			local x =
				origin.X + math.cos(angle) * radius
			local z =
				origin.Z + math.sin(angle) * radius

			local hit = workspace:Raycast(
				Vector3.new(x, origin.Y + 140, z),
				Vector3.new(0, -320, 0),
				terrainParams
			)

			if hit
				and hit.Material ~= Enum.Material.Water
				and hit.Normal.Y >= 0.40 then

				local candidate =
					hit.Position
					+ Vector3.new(0, 2.5, 0)

				-- Don't select the solid bottom underneath a puddle as an exit.
				local candidateInWater =
					isPositionInWaterTerrain(
						candidate,
						2.75,
						3.5
					)

				if not candidateInWater then
					local verticalDelta =
						math.abs(
							hit.Position.Y - origin.Y
						)

					local score =
						radius
						+ verticalDelta * 0.65

					if score < bestScore then
						bestScore = score
						best = candidate
					end
				end
			end
		end

		if best and radius >= 46 then
			break
		end
	end

	return best
end

state.aquaticRiverEscape =
	state.aquaticRiverEscape
	or {
		busy = false,
		retryAt = 0,
		selfDamageGuard = false,
		fallDamageConfig = nil,
		fallDamageConfigOld = nil,
		bodyVelocity = nil,
		bodyGyro = nil,
	}

function state.aquaticFlyEnableFallGuard(character)
	local fly = state.aquaticRiverEscape

	fly.selfDamageGuard = true
	fly.fallDamageConfig = nil
	fly.fallDamageConfigOld = nil

	if not character or not AnimalConfig then
		return
	end

	local animalType = character:GetAttribute("AnimalType")
	local animalName = character:GetAttribute("AnimalName")

	local configForAnimal =
		animalType
			and animalName
			and AnimalConfig[animalType]
			and AnimalConfig[animalType][animalName]

	if type(configForAnimal) == "table" then
		fly.fallDamageConfig = configForAnimal
		fly.fallDamageConfigOld = configForAnimal.DisableFallDamage
		configForAnimal.DisableFallDamage = true
	end
end

function state.aquaticFlyDisableFallGuard()
	local fly = state.aquaticRiverEscape

	if fly.fallDamageConfig then
		pcall(function()
			fly.fallDamageConfig.DisableFallDamage =
				fly.fallDamageConfigOld
		end)
	end

	fly.fallDamageConfig = nil
	fly.fallDamageConfigOld = nil
	fly.selfDamageGuard = false
end

function state.aquaticFlyDryGroundReached(character, root, waterPart)
	if not character or not root then
		return false
	end

	if root.Position.Y < config.dangerY then
		return false
	end

	if isPositionInWaterTerrain(root.Position, 2.6, 3.5) then
		return false
	end

	if isPositionInWaterTerrain(
		root.Position - Vector3.new(0, 1.75, 0),
		2.4,
		3.0
	) then
		return false
	end

	if waterPart
		and waterPart:IsA("BasePart")
		and state.drinkMainWaterSurface then

		local exposedWater =
			state.drinkMainWaterSurface(
				waterPart,
				root.Position.X,
				root.Position.Z
			)

		if exposedWater then
			return false
		end
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = false

	local hit =
		workspace:Raycast(
			root.Position + Vector3.new(0, 8, 0),
			Vector3.new(0, -64, 0),
			params
		)

	return hit ~= nil
		and hit.Material ~= Enum.Material.Water
		and hit.Normal.Y >= 0.12
end

function state.findAquaticDryTerrainExit(character, root, preferredTarget)
	if not character or not root then
		return nil
	end

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	local waterY =
		waterPart
		and waterPart:IsA("BasePart")
		and (waterPart.Position.Y + waterPart.Size.Y * 0.5)
		or root.Position.Y

	local origin =
		Vector3.new(
			root.Position.X,
			waterY,
			root.Position.Z
		)

	local preferredDirection

	if typeof(preferredTarget) == "Vector3" then
		local delta =
			Vector3.new(
				preferredTarget.X - origin.X,
				0,
				preferredTarget.Z - origin.Z
			)

		if delta.Magnitude > 1 then
			preferredDirection = delta.Unit
		end
	end

	local directions = {}

	local function rotated(direction, degrees)
		local angle = math.rad(degrees)
		local c = math.cos(angle)
		local s = math.sin(angle)

		return Vector3.new(
			direction.X * c - direction.Z * s,
			0,
			direction.X * s + direction.Z * c
		).Unit
	end

	if preferredDirection then
		for _, degrees in ipairs({
			0, -26, 26, -52, 52, -82, 82
		}) do
			table.insert(
				directions,
				rotated(preferredDirection, degrees)
			)
		end
	else
		for index = 0, 7 do
			local angle = index / 8 * math.pi * 2
			table.insert(
				directions,
				Vector3.new(
					math.cos(angle),
					0,
					math.sin(angle)
				)
			)
		end
	end

	local clearance = state.movementRootClearance(character)

	for _, radius in ipairs({
		18, 30, 46, 66, 92, 124
	}) do
		local best
		local bestScore = math.huge

		for _, direction in ipairs(directions) do
			local point = origin + direction * radius

			local hit =
				workspace:Raycast(
					Vector3.new(
						point.X,
						waterY + 120,
						point.Z
					),
					Vector3.new(0, -250, 0),
					terrainParams
				)

			if hit
				and hit.Material ~= Enum.Material.Water
				and hit.Normal.Y >= 0.18
				and hit.Position.Y >= waterY - 0.75 then

				local stillExposedWater = false

				if waterPart
					and waterPart:IsA("BasePart")
					and state.drinkMainWaterSurface then

					stillExposedWater =
						state.drinkMainWaterSurface(
							waterPart,
							point.X,
							point.Z
						) ~= nil
				end

				if not stillExposedWater then
					local candidate =
						hit.Position
						+ Vector3.new(
							0,
							math.clamp(
								clearance * 0.38,
								1.8,
								3.2
							),
							0
						)

					local score =
						radius
						+ math.abs(
							hit.Position.Y - waterY
						) * 0.15

					if typeof(preferredTarget) == "Vector3" then
						score +=
							Vector3.new(
								preferredTarget.X - candidate.X,
								0,
								preferredTarget.Z - candidate.Z
							).Magnitude * 0.01
					end

					if score < bestScore then
						bestScore = score
						best = candidate
					end
				end
			end
		end

		if best then
			return best
		end
	end

	return nil
end

function state.aquaticRiverInfinityFlyExit(character, root, preferredTarget)
	if not character
		or not root
		or not state.isCrocOrHippoMovementCharacter(character) then
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if not humanoid or humanoid.Health <= 0 then
		return false
	end

	local waterPart = workspace:FindFirstChild("MainWaterPart")

	if state.aquaticFlyDryGroundReached(
		character,
		root,
		waterPart
	) then
		pcall(
			humanoid.ChangeState,
			humanoid,
			Enum.HumanoidStateType.GettingUp
		)
		return true
	end

	-- Fly is created ONLY if Croc/Hippo is actually still in water.
	if not state.isBodyActuallyInWater(character, root) then
		return false
	end

	local target =
		state.findAquaticDryTerrainExit(
			character,
			root,
			preferredTarget
		)

	if not target then
		runtimeMessage =
			CROC.isCharacter(character)
				and "Croc water Fly: no local dry bank found"
				or "Hippo water Fly: no local dry bank found"
		return false
	end

	state.releaseMovementNow(character, true)

	local fly = state.aquaticRiverEscape

	pcall(function()
		local old = root:FindFirstChild("MMB_AquaticFlyVelocity")
		if old then old:Destroy() end
	end)

	pcall(function()
		local old = root:FindFirstChild("MMB_AquaticFlyGyro")
		if old then old:Destroy() end
	end)

	local oldAutoRotate = humanoid.AutoRotate
	local oldWaterCollision =
		waterPart
		and waterPart:IsA("BasePart")
		and waterPart.CanCollide
		or false

	state.aquaticFlyEnableFallGuard(character)

	if waterPart and waterPart:IsA("BasePart") then
		-- Do not let the water collision plane trap the rig below the surface.
		waterPart.CanCollide = false
	end

	local BG = Instance.new("BodyGyro")
	local BV = Instance.new("BodyVelocity")

	BG.Name = "MMB_AquaticFlyGyro"
	BV.Name = "MMB_AquaticFlyVelocity"

	-- Same core constants used by Infinite Yield Fly.
	BG.P = 9e4
	BG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	BG.CFrame = root.CFrame

	BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	BV.Velocity = Vector3.zero

	BG.Parent = root
	BV.Parent = root

	fly.bodyGyro = BG
	fly.bodyVelocity = BV

	pcall(function()
		humanoid.PlatformStand = true
		humanoid.AutoRotate = false
	end)

	character:SetAttribute("MovementDisabled", false)

	local waterY =
		waterPart
		and waterPart:IsA("BasePart")
		and (waterPart.Position.Y + waterPart.Size.Y * 0.5)
		or root.Position.Y

	local clearance = state.movementRootClearance(character)

	-- Low flight only: enough to rise from the river and cross the bank lip.
	local cruiseY =
		waterY
		+ math.clamp(
			clearance * 0.30,
			0.75,
			2.25
		)

	local bankY =
		math.min(
			target.Y,
			waterY
				+ math.clamp(
					clearance * 0.48,
					1.25,
					3.25
				)
		)

	-- Match the plain Infinite Yield `fly` command: NO numeric argument is
	-- supplied and no multiplier is introduced here. sFLY() itself uses its
	-- internal active base SPEED of 50 when movement is requested.
	-- This remains completely independent from Acceleration / WalkSpeed.
	local IY_FLY_SPEED = 50

	local flatDistance =
		Vector3.new(
			target.X - root.Position.X,
			0,
			target.Z - root.Position.Z
		).Magnitude

	local deadline =
		tick()
		+ math.clamp(
			flatDistance / IY_FLY_SPEED + 2.0,
			2.5,
			7.0
		)

	local success = false

	local callOk, callError =
		pcall(function()
			while state.alive
				and character.Parent
				and root.Parent
				and humanoid.Parent
				and humanoid.Health > 0
				and tick() < deadline do

				-- First dry-ground frame = immediate UNFLY.
				if state.aquaticFlyDryGroundReached(
					character,
					root,
					waterPart
				) then
					success = true
					break
				end

				local horizontal =
					Vector3.new(
						target.X - root.Position.X,
						0,
						target.Z - root.Position.Z
					)

				local remaining = horizontal.Magnitude

				local desiredY =
					remaining > 18
						and cruiseY
						or bankY

				local hardCeiling =
					waterY
					+ math.clamp(
						clearance * 0.55,
						1.5,
						3.75
					)

				desiredY = math.min(desiredY, hardCeiling)

				if root.Position.Y > hardCeiling + 0.35 then
					desiredY = cruiseY
				end

				local flyDelta =
					Vector3.new(
						horizontal.X,
						desiredY - root.Position.Y,
						horizontal.Z
					)

				if flyDelta.Magnitude <= 0.10 then
					BV.Velocity = Vector3.zero
				else
					BV.Velocity =
						flyDelta.Unit * IY_FLY_SPEED
				end

				if horizontal.Magnitude > 0.25 then
					BG.CFrame =
						CFrame.lookAt(
							root.Position,
							root.Position + horizontal.Unit,
							Vector3.yAxis
						)
				end

				root.AssemblyAngularVelocity = Vector3.zero

				runtimeMessage =
					CROC.isCharacter(character)
						and string.format(
							"Croc water Fly: exiting river (%.0f studs)",
							remaining
						)
						or string.format(
							"Hippo water Fly: exiting river (%.0f studs)",
							remaining
						)

				RunService.Heartbeat:Wait()
			end
		end)

	-- UNFLY immediately removes both Infinite-Yield-style force objects.
	pcall(function()
		if BV and BV.Parent then BV:Destroy() end
	end)

	pcall(function()
		if BG and BG.Parent then BG:Destroy() end
	end)

	fly.bodyVelocity = nil
	fly.bodyGyro = nil

	if root and root.Parent then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	pcall(function()
		humanoid.PlatformStand = false
		humanoid.AutoRotate = oldAutoRotate ~= false
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end)

	character:SetAttribute("MovementDisabled", false)

	if success then
		if waterPart and waterPart:IsA("BasePart") then
			waterPart.CanCollide = false
		end

		-- Keep the anti-fall guard for two landing frames only.
		for _ = 1, 2 do
			RunService.Heartbeat:Wait()
		end

		state.aquaticFlyDisableFallGuard()

		runtimeMessage =
			CROC.isCharacter(character)
				and "Croc water Fly OFF: dry Terrain reached"
				or "Hippo water Fly OFF: dry Terrain reached"

		return true
	end

	if waterPart and waterPart:IsA("BasePart") then
		waterPart.CanCollide = oldWaterCollision
	end

	state.aquaticFlyDisableFallGuard()

	if not callOk then
		runtimeMessage =
			"Aquatic Fly error: " .. tostring(callError)
	end

	return false
end

function state.moveAquaticToDryTerrain(character, root, preferredTarget)
	if not character or not root then
		return false
	end

	local controller = state.aquaticRiverEscape

	if controller.busy then
		return false
	end

	if tick() < (controller.retryAt or 0) then
		return false
	end

	-- Crocodile/Hippo: Fly is allowed ONLY while escaping water.
	if state.isCrocOrHippoMovementCharacter(character) then
		controller.busy = true

		local ok =
			state.aquaticRiverInfinityFlyExit(
				character,
				root,
				preferredTarget
			)

		controller.busy = false
		controller.retryAt = ok and 0 or tick() + 1.25
		return ok
	end

	-- Other aquatic animals keep the prior physical bank movement.
	local target =
		state.findAquaticDryTerrainExit(
			character,
			root,
			preferredTarget
		)

	if not target then
		return false
	end

	setAquaticWaterCollision(character, true)

	local moved =
		safeMoveToPosition(
			target,
			7,
			nil,
			{
				purpose = "safety",
				tolerance =
					math.clamp(
						state.movementFootprint(character) * 0.65,
						8,
						15
					),
				vertical = false,
				forceMoveToLand = true,
				constantSpeed = true,
				stopOnDryGround = true,
				maxDuration = 180,
			}
		)

	character, root = characterParts()

	if moved
		and character
		and root
		and state.normalizeDryLandState(character, root) then

		setAquaticWaterCollision(character, false)
		state.releaseMovementNow(character, true)
		return true
	end

	return false
end

local function isNearSavedSwimLocation(root, radius)
	if not root or not state.questSwimPosition then return false end

	local target = state.questSwimPosition
	local horizontal = Vector3.new(
		root.Position.X - target.X,
		0,
		root.Position.Z - target.Z
	).Magnitude

	return horizontal <= (radius or 68)
end

local function isValidSwimQuestWater(root)
	if not root or not state.questSwimPosition then return false end

	-- CRITICAL v65:
	-- A random puddle / Drink prompt is NEVER valid for the Swim quest.
	-- The mission only runs around the fixed saved swim farm location.
	if not isNearSavedSwimLocation(root, 68) then
		return false
	end

	if isStandingInWater(root) then
		return true
	end

	-- Wider terrain confirmation is allowed ONLY after confirming proximity
	-- to the saved Swim location.
	if isPositionInWaterTerrain(root.Position, 12, 16) then
		return true
	end

	-- The exact saved point is known to be the intended Swim area. Near the
	-- center, trust that fixed point even if the animal HRP is awkwardly placed.
	if isNearSavedSwimLocation(root, 34) then
		local _, _, humanoid = characterParts()
		if humanoid then
			pcall(
				humanoid.ChangeState,
				humanoid,
				Enum.HumanoidStateType.Swimming
			)
		end
		setSubState("Swimming")
		return true
	end

	return false
end


function state.drinkIsUpsideDown(root)
	if not root then return false end
	return root.CFrame.UpVector.Y < 0.35
end

function state.drinkUprightCharacter(character, root, faceTowards)
	if not character or not root or not root.Parent then return false end

	local forward
	if faceTowards then
		local flatTarget = Vector3.new(
			faceTowards.X - root.Position.X,
			0,
			faceTowards.Z - root.Position.Z
		)
		if flatTarget.Magnitude > 0.5 then
			forward = flatTarget.Unit
		end
	end

	if not forward then
		local look = root.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		if flatLook.Magnitude > 0.25 then
			forward = flatLook.Unit
		else
			local right = root.CFrame.RightVector
			local flatRight = Vector3.new(right.X, 0, right.Z)
			forward = flatRight.Magnitude > 0.25
				and flatRight.Unit
				or Vector3.new(0, 0, -1)
		end
	end

	local ok = pcall(function()
		root.CFrame = CFrame.lookAt(
			root.Position,
			root.Position + forward,
			Vector3.yAxis
		)

		root.AssemblyAngularVelocity = Vector3.zero
		local velocity = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(
			velocity.X * 0.25,
			math.clamp(velocity.Y, -1.5, 2),
			velocity.Z * 0.25
		)
		character:SetAttribute("MovementDisabled", false)
	end)

	if ok then
		state.drinkSearch.upsideDownSince = nil
		state.drinkSearch.lastUprightAt = tick()
	end

	return ok
end

function state.drinkPostureWatch(character, root, humanoid)
	if not drinkingToFull
		or state.questSwimActive
		or not character
		or not root
		or not humanoid then

		state.drinkSearch.upsideDownSince = nil
		state.drinkSearch.waterHealth = nil
		return false
	end

	local now = tick()
	local inWater = isStandingInWater(root)
		or state.drinkSearch.undergroundMode
	local upsideDown = state.drinkIsUpsideDown(root)

	if upsideDown then
		if not state.drinkSearch.upsideDownSince then
			state.drinkSearch.upsideDownSince = now
		end

		local invertedFor = now - state.drinkSearch.upsideDownSince

		-- Pequeno flip durante o ragdoll é normal. Preso invertido não é.
		if invertedFor >= 0.65
			and now - (state.drinkSearch.lastUprightAt or 0) >= 0.75 then

			state.drinkUprightCharacter(
				character,
				root,
				state.drinkSearch.currentWaterPoint
			)
			runtimeMessage = "Agua: animal virou; corrigindo postura"
		end

		local maxInverted = state.drinkSearch.undergroundMode and 1.5 or 2.5
		if inWater and invertedFor >= maxInverted then
			state.drinkEmergencyEscape(
				character,
				root,
				"Watchdog agua: animal preso de ponta-cabeca; saindo da fonte"
			)
			return true
		end
	else
		state.drinkSearch.upsideDownSince = nil
	end

	-- Dano enquanto parado na água para beber é tratado como risco de afogamento.
	if inWater then
		local health = humanoid.Health
		local maxHealth = math.max(humanoid.MaxHealth, 1)

		if state.drinkSearch.waterHealth == nil then
			state.drinkSearch.waterHealth = health
			state.drinkSearch.waterHealthAt = now
		elseif health > state.drinkSearch.waterHealth then
			state.drinkSearch.waterHealth = health
			state.drinkSearch.waterHealthAt = now
		else
			local lost = state.drinkSearch.waterHealth - health
			local elapsed = now - (state.drinkSearch.waterHealthAt or now)

			local damageLimit = state.drinkSearch.undergroundMode and 0.03 or 0.05
			if elapsed <= 5 and lost >= maxHealth * damageLimit then
				state.drinkEmergencyEscape(
					character,
					root,
					"Watchdog agua: tomando dano enquanto bebia; abortando antes de afogar"
				)
				return true
			elseif elapsed > 5 then
				state.drinkSearch.waterHealth = health
				state.drinkSearch.waterHealthAt = now
			end
		end
	else
		state.drinkSearch.waterHealth = nil
		state.drinkSearch.waterHealthAt = 0
	end

	return false
end

local forcingPostDrinkMove = false

local function ensureOnSolidGround(
	targetPosition,
	label,
	allowDuringGrowthReset
)
	label = label or "safe ground"
	criticalRecoveryActive = true

	-- criticalRecoveryActive already blocks competing controllers.
	-- Preserve the user's Auto Eat/Drink toggle choices.
	for attempt = 1, 3 do
		local character, root = characterParts()
		if not character or not root then break end

		local inVoid =
			root.Position.Y < config.dangerY

		local buried =
			not isDinoLife
			and state.drinkIsBuriedUnderTerrain(root)

		runtimeMessage = string.format(
			"Moving safely to %s (%d/3)",
			label,
			attempt
		)

		local moved = safeMoveToPosition(
			targetPosition,
			7,
			nil,
			{
				purpose = "safety",
				tolerance = 12,

				-- Only a character that is ACTUALLY in the void/buried may use the
				-- vertical recovery motor. Once above Terrain, safety routes must use
				-- the same reliable Humanoid:MoveTo motor as Move To / Zone.
				vertical = inVoid or buried,
				forceMoveToLand = not inVoid and not buried,

				-- Above Terrain, use normal land movement and stop after dry ground
				-- is genuinely confirmed. Never make a healthy land animal slide via
				-- the vertical/velocity recovery motor.
				constantSpeed = not inVoid and not buried,
				stopOnDryGround = not inVoid and not buried,

				-- v108: quest Growth-reset staging is an intentional safety
				-- movement performed while the exclusive reset lock is active.
				allowDuringGrowthReset =
					allowDuringGrowthReset == true,

				maxDuration = 240,
			}
		)

		task.wait(0.18)

		character, root = characterParts()

		if character
			and root
			and state.normalizeDryLandState(
				character,
				root
			) then

			runtimeMessage =
				"Safe ground confirmed at "
				.. label

			if not forcingPostDrinkMove then
				criticalRecoveryActive = false
			end

			return true
		end

		if character and root then
			runtimeMessage = string.format(
				"Still unsafe (void:%s directWater:%s terrain:%s); retrying",
				tostring(
					root.Position.Y < config.dangerY
				),
				tostring(
					state.isDirectWaterContact(root)
				),
				tostring(
					not isDinoLife
						and state.drinkIsBuriedUnderTerrain(root)
				)
			)
		end

		if not moved then
			task.wait(0.12)
		end
	end

	if not forcingPostDrinkMove then
		criticalRecoveryActive = false
	end

	return false
end

