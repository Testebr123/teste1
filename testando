function state.questShouldShowInLive(quest, records, character, currentAnimal, currentZone, currentPack)
	if type(quest) ~= "table"
		or type(quest.props) ~= "table"
		or state.questGroup.questComplete(quest) then
		return false
	end

	if state.questIsProgressingNow(
		quest,
		records,
		character,
		currentAnimal,
		currentZone,
		currentPack
	) then
		return true
	end

	local props = quest.props

	-- Keep the mission visible while a survival routine temporarily pauses it.
	-- This is what the farm is actively working toward, even if progress is not
	-- changing during this exact frame.
	if isTravelQuestForAutoRun(props) and questTravelWanted then
		return true
	end

	if isSwimQuest(props) and state.questSwimActive then
		return true
	end

	if props.QuestType == "ZoneTime" and questTargetZoneName then
		local targetZone = findZoneInQuest(quest)
		return type(targetZone) == "string"
			and targetZone:lower() == questTargetZoneName:lower()
	end

	if state.questIsGrowthQuest(quest)
		and (state.questGrowthReset.busy or state.questGrowthReset.active) then
		return true
	end

	return false
end

function state.questBuildActiveStatus(quests)
	if not state.autoQuests then
		return state.hudEnglishStatus(questStatusText), 1
	end

	quests = type(quests) == "table" and quests or getAllQuests()

	local records = savedCharacters()
	local character = player.Character
	local currentAnimal = character and character:GetAttribute("AnimalName")

	if (type(currentAnimal) ~= "string" or currentAnimal == "") and character then
		currentAnimal = CROC.getAnimalName(character)
	end

	local currentZone = getPlayerZoneName()
	local handler = state.questGroup.resolveHandler()
	local currentPack = handler and state.questGroup.getCurrentPack(handler) or nil

	local lines = {}

	for _, quest in ipairs(quests) do
		if state.questShouldShowInLive(
			quest,
			records,
			character,
			currentAnimal,
			currentZone,
			currentPack
		) then
			local title = tostring(
				quest.props.Title
					or quest.entry.QuestUniqueKey
					or "Quest"
			)

			local progress = state.questFormatProgress(quest) or "In progress"
			local suffix = ""

			if quest.props.QuestType == "ZoneTime" then
				local zone = findZoneInQuest(quest)
				if zone then suffix = " · " .. zone end
			elseif quest.props.QuestType == "GroupTime" and currentPack then
				suffix = string.format(
					" · %d animals",
					state.questGroup.memberCount(currentPack)
				)
			elseif isSwimQuest(quest.props) then
				suffix = " · Swimming"
			elseif isLandDistanceQuest(quest.props) then
				suffix = " · Running"
			elseif state.questIsGrowthQuest(quest) then
				suffix = " · Growing"
			end

			table.insert(
				lines,
				"• " .. title .. "  —  " .. progress .. suffix
			)
		end
	end

	if #lines == 0 then
		return state.hudEnglishStatus(questStatusText), 1
	end

	return table.concat(lines, "\n"), #lines
end

local function getQuestNativePlanarSpeed(root)
	if not root then return 0 end
	local velocity = root.AssemblyLinearVelocity
	return Vector3.new(velocity.X, 0, velocity.Z).Magnitude
end

local function getQuestMoveSpeed(character)
	return state.safeMovementSpeed(character)
end

function state.questGetAcceleration(character)
	return state.rawMovementAcceleration(
		character
	) or 0
end

function state.questGetGrowthRatio(character)
	return state.movementGrowthRatio(
		character
	)
end

function state.questMotionCalibrationKey(character, mode)
	if not character then return "none" end

	local animal = tostring(character:GetAttribute("AnimalName") or character.Name)
	local growth = state.questGetGrowthRatio(character)
	local bucket = math.floor(growth * 20) -- recalcula a cada ~5%

	return table.concat({
		animal,
		tostring(bucket),
		tostring(mode or "Land"),
		tostring(state.questMoveSubState or "Running"),
	}, "|")
end

function state.questGetTargetMoveSpeed(character, mode)
	local target, acceleration, growth =
		state.dynamicMovementSpeed(
			character,
			mode
		)

	return math.max(1, target),
		acceleration,
		growth
end

function state.questUpdateMotionTarget(character, root, mode)
	local cal = state.questMotionCal
	local key = state.questMotionCalibrationKey(character, mode)
	local target, acceleration, growth =
		state.questGetTargetMoveSpeed(character, mode)

	cal.key = key
	cal.acceleration = acceleration
	cal.growth = growth
	cal.targetSpeed = target
	cal.actualSpeed = getQuestNativePlanarSpeed(root)

	if tick() - (cal.lastPrintAt or 0) >= 5 then
		cal.lastPrintAt = tick()
		print(string.format(
			"[MMB Motion] %s | Acceleration %.2f | Growth %.0f%% | Target %.2f | Actual %.2f",
			tostring(mode),
			acceleration,
			growth * 100,
			target,
			cal.actualSpeed
		))
	end

	return cal
end

function state.questApplyGrowthScaledVelocity(character, root, direction, mode, dt)
	if not root or not direction then return end

	local cal = state.questUpdateMotionTarget(character, root, mode)
	local currentVelocity = root.AssemblyLinearVelocity
	local planar = Vector3.new(
		currentVelocity.X,
		0,
		currentVelocity.Z
	).Magnitude

	local target = cal.targetSpeed
	local acceleration = cal.acceleration

	-- Acceleration controla a RAMPA. O alvo já foi reduzido pelo Growth.
	-- Se o atributo for muito pequeno/atrasar a replicação, ainda usamos uma
	-- rampa mínima para o Auto Run começar imediatamente.
	local ramp = math.max(acceleration, target * 1.8, 14)
	local frameDt = math.max(dt or 0.05, 0.01)

	local nextSpeed
	if planar < target then
		nextSpeed = math.min(target, planar + ramp * frameDt)
	else
		nextSpeed = math.max(target, planar - ramp * frameDt * 1.4)
	end

	root.AssemblyLinearVelocity = Vector3.new(
		direction.X * nextSpeed,
		currentVelocity.Y,
		direction.Z * nextSpeed
	)

	cal.actualSpeed = nextSpeed
end


local NAMES = { "Jack","John","Evian","Aiman","Adam","Alex","Ben","Sam","Max","Leo","Noah","Liam","Omar","Zain","Ali","Ryan","Ethan","Mason","Dylan","Lucas","Harry","Jacob","Henry","Isaac","Yusuf","Amir","Daniel","David","Aaron","Oscar","Toby","Kian","Kai","Jay","Sean","Chris","Kevin","Mark" }
local function uniqueName()
	local used = {}
	for _, entry in ipairs(savedCharacters()) do if entry.CharacterName then used[entry.CharacterName] = true end end
	for _, name in ipairs(NAMES) do if not used[name] then return name end end
	return "Slot" .. tostring(math.floor(os.clock() * 1000))
end

local function createNextSlot()
	if not CreateRemote or not ResetRemote then return false end
	local character = player.Character
	if not character then return false end

	if not state.atSlotSwitchPoint()
		and not state.prepareCurrentSlotForSwitch(
			"Growth: staging current animal before creating next slot"
		) then
		return false
	end

	local entry = {
		CharacterName = uniqueName(),
		AnimalName = character:GetAttribute("AnimalName") or "Elephant",
		Gender = state.newSlotGender or character:GetAttribute("Gender") or "Female",
		Skin = character:GetAttribute("Skin") or "Default",
		GrowthPercentage = 0,
	}
	pcall(ResetRemote.InvokeServer, ResetRemote)
	task.wait(2)
	local ok = pcall(CreateRemote.InvokeServer, CreateRemote, entry.CharacterName, entry.AnimalName, entry.Gender, entry.Skin)
	if not ok then return false end
	task.wait(2)
	return spawnSlot(entry, true)
end

local growthBusy = false
function state.coinFarmUniqueAnimals(records)
	records = records or savedCharacters()

	local byKey = {}
	for _, entry in ipairs(records) do
		if type(entry) == "table"
			and type(entry.AnimalName) == "string"
			and entry.AnimalName ~= "" then

			local key = state.questAnimalKey(entry.AnimalName)
			if key ~= "" and not byKey[key] then
				byKey[key] = entry.AnimalName
			end
		end
	end

	local animals = {}
	for _, animalName in pairs(byKey) do
		animals[#animals + 1] = animalName
	end

	table.sort(animals, function(a, b)
		return a:lower() < b:lower()
	end)

	return animals
end

function state.coinFarmFindPreferredSlot(records, animalName)
	if type(animalName) ~= "string" or animalName == "" then
		return nil
	end

	records = records or savedCharacters()
	local wanted = state.questAnimalKey(animalName)
	local best
	local bestGrowth = -math.huge

	for _, entry in ipairs(records) do
		if type(entry) == "table"
			and type(entry.AnimalName) == "string"
			and state.questAnimalKey(entry.AnimalName) == wanted then

			local growth = tonumber(entry.GrowthPercentage) or 0
			if growth <= 1 then
				growth *= 100
			end

			-- If the user owns many slots of the same animal, use ONE slot only:
			-- prefer the most-grown one because AFK Coin does not need to rotate
			-- through duplicate species.
			if not best
				or growth > bestGrowth
				or (
					growth == bestGrowth
					and tostring(entry.CharacterName or "")
						< tostring(best.CharacterName or "")
				) then

				best = entry
				bestGrowth = growth
			end
		end
	end

	return best
end

function state.coinFarmRenderPreferred()
	if renders and renders.coinFarmAnimal then
		pcall(renders.coinFarmAnimal)
	end
end

function state.coinFarmRequestPreferredSwitch(reason)
	if not state.farmCoins then
		state.coinFarmSwitchPending = false
		state.coinFarmSwitchReason = nil
		return
	end

	local preferred = state.coinFarmPreferredAnimal

	if type(preferred) ~= "string" or preferred == "" then
		state.coinFarmSwitchPending = false
		state.coinFarmSwitchReason = nil

		local character = player.Character
		local currentAnimal = character
			and character:GetAttribute("AnimalName")
			or "current animal"

		questStatusText =
			"AFK Coin Farm: keeping current animal -> "
			.. tostring(currentAnimal)

		runtimeMessage =
			"No AFK Coin animal selected; keeping the animal active when Coin Farm started"
		return
	end

	state.coinFarmSwitchPending = true
	state.coinFarmSwitchReason = reason or "AFK Coin Farm started"
	state.coinFarmRetryAt = 0

	questStatusText =
		"AFK Coin Farm: preferred animal -> "
		.. preferred
end

function state.coinFarmTryPreferredSwitch()
	if state.questGroup
		and state.questGroup.coop
		and (
			state.questGroup.coop.helperActive
			or state.questGroup.coop.helperSwitching
		) then
		return
	end

	if not state.farmCoins
		or not state.coinFarmSwitchPending
		or state.coinFarmSwitching
		or tick() < (state.coinFarmRetryAt or 0) then
		return
	end

	local preferred = state.coinFarmPreferredAnimal
	if type(preferred) ~= "string" or preferred == "" then
		state.coinFarmSwitchPending = false
		return
	end

	local character = player.Character
	local currentAnimal = character
		and character:GetAttribute("AnimalName")

	if type(currentAnimal) == "string"
		and state.questAnimalKey(currentAnimal)
			== state.questAnimalKey(preferred) then

		state.coinFarmSwitchPending = false
		state.coinFarmSwitchReason = nil

		questStatusText =
			"AFK Coin Farm: "
			.. preferred
			.. " selected"

		runtimeMessage =
			"AFK Coin preferred animal already active: "
			.. preferred
		return
	end

	-- Never fight Eat/Drink, damage recovery, Growth reset, a quest switch,
	-- or another movement controller. The preferred species remains pending.
	if growthBusy
		or state.busy
		or questSwitchingAnimal
		or criticalRecoveryActive
		or DAMAGE.active
		or state.questGrowthReset.exclusive
		or state.questGrowthReset.busy
		or drinkingToFull
		or eatingToFull
		or carcassEatBusy
		or BABOON.busy
		or GIRAFFE.busy
		or CROC.approachBusy
		or forcingPostDrinkMove then
		return
	end

	local target = state.coinFarmFindPreferredSlot(
		savedCharacters(),
		preferred
	)

	-- The selector only lists existing species, but a slot can be removed after
	-- selection. Fail safely: clear the stale preference and keep current animal.
	if not target then
		state.coinFarmPreferredAnimal = nil
		state.coinFarmSwitchPending = false
		state.coinFarmSwitchReason = nil

		runtimeMessage =
			"Selected AFK Coin animal no longer has a saved slot; keeping current animal"
		questStatusText =
			"AFK Coin Farm: Current animal (saved selection unavailable)"

		state.coinFarmRenderPreferred()
		return
	end

	state.coinFarmSwitching = true
	state.coinFarmSwitchPending = false

	local requestedAnimal = preferred
	local previousAutoEat = state.autoEat
	local previousAutoDrink = state.autoDrink

	-- Prevent survival loops from trying to operate on the disappearing
	-- character during the short Reset -> Spawn transition.
	state.autoEat = false
	state.autoDrink = false
	blockClientSubState = false
	state.questSetW(false)
	DAMAGE.cooldownUntil = math.max(
		DAMAGE.cooldownUntil or 0,
		tick() + 20
	)

	runtimeMessage =
		"AFK Coin Farm: switching to preferred animal "
		.. requestedAnimal

	questStatusText =
		"AFK Coin Farm: switching -> "
		.. requestedAnimal

	task.spawn(function()
		if not state.prepareCurrentSlotForSwitch(
			"AFK Coin: staging current animal before preferred-slot switch"
		) then
			state.coinFarmSwitching = false
			state.coinFarmSwitchPending = true
			state.coinFarmRetryAt = tick() + 3
			state.autoEat = previousAutoEat
			state.autoDrink = previousAutoDrink
			runtimeMessage = "AFK Coin switch postponed: staging failed"
			return
		end

		if ResetRemote then
			pcall(ResetRemote.InvokeServer, ResetRemote)
			task.wait(1.35)
		end

		-- Even if Coin Farm/selection changed while the menu was open, always
		-- finish spawning something so the player is never left slotless.
		local spawned = spawnSlot(target, true)

		state.coinFarmSwitching = false

		if state.farmCoins then
			state.applySurvivalDefaults(false)
		else
			state.autoEat = previousAutoEat
			state.autoDrink = previousAutoDrink
		end

		if renders then
			if renders.autoEat then renders.autoEat() end
			if renders.autoDrink then renders.autoDrink() end
		end

		if spawned then
			if state.farmCoins
				and type(state.coinFarmPreferredAnimal) == "string"
				and state.questAnimalKey(state.coinFarmPreferredAnimal)
					~= state.questAnimalKey(requestedAnimal) then

				-- User changed the dropdown during the switch. Complete this
				-- spawn first, then honor the NEW choice on the next pass.
				state.coinFarmSwitchPending = true
				state.coinFarmRetryAt = tick() + 1
				runtimeMessage =
					"AFK Coin animal selection changed; applying new preference"
			else
				state.coinFarmSwitchPending = false
				questStatusText =
					"AFK Coin Farm: "
					.. requestedAnimal
				runtimeMessage =
					"AFK Coin preferred animal active: "
					.. requestedAnimal
			end
		elseif state.farmCoins then
			state.coinFarmSwitchPending = true
			state.coinFarmRetryAt = tick() + 10
			runtimeMessage =
				"AFK Coin preferred animal spawn was not confirmed; retrying later"
		end
	end)
end


function state.growthPrideReturnStep()
	local character, root =
		characterParts()

	if not character or not root then
		return
	end

	if not state.growthPrideRestrictionActive(
		character
	) then
		if state.growthPride.returning
			and state.safeMove
			and state.safeMove.active
			and state.safeMove.reason == "growth_home" then

			state.safeMove.cancelToken += 1
			state.releaseMovementNow(
				character,
				true
			)
		end

		state.growthPride.returning = false
		state.growthPride.returnRequested = false
		return
	end

	if state.growthPrideInside(
		character,
		root
	) then
		state.growthPride.returning = false
		state.growthPride.returnRequested = false
		return
	end

	local water =
		tonumber(
			character:GetAttribute("Water")
		) or 100

	-- ONLY allowed reason to remain outside Pride during Growth: drinking.
	-- Let Auto Drink leave, drink, and complete its dry-bank exit first.
	if (
		state.autoDrink
		and (
			drinkingToFull
			or water <= 75
		)
	)
		or forcingPostDrinkMove
		or criticalRecoveryActive
		or DAMAGE.active
		or state.questGrowthReset.exclusive
		or growthBusy
		or questSwitchingAnimal then
		return
	end

	-- Do not fight another movement controller. As soon as it releases, Pride
	-- home wins unless that controller was the water exception above.
	if state.busy
		or state.growthPride.returning
		or tick()
			- (state.growthPride.lastReturnAt or 0)
			< 1.2 then
		return
	end

	state.growthPride.returning = true
	state.growthPride.returnRequested = false
	state.growthPride.lastReturnAt = tick()

	runtimeMessage =
		"Growth herbivore: returning to Pride Rock home"

	task.spawn(function()
		safeMoveToPosition(
			state.growthPride.home,
			10,
			nil,
			{
				purpose = "growth_home",
				forceMoveToLand = true,
				tolerance = 18,
				speedScale = 1,
				maxDuration = 360,
				routeCheckInterval = 0.20,
				routeCheck = function()
					local liveCharacter, liveRoot =
						characterParts()

					if liveCharacter
						and liveRoot
						and state.growthPrideInside(
							liveCharacter,
							liveRoot
						) then
						return true, "pride_entered"
					end

					return false
				end,
			}
		)

		task.wait(0.15)

		local liveCharacter, liveRoot =
			characterParts()

		state.growthPride.returning = false

		if liveCharacter
			and liveRoot
			and state.growthPrideInside(
				liveCharacter,
				liveRoot
			) then

			runtimeMessage =
				"Growth herbivore: Pride Rock home confirmed"
		else
			state.growthPride.returnRequested = true
		end
	end)
end

task.spawn(function()
	while state.alive do
		pcall(
			state.growthPrideReturnStep
		)
		task.wait(0.55)
	end
end)

state.growthTopUp = state.growthTopUp or {
