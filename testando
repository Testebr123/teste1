	if self.currentOwner == "Water" and tonumber(self.progressWater) and context.water > self.progressWater + 0.02 then progressed = true end
	if self.currentOwner == "Safety" then
		local hazard = self:SafetyHazard(context)
		if not hazard then progressed = true end
	end
