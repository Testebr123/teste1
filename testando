local function normalizeQuestBucket(bucket)
	local result = {}
	if type(bucket) ~= "table" then return result end
	for index, entry in pairs(bucket) do
		if type(entry) == "table" and type(entry.QuestUniqueKey) == "string" then
			table.insert(result, {
				index = index,
				data = entry,
			})
		end
	end
	table.sort(result, function(a, b)
		local an, bn = tonumber(a.index), tonumber(b.index)
		if an and bn then return an < bn end
		return tostring(a.index) < tostring(b.index)
	end)
	return result
end

local function getQuestBucket(key)
	local replication = resolveReplication()
	if not replication then return {} end
	local ok, bucket = pcall(replication.GetKeyData, key)
	if not ok or type(bucket) ~= "table" then
		if type(replication.GetData) == "function" then
			local dataOk, allData = pcall(replication.GetData)
			if dataOk and type(allData) == "table" then bucket = allData[key] end
		end
	end
	return normalizeQuestBucket(bucket)
end

local function getAllQuests()
	local result = {}
	for _, spec in ipairs({
		{ category = "Daily", dataKey = "DailyQuests" },
		{ category = "Weekly", dataKey = "WeeklyQuests" },
	}) do
		for _, wrapped in ipairs(getQuestBucket(spec.dataKey)) do
			local entry = wrapped.data
			local storageBucket = QuestsStorage and QuestsStorage[spec.dataKey]
			local props = storageBucket and storageBucket[entry.QuestUniqueKey]
			if props then
				local id = spec.category .. "|" .. entry.QuestUniqueKey
				if not questSessionClaimed[id] then
					table.insert(result, {
						id = id,
						category = spec.category,
						dataKey = spec.dataKey,
						entry = entry,
						props = props,
					})
				end
			end
		end
	end
	return result
end


