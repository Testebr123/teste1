	if manager and type(manager.CancelOwner) == "function" then
		pcall(manager.CancelOwner, manager, "Quest", reason or (tostring(owner) .. " survival handoff"), true)
	end
end

-- Fica true enquanto forcePostDrinkMove ou ensureOnSolidGround estão
-- ativamente controlando o personagem (saindo da água/void). Enquanto isso,
-- nenhuma outra rotina (comer, beber, trocar de slot) pode mexer no
-- personagem — senão ficam brigando pra mover pra lugares diferentes
-- ao mesmo tempo (foi isso que matou um Rex no Dino Life).
criticalRecoveryActive = false
local eatingSourcePosition
local eatingTargetReachedAt
local drinkingSourcePosition
local swimBarrier
local swimAnchorPosition
local ignoredGrassPosition
local ignoredGrassUntil = 0
local lastObservedFood
local lastFoodIncreaseAt = tick()
local nextEmergencyGrassCheck = 0
local nextCarnivoreExploreCheck = 0
local savannahCarcassSpawnIndex = 0
local savannahCarcassCurrentSpawn
local savannahCarcassSpawnVisited = {}
local SAVANNAH_CARCASS_SPAWN_WAIT = 15
local SAVANNAH_ACTIVE_CARCASS_REVISIT = 35

function state.carnivorePassiveScavengeAllowed(
	character
)
	if not character
		or not state.autoEat
		or not isCarnivoreCharacter(
			character
		) then

		return false
	end

	-- Reset Spawn / slot switching always wins.
	if state.slotSwitchStagingActive == true
		or state.questGrowthReset.exclusive
		or (
			state.questGrowthReset
			and state.questGrowthReset.stagingBusy
		)
		or criticalRecoveryActive
		or DAMAGE.active
		or (
			state.questSlots
			and state.questSlots.busy
		)
		or preSwitchFoodTarget ~= nil
		or (
			state.slotGuardian
			and state.slotGuardian.recovering
		) then

		return false
	end

	-- Once an Auto-Grow slot is already complete and its vitals are safe enough to
	-- switch, passive scavenging is over. Even between failed Reset Point attempts,
	-- do not let a full carnivore start another carcass patrol and steal the body.
	if state.autoGrowModeActive
		and state.autoGrowModeActive()
		and state.autoGrowCurrentSlotComplete
		and state.autoGrowCurrentSlotComplete(character) then

		local food = tonumber(character:GetAttribute("Food")) or 100
		local water = tonumber(character:GetAttribute("Water")) or 100
		if food > 50 and water > 50 then
			return false
		end
	end

	-- Re-execution / completed-quest safety:
	-- never trust an inherited questMovementPriorityPending flag without a fresh
	-- lightweight classification of the currently replicated quests.
	if state.autoQuests
		and state.questRefreshMovementPrioritySnapshot then

		pcall(
			state.questRefreshMovementPrioritySnapshot,
			false
		)
	end

	-- AUTO QUEST PRIORITY:
	-- "always search for carcass" is an idle/no-quest policy only. While an
	-- actionable Daily/Weekly mission exists, NEVER start or continue passive
	-- spawn patrol for a new carcass. The quest survival controller will still
	-- pause at the real hunger threshold, feed to 100%, then resume the mission.
	if state.autoQuests
		and state.savannahCarcassPhysicalQuestBlocked
		and state.savannahCarcassPhysicalQuestBlocked(
			character
		) then

		return false
	end

	-- Never abandon/provoke a ZoneTime / Survive in Zone route just to hunt.
	-- If Food later becomes genuinely low, the existing zone survival policy
	-- is still allowed to feed at its survival threshold.
	if state.questZonePriorityActive()
		or (
			state.questZoneDrinkOverride
			and state.questZoneDrinkOverride.active
		) then

		return false
	end

	-- Explicit movement owned by the player or a higher priority controller
	-- must not be stolen by background scavenging.
	if state.safeMove
		and state.safeMove.active then

		local reason =
			state.safeMove.reason

		local staleFinishedQuestRoute =
			reason == "quest"
			and state.autoQuests
			and state.questMovementPriorityPending ~= true

		if not staleFinishedQuestRoute
			and (
				reason == "safety"
					or reason == "growth_home"
					or reason == "quest"
					or reason == "manual"
					or reason == "water"
			) then

			return false
		end
	end

	if state.aquaticRiverEscape
		and state.aquaticRiverEscape.survivalSuspended then

		return false
	end

	return true
end

local function resetEatingSearch(food)
	eatingSourcePosition = nil
	eatingTargetReachedAt = nil
	ignoredGrassPosition = nil
	ignoredGrassUntil = 0
	grassRetryIgnorePosition = nil
	grassRetryIgnoreUntil = 0
	lastObservedFood = food
	lastFoodIncreaseAt = tick()
end

-- Savannah carcass exploration.
--
-- PASSIVE scavenging may linger briefly at a spawn.
-- ACTIVE survival/quest feeding is different: a hungry carnivore must keep
-- physically searching. It never stands in the field waiting for a carcass to
-- stream into the current radius. It visits the nearest fresh Spawn Location,
-- scans for carcasses during the whole route, then immediately continues to the
-- next fresh spawn if nothing was found.
function state.carcassSearchSpawnUsable(part, character)
	if not part or not part.Parent or not part:IsA("BasePart") then
		return false
	end

	if not isDinoLife then
		return true
	end

	local lower = part.Name:lower()
	if lower:find("aquatic", 1, true)
		or lower:find("water", 1, true)
		or lower:find("swim", 1, true) then
		return false
	end

	local hit = workspace:Raycast(
		part.Position + Vector3.new(0, 120, 0),
		Vector3.new(0, -400, 0),
		terrainOnlyRayParams
	)

	if hit and hit.Material == Enum.Material.Water then
		return false
	end

	-- Some Dino spawn markers sit on map Parts instead of Terrain. Name filtering
	-- still excludes known aquatic waypoints, so absence of a Terrain hit alone
	-- must not leave a starving carnivore with zero search destinations.
	return true
end

local function exploreSavannahCarcassSpawns(
	passiveSearch,
	forceContinuous
)
	if not isSavannahLife and not isDinoLife then
		return false
	end

	local activeSurvivalSearch =
		passiveSearch ~= true
		or forceContinuous == true

	-- A cooldown created by an old passive patrol must NEVER freeze an active
	-- hunger recovery. This was the reason a quest carnivore could display
	-- "reacquiring food" while remaining completely stationary.
	if activeSurvivalSearch then
		nextCarnivoreExploreCheck = 0
	elseif tick() < nextCarnivoreExploreCheck then
		local remaining =
			math.max(
				0,
				nextCarnivoreExploreCheck - tick()
			)

		local spawnName =
			savannahCarcassCurrentSpawn
				and savannahCarcassCurrentSpawn.Name
				or "spawn"

		runtimeMessage =
			string.format(
				"Passive carcass patrol: scanning %s (%ds)",
				spawnName,
				math.ceil(remaining)
			)

		return true
	end

	refreshCompletionSpawns()

	local spawnParts = {}
	local liveCharacter = player.Character
	for _, part in ipairs(completionSpawnParts) do
		if state.carcassSearchSpawnUsable(part, liveCharacter) then
			spawnParts[#spawnParts + 1] = part
		end
	end

	if #spawnParts == 0 then
		runtimeMessage =
			activeSurvivalSearch
				and "Carnivore survival: no Spawn Locations available; retrying"
				or "Nenhum spawn encontrado para procurar carcaca"

		nextCarnivoreExploreCheck =
			tick()
			+ (
				activeSurvivalSearch
					and 0.75
					or SAVANNAH_CARCASS_SPAWN_WAIT
			)

		return true
	end

	local character, root =
		characterParts()

	if not character or not root then
		nextCarnivoreExploreCheck =
			tick() + 0.25
		return true
	end

	local destination
	local destinationIndex

	if activeSurvivalSearch then
		local now =
			tick()

		local bestFreshDistance =
			math.huge

		local bestFallbackDistance =
			math.huge

		local fallback
		local fallbackIndex

		-- Survival search is distance-aware. Do not cross the whole Savannah just
		-- because the round-robin index happened to point at a distant spawn.
		-- At the same time, avoid bouncing between the same two nearby spawns.
		for index, part in ipairs(spawnParts) do
			if part
				and part.Parent
				and part:IsA("BasePart") then

				local flatDistance =
					Vector3.new(
						part.Position.X - root.Position.X,
						0,
						part.Position.Z - root.Position.Z
					).Magnitude

				-- A point under the animal is not exploration. Prefer something that
				-- actually moves us into a new streaming area.
				local usefulDistance =
					flatDistance >= 28

				local lastVisited =
					savannahCarcassSpawnVisited[part]
						or 0

				local fresh =
					now - lastVisited
						>= SAVANNAH_ACTIVE_CARCASS_REVISIT

				if usefulDistance
					and fresh
					and flatDistance < bestFreshDistance then

					bestFreshDistance =
						flatDistance
					destination =
						part
					destinationIndex =
						index
				end

				if usefulDistance
					and flatDistance < bestFallbackDistance then

					bestFallbackDistance =
						flatDistance
					fallback =
						part
					fallbackIndex =
						index
				end
			end
		end

		if not destination then
			destination =
				fallback
			destinationIndex =
				fallbackIndex
		end

		-- If every spawn is extremely close, use the normal sequence as a last
		-- resort rather than staying still.
		if not destination then
			savannahCarcassSpawnIndex =
				savannahCarcassSpawnIndex
					% #spawnParts
					+ 1

			destination =
				spawnParts[
					savannahCarcassSpawnIndex
				]

			destinationIndex =
				savannahCarcassSpawnIndex
		end
	else
		-- Passive full-food scavenging keeps the old deterministic patrol order.
		savannahCarcassSpawnIndex =
			savannahCarcassSpawnIndex
				% #spawnParts
				+ 1

		destination =
			spawnParts[
				savannahCarcassSpawnIndex
			]

		destinationIndex =
			savannahCarcassSpawnIndex
	end

	if not destination
		or not destination.Parent then

		refreshCompletionSpawns()
		nextCarnivoreExploreCheck =
			tick()
			+ (
				activeSurvivalSearch
					and 0.25
					or 1
			)

		return true
	end

	savannahCarcassSpawnIndex =
		destinationIndex
			or savannahCarcassSpawnIndex

	savannahCarcassCurrentSpawn =
		destination

	if activeSurvivalSearch then
		savannahCarcassSpawnVisited[
			destination
		] = tick()

		runtimeMessage =
			"Carnivore survival: actively searching toward "
			.. destination.Name
	else
		runtimeMessage =
			"Passive carcass patrol: going to "
			.. destination.Name
	end

	local moved, reason =
		state.moveToCarcassSearchSpawn(
			destination,
			passiveSearch,
			forceContinuous
		)

	if moved then
		if reason == "locked_carcass" then
			runtimeMessage =
				"Carcass locked: finishing current food source"

			nextCarnivoreExploreCheck =
				0

		elseif reason == "fed" then
			runtimeMessage =
				"Carnivore fed on route; carcass search complete"

			nextCarnivoreExploreCheck =
				0

		elseif activeSurvivalSearch then
			-- IMPORTANT: do NOT sit at this spawn for 15 seconds. nearestCarcass()
			-- is checked before every patrol call and state.carcassOnSearchRoute()
			-- scans throughout movement. If neither saw a carcass, keep exploring.
			runtimeMessage =
				"Carnivore survival: no carcass here; moving to next spawn"

			nextCarnivoreExploreCheck =
				tick() + 0.15

		else
			runtimeMessage =
				"Passive carcass patrol: scanning "
				.. destination.Name

			nextCarnivoreExploreCheck =
				tick()
				+ SAVANNAH_CARCASS_SPAWN_WAIT
		end
	else
		if reason == "priority" then
			nextCarnivoreExploreCheck =
				0

			runtimeMessage =
				"Passive carcass patrol paused for Reset Spawn / Zone / priority"

		elseif reason == "water_priority" then
			local liveCharacter =
				player.Character

			if liveCharacter
				and state.survivalForceWaterHandoff(
					liveCharacter,
					"Carcass route yielded to Water"
				) then

				drinkingToFull =
					true

				eatingToFull =
					false

				eatingSourcePosition =
					nil

				eatingTargetReachedAt =
					nil

				if not activeCarcassCommitted then
					clearActiveCarcass(false)
				end

				runtimeMessage =
					"Carcass route paused: Auto Drink now owns survival"
			else
				runtimeMessage =
					"Carcass route paused: Water priority"
			end

			nextCarnivoreExploreCheck =
				tick() + 0.5

		elseif reason == "destination_gone" then
			refreshCompletionSpawns()

			runtimeMessage =
				"Carcass search destination disappeared; selecting another spawn"

			nextCarnivoreExploreCheck =
				tick() + 0.15

		elseif activeSurvivalSearch
			and (
				reason == "food_search_stall"
					or reason == "blocked"
					or reason == "success_without_arrival"
					or reason == "too_many_carcass_interrupts"
					or reason == "interrupted"
			) then

			-- Never retry the same failed active route in-place. Mark the current
			-- point as recently visited and choose another search direction.
			savannahCarcassSpawnVisited[
				destination
			] = tick()

			runtimeMessage =
				"Carnivore survival: search route stalled; trying another spawn"

			nextCarnivoreExploreCheck =
				tick() + 0.15
		else
			runtimeMessage =
				"Spawn search route interrupted ("
				.. tostring(reason)
				.. "); retrying"

			nextCarnivoreExploreCheck =
				tick()
				+ (
					activeSurvivalSearch
						and 0.25
						or 1.5
				)
		end
	end

	return true
end

local function removeSwimBarrier()
	if swimBarrier then swimBarrier:Destroy(); swimBarrier = nil end
	swimAnchorPosition = nil
end

local function updateSwimBarrier(root, resetAnchor)
	if not swimBarrier then
		swimBarrier = Instance.new("Folder")
		swimBarrier.Name = "FarmLocalSwimBarrier"
		swimBarrier.Parent = workspace
		for index = 1, 4 do
			local wall = Instance.new("Part")
			wall.Name = "Wall" .. index
			wall.Anchored = true
			wall.CanCollide = true
			wall.CanTouch = false
			wall.CanQuery = false
			wall.Transparency = 1
			wall.Parent = swimBarrier
		end
	end
	if resetAnchor or not swimAnchorPosition then swimAnchorPosition = root.Position end
	local center = Vector3.new(swimAnchorPosition.X, root.Position.Y, swimAnchorPosition.Z)
	local walls = swimBarrier:GetChildren()
	if #walls >= 4 then
		walls[1].Size, walls[1].CFrame = Vector3.new(16,18,2), CFrame.new(center + Vector3.new(0,0,7))
		walls[2].Size, walls[2].CFrame = Vector3.new(16,18,2), CFrame.new(center + Vector3.new(0,0,-7))
		walls[3].Size, walls[3].CFrame = Vector3.new(2,18,16), CFrame.new(center + Vector3.new(7,0,0))
		walls[4].Size, walls[4].CFrame = Vector3.new(2,18,16), CFrame.new(center + Vector3.new(-7,0,0))
	end
end

-- Crocodile: rota exclusiva de bebida pela margem.
-- MainWaterPart cobre uma area enorme e continua por baixo do Terrain.
-- Por isso NAO procuramos "onde existe agua" no X/Z: ela existe praticamente
-- em todo lugar. A margem e encontrada comparando o topo do Terrain SOLIDO
-- com a altura da superficie da MainWaterPart. Enquanto o Terrain estiver
-- acima da agua, ela esta enterrada e e ignorada. Quando o Terrain desce para
-- baixo do nivel da agua, aquela agua passa a estar exposta.
CROC.solidTerrainParams = RaycastParams.new()
CROC.solidTerrainParams.FilterType = Enum.RaycastFilterType.Include
CROC.solidTerrainParams.FilterDescendantsInstances = { workspace.Terrain }
CROC.solidTerrainParams.IgnoreWater = true
CROC.lastShoreDirection = nil
CROC.lastShorePosition = nil

function CROC.findPrideRockSpawn1()
	local spawns = workspace:FindFirstChild("Spawns")
	if not spawns then return nil end
	local part = spawns:FindFirstChild("PrideRockSpawn1", true)
	if part and part:IsA("BasePart") then return part end
	return nil
end

function CROC.getWaterSurfaceY()
	local waterPart = workspace:FindFirstChild("MainWaterPart")
	if not waterPart or not waterPart:IsA("BasePart") then return nil, nil end
	return waterPart.Position.Y + waterPart.Size.Y / 2, waterPart
end

function CROC.solidTerrainHitAt(position, castY)
	return workspace:Raycast(
		Vector3.new(position.X, castY, position.Z),
		Vector3.new(0, -1200, 0),
		CROC.solidTerrainParams
	)
end

function CROC.findVisibleShoreFrom(origin)
	local waterY = CROC.getWaterSurfaceY()
	if not waterY then return nil end

	local castY = math.max(origin.Y, waterY) + 350
	local maxRadius = 900
	local step = 5
	local directions = 72
	local exposureDepth = 0.75
	local bestPosition, bestDirection, bestDistance

	local function waterIsExposedAt(position)
		local hit = CROC.solidTerrainHitAt(position, castY)
		-- Sem Terrain solido acima/na superficie = agua visivel.
		if not hit then return true, nil end
		return hit.Position.Y <= waterY - exposureDepth, hit
	end

	for index = 0, directions - 1 do
		local angle = index / directions * math.pi * 2
		local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local lastDryDistance = nil
		local lastDryHit = nil

		for distance = 0, maxRadius, step do
			local probe = origin + direction * distance
			local exposed, hit = waterIsExposedAt(probe)

			if exposed then
				if lastDryDistance and lastDryHit then
					-- Refina a transicao terra -> agua para achar a margem real.
					local low = lastDryDistance
					local high = distance
					for _ = 1, 8 do
						local mid = (low + high) / 2
						local midExposed = waterIsExposedAt(origin + direction * mid)
						if midExposed then
							high = mid
						else
							low = mid
						end
					end

					-- Fica um pouco ANTES do inicio da agua. Assim o corpo permanece
					-- no Terrain, mas a cabeca fica perto o bastante para beber.
					local shoreDistance = math.max(0, low - 1.25)
					local shoreProbe = origin + direction * shoreDistance
					local shoreHit = CROC.solidTerrainHitAt(shoreProbe, castY) or lastDryHit

					if shoreHit and (not bestDistance or shoreDistance < bestDistance) then
						bestDistance = shoreDistance
						bestPosition = shoreHit.Position
						bestDirection = direction
					end
				end
				break
			end

			lastDryDistance = distance
			lastDryHit = hit
		end
	end

	return bestPosition, bestDirection, bestDistance
end

function CROC.moveToPrideRock(prideRock)
	if not prideRock or not prideRock.Parent then return false end

	return safeMoveToPosition(
		prideRock.Position,
		8,
		prideRock.Position + prideRock.CFrame.LookVector * 12,
		{
			purpose = "water",
			tolerance = 18,
			speedScale = 0.70,
		}
	)
end

function CROC.approachDrink()
	if state.questGrowthReset.exclusive then return false end
	if CROC.approachBusy or criticalRecoveryActive then return false end

	local character, root = characterParts()

	if not character
		or not root
		or not state.isCrocOrHippoMovementCharacter(
			character
		) then
		return false
	end

	CROC.approachBusy = true
	removeSwimBarrier()
	drinkingSourcePosition = nil

	-- Normal drinking uses the solid MainWaterPart. Only underwater exit
	-- temporarily disables this collision.
	setAquaticWaterCollision(
		character,
		true
	)

	local spot =
		state.drinkFindAccessibleSpot(
			root.Position,
			character
		)

	if not spot then
		runtimeMessage =
			"Croco: no exposed water found"
		CROC.approachBusy = false
		return false
	end

	state.drinkSearch.currentWaterPoint = spot.water
	state.drinkClearUndergroundMode()

	runtimeMessage =
		"Croco: moving to exposed water edge"

	local moved = safeMoveToPosition(
		spot.stand,
		9,
		spot.water,
		{
			purpose = "water",
			tolerance =
				spot.source
					== "MainWaterPart"
					and 1.15
					or 2.5,
			speedScale = 0.50,
			-- Same smooth near-target deceleration as manual Move To.
			constantSpeed = false,
			riverApproach =
				spot.source
					== "MainWaterPart",
			riverApproachRadius = 36,
			maxDuration = 300,
		}
	)

	task.wait(0.18)

	character, root = characterParts()

	if character
		and root
		and state.isCrocOrHippoMovementCharacter(
			character
		)
		and moved then

		local humanoid =
			character:FindFirstChildOfClass(
				"Humanoid"
			)

		local waterBefore =
			tonumber(
				character:GetAttribute(
					"Water"
				)
			) or 0

		local acquired =
			humanoid
			and state.drinkAcquirePromptAfterMove(
				spot,
				character,
				root,
				humanoid,
				waterBefore,
				2.8
			)

		if acquired then
			local _, heldRoot = characterParts()
			if heldRoot then
				drinkingSourcePosition = heldRoot.Position
				heldRoot.AssemblyLinearVelocity = Vector3.zero
				heldRoot.AssemblyAngularVelocity = Vector3.zero
			end

			runtimeMessage =
				"Croco: drinking from water edge after facing correction"

			setSubState("Drinking")
			task.spawn(sustainDrinkAtCurrentPrompt)
		else
			state.drinkAbandonCurrent(
				"Croco bank had no Drink prompt after in-place rotation sweep"
			)
		end
	end

	CROC.approachBusy = false
	return moved
end

local VirtualInputManager = game:GetService("VirtualInputManager")
local eatingStuckSince
local lastEatWatchdogFood

function state.questMovementOpportunisticInteract(
	character,
	root
)
	local data =
		state.questMoveInteract

	-- Completed-slot staging must not "ride along" with Eat/Drink. That old rule
	-- could immediately re-enter a native interaction after Slots tried to stop it.
	if state.slotSwitchStagingActive == true then
		if data then
			data.grassGraceUntil = 0
			data.drinkGraceUntil = 0
			data.lastEatRemoteAt = 0
			data.lastDrinkRemoteAt = 0
		end
		return nil
	end

	if not data
		or not character
		or not root
		or (
			state.questGrowthReset.exclusive
			and state.slotStagingOpportunisticEat ~= true
		)
		or (
			state.questGrowthReset
			and state.questGrowthReset.stagingBusy
			and state.slotStagingOpportunisticEat ~= true
		)
		or (
			criticalRecoveryActive
			and state.slotStagingOpportunisticEat ~= true
		)
		or DAMAGE.active
		or (
			state.aquaticRiverEscape
			and state.aquaticRiverEscape.survivalSuspended
		) then

		return nil
	end

	-- Opportunistic interaction is GLOBAL for automated movement. SafeMove,
	-- Move To, Growth/slot staging and Auto Run all use the SAME non-invasive
	-- grass probe. It never owns movement: no grass search, no target, no turn,
	-- no stop and no route cancellation.

	if data.character ~= character then
		data.character = character
		data.lastCheckAt = 0
		data.lastEatRemoteAt = 0
		data.lastDrinkRemoteAt = 0
		data.grassGraceUntil = 0
		data.drinkGraceUntil = 0
		data.lastFood = nil
		data.lastWater = nil
	end

	local velocity =
		root.AssemblyLinearVelocity

	local planarSpeed =
		Vector3.new(
			velocity.X,
			0,
			velocity.Z
		).Magnitude

	local automatedMovementActive =
		planarSpeed >= 0.60
		or (
			state.safeMove
			and state.safeMove.active
		)
		or state.questMotionMoving

	if not automatedMovementActive then
		return nil
	end

	local now = tick()

	if now - (data.lastCheckAt or 0) < 0.06 then
		if now < (data.grassGraceUntil or 0) then
			return "eat_grace"
		end

		if now < (data.drinkGraceUntil or 0) then
			return "drink_grace"
		end

		return nil
	end

	data.lastCheckAt = now

	local food =
		tonumber(
			character:GetAttribute("Food")
		) or 100

	local water =
		tonumber(
			character:GetAttribute("Water")
		) or 100

	local foodEmergency =
		state.survivalFoodEmergency
		and state.survivalFoodEmergency(
			food,
			water
		)
		or false

	-- Quest movement is sampled much faster than the 1s survival scheduler.
	-- Kick the starvation handoff here too, with a cooldown, so a quest standing
	-- in water cannot spam SubState=Drinking while Food reaches zero.
	if foodEmergency
		and state.survivalForceFoodHandoff
		and now - (state.survivalFoodEmergencyHandoffAt or 0) >= 0.75 then
		pcall(
			state.survivalForceFoodHandoff,
			character,
			"Quest interaction yielded to critical Food"
		)
	end

	if type(data.lastFood) == "number"
		and food > data.lastFood + 0.01 then

		data.grassGraceUntil =
			math.max(
				data.grassGraceUntil or 0,
				now + 1.25
			)
	end

	if type(data.lastWater) == "number"
		and water > data.lastWater + 0.01 then

		data.drinkGraceUntil =
			math.max(
				data.drinkGraceUntil or 0,
				now + 1.35
			)
	end

	data.lastFood = food
	data.lastWater = water

	local detected =
		detectAvailableFood(
			character
		)

	local class =
		getAnimalClass(
			character
		)

	local classLower =
		type(class) == "string"
			and class:lower()
			or ""

	local herbivore =
		classLower:find(
			"herb",
			1,
			true
		) ~= nil

	local carnivore =
		classLower:find(
			"carn",
			1,
			true
		) ~= nil

	if classLower == "" then
		carnivore =
			isCarnivoreCharacter(
				character
			)

		herbivore =
			not carnivore
				and not isBaboonCharacter(
					character
				)
	end

	-- GLOBAL opportunistic grass:
	-- while an herbivore is already moving, pulse the server Eating substate.
	-- We deliberately do NOT require DetectMeatGrassWater == "Eat" here: at
	-- high running speed that prompt can exist for only a fraction of a frame.
	-- If grass is under the animal the game consumes it; otherwise nothing
	-- happens and the current route continues completely untouched.
	local waterOwnsSurvival =
		not foodEmergency
		and (
			drinkingToFull
			or (
				state.survivalArbiter
				and state.survivalArbiter.owner == "water"
			)
		)

	-- Swim only blocks opportunistic grass AFTER the animal is actually established
	-- in the Swim farm. While travelling there on land, grass directly under the
	-- route is still free: no detour, no stop, no facing change. Dedicated food
	-- routes remain blocked by autoEatStep for the entire Swim quest.
	if herbivore
		and not isGiraffeCharacter(character)
		and state.autoEat
		and not (
			state.autoQuests
			and state.questSwimActive
			and state.questSwimReady
		)
		and food < 99
		and not waterOwnsSurvival
		and detected ~= "Drink" then

		-- Pulse quickly enough to catch a grass patch while running at the Hub's
		-- high movement speeds. This only changes the interaction substate; it
		-- never touches CFrame, Humanoid.Move, SafeMove or the route destination.
		if now
			- (data.lastEatRemoteAt or 0)
			>= 0.12 then

			data.lastEatRemoteAt = now
			setSubState("Eating")
		end

		-- Grace is earned only when the game actually exposes Eat. Blind remote
		-- pulses must NOT keep extending grace, otherwise a truly hungry animal
		-- could be prevented from starting its normal dedicated grass route.
		if detected == "Eat" then
			data.grassGraceUntil =
				now + 0.90

			-- Opportunistic Eating is intentionally HUD-silent. It is a background
			-- interaction and must never overwrite the diagnostic message that tells
			-- us which route/quest/watchdog/recovery currently owns the character.
			data.lastOpportunisticEatConfirmedAt = now

			return "eat"
		end
	end

	-- GLOBAL opportunistic water (lightweight):
	-- Keep this cheap because the movement-interaction poll runs frequently.
	-- The normal game detector is already sampled above. As a fast fallback, use
	-- only the replicated Swimming state and ONE direct Terrain-water raycast.
	-- Do NOT scan PlayerGui or run the full body/bounding-box water proof here.
	if state.autoDrink
		and not foodEmergency
		and state.slotStagingOpportunisticEat ~= true
		and water < 99.5
		and (
			detected == "Drink"
			or (
				state.isCharacterSwimmingState
				and state.isCharacterSwimmingState(character)
			)
			or (
				state.isDirectWaterContact
				and state.isDirectWaterContact(root)
			)
		) then

		data.drinkGraceUntil =
			now + 1.65

		if now
			- (data.lastDrinkRemoteAt or 0)
			>= 0.12 then

			data.lastDrinkRemoteAt = now

			setSubState(
				"Drinking"
			)

			-- Opportunistic Drinking is also HUD-silent for the same reason: the
			-- important message remains the active route/quest/watchdog state.
			data.lastOpportunisticDrinkConfirmedAt = now
		end

		return "drink"
	end

	if now < (data.grassGraceUntil or 0) then
		return "eat_grace"
	end

	if now < (data.drinkGraceUntil or 0) then
		return "drink_grace"
	end

	return nil
end

-- SafeMove sets state.busy, so autoEatStep intentionally does not run while a
-- spawn/slot/manual/quest route owns movement. Keep opportunistic grass alive
-- independently: this lightweight poll only calls the remote probe above and
-- therefore cannot alter the active destination or steering.
task.spawn(function()
	while state.alive do
		if state.autoEat or state.autoDrink then
			local character, root = characterParts()

			if character
				and root
				and state.questMovementOpportunisticInteract then

				pcall(
					state.questMovementOpportunisticInteract,
					character,
					root
				)
			end
		end

		task.wait(0.08)
	end
end)

local function giraffeApproachLockedTree(selected, approachIndex)
	local character, root = characterParts()
	if not character
		or not root
		or not selected
		or not selected.tree
		or not selected.leafPart then
		return false
	end

	-- Use the exact approach that was already geometry-verified. Recomputing a
	-- second side here was the source of the visible "go there, come back" loop.
	local approach = selected.approach

	if not approach or not approach.ground then
		approach = giraffeReachableApproach(
			selected.tree,
			selected.leafPart,
			character,
			root,
			approachIndex or 0
		)
	end

	if not approach or not approach.ground then
		return false
	end

	selected.approach = approach

	-- Use the same terrestrial MoveTo engine as the other animals, but require
	-- the Giraffe to actually reach its selected side of the tree. tolerance=9
	-- could declare success while the trunk was still between the animal and the
	-- intended stand point.
	-- Precision matters here: a large tolerance lets SafeMove stop several studs
	-- before the selected stand point, which puts an adult Giraffe outside the
	-- actual head/neck interaction range even though the route reports success.
	local approachTolerance = math.clamp(
		state.movementFootprint(character) * 0.10,
		1.25,
		2.0
	)

	local terminalDistance =
		math.clamp(
			state.movementFootprint(character) * 1.15 + 8,
			12,
			24
		)

	local moved = safeMoveToPosition(
		approach.ground,
		8,
		selected.leafPart.Position,
		{
			purpose = "food",
			forceMoveToLand = true,
			tolerance = approachTolerance,
			speedScale = 1,
			constantSpeed = false,

			-- Once the selected tree is the actual interaction target, generic object
			-- avoidance must stop before the final feeding stand point. The Giraffe is
			-- SUPPOSED to approach the trunk/canopy; continuing to treat that geometry
			-- as a navigation obstacle creates the visible left/right fight.
			ignoreObstacleInstance = selected.tree,
			interactionTarget = "giraffe_tree",
			suspendObstacleAvoidanceNearTarget = true,
			obstacleSuspendDistance = terminalDistance,

			-- The native Eat prompt is stronger evidence than our geometric stand point.
			-- The instant it appears, end locomotion and let the eating handshake own
			-- positioning; never take one more avoidance/reposition step.
			routeCheckInterval = 0.055,
			routeCheck = function(liveCharacter)
				if liveCharacter
					and state.grassEatAvailable(liveCharacter) then
					return true, "giraffe_eat_prompt"
				end
				return false
			end,
		}
	)

	if state.safeMove.routeInterruptReason == "giraffe_eat_prompt" then
		return true
	end

	return moved
end

local function giraffeEatLockedTree(selected)
	if GIRAFFE.exclusiveRecovery
		and GIRAFFE.exclusiveRecovery.active then
		return
	end

	if GIRAFFE.busy
		or state.questGrowthReset.exclusive
		or type(selected) ~= "table"
		or not selected.tree
		or not selected.leafPart then
		return
	end

	local myToken = GIRAFFE.cancelToken
	GIRAFFE.busy = true
	GIRAFFE.targetTree = selected.tree
	GIRAFFE.targetLeaves = selected.leaves
	GIRAFFE.targetLeafPart = selected.leafPart
	GIRAFFE.targetStartedAt = GIRAFFE.targetStartedAt > 0
		and GIRAFFE.targetStartedAt
		or tick()

	do
		local character, root =
			characterParts()

		local profile =
			character
			and root
			and giraffeCharacterReachProfile(
				character,
				root
			)
			or nil

		GIRAFFE.targetGrowthAtLock =
			profile
			and profile.growthPercent
			or nil

		GIRAFFE.targetBodyHeightAtLock =
			profile
			and profile.bodyHeight
			or nil
	end

	local function cancelled()
		return myToken ~= GIRAFFE.cancelToken
			or (
				GIRAFFE.exclusiveRecovery
				and GIRAFFE.exclusiveRecovery.active
			)
			or state.questGrowthReset.exclusive
			or not state.autoEat
			or drinkingToFull
			or criticalRecoveryActive
	end

	local character, root = characterParts()
	if not character or not root or cancelled() then
		GIRAFFE.busy = false
		return
	end

	-- PROMPT OVERRIDES GEOMETRY:
	-- if Savannah is ALREADY offering Eat at the current position, that is the
	-- strongest possible evidence that we are in the interaction zone.
	-- Do not dodge the trunk, change sides, recompute an approach or SafeMove.
	local initialEatAvailable =
		state.grassEatAvailable(
			character
		)

	if not initialEatAvailable then
		-- Re-check depletion/reach only when there is NO Eat prompt.
		local leafPart, info, initialApproach =
			giraffeBestReachableLeaf(
				selected.tree,
				character,
				root
			)

		if not info or info.depleted then
			runtimeMessage =
				"Giraffe: tree leaves are depleted; selecting another tree"

			GIRAFFE.clearTarget()
			GIRAFFE.busy = false
			return
		end

		if not leafPart then
			local grew =
				giraffeTargetGrowthChanged(
					character,
					root
				)

			if grew then
				giraffeSizeRejectTree(
					selected.tree,
					character,
					"tree_became_unreachable_after_growth"
				)

				runtimeMessage =
					"Giraffe: tree became unreachable after growth; blacklisted"
			else
				giraffeIgnoreTree(
					selected.tree,
					35
				)

				runtimeMessage =
					"Giraffe: tree currently unreachable; selecting another"
			end

			GIRAFFE.clearTarget()
			GIRAFFE.busy = false
			return
		end

		selected.leafPart =
			leafPart

		selected.approach =
			initialApproach

		GIRAFFE.targetLeafPart =
			leafPart

		runtimeMessage =
			string.format(
				"Giraffe: locked tree with available leaves (%.0f studs)",
				selected.distance or 0
			)

		-- Only approach/reposition while Eat is NOT available.
		local approached =
			giraffeApproachLockedTree(
				selected,
				0
			)

		if not approached then
			character, root =
				characterParts()

			if character
				and root
				and not state.grassEatAvailable(
					character
				)
				and state.giraffeTryAlternateFeedingPoint(
					selected,
					character,
					root,
					"approach_move_failed"
				) then

				runtimeMessage =
					"Giraffe: first feeding point blocked; trying another side"

				giraffeApproachLockedTree(
					selected,
					1
				)
			end
		end

		task.wait(0.25)
	else
		runtimeMessage =
			"Giraffe: Eat prompt already available; holding position for native Eat handshake"

		blockClientSubState = false

		state.releaseMovementNow(
			character,
			true
		)

		root.AssemblyLinearVelocity =
			Vector3.zero

		root.AssemblyAngularVelocity =
			Vector3.zero
	end

	character, root = characterParts()
	if not character or not root or cancelled() then
		GIRAFFE.busy = false
		return
	end

	local holdPosition = root.Position
	local lastFood = character:GetAttribute("Food") or 0
	local lastProgressAt = tick()
	local startedAt = tick()
	local nextStateAt = 0
	local sawEatPrompt = initialEatAvailable == true
	local progressEver = false
	local noInteractionStartedAt = tick()
	local eatPromptGraceUntil = sawEatPrompt and (tick() + 3.0) or 0

	-- Giraffe uses the SAME authoritative server remote path as normal
	-- Savannah grass eating. No VirtualInput/E handshake exists here.
	local remoteEatStartedAt = 0
	local rejectedTree = nil

	GIRAFFE.lastFood = lastFood
	GIRAFFE.lastProgressAt = lastProgressAt

	while state.alive and tick() - startedAt < 35 do
		if cancelled() then break end

		character, root = characterParts()
		if not character or not root then break end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then break end

		-- Water always wins over feeding.
		if humanoid:GetState() == Enum.HumanoidStateType.Swimming
			or isPositionUnderwater(root.Position) then
			runtimeMessage = "Giraffe: tree position entered water; aborting leaf feed"
			break
		end

		-- EAT PROMPT FREEZE:
		-- Once Eat is visible, ALL local tree navigation/reposition logic stops.
		-- The Giraffe stays exactly where it is and only tries to eat.
		--
		-- If Food does not actually increase, we do NOT "try another side" while
		-- still inside the same interaction mess. The failed tree is blocked and
		-- the exclusive PrideRockSpawn1 watchdog takes over.
		local currentFood =
			character:GetAttribute(
				"Food"
			) or 0

		local targetFood =
			(
				state.autoQuests
				and state.questGiraffeFeeding
				and not preSwitchFoodTarget
			)
				and 100
				or (
					preSwitchFoodTarget
						or 92
				)

		if currentFood >= targetFood then
			-- The server may still be in Eating even though our local worker is done.
			-- Release it BEFORE returning control to Auto Run/Growth.
			state.forceStopEatingSubState(
				character,
				"Giraffe reached food target"
			)

			runtimeMessage =
				"Giraffe finished feeding from tree leaves"

			break
		end

		if currentFood > lastFood + 0.01 then
			lastFood = currentFood
			lastProgressAt = tick()
			progressEver = true
			noInteractionStartedAt = tick()
			eatPromptGraceUntil = math.max(eatPromptGraceUntil, tick() + 3.5)

			GIRAFFE.lastFood =
				currentFood

			GIRAFFE.lastProgressAt =
				lastProgressAt

			GIRAFFE.repositionAttempts =
				0

			remoteEatStartedAt =
				tick()
		end

		-- IMPORTANT:
		-- Use the SAME prompt detector as the proven normal herbivore path.
		-- This includes both framework detection and the visible bottom-screen
		-- "Click E to eat" prompt.
		local available =
			state.grassEatAvailable(
				character
			)

		if available then
			sawEatPrompt = true
			eatPromptGraceUntil = tick() + 3.0
			noInteractionStartedAt = tick()

			-- VALID PROMPT = VALID CURRENT POSITION.
			-- Absolutely no tree navigation/reposition/dodge while the game says Eat.
			if state.safeMove
				and state.safeMove.active
				and state.safeMove.reason == "food" then

				state.safeMove.cancelToken += 1
				state.safeMove.active = false
				state.safeMove.target = nil
				state.safeMove.reason = nil
				state.safeMove.manualLabel = nil
				state.busy = false
			end

			state.releaseMovementNow(
				character,
				true
			)

			root.AssemblyLinearVelocity =
				Vector3.zero

			root.AssemblyAngularVelocity =
				Vector3.zero

			if RAGDOLL_STATES[
				humanoid:GetState()
			] then

				humanoid:ChangeState(
					Enum.HumanoidStateType.GettingUp
				)
			end

			-- THIS IS THE OLD/PROVEN METHOD:
			-- startGrassEatingIfAvailable() directly invokes the server-side
			-- Eating sub-state remote. It does NOT press E.
			--
			-- Re-send at a low frequency until Food actually starts moving. This
			-- handles a transient missed remote without toggling anything off.
			if currentFood > lastFood + 0.01 then
				lastFood = currentFood
				lastProgressAt = tick()
				progressEver = true
				remoteEatStartedAt = tick()

				GIRAFFE.lastFood = currentFood
				GIRAFFE.lastProgressAt = lastProgressAt
				GIRAFFE.repositionAttempts = 0
			end

			if tick() - remoteEatStartedAt >= 0.55 then
				remoteEatStartedAt = tick()

				blockClientSubState = false

				startGrassEatingIfAvailable(
					character,
					root,
					selected.leafPart
						and selected.leafPart.Position
						or nil
				)

				blockClientSubState = false
			end

			if progressEver
				and tick() - lastProgressAt <= 2.0 then

				runtimeMessage =
					string.format(
						"Giraffe eating through server remote - Food %d%%",
						math.floor(currentFood)
					)
			else
				runtimeMessage =
					string.format(
						"Giraffe: Eat prompt confirmed -> sending Eating remote (Food %d%%)",
						math.floor(currentFood)
					)
			end

			-- Do NOT blacklist, do NOT reposition and do NOT leave the tree while
			-- Eat is visible. The server remote owns this state now.
			task.wait(0.18)
			continue
		end

		-- A visible Eat prompt can flicker for a frame while the server is accepting
		-- the Eating sub-state.  Previously that single false frame immediately fell
		-- through to Walking + side-reposition logic, cancelling Eating and creating
		-- the left/right ping-pong shown in the report.  Once Eat was seen, hold the
		-- CURRENT pose for a short grace window and keep only the Eating handshake.
		if sawEatPrompt and tick() < eatPromptGraceUntil then
			blockClientSubState = false

			if state.safeMove
				and state.safeMove.active
				and state.safeMove.reason == "food" then
				state.safeMove.cancelToken += 1
				state.safeMove.active = false
				state.safeMove.target = nil
				state.safeMove.reason = nil
				state.safeMove.manualLabel = nil
				state.busy = false
			end

			state.releaseMovementNow(character, true)
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero

			if RAGDOLL_STATES[humanoid:GetState()] then
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end

			if tick() - remoteEatStartedAt >= 0.55 then
				remoteEatStartedAt = tick()
				-- The prompt was verified only moments ago. During this grace window
				-- do not require the visual detector to still be true, otherwise one
				-- flicker would prevent the remote from being reasserted.
				blockClientSubState = false
				setSubState("Eating")
				blockClientSubState = false
			end

			runtimeMessage = string.format(
				"Giraffe: Eat handshake locked; holding current side (Food %d%%)",
				math.floor(currentFood)
			)
			task.wait(0.18)
			continue
		end

		-- Eat has been continuously absent beyond the grace window, so geometry /
		-- reposition logic is allowed again.
		blockClientSubState = false

		-- Growth is validated through the same reach solver that selected the
		-- tree. We do not use a separate canopy heuristic here; that caused valid
		-- trees to be rejected globally.
		-- CRITICAL tree depletion check:
		-- switch ONLY when every BasePart under this tree's Leaves is transparent.
		local currentLeaf, currentInfo, currentApproach = giraffeBestReachableLeaf(
			selected.tree,
			character,
			root
		)

		if not currentInfo then
			runtimeMessage = "Giraffe: tree lost its Leaves model; selecting another tree"
			GIRAFFE.clearTarget()
			break
		end

		if currentInfo.depleted then
			runtimeMessage = "Giraffe: all Leaves meshes reached Transparency 1; switching tree"
			GIRAFFE.clearTarget()
			break
		end

		if not currentLeaf then
			local grew =
				giraffeTargetGrowthChanged(
					character,
					root
				)

			if grew then
				giraffeSizeRejectTree(
					selected.tree,
					character,
					"grew_while_eating_and_tree_became_unreachable"
				)

				runtimeMessage =
					string.format(
						"Giraffe grew beyond this tree at %d%% Growth; blacklisted and finding a taller tree",
						math.floor(
							tonumber(
								character:GetAttribute(
									"GrowthPercentage"
								)
							) or 0
						)
					)
			else
				giraffeIgnoreTree(
					selected.tree,
					35
				)

				runtimeMessage =
					"Giraffe: visible Leaves are currently unreachable; switching tree"
			end

			GIRAFFE.clearTarget()
			break
		end

		-- Individual leaf meshes disappear while the tree is consumed.
		-- Update the target INSIDE the same tree instead of switching trees.
		if currentLeaf and currentLeaf ~= GIRAFFE.targetLeafPart then
			GIRAFFE.targetLeafPart = currentLeaf
			selected.leafPart = currentLeaf
			selected.approach = currentApproach
		end

		-- Adult/large Giraffe fail-fast: if a geometrically marginal low target
		-- provides neither Eat prompt nor Food progress, it is not a usable tree.
		-- Do not spend the full 35-second lock repeatedly standing on a shrub.
		if not sawEatPrompt
			and not progressEver
			and tick() - noInteractionStartedAt >= 3.75
			and currentApproach then

			local lowClearance = (currentApproach.highestLeafY or -math.huge)
				- (currentApproach.reachableBottomY or math.huge)

			if lowClearance <= 2.75 then
				state.giraffeRejectInteractionTree(
					selected.tree,
					character,
					"low_shrub_no_interaction",
					420
				)

				rejectedTree =
					selected.tree

				runtimeMessage =
					"Giraffe: low shrub produced no real interaction; blacklisted"

				GIRAFFE.clearTarget()
				break
			end
		end

		-- Hold near THIS tree. Never chase a different tree just because the
		-- current leaf mesh disappeared; currentLeaf above keeps us on the tree.
		root.AssemblyLinearVelocity = Vector3.new(
			0,
			root.AssemblyLinearVelocity.Y,
			0
		)

		-- Never teleport the Giraffe back to an old hold position. If physics or an
		-- obstacle moved the body, snapping CFrame back could repeatedly push it into
		-- the same trunk/rock. Only correct facing while preserving CURRENT position.
		if (root.Position - holdPosition).Magnitude > 6 then
			local currentPosition = root.Position
			root.CFrame = CFrame.lookAt(
				currentPosition,
				Vector3.new(
					GIRAFFE.targetLeafPart.Position.X,
					currentPosition.Y,
					GIRAFFE.targetLeafPart.Position.Z
				),
				Vector3.yAxis
			)
		end

		if RAGDOLL_STATES[humanoid:GetState()] then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end

		if tick() >= nextStateAt then
			nextStateAt =
				tick() + 0.45

			if AskSubState then
				pcall(
					AskSubState.InvokeServer,
					AskSubState,
					"Walking"
				)
			end

			blockClientSubState =
				false
		end

		-- No Food progress does NOT immediately switch trees.
		-- First verify the Leaves meshes, then reposition around the SAME tree.
		if tick() - lastProgressAt >= 4.5 then
			local currentPoint =
				currentApproach
					and currentApproach.approachIndex

			if currentPoint ~= nil then
				state.giraffeRejectApproachPoint(
					selected.tree,
					currentPoint,
					character,
					"no_interaction_at_point",
					150
				)
			end

			local verifyLeaf, verifyInfo, verifyApproach = giraffeBestReachableLeaf(
				selected.tree,
				character,
				root,
				GIRAFFE.repositionAttempts + 1
			)

			if verifyInfo and verifyInfo.depleted then
				runtimeMessage = "Giraffe: verified all Leaves depleted; switching tree"
				GIRAFFE.clearTarget()
				break
			end

			if verifyInfo and not verifyInfo.depleted and not verifyLeaf then
				if state.giraffeAllApproachPointsBlocked(
					selected.tree,
					character
				) then

					local grew =
						giraffeTargetGrowthChanged(
							character,
							root
						)

					if grew then
						giraffeSizeRejectTree(
							selected.tree,
							character,
							"all_points_invalid_after_growth"
						)
					else
						state.giraffeRejectInteractionTree(
							selected.tree,
							character,
							"all_feeding_points_invalid",
							600
						)
					end

					rejectedTree =
						selected.tree

					runtimeMessage =
						"Giraffe: all feeding points on this tree are blocked; PrideRockSpawn1 recovery"

					GIRAFFE.clearTarget()
					break
				end

				local grew =
					giraffeTargetGrowthChanged(
						character,
						root
					)

				if grew then
					giraffeSizeRejectTree(
						selected.tree,
						character,
						"reposition_unreachable_after_growth"
					)

					runtimeMessage =
						"Giraffe: growth made the current tree unreachable; size-blacklisted"
				else
					giraffeIgnoreTree(
						selected.tree,
						25
					)

					runtimeMessage =
						"Giraffe: current geometry unavailable; selecting another tree"
				end

				GIRAFFE.clearTarget()
				break
			end

			GIRAFFE.repositionAttempts += 1

			if GIRAFFE.repositionAttempts <= 3
				and verifyLeaf then

				selected.leafPart = verifyLeaf
				selected.approach = verifyApproach
				GIRAFFE.targetLeafPart = verifyLeaf

				runtimeMessage = string.format(
					"Giraffe: leaves remain; repositioning on same tree (%d/3)",
					GIRAFFE.repositionAttempts
				)

				giraffeApproachLockedTree(
					selected,
					0
				)
				task.wait(0.35)

				character, root = characterParts()
				if not character or not root then break end

				holdPosition = root.Position
				lastProgressAt = tick()
				nextStateAt = 0
				nextKeyAt = 0
			else
				state.giraffeRejectInteractionTree(
					selected.tree,
					character,
					"verified_sides_without_eat_prompt",
					600
				)

				rejectedTree =
					selected.tree

				runtimeMessage =
					"Giraffe: verified sides produced no Eat prompt; tree blocked -> PrideRockSpawn1"

				GIRAFFE.clearTarget()
				break
			end
		end

		if tick() - lastProgressAt <= 1.75
			and progressEver then

			runtimeMessage =
				string.format(
					"Giraffe: Food recently progressed to %d%%; reacquiring Eat prompt",
					math.floor(currentFood)
				)
		else
			runtimeMessage =
				"Giraffe: Eat prompt absent; validating one feeding position"
		end

		task.wait(0.20)
	end

	character, root = characterParts()
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	local foodAfter = character and (character:GetAttribute("Food") or 0) or 0
	local targetFood = (
		state.autoQuests
		and state.questGiraffeFeeding
		and not preSwitchFoodTarget
	) and 100 or (preSwitchFoodTarget or 92)

	if foodAfter >= targetFood then
		state.forceStopEatingSubState(
			character,
			"Giraffe feed worker completed"
		)
		GIRAFFE.clearTarget()
	elseif GIRAFFE.targetTree and GIRAFFE.targetTree.Parent then
		local finalLeaf, finalInfo = giraffeBestReachableLeaf(
			GIRAFFE.targetTree,
			character,
			root
		)

		if finalInfo and finalInfo.depleted then
			runtimeMessage = "Giraffe: current tree exhausted; next feed will use another tree"
			GIRAFFE.clearTarget()
		elseif finalInfo and not finalInfo.depleted and not finalLeaf then
			local grew =
				giraffeTargetGrowthChanged(
					character,
					root
				)

			if grew then
				giraffeSizeRejectTree(
					GIRAFFE.targetTree,
					character,
					"final_unreachable_after_growth"
				)

				runtimeMessage =
					"Giraffe: current tree no longer fits this growth stage; blacklisted"
			else
				giraffeIgnoreTree(
					GIRAFFE.targetTree,
					35
				)

				runtimeMessage =
					"Giraffe: remaining tree leaves are currently unreachable; selecting another tree"
			end

			GIRAFFE.clearTarget()
		elseif not finalInfo then
			GIRAFFE.clearTarget()
		elseif progressEver then
			-- Keep the same tree locked if it did feed and still has leaves.
			-- The next pass continues here instead of choosing a closer tree.
			GIRAFFE.targetStartedAt = GIRAFFE.targetStartedAt > 0
				and GIRAFFE.targetStartedAt
				or tick()
		elseif not sawEatPrompt and GIRAFFE.repositionAttempts >= 3 then
			giraffeIgnoreTree(GIRAFFE.targetTree, 45)
			GIRAFFE.clearTarget()
		end
	end

	GIRAFFE.busy = false

	if rejectedTree
		and character
		and root then

		pcall(
			state.giraffeDisengageRejectedTree,
			rejectedTree,
			character,
			root
		)
	end
end


task.spawn(function()
	while state.alive do
		pcall(function()
			if not GIRAFFE.busy
				or not GIRAFFE.targetTree
				or not GIRAFFE.targetTree.Parent then

				return
			end

			local character, root =
				characterParts()

			if not character
				or not root
				or not isGiraffeCharacter(
					character
				) then

				return
			end

			local interactionRejected =
				GIRAFFE.interactionRejectedTrees[
					GIRAFFE.targetTree
				]

			if type(interactionRejected) == "table"
				and interactionRejected.character == character
				and tick() < (interactionRejected.expiresAt or 0) then

				runtimeMessage =
					"Giraffe watchdog: rejected tree still active; cancelling stale interaction"

				GIRAFFE.cancel()
				return
			end

			local grew =
				giraffeTargetGrowthChanged(
					character,
					root
				)

			if not grew then
				return
			end

			local leafPart, info =
				giraffeBestReachableLeaf(
					GIRAFFE.targetTree,
					character,
					root
				)

			-- Still reachable after growth: keep eating. This is the most important
			-- false-positive protection added in this fix.
			if leafPart then
				return
			end

			if info
				and not info.depleted then

				giraffeSizeRejectTree(
					GIRAFFE.targetTree,
					character,
					"watchdog_confirmed_unreachable_after_growth"
				)

				runtimeMessage =
					"Giraffe growth watchdog: locked tree became unreachable; finding taller Leaves"

				GIRAFFE.cancel()
			end
		end)

		task.wait(0.55)
	end
end)

local function baboonTapEatKey()
	pcall(function()
		VirtualInputManager:SendKeyEvent(
			true,
			Enum.KeyCode.E,
			false,
			game
		)
		task.wait(0.045)
		VirtualInputManager:SendKeyEvent(
			false,
			Enum.KeyCode.E,
			false,
			game
		)
	end)
end

local function baboonApproachFood(targetPart, distance)
	local character, root = characterParts()
	if not character or not root or not targetPart or not targetPart.Parent then
		return false
	end

	local flat = Vector3.new(
		root.Position.X - targetPart.Position.X,
		0,
		root.Position.Z - targetPart.Position.Z
	)

	if flat.Magnitude < 0.5 then
		flat = Vector3.new(
			-root.CFrame.LookVector.X,
			0,
			-root.CFrame.LookVector.Z
		)
	end

	if flat.Magnitude < 0.1 then
		flat = Vector3.new(1, 0, 0)
	else
		flat = flat.Unit
	end

	local desired = targetPart.Position + flat * (distance or 4)

	-- Always land on real Terrain next to the AntHill. The old code preserved
	-- the AntHill mesh Y, which could put the Baboon on top of/inside the model.
	local castY = math.max(
		targetPart.Position.Y + 120,
		root.Position.Y + 120,
		250
	)

	local hit = workspace:Raycast(
		Vector3.new(desired.X, castY, desired.Z),
		Vector3.new(0, -500, 0),
		terrainOnlyRayParams
	)

	if not hit or hit.Material == Enum.Material.Water then
		return false
	end

	return safeMoveToPosition(
		hit.Position,
		7,
		targetPart.Position,
		{ purpose = "food", tolerance = 8 }
	)
end

local function baboonEatLockedTarget(selected)
	if BABOON.busy
		or state.questGrowthReset.exclusive
		or type(selected) ~= "table"
		or not selected.object
		or not selected.part then
		return
	end

	local myToken = BABOON.cancelToken
	BABOON.busy = true
	BABOON.targetKind = selected.kind
	BABOON.targetObject = selected.object
	BABOON.targetPart = selected.part
	BABOON.targetStartedAt = tick()

	local function cancelled()
		local liveCharacter = player.Character
		local liveWater = liveCharacter
			and (liveCharacter:GetAttribute("Water") or 100)
			or 100

		return myToken ~= BABOON.cancelToken
			or state.questGrowthReset.exclusive
			or not state.autoEat
			or drinkingToFull
			or liveWater <= 75
			or criticalRecoveryActive
	end

	local character, root = characterParts()
	if not character or not root or cancelled() then
		BABOON.busy = false
		BABOON.clearTarget()
		return
	end

	-- ========================================================
	-- CARCASS
	-- ========================================================
	if selected.kind == "Carcass" then
		runtimeMessage = string.format(
			"Baboon: locked nearest food -> carcass (%.0f studs)",
			selected.distance or 0
		)

		-- Keep the Baboon lock around the existing, battle-tested carcass
		-- routine. It cannot switch to an AntHill mid-attempt.
		eatCarcass(selected.object, selected.part)

		local liveCharacter = player.Character
		local foodAfter = liveCharacter and (liveCharacter:GetAttribute("Food") or 0) or 0
		local targetFood = (
			state.autoQuests
			and state.questBaboonFeeding
			and not preSwitchFoodTarget
		) and 100 or (preSwitchFoodTarget or 92)

		if foodAfter >= targetFood then
			BABOON.clearTarget()
		elseif not selected.object.Parent or carcassIsIgnored(selected.object) then
			BABOON.clearTarget()
		else
			-- If carcass routine returned without finishing but did not mark it
			-- bad, keep the SAME source locked for the next pass.
			BABOON.targetObject = selected.object
			BABOON.targetPart = selected.part
			BABOON.targetKind = "Carcass"
		end

		BABOON.busy = false
		return
	end

	-- ========================================================
	-- ANT HILL
	-- ========================================================
	if selected.kind ~= "AntHill"
		or not selected.object.Parent
		or not selected.part.Parent then

		BABOON.busy = false
		BABOON.clearTarget()
		return
	end

	runtimeMessage = string.format(
		"Baboon: locked nearest food -> AntHill (%.0f studs)",
		selected.distance or 0
	)

	-- ONE positioning action only.
	-- If already close, do not move at all.
	if (root.Position - selected.part.Position).Magnitude > 9 then
		local approached = baboonApproachFood(selected.part, 4)

		if not approached then
			baboonIgnoreAntHill(selected.object, 60)
			BABOON.busy = false
			BABOON.clearTarget()
			runtimeMessage = "Baboon: could not find safe ground beside AntHill"
			return
		end

		task.wait(0.35)
	end

	character, root = characterParts()
	if not character or not root or cancelled() then
		BABOON.busy = false
		BABOON.clearTarget()
		return
	end

	-- IMPORTANT:
	-- AntHill is a special Baboon food source. The generic
	-- DetectMeatGrassWater helper is not authoritative for it, so do not reject
	-- a valid AntHill just because that helper does not return "Eat".
	--
	-- Start the interaction exactly ONCE. The order matches normal player use:
	-- press E once, then reinforce the Eating substate once.
	local startFood = character:GetAttribute("Food") or 0
	local lastFood = startFood
	local lastProgressAt = tick()
	local foodEverRose = false

	BABOON.lastFood = startFood
	BABOON.lastProgressAt = lastProgressAt

	baboonTapEatKey()
	task.wait(0.08)

	if cancelled() then
		BABOON.busy = false
		BABOON.clearTarget()
		return
	end

	setSubState("Eating")

	runtimeMessage = string.format(
		"Baboon eating AntHill - Food %d%%",
		math.floor(startFood)
	)

	-- From this point onward there are NO more E presses and NO forced relocations.
	-- We only observe Food and the safety state.
	while state.alive do
		if cancelled() then break end
		if not selected.object.Parent or not selected.part.Parent then break end

		character, root = characterParts()
		if not character or not root then break end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then break end

		if humanoid:GetState() == Enum.HumanoidStateType.Swimming
			or isPositionUnderwater(root.Position) then

			baboonIgnoreAntHill(selected.object, 120)
			runtimeMessage = "Baboon: AntHill became unsafe near water; target blacklisted"
			break
		end

		local currentFood = character:GetAttribute("Food") or 0
		local targetFood = (
			state.autoQuests
			and state.questBaboonFeeding
			and not preSwitchFoodTarget
		) and 100 or (preSwitchFoodTarget or 92)

		if currentFood >= targetFood then
			break
		end

		if currentFood > lastFood + 0.01 then
			lastFood = currentFood
			lastProgressAt = tick()
			foodEverRose = true
			BABOON.lastFood = currentFood
			BABOON.lastProgressAt = lastProgressAt

			runtimeMessage = string.format(
				"Baboon eating AntHill - Food %d%%",
				math.floor(currentFood)
			)
		end

		-- If the Baboon gets displaced away from the AntHill, do NOT snap it back
		-- it back on top. End this attempt cleanly and reacquire later.
		if (root.Position - selected.part.Position).Magnitude > 13 then
			runtimeMessage = "Baboon moved away from AntHill; ending feed attempt without moving"
			break
		end

		-- One E press should start the entire feeding session. If Food never
		-- moves, this AntHill is simply not usable from this position.
		if tick() - lastProgressAt >= 7 then
			baboonIgnoreAntHill(selected.object, 90)
			runtimeMessage = foodEverRose
				and "Baboon: AntHill stopped giving Food for 7s; switching source"
				or "Baboon: AntHill gave no Food after one Eat press; switching source"
			break
		end

		task.wait(0.20)
	end

	character, root = characterParts()

	local foodAfter = character
		and (character:GetAttribute("Food") or 0)
		or 0

	local targetFood = (
		state.autoQuests
		and state.questBaboonFeeding
		and not preSwitchFoodTarget
	) and 100 or (preSwitchFoodTarget or 92)

	if foodAfter >= targetFood then
		runtimeMessage = "Baboon finished feeding from AntHill"
		BABOON.clearTarget()

	elseif not selected.object.Parent
		or baboonAntHillIsIgnored(selected.object)
		or not foodEverRose then

		if not foodEverRose and selected.object.Parent then
			baboonIgnoreAntHill(selected.object, 90)
		end

		BABOON.clearTarget()

	else
		-- It was a valid source and Food increased. Keep the same AntHill locked
		-- if the attempt ended for an external reason; do not compare distances
		-- again and do not force-position it while already eating.
		BABOON.targetKind = "AntHill"
		BABOON.targetObject = selected.object
		BABOON.targetPart = selected.part
	end

	BABOON.busy = false

	if not state.questGrowthReset.exclusive
		and not drinkingToFull then
		blockClientSubState = false
	end
end


local function virtualEatKick()
	if state.questGrowthReset.exclusive then return end
	local character, root = characterParts()
	if not character or not root then return end

	local animal = character:GetAttribute("AnimalName") or ""

	if isGiraffeCharacter(character) then
		if GIRAFFE.busy then return end

		local selected = nearestGiraffeTree(root)
		if selected then
			runtimeMessage = "Giraffe: Eat stalled; retrying locked tree leaves"
			task.spawn(giraffeEatLockedTree, selected)
		else
			runtimeMessage = "Giraffe: no non-depleted tree leaves found"
		end

		eatingStuckSince = nil
		return
	end

	if isBaboonCharacter(character) then
		-- Water has absolute priority for Baboon.
		if (character:GetAttribute("Water") or 100) <= 75 then
			state.questBaboonFeeding = false
			eatingToFull = false
			BABOON.cancel()
			eatingStuckSince = nil
			return
		end

		-- The dedicated Baboon routine owns AntHill interaction. Never use the
		-- generic watchdog to spam E or reposition while that routine is active.
		if BABOON.busy then
			eatingStuckSince = nil
			return
		end

		local selected = chooseBaboonFood(root)
		if selected then
			runtimeMessage = "Baboon: feed attempt ended; reacquiring locked food source"
			task.spawn(baboonEatLockedTarget, selected)
		else
			runtimeMessage = "Baboon: no carcass or AntHill available"
		end

		eatingStuckSince = nil
		return
	end

	if isCarnivoreCharacter(character) then
		local carcass
		local carcassRoot

		if activeCarcass and activeCarcassStillExists() then
			carcass = activeCarcass
			carcassRoot =
				carcass:FindFirstChild("HumanoidRootPart")
				or carcass:FindFirstChildWhichIsA("BasePart", true)

			runtimeMessage =
				activeCarcassCommitted
					and "Eat watchdog: retrying SAME locked carcass"
					or "Eat watchdog: retrying SAME selected carcass"
		else
			clearActiveCarcass(true)
			carcass, carcassRoot = nearestCarcass(root)
			runtimeMessage =
				"Eat watchdog: acquiring carcass"
		end

		if carcass and carcassRoot and not carcassEatBusy then
			task.spawn(
				eatCarcass,
				carcass,
				carcassRoot,
				activeCarcassCommitted and false or passiveCarnivoreScavenge
			)
		elseif not carcass then
			runtimeMessage =
				"Carnivore: no carcass available"
		end

		eatingStuckSince = nil
		return
	end

	runtimeMessage =
		"Eat travou; procurando uma grama realmente utilizavel"

	local food =
		tonumber(
			character:GetAttribute(
				"Food"
			)
		) or 100

	local grass =
		findNearestGrass(
			root.Position
		)

	if not grass
		and food < 92 then

		grass =
			findDistantGrass(
				root.Position
			)
	end

	if grass then
		local moved =
			moveToGrass(
				grass
			)

		if moved then
			task.wait(0.15)
			character, root = characterParts()

			if character and root
				and startGrassEatingIfAvailable(
					character,
					root,
					grass
				) then

				eatingSourcePosition = grass
				eatingTargetReachedAt = tick()
				runtimeMessage =
					"Eat recuperado em nova grama"
			else
				temporarilyIgnoreGrass(grass, 4)
				runtimeMessage =
					"Grama sem prompt Eat; procurando outra"
			end
		else
			temporarilyIgnoreGrass(grass, 4)
		end
	elseif isSavannahLife and food < 92 then
		runtimeMessage =
			"Eat watchdog: sem grama local; iniciando busca rumo ao Pride Rock"

		local searched, searchReason, searchGrass =
			state.grassSearchTowardPride(92)

		if searched then
			task.wait(0.10)
			character, root = characterParts()

			if character and root
				and state.grassEatAvailable(character) then

				eatingSourcePosition =
					searchGrass or root.Position
				eatingTargetReachedAt = tick()

				startGrassEatingIfAvailable(
					character,
					root,
					eatingSourcePosition
				)
			end
		elseif searchReason ~= "cooldown"
			and searchReason ~= "food_area_restricted" then

			runtimeMessage =
				"Eat watchdog: busca de grama interrompida ("
				.. tostring(searchReason)
				.. ")"
		end
	end

	eatingStuckSince = nil
end

-- ============================================================
-- SURVIVAL ARBITER
-- Food and Water are mutually exclusive long-running jobs. Once one need owns
-- survival, the other may not steal movement just because its percentage changes
-- by a few points. Only critical thirst may preempt an active food job.
-- ============================================================
state.survivalArbiter = state.survivalArbiter or {
	owner = nil,
	ownerSince = 0,
	lastOwner = nil,
	handoffNotBefore = 0,
	lastProgressAt = 0,
	lastValue = nil,
	preemptions = 0,
}

function state.survivalArbiterReset(reason)
	local arbiter = state.survivalArbiter
	arbiter.owner = nil
	arbiter.ownerSince = 0
	arbiter.lastOwner = nil
	arbiter.handoffNotBefore = 0
	arbiter.lastProgressAt = tick()
	arbiter.lastValue = nil
	arbiter.preemptions = 0
end

function state.authoritativeSurvivalOwner()
	local ai = state.MMBAI
	local authority = ai and ai.Authority

	if not authority or authority.exclusive ~= true then
		return nil
	end

	if authority.currentOwner == "Food" then
		return "food"
	elseif authority.currentOwner == "Water" then
		return "water"
	end

	return nil
end

function state.waterShouldPreemptFood(character, threshold)
	local authoritative = state.authoritativeSurvivalOwner()
	if authoritative == "food" then
		return false
	elseif authoritative == "water" then
		return true
	end

	local water = character
		and tonumber(character:GetAttribute("Water"))
		or 100

	return state.autoDrink == true
		and water <= (tonumber(threshold) or 72)
end

function state.survivalFoodEmergency(food, water)
	food =
		tonumber(food) or 100

	water =
		tonumber(water) or 100

	if not state.autoEat then
		return false
	end

	local authoritative = state.authoritativeSurvivalOwner()

	-- The Supervisor is the final vital arbiter. Legacy percentages may not
	-- contradict an already-elected exclusive Food/Water owner.
	if authoritative == "food" then
		return food <= 25
	elseif authoritative == "water" then
		return false
	end

	-- Standalone/no-Supervisor fallback.
	return food <= 25
		and (
			not state.autoDrink
				or water > 45
		)
end

function state.survivalArbiterChoose(food, water)
	food = tonumber(food) or 100
	water = tonumber(water) or 100

	local authoritative = state.authoritativeSurvivalOwner()
	if authoritative then
		return authoritative
	end

	-- Standalone/no-Supervisor fallback.
	-- Critical thirst always wins.
	if state.autoDrink and water <= 45 then
		return "water"
	end

	-- HARD STARVATION PRIORITY:
	-- once Food reaches emergency level, a safe/non-critical Water value is enough.
	-- Do NOT let an old Drink transaction keep the animal in water until it dies.
	if state.survivalFoodEmergency(
		food,
		water
	) then
		return "food"
	end

	local waterNeed = state.autoDrink and water <= 75
	local foodNeed = state.autoEat and food < 92

	if waterNeed and foodNeed then
		if water <= 60 or water <= food - 8 then
			return "water"
		end
		return "food"
	elseif waterNeed then
		return "water"
	elseif foodNeed then
		return "food"
	end

	return nil
end

function state.survivalArbiterAcquire(kind, food, water, reason)
	if kind ~= "food" and kind ~= "water" then
		return false
	end

	local arbiter = state.survivalArbiter
	local now = tick()
	food = tonumber(food) or 100
	water = tonumber(water) or 100

	local authoritative = state.authoritativeSurvivalOwner()
	if authoritative and kind ~= authoritative then
		return false
	end

	if arbiter.owner == kind then
		return true
	end

	if arbiter.owner ~= nil then
		if authoritative and kind == authoritative then
			-- Repair a stale opposite legacy owner immediately.
			arbiter.preemptions = (arbiter.preemptions or 0) + 1
		else
		-- Food may only be interrupted for genuinely dangerous thirst. Normal
		-- Water <=75 is NOT enough to abandon a grass/tree/carcass route.
		local emergencyWaterPreempt =
			kind == "water"
			and arbiter.owner == "food"
			and state.autoDrink
			and water <= 45

		local emergencyFoodPreempt =
			kind == "food"
			and arbiter.owner == "water"
			and state.survivalFoodEmergency(
				food,
				water
			)

		if not emergencyWaterPreempt
			and not emergencyFoodPreempt then

			return false
		end

		arbiter.preemptions = (arbiter.preemptions or 0) + 1
		end
	end

	-- Small dead-band after a completed job prevents Eat/Drink from swapping on
	-- adjacent scheduler frames. Critical Water bypasses it.
	if now < (arbiter.handoffNotBefore or 0)
		and kind ~= arbiter.lastOwner
		and not authoritative
		and not (kind == "water" and water <= 45) then
		return false
	end

	arbiter.owner = kind
	arbiter.ownerSince = now
	arbiter.lastProgressAt = now
	arbiter.lastValue = kind == "water" and water or food

	return true
end

function state.survivalArbiterNoteProgress(kind, value)
	local arbiter = state.survivalArbiter
	if arbiter.owner ~= kind then return end

	value = tonumber(value)
	if not value then return end

	if arbiter.lastValue == nil or value > arbiter.lastValue + 0.01 then
		arbiter.lastValue = value
		arbiter.lastProgressAt = tick()
	end
end

function state.survivalArbiterComplete(kind)
	local arbiter = state.survivalArbiter
	if arbiter.owner ~= kind then return false end

	arbiter.lastOwner = kind
	arbiter.owner = nil
	arbiter.ownerSince = 0
	arbiter.lastProgressAt = tick()
	arbiter.lastValue = nil
	arbiter.handoffNotBefore = tick() + 1.1
	return true
end

-- HARD starvation handoff. This is deliberately independent from the AI
-- Supervisor so the same invariant also protects older/no-Supervisor builds:
-- Food <=25 with non-critical Water must be able to break a stale Quest/Drink
-- movement transaction immediately.
state.survivalFoodEmergencyHandoffAt =
	state.survivalFoodEmergencyHandoffAt or 0

function state.survivalForceFoodHandoff(character, reason)
	if not character
		or character ~= player.Character
		or not state.autoEat then
		return false
	end

	local food =
		tonumber(character:GetAttribute("Food")) or 100
	local water =
		tonumber(character:GetAttribute("Water")) or 100

	if state.authoritativeSurvivalOwner() == "water" then
		return false
	end

	if not state.survivalFoodEmergency(food, water) then
		return false
	end

	-- Never steal an actual Safety extraction.
	if state.aiSupervisorSafetyOverride
		and state.aiSupervisorSafetyOverride() then
		return false
	end

	local now = tick()
	state.survivalFoodEmergencyHandoffAt = now

	-- Stop BOTH precise Water and water_search. forceStopActiveDrink also clears
	-- the real Drinking substate so opportunistic quest water cannot root us.
	if state.forceStopActiveDrink then
		pcall(
			state.forceStopActiveDrink,
			character,
			reason or "CRITICAL FOOD: preempting Drink/Quest"
		)
	else
		drinkingToFull = false
		drinkingSourcePosition = nil
		drinkingStuckSince = nil
	end

	-- A live quest/growth route can keep state.busy=true forever from Auto Eat's
	-- point of view. Cancel only automation routes; Manual/Safety/slot recovery
	-- remain protected.
	if state.safeMove
		and state.safeMove.active then

		local purpose = state.safeMove.reason
		local cancelRoute =
			purpose == "water"
			or purpose == "water_search"
			or purpose == "quest"
			or purpose == "growth_home"

		if cancelRoute then
			state.safeMove.cancelToken += 1
			state.safeMove.active = false
			state.safeMove.target = nil
			state.safeMove.reason = nil
			state.safeMove.manualLabel = nil
			state.safeMove.landQuestW = false
			state.busy = false
		end
	end

	if state.heavyWalk
		and state.heavyWalk.owner == "autoRun"
		and state.heavyWalkStop then
		pcall(state.heavyWalkStop, character)
	end

	state.questMotionMoving = false
	state.questMotionMode = nil
	state.autoRunMoveOwnsInput = false

	if state.questSetW then
		pcall(state.questSetW, false)
	end

	if state.questSetLandPermanentW then
		pcall(state.questSetLandPermanentW, false)
	end

	state.releaseMovementNow(character, true)

	state.survivalArbiterReset(
		reason or "critical starvation handoff"
	)
	state.survivalArbiterAcquire(
		"food",
		food,
		water,
		reason or "critical starvation handoff"
	)

	if state.aiSupervisorSignal then
		pcall(
			state.aiSupervisorSignal,
			"CriticalFood",
			"Food",
			reason or "critical starvation handoff",
			980,
			4
		)
	end

	runtimeMessage = string.format(
		"CRITICAL FOOD %d%%: Food preempted Drink/Quest",
		math.floor(food)
	)

	return true
end

function state.survivalForceWaterHandoff(
	character,
	reason
)
	if not character
		or not state.autoDrink then
		return false
	end

	local water =
		tonumber(
			character:GetAttribute(
				"Water"
			)
		) or 100

	if water > 75 then
		return false
	end

	local food =
		tonumber(
			character:GetAttribute(
				"Food"
			)
		) or 100

	if state.authoritativeSurvivalOwner() == "food" then
		return false
	end

	-- A subsystem has already stopped Food specifically because Water now has
	-- priority. Do not leave stale owner="food" behind or Eat/Drink deadlock.
	state.survivalArbiterReset(
		reason
			or "explicit water handoff"
	)

	state.survivalArbiterAcquire(
		"water",
		food,
		water,
		reason
			or "explicit water handoff"
	)

	-- Water priority must also own MOVEMENT. Otherwise Auto Eat sees owner=water
	-- and returns while Auto Drink sees state.busy from the old Food route and
	-- returns too, leaving the animal frozen.
	if state.safeMove
		and state.safeMove.active
		and state.safeMove.reason == "food" then
		state.safeMove.cancelToken += 1
		state.safeMove.active = false
		state.safeMove.target = nil
		state.safeMove.reason = nil
		state.safeMove.manualLabel = nil
		state.busy = false
		state.releaseMovementNow(character, true)
	end

	-- Keep the carcass Instance lock, but release Eating posture/state so Drink can
	-- take over immediately and Auto Eat can resume the same carcass afterwards.
	eatingToFull = false
	eatingSourcePosition = nil
	eatingTargetReachedAt = nil
	eatingStuckSince = nil
	blockClientSubState = false

	return true
end

local function autoEatStep()
	if state.dinoShorelineRecovery and state.dinoShorelineRecovery.active then return end
	if state.dinoRockEmergency and state.dinoRockEmergency.supervisorActive
		and state.dinoRockEmergency.supervisorCharacter == player.Character then
		return
	end
	local emergencyCharacter = player.Character
	local emergencyFood =
		emergencyCharacter
		and tonumber(emergencyCharacter:GetAttribute("Food"))
		or 100
	local emergencyWater =
		emergencyCharacter
		and tonumber(emergencyCharacter:GetAttribute("Water"))
		or 100

	local emergencyFoodNeed =
		emergencyCharacter
		and state.survivalFoodEmergency(
			emergencyFood,
			emergencyWater
		)
		or false

	local emergencyHandoff = false
	if emergencyFoodNeed
		and state.survivalForceFoodHandoff then
		emergencyHandoff =
			state.survivalForceFoodHandoff(
				emergencyCharacter,
				"Auto Eat critical starvation preemption"
			) == true
	end

	-- Circuit breakers/quest authority may delay normal Food work, but they may
	-- not keep a starving animal behind a stale Drink/Quest owner.
	if not emergencyHandoff
		and not state.aiModuleOperational("AutoEat") then return end
	if not emergencyHandoff
		and not state.aiMovementOperational("Food") then return end
	if state.herbivoreFoodRecovery
		and state.herbivoreFoodRecovery.active
		and state.herbivoreFoodRecovery.character
			== player.Character then

		return
	end

	if GIRAFFE.exclusiveRecovery
		and GIRAFFE.exclusiveRecovery.active
		and isGiraffeCharacter(
			player.Character
		) then

		return
	end

	if state.slotParkingAudit and state.slotParkingAudit.active then return end
	if state.aquaticRiverEscape
		and state.aquaticRiverEscape.survivalSuspended then
		return
	end

	if state.questGrowthReset.exclusive then return end

	-- Swim quest owns movement completely only while a REAL incomplete Swim
	-- quest still exists. Check liveness first so a completed quest can never
	-- leave Auto Eat paused behind a stale questSwimActive flag.
	if state.autoQuests
		and state.questSwimActive
		and not emergencyHandoff
		and not (
			state.questReleaseCompletedSwimIfNeeded
			and state.questReleaseCompletedSwimIfNeeded()
		) then
		if state.safeMove
			and state.safeMove.active
			and state.safeMove.reason == "food" then
			state.safeMove.cancelToken += 1
		end

		state.questCarnivoreFeeding = false
		state.questBaboonFeeding = false
		state.questGiraffeFeeding = false
		if state.questTravelHerbivoreFeed then
			state.questTravelHerbivoreFeed.active = false
		end

		eatingToFull = false
		eatingSourcePosition = nil
		eatingTargetReachedAt = nil
		eatingStuckSince = nil
		BABOON.cancel()
		GIRAFFE.cancel()

		if state.survivalArbiter
			and state.survivalArbiter.owner == "food" then
			state.survivalArbiterComplete("food")
		end

		runtimeMessage = "Swim quest active: Auto Eat paused until Swim finishes"
		return
	end

	-- A stale quest movement owner must be cleaned BEFORE the generic busy gate.
	-- This makes re-executing the Hub equivalent to the user's manual
	-- Auto Quests OFF/ON workaround, but automatically and safely.
	if isSavannahLife
		and state.autoQuests
		and state.questRefreshMovementPrioritySnapshot then

		pcall(
			state.questRefreshMovementPrioritySnapshot,
			false
		)
	end

	if isSavannahLife
		and state.autoQuests
		and state.savannahCarcassPhysicalQuestBlocked
		and not state.savannahCarcassPhysicalQuestBlocked(
			player.Character
		) then

		-- No real quest needs locomotion. Any surviving quest SafeMove / AutoRun
		-- lock is stale and must not stop carnivore scavenging.
		if state.safeMove
			and state.safeMove.active
			and state.safeMove.reason == "quest" then

			state.safeMove.cancelToken += 1
			state.safeMove.active = false
			state.safeMove.target = nil
			state.safeMove.reason = nil
			state.safeMove.manualLabel = nil
			state.safeMove.landQuestW = false
			state.busy = false
		end

		if state.heavyWalk
			and state.heavyWalk.owner == "autoRun"
			and state.heavyWalkStop
			and player.Character then

			pcall(
				state.heavyWalkStop,
				player.Character
			)
		end
	end

	-- Slot-switch Food safety is an explicit high-priority transaction.
	-- A completed Growth slot must never be blocked by an old growth_home route.
	if preSwitchFoodTarget
		and state.autoGrowModeActive()
		and player.Character then

		state.growthTopUpReleaseCompletedGrowthMovement(
			player.Character
		)
	end

	-- Post-drink dry-bank recovery must be able to repair a stale
	-- criticalRecoveryActive/busy flag. Check it BEFORE the generic recovery gate.
	do
		local exitCharacter, exitRoot = characterParts()
		if state.autoEat
			and isDinoLife
			and exitCharacter
			and exitRoot
			and state.dinoPostDrinkDryExitRequired(exitCharacter, exitRoot) then
			if state.requestDinoPostDrinkDryExit then
				state.requestDinoPostDrinkDryExit(
					exitCharacter,
					"Auto Eat detected unfinished post-drink dry-bank exit"
				)
			end
			return
		end
	end

	if not state.autoEat or criticalRecoveryActive then return end
	if state.slotSwitchStagingActive == true then return end
	if (state.busy or drinkingToFull) and not emergencyHandoff then return end
	local character, root = characterParts()
	if not character or not root then return end
	if carcassEatBusy or BABOON.busy or GIRAFFE.busy then return end

	local food = character:GetAttribute("Food") or 100
	local water = character:GetAttribute("Water") or 100

	-- Completed Auto-Grow slots with safe vitals belong to the Reset Point pipeline,
	-- not to passive carcass hunting. This closes the frame window before staging
	-- becomes active and prevents a full carnivore from reacquiring Food ownership.
	if state.autoGrowModeActive
		and state.autoGrowModeActive()
		and state.autoGrowCurrentSlotComplete
		and state.autoGrowCurrentSlotComplete(character) then

		local completedThreshold =
			isCarnivoreCharacter(character) and 50 or 60

		if food > completedThreshold
			and water > completedThreshold then

			if activeCarcass ~= nil
				or activeCarcassCommitted
				or carcassEatBusy then

				state.carcassController.cancelRequested = true
				state.carcassController.token += 1
				clearActiveCarcass(true)
				carcassEatBusy = false
			end

			eatingToFull = false
			state.questCarnivoreFeeding = false
			return
		end
	end

	if state.dinoPostDrinkDryExitRequired(
		character,
		root
	) then

		state.carcassController.cancelRequested =
			true

		state.carcassController.token += 1

		carcassEatBusy = false

		clearActiveCarcass(
			true
		)

		eatingToFull = false
		eatingSourcePosition = nil
		eatingTargetReachedAt = nil
		eatingStuckSince = nil

		if state.survivalArbiter
			and state.survivalArbiter.owner
				== "food" then

			state.survivalArbiterComplete(
				"food"
			)
		end

		runtimeMessage =
			"Rex post-drink: exiting water before any Food/carcass controller"

		mmbTaskDefer(function()
			task.wait(0.02)
			local liveCharacter = player.Character
			if state.requestDinoPostDrinkDryExit and liveCharacter then
				pcall(
					state.requestDinoPostDrinkDryExit,
					liveCharacter,
					"Auto Eat yielded to post-drink Safety"
				)
			else
				pcall(state.noIdleWaterSafetyStep)
			end
		end)

		return
	end

	state.survivalArbiterNoteProgress("food", food)
	state.survivalArbiterNoteProgress("water", water)

	local authoritativeOwner = state.authoritativeSurvivalOwner()
	local survivalOwner = state.survivalArbiter.owner

	if authoritativeOwner == "food"
		and survivalOwner ~= "food" then
		state.survivalArbiterReset(
			"Auto Eat synchronized to Supervisor Food"
		)
		state.survivalArbiterAcquire(
			"food",
			food,
			water,
			"Auto Eat synchronized to Supervisor Food"
		)
		survivalOwner = state.survivalArbiter.owner
	end

	if survivalOwner == "water"
		and authoritativeOwner ~= "food" then
		return
	end

	if survivalOwner == nil then
		local preferredNeed = state.survivalArbiterChoose(food, water)
		if preferredNeed == "water" then
			state.survivalArbiterAcquire("water", food, water, "initial arbitration")
			return
		end
	end

	-- v80: after an herbivore leaves Pride Rock to drink, it must return to
	-- Pride Rock BEFORE looking for grass/tree food. Drinking is the sole
	-- automatic exception to the Pride Growth leash.
	if state.growthPrideRestrictionActive(character)
		and not state.growthPrideInside(
			character,
			root
		) then

		state.growthPride.returnRequested = true

		runtimeMessage =
			water <= 75
			and "Growth herbivore: outside Pride Rock only for water"
			or "Growth herbivore: returning to Pride Rock before eating"

		return
	end
	local giraffe = isGiraffeCharacter(character)
	local baboon = not giraffe and isBaboonCharacter(character)
	local carnivore = not giraffe and not baboon and isCarnivoreCharacter(character)

	local passiveCarnivoreScavenge =
		carnivore
		and state.carnivorePassiveScavengeAllowed(
			character
		)

	-- EXCLUSIVE CARCASS LOCK:
	-- Outside actionable quests, a committed carcass stays exclusive until the
	-- Instance disappears. During Auto Quests the rule is intentionally different:
	-- finish the CURRENT feeding cycle only to 100%, release the carcass even if it
	-- still exists, and immediately hand movement back to the quest controller.
	if carnivore and activeCarcassCommitted then
		if activeCarcassStillExists() then
			local questPriority =
				state.autoQuests == true
				and state.savannahHasLiveLocomotionQuest
				and state.savannahHasLiveLocomotionQuest()

			if questPriority then
				local questFeedCommitted =
					state.questCarnivoreFeeding == true

				local releaseForQuest =
					(not questFeedCommitted and food > 70)
					or (questFeedCommitted and food >= 100)

				if releaseForQuest then
					clearActiveCarcass(true)
					eatingToFull = false
					state.questCarnivoreFeeding = false
					eatingStuckSince = nil
					state.survivalArbiterComplete("food")
					state.questForceFastRecheckUntil = tick() + 12
					runtimeMessage =
						questFeedCommitted
						and "Carnivore full; carcass released for Auto Quests"
						or "Auto Quests priority: passive carcass released"
					return
				end
			end

			local lockedRoot =
				activeCarcass:FindFirstChild("HumanoidRootPart")
				or activeCarcass:FindFirstChildWhichIsA("BasePart", true)

			if lockedRoot then
				eatingToFull = true
				runtimeMessage =
					questPriority
					and string.format(
						"Quest feeding: finishing current carcass to 100%% (%d%%)",
						math.floor(food)
					)
					or string.format(
						"Finishing locked carcass (Food %d%%)",
						math.floor(food)
					)

				if not carcassEatBusy then
					task.spawn(
						eatCarcass,
						activeCarcass,
						lockedRoot,
						false
					)
				end
			else
				runtimeMessage =
					"Locked carcass still exists; waiting for its interaction part"
			end

			return
		else
			clearActiveCarcass(true)
		end
	end

	-- Zone carnivore policy:
	-- the protection starts as soon as a ZoneTime quest owns routing, not only
	-- after the animal is already physically inside the zone. Carnivores wait
	-- until <=60%, then feed to 100% and return to the zone.
	-- For TravelDistance and other real locomotion quests, the quest feeding
	-- threshold applies. GroupTime itself is parallel and never blocks scavenging.
	local zoneSurvivalFeeding =
		state.autoQuests
			and (
				state.questZonePriorityActive()
					or (
					state.questZoneDrinkOverride
					and state.questZoneDrinkOverride.active
				)
			)
			and not preSwitchFoodTarget

	local questCarnivore =
		state.autoQuests == true
		and carnivore
		and not preSwitchFoodTarget
		and state.savannahHasLiveLocomotionQuest
		and state.savannahHasLiveLocomotionQuest()

	local questCarnivoreFoodThreshold =
		zoneSurvivalFeeding
			and 60
			or 70

	local questBaboon =
		zoneSurvivalFeeding and baboon

	local questGiraffe =
		zoneSurvivalFeeding and giraffe

	-- v109:
	-- During pure TravelDistance, grass-eating herbivores should not abandon
	-- Auto Run every time Food drops a little. Start a real feeding route only
	-- at <=60%. v4.1 upgrades that pause into a full Survival refill.
	local travelHerbivoreFeeding =
		state.autoQuests
			and state.questTravelActive
			and not state.questSwimActive
			and not (
				state.questZoneDrinkOverride
				and state.questZoneDrinkOverride.active
			)
			and not carnivore
			and not baboon
			and not giraffe
			and not preSwitchFoodTarget

	if travelHerbivoreFeeding then
		if not state.questTravelHerbivoreFeed.active
			and food <= 60 then

			state.questTravelHerbivoreFeed.active = true

		elseif state.questTravelHerbivoreFeed.active
			and food >= 99.5 then

			state.questTravelHerbivoreFeed.active = false
		end
	else
		state.questTravelHerbivoreFeed.active = false
	end

	-- While terrestrial Auto Run is active, a normal herbivore must NOT fall
	-- through to the generic 92% food cap. Above 60% it may only eat
	-- opportunistically under its feet while continuing the route. A dedicated
	-- grass search starts at <=60; Travel resumes only after the full refill gate.
	if travelHerbivoreFeeding
		and not state.questTravelHerbivoreFeed.active then

		if state.questMovementOpportunisticInteract then
			pcall(
				state.questMovementOpportunisticInteract,
				character,
				root
			)
		end

		eatingToFull = false
		eatingSourcePosition = nil
		eatingTargetReachedAt = nil
		eatingStuckSince = nil
		return
	end

	-- Baboon never competes with Auto Drink. If Water needs service, drop all
	-- Baboon food ownership immediately and let autoDrinkStep take over.
	if baboon and water <= 75 then
		state.questBaboonFeeding = false
		eatingToFull = false
		BABOON.cancel()
		eatingStuckSince = nil
		lastEatWatchdogFood = food
		return
	end

	-- Giraffe eats ONLY tree Leaves from workspace.MapAssets.MainAssets.
	-- During an active ZoneTime it may delay feeding to <=70% to avoid leaving the zone.
	if questGiraffe then
		if not state.questGiraffeFeeding and food <= 70 then
			state.questRememberZoneBeforeFeeding("Giraffe feeding")
			state.questGiraffeFeeding = true
			eatingToFull = true
			runtimeMessage = "Giraffe: Food <= 70%; pausing quests to eat tree leaves"
		end

		if state.questGiraffeFeeding then
			if food >= 100 then
				state.questGiraffeFeeding = false
				eatingToFull = false
				state.survivalArbiterComplete("food")
				resetEatingSearch(food)
				GIRAFFE.cancel()
				eatingStuckSince = nil
				runtimeMessage = "Giraffe full; returning to quests"
				return
			end
		else
			return
		end
	elseif state.questGiraffeFeeding then
		state.questGiraffeFeeding = false
		GIRAFFE.cancel()
	end

	-- Baboon is an omnivore with an EXCLUSIVE dual-food controller:
	-- nearest Carcass OR workspace.MapAssets.AntHills. Once selected, that
	-- source remains locked until it feeds successfully or is proven bad.
	if questBaboon then
		if not state.questBaboonFeeding and food <= 70 then
			state.questRememberZoneBeforeFeeding("Baboon feeding")
			state.questBaboonFeeding = true
			eatingToFull = true
			runtimeMessage = "Baboon: Food <= 70%; pausing quests to feed"
		end

		if state.questBaboonFeeding then
			if food >= 100 then
				state.questBaboonFeeding = false
				eatingToFull = false
				state.survivalArbiterComplete("food")
				resetEatingSearch(food)
				BABOON.cancel()
				eatingStuckSince = nil
				runtimeMessage = "Baboon full; returning to quests"
				return
			end
		else
			-- Above 70%, do not abandon Auto Run/Zone just to feed.
			return
		end
	elseif state.questBaboonFeeding then
		state.questBaboonFeeding = false
		BABOON.cancel()
	end

	-- Carnivore while actionable Auto Quests exist:
	--   normal quests: only interrupt at <=70%;
	--   ZoneTime: only interrupt at <=60%;
	-- once a feeding cycle starts, fill to 100%, RELEASE the carcass even if its
	-- Instance still exists, then resume quests. No passive scavenging in between.
	if questCarnivore then
		if not state.questCarnivoreFeeding
			and food <= questCarnivoreFoodThreshold then

			state.questRememberZoneBeforeFeeding("Carnivore feeding")
			state.questCarnivoreFeeding = true
			eatingToFull = true

			-- Transition from quest movement to ACTIVE survival search immediately.
			-- Never inherit a 15-second passive-patrol wait from an older state.
			nextCarnivoreExploreCheck = 0
			savannahCarcassCurrentSpawn = nil

			runtimeMessage = string.format(
				"Carnivore: Food <= %d%%; pausing quests to eat",
				questCarnivoreFoodThreshold
			)
		end

		if state.questCarnivoreFeeding then
			if food >= 100 then
				state.questCarnivoreFeeding = false
				eatingToFull = false
				state.survivalArbiterComplete("food")
				resetEatingSearch(food)
				clearActiveCarcass(true)
				eatingStuckSince = nil
				state.questForceFastRecheckUntil = tick() + 12
				runtimeMessage =
					"Carnivore full; carcass released; returning to quests"
				return
			end
		else
			-- Food is comfortable: quests own the animal. Do not approach, retain or
			-- search for a carcass merely because Auto Eat is enabled.
			return
		end
	elseif state.questCarnivoreFeeding then
		state.questCarnivoreFeeding = false
	end

	local travelFullRefillFood =
		state.questTravelFullRefill
		and state.questTravelFullRefill.active
		and state.questTravelFullRefill.owner == "food"

	local foodCap =
		travelFullRefillFood
			and 100
			or passiveCarnivoreScavenge
			and 100
			or (
				(questCarnivore or questBaboon or questGiraffe)
					and 100
					or (
						travelHerbivoreFeeding
							and state.questTravelHerbivoreFeed.active
							and 100
					)
					or (
						preSwitchFoodTarget
							or 92
					)
			)

	if food < foodCap then
		if not state.survivalArbiterAcquire(
			"food",
			food,
			water,
			"Auto Eat committed"
		) then
			return
		end
	end

	if food >= foodCap then
		local wasEating =
			eatingToFull

		if wasEating and not passiveCarnivoreScavenge then
			state.forceStopEatingSubState(
				character,
				"Food target reached"
			)
		end

		eatingToFull =
			false

		state.survivalArbiterNoteProgress(
			"food",
			food
		)

		state.survivalArbiterComplete(
			"food"
		)

		resetEatingSearch(
			food
		)

		eatingStuckSince =
			nil

		if state.questTravelHerbivoreFeed
			and state.questTravelHerbivoreFeed.active
			and food >= 99.5 then

			state.questTravelHerbivoreFeed.active =
				false

			runtimeMessage =
				"Auto Run food refill complete; checking Water before TravelDistance"
		end

		if wasEating
			and state.autoQuests
			and not passiveCarnivoreScavenge then

			state.questForceFastRecheckUntil =
				tick() + 12

			runtimeMessage =
				"Food stable; resuming quest controller"
		end

		if not passiveCarnivoreScavenge then
			activeCarcass =
				nil

			return
		end

		-- Full carnivore intentionally falls through into the carcass controller.
	end

	local availableFood = detectAvailableFood(character)

	-- LOCAL PROMPT WINS. This is deliberately checked before any verified-grass
	-- search (including the 540-stud emergency scan). A visible Eat prompt means
	-- Savannah already accepts the current position, so searching/moving elsewhere
	-- would be both slower and wrong.
	if availableFood ~= "Eat"
		and state.eatVisualPromptVisible
		and state.eatVisualPromptVisible() then

		availableFood = "Eat"
	end

	local movementInteraction

	if state.questMovementOpportunisticInteract then
		movementInteraction =
			state.questMovementOpportunisticInteract(
				character,
				root
			)
	end

	-- TravelDistance grass policy:
	-- if grass is already under the running herbivore, use it in-place while
	-- Auto Run keeps owning movement. A real grass route is allowed only after
	-- that on-path opportunity/grace is gone.
	if travelHerbivoreFeeding then
		local grassOnPath =
			availableFood == "Eat"
				and state.questMotionMoving
				and state.questMotionMode == "Land"

		local grassGrace =
			state.questMoveInteract
				and tick()
					< (
						state.questMoveInteract.grassGraceUntil
							or 0
					)

		if grassOnPath
			or movementInteraction == "eat"
			or movementInteraction == "eat_grace"
			or grassGrace then

			eatingToFull = false
			eatingSourcePosition = nil
			eatingTargetReachedAt = nil
			eatingStuckSince = nil

			runtimeMessage =
				"Auto Run: eating grass while moving"

			return
		end

		if not state.questTravelHerbivoreFeed.active then
			-- Food is still comfortable. Keep running and do NOT create a
			-- moveToGrass/SafeMove food route.
			return
		end

		eatingToFull = true

		runtimeMessage =
			string.format(
				"Auto Run food refill (%d%% -> 100%%)",
				math.floor(food)
			)
	end

	local passiveOnly =
		passiveCarnivoreScavenge
		and food >= foodCap

	if not passiveOnly then
		if not eatingToFull then
			state.questRememberZoneBeforeFeeding(
				"feeding"
			)
		end

		eatingToFull =
			true

		if lastEatWatchdogFood == nil
			or food > lastEatWatchdogFood then

			lastEatWatchdogFood =
				food

			eatingStuckSince =
				tick()

		elseif not eatingStuckSince then
			eatingStuckSince =
				tick()
		end

		if eatingStuckSince
			and tick()
				- eatingStuckSince
				>= 15 then

			lastEatWatchdogFood =
				food

			eatingStuckSince =
				tick()

			virtualEatKick()
			return
		end
	else
		-- Full Food patrol is movement/search only; it does not own Survival.
		eatingToFull =
			false

		eatingStuckSince =
			nil

		lastEatWatchdogFood =
			food
	end

	if giraffe then
		if GIRAFFE.busy then return end

		local selected = nearestGiraffeTree(root)
		if selected then
			GIRAFFE.noReachableTreeSince = 0

			runtimeMessage = string.format(
				"Giraffe: using %s tree leaves (%.0f studs)",
				selected.locked and "locked" or "nearest available",
				selected.distance or 0
			)
			task.spawn(giraffeEatLockedTree, selected)
		else
			GIRAFFE.noReachableTreeSince =
				GIRAFFE.noReachableTreeSince > 0
					and GIRAFFE.noReachableTreeSince
					or tick()

			local waitingFor =
				tick()
					- GIRAFFE.noReachableTreeSince

			if preSwitchFoodTarget then
				runtimeMessage =
					"Giraffe slot safety: no reachable Leaves found yet; rescanning"

				GIRAFFE.clearTarget()
			else
				runtimeMessage =
					"Giraffe: no reachable tree; verifying before Pride Rock fallback"
			end

			if food < foodCap
				and waitingFor >= 4
				and not GIRAFFE.failedEatPrideBusy
				and tick()
					>= (
						GIRAFFE.failedEatPrideCooldownUntil
							or 0
					) then

				local oldTree =
					GIRAFFE.lastRejectedTree

				if state.giraffeStartExclusivePrideRecovery then
					state.giraffeStartExclusivePrideRecovery(
						oldTree,
						"no_reachable_tree"
					)
				end

				GIRAFFE.noReachableTreeSince = 0
			end
		end

		if selected then
			GIRAFFE.noReachableTreeSince = 0
		end

		return
	end

	if baboon then
		if BABOON.busy then return end

		local selected = chooseBaboonFood(root)
		if selected then
			runtimeMessage = string.format(
				"Baboon: nearest food is %s (%.0f studs); target locked",
				selected.kind,
				selected.distance or 0
			)
			task.spawn(baboonEatLockedTarget, selected)
		else
			runtimeMessage = "Baboon: no carcass or AntHill currently available"
		end
		return
	end

	if carnivore then
		if carcassEatBusy then return end

		local carcass = activeCarcass
		local carcassRoot = carcass and (
			carcass:FindFirstChild("HumanoidRootPart")
			or carcass:FindFirstChildWhichIsA("BasePart", true)
		)

		if not carcassRoot then
			carcass, carcassRoot = nearestCarcass(root)
		end

		if carcass and carcassRoot then
			runtimeMessage = questCarnivore
				and string.format("Carnivore feeding to 100%% (Food %d%%)", math.floor(food))
				or "Indo comer carcaça"
			task.spawn(eatCarcass, carcass, carcassRoot)
		else
			runtimeMessage = questCarnivore
				and string.format("Carnivore feeding: searching carcass (Food %d%%)", math.floor(food))
				or "Carnivoro sem carcaça por perto"

			if isSavannahLife or isDinoLife then
				-- Hungry carnivores actively stream the map through safe Spawn Locations
				-- and scan for carcasses during the whole route. Dino shares the proven
				-- Savannah engine but filters aquatic/water spawn points.
				local usePassivePatrol =
					isSavannahLife
					and passiveCarnivoreScavenge
					and food >= 92

				local passiveQuestContinuous =
					isSavannahLife
					and state.autoQuests
					and state.savannahHasLiveLocomotionQuest
					and not state.savannahHasLiveLocomotionQuest()

				exploreSavannahCarcassSpawns(
					usePassivePatrol,
					passiveQuestContinuous or isDinoLife
				)
			elseif tick() >= nextCarnivoreExploreCheck then
				nextCarnivoreExploreCheck = tick() + 20
				local spot = findSafeTerrainSpot(root.Position, 20, 60)
				if spot then
					runtimeMessage = "Procurando carcaça em outra area (terreno seguro)"
					safeMoveToPosition(
					spot,
					7,
					nil,
					{ purpose = "food", tolerance = 14 }
				)
				end
			end
		end
		return
	end

	if availableFood == "Eat" then
		eatingSourcePosition = root.Position
		eatingTargetReachedAt = tick()
		runtimeMessage = "Comendo a grama proxima"
		startGrassEatingIfAvailable(character, root, eatingSourcePosition)
		return
	end

	-- v124: verified grass controller.
	if eatingSourcePosition
		and eatingTargetReachedAt then

		if state.grassEatAvailable(
			character
		) then
			if startGrassEatingIfAvailable(
				character,
				root,
				eatingSourcePosition
			) then

				runtimeMessage =
					"Eat confirmado na grama atual"

				return
			end
		end

		-- Do not remain stuck claiming a non-working grass point.
		if tick()
				- eatingTargetReachedAt
				> 0.85 then

			temporarilyIgnoreGrass(
				eatingSourcePosition,
				7,
				14
			)

			eatingSourcePosition = nil
			eatingTargetReachedAt = nil
		else
			faceGrassPoint(
				root,
				eatingSourcePosition
			)

			runtimeMessage =
				"Aguardando confirmacao Eat na grama"

			return
		end
	end

	local grass,
		grassDistance,
		grassSamples =
			findNearestGrass(
				root.Position
			)

	-- If PrideRock (or any other terrain condition) invalidates the nearby
	-- patches, NEVER leave a hungry herbivore standing still. Expand the search
	-- progressively and route to a verified patch farther away. The cooldown is
	-- short only to avoid repeating the large radial scan every scheduler frame.
	if not grass
		and food < foodCap
		and tick()
			>= nextEmergencyGrassCheck then

		nextEmergencyGrassCheck =
			tick() + 8

		local distantGrass =
			findDistantGrass(
				root.Position
			)

		if distantGrass then
			runtimeMessage =
				string.format(
					"Nenhuma grama local; buscando grama mais longe (Food %d%%)",
					math.floor(food)
				)

			local moved,
				moveReason =
					moveToGrass(
						distantGrass
					)

			if moved then
				task.wait(0.12)

				local liveCharacter,
					liveRoot =
						characterParts()

				if liveCharacter
					and liveRoot
					and state.grassEatAvailable(
						liveCharacter
					) then

					eatingSourcePosition =
						liveRoot.Position

					eatingTargetReachedAt =
						tick()

					startGrassEatingIfAvailable(
						liveCharacter,
						liveRoot,
						distantGrass
					)
				else
					temporarilyIgnoreGrass(
						distantGrass,
						10,
						18
					)
				end
			else
				temporarilyIgnoreGrass(
					distantGrass,
					8,
					18
				)

				runtimeMessage =
					"Rota da grama distante rejeitada: "
					.. tostring(
						moveReason
					)
			end

			return
		end
	end

	if not grass then
		if food < foodCap
			and isSavannahLife then

			runtimeMessage =
				string.format(
					"Nenhuma grama verificada ate 900 studs; buscando rumo ao Pride Rock (Food %d%%)",
					math.floor(food)
				)

			local searched, searchReason, searchGrass =
				state.grassSearchTowardPride(foodCap)

			if searched then
				task.wait(0.10)
				local liveCharacter, liveRoot =
					characterParts()

				if liveCharacter and liveRoot
					and state.grassEatAvailable(liveCharacter) then

					eatingSourcePosition =
						searchGrass or liveRoot.Position
					eatingTargetReachedAt = tick()

					startGrassEatingIfAvailable(
						liveCharacter,
						liveRoot,
						eatingSourcePosition
					)
				end

				return
			end

			if searchReason == "food_area_restricted" then
				if food <= 82
					and state.requestHerbivoreFoodRecovery then

					state.requestHerbivoreFoodRecovery(
						"no_grass_allowed_area"
					)

					runtimeMessage =
						"Sem grama utilizavel; watchdog central assumindo rota ao Pride Rock"
				else
					runtimeMessage =
						"Sem grama na area permitida; prioridade de Zone/Growth mantida"
				end
			elseif searchReason ~= "cooldown"
				and searchReason ~= "already_searching" then

				runtimeMessage =
					"Busca rumo ao Pride Rock interrompida: "
					.. tostring(searchReason)
			end

			return
		end

		runtimeMessage =
			"Nenhuma grama local necessaria agora"

		return
	end

	runtimeMessage =
		string.format(
			"Grama verificada: %.0f studs (%d/9 Terrain Grass)",
			grassDistance or 0,
			grassSamples or 0
		)

	local moved,
		moveReason =
			moveToGrass(
				grass
			)

	if not moved then
		temporarilyIgnoreGrass(
			grass,
			8,
			14
		)

		eatingSourcePosition = nil
		eatingTargetReachedAt = nil

		runtimeMessage =
			"Rota da grama rejeitada: "
			.. tostring(
				moveReason
			)

		return
	end

	task.wait(0.10)

	character, root =
		characterParts()

	if not character or not root then
		return
	end

	if state.grassEatAvailable(
		character
	) then
		eatingSourcePosition =
			root.Position

		eatingTargetReachedAt =
			tick()

		if startGrassEatingIfAvailable(
			character,
			root,
			grass
		) then

			runtimeMessage =
				"Eat confirmado; comecando a comer"

			return
		end
	end

	-- Reaching a Terrain coordinate without Eat is NOT success.
	temporarilyIgnoreGrass(
		grass,
		8,
		14
	)

	eatingSourcePosition = nil
	eatingTargetReachedAt = nil

	runtimeMessage =
		"Terrain Grass confirmado, mas sem prompt Eat; tentando outro ponto"

end


-- ============================================================
-- GIRAFFE EXCLUSIVE FAILED-EAT RECOVERY
--
-- This is intentionally a SINGLE movement owner.
--
-- Trigger:
--   locked/near tree + Giraffe needs Food + Food does not increase.
--
-- Action:
--   1) blacklist current tree;
--   2) cancel every competing Giraffe/Quest/Growth/Food/Water movement;
--   3) block every new SafeMove except purpose="giraffe_recovery";
--   4) move to workspace.Spawns.PrideRockSpawn1;
--   5) only after arrival, release ownership and restart Auto Eat.
-- ============================================================

function state.giraffeExclusiveRecoveryFinish(
	token,
	reached,
	message
)
	local recovery =
		GIRAFFE.exclusiveRecovery

	if not recovery
		or recovery.token ~= token then

		return
	end

	local character =
		recovery.character

	-- Cancel only OUR recovery route.
	if state.safeMove
		and state.safeMove.active
		and state.safeMove.reason == "giraffe_recovery" then

		state.safeMove.cancelToken += 1
		state.safeMove.active = false
		state.safeMove.target = nil
		state.safeMove.reason = nil
		state.safeMove.manualLabel = nil
		state.busy = false
	end

	if character
		and character == player.Character then

		state.releaseMovementNow(
			character,
			true
		)
	end

	recovery.active = false
	recovery.character = nil
	recovery.tree = nil
	recovery.reason = nil
	recovery.startedAt = 0
	recovery.attempt = 0

	GIRAFFE.failedEatPrideBusy = false
	GIRAFFE.failedEatPrideCooldownUntil =
		tick() + (
			reached
				and 1.25
				or 3
		)

	GIRAFFE.noReachableTreeSince = 0
	GIRAFFE.clearTarget()

	eatingToFull = false
	eatingSourcePosition = nil
	eatingTargetReachedAt = nil
	eatingStuckSince = nil
	blockClientSubState = false

	if recovery.ownsCriticalLock then
		criticalRecoveryActive = false
	end

	recovery.ownsCriticalLock = false

	if character
		and character == player.Character
		and state.autoEatManualDisabled ~= true then

		state.autoEat = true
	end

	if character
		and character == player.Character
		and state.autoDrinkManualDisabled ~= true then

		state.autoDrink = true
	end

	runtimeMessage =
		message
			or (
				reached
					and "Giraffe recovery complete at PrideRockSpawn1; restarting tree search"
					or "Giraffe recovery released after failed Pride route; retrying normally"
			)

	if reached
		and character
		and character == player.Character
		and state.autoEat then

		mmbTaskDefer(function()
			task.wait(0.20)

			if player.Character == character
				and state.autoEat
				and not (
					GIRAFFE.exclusiveRecovery
					and GIRAFFE.exclusiveRecovery.active
				)
				and not state.busy
				and not criticalRecoveryActive then

				pcall(
					autoEatStep
				)
			end
		end)
	end
end

function state.giraffeExclusiveRecoveryHardStopOthers(
	character,
	token
)
	local recovery =
		GIRAFFE.exclusiveRecovery

	if not recovery
		or not recovery.active
		or recovery.token ~= token
		or not character
		or character ~= player.Character then

		return false
	end

	-- Tree worker / reposition controller.
	GIRAFFE.cancelToken += 1
	GIRAFFE.busy = false
	GIRAFFE.clearTarget()

	-- Eating / Drinking transaction state.
	eatingToFull = false
	drinkingToFull = false
	eatingSourcePosition = nil
	drinkingSourcePosition = nil
	eatingTargetReachedAt = nil
	eatingStuckSince = nil
	drinkingStuckSince = nil
	blockClientSubState = false

	state.questGiraffeFeeding = false

	-- Pride-home controller.
	state.growthPride.returnRequested = false
	state.growthPride.returning = false

	-- Quest/AutoRun/W controller.
	questTravelWanted = false
	state.questTravelActive = false
	state.questLandInputActive = false
	state.questSwimActive = false
	state.questSwimReady = false
	state.questMotionMoving = false
	state.questMotionMode = nil
	state.autoRunMoveOwnsInput = false

	state.questSetW(false)

	if state.questSetLandPermanentW then
		pcall(
			state.questSetLandPermanentW,
			false
		)
	end

	if state.heavyWalk
		and state.heavyWalk.owner == "autoRun"
		and state.heavyWalkStop then

		pcall(
			state.heavyWalkStop,
			character
		)
	end

	-- Survival owner cannot start Food/Water movement while recovery is active.
	if state.survivalArbiterReset then
		state.survivalArbiterReset(
			"Giraffe exclusive Pride recovery"
		)
	end

	-- Kill any movement that is NOT our recovery route.
	if state.safeMove
		and state.safeMove.active
		and state.safeMove.reason ~= "giraffe_recovery" then

		state.safeMove.cancelToken += 1
		state.safeMove.active = false
		state.safeMove.target = nil
		state.safeMove.reason = nil
		state.safeMove.manualLabel = nil
		state.busy = false

		state.releaseMovementNow(
			character,
			true
		)
	end

	-- Force the game out of stale Eating.
	return true
end

-- v4.2 GIRAFFE/LOCAL QUEST AUTHORITY:
-- PrideRockSpawn1 recovery is a last-resort FOOD executor, never a generic
-- locomotion fallback. A completed refill must not drag a Giraffe out of an
-- active ZoneTime/Local quest (River Bend, etc.).
function state.giraffeFoodRecoveryStillNeeded(character)
	character = character or player.Character

	if not character
		or character ~= player.Character
		or not isGiraffeCharacter(character)
		or not state.autoEat then
		return false
	end

	local food = tonumber(character:GetAttribute("Food")) or 100

	if type(preSwitchFoodTarget) == "number" then
		return food < preSwitchFoodTarget - 0.05
	end

	if state.autoQuests then
		local refill = state.questTravelFullRefill
		local committedQuestFeed =
			state.questGiraffeFeeding == true
			or (
				refill
				and refill.active == true
				and refill.owner == "food"
			)

		if committedQuestFeed then
			return food < 99.5
		end

		-- Without a committed feeding transaction, Quest owns locomotion.
		-- Giraffe may abandon Local/Travel only at the scheduler's real <=70% gate.
		return food <= 70
	end

	return food < 92
end

function state.giraffeStartExclusivePrideRecovery(
	tree,
	reason,
	preserveTree
)
	if not isSavannahLife then
		return false
	end

	local character, root =
		characterParts()

	if not character
		or not root
		or not isGiraffeCharacter(
			character
		) then

		return false
	end

	local giraffeFood =
		tonumber(character:GetAttribute("Food")) or 100

	-- A stale tree/watchdog state may never create a Pride trip once Food is
	-- already satisfied. This was the River Bend -> Pride Rock loop.
	if not state.giraffeFoodRecoveryStillNeeded(character) then
		state.questGiraffeFeeding = false
		eatingToFull = false
		eatingSourcePosition = nil
		eatingTargetReachedAt = nil
		eatingStuckSince = nil
		GIRAFFE.noReachableTreeSince = 0
		GIRAFFE.clearTarget()

		if state.survivalArbiter
			and state.survivalArbiter.owner == "food" then
			state.survivalArbiterComplete("food")
		end

		state.questForceFastRecheckUntil = tick() + 12
		runtimeMessage =
			"Giraffe Food already satisfied; keeping current quest location"
		return false
	end

	local supervisorFoodSeverity =
		giraffeFood <= 25 and 995
		or giraffeFood <= 45 and 955
		or 915

	if not state.aiSupervisorPermitController(
		"Food",
		"GiraffeRecovery",
		reason or "Giraffe failed-Eat recovery",
		supervisorFoodSeverity
	) then
		return false
	end

	local recovery =
		GIRAFFE.exclusiveRecovery

	if recovery.active then
		-- A tree that exposed a real Eat prompt is NOT automatically bad. For a
		-- prompt-handshake recovery, keep it eligible for a later retry.
		if tree
			and tree.Parent
			and not preserveTree then

			state.giraffeRejectInteractionTree(
				tree,
				character,
				reason or "exclusive_recovery",
				900
			)
		end

		return true
	end

	if tree and tree.Parent then
		if preserveTree then
			-- Short cooldown only. This prevents an immediate loop after returning
			-- to Pride without turning a valid-prompt tree into a 15-minute block.
			giraffeIgnoreTree(
				tree,
				18
			)
		else
			state.giraffeRejectInteractionTree(
				tree,
				character,
				reason or "exclusive_recovery",
				900
			)

			GIRAFFE.lastRejectedTree =
				tree
		end
	end

	recovery.token += 1
	local token =
		recovery.token

	recovery.active = true
	recovery.character = character
	recovery.tree = tree
	recovery.reason =
		reason or "failed_eat"
	recovery.startedAt = tick()
	recovery.attempt = 0
	recovery.ownsCriticalLock =
		not criticalRecoveryActive

	GIRAFFE.failedEatPrideBusy = true
	GIRAFFE.failedEatPrideCooldownUntil = 0

	if recovery.ownsCriticalLock then
		criticalRecoveryActive = true
	end

	-- This happens SYNCHRONOUSLY before the worker is spawned. Other loops see the
	-- exclusive flag on their very next line/cycle and cannot acquire movement.
	state.giraffeExclusiveRecoveryHardStopOthers(
		character,
		token
	)

	runtimeMessage =
		preserveTree
			and "Giraffe interaction recovery: Eat prompt was valid; returning to PrideRockSpawn1 without blacklisting tree"
			or "Giraffe watchdog: failed tree blocked; ONLY PrideRockSpawn1 recovery may move"

	task.spawn(function()
		local maxAttempts = 6

		while state.alive
			and recovery.active
			and recovery.token == token
			and recovery.attempt < maxAttempts do

			local liveCharacter,
				liveRoot,
				liveHumanoid =
					characterParts()

			if liveCharacter ~= character
				or not liveRoot
				or not liveHumanoid
				or liveHumanoid.Health <= 0 then

				state.giraffeExclusiveRecoveryFinish(
					token,
					false,
					"Giraffe recovery stopped: character changed"
				)

				return
			end

			if not state.giraffeFoodRecoveryStillNeeded(character) then
				state.giraffeExclusiveRecoveryFinish(
					token,
					false,
					"Giraffe Food satisfied; Pride recovery cancelled and quests resumed"
				)
				state.questForceFastRecheckUntil = tick() + 15
				return
			end

			state.giraffeExclusiveRecoveryHardStopOthers(
				character,
				token
			)

			local pride =
				state.giraffePrideResetSpawn()

			if not pride then
				task.wait(0.35)
				recovery.attempt += 1
				continue
			end

			local flatDistance =
				Vector3.new(
					liveRoot.Position.X - pride.Position.X,
					0,
					liveRoot.Position.Z - pride.Position.Z
				).Magnitude

			if flatDistance <= 14 then
				state.giraffeExclusiveRecoveryFinish(
					token,
					true,
					preserveTree
						and "Giraffe reached PrideRockSpawn1; valid-prompt tree kept eligible for later retry"
						or "Giraffe reached PrideRockSpawn1; failed tree remains blocked"
				)

				return
			end

			recovery.attempt += 1

			runtimeMessage =
				string.format(
					"Giraffe watchdog ONLY: moving to PrideRockSpawn1 (%d/%d, %.0f studs)",
					recovery.attempt,
					maxAttempts,
					flatDistance
				)

			-- state.busy must be free immediately before OUR SafeMove acquires it.
			if state.safeMove
				and state.safeMove.active
				and state.safeMove.reason ~= "giraffe_recovery" then

				state.safeMove.cancelToken += 1
				state.safeMove.active = false
				state.safeMove.target = nil
				state.safeMove.reason = nil
				state.busy = false
			end

			if not (
				state.safeMove
				and state.safeMove.active
				and state.safeMove.reason == "giraffe_recovery"
			) then
				state.busy = false
			end

			safeMoveToPosition(
				pride.Position,
				10,
				pride.Position,
				{
					purpose = "giraffe_recovery",
					forceMoveToLand = true,
					tolerance = 10,
					speedScale = 0.82,
					constantSpeed = false,
					maxDuration = 75,
					ignoreObstacleInstance =
						tree,
					routeCheckInterval = 0.25,
					routeCheck = function()
						if not recovery.active
							or recovery.token ~= token then

							return true,
								"recovery_cancelled"
						end

						local checkCharacter,
							checkRoot =
								characterParts()

						if checkCharacter ~= character
							or not checkRoot then

							return true,
								"character_changed"
						end

						if not state.giraffeFoodRecoveryStillNeeded(checkCharacter) then
							return true, "food_satisfied"
						end

						local d =
							Vector3.new(
								checkRoot.Position.X
									- pride.Position.X,
								0,
								checkRoot.Position.Z
									- pride.Position.Z
							).Magnitude

						if d <= 14 then
							return true,
								"pride_reached"
						end

						return false
					end,
				}
			)

			task.wait(0.15)

			liveCharacter,
				liveRoot =
					characterParts()

			if liveCharacter == character
				and liveRoot then

				local remaining =
					Vector3.new(
						liveRoot.Position.X
							- pride.Position.X,
						0,
						liveRoot.Position.Z
							- pride.Position.Z
					).Magnitude

				if remaining <= 14 then
					state.giraffeExclusiveRecoveryFinish(
						token,
						true,
						preserveTree
							and "Giraffe reached PrideRockSpawn1; valid-prompt tree kept eligible for later retry"
							or "Giraffe reached PrideRockSpawn1; failed tree remains blocked"
					)

					return
				end
			end
		end

		state.giraffeExclusiveRecoveryFinish(
			token,
			false,
			"Giraffe Pride recovery exhausted retries; controls released safely"
		)
	end)

	return true
end

-- Independent empirical watchdog.
-- It does NOT care whether some subsystem claims "Eating", "repositioning" or
-- "finding another tree". If the Giraffe is already near its locked tree and
-- Food has not increased, those controllers have collectively failed.
task.spawn(function()
	while state.alive do
		pcall(function()
			local recovery =
				GIRAFFE.exclusiveRecovery

			if recovery
				and recovery.active then

				local character =
					player.Character

				if character
					and character == recovery.character then

					state.giraffeExclusiveRecoveryHardStopOthers(
						character,
						recovery.token
					)
				end

				return
			end

			if not isSavannahLife
				or not state.autoEat then

				return
			end

			local character, root =
				characterParts()

			if not character
				or not root
				or not isGiraffeCharacter(
					character
				) then

				return
			end

			local tree =
				GIRAFFE.targetTree

			local leaf =
				GIRAFFE.targetLeafPart

			if not tree
				or not tree.Parent
				or not leaf
				or not leaf.Parent then

				GIRAFFE.recoveryMonitor.tree = nil
				GIRAFFE.recoveryMonitor.lastFood = nil
				GIRAFFE.recoveryMonitor.lastProgressAt = 0
				GIRAFFE.recoveryMonitor.nearSince = 0
				return
			end

			-- While Eat is visible, giraffeEatLockedTree is the SINGLE prompt
			-- watchdog. Do not let this background monitor start another recovery
			-- at the same time.
			if state.grassEatAvailable(
				character
			) then

				return
			end

			local food =
				tonumber(
					character:GetAttribute(
						"Food"
					)
				) or 100

			local needsFood =
				state.giraffeFoodRecoveryStillNeeded(character)

			if not needsFood then
				GIRAFFE.recoveryMonitor.tree = nil
				GIRAFFE.recoveryMonitor.lastFood = food
				GIRAFFE.recoveryMonitor.lastProgressAt = tick()
				GIRAFFE.recoveryMonitor.nearSince = 0
				return
			end

			local monitor =
				GIRAFFE.recoveryMonitor

			if monitor.tree ~= tree then
				monitor.tree = tree
				monitor.lastFood = food
				monitor.lastProgressAt = tick()
				monitor.nearSince = 0
				return
			end

			if monitor.lastFood == nil
				or food > monitor.lastFood + 0.01 then

				monitor.lastFood = food
				monitor.lastProgressAt = tick()
				monitor.nearSince = 0
				return
			end

			if state.giraffeAllApproachPointsBlocked(
				tree,
				character
			) then

				state.giraffeRejectInteractionTree(
					tree,
					character,
					"watchdog_all_points_blocked",
					600
				)

				runtimeMessage =
					"Giraffe watchdog: every feeding point is invalid; taking exclusive Pride recovery"

				state.giraffeStartExclusivePrideRecovery(
					tree,
					"all_feeding_points_blocked"
				)

				return
			end

			local flatToLeaf =
				Vector3.new(
					root.Position.X - leaf.Position.X,
					0,
					root.Position.Z - leaf.Position.Z
				).Magnitude

			-- Do not punish a long legitimate trip to a distant tree. The
			-- watchdog arms only once the Giraffe is already inside/near the
			-- interaction area.
			if flatToLeaf > 18 then
				monitor.nearSince = 0
				monitor.lastProgressAt = tick()
				return
			end

			monitor.nearSince =
				monitor.nearSince > 0
					and monitor.nearSince
					or tick()

			local stuckFor =
				tick()
					- math.max(
						monitor.lastProgressAt or 0,
						monitor.nearSince or 0
					)

			if stuckFor >= 6.0 then
				state.giraffeRejectInteractionTree(
					tree,
					character,
					"exclusive_watchdog_no_food_progress",
					900
				)

				runtimeMessage =
					"Giraffe watchdog: no Food progress near locked tree; blocking it and taking exclusive control"

				state.giraffeStartExclusivePrideRecovery(
					tree,
					"no_food_progress_near_locked_tree"
				)

				monitor.tree = nil
				monitor.lastFood = nil
				monitor.lastProgressAt = 0
				monitor.nearSince = 0
			end
		end)

		task.wait(0.25)
	end
end)

local function isPositionInWaterTerrain(position, radiusXZ, radiusY)
	radiusXZ = radiusXZ or 5
	radiusY = radiusY or 7

	local ok, materials, occupancies = pcall(function()
		local half = Vector3.new(radiusXZ, radiusY, radiusXZ)
		local region = Region3.new(position - half, position + half):ExpandToGrid(4)
		return workspace.Terrain:ReadVoxels(region, 4)
	end)
	if not ok or type(materials) ~= "table" then return false end

	-- ReadVoxels returns a 3D matrix. The old check only inspected [1][1][1],
	-- so it could report false even with the animal visibly inside water.
	for x = 1, #materials do
		local ys = materials[x]
		if type(ys) == "table" then
			for y = 1, #ys do
				local zs = ys[y]
				if type(zs) == "table" then
					for z = 1, #zs do
						if zs[z] == Enum.Material.Water then
							local occupancy = occupancies
								and occupancies[x]
								and occupancies[x][y]
								and occupancies[x][y][z]
							if occupancy == nil or occupancy > 0.05 then
								return true
							end
						end
					end
				end
			end
		end
	end

	return false
end

local function isStandingInWater(root)
	if not root then return false end

	local _, _, humanoid = characterParts()
	if humanoid and humanoid:GetState() == Enum.HumanoidStateType.Swimming then
		return true
	end

	if isPositionInWaterTerrain(root.Position, 6, 9) then
		return true
	end

	-- Probe several points around the body instead of one tiny 3-stud ray.
	local offsets = {
		Vector3.new(0, 5, 0),
		Vector3.new(0, 2, 0),
		Vector3.new(3, 3, 0),
		Vector3.new(-3, 3, 0),
		Vector3.new(0, 3, 3),
		Vector3.new(0, 3, -3),
	}
	for _, offset in ipairs(offsets) do
		local hit = workspace:Raycast(
			root.Position + offset,
			Vector3.new(0, -14, 0),
			terrainParams
		)
		if hit and hit.Material == Enum.Material.Water then
			return true
		end
	end

	return false
end

function state.isDirectWaterContact(root)
	if not root then return false end

	-- Use the FIRST Terrain surface directly below the body.
	-- If the animal is already on a dry bank, this hits Sand/Grass/Ground and
	-- does not get confused by nearby water or a stale Swimming humanoid state.
	local hit = workspace:Raycast(
		root.Position + Vector3.new(0, 5, 0),
		Vector3.new(0, -34, 0),
		terrainParams
	)

	return hit ~= nil
		and hit.Material == Enum.Material.Water
end

function state.isBodyActuallyInWater(character, root)
	if not character or not root then return false end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	-- Both the Humanoid state and the game's replicated/local movement attribute
	-- are useful. Either one saying Swimming means we are NOT dry yet.
	if humanoid
		and humanoid:GetState()
			== Enum.HumanoidStateType.Swimming then
		return true
	end

	if character:GetAttribute(
		"MovementState"
	) == "Swimming" then
		return true
	end

	-- Terrain water around the BODY, not merely around HRP.
	if isPositionInWaterTerrain(
		root.Position,
		3.25,
		4.5
	) then
		return true
	end

	if isPositionInWaterTerrain(
		root.Position - Vector3.new(0, 2.25, 0),
		2.75,
		3.5
	) then
		return true
	end

	-- Small animals such as Impala can have HRP already above the visible
	-- surface while chest/legs are still submerged. Sample the real model
	-- bounding box, including the lower body and its horizontal footprint.
	local boxOk, boxCFrame, boxSize =
		pcall(function()
			local cf, size =
				character:GetBoundingBox()

			return cf, size
		end)

	if boxOk
		and typeof(boxCFrame) == "CFrame"
		and typeof(boxSize) == "Vector3" then

		local horizontalProbe =
			math.clamp(
				math.max(
					boxSize.X,
					boxSize.Z
				) * 0.28,
				1.5,
				5.5
			)

		local lowerBody =
			boxCFrame.Position
				- Vector3.new(
					0,
					boxSize.Y * 0.38,
					0
				)

		local bottomBody =
			boxCFrame.Position
				- Vector3.new(
					0,
					math.max(
						0,
						boxSize.Y * 0.5 - 0.75
					),
					0
				)

		if isPositionInWaterTerrain(
			lowerBody,
			horizontalProbe,
			3.0
		)
			or isPositionInWaterTerrain(
				bottomBody,
				horizontalProbe,
				2.25
			) then

			return true
		end
	end

	if state.isDirectWaterContact(root) then
		return true
	end

	-- MainWaterPart is enormous and also exists under dry Terrain. Therefore X/Z
	-- overlap alone is NEVER water proof. First confirm that MainWater is
	-- genuinely EXPOSED at this X/Z, then test body intersection with its volume.
	local waterPart =
		workspace:FindFirstChild(
			"MainWaterPart"
		)

	if waterPart
		and waterPart:IsA(
			"BasePart"
		) then

		local exposedSurface =
			state.drinkMainWaterSurface
			and state.drinkMainWaterSurface(
				waterPart,
				root.Position.X,
				root.Position.Z
			)

		if exposedSurface then
			local localPoint =
				waterPart.CFrame:PointToObjectSpace(
					root.Position
				)

			local half =
				waterPart.Size * 0.5

			local clearance =
				state.movementRootClearance(
					character
				)

			local insideXZ =
				math.abs(localPoint.X)
					<= half.X + 1.5
				and math.abs(localPoint.Z)
					<= half.Z + 1.5

			local bodyIntersectsWater =
				localPoint.Y
					<= half.Y
						+ clearance
						+ 1.0
				and localPoint.Y
					>= -half.Y
						- clearance
						- 2.0

			if insideXZ
				and bodyIntersectsWater then
				return true
			end
		end
	end

	return false
end

function state.supervisorDryCoreSupported(character, root)
	if not character or not root then
		return false
	end

	if root.Position.Y < config.dangerY then
		return false
	end

	if isAquaticCharacter(character) then
		return false
	end

	local hit =
		workspace:Raycast(
			root.Position + Vector3.new(0, 6, 0),
			Vector3.new(0, -30, 0),
			terrainParams
		)

	if not hit or hit.Material == Enum.Material.Water then
		return false
	end

	local gap =
		root.Position.Y - hit.Position.Y

	return gap >= -0.75
		and gap <= 16
end

function state.supervisorDangerousWaterHazard(character, root)
	if not character
		or not root
		or isAquaticCharacter(character) then

		return false
	end

	-- Swim TravelDistance intentionally puts ordinary land animals in deep water.
	-- The Supervisor used to classify that exact mission state as
	-- "unsafe core-body water", elect exclusive Safety and cancel the Quest
	-- SafeMove just as the animal reached the saved swim farm. That left
	-- questSwimReady=false, so the circle controller never started.
	-- Protect ONLY the known Swim quest area; random rivers/puddles elsewhere
	-- remain normal Safety hazards.
	local swimQuestWaterProtected =
		isSavannahLife
		and state.autoQuests == true
		and state.questSwimActive == true
		and typeof(state.questSwimPosition) == "Vector3"

	if swimQuestWaterProtected then
		local center = state.questSwimPosition
		local horizontal = Vector3.new(
			root.Position.X - center.X,
			0,
			root.Position.Z - center.Z
		).Magnitude

		-- 82 studs gives the 30-stud swim orbit enough entry/recovery margin while
		-- staying tightly scoped to the fixed quest farm (normal validation uses 68).
		if horizontal <= 82 then
			return false
		end
	end

	if state.intentionalWaterTransitActive
		and state.intentionalWaterTransitActive(
			character,
			root
		) then

		return false
	end

	if state.drinkTransactionProtected
		and state.drinkTransactionProtected(
			character
		) then

		return false
	end

	-- Tail / rear legs touching the river are NOT enough to put the whole Hub
	-- into Safety. If the core/root is standing on real dry Terrain, normal
	-- Food/Water/Quest/Growth logic must be allowed to continue.
	if state.supervisorDryCoreSupported(
		character,
		root
	) then

		return false
	end

	return state.isBodyActuallyInWater(
		character,
		root
	)
end

function state.dinoRockSafetyHazardLive()
	if not isDinoLife
		or not state.dinoRockEmergency then

		return false
	end

	local emergency =
		state.dinoRockEmergency

	if emergency.supervisorActive
		or emergency.active
		or emergency.moralTrapped == true then

		return true
	end

	local localEvidence =
		(tonumber(emergency.moralNearby) or 0) > 0
		or (tonumber(emergency.moralInside) or 0) > 0
		or (tonumber(emergency.rockPressureNearby) or 0) > 0

	-- objectiveStalled is historical evidence. It is only a Safety hazard while
	-- rocks are STILL physically present around the current character.
	return emergency.objectiveStalled == true
		and localEvidence
end

function state.dinoShorelineSafetyHazardLive(character, root)
	if not isDinoLife
		or not character
		or not root
		or not state.dinoShorelineRecovery then

		return false
	end

	-- Food is allowed to cross exposed water toward a VERIFIED DRY carcass.
	-- This check must precede recovery.deadlocked, otherwise one stale shoreline
	-- sample can keep resurrecting Safety while Food is visibly making progress.
	if state.carcassIntentionalWaterTransitActive
		and state.carcassIntentionalWaterTransitActive(character, root) then
		state.dinoShorelineResetProbe()
		return false
	end

	if state.drinkTransactionProtected
		and state.drinkTransactionProtected(
			character
		) then

		return false
	end

	local recovery =
		state.dinoShorelineRecovery

	if recovery.active then
		return not state.supervisorDryCoreSupported(
			character,
			root
		)
	end

	if recovery.deadlocked ~= true then
		return false
	end

	local waterProof =
		state.dinoShorelineWaterProof
		and state.dinoShorelineWaterProof(
			character,
			root
		)
		or false

	local foodOwns =
		state.dinoShorelineFoodOwnerActive
		and state.dinoShorelineFoodOwnerActive()
		or false

	return waterProof
		and foodOwns
end

function state.nonAquaticDryBankConfirmed(character, root)
	if not character or not root then return false end
	if root.Position.Y < config.dangerY then return false end
	if state.isCrocOrHippoMovementCharacter(character) then return false end

	-- The first Terrain surface directly under HRP is authoritative for ordinary
	-- land animals. A stale Swimming state or a tail/leg touching nearby water
	-- must not trigger an expensive anti-Terrain escape when Sand/Grass is below.
	local hit = workspace:Raycast(
		root.Position + Vector3.new(0, 6, 0),
		Vector3.new(0, -28, 0),
		terrainParams
	)

	if not hit or hit.Material == Enum.Material.Water then
		return false
	end

	-- Do not call the expensive/steep-slope buried detector here. At a shoreline
	-- it can see the bank face above part of a small animal and falsely start an
	-- infinite Terrain escape. The actual support surface directly below HRP is
	-- enough, provided it is not above the root and is reasonably close.
	local supportGap = root.Position.Y - hit.Position.Y
	if supportGap < -0.75 or supportGap > 16 then
		return false
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid:GetState() == Enum.HumanoidStateType.Swimming then
		pcall(humanoid.ChangeState, humanoid, Enum.HumanoidStateType.GettingUp)
	end

	return true
end

function state.dryGroundUnderCharacter(character, root)
	if not character or not root then return false end
	if root.Position.Y < config.dangerY then return false end

	-- v78 CRITICAL:
	-- Never call this "dry ground" while the animal's body is still inside
	-- Terrain water / MainWaterPart, even if solid Terrain also exists below.
	if state.isBodyActuallyInWater(
		character,
		root
	) then
		return false
	end

	if not isDinoLife
		and state.drinkIsBuriedUnderTerrain(root) then
		return false
	end

	if state.isDirectWaterContact(root) then
		return false
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = false

	local hit = workspace:Raycast(
		root.Position + Vector3.new(0, 5, 0),
		Vector3.new(0, -42, 0),
		params
	)

	return hit ~= nil
		and hit.Material ~= Enum.Material.Water
end

function state.normalizeDryLandState(character, root)
	if not state.dryGroundUnderCharacter(character, root) then
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	-- Swimming can remain stale for a moment after reaching the bank.
	-- Dry Terrain beneath the animal wins.
	if humanoid
		and humanoid:GetState()
			== Enum.HumanoidStateType.Swimming then

		pcall(
			humanoid.ChangeState,
			humanoid,
			Enum.HumanoidStateType.GettingUp
		)
	end

	return true
end

function state.waterExitPointIsTrulyDry(position)
	if typeof(position) ~= "Vector3" then
		return false
	end

	-- Reject Terrain Water around the complete landing column.
	if isPositionInWaterTerrain(
		position,
		4.5,
		7.0
	) then
		return false
	end

	local terrainHit =
		workspace:Raycast(
			position
				+ Vector3.new(
					0,
					24,
					0
				),
			Vector3.new(
				0,
				-48,
				0
			),
			terrainParams
		)

	if not terrainHit
		or terrainHit.Material
			== Enum.Material.Water
		or terrainHit.Normal.Y < 0.30 then
		return false
	end

	-- MainWaterPart can sit above a solid river bottom. If its surface is
	-- exposed at this X/Z, that solid Terrain is still UNDER WATER and is not
	-- a valid bank. Covered/buried MainWater returns nil here, so dry land above
	-- the giant part remains valid.
	local waterPart =
		workspace:FindFirstChild(
			"MainWaterPart"
		)

	if waterPart
		and waterPart:IsA(
			"BasePart"
		)
		and state.drinkMainWaterSurface then

		local exposed =
			state.drinkMainWaterSurface(
				waterPart,
				position.X,
				position.Z
			)

		if exposed
			and terrainHit.Position.Y
				<= exposed.Y + 1.5 then
			return false
		end
	end

	return true
end

function state.findNearestDryWaterExit(root)
	if not root then return nil end

	local origin = root.Position
	local best
	local bestScore = math.huge
	local angleOffset =
		(player.UserId % 360) * math.pi / 180

	for _, radius in ipairs({
		10, 16, 24, 34, 46, 62, 82, 110, 145
	}) do
		local samples =
			radius <= 34 and 16 or 20

		for index = 0, samples - 1 do
			local angle =
				angleOffset
				+ index / samples * math.pi * 2

			local x =
				origin.X + math.cos(angle) * radius
			local z =
				origin.Z + math.sin(angle) * radius

			local hit = workspace:Raycast(
				Vector3.new(x, origin.Y + 140, z),
				Vector3.new(0, -320, 0),
				terrainParams
			)

			if hit
				and hit.Material ~= Enum.Material.Water
				and hit.Normal.Y >= 0.40 then

				local candidate =
					hit.Position
					+ Vector3.new(0, 2.5, 0)

				-- Don't select the solid bottom underneath a puddle as an exit.
				local candidateInWater =
					isPositionInWaterTerrain(
						candidate,
						2.75,
						3.5
					)

				if not candidateInWater
					and state.waterExitPointIsTrulyDry(
						candidate
					) then

					local verticalDelta =
						math.abs(
							hit.Position.Y - origin.Y
						)

					local score =
						radius
						+ verticalDelta * 0.65

					if score < bestScore then
						bestScore = score
						best = candidate
					end
				end
			end
		end

		if best and radius >= 46 then
			break
		end
	end

	return best
end

state.aquaticRiverEscape =
	state.aquaticRiverEscape
	or {
		busy = false,
		retryAt = 0,
		selfDamageGuard = false,
		fallDamageConfig = nil,
		fallDamageConfigOld = nil,
		bodyVelocity = nil,
		bodyPosition = nil,
		bodyGyro = nil,
		survivalSuspended = false,
	}

function state.aquaticSurvivalSuspend(
	character
)
	local fly =
		state.aquaticRiverEscape

	if fly.survivalSuspended then
		-- Effective workers remain paused during Fly, but this is never a manual
		-- Survival disable. The central food watchdog reads intent separately.
		state.autoEat = false
		state.autoDrink = false
		return
	end

	fly.survivalSuspended = true

	-- Turn the actual toggles OFF, not merely the worker loops. This prevents
	-- any Eat/Drink movement transaction from fighting BodyVelocity/BodyGyro.
	state.autoEat = false
	state.autoDrink = false

	eatingToFull = false
	drinkingToFull = false
	if not activeCarcassCommitted then
		clearActiveCarcass(false)
	end
	eatingSourcePosition = nil
	eatingTargetReachedAt = nil
	drinkingSourcePosition = nil
	drinkingStuckSince = nil
	lastDrinkWatchdogWater = nil

	state.questCarnivoreFeeding = false
	state.questBaboonFeeding = false
	state.questGiraffeFeeding = false

	pcall(BABOON.cancel)
	pcall(GIRAFFE.cancel)

	if state.safeMove
		and state.safeMove.active
		and (
			state.safeMove.reason == "food"
			or state.safeMove.reason == "water"
		) then

		state.safeMove.cancelToken += 1
	end

	if state.survivalArbiterReset then
		state.survivalArbiterReset(
			"aquatic Fly exclusive movement"
		)
	end

	if state.drinkProgressReset then
		state.drinkProgressReset()
	end

	if renders then
		if renders.autoEat then
			pcall(renders.autoEat)
		end

		if renders.autoDrink then
			pcall(renders.autoDrink)
		end
	end
end

function state.aquaticSurvivalResume(
	character
)
	local fly =
		state.aquaticRiverEscape

	if not fly.survivalSuspended then
		return
	end

	fly.survivalSuspended = false

	-- Restore EFFECTIVE Survival from the existing user/automation intent.
	-- Never rewrite manual-disabled preferences merely because a water Fly ended.
	state.autoEat =
		state.autoEatManualDisabled
			~= true

	state.autoDrink =
		state.autoDrinkManualDisabled
			~= true

	eatingToFull = false
	drinkingToFull = false
	if not activeCarcassCommitted then
		clearActiveCarcass(false)
	end
	eatingSourcePosition = nil
	eatingTargetReachedAt = nil
	drinkingSourcePosition = nil
	drinkingStuckSince = nil

	if state.survivalArbiterReset then
		state.survivalArbiterReset(
			"aquatic Fly completed"
		)
	end

	local water =
		character
		and tonumber(
			character:GetAttribute(
				"Water"
			)
		)
		or 100

	-- If we came out still thirsty, Drink gets the first transaction. Auto Eat
	-- remains ON but cannot start a competing route while drinkingToFull is true.
	if water <= 75 then
		drinkingToFull = true
	end

	if renders then
		if renders.autoEat then
			pcall(renders.autoEat)
		end

		if renders.autoDrink then
			pcall(renders.autoDrink)
		end
	end
end

