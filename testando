function CROC.approachDrink()
	if state.questGrowthReset.exclusive then return false end
	if CROC.approachBusy or criticalRecoveryActive then return false end

	local character, root = characterParts()

	if not character
		or not root
		or not CROC.isCharacter(character) then
		return false
	end

	CROC.approachBusy = true
	removeSwimBarrier()
	drinkingSourcePosition = nil

	-- v77: Croc has no fixed drinking spawn anymore.
	-- Any exposed water found by the normal scanner is valid.
	setAquaticWaterCollision(character, true)

	local spot =
		state.drinkFindAccessibleSpot(
			root.Position,
			character
		)

	if not spot then
		runtimeMessage =
			"Croco: no exposed water found"
		CROC.approachBusy = false
		return false
	end

	state.drinkSearch.currentWaterPoint = spot.water
	state.drinkClearUndergroundMode()

	runtimeMessage =
		"Croco: moving to exposed water edge"

	local moved = safeMoveToPosition(
		spot.stand,
		9,
		spot.water,
		{
			purpose = "water",
			tolerance =
				spot.source
					== "MainWaterPart"
					and 1.15
					or 2.5,
			speedScale = 0.50,
			constantSpeed = true,
			riverApproach =
				spot.source
					== "MainWaterPart",
			riverApproachRadius = 36,
			maxDuration = 300,
		}
	)

	task.wait(0.18)

	character, root = characterParts()

	if character
		and root
		and CROC.isCharacter(character)
		and moved then

		-- v92: NO shoreline refinement movement.
		-- We already completed the one bank SafeMove above. Stay still and
		-- give the game's prompt a brief chance to replicate.
		if detectAvailableFood(character) ~= "Drink" then
			root.AssemblyLinearVelocity =
				Vector3.new(
					0,
					root.AssemblyLinearVelocity.Y,
					0
				)

			root.AssemblyAngularVelocity =
				Vector3.zero

			task.wait(0.30)
		end

		if detectAvailableFood(character) == "Drink" then
			drinkingSourcePosition = root.Position
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero

			runtimeMessage =
				"Croco: drinking from water edge"

			setSubState("Drinking")
			task.spawn(sustainDrinkAtCurrentPrompt)
		else
			state.drinkAbandonCurrent(
				"Croco bank had no Drink prompt; trying another puddle"
			)
		end
	end

	CROC.approachBusy = false
	return moved
end

