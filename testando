			character
		)
	end
end

function state.drinkGamePromptAvailable(character)
	if not character
		or not GameUtils
		or not AnimalConfig
		or not character:FindFirstChild(
			"Head"
		) then

		return false
	end

	local cache = state.drinkVisualPrompt
	local now = tick()
	local root = character:FindFirstChild("HumanoidRootPart")
	local interval = 0.22

	-- Preserve precise shoreline stopping without paying the detector cost for the
	-- whole trip. Only the final Water approach gets a faster probe cadence.
	if root
		and state.safeMove
		and state.safeMove.active
		and (
			state.safeMove.reason == "water"
			or state.safeMove.reason == "water_search"
		)
		and typeof(state.safeMove.target) == "Vector3" then

		local target = state.safeMove.target
		local flatDistance = Vector3.new(
			target.X - root.Position.X,
			0,
			target.Z - root.Position.Z
		).Magnitude

		if flatDistance <= 42 then
			interval = 0.055
		elseif flatDistance <= 110 then
			interval = 0.10
		end
	end

	if cache.gamePromptCharacter == character
		and now - (cache.gamePromptAt or 0) < interval then

		local moved = 0
		if root and typeof(cache.gamePromptPosition) == "Vector3" then
			moved = Vector3.new(
				root.Position.X - cache.gamePromptPosition.X,
				0,
				root.Position.Z - cache.gamePromptPosition.Z
			).Magnitude
		end

		-- A positive prompt is safe to reuse briefly. A negative result is reused
		-- only while the animal has not crossed meaningful interaction distance.
		if cache.gamePromptVisible == true or moved <= 2.5 then
			return cache.gamePromptVisible == true
		end
	end

	local animalType =
		character:GetAttribute(
			"AnimalType"
		)

	local animalName =
		character:GetAttribute(
			"AnimalName"
		)

	local configForAnimal =
		animalType
			and animalName
			and AnimalConfig[animalType]
			and AnimalConfig[animalType][animalName]

	if not configForAnimal then
		cache.gamePromptAt = now
		cache.gamePromptCharacter = character
		cache.gamePromptPosition = root and root.Position or nil
		cache.gamePromptVisible = false
		return false
	end

	local ok, result =
		pcall(
			GameUtils.CanEatDrink.DetectMeatGrassWater,
			character,
			configForAnimal
		)

	local visible = ok and result == "Drink"
	cache.gamePromptAt = now
	cache.gamePromptCharacter = character
	cache.gamePromptPosition = root and root.Position or nil
	cache.gamePromptVisible = visible

	return visible
end

function state.drinkVisualPromptVisible()
	local data = state.drinkVisualPrompt
	local now = tick()

	if now - (data.at or 0) < 0.10 then
		return data.visible == true
	end

	data.at = now
	data.visible = false

	local playerGui =
		player:FindFirstChildOfClass("PlayerGui")

	if not playerGui then
		return false
	end

	local camera = workspace.CurrentCamera
	local viewport =
		camera and camera.ViewportSize
		or Vector2.new(1280, 720)

	for _, object in ipairs(
		playerGui:GetDescendants()
	) do
		if (
			object:IsA("TextLabel")
			or object:IsA("TextButton")
			or object:IsA("TextBox")
		)
			and object.Visible
			and object.TextTransparency < 0.95 then

			local raw =
				tostring(object.Text or "")

			local lower = raw:lower()

			-- v94: Savannah can render the key [E] separately.
			-- In the strict bottom-center interaction region, "para beber" /
			-- "to drink" alone is enough and still cannot match MMB status text.
			local portuguesePrompt =
				lower:find(
					"para beber",
					1,
					true
				)

			local englishPrompt =
				lower:find(
					"to drink",
					1,
					true
				)

			if portuguesePrompt or englishPrompt then
				local centerX =
					object.AbsolutePosition.X
					+ object.AbsoluteSize.X * 0.5

				local centerY =
					object.AbsolutePosition.Y
					+ object.AbsoluteSize.Y * 0.5

				-- Savannah's E interaction prompt is bottom-center.
				-- This deliberately excludes:
				-- - MMB Hub on the left
				-- - status card in the top-right
				-- - quest/menu text
				local inBottom =
					centerY >= viewport.Y * 0.72

				local inCenter =
					centerX >= viewport.X * 0.22
					and centerX <= viewport.X * 0.78

				if inBottom and inCenter then
					data.visible = true
					return true
				end
			end
		end
	end

	return false
end

function state.drinkStopPromptVisible()
	local data = state.drinkVisualPrompt
	local now = tick()

	-- This function walks the entire PlayerGui. Surface/AI code may query it many
	-- times in one scheduler cycle, so one shared result is authoritative briefly.
	if now - (data.stopPromptAt or 0) < 0.22 then
		return data.stopPromptVisible == true
	end

	data.stopPromptAt = now
	data.stopPromptVisible = false

	local playerGui =
		player:FindFirstChildOfClass(
			"PlayerGui"
		)

	if not playerGui then
		return false
	end

	local camera =
		workspace.CurrentCamera

	local viewport =
		camera
			and camera.ViewportSize
			or Vector2.new(
				1280,
				720
			)

	for _, object in ipairs(
		playerGui:GetDescendants()
	) do
		if (
			object:IsA("TextLabel")
			or object:IsA("TextButton")
			or object:IsA("TextBox")
		)
			and object.Visible
			and object.TextTransparency < 0.95 then

			local lower =
				tostring(
					object.Text or ""
				):lower()

			local stopText =
				lower:find(
					"parar de beber",
					1,
					true
				)
				or lower:find(
					"stop drinking",
					1,
					true
				)

			if stopText then
				local centerX =
					object.AbsolutePosition.X
					+ object.AbsoluteSize.X
						* 0.5

				local centerY =
					object.AbsolutePosition.Y
					+ object.AbsoluteSize.Y
						* 0.5

				if centerY
						>= viewport.Y * 0.68
					and centerX
						>= viewport.X * 0.18
					and centerX
						<= viewport.X * 0.82 then

					data.stopPromptVisible = true
					return true
				end
			end
		end
	end

	return false
end

function state.drinkPromptHoldActive()
	return tick()
		< (
			state.drinkVisualPrompt.holdUntil
			or 0
		)
end

function state.drinkLatchVisualPrompt()
	local now = tick()

	state.drinkVisualPrompt.at = now
	state.drinkVisualPrompt.visible = true
	state.drinkVisualPrompt.holdUntil =
		now + 0.90
end


function state.renderMoveToCancelButton()
	local button = state.moveToCancelButton
	if not button or not button.Parent then return end

	local manualActive =
		state.safeMove.active
		and state.safeMove.reason == "manual"

	if manualActive then
		button.Text = state.safeMove.manualLabel
			and (
				"Cancel Move · "
				.. tostring(state.safeMove.manualLabel)
			)
			or "Cancel Current Move"

		-- v81: this function lives in the core chunk, while the HUD palette is
		-- declared later inside a different closure. Use the same RGB values
		-- directly here so BackgroundColor3/TextColor3 can never receive nil.
		button.BackgroundColor3 =
			Color3.fromRGB(255, 46, 122)
		button.TextColor3 =
			Color3.fromRGB(18, 4, 10)
	else
		button.Text = "Cancel Current Move"
		button.BackgroundColor3 =
			Color3.fromRGB(32, 14, 27)
		button.TextColor3 =
			Color3.fromRGB(168, 122, 145)
	end
end

function state.beginManualMoveRequest(target, label)
	local safeMove = state.safeMove
	local goalManager = state.MMBAI and state.MMBAI.GoalManager

	if goalManager and type(goalManager.suspended) == "table" then
		for index = #goalManager.suspended, 1, -1 do
			if goalManager.suspended[index].goal == "Manual Move" then
				table.remove(goalManager.suspended, index)
			end
		end
	end

	safeMove.manualRequestGeneration =
		(tonumber(safeMove.manualRequestGeneration) or 0) + 1

	safeMove.manualRequestPending = true
	safeMove.manualPendingTarget = target
	safeMove.manualPendingLabel = label

	if state.renderMoveToCancelButton then
		pcall(state.renderMoveToCancelButton)
	end

	return safeMove.manualRequestGeneration
end

function state.manualMoveRequestIsCurrent(generation)
	local safeMove = state.safeMove
	return state.alive == true
		and safeMove.manualRequestPending == true
		and safeMove.manualRequestGeneration == generation
end

function state.intentionalWaterTransitActive(
	character,
	root
)
	if not character
		or not root
		or character ~= player.Character then

		return false
	end

	-- Carcass pursuit is a first-class Survival movement transaction in BOTH
	-- Savannah and Dino. When the target carcass is verified dry and the animal
	-- is making real progress toward that SAME target, river water is transit,
	-- not a Safety hazard. The helper is declared later and is intentionally
	-- looked up dynamically here so the core movement layer stays decoupled.
	local carcassTransit =
		state.carcassIntentionalWaterTransitActive
		and state.carcassIntentionalWaterTransitActive(
			character,
			root
		)
		or false

	if carcassTransit then
		return true
	end

	local safeMove =
		state.safeMove

	-- v5.4 CARNIVORE SPAWN-SEARCH RIVER TRANSIT:
	-- MirageSpawn/other carcass Spawn Locations are search waypoints, not hazards.
	-- A carnivore that is actively walking a Food search route may cross an exposed
	-- river to reach the next dry search area. Safety is suppressed ONLY while the
	-- exact SafeMove remains active and keeps making progress; a real 8-second stall
	-- automatically gives control back to the normal dry-bank recovery.
	local carcassSearchWaterTransit =
		(isSavannahLife or isDinoLife)
		and safeMove
		and safeMove.active == true
		and safeMove.reason == "food"
		and safeMove.allowWaterTransit == true
		and safeMove.waterTransitKind == "carcass_search"
		and typeof(safeMove.target) == "Vector3"
		and isCarnivoreCharacter(character)

	if carcassSearchWaterTransit then
		local progressAt =
			tonumber(safeMove.lastProgressAt)
			or tonumber(safeMove.startedAt)
			or 0

		if tick() - progressAt <= 8.0 then
			return true
		end
	end

	-- v4.3 QUEST ZONE RIVER TRANSIT:
	-- A Local/Zone mission can legitimately have its configured farm point on the
	-- opposite bank. If that exact Quest SafeMove opted into water transit, being
	-- inside the river is part of the route and Safety must not drag the animal
	-- back to the previous bank. The exemption exists only while the SAME route is
	-- active and still making progress. Travel-in-Land never opts in, so it keeps
	-- its strict land-only behavior.
	local questWaterTransit =
		(isSavannahLife or isDinoLife)
		and state.autoQuests == true
		and safeMove
		and safeMove.active == true
		and safeMove.reason == "quest"
		and safeMove.allowWaterTransit == true
		and typeof(safeMove.target) == "Vector3"

	if questWaterTransit then
		local progressAt =
			tonumber(safeMove.lastProgressAt)
			or tonumber(safeMove.startedAt)
			or 0

		if tick() - progressAt <= 8.0 then
			return true
		end
	end

	-- Manual Move To is a first-class user route in BOTH Savannah and Dino.
	-- If the selected destination is across a river, water is transit instead of a
	-- Safety hazard while the SAME manual SafeMove is active and making progress.
	-- A queued/suspended request alone is NOT enough to suppress Safety; if the
	-- crossing genuinely stalls for 8s, normal dry-bank recovery is allowed again.
	if not (isSavannahLife or isDinoLife) then
		return false
	end

	local manualActive =
		safeMove
		and safeMove.active
		and safeMove.reason == "manual"
		and safeMove.allowWaterTransit == true
		and typeof(
			safeMove.target
		) == "Vector3"

	if manualActive then
		local progressAt =
			tonumber(safeMove.lastProgressAt)
			or tonumber(safeMove.startedAt)
			or 0

		if tick() - progressAt <= 8.0 then
			return true
		end
	end

	return false
end

function state.finishManualMoveRequest(generation)
	local safeMove = state.safeMove
	if safeMove.manualRequestGeneration ~= generation then return false end

	safeMove.manualRequestPending = false
	safeMove.manualPendingTarget = nil
	safeMove.manualPendingLabel = nil

	if state.renderMoveToCancelButton then
		pcall(state.renderMoveToCancelButton)
	end

	return true
end

function state.cancelManualMove()
	local safeMove =
		state.safeMove

	local manualActive =
		safeMove.active
		and safeMove.reason == "manual"

	local manualPending =
		safeMove.manualRequestPending
			== true

	if not manualActive
		and not manualPending then

		runtimeMessage =
			"No manual Move To route is active"

		state.renderMoveToCancelButton()
		return false
	end

	-- Cancel active, pending and AI-suspended Manual Move generations together.
	safeMove.manualRequestGeneration =
		(
			tonumber(
				safeMove.manualRequestGeneration
			) or 0
		) + 1

	safeMove.manualRequestPending = false
	safeMove.manualPendingTarget = nil
	safeMove.manualPendingLabel = nil

	local goalManager =
		state.MMBAI
		and state.MMBAI.GoalManager

	if goalManager
		and type(
			goalManager.suspended
		) == "table" then

		for index =
			#goalManager.suspended,
			1,
			-1 do

			if goalManager.suspended[index].goal
				== "Manual Move" then

				table.remove(
					goalManager.suspended,
					index
				)
			end
		end
	end

	if not manualActive then
		runtimeMessage =
			"Pending Move To cancelled"

		state.renderMoveToCancelButton()
		return true
	end

	-- safeMoveToPosition checks this token every Heartbeat. Incrementing it
	-- invalidates ONLY the currently running movement controller.
	state.safeMove.cancelToken += 1
	state.safeMove.manualCancelledAt = tick()

	-- An accidental spawn selection should not remain as the preferred
	-- post-drink exit destination after the user explicitly cancels it.
	selectedMoveToSpawn = nil

	local _, root, humanoid = characterParts()

	if humanoid then
		pcall(
			humanoid.Move,
			humanoid,
			Vector3.zero,
			false
		)
	end

	if root then
		local velocity = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(
			0,
			velocity.Y,
			0
		)
		root.AssemblyAngularVelocity =
			root.AssemblyAngularVelocity * 0.20
	end

	if state.questSetW then
		pcall(state.questSetW, false)
	end

	runtimeMessage = "Move To cancelled"

	-- Do not forcibly set state.busy=false here. The movement coroutine owns
	-- cleanup and releases it on the next Heartbeat, avoiding controller races.
	state.renderMoveToCancelButton()
	return true
end

function state.safeMoveRunRouteCheck(
	options,
	character,
	root,
	humanoid,
	position
)
	if type(options) ~= "table"
		or type(options.routeCheck) ~= "function" then
		return false
	end

	local now = tick()
	local interval =
		tonumber(
			options.routeCheckInterval
		) or 0.35

	if now
		- (
			state.safeMove.routeCheckAt
			or 0
		) < interval then
		return false
	end

	state.safeMove.routeCheckAt = now

	local ok, shouldInterrupt, reason =
		pcall(
			options.routeCheck,
			character,
			root,
			humanoid,
			position
		)

	if not ok then
		-- A monitoring callback must never kill the actual movement controller.
		state.safeMove.routeCheckError =
			tostring(shouldInterrupt)
		return false
	end

	if shouldInterrupt == true then
		state.safeMove.routeInterruptReason =
			reason or "route_interrupt"
		return true
	end

	return false
end

-- ============================================================
-- LOW TERRAIN SLOPE ASSIST
-- Kept OUTSIDE safeMoveToPosition so the already-large SafeMove function does
-- not exceed Luau's 200 local-register compilation limit.
-- ============================================================
function state.landSlopeTerrainHeightAt(worldPosition, referenceY)
	if typeof(worldPosition) ~= "Vector3" then return nil end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	params.IgnoreWater = false

	local castTop = math.max(
		(tonumber(referenceY) or worldPosition.Y) + 320,
		worldPosition.Y + 320
	)

	local hit = workspace:Raycast(
		Vector3.new(worldPosition.X, castTop, worldPosition.Z),
		Vector3.new(0, -700, 0),
		params
	)

	if not hit or hit.Material == Enum.Material.Water then
		return nil
	end

	return hit.Position.Y
end

function state.landSlopeForeignFlyActive(root, ownBP, ownBG)
	if not root then return true end

	local trapFly = state.confirmedTrapFly
	if trapFly
		and (
			trapFly.busy
				or trapFly.bodyPosition ~= nil
				or trapFly.bodyGyro ~= nil
		)
		and not (
			ownBP ~= nil
			and ownBG ~= nil
			and trapFly.bodyPosition == ownBP
			and trapFly.bodyGyro == ownBG
		) then
		return true
	end

	local aquatic = state.aquaticRiverEscape
	if aquatic
		and (
			aquatic.busy
				or aquatic.survivalSuspended
				or aquatic.bodyPosition ~= nil
				or aquatic.bodyVelocity ~= nil
				or aquatic.bodyGyro ~= nil
		) then
		return true
	end

	local drinkTest = state.drinkTest
	if drinkTest
		and (
			drinkTest.active
				or drinkTest.hardExitBusy
		) then
		return true
	end

	-- MainWater bridge and external/IY-style flies normally attach movers to HRP.
	-- Scan only Root so this emergency check stays cheap.
	for _, mover in ipairs(root:GetChildren()) do
		if mover ~= ownBP and mover ~= ownBG then
			if mover:IsA("BodyPosition")
				or mover:IsA("BodyVelocity")
				or mover:IsA("BodyGyro")
				or mover:IsA("LinearVelocity")
				or mover:IsA("AlignPosition")
				or mover:IsA("VectorForce") then
				return true
			end
		end
	end

	return false
end

function state.landSlopeLandingColumnClear(character, worldPosition)
	if not character or typeof(worldPosition) ~= "Vector3" then return false end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = true
	pcall(function() params.RespectCanCollide = true end)

	local hit = workspace:Raycast(
		worldPosition + Vector3.new(0, 90, 0),
		Vector3.new(0, -180, 0),
		params
	)

	return hit ~= nil
		and hit.Instance == workspace.Terrain
		and hit.Material ~= Enum.Material.Water
		and hit.Normal.Y > 0.08
end

function state.landSlopeFindClimbTarget(character, root, forward)
	if not character or not root or typeof(forward) ~= "Vector3" then
		return nil
	end

	local flat = Vector3.new(forward.X, 0, forward.Z)
	if flat.Magnitude <= 0.05 then return nil end
	flat = flat.Unit

	local currentGroundY = state.landSlopeTerrainHeightAt(root.Position, root.Position.Y)
	if type(currentGroundY) ~= "number" then return nil end

	local best
	local bestScore = -math.huge
	local previousY = currentGroundY

	for _, distance in ipairs({ 8, 12, 18, 26, 34, 44, 54 }) do
		local point = root.Position + flat * distance
		local y = state.landSlopeTerrainHeightAt(point, root.Position.Y)

		if type(y) == "number" then
			local rise = y - currentGroundY
			local stepRise = y - previousY
			local slope = rise / math.max(distance, 1)
			local steepEnough =
				(rise >= 9 and slope >= 0.34)
				or stepRise >= 8

			if steepEnough then
				local terrainPoint = Vector3.new(point.X, y, point.Z)
				if state.landSlopeLandingColumnClear(character, terrainPoint) then
					local score = rise * 1.8 + distance * 0.30
					if score > bestScore then
						bestScore = score
						best = terrainPoint
					end
				end
			end

			previousY = y
		end
	end

	return best, currentGroundY
end

function state.runLowTerrainSlopeAssist(context)
	if type(context) ~= "table" then return false end

	local character = context.character
	local root = context.root
	local humanoid = context.humanoid
	if not character or not root or not humanoid then return false end

	local assist = state.landSlopeAssist
	if not assist or assist.busy then return false end
	if tick() < (assist.retryAt or 0) then return false end

	local purpose = context.purpose
	if purpose == "water"
		or purpose == "safety"
		or context.calmRiverApproach == true
		or context.verticalMovement == true
		or state.movementPrideRockNearby(root.Position, 90) then
		return false
	end

	if state.questGrowthReset.exclusive
		or criticalRecoveryActive
		or DAMAGE.active
		or state.landSlopeForeignFlyActive(root, nil, nil) then
		return false
	end

	local climbTarget, startGroundY =
		state.landSlopeFindClimbTarget(character, root, context.forward)
	if not climbTarget or type(startGroundY) ~= "number" then
		return false
	end

	-- This assist deliberately uses RAW Acceleration as its hard 3D speed ceiling.
	-- safeMovementSpeed may include a mature-ground boost, which is not allowed here.
	local acceleration =
		tonumber(state.rawMovementAcceleration(character))
			or tonumber(humanoid.WalkSpeed)
			or 1
	local flySpeed = math.max(
		1,
		math.min(tonumber(context.routeMaximumSpeed) or acceleration, acceleration)
	)

	local rootSizeY = root.Size and root.Size.Y or 2
	local nominalClearance = math.max(
		1.0,
		(tonumber(humanoid.HipHeight) or 0) + rootSizeY * 0.5
	)
	local liveClearance = math.max(0.5, root.Position.Y - startGroundY)
	local terrainClearance = math.clamp(
		math.max(nominalClearance, liveClearance),
		nominalClearance,
		nominalClearance + 0.75
	)

	state.heavyWalkStop(character)
	if state.questSetW then pcall(state.questSetW, false) end
	if state.questSetLandPermanentW then
		pcall(state.questSetLandPermanentW, false)
	end

	local oldAutoRotate = humanoid.AutoRotate
	local oldPlatformStand = humanoid.PlatformStand
	local oldMovementDisabled = character:GetAttribute("MovementDisabled")

	local BG = Instance.new("BodyGyro")
	local BP = Instance.new("BodyPosition")
	BG.Name = "MMB_LandSlopeFlyGyro"
	BP.Name = "MMB_LandSlopeFlyPosition"
	BG.P = 65000
	BG.MaxTorque = Vector3.new(9e8, 9e8, 9e8)
	BP.P = 18000
	BP.D = 3000
	BP.MaxForce = Vector3.new(9e8, 9e8, 9e8)
	BG.CFrame = root.CFrame
	BP.Position = root.Position
	BG.Parent = root
	BP.Parent = root

	assist.busy = true
	assist.character = character
	assist.bodyPosition = BP
	assist.bodyGyro = BG
	assist.startedAt = tick()

	pcall(function()
		humanoid.PlatformStand = true
		humanoid.AutoRotate = false
	end)
	character:SetAttribute("MovementDisabled", true)

	local commanded = root.Position
	local lastHeartbeatAt = tick()
	local horizontalDistance = Vector3.new(
		climbTarget.X - root.Position.X,
		0,
		climbTarget.Z - root.Position.Z
	).Magnitude
	local deadline = tick() + math.clamp(
		horizontalDistance / math.max(flySpeed, 1) + 2.0,
		2.0,
		8.0
	)

	local success = false
	local callOk, callError = pcall(function()
		while state.alive
			and character.Parent
			and root.Parent
			and humanoid.Parent
			and humanoid.Health > 0
			and context.token == state.safeMove.cancelToken
			and tick() < deadline do

			if state.safeMoveRunRouteCheck(
				context.options or {},
				character,
				root,
				humanoid,
				context.position
			) then
				break
			end

			if state.questGrowthReset.exclusive
				or criticalRecoveryActive
				or DAMAGE.active
				or state.landSlopeForeignFlyActive(root, BP, BG) then
				break
			end

			local flat = Vector3.new(
				climbTarget.X - commanded.X,
				0,
				climbTarget.Z - commanded.Z
			)

			if flat.Magnitude <= 2.5 then
				local ground = state.landSlopeTerrainHeightAt(root.Position, root.Position.Y)
				if type(ground) == "number"
					and ground >= startGroundY + 6
					and state.landSlopeLandingColumnClear(
						character,
						Vector3.new(root.Position.X, ground, root.Position.Z)
					) then
					success = true
					break
				end
			end

			local now = tick()
			local dt = math.clamp(now - lastHeartbeatAt, 1 / 120, 1 / 20)
			lastHeartbeatAt = now

			local planarStep = math.min(flat.Magnitude, flySpeed * dt)
			local nextXZ = flat.Magnitude > 0.05
				and commanded + flat.Unit * planarStep
				or commanded
			local groundY = state.landSlopeTerrainHeightAt(nextXZ, commanded.Y)
			if type(groundY) ~= "number" then break end

			local desired = Vector3.new(
				nextXZ.X,
				groundY + terrainClearance,
				nextXZ.Z
			)
			local commandDelta = desired - commanded
			if commandDelta.Magnitude > flySpeed * dt then
				desired = commanded + commandDelta.Unit * (flySpeed * dt)
			end

			commanded = desired
			BP.Position = commanded

			local face = Vector3.new(
				climbTarget.X - root.Position.X,
				0,
				climbTarget.Z - root.Position.Z
			)
			if face.Magnitude > 0.15 then
				BG.CFrame = CFrame.lookAt(
					root.Position,
					root.Position + face.Unit,
					Vector3.yAxis
				)
			end

			local velocity = root.AssemblyLinearVelocity
			if velocity.Magnitude > flySpeed then
				root.AssemblyLinearVelocity = velocity.Unit * flySpeed
			end
			root.AssemblyAngularVelocity = Vector3.zero
			setSubState("Running")

			runtimeMessage = string.format(
				"Steep Terrain: low assist climbing at <= Acceleration (%.0f)",
				flySpeed
			)

			RunService.Heartbeat:Wait()
		end
	end)

	local movementTakeover =
		state.landSlopeForeignFlyActive(root, BP, BG)
		or criticalRecoveryActive
		or DAMAGE.active
		or state.questGrowthReset.exclusive

	pcall(function() if BP and BP.Parent then BP:Destroy() end end)
	pcall(function() if BG and BG.Parent then BG:Destroy() end end)

	assist.bodyPosition = nil
	assist.bodyGyro = nil
	assist.character = nil
	assist.busy = false
	assist.retryAt = tick() + (success and 1.5 or 4.0)

	if not movementTakeover and root and root.Parent then
		local velocity = root.AssemblyLinearVelocity
		if velocity.Magnitude > flySpeed then
			root.AssemblyLinearVelocity = velocity.Unit * flySpeed
		end
		root.AssemblyAngularVelocity = Vector3.zero
	end

	if not movementTakeover then
		pcall(function()
			humanoid.PlatformStand = oldPlatformStand == true
			humanoid.AutoRotate = oldAutoRotate ~= false
			if not humanoid.PlatformStand then
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end)

		if oldMovementDisabled == nil then
			character:SetAttribute("MovementDisabled", false)
		else
			character:SetAttribute("MovementDisabled", oldMovementDisabled)
		end
	end

	if success then
		runtimeMessage = "Steep Terrain: low assist OFF; upper Terrain reached"
		return true
	end

	if not callOk then
		runtimeMessage = "Steep Terrain assist error: " .. tostring(callError)
	end

	return false
end

-- ============================================================
-- CONFIRMED TRAP FLY
-- Last-resort extraction for an animal that the normal stuck watchdog has
-- ALREADY proven cannot escape by walking/backing/side detours. Unlike the
-- aquatic exit, this is not tied to water: it also handles dry pits, trenches
-- and steep Terrain bowls (especially Crocodile/Hippo, which cannot jump well).
-- Landing points are REAL dry Terrain only; never rocks/models.
-- ============================================================
state.confirmedTrapFly = state.confirmedTrapFly or {
	busy = false,
	retryAt = 0,
	bodyPosition = nil,
	bodyGyro = nil,

	-- Persistent evidence survives SafeMove/AutoRun route restarts. A shrub or
	-- narrow object can make one recovery attempt look successful even though the
	-- animal never truly leaves the same small area; without persistent evidence
	-- every restarted route used to begin again at "first stuck attempt".
	evidenceCharacter = nil,
	evidenceAnchor = nil,
	evidenceCount = 0,
	evidenceFirstAt = 0,
	evidenceLastAt = 0,
}

function state.confirmedTrapResetEvidence(character)
	local controller = state.confirmedTrapFly
	if not controller then return end
	if character ~= nil
		and controller.evidenceCharacter ~= nil
		and controller.evidenceCharacter ~= character then
		return
	end

	controller.evidenceCharacter = nil
	controller.evidenceAnchor = nil
	controller.evidenceCount = 0
	controller.evidenceFirstAt = 0
	controller.evidenceLastAt = 0
end

function state.confirmedTrapShouldFly(character, root, localFailureCount)
	local controller = state.confirmedTrapFly
	if not controller or not character or not root then return false end

	local now = tick()
	local footprint = math.max(4, state.movementFootprint(character))
	local sameAreaRadius = math.clamp(footprint * 0.85 + 7, 12, 24)
	local anchor = controller.evidenceAnchor
	local sameCharacter = controller.evidenceCharacter == character
	local sameArea = false

	if sameCharacter and typeof(anchor) == "Vector3" then
		local flat = Vector3.new(
			root.Position.X - anchor.X,
			0,
			root.Position.Z - anchor.Z
		)
		sameArea = flat.Magnitude <= sameAreaRadius
	end

	-- Evidence is deliberately short-lived. A later unrelated obstacle must start
	-- from zero; only repeated failures in the SAME small area can unlock Fly.
	if not sameArea
		or now - (controller.evidenceLastAt or 0) > 12 then
		controller.evidenceCharacter = character
		controller.evidenceAnchor = root.Position
		controller.evidenceCount = 1
		controller.evidenceFirstAt = now
		controller.evidenceLastAt = now
	else
		controller.evidenceCount = math.min(
			20,
			(controller.evidenceCount or 0) + 1
		)
		controller.evidenceLastAt = now
	end

	local crocHippo = state.isCrocOrHippoMovementCharacter(character)
	local dinoTrap = isDinoLife == true
	local needed = crocHippo and 2 or (dinoTrap and 2 or 3)
	local minimumAge = crocHippo and 3.4 or (dinoTrap and 3.8 or 5.5)
	local age = now - (controller.evidenceFirstAt or now)

	return (tonumber(localFailureCount) or 0) >= needed
		or (controller.evidenceCount or 0) >= needed
			and age >= minimumAge
end

function state.confirmedTrapFlyPointWet(position)
	if typeof(position) ~= "Vector3" then return true end

	local ok, materials, occupancies = pcall(function()
		local half = Vector3.new(3.25, 4.5, 3.25)
		local region = Region3.new(
			position - half,
			position + half
		):ExpandToGrid(4)
		return workspace.Terrain:ReadVoxels(region, 4)
	end)

	if not ok or type(materials) ~= "table" then
		return false
	end

	for x = 1, #materials do
		local ys = materials[x]
		if type(ys) == "table" then
			for y = 1, #ys do
				local zs = ys[y]
				local occY = type(occupancies) == "table"
					and occupancies[x]
					and occupancies[x][y]
					or nil
				if type(zs) == "table" then
					for z = 1, #zs do
						local occupancy = occY and occY[z] or 1
						if zs[z] == Enum.Material.Water
							and (tonumber(occupancy) or 0) > 0.05 then
							return true
						end
					end
				end
			end
		end
	end

	return false
end

function state.confirmedTrapFlySolidTerrainHit(position, referenceY)
	if typeof(position) ~= "Vector3" then return nil end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	params.IgnoreWater = true

	local castY = math.max(
		(tonumber(referenceY) or position.Y) + 220,
		position.Y + 220
	)

	local hit = workspace:Raycast(
		Vector3.new(position.X, castY, position.Z),
		Vector3.new(0, -520, 0),
		params
	)

	if not hit
		or hit.Material == Enum.Material.Water
		or hit.Normal.Y < 0.28 then
		return nil
	end

	return hit
end

function state.findConfirmedTrapFlyTarget(character, root, preferredTarget)
	if not character or not root then return nil end

	local origin = root.Position
	local originHit = state.confirmedTrapFlySolidTerrainHit(origin, origin.Y)
	local originGroundY = originHit and originHit.Position.Y or (origin.Y - 3)

	local preferredFlat
	if typeof(preferredTarget) == "Vector3" then
		preferredFlat = Vector3.new(
			preferredTarget.X - origin.X,
			0,
			preferredTarget.Z - origin.Z
		)
		if preferredFlat.Magnitude > 0.05 then
			preferredFlat = preferredFlat.Unit
		else
			preferredFlat = nil
		end
	end

	local best
	local bestScore = -math.huge
	local bestRaised
	local bestRaisedScore = -math.huge
	local angleOffset = (player.UserId % 360) * math.pi / 180
	local maxRise =
		state.isCrocOrHippoMovementCharacter(character)
			and 52
			or (isDinoLife and 62 or 38)

	local searchRadii =
		isDinoLife
			and { 14, 22, 32, 44, 58, 76, 98, 124 }
			or { 12, 18, 26, 36, 48, 64, 82 }

	for _, radius in ipairs(searchRadii) do
		local samples = radius <= 26 and 16 or 20
		for index = 0, samples - 1 do
			local angle = angleOffset + index / samples * math.pi * 2
			local probe = origin + Vector3.new(
				math.cos(angle) * radius,
				0,
				math.sin(angle) * radius
			)
			local hit = state.confirmedTrapFlySolidTerrainHit(probe, origin.Y)

			if hit and hit.Normal.Y >= 0.40 then
				local landing = hit.Position
				local rise = landing.Y - originGroundY

				if rise >= -5
					and rise <= maxRise
					and not state.confirmedTrapFlyPointWet(
						landing + Vector3.new(0, 2.5, 0)
					)
					and (
						not isDinoLife
						or not state.movementPrideRockPointForbidden(
							landing,
							character,
							math.clamp(
								state.movementFootprint(character) * 0.30 + 4,
								6,
								14
							)
						)
					)
					and state.landSlopeLandingColumnClear(
						character,
						landing
					) then

					local outward = Vector3.new(
						landing.X - origin.X,
						0,
						landing.Z - origin.Z
					)
					local alignment = preferredFlat
						and outward.Magnitude > 0.05
						and preferredFlat:Dot(outward.Unit)
						or 0
					local score =
						alignment * 12
						+ math.clamp(rise, -5, 24) * 1.15
						+ hit.Normal.Y * 5
						- radius * 0.18

					if score > bestScore then
						bestScore = score
						best = landing
					end

					-- In an actual Terrain bowl/pit, prefer a clearly higher dry shelf
					-- over another point on the same basin floor.
					if rise >= 4 and score > bestRaisedScore then
						bestRaisedScore = score
						bestRaised = landing
					end
				end
			end
		end
	end

	return bestRaised or best
end

function state.runConfirmedTrapFlyEscape(context)
	if type(context) ~= "table" then return false end

	local character = context.character
	local root = context.root
	local humanoid = context.humanoid
	if not character or not root or not humanoid then return false end
	if state.isFlyingMovementCharacter(character) then return false end

	local controller = state.confirmedTrapFly
	if not controller or controller.busy then return false end
	if tick() < (controller.retryAt or 0) then return false end

	local purpose = context.purpose
	if context.verticalMovement == true
		or context.calmRiverApproach == true
		or purpose == "safety"
		or (
			isDinoLife
				and state.dinoRockEmergency
				and (
					state.dinoRockEmergency.supervisorActive
						or state.dinoRockEmergency.objectiveStalled
				)
		)
		or (
			not isDinoLife
			and state.movementPrideRockNearby(root.Position, 90)
		) then
		return false
	end

	if DAMAGE.active
		or (criticalRecoveryActive and purpose ~= "slot_switch")
		or (state.questGrowthReset.exclusive and purpose ~= "slot_switch")
		or state.landSlopeForeignFlyActive(root, nil, nil) then
		return false
	end

	-- If this is the classic Croc/Hippo MainWater trap, prefer the dedicated
	-- aquatic Fly first because it owns MainWaterPart collision correctly.
	if state.isCrocOrHippoMovementCharacter(character)
		and type(state.isUnderMainWaterPart) == "function"
		and type(state.moveAquaticToDryTerrain) == "function" then
		local under = state.isUnderMainWaterPart(root)
		if under then
			runtimeMessage = "Confirmed trap: handing Croc/Hippo to aquatic Fly"
			return state.moveAquaticToDryTerrain(
				character,
				root,
				context.position
			) == true
		end
	end

	local target = state.findConfirmedTrapFlyTarget(
		character,
		root,
		context.position
	)
	if typeof(target) ~= "Vector3" then
		controller.retryAt = tick() + 3.0
		return false
	end

	state.heavyWalkStop(character)
	if state.questSetW then pcall(state.questSetW, false) end
	if state.questSetLandPermanentW then
		pcall(state.questSetLandPermanentW, false)
	end

	pcall(function()
		local old = root:FindFirstChild("MMB_ConfirmedTrapFlyPosition")
		if old then old:Destroy() end
		old = root:FindFirstChild("MMB_ConfirmedTrapFlyGyro")
		if old then old:Destroy() end
	end)

	local oldAutoRotate = humanoid.AutoRotate
	local oldPlatformStand = humanoid.PlatformStand
	local oldMovementDisabled = character:GetAttribute("MovementDisabled")

	local BG = Instance.new("BodyGyro")
	local BP = Instance.new("BodyPosition")
	BG.Name = "MMB_ConfirmedTrapFlyGyro"
	BP.Name = "MMB_ConfirmedTrapFlyPosition"
	BG.P = 75000
	BG.MaxTorque = Vector3.new(9e8, 9e8, 9e8)
	BP.P = 22000
	BP.D = 3000
	BP.MaxForce = Vector3.new(9e8, 9e8, 9e8)
	BG.CFrame = root.CFrame
	BP.Position = root.Position
	BG.Parent = root
	BP.Parent = root

	controller.busy = true
	controller.bodyPosition = BP
	controller.bodyGyro = BG

	pcall(function()
		humanoid.PlatformStand = true
		humanoid.AutoRotate = false
	end)
	character:SetAttribute("MovementDisabled", true)

	local acceleration = tonumber(state.rawMovementAcceleration(character))
		or tonumber(humanoid.WalkSpeed)
		or 28
	local flySpeed
	if isDinoLife then
		local dinoMovementSpeed = tonumber(state.safeMovementSpeed(character)) or acceleration
		flySpeed = math.clamp(
			math.max(acceleration, dinoMovementSpeed * 0.88),
			18,
			54
		)
	else
		flySpeed = math.clamp(
			math.min(
				tonumber(context.routeMaximumSpeed) or acceleration,
				acceleration
			),
			8,
			state.isCrocOrHippoMovementCharacter(character) and 34 or 42
		)
	end
	local rootSizeY = root.Size and root.Size.Y or 2
	local clearance = math.clamp(
		(tonumber(humanoid.HipHeight) or 0) + rootSizeY * 0.5 + 0.65,
		1.4,
		isDinoLife and 7.5 or 4.2
	)
	if isDinoLife then
		clearance = math.max(
			clearance,
			math.clamp(state.movementBodySize(character).Y * 0.22 + 0.8, 2.4, 7.5)
		)
	end
	local commanded = root.Position
	local minimumY = root.Position.Y
	local lastHeartbeatAt = tick()
	local flatDistance = Vector3.new(
		target.X - root.Position.X,
		0,
		target.Z - root.Position.Z
	).Magnitude
	local deadline = tick() + math.clamp(
		flatDistance / math.max(flySpeed, 1) + 3.0,
		3.5,
		11.0
	)
	local success = false

	local callOk, callError = pcall(function()
		while state.alive
			and character.Parent
			and root.Parent
			and humanoid.Parent
			and humanoid.Health > 0
			and context.token == state.safeMove.cancelToken
			and tick() < deadline do

			if state.safeMoveRunRouteCheck(
				context.options or {},
				character,
				root,
				humanoid,
				context.position
			) then
				break
			end

			if DAMAGE.active
				or (criticalRecoveryActive and purpose ~= "slot_switch")
				or (state.questGrowthReset.exclusive and purpose ~= "slot_switch")
				or state.landSlopeForeignFlyActive(root, BP, BG) then
				break
			end

			local remaining = Vector3.new(
				target.X - commanded.X,
				0,
				target.Z - commanded.Z
			)

			if remaining.Magnitude <= 3.5 then
				local liveHit = state.confirmedTrapFlySolidTerrainHit(
					root.Position,
					root.Position.Y
				)
				if liveHit
					and not state.confirmedTrapFlyPointWet(
						liveHit.Position + Vector3.new(0, 2.5, 0)
					) then
					success = true
					break
				end
			end

			local now = tick()
			local dt = math.clamp(now - lastHeartbeatAt, 1 / 120, 1 / 20)
			lastHeartbeatAt = now
			local planarStep = math.min(remaining.Magnitude, flySpeed * dt)
			local nextPosition = remaining.Magnitude > 0.05
				and commanded + remaining.Unit * planarStep
				or commanded
			local terrainHit = state.confirmedTrapFlySolidTerrainHit(
				nextPosition,
				commanded.Y
			)

			if not terrainHit then break end

			local desired = Vector3.new(
				nextPosition.X,
				math.max(terrainHit.Position.Y + clearance, minimumY),
				nextPosition.Z
			)
			local commandDelta = desired - commanded
			local maxStep = flySpeed * dt
			if commandDelta.Magnitude > maxStep then
				desired = commanded + commandDelta.Unit * maxStep
			end

			commanded = desired
			BP.Position = commanded

			local face = Vector3.new(
				target.X - root.Position.X,
				0,
				target.Z - root.Position.Z
			)
			if face.Magnitude > 0.15 then
				BG.CFrame = CFrame.lookAt(
					root.Position,
					root.Position + face.Unit,
					Vector3.yAxis
				)
			end

			root.AssemblyLinearVelocity = root.AssemblyLinearVelocity * 0.22
			root.AssemblyAngularVelocity = Vector3.zero

			runtimeMessage = state.isCrocOrHippoMovementCharacter(character)
				and string.format(
					"Confirmed trap: Croc/Hippo low Fly -> dry Terrain (%.0f)",
					face.Magnitude
				)
				or string.format(
					"Confirmed trap: low Fly -> open Terrain (%.0f)",
					face.Magnitude
				)

			RunService.Heartbeat:Wait()
		end
	end)

	pcall(function() if BP and BP.Parent then BP:Destroy() end end)
	pcall(function() if BG and BG.Parent then BG:Destroy() end end)
	controller.bodyPosition = nil
	controller.bodyGyro = nil
	controller.busy = false
	controller.retryAt = tick() + (success and 1.5 or 4.0)

	if root and root.Parent then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	pcall(function()
		humanoid.PlatformStand = oldPlatformStand == true
		humanoid.AutoRotate = oldAutoRotate ~= false
		if not humanoid.PlatformStand then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)

	if oldMovementDisabled == nil then
		character:SetAttribute("MovementDisabled", false)
	else
		character:SetAttribute("MovementDisabled", oldMovementDisabled)
	end

	if success then
		state.confirmedTrapResetEvidence(character)
		runtimeMessage = "Confirmed trap Fly OFF: open Terrain reached; route resumed"
		return true
	end

	if not callOk then
		runtimeMessage = "Confirmed trap Fly error: " .. tostring(callError)
	end

	return false
end

local function safeMoveToPosition(position, maxAttempts, faceTowards, options)
	if typeof(position) ~= "Vector3" then return false end

	options = type(options) == "table" and options or {}

	local requestedPurpose =
		options.purpose or "movement"

	local supervisorAllowed =
		state.aiSupervisorPermitMovement(
			requestedPurpose,
			position,
			options
		)

	if not supervisorAllowed then
		if requestedPurpose == "slot_switch" then
			state.slotSwitchLastBlockReason =
				"Supervisor denied Reset Point movement"
		end
		return false
	end

	local supervisorSafetyOverride =
		state.aiSupervisorSafetyOverride()

	-- DINO ROCK TRAP EXCLUSIVE RECOVERY:
	if state.dinoRockEmergency
		and state.dinoRockEmergency.supervisorActive
		and state.dinoRockEmergency.supervisorCharacter == player.Character
		and options.purpose ~= "safety" then
		return false
	end

	-- CENTRAL HERBIVORE FOOD RECOVERY INVARIANT:
	-- if a Savannah herbivore has failed to reach/eat grass, only the central
	-- Pride recovery route may own movement until the animal is physically safe.
	if state.herbivoreFoodRecovery
		and state.herbivoreFoodRecovery.active
		and state.herbivoreFoodRecovery.character
			== player.Character
		and options.purpose
			~= "herbivore_food_recovery"
		and not supervisorSafetyOverride then

		return false
	end

	-- GIRAFFE EXCLUSIVE RECOVERY INVARIANT:
	-- once failed-Eat recovery starts, NO other controller may acquire movement.
	-- Not Food, Water, Growth Home, Quest, manual automation or slot staging.
	-- The recovery watchdog is the sole owner until PrideRockSpawn1 is reached.
	if GIRAFFE
		and GIRAFFE.exclusiveRecovery
		and GIRAFFE.exclusiveRecovery.active
		and isGiraffeCharacter(
			player.Character
		)
		and options.purpose ~= "giraffe_recovery"
		and not supervisorSafetyOverride then

		return false
	end

	if state.slotParkingAudit
		and state.slotParkingAudit.active
		and options.purpose ~= "slot_switch"
		and options.purpose ~= "safety" then
		return false
	end

	-- v97 Underground Drink owns movement while the animal can be under Terrain.
	-- Cancel requests a controlled surface exit; it never releases automation
	-- immediately while still buried.
	if state.drinkTest
		and state.drinkTest.active
		and options.purpose ~= "safety" then
		return false
	end

	-- v80: while a Savannah HERBIVORE is in a Growth mode, automatic food
	-- movement is never allowed to leave Pride Rock. Water routes remain exempt.
	if options.purpose == "food"
		and state.growthPrideRestrictionActive(
			player.Character
		)
		and not state.autoFoodPositionAllowed(
			position
		) then

		runtimeMessage =
			"Growth herbivore: outside-Pride food target rejected"

		return false
	end

	if state.questGrowthReset
		and state.questGrowthReset.exclusive
		and options.allowDuringGrowthReset ~= true
		and not supervisorSafetyOverride then
		return false
	end

	if state.busy and not supervisorSafetyOverride then
		-- A dead boolean from the finished Quest/Growth route must not veto the
		-- dedicated Reset Point transaction. If no physical SafeMove exists, clear
		-- only that orphaned flag and let Slots acquire movement normally.
		if requestedPurpose == "slot_switch"
			and state.slotSwitchStagingActive == true
			and not (state.safeMove and state.safeMove.active) then

			state.busy = false
		else
			if requestedPurpose == "slot_switch" then
				state.slotSwitchLastBlockReason =
					"Reset Point movement blocked by an active movement transaction"
			end
			return false
		end
	end

	if state.busy and supervisorSafetyOverride then
		-- A stale subordinate controller cannot veto Supervisor Safety.
		state.busy = false
	end

	local character, root, humanoid = characterParts()
	if not character or not root or not humanoid then return false end

	local aquaticLandPreflight =
		state.isCrocOrHippoMovementCharacter(
			character
		)
		and requestedPurpose ~= "water"
		and requestedPurpose ~= "safety"
		and options.swimming ~= true
		and options.vertical ~= true
		and options.rawVerticalTransit ~= true
		and type(
			state.moveAquaticToDryTerrain
