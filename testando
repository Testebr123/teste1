local function forcePostDrinkTeleport()
	if forcingPostDrinkTeleport then return end
	forcingPostDrinkTeleport = true
	runtimeMessage = "Agua cheia; teleportando para sair da agua"

	if isDinoLife then
		local waterPart = workspace:FindFirstChild("MainWaterPart")
		if waterPart and waterPart:IsA("BasePart") then waterPart.CanCollide = false end

		local _, root = characterParts()

		-- Se por algum motivo realmente caiu no void enquanto bebia, aí SIM
		-- libera a rota AquaticNestRock.
		if root and root.Position.Y < config.dangerY then
			escapeDinoToSafety("void depois de beber")
		else
			-- Saída normal da água: vai DIRETO para terra firme.
			-- AquaticNestRock não participa desta rotina.
			local landed = false
			local nestRock1 = findNestRock1()

			if nestRock1 then
				landed = ensureOnSolidGround(nestRock1.Position, "NestRock1 (saindo da agua)")
			elseif root then
				-- Fallback apenas para spawns NÃO aquáticos.
				for _, spawnPart in ipairs(DAMAGE.getNearestSafeSpawns(root)) do
					if ensureOnSolidGround(spawnPart.Position, spawnPart.Name .. " (saindo da agua)") then
						landed = true
						break
					end
				end
			end

			if not landed then
				runtimeMessage = "Dino: agua cheia, mas nenhum spawn terrestre seguro foi confirmado"
			end
		end
	else
		local waterPart = workspace:FindFirstChild("MainWaterPart")
		if waterPart and waterPart:IsA("BasePart") then waterPart.CanCollide = false end
		local ok = pcall(function()
			refreshCompletionSpawns()
			local candidates = {}
			if selectedCompletionSpawn and selectedCompletionSpawn.Parent then
				table.insert(candidates, selectedCompletionSpawn.Position)
			end
			for _, part in ipairs(completionSpawnParts) do table.insert(candidates, part.Position) end
			table.insert(candidates, config.farm)

			local succeeded = false
			for _, position in ipairs(candidates) do
				if ensureOnSolidGround(position, "ponto de saída da água") then
					succeeded = true
					break
				end
			end
			if not succeeded then
				runtimeMessage = "Nao foi possivel sair da agua; tentando novamente no proximo ciclo"
			end
		end)
		if not ok then runtimeMessage = "Falha ao sair da agua; retomando mesmo assim" end
	end

	resetEatingSearch(nil)
	drinkingSourcePosition = nil
	state.autoEat, state.autoDrink = true, true
	if renders then
		if renders.autoEat then renders.autoEat() end
		if renders.autoDrink then renders.autoDrink() end
	end
	forcingPostDrinkTeleport = false
end

local drinkingStuckSince
-- Segura a posição com alta frequência enquanto bebe no Dino Life. O
-- autoDrinkStep só roda 1x/segundo — frequência baixa demais pra evitar o
-- jitter físico de ficar em pé numa água com CanCollide=true (que estava
-- causando dano de queda). Essa rotina corrige a cada 0.25s até encher.
local dinoDrinkHoldBusy = false
local function holdDinoDrinkPosition(targetPosition)
	if dinoDrinkHoldBusy then return end
	dinoDrinkHoldBusy = true

	local promptMissingSince = nil
	local anchorXZ = nil

	while drinkingToFull and state.autoDrink and not criticalRecoveryActive do
		local character, root, humanoid = characterParts()
		if not character or not root or not humanoid then break end

		local water = character:GetAttribute("Water") or 100
		if water >= (preSwitchWaterTarget or 98) then break end

		local detected = detectAvailableFood(character)

		if detected == "Drink" then
			-- Se o prompt de beber existe, ESTA posição já é válida.
			-- Nunca teleporta/corrige a altura enquanto o prompt estiver disponível.
			promptMissingSince = nil
			if not anchorXZ then
				anchorXZ = Vector3.new(root.Position.X, 0, root.Position.Z)
			end
			drinkingSourcePosition = root.Position
			runtimeMessage = "Dino: prompt detectado; bebendo"

			local velocity = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(0, math.clamp(velocity.Y, -2, 2), 0)
			root.AssemblyAngularVelocity = Vector3.zero

			-- Só segura X/Z se escorregar bastante. O Y atual é SEMPRE preservado,
			-- eliminando o efeito de ficar flickando para cima/baixo.
			if anchorXZ then
				local horizontalOffset = Vector3.new(
					root.Position.X - anchorXZ.X,
					0,
					root.Position.Z - anchorXZ.Z
				)
				if horizontalOffset.Magnitude > 3.5 then
					root.CFrame = CFrame.new(
						anchorXZ.X,
						root.Position.Y,
						anchorXZ.Z
					) * root.CFrame.Rotation
				end
			end

			character:SetAttribute("MovementDisabled", false)
			setSubState("Drinking")
		else
			-- O prompt pode piscar por alguns frames. Não teleporta imediatamente.
			if not promptMissingSince then promptMissingSince = tick() end
			if tick() - promptMissingSince >= 1.5 then
				break
			end

			local velocity = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(0, math.clamp(velocity.Y, -2, 2), 0)
			root.AssemblyAngularVelocity = Vector3.zero
			setSubState("Drinking")
		end

		task.wait(0.15)
	end

	dinoDrinkHoldBusy = false
end

local lastDrinkWatchdogWater

local function virtualDrinkKick()
	local character, root = characterParts()
	if not character or not root then return end

	local detected = detectAvailableFood(character)
	local dinoPromptAlreadyVisible = isDinoLife and detected == "Drink"

	if dinoPromptAlreadyVisible then
		runtimeMessage = "Dino: beber travou, mas prompt esta ativo; reativando sem TP"
		drinkingSourcePosition = root.Position
	else
		runtimeMessage = "Beber travado; forcando com tecla E"

		if isDinoLife then
			local landing = DINO_DRINK_POSITION + Vector3.new(0, surfaceStandOffset(character), 0)
			ragdollTeleport(landing)
			local _, newRoot = characterParts()
			if newRoot then drinkingSourcePosition = newRoot.Position end
			CROC.dinoLastTeleportAt = tick()
		elseif CROC.isCharacter(character) then
			drinkingSourcePosition = nil
			removeSwimBarrier()
			local _, waterPart = CROC.getWaterSurfaceY()
			if waterPart then waterPart.CanCollide = true end
			CROC.approachDrink()
		elseif drinkingSourcePosition then
			ragdollTeleport(drinkingSourcePosition)
		end

		task.wait(0.2)
	end

	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
		task.wait(0.05)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
	end)
	task.wait(0.15)

	-- No Dino, se o prompt já estava visível, não desliga/reLiga Auto Drink.
	-- Esse toggle era outra fonte de interrupção e jitter.
	if not dinoPromptAlreadyVisible then
		state.autoDrink = false
		if renders and renders.autoDrink then renders.autoDrink() end
		task.wait(0.2)
		state.autoDrink = true
		if renders and renders.autoDrink then renders.autoDrink() end
	end

	setSubState("Drinking")
	if isDinoLife then
		task.spawn(holdDinoDrinkPosition, drinkingSourcePosition or root.Position)
	end
	drinkingStuckSince = nil
end

local function autoDrinkStep()
	if not state.autoDrink or state.busy or criticalRecoveryActive then return end
	local character, root = characterParts()
	if not character or not root then return end

	local currentAnimalName = CROC.getAnimalName(character)
	if currentAnimalName ~= CROC.lastDrinkAnimalName then
		drinkingToFull = false
		drinkingSourcePosition = nil
		drinkingStuckSince = nil
		lastDrinkWatchdogWater = nil
		removeSwimBarrier()
		CROC.lastDrinkAnimalName = currentAnimalName
		CROC.dinoLastTeleportAt = nil
	end

	local water = character:GetAttribute("Water") or 100

	-- Swim quest: pode beber, mas nunca pode parar o nado.
	-- Faz pulsos curtos de Drink somente quando o prompt já está disponível,
	-- preserva a velocidade atual e imediatamente volta ao estado Swimming.
	if state.questSwimActive then
		drinkingToFull = false
		drinkingSourcePosition = nil
		drinkingStuckSince = nil
		lastDrinkWatchdogWater = water
		removeSwimBarrier()

		if water <= 75
			and tick() - (state.questSwimLastDrinkAt or 0) >= 0.8
			and detectAvailableFood(character) == "Drink" then

			state.questSwimLastDrinkAt = tick()
			runtimeMessage = string.format("Swim quest: drinking while moving (%d%%)", math.floor(water))

			pcall(function()
				VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
				task.wait(0.04)
				VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
			end)

			setSubState("Drinking")
			task.wait(0.08)
			setSubState("Swimming")
		end
		return
	end

	if water <= 75 then
		drinkingToFull = true
		eatingToFull = false
		eatingSourcePosition = nil
		activeCarcass = nil
		runtimeMessage = "Indo beber agua"
	end
	if drinkingToFull and water >= (preSwitchWaterTarget or 98) then
		drinkingToFull = false
		removeSwimBarrier()
		-- Reverte a água pra não-colidível (só era sólida pra Hippo/Crocodile
		-- beberem sem afundar) — senão fica sólida pra sempre e atrapalha
		-- outros animais nadando/andando por ela depois.
		if isAquaticCharacter(character) then
			local waterPart = workspace:FindFirstChild("MainWaterPart")
			if waterPart and waterPart:IsA("BasePart") then waterPart.CanCollide = false end
		end
		task.spawn(forcePostDrinkTeleport)
		return
	end
	if not drinkingToFull then return end

	if lastDrinkWatchdogWater == nil or water > lastDrinkWatchdogWater then
		lastDrinkWatchdogWater = water
		drinkingStuckSince = tick()
	elseif not drinkingStuckSince then
		drinkingStuckSince = tick()
	end
	if drinkingStuckSince and tick() - drinkingStuckSince >= 8 then
		lastDrinkWatchdogWater = water
		drinkingStuckSince = tick()
		virtualDrinkKick()
		return
	end

	-- Se o prompt já está disponível, não reposiciona nem deixa outra rotina
	-- assumir o personagem: simplesmente mantém a posição e bebe.
	local drinkDetectedNow = detectAvailableFood(character)
	if drinkDetectedNow == "Drink" then
		drinkingSourcePosition = root.Position
		root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
		root.AssemblyAngularVelocity = Vector3.zero
		runtimeMessage = "Prompt de agua detectado; bebendo"
		setSubState("Drinking")
		if isDinoLife then
			task.spawn(holdDinoDrinkPosition, root.Position)
		end
		return
	end

	if isDinoLife then
		local waterPart = workspace:FindFirstChild("MainWaterPart")
		if waterPart and waterPart:IsA("BasePart") then waterPart.CanCollide = true end

		-- REGRA PRINCIPAL: se o prompt já aparece, a posição atual é válida.
		-- Não teleporta de novo e não tenta empurrar o personagem para outra altura.
		local detected = detectAvailableFood(character)
		if detected == "Drink" then
			drinkingSourcePosition = root.Position
			CROC.dinoLastTeleportAt = nil
			runtimeMessage = "Dino: prompt de beber detectado; mantendo posicao"
			setSubState("Drinking")
			task.spawn(holdDinoDrinkPosition, root.Position)
			return
		end

		-- Depois de um TP, dá alguns segundos para o prompt aparecer/estabilizar.
		-- Antes o autoDrinkStep rodava de novo 1s depois e teleportava no MESMO
		-- ponto repetidamente, mesmo quando o animal ainda estava assentando.
		if drinkingSourcePosition and (root.Position - drinkingSourcePosition).Magnitude <= 20 then
			local elapsed = tick() - (CROC.dinoLastTeleportAt or tick())
			if elapsed < 4 then
				runtimeMessage = string.format(
					"Dino: aguardando prompt estabilizar (%.1fs)",
					math.max(0, 4 - elapsed)
				)
				setSubState("Drinking")
				return
			end
		end

		local dinoLandingPosition = DINO_DRINK_POSITION + Vector3.new(0, surfaceStandOffset(character), 0)
		runtimeMessage = "Dino: posicionando na agua"
		ragdollTeleport(dinoLandingPosition)

		-- Usa a posição REAL depois do pouso como referência, não o alvo teórico.
		local _, landedRoot = characterParts()
		drinkingSourcePosition = landedRoot and landedRoot.Position or dinoLandingPosition
		CROC.dinoLastTeleportAt = tick()

		task.wait(0.25)
		for _ = 1, 3 do
			setSubState("Drinking")
			task.wait(0.15)
		end
		return
	end


	if CROC.isCharacter(character) then
		local _, waterPart = CROC.getWaterSurfaceY()
		if waterPart then waterPart.CanCollide = true end

		if drinkingSourcePosition and (root.Position - drinkingSourcePosition).Magnitude <= 14 then
			runtimeMessage = "Croco: na margem; bebendo"
			setSubState("Drinking")
			return
		end

		CROC.approachDrink()
		return
	end

	local isAquatic = isAquaticCharacter(character)

	if drinkingSourcePosition and (root.Position - drinkingSourcePosition).Magnitude <= 16 then
		runtimeMessage = "Bebendo ate encher"
		if isAquatic then
			local waterPart = workspace:FindFirstChild("MainWaterPart")
			-- Só pra Hippo/Crocodile: deixa a água colidível pra eles terem
			-- chão de verdade em vez de afundar. Nunca acontece pros outros
			-- animais, que nem entram nesse "if isAquatic".
			if waterPart and waterPart:IsA("BasePart") then waterPart.CanCollide = true end
		end
		setSubState("Drinking")
		return
	end
	local waterPart = workspace:FindFirstChild("MainWaterPart")
	if isAquatic and waterPart and waterPart:IsA("BasePart") then waterPart.CanCollide = true end

	local waterSurfaceY = waterPart and waterPart:IsA("BasePart")
		and (waterPart.Position.Y + waterPart.Size.Y / 2)
		or nil
	local waterPosition = waterSurfaceY
		and Vector3.new(root.Position.X, waterSurfaceY, root.Position.Z)
		or findMaterial(root.Position, Enum.Material.Water, 384)
	if waterPosition then
		-- Aquáticos usam teleporte normal acima da superfície.
		-- O Croco não passa por esta rotina no Savannah; ele usa a aproximação pela margem.
		if isAquatic then
			ragdollTeleport(waterPosition + Vector3.new(0, surfaceStandOffset(character), 0))
		else
			ragdollTeleport(waterPosition - Vector3.new(0, 3, 0))
		end
		task.wait(0.25)

		local _, newRoot = characterParts()
		if newRoot then
			drinkingSourcePosition = newRoot.Position
			newRoot.AssemblyLinearVelocity = Vector3.zero
			newRoot.AssemblyAngularVelocity = Vector3.zero
			updateSwimBarrier(newRoot, true)
		else
			drinkingSourcePosition = waterPosition
		end

		for _ = 1, 5 do
			setSubState("Drinking")
			task.wait(0.2)
		end
	end
end

local function isInsideTerrain(character, root)
	if not character or not root then return false end
	local region = Region3.new(root.Position - Vector3.new(2,2,2), root.Position + Vector3.new(2,2,2)):ExpandToGrid(4)
	local ok, _, occupancy = pcall(function()
		local materials, values = workspace.Terrain:ReadVoxels(region, 4)
		return materials, values
	end)
	return ok and occupancy and occupancy[1][1][1] > 0.55
end

local function resolveReplication()
	if shared._playerDataReplication and type(shared._playerDataReplication.GetKeyData) == "function" then
		return shared._playerDataReplication
	end
	for _, root in ipairs({ ReplicatedStorage, player:FindFirstChild("PlayerScripts"), player:FindFirstChild("PlayerGui") }) do
		local module = root and root:FindFirstChild("PlayerDataReplication", true)
		if module and module:IsA("ModuleScript") then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" and type(result.GetKeyData) == "function" then
				shared._playerDataReplication = result
				return result
			end
		end
	end
end

local function savedCharacters()
	local replication = resolveReplication()
	if not replication then runtimeMessage = "Dados de slots nao encontrados"; return {} end
	local ok, records = pcall(replication.GetKeyData, "SavedCharacters")
	if (not ok or type(records) ~= "table") and type(replication.GetData) == "function" then
		local dataOk, data = pcall(replication.GetData)
		if dataOk and type(data) == "table" then
			records = data.SavedCharacters
			ok = type(records) == "table"
		end
	end
	if not ok or type(records) ~= "table" then
		runtimeMessage = "Falha ao ler SavedCharacters"
		return {}
	end

	local normalized = {}
	for key, entry in pairs(records) do
		if type(entry) == "table" then
			if not entry.CharacterName and type(key) == "string" then
				entry.CharacterName = key
			end
			table.insert(normalized, entry)
		end
	end
	table.sort(normalized, function(a, b)
		return tostring(a.CharacterName or "") < tostring(b.CharacterName or "")
	end)
	return normalized
end

local function motherNameFor(entry)
	if type(entry) ~= "table" or (entry.GrowthPercentage or 1) > 0.01 then return nil end
	local remote = ReplicatedStorage:FindFirstChild("BabySpawnsRequestMotherNamesRemoteFunction")
	if not remote then return nil end
	local ok, result = pcall(remote.InvokeServer, remote, entry.AnimalName)
	if not ok then return nil end
	if type(result) == "string" then return result end
	if type(result) == "table" then
		for _, value in pairs(result) do
			if type(value) == "string" then return value end
			if type(value) == "table" then return value.PlayerName or value.Name or value.Username end
		end
	end
end

local function spawnSlot(entry)
	local uniqueName = type(entry) == "table" and (entry.UniqueCharacterName or entry.CharacterName)
	if not SpawnRemote or not uniqueName then return false end
	runtimeMessage = "Trocando para " .. tostring(entry.CharacterName)
	local mother = motherNameFor(entry)
	local ok = pcall(function()
		if mother then SpawnRemote:InvokeServer(uniqueName, mother)
		else SpawnRemote:InvokeServer(uniqueName) end
	end)
	if not ok then runtimeMessage = "Spawn falhou: " .. tostring(entry.CharacterName); return false end
	local deadline = tick() + 12
	repeat task.wait(0.25) until tick() >= deadline or (player.Character and player.Character:FindFirstChild("HumanoidRootPart"))
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then runtimeMessage = "Personagem nao apareceu"; return false end
	task.wait(1)
	ragdollTeleport(getSafeFarmPosition())
	runtimeMessage = "Crescendo " .. tostring(entry.CharacterName)
	return true
end

local slotIndex = 0
local sessionCompletedSlots = {}
local function isGrowthComplete(value)
	value = tonumber(value)
	if value == nil then return false end
	if value <= 1 then return value >= 0.999 end
	return value >= 99.9
end

local function nextExistingSlot(animalName, records)
	records = records or savedCharacters()
	if #records == 0 then return nil end
	local currentCharacter = player.Character
	local currentName = currentCharacter and currentCharacter:GetAttribute("CharacterName")
	for _ = 1, #records do
		slotIndex = slotIndex % #records + 1
		local entry = records[slotIndex]
		local name = type(entry) == "table" and entry.CharacterName
		if type(name) == "string" and name ~= ""
			and name ~= currentName and not sessionCompletedSlots[name]
			and (not animalName or entry.AnimalName == animalName)
			and not isGrowthComplete(entry.GrowthPercentage) then
			runtimeMessage = string.format(
				"Testando slot: %s (salvo: %s)",
				name,
				tostring(entry.GrowthPercentage or "?")
			)
			return entry
		end
	end
end


