-- ============================================================
-- Adaptive HUD scale for SMALL screens only
-- Medium/large screens keep the exact existing 1.0 size.
-- ============================================================
local HUD_BASE_SIZE = Vector2.new(380, 500)
local HUD_NORMAL_MIN_WIDTH = 900
local HUD_NORMAL_MIN_HEIGHT = 540
local HUD_MIN_SCALE = 0.62

local hudScale = Instance.new("UIScale")
hudScale.Name = "AdaptiveSmallScreenScale"
hudScale.Scale = 1
hudScale.Parent = window

local function calculateHudScale(viewport)
	if typeof(viewport) ~= "Vector2"
		or viewport.X <= 0
		or viewport.Y <= 0 then
		return 1
	end

	-- Do not touch medium/large displays.
	if viewport.X >= HUD_NORMAL_MIN_WIDTH
		and viewport.Y >= HUD_NORMAL_MIN_HEIGHT then
		return 1
	end

	-- Leave room for Roblox's top controls and a small bottom/right margin.
	-- The base HUD itself remains 380x500; UIScale shrinks it uniformly.
	local availableWidth =
		math.max(
			240,
			viewport.X - 24
		)

	local availableHeight =
		math.max(
			260,
			viewport.Y - 58
		)

	local fit =
		math.min(
			availableWidth / HUD_BASE_SIZE.X,
			availableHeight / HUD_BASE_SIZE.Y,
			1
		)

	-- Keep text/buttons usable even on extremely small screens.
	return math.clamp(
		math.floor(fit * 100 + 0.5) / 100,
		HUD_MIN_SCALE,
		1
	)
end

local function clampWindowToViewport(viewport, scale)
	if typeof(viewport) ~= "Vector2" then
		return
	end

	scale =
		tonumber(scale)
		or 1

	local logicalWidth =
		window.Size.X.Offset

	local logicalHeight =
		window.Size.Y.Offset

	local renderedWidth =
		logicalWidth * scale

	local renderedHeight =
		logicalHeight * scale

	local currentX =
		window.Position.X.Offset

	local currentY =
		window.Position.Y.Offset

	local maxX =
		math.max(
			0,
			viewport.X - renderedWidth
		)

	local maxY =
		math.max(
			0,
			viewport.Y - renderedHeight
		)

	window.Position =
		UDim2.fromOffset(
			math.clamp(
				currentX,
				0,
				maxX
			),
			math.clamp(
				currentY,
				0,
				maxY
			)
		)
end

local function applyAdaptiveHudScale()
	local camera =
		workspace.CurrentCamera

	if not camera then
		hudScale.Scale = 1
		return
	end

	local viewport =
		camera.ViewportSize

	local scale =
		calculateHudScale(
			viewport
		)

	hudScale.Scale =
		scale

	clampWindowToViewport(
		viewport,
		scale
	)
end

