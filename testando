				end
			end
		end

		return false
	end


	-- v130: object raycasts for Auto Run must respect actual physics. Decorative
	-- parts / foliage with CanCollide=false are invisible to this planner.
	local function autoRunObjectRayParams(character)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {
			character,
			workspace.Terrain,
		}
		params.IgnoreWater = true
		pcall(function()
			params.RespectCanCollide = true
		end)
		return params
	end

	local function autoRunCircleAreaScore(
		character,
		root,
		candidateCenter,
		circleRadius
	)
		if not character
			or not root
			or typeof(candidateCenter) ~= "Vector3" then
			return nil
		end

		local centerSurface =
			autoRunTerrainSurfaceAt(
				candidateCenter,
				root.Position.Y
			)

		if not centerSurface
			or centerSurface.Material == Enum.Material.Water then
			return nil
		end

		local centerY = centerSurface.Position.Y
		local sampleCount = 12
		local ringPoints = {}
		local ringGroundY = {}
		local lowestY = centerY
		local highestY = centerY
		local score = 0

		-- First reject water / cliffs. Water inside or close to the circle is a
		-- hard failure; water farther out is only a large preference penalty.
		for index = 0, sampleCount - 1 do
			local theta =
				index / sampleCount
					* math.pi * 2

			local radial =
				Vector3.new(
					math.cos(theta),
					0,
					math.sin(theta)
				)

			local ringPoint =
				candidateCenter
					+ radial * circleRadius

			local surface =
				autoRunTerrainSurfaceAt(
					ringPoint,
					centerY
				)

			if not surface
				or surface.Material == Enum.Material.Water then
				return nil
			end

			local y = surface.Position.Y
			ringPoints[index + 1] =
				Vector3.new(
					ringPoint.X,
					y,
					ringPoint.Z
				)

			ringGroundY[index + 1] = y
			lowestY = math.min(lowestY, y)
			highestY = math.max(highestY, y)

			if math.abs(y - centerY) > 11 then
				return nil
			end

			local nearWater =
				candidateCenter
					+ radial
						* (circleRadius + 42)

			if autoRunWaterAt(
				nearWater,
				centerY
			) then
				return nil
			end

			local farWater =
				candidateCenter
					+ radial
						* (circleRadius + 72)

			if autoRunWaterAt(
				farWater,
				centerY
			) then
				score += 80
			end
		end

		local verticalRange =
			highestY - lowestY

		if verticalRange > 13 then
			return nil
		end

		score += verticalRange * 7

		-- Verify the whole ring corridor, not only the center. Three parallel
		-- lanes give large animals enough clearance from trees/rocks.
		local params =
			autoRunObjectRayParams(
				character
			)

		local bodyHalf =
			math.clamp(
				state.movementFootprint(character)
					* 0.58,
				2.5,
				8.5
			)

		local probeHeight =
			math.clamp(
				state.movementProbeHeight(character),
				2.5,
				8.5
			)

		for index = 1, sampleCount do
			local nextIndex =
				index % sampleCount + 1

			local a = ringPoints[index]
			local b = ringPoints[nextIndex]
			local segment =
				Vector3.new(
					b.X - a.X,
					0,
					b.Z - a.Z
				)

			if segment.Magnitude > 0.05 then
				local tangent =
					segment.Unit

				local side =
					Vector3.new(
						-tangent.Z,
						0,
						tangent.X
					)

				local y =
					math.max(
						ringGroundY[index],
						ringGroundY[nextIndex]
					)

				for _, lateral in ipairs({
					-bodyHalf,
					0,
					bodyHalf,
				}) do
					local origin =
						Vector3.new(
							a.X,
							y + probeHeight,
							a.Z
						)
						+ side * lateral

					local hit =
						workspace:Raycast(
							origin,
							segment,
							params
						)

					if hit
						and hit.Instance
						and hit.Instance:IsA("BasePart")
						and hit.Instance.CanCollide == false then
						hit = nil
					end

					if hit then
						return nil
					end
				end
			end
		end

		-- Prefer the closest valid area only AFTER openness/dryness. Distance is
		-- deliberately a weak cost so a clean field beats a nearby bad circle.
		local travelDistance =
			Vector3.new(
				candidateCenter.X
					- root.Position.X,
				0,
				candidateCenter.Z
					- root.Position.Z
			).Magnitude

		score += travelDistance * 0.16

		return score,
			Vector3.new(
				candidateCenter.X,
				centerY,
				candidateCenter.Z
			)
	end

	local function autoRunFindBestCircleCenter(
		character,
		root,
		circleRadius
	)
		if not character or not root then
			return nil, nil, false
		end

		local bestCenter
		local bestScore = math.huge

		local seedAngle =
			(player.UserId % 360)
				/ 180 * math.pi

		-- Search locally first, then farther away. The last 200-stud ring is only
		-- accepted when it is genuinely cleaner/drier than the nearer candidates.
		for _, searchRadius in ipairs({
			0,
			70,
			130,
			200,
		}) do
			local samples =
				searchRadius == 0
					and 1
					or 8

			for index = 0, samples - 1 do
				local candidate

				if searchRadius == 0 then
					candidate =
						root.Position
				else
					local theta =
						seedAngle
							+ index / samples
								* math.pi * 2

					candidate =
						root.Position
							+ Vector3.new(
								math.cos(theta)
									* searchRadius,
								0,
								math.sin(theta)
									* searchRadius
							)
				end

				local areaScore,
					resolvedCenter =
					autoRunCircleAreaScore(
						character,
						root,
						candidate,
						circleRadius
					)

				if areaScore
					and areaScore < bestScore then
					bestScore = areaScore
					bestCenter = resolvedCenter
				end
			end
		end

		if bestCenter then
			return bestCenter,
				bestScore,
				true
		end

		return root.Position,
			math.huge,
			false
	end

	local function autoRunDryCorridorScore(
		root,
		direction,
		currentGroundY
	)
		local score = 0
		local side =
			Vector3.new(
				-direction.Z,
				0,
				direction.X
			)

		for _, distance in ipairs({
			12,
			24,
			38,
			54,
			70,
		}) do
			for _, lateral in ipairs({
				-8,
				0,
				8,
			}) do
				local point =
					root.Position
					+ direction * distance
					+ side * lateral

				local hit =
					autoRunTerrainSurfaceAt(
						point,
						root.Position.Y
					)

				if not hit then
					score += 30

				elseif hit.Material
					== Enum.Material.Water then

					-- Water is a hard penalty for Land Distance farming.
					score += 500

				else
					local rise =
						hit.Position.Y
							- currentGroundY

					-- Avoid solving "river" by choosing a mountain wall.
					if rise > 18 then
						score +=
							(rise - 18)
								* 2.0
					end

					if rise > 34 then
						score += 90
					end

					if rise < -38 then
						score += 70
					end
				end
			end
		end

		return score
	end

	local function autoRunChooseDryEscape(
		root,
		direction
	)
		local currentGroundY =
			autoTerrainHeightAt(
				root.Position,
				root.Position.Y
			)
			or root.Position.Y

		local bestDirection =
			direction

		local bestScore =
			math.huge

		-- Evaluate the full compass. A river can be beside the circle rather
		-- than directly in front, so left/right alone is not always enough.
		for _, degrees in ipairs({
			0,
			45,
			-45,
			90,
			-90,
			135,
			-135,
			180,
		}) do
			local candidate =
				rotatePlanar(
					direction,
					degrees
				)

			local score =
				autoRunDryCorridorScore(
					root,
					candidate,
					currentGroundY
				)

			-- Small turning cost only breaks ties; staying dry dominates.
			score +=
				math.abs(degrees)
					* 0.08

			if score < bestScore then
				bestScore = score
				bestDirection =
					candidate
			end
		end

		return bestDirection,
			bestScore
	end

	local function startAutoWaterEscape(
		root,
		direction
	)
		local escapeDirection,
			escapeScore =
			autoRunChooseDryEscape(
				root,
				direction
			)

		autoWater.active = true
		autoWater.direction =
			escapeDirection
		autoWater.anchor =
			root.Position
		autoWater.progressAt =
			tick()
		autoWater.bestProjection = 0

		autoAvoidReason = "water_buffer"
		autoAvoidUntil =
			tick() + 4.0

		runtimeMessage =
			string.format(
				"Auto Run: leaving water buffer (dry score %.0f)",
				escapeScore
			)

		return escapeDirection
	end

	local function autoRunWaterEscapeDirection(
		root,
		direction
	)
		if not autoWater.active
			or not autoWater.direction
			or not autoWater.anchor then
			return nil
		end

		local delta =
			Vector3.new(
				root.Position.X
					- autoWater.anchor.X,
				0,
				root.Position.Z
					- autoWater.anchor.Z
			)

		local projection =
			delta:Dot(
				autoWater.direction
			)

		if projection
			> autoWater.bestProjection
				+ 2.0 then

			autoWater.bestProjection =
				projection

			autoWater.progressAt =
				tick()
		end

		-- After enough dry travel, verify that the river/puddle is no longer
		-- within the buffer. Re-center the circle on the new dry area.
		if autoWater.bestProjection >= 44 then
			if not autoRunWaterNearby(root) then
				autoWater.active = false
				autoWater.direction = nil
				autoWater.anchor = nil
				autoWater.bestProjection = 0

				-- The old code blindly centered the next circle exactly where the
				-- water escape ended. Search a genuinely open/dry area instead.
				center = nil
				angle = 0
				autoCircle.waypointIndex = nil
				autoCircle.center = nil
				autoArea.center = nil
				autoArea.score = nil
				autoArea.replanRequested = true
				autoArea.replanAfter = tick()

				if autoAvoidReason
					== "water_buffer" then
					autoAvoidReason = nil
					autoAvoidUntil = 0
				end

				runtimeMessage =
					"Auto Run: dry area confirmed; searching clean circle"

				return direction
			end

			-- Still too close: choose another dry corridor from the new point.
			return startAutoWaterEscape(
				root,
				direction
			)
		end

		-- A dry escape direction that makes no progress gets recomputed, but
		-- never falls into generic left/right + jump behavior toward the river.
		if tick()
			- autoWater.progressAt
			>= 3.0 then

			return startAutoWaterEscape(
				root,
				rotatePlanar(
					direction,
					90
				)
			)
		end

		local blended =
			autoWater.direction * 0.90
				+ direction * 0.10

		return blended.Magnitude > 0.05
			and blended.Unit
			or autoWater.direction
	end

	local function autoRunPeakMetrics(
		root,
		direction,
		currentGroundY
	)
		local peakRise = 0
		local peakSlope = 0

		for _, sampleDistance in ipairs({
			16, 28, 42, 58, 76,
		}) do
			local y =
				autoTerrainHeightAt(
					root.Position
						+ direction * sampleDistance,
					root.Position.Y
				)

			if y then
				local rise =
					y - currentGroundY

				peakRise =
					math.max(
						peakRise,
						rise
					)

				peakSlope =
					math.max(
						peakSlope,
						rise
							/ math.max(
								sampleDistance,
								1
							)
					)
			end
		end

		return peakRise, peakSlope
	end

	local function autoRunHillSideScore(
		character,
		root,
		direction,
		sign,
		currentGroundY
	)
		local heading =
			rotatePlanar(
				direction,
				58 * sign
			)

		local score = 0
		local lastY = currentGroundY

		-- Score the actual escape corridor with several samples.
		for _, distance in ipairs({
			14, 24, 38, 54, 72, 92,
		}) do
			local y =
				autoTerrainHeightAt(
					root.Position
						+ heading * distance,
					root.Position.Y
				)

			if y then
				local rise =
					y - currentGroundY

				local stepRise =
					y - lastY

				if rise > 0 then
					score += rise * 1.15
				end

				if rise > 18 then
					score +=
						(rise - 18) * 3.2
				end

				if rise > 32 then
					score +=
						(rise - 32) * 4.5
				end

				if stepRise > 9 then
					score +=
						stepRise * 3.0
				end

				-- Don't treat a huge drop as the "easy" path.
				if rise < -38 then
					score += 70
				end

				lastY = y
			else
				score += 18
			end
		end

		-- Wider shoulder probes estimate whether this side actually goes around
		-- the mountain instead of merely touching its edge.
		local sideVector =
			Vector3.new(
				-direction.Z,
				0,
				direction.X
			) * sign

		for _, probe in ipairs({
			{ 28, 36 },
			{ 48, 58 },
			{ 64, 78 },
		}) do
			local y =
				autoTerrainHeightAt(
					root.Position
						+ direction * probe[1]
						+ sideVector * probe[2],
					root.Position.Y
				)

			if y then
				local rise =
					y - currentGroundY

				if rise > 15 then
					score +=
						(rise - 15) * 2.4
				end
			else
				score += 12
			end
		end

		local params =
			RaycastParams.new()

		params.FilterType =
			Enum.RaycastFilterType.Exclude

		params.FilterDescendantsInstances = {
			character,
		}

		params.IgnoreWater = true
		pcall(function()
			params.RespectCanCollide = true
		end)

		local obstacle =
			workspace:Raycast(
				root.Position
					+ Vector3.new(
						0,
						state.movementProbeHeight(
							character
						),
						0
					),
				heading * 32,
				params
			)

		if obstacle
			and obstacle.Instance
			and obstacle.Instance:IsA("BasePart")
			and obstacle.Instance.CanCollide == false then
			obstacle = nil
		end

		if obstacle
			and math.abs(
				obstacle.Normal.Y
			) < 0.72 then

			score +=
				obstacle.Instance
					== workspace.Terrain
					and 130
					or 65
		end

		-- A side that already failed near this same mountain gets a huge
		-- temporary penalty, so retries do not fall back into the same loop.
		local failedUntil =
			sign < 0
				and autoHill.failureLeftUntil
				or autoHill.failureRightUntil

		local failedPosition =
			sign < 0
				and autoHill.failureLeftPosition
				or autoHill.failureRightPosition

		if tick() < (failedUntil or 0)
			and typeof(failedPosition)
				== "Vector3"
			and (
				failedPosition
					- root.Position
			).Magnitude <= 95 then

			score += 500
		end

		return score
	end

	local function chooseAutoHillSide(
		character,
		root,
		direction,
		currentGroundY
	)
		local leftScore =
			autoRunHillSideScore(
				character,
				root,
				direction,
				-1,
				currentGroundY
			)

		local rightScore =
			autoRunHillSideScore(
				character,
				root,
				direction,
				1,
				currentGroundY
			)

		autoHill.leftScore = leftScore
		autoHill.rightScore = rightScore

		-- Hysteresis: similar scores keep the existing committed side.
		if autoHill.sign
			and math.abs(
				leftScore - rightScore
			) < 26 then
			return autoHill.sign
		end

		return leftScore < rightScore
			and -1
			or 1
	end

	local function startAutoHillCommit(
		character,
		root,
		direction,
		currentGroundY,
		forcedSign
	)
		local sign =
			forcedSign
				or chooseAutoHillSide(
					character,
					root,
					direction,
					currentGroundY
				)

		autoHill.sign = sign
		autoHill.progressAt = tick()
		autoHill.anchor = root.Position
		autoHill.bestProjection = 0

		local escapeAngle =
			62
			+ math.min(
				18,
				(autoHill.switchCount or 0) * 8
			)

		autoHill.escapeDirection =
			rotatePlanar(
				direction,
				escapeAngle * sign
			)

		autoAvoidSign = sign
		autoAvoidReason = "hill"
		autoAvoidUntil = tick() + 6.0

		runtimeMessage =
			string.format(
				"Auto Run hill: committing %s (L %.0f / R %.0f)",
				sign < 0 and "LEFT" or "RIGHT",
				tonumber(autoHill.leftScore) or -1,
				tonumber(autoHill.rightScore) or -1
			)

		return sign
	end

	local function clearAutoHillCommit()
		autoHill.sign = nil
		autoHill.progressAt = 0
		autoHill.anchor = nil
		autoHill.escapeDirection = nil
		autoHill.bestProjection = 0
		autoHill.switchCount = 0

		if autoAvoidReason == "hill" then
			autoAvoidReason = nil
			autoAvoidUntil = 0
		end
	end

	local function autoRunCommittedHillDirection(
		character,
		root,
		direction
	)
		if not autoHill.sign
			or not autoHill.anchor
			or not autoHill.escapeDirection then
			return nil
		end

		local escapeDelta =
			Vector3.new(
				root.Position.X
					- autoHill.anchor.X,
				0,
				root.Position.Z
					- autoHill.anchor.Z
			)

		local projection =
			escapeDelta:Dot(
				autoHill.escapeDirection
			)

		if projection
			> (
				autoHill.bestProjection or 0
			) + 2.25 then

			autoHill.bestProjection =
				projection

			autoHill.progressAt =
				tick()

			-- Keep commitment alive while lateral escape is genuinely working.
			autoAvoidUntil =
				math.max(
					autoAvoidUntil,
					tick() + 2.6
				)
		end

		-- Enough lateral travel: rejoin the normal circle. If the mountain is
		-- still ahead, the next probe will recommit instead of oscillating.
		if (
			autoHill.bestProjection or 0
		) >= 55 then
			clearAutoHillCommit()
			return direction
		end

		if tick()
			- (
				autoHill.progressAt or 0
			) >= 3.4 then

			local failedSign =
				autoHill.sign

			if failedSign < 0 then
				autoHill.failureLeftUntil =
					tick() + 18

				autoHill.failureLeftPosition =
					root.Position
			else
				autoHill.failureRightUntil =
					tick() + 18

				autoHill.failureRightPosition =
					root.Position
			end

			autoHill.switchCount =
				(autoHill.switchCount or 0) + 1

			if autoHill.switchCount >= 3 then
				-- Auto Run has no fixed endpoint to abort. Re-center the circle
				-- and force a strong lateral departure instead of looping.
				local escapeSign =
					-failedSign

				autoHill.sign = nil
				autoHill.progressAt = 0
				autoHill.anchor = nil
				autoHill.escapeDirection = nil
				autoHill.bestProjection = 0
				autoHill.switchCount = 0

				center = root.Position
				angle += math.pi * 0.75
				autoCircle.waypointIndex = nil
				autoCircle.center = nil

				autoAvoidSign =
					escapeSign

				autoAvoidReason =
					"hill_recenter"

				autoAvoidUntil =
					tick() + 2.6

				autoProgressPosition =
					root.Position

				autoProgressAt = tick()

				runtimeMessage =
					"Auto Run hill trap: both sides failed; re-centering route"

				return rotatePlanar(
					direction,
					88 * escapeSign
				)
			end

			local currentGroundY =
				autoTerrainHeightAt(
					root.Position,
					root.Position.Y
				)
				or root.Position.Y

			-- Failed side is now heavily penalized for 18 seconds.
			autoHill.sign = nil

			local nextSign =
				chooseAutoHillSide(
					character,
					root,
					direction,
					currentGroundY
				)

			startAutoHillCommit(
				character,
				root,
				direction,
				currentGroundY,
				nextSign
			)

			runtimeMessage =
				"Auto Run hill: "
				.. (
					failedSign < 0
						and "LEFT"
						or "RIGHT"
				)
				.. " failed; committing "
				.. (
					nextSign < 0
						and "LEFT"
						or "RIGHT"
				)
		end

		local committed =
			autoHill.escapeDirection

		if not committed then
			return direction
		end

		local blended =
			committed * 0.84
				+ direction * 0.16

		return blended.Magnitude > 0.05
			and blended.Unit
			or committed
	end


	local function chooseAutoAvoidSide(character, root, direction, distance)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character }
		params.IgnoreWater = true
		pcall(function()
			params.RespectCanCollide = true
		end)

		local leftDirection = rotatePlanar(direction, -55)
		local rightDirection = rotatePlanar(direction, 55)

		local probeHeight =
			state.movementProbeHeight(
				character
			)

		local leftHit =
			workspace:Raycast(
				root.Position
					+ Vector3.new(
						0,
						probeHeight,
						0
					),
				leftDirection * distance,
				params
			)

		local rightHit =
			workspace:Raycast(
				root.Position
					+ Vector3.new(
						0,
						probeHeight,
						0
					),
				rightDirection * distance,
				params
			)

		if leftHit
			and leftHit.Instance
			and leftHit.Instance:IsA("BasePart")
			and leftHit.Instance.CanCollide == false then
			leftHit = nil
		end

		if rightHit
			and rightHit.Instance
			and rightHit.Instance:IsA("BasePart")
			and rightHit.Instance.CanCollide == false then
			rightHit = nil
		end

		if leftHit and not rightHit then return 1 end
		if rightHit and not leftHit then return -1 end

		if leftHit and rightHit then
			return leftHit.Distance > rightHit.Distance and -1 or 1
		end

		-- Alternate the fallback side so a persistent obstacle cannot trap us
		-- in one bad direction forever.
		return -autoAvoidSign
	end

	local function autoRunCircleWaypoint(
		root,
		circleCenter,
		circleRadius
	)
		if not root or typeof(circleCenter) ~= "Vector3" then
			return nil, nil, nil
		end

		local count =
			math.max(
				16,
				tonumber(autoCircle.waypointCount)
					or 48
			)

		local centerChanged =
			not autoCircle.center
				or Vector3.new(
					autoCircle.center.X
						- circleCenter.X,
					0,
					autoCircle.center.Z
						- circleCenter.Z
				).Magnitude > 1

		if centerChanged then
			autoCircle.center =
				circleCenter
			autoCircle.waypointIndex =
				nil
		end

		local function pointAt(index)
			local theta =
				(index % count)
					/ count
					* math.pi * 2

			return Vector3.new(
				circleCenter.X
					+ math.cos(theta)
						* circleRadius,
				root.Position.Y,
				circleCenter.Z
					+ math.sin(theta)
						* circleRadius
			)
		end

		local offset =
			Vector3.new(
				root.Position.X
					- circleCenter.X,
				0,
				root.Position.Z
					- circleCenter.Z
			)

		local nearestIndex = 0

		if offset.Magnitude > 0.05 then
			local theta =
				math.atan2(
					offset.Z,
					offset.X
				)

			if theta < 0 then
				theta += math.pi * 2
			end

			nearestIndex =
				math.floor(
					theta
						/ (math.pi * 2)
						* count
						+ 0.5
				) % count
		end

		local sign =
			autoCircle.directionSign >= 0
				and 1
				or -1

		local radialError =
			math.abs(
				offset.Magnitude
					- circleRadius
			)

		local lookAhead =
			radialError > circleRadius * 0.55
				and 1
				or 2

		local function forwardSteps(
			fromIndex,
			toIndex
		)
			if sign > 0 then
				return (
					toIndex - fromIndex
				) % count
			end

			return (
				fromIndex - toIndex
			) % count
		end

		if autoCircle.waypointIndex == nil then
			autoCircle.waypointIndex =
				(
					nearestIndex
						+ sign * lookAhead
				) % count
		else
			local ahead =
				forwardSteps(
					nearestIndex,
					autoCircle.waypointIndex
				)

			-- If the stored checkpoint is now behind the animal, discard it.
			-- This is the old high-speed "go back to the point I missed" bug.
			if ahead == 0
				or ahead > count * 0.45 then
				autoCircle.waypointIndex =
					(
						nearestIndex
							+ sign * lookAhead
					) % count
			end
		end

		local target =
			pointAt(
				autoCircle.waypointIndex
			)

		local delta =
			Vector3.new(
				target.X - root.Position.X,
				0,
				target.Z - root.Position.Z
			)

		-- Advance monotonically. If the following point is already closer, the
		-- current one was passed between frames and must never be chased backward.
		for _ = 1, 4 do
			local nextIndex =
				(
					autoCircle.waypointIndex
						+ sign
				) % count

			local nextTarget =
				pointAt(
					nextIndex
				)

			local nextDelta =
				Vector3.new(
					nextTarget.X
						- root.Position.X,
					0,
					nextTarget.Z
						- root.Position.Z
				)

			local arrived =
				delta.Magnitude
					<= (
						autoCircle.arrivalRadius
							or 3.25
					)

			local passed =
				nextDelta.Magnitude
					+ 0.65
					< delta.Magnitude

			if not arrived
				and not passed then
				break
			end

			autoCircle.waypointIndex =
				nextIndex
			target =
				nextTarget
			delta =
				nextDelta
		end

		if delta.Magnitude <= 0.05 then
			return target,
				nil,
				0
		end

		return target,
			delta.Unit,
			delta.Magnitude
	end

	local function autoRunAvoidDirection(
		character,
		root,
		humanoid,
		direction,
		speed
	)
		if not character or not root or direction.Magnitude <= 0.05 then
			return direction
		end

		-- Water buffer has the highest priority for Land Distance.
		-- Never intentionally farm Run/Travel beside a river/puddle.
		if autoWater.active then
			local waterEscape =
				autoRunWaterEscapeDirection(
					root,
					direction
				)

			if waterEscape then
				return waterEscape
			end
		end

		-- Persistent mountain controller owns the heading until it has
		-- genuinely escaped or a side has really failed.
		if autoAvoidReason == "hill"
			and autoHill.sign then

			local committed =
				autoRunCommittedHillDirection(
					character,
					root,
					direction
				)

			if committed then
				return committed
			end
		end

		-- Object avoidance uses a fixed world-space bypass point.
		if autoAvoidReason == "object" and autoAvoidTarget and tick() < autoAvoidUntil then
			local toBypass=Vector3.new(autoAvoidTarget.X-root.Position.X,0,autoAvoidTarget.Z-root.Position.Z)
			if toBypass.Magnitude>5 then return toBypass.Unit end
			autoAvoidTarget,autoAvoidReason,autoAvoidUntil=nil,nil,0
		end
		if tick() < autoAvoidUntil then
			local degrees=autoAvoidReason=="stuck" and 68 or (autoAvoidReason=="hill_recenter" and 88 or 55)
			return rotatePlanar(direction,degrees*autoAvoidSign)
		end

		if tick() - autoLastProbeAt < 0.16 then
			return direction
		end
		autoLastProbeAt = tick()

		-- 0) Run quests stay away from exposed Terrain Water. We check both
		-- the intended heading and a buffer around the animal, so running
		-- parallel to a river also triggers an escape.
		if autoRunWaterAhead(
			root,
			direction
		)
			or autoRunWaterNearby(root) then

			return startAutoWaterEscape(
				root,
				direction
			)
		end

		-- 1) Detect a genuinely high/steep Terrain peak ahead.
		local currentGroundY =
			autoTerrainHeightAt(
				root.Position,
				root.Position.Y
			)
			or root.Position.Y

		local peakRise, peakSlope =
			autoRunPeakMetrics(
				root,
				direction,
				currentGroundY
			)

		if (
			peakRise >= 28
				and peakSlope >= 0.48
		)
			or peakRise >= 42 then

			startAutoHillCommit(
				character,
				root,
				direction,
				currentGroundY
			)

			return autoRunCommittedHillDirection(
				character,
				root,
				direction
			)
				or direction
		end

		-- 2) Trees, rocks, models, etc. blocking the circle.
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { character }
		params.IgnoreWater = true
		pcall(function()
			params.RespectCanCollide = true
		end)

		local heavyMover =
			state.isHeavyGroundMover(
				character
			)

		local probeDistance =
			heavyMover
				and math.clamp(
					(speed or 30) * 0.42
						+ state.movementFootprint(
							character
						) * 0.85,
					16,
					46
				)
				or math.clamp(
					(speed or 30) * 0.24,
					8,
					20
				)

		local obstacle =
			state.heavyObstacleProbe(
				character,
				root,
				direction,
				probeDistance
			)

		if obstacle
			and (
				heavyMover
					or math.abs(
						obstacle.Normal.Y
					) < 0.72
			) then

			if obstacle.Instance ~= autoBlockingInstance then
				autoBlockingInstance = obstacle.Instance
				autoBlockingSince = tick()
			elseif autoBlockingSince <= 0 then
				autoBlockingSince = tick()
			end

			-- Ordinary Terrain slopes are climbed normally. Mountain-like
			-- Terrain was already handled by the height probes above.
			if obstacle.Instance == workspace.Terrain then
				-- Auto Run never uses Space to solve Terrain. Repeated jump retries
				-- were able to turn a normal TravelDistance quest into an infinite
				-- jump loop. Terrain is handled by the circle/height route instead.
				return direction
			end

			if state.safeMove.heavyObstacleSign then
				autoAvoidSign =
					state.safeMove.heavyObstacleSign
			else
				autoAvoidSign =
					chooseAutoAvoidSide(
						character,
						root,
						direction,
						math.max(
							14,
							probeDistance
						)
					)
			end

			autoAvoidReason =
				"object"

			-- A real collidable object on the selected orbit means this was not a
			-- clean farming area after all. Finish the immediate bypass, then choose
			-- a different open circle instead of fighting the same object every lap.
			if autoArea.center
				and tick() - (autoArea.lastPlanAt or 0) >= 2.0 then
				local radialDistance =
					Vector3.new(
						root.Position.X
							- autoArea.center.X,
						0,
						root.Position.Z
							- autoArea.center.Z
					).Magnitude

				if math.abs(radialDistance - radius) <= 18 then
					autoArea.replanRequested = true
					autoArea.replanAfter =
						tick() + 0.9
				end
			end

			local sideVector =
				Vector3.new(
					-direction.Z,
					0,
					direction.X
				) * autoAvoidSign

			local objectDistance =
				tonumber(
					obstacle.Distance
				) or (
					probeDistance * 0.5
				)

			local bodyClearance =
				heavyMover
					and math.clamp(
						state.movementFootprint(
							character
						) * 1.35,
						12,
						26
					)
					or 10

			local forwardClearance =
				math.clamp(
					objectDistance
						+ bodyClearance * 0.70,
					10,
					probeDistance + 18
				)

			autoAvoidTarget =
				root.Position
					+ direction * forwardClearance
					+ sideVector * bodyClearance

			autoAvoidUntil =
				tick()
					+ (
						heavyMover
							and 3.0
							or 1.8
					)

			local bypassDirection =
				Vector3.new(
					autoAvoidTarget.X
						- root.Position.X,
					0,
					autoAvoidTarget.Z
						- root.Position.Z
				).Unit

			-- Lateral bypass is the only obstacle response used by Auto Run.
			-- Do not press Space here: a persistent tree/rock must trigger a new
			-- route/area, not an endless jump cycle.

			if autoAvoidTarget then
				local toBypass=Vector3.new(autoAvoidTarget.X-root.Position.X,0,autoAvoidTarget.Z-root.Position.Z)
				if toBypass.Magnitude>0.05 then return toBypass.Unit end
			end
			return bypassDirection
		end

		autoAvoidReason = nil
		autoBlockingInstance = nil
		autoBlockingSince = 0
		return direction
	end

	while state.alive do
		local character, root = characterParts()
		local food = character and (character:GetAttribute("Food") or 100) or 100
		local water = character and (character:GetAttribute("Water") or 100) or 100

		local swimMove = state.autoQuests
			and state.questSwimActive
			and state.questSwimReady

		local landMove = state.autoQuests
			and questTravelWanted
			and not state.questSwimActive

		local travelGrassHerbivore =
			landMove
				and character
				and not isCarnivoreCharacter(character)
				and not isBaboonCharacter(character)
				and not isGiraffeCharacter(character)

		local buriedNow = character
			and root
			and not isDinoLife
			and state.drinkIsBuriedUnderTerrain(root)

		local commonSafe = not questSwitchingAnimal
			and not state.busy
			and not (
				state.safeMove
					and state.safeMove.active
			)
			and not criticalRecoveryActive
			and not DAMAGE.active
			and not carcassEatBusy
			and not CROC.approachBusy
			and not forcingPostDrinkMove
			and not state.questGrowthReset.exclusive
			and not state.questCarnivoreFeeding
			and not state.questBaboonFeeding
			and not state.questGiraffeFeeding
			and not BABOON.busy
			and not GIRAFFE.busy
			and not buriedNow
			and character and root

		local moveInteract =
			state.questMoveInteract

		local grassMoveGrace =
			moveInteract
				and tick()
					< (
						moveInteract.grassGraceUntil
							or 0
					)

		local drinkMoveGrace =
			moveInteract
				and tick()
					< (
						moveInteract.drinkGraceUntil
							or 0
					)

		local canMove = commonSafe and (
			(
				swimMove
				and not drinkingToFull
				and not eatingToFull
			)
			or (
				landMove
				and not drinkingToFull
				and not eatingToFull
				and (
					travelGrassHerbivore
						and (
							food > 60
								or grassMoveGrace
						)
					or (
						not travelGrassHerbivore
							and food > 68
					)
				)
				and (
					water > 75
						or (
							drinkMoveGrace
								and water > 45
						)
						or (
							tick() < (state.drinkSearch.retryAfter or 0)
								and water > 45
						)
				)
			)
		)


		if canMove and swimMove then
			-- Cheap watchdog: the known swim circle is entirely inside water.
			-- Only leaving the area triggers re-verification/movement; no heavy
			-- ReadVoxels call every second while we're already swimming correctly.
			local swimCenter = state.questSwimPosition
			local dx = root.Position.X - swimCenter.X
			local dz = root.Position.Z - swimCenter.Z
			if math.sqrt(dx * dx + dz * dz) > 68 then
				state.questSwimReady = false
				canMove = false
				questStatusText =
					"Swim: left saved farm area; repositioning"
			end
		end

		if canMove then
			state.questMotionMoving = true
			state.questMotionMode = swimMove and "Swimming" or "Land"

			state.autoRunMoveOwnsInput =
				landMove
					and not swimMove

			if swimMove then
				state.questSetW(true)

			elseif landMove then
				-- Steering stays 100% MoveTo/world-space. W is held only as the
				-- game's movement-state signal required by TravelDistance quests.
				state.questSetW(true)
			else
				state.questSetW(false)
			end

			if landMove
				and not swimMove
				and state.questMovementOpportunisticInteract then

				pcall(
					state.questMovementOpportunisticInteract,
					character,
					root
				)
			end

			local needsCirclePlan =
				trackedCharacter ~= character
					or not center
					or wasSwimming ~= swimMove

			if not swimMove
				and autoArea.replanRequested
				and tick() >= (autoArea.replanAfter or 0)
				and not (
					autoAvoidReason == "object"
						and tick() < autoAvoidUntil
				) then
				needsCirclePlan = true
			end

			if needsCirclePlan then
				trackedCharacter = character
				wasSwimming = swimMove

				if swimMove then
					center =
						state.questSwimPosition
					autoArea.center = nil
					autoArea.score = nil
					autoArea.replanRequested = false
				else
					local plannedCenter,
						plannedScore,
						foundCleanArea =
							autoRunFindBestCircleCenter(
								character,
								root,
								radius
							)

					center =
						plannedCenter
							or root.Position

					autoArea.center = center
					autoArea.score = plannedScore
					autoArea.lastPlanAt = tick()
					autoArea.replanRequested = false
					autoArea.replanAfter = 0

					if foundCleanArea then
						runtimeMessage =
							string.format(
								"Auto Run: clean dry circle selected (score %.0f)",
								plannedScore or 0
							)
					else
						runtimeMessage =
							"Auto Run: no fully clean circle found; using safest local fallback"
					end
				end

				angle = 0
				autoCircle.waypointIndex = nil
				autoCircle.center = nil

				autoHill.sign = nil
				autoHill.progressAt = 0
				autoHill.anchor = nil
				autoHill.escapeDirection = nil
				autoHill.bestProjection = 0
				autoHill.switchCount = 0

				autoWater.active = false
				autoWater.direction = nil
				autoWater.anchor = nil
				autoWater.progressAt = 0
				autoWater.bestProjection = 0
				autoAvoidTarget = nil
				autoAvoidReason = nil
				autoAvoidUntil = 0
				autoBlockingInstance = nil
				autoBlockingSince = 0
			end

			if tick() - (state.questLastSubStateAt or 0) >= (swimMove and 1.25 or 0.75) then
				state.questLastSubStateAt = tick()
				blockClientSubState = false
				setSubState(swimMove and "Swimming" or (state.questMoveSubState or "Running"))
				blockClientSubState = false
			end

			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local loopDt = state.questSwimActive and 0.03 or 0.05

			if swimMove then
				-- SAME engine as Land Auto Run.
				-- The only swim-specific pieces are:
				--   1) center is the verified underwater farm point;
				--   2) radius is kept inside the known water area;
				--   3) vertical correction keeps the animal submerged;
				--   4) substate stays Swimming.
				local speed = getQuestMoveSpeed(character)
				local moveRadius = 30
				angle += (speed / moveRadius) * 0.05

				local target = Vector3.new(
					center.X + math.cos(angle) * moveRadius,
					center.Y,
					center.Z + math.sin(angle) * moveRadius
				)

				local flat = Vector3.new(
					target.X - root.Position.X,
					0,
					target.Z - root.Position.Z
				)

				if flat.Magnitude > 0.1 then
					local direction = flat.Unit
					local velocity = root.AssemblyLinearVelocity

					pcall(function()
						root.CFrame = CFrame.lookAt(
							root.Position,
							root.Position + direction,
							Vector3.yAxis
						)
					end)

					if humanoid then
						pcall(humanoid.Move, humanoid, Vector3.new(0, 0, -1), true)
					end

					-- Same horizontal velocity as Land Auto Run.
					-- Only add a small Y correction so it cannot float out of or sink
					-- beneath the swimming layer.
					local yError =
						center.Y - root.Position.Y

					-- Respect the same movement ceiling vertically as well.
					local verticalCap =
						math.min(8, speed)

					local yVelocity =
						math.clamp(
							yError * 2.2,
							-verticalCap,
							verticalCap
						)

					root.AssemblyLinearVelocity = Vector3.new(
						direction.X * speed,
						yVelocity,
						direction.Z * speed
					)

					wasMoving = true
				end
			else
				local speed =
					getQuestMoveSpeed(
						character
					)

				local moveRadius =
					radius

				-- Fixed WORLD-SPACE circle points.
				local circleTarget,
					direction,
					circleTargetDistance =
						autoRunCircleWaypoint(
							root,
							center,
							moveRadius
						)

				if tick()
					- (
						state.autoRunCircleStatusAt
							or 0
					) >= 1.0 then

					state.autoRunCircleStatusAt =
						tick()

					runtimeMessage =
						string.format(
							"Auto Run circle · point %s/%d · %.0f studs",
							tostring(
								autoCircle.waypointIndex
									or "?"
							),
							autoCircle.waypointCount
								or 48,
							circleTargetDistance
								or 0
						)
				end

				if direction
					and direction.Magnitude > 0.1 then

					local velocity =
						root.AssemblyLinearVelocity

					-- Independent stuck verification: if the animal has barely moved
					-- for ~1 second even after avoidance, use virtual Space and force a
					-- stronger temporary side route.
					if not autoProgressPosition then
						autoProgressPosition =
							root.Position

						autoProgressAt =
							tick()
					else
						local progress =
							Vector3.new(
								root.Position.X
									- autoProgressPosition.X,
								0,
								root.Position.Z
									- autoProgressPosition.Z
							).Magnitude

						if progress >= 3 then
							autoProgressPosition =
								root.Position

							autoProgressAt =
								tick()

						elseif tick()
							- autoProgressAt
							>= 1.0 then

							autoProgressPosition =
								root.Position

							autoProgressAt =
								tick()

							if autoWater.active then
								-- Water buffer controller owns re-routing.
								-- Never generic-jump/flip while escaping a river.

							elseif autoAvoidReason == "hill"
								and autoHill.sign then

								-- Hill controller owns side changes/jump policy.
								-- Its 3.4s projection timeout decides a real fail.
							else
								autoAvoidSign *= -1
								autoAvoidReason =
									"stuck"

								autoAvoidUntil =
									tick() + 1.45

								-- A stuck circle is a routing failure, not a jumping problem.
								-- Flip the bypass side and ask the open-area planner for a
								-- fresh circle if the obstruction persists.
								if autoArea then
									autoArea.replanRequested = true
									autoArea.replanAfter = tick() + 0.35
								end
							end
						end
					end

					-- Keep the circle target, but temporarily bend the actual heading
					-- around trees/rocks/high peaks. Once clear, it naturally rejoins
					-- the circle instead of staying stuck against the obstacle.
					direction = autoRunAvoidDirection(
						character,
						root,
						humanoid,
						direction,
						speed
					)

					local exactRunTarget

					if autoAvoidReason == "object"
						and autoAvoidTarget
						and tick() < autoAvoidUntil then

						exactRunTarget =
							autoAvoidTarget

					elseif not autoWater.active
						and autoAvoidReason ~= "hill"
						and autoAvoidReason ~= "stuck"
						and autoAvoidReason ~= "hill_recenter"
						and tick() >= autoAvoidUntil then

						exactRunTarget =
							circleTarget
					end

					local runTargetDistance =
						exactRunTarget
							and Vector3.new(
								exactRunTarget.X
									- root.Position.X,
								0,
								exactRunTarget.Z
									- root.Position.Z
							).Magnitude
							or circleTargetDistance

					if humanoid then
						state.heavyWalkStep(
							character,
							root,
							humanoid,
							direction,
							speed,
							runTargetDistance,
							exactRunTarget,
							"autoRun",
							trackedCharacter
						)
					end
					wasMoving = true
				end
			end
		else
			state.autoRunMoveOwnsInput = false

			-- Stop only pure AutoRun ownership. A SafeMove route may be active.
			if state.heavyWalk
				and state.heavyWalk.owner
					== "autoRun" then

				state.heavyWalkStop(
					player.Character
				)
			end

			autoProgressPosition = nil
			autoProgressAt = 0
			autoBlockingInstance = nil
			autoBlockingSince = 0
			state.safeMove.heavyObstacleSign = nil

			autoHill.sign = nil
			autoHill.progressAt = 0
			autoHill.anchor = nil
			autoHill.escapeDirection = nil
			autoHill.bestProjection = 0
			autoHill.switchCount = 0

			autoWater.active = false
			autoWater.direction = nil
			autoWater.anchor = nil
			autoWater.progressAt = 0
			autoWater.bestProjection = 0
			autoAvoidTarget = nil

			if autoAvoidReason == "hill"
				or autoAvoidReason
					== "water_buffer" then
				autoAvoidReason = nil
				autoAvoidUntil = 0
			end

			-- Do not touch a physical SafeMove from the pure AutoRun loop.
			local physicalMoveOwnsMovement =
				state.safeMove
					and state.safeMove.active

			local moveOwnsLandQuestW =
				physicalMoveOwnsMovement
					and state.safeMove.landQuestW

			if not physicalMoveOwnsMovement then
				state.questMotionMoving = false
				state.questMotionMode = nil
				state.questSetW(false)

				if state.questLandKeyDown then
					state.releaseMovementNow(
						player.Character,
						true
					)
				end

				if root then
					local stopCharacter =
						player.Character

					local stopHumanoid =
						stopCharacter
						and stopCharacter:FindFirstChildOfClass(
							"Humanoid"
						)

					if stopHumanoid then
						pcall(
							stopHumanoid.Move,
							stopHumanoid,
							Vector3.zero,
							false
						)
					end
				end
			elseif moveOwnsLandQuestW then
				-- SafeMove owns W; leave it untouched.
			end
			wasMoving = false
			wasSwimming = false
			center = nil
			autoArea.center = nil
			autoArea.score = nil
			autoArea.replanRequested = false
			autoArea.replanAfter = 0
			state.questMotionCal.key = nil
			state.questMotionCal.targetSpeed = 0
			state.questMotionCal.actualSpeed = 0
			blockClientSubState = false
		end

		task.wait(state.questSwimActive and 0.03 or 0.05)
	end
end)

