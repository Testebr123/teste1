		reason = reason,
	}
	return true
end

function ai:ConsumeWorkerRequest(name)
	local request = self.WorkerRequests[name]
	if not request or tick() < (request.runAfter or 0) then
		return false, nil
	end
	self.WorkerRequests[name] = nil
	return true, request
end

ai.QuestTracker = {
	quests = {},
	active = {},
	lastUpdateAt = 0,
	aggregate = nil,
	lastAggregateProgressAt = tick(),
}

function ai.QuestTracker:Classify(quest)
	local props = quest and quest.props or {}
	local title = tostring(props.Title or quest and quest.id or "Quest")
	local lower = title:lower()
	if isSwimQuest(props) then return "Swim", true, ai.Capabilities.Current.swimQuest == true end
	if isLandDistanceQuest(props) then return "Run", true, ai.Capabilities.Current.runQuest == true end
	if findZoneInQuest(quest) then return "Zone", true, ai.Capabilities.Current.zoneQuest == true end
	if lower:find("group", 1, true) or lower:find("pack", 1, true) then
		return "Group", false, ai.Capabilities.Current.groups == true
	end
	if lower:find("grow", 1, true) then return "Growth", false, ai.Capabilities.Current.growth == true end
	if lower:find("survive", 1, true) or lower:find("play", 1, true) then
		return "Passive", false, true
	end
	return tostring(props.QuestType or "Generic"), false, ai.Capabilities.Current.quests == true
end

function ai.QuestTracker:Update()
	if not state.autoQuests or not ai.Capabilities.Current.quests then
		self.active = {}
		self.aggregate = nil
		return self.active
	end

	local ok, quests = pcall(getAllQuests)
	if not ok or type(quests) ~= "table" then
		return self.active
	end

	local now = tick()
	local seen = {}
	local active = {}
	local aggregate = 0
	local aggregateKnown = false
	for _, quest in ipairs(quests) do
		local id = tostring(quest.id or quest.entry and quest.entry.QuestUniqueKey or quest)
		seen[id] = true
		local record = self.quests[id]
		if not record then
			local questType, needsMovement, supported = self:Classify(quest)
			local dependencies = { "Survival" }
			if needsMovement then table.insert(dependencies, "Movement") end
			if questType == "Group" then table.insert(dependencies, "AutoGroup") end
			if questType == "Growth" then
				table.insert(dependencies, "GrowSlots")
				table.insert(dependencies, "Slots")
			end
			record = {
				id = id,
				title = tostring(quest.props and quest.props.Title or id),
				type = questType,
				initial = nil,
				current = nil,
				maximum = nil,
				lastProgressAt = now,
				animal = quest.entry and quest.entry.AnimalName
					or quest.props and quest.props.AnimalName,
				zone = findZoneInQuest(quest),
				movementRequired = needsMovement,
				dependencies = dependencies,
				attempts = 0,
				recoveryLevel = 0,
				lastRecoveryAt = 0,
				failureReason = nil,
				supported = supported ~= false,
			}
			self.quests[id] = record
		end

		local progressOk, current, maximum = pcall(state.questProgressValues, quest)
		if progressOk then
			if type(current) == "number" then
				if record.initial == nil then record.initial = current end
				if record.current == nil or current > record.current + 0.001 then
					record.lastProgressAt = now
					self.lastAggregateProgressAt = now
					ai.Blackboard.lastProgressAt = now
					record.recoveryLevel = 0
					record.failureReason = nil
					record.attempts = 0
				end
				record.current = current
				record.maximum = maximum
				aggregate += current
				aggregateKnown = true
			end
		end

		record.zone = record.zone or findZoneInQuest(quest)
		record.lastSeenAt = now
		table.insert(active, record)
	end

	for id, record in pairs(self.quests) do
		if not seen[id] and now - (record.lastSeenAt or 0) > 12 then
			self.quests[id] = nil
		end
	end

	table.sort(active, function(a, b) return a.title < b.title end)
	self.active = active
	self.aggregate = aggregateKnown and aggregate or nil
	self.lastUpdateAt = now
	ai.Blackboard.activeQuests = active
	return active
end

function ai.QuestTracker:TimeoutFor(quest, context)
	context = context or ai.Blackboard
	local base = quest.type == "Run" and 32
		or quest.type == "Swim" and 38
		or quest.type == "Zone" and 55
		or quest.type == "Group" and 105
		or quest.type == "Growth" and 135
		or quest.type == "Passive" and 180
		or 100
	local footprint = context.character
		and math.clamp(state.movementFootprint(context.character), 2, 32)
		or 8
	local speed = math.max(1, tonumber(context.speedLimit) or 12)
	local target = quest.zone and QUEST_ZONES[quest.zone] or state.questZoneFarmTarget
	local distance = 0
	if typeof(target) == "Vector3" and typeof(context.position) == "Vector3" then
		distance = Vector3.new(
			target.X - context.position.X,
			0,
			target.Z - context.position.Z
		).Magnitude
	end
	local travelAllowance = quest.movementRequired
		and distance / speed * (1.8 + footprint / 32)
		or 0
	if quest.type == "Growth" and (tonumber(context.growthRate) or 0) > 0 then
		base += 45
	end
	return math.clamp(base + travelAllowance, 20, 360)
end

function ai.QuestTracker:WaitingReason(quest, context)
	if not context.characterAlive then return "waiting for character" end
	if DAMAGE.active or state.questGrowthReset.exclusive
		or state.questSlots.busy or questSwitchingAnimal then
		return "waiting for safety/slot transaction"
	end
	if context.water <= 60 and state.autoDrink then return "waiting for Water" end
	if context.food <= 50 and state.autoEat then return "waiting for Food" end
	return nil
end

function ai.QuestTracker:Diagnosis(quest, context)
	if quest.supported == false then
		return quest.type .. " is unsupported by this game adapter"
	end
	if quest.animal
		and state.questAnimalKey(quest.animal) ~= state.questAnimalKey(context.animal) then
		return "quest requires animal " .. tostring(quest.animal)
			.. ", active " .. tostring(context.animal)
	end
	if quest.type == "Run" and not state.questLandInputActive then
		return "Run quest has no locomotion owner"
	elseif quest.type == "Swim" and not state.questSwimActive then
		return "Swim quest has no swim controller"
	elseif quest.type == "Zone" then
		local liveZone = state.questCurrentZoneName()
		if quest.zone and (type(liveZone) ~= "string"
			or liveZone:lower() ~= quest.zone:lower()) then
			return "outside required zone " .. tostring(quest.zone)
		end
	elseif quest.type == "Group" then
		if not state.questGroup.localHasActiveGroupTime()
			and not state.questGroup.coop.helperActive then
			return "Group quest has no verified group"
		end
	elseif quest.type == "Growth" and (tonumber(context.growthRate) or 0) <= 0 then
		return "Growth quest has no Growth increase"
	end
	return quest.type .. " quest made no objective progress"
end

function ai.QuestTracker:StalledQuest(now, context)
	now = tonumber(now) or tick()
	context = context or ai.Blackboard
	for _, quest in ipairs(self.active) do
		if quest.supported ~= false
			and quest.current ~= nil and quest.maximum ~= nil
			and quest.current < quest.maximum then

			-- v5.5: Survive/PlayTime is server-time driven and never owns locomotion.
			-- It cannot circuit-break unrelated Local/Travel/Swim execution.
			if quest.type == "Passive" then
				quest.waitingReason = "passive quest is time/server driven"
				quest.lastProgressAt = now
				continue
			end

			local waiting = self:WaitingReason(quest, context)
			if waiting then
				quest.waitingReason = waiting
				quest.lastProgressAt = math.max(quest.lastProgressAt or now, now - 1)
			else
				quest.waitingReason = nil
				local timeout = self:TimeoutFor(quest, context)
				if now - (quest.lastProgressAt or now) >= timeout then
					local diagnosis = self:Diagnosis(quest, context)
					quest.failureReason = diagnosis
					return quest, timeout, diagnosis
				end
			end
		end
	end
	return nil
end

ai.WatchdogManager = {
	records = {},
	lastRuntimeMessage = nil,
	current = nil,
}

function ai.WatchdogManager:Timeout(name, context)
	context = context or ai.Blackboard
	if name == "SafeMove" then
		local distance = ai.MovementManager:DistanceToTarget(context) or 0
		local speed = math.max(1, tonumber(context.speedLimit) or 12)
		return math.clamp(distance / speed * 2.8 + 10, 12, 210)
	elseif name == "Drink" then
		return isDinoLife and 165 or 110
	elseif name == "Eat" then
		return 130
	elseif name == "QuestW" then
		local quest, timeout = ai.QuestTracker:StalledQuest(tick(), context)
		return quest and timeout or 90
	elseif name == "SlotGuardian" then
		return 140
	end
	return 75
end

function ai.WatchdogManager:SetModuleFailure(moduleName, reason, active)
	local module = moduleName and ai.ModuleRegistry:Get(moduleName)
	if not module then return end
	module.runtime.watchdogFailure = active and reason or nil
	module.runtime.watchdogFailureAt = active and tick() or nil
	if active then
		module.runtime.lastProgressAt = math.min(
			module.runtime.lastProgressAt or tick(),
			tick() - 5
		)
	end
end

function ai.WatchdogManager:ResetModuleProbe(moduleName, now)
	now = tonumber(now) or tick()
	self:SetModuleFailure(moduleName, nil, false)
	for _, record in pairs(self.records) do
		if record.moduleName == moduleName then
			record.active = false
			record.stalled = false
			record.failureUntil = nil
			record.failureReason = nil
			record.initialProgress = nil
			record.lastProgress = nil
			record.lastProgressAt = now
			record.startedAt = now
			record.nextEscalationAt = now
			record.result = "fresh circuit probe"
		end
	end
end

function ai.WatchdogManager:Pulse(name, active, reason, progress, timeout, moduleName, context)
	local now = tick()
	timeout = tonumber(timeout) or self:Timeout(name, context)
	local record = self.records[name]
	if not record then
			record = {
			name = name,
			active = false,
			attempts = 0,
			consecutiveFailures = 0,
			lastProgressAt = now,
			nextEscalationAt = 0,
			stalled = false,
		}
		self.records[name] = record
	end

	if active and not record.active then
		record.active = true
		record.startedAt = now
		record.attempts += 1
		record.initialProgress = progress
		record.lastProgress = progress
		record.lastProgressAt = now
		record.reason = reason
		record.timeout = timeout
		record.moduleName = moduleName
	elseif active then
		record.reason = reason or record.reason
		record.timeout = timeout
		record.moduleName = moduleName or record.moduleName
		if type(progress) == "number"
			and (record.lastProgress == nil or progress > record.lastProgress + 0.01) then
			record.lastProgress = progress
			record.lastProgressAt = now
			record.stalled = false
			record.result = "progress"
			self:SetModuleFailure(record.moduleName, nil, false)
			record.consecutiveFailures = 0
		end
		if now - (record.lastProgressAt or now) >= timeout
			and now >= (record.nextEscalationAt or 0) then
			record.stalled = true
			record.consecutiveFailures += 1
			record.attempts += 1
			record.lastFailureAt = now
			record.failureReason = string.format(
				"%s watchdog made no verified progress for %.0fs",
				name,
				now - record.lastProgressAt
			)
			record.result = "stalled"
			record.nextEscalationAt = now + math.clamp(timeout * 0.30, 8, 45)
			self:SetModuleFailure(record.moduleName, record.failureReason, true)
			local stalledModule = record.moduleName and ai.ModuleRegistry:Get(record.moduleName)
			if ai.Authority and stalledModule then
				ai.Authority:Signal(
					"Watchdog:" .. tostring(name),
					stalledModule.owner,
					record.failureReason,
					stalledModule.vital and 940 or 720,
					5
				)
			end
			ai.Memory:MarkFailure("watchdog", name, record.failureReason, 45)
			ai.Telemetry:Push("WatchdogManager", "stall", {
				reason = record.failureReason,
				result = "attempt " .. record.attempts,
				debounce = 8,
			}, "watchdog-stall:" .. name,
				name .. " watchdog failed; escalating strategy")
		end
	elseif record.active then
		local improved = type(progress) == "number"
			and type(record.initialProgress) == "number"
			and progress > record.initialProgress + 0.01
		local duration = now - (record.startedAt or now)
		record.active = false
		record.result = improved and "progress" or "no verified progress"
		record.finishedAt = now
		if improved then
			record.consecutiveFailures = 0
			record.stalled = false
			self:SetModuleFailure(record.moduleName, nil, false)
		else
			if record.stalled or duration >= timeout * 0.75 then
				record.consecutiveFailures += 1
			end
			if record.consecutiveFailures >= 3 then
				ai.Memory:MarkFailure("watchdog", name, record.reason, 45)
			end
			if record.stalled then record.failureUntil = now + 12 end
		end
	elseif record.failureUntil and now >= record.failureUntil then
		record.failureUntil = nil
		record.stalled = false
		self:SetModuleFailure(record.moduleName, nil, false)
	end
	return record
end

function ai.WatchdogManager:Refresh(context)
	local distance = ai.MovementManager:DistanceToTarget(context)
	self:Pulse(
		"Damage", DAMAGE.active, runtimeMessage,
		context.healthFraction * 100, self:Timeout("Damage", context), "Safety", context
	)
	self:Pulse(
		"Drink",
		drinkingToFull or state.drinkTest.active,
		runtimeMessage,
		context.water, self:Timeout("Drink", context), "AutoDrink", context
	)
	self:Pulse(
		"Eat",
		eatingToFull or carcassEatBusy or BABOON.busy or GIRAFFE.busy,
		runtimeMessage,
		context.food, self:Timeout("Eat", context), "AutoEat", context
	)
	self:Pulse(
		"SafeMove", state.safeMove.active, state.safeMove.reason,
		distance and -distance, self:Timeout("SafeMove", context), "Movement", context
	)
	self:Pulse(
		"QuestW",
		state.questLandInputActive or state.questSwimActive,
		questStatusText,
		ai.QuestTracker.lastAggregateProgressAt,
		self:Timeout("QuestW", context), "AutoQuests", context
	)
	self:Pulse(
		"SlotGuardian",
		state.slotGuardian.recovering,
		state.slotGuardian.pendingDeathReason,
		context.characterAlive and 1 or 0,
		self:Timeout("SlotGuardian", context), "Slots", context
	)

	local damageRecord = self.records.Damage
	if damageRecord and damageRecord.active
		and not criticalRecoveryActive
		and not context.inVoid
		and not context.buried
		and not context.dangerousWater
		and context.healthRate >= -0.05
		and tick() - (damageRecord.startedAt or tick()) >= 8 then
		damageRecord.falsePositive = true
		damageRecord.result = "false positive"
		self:SetModuleFailure("Safety", nil, false)
		pcall(state.questReleaseStaleRecoveryLock)
		ai.Telemetry:Push("WatchdogManager", "false-positive", {
			reason = "Damage active without a current hazard",
			result = "stale lock release requested",
			debounce = 12,
		}, "damage-false-positive", "Damage watchdog false positive isolated")
	end

	local drinkRecord = self.records.Drink
	local eatRecord = self.records.Eat
	if drinkRecord and drinkRecord.active and eatRecord and eatRecord.active
		and tick() - math.max(drinkRecord.startedAt or 0, eatRecord.startedAt or 0) >= 4 then
		local waterScore = ai.MovementManager:ScoreOwner("Water", context)
		local foodScore = ai.MovementManager:ScoreOwner("Food", context)
		local suggested = waterScore >= foodScore and "Water" or "Food"
		if ai.Authority then
			ai.Authority:Signal(
				"EatDrinkConflict",
				suggested,
				"Eat and Drink watchdogs active together",
				930,
				4
			)
		end
		ai.Telemetry:Push("WatchdogManager", "advisory-conflict", {
			reason = "Eat and Drink watchdogs active together",
			owner = suggested,
			result = "forwarded to Supervisor Authority",
			debounce = 10,
		}, "watchdog-eat-drink-deadlock", "Watchdog conflict forwarded to Supervisor")
	end

	local best
	for _, record in pairs(self.records) do
		if record.active
			and (not best or record.startedAt < best.startedAt) then
			best = record
		end
	end
	self.current = best
	context.activeWatchdog = best and best.name or "None"
	context.lastWatchdog = best and best.reason or nil

	if runtimeMessage ~= self.lastRuntimeMessage then
		self.lastRuntimeMessage = runtimeMessage
		local lower = type(runtimeMessage) == "string" and runtimeMessage:lower() or ""
		if lower:find("watchdog", 1, true) then
			ai.Telemetry:Push("WatchdogManager", "observed", {
				reason = runtimeMessage,
			})
		end
	end
	return best
end
end)()

