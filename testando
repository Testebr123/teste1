function state.drinkTestGhostCharacter(character, enabled)
	local test = state.drinkTest

	if enabled then
		if test.collisionSnapshot then
			-- Reassert clipping even if Roblox or another controller changed a
			-- character part after the original snapshot was captured.
			for _, object in ipairs(
				character:GetDescendants()
			) do
				if object:IsA("BasePart")
					and object.CanCollide then
					object.CanCollide = false
				end
			end

			return true
		end

		local snapshot = {}

		for _, object in ipairs(
			character:GetDescendants()
		) do
			if object:IsA("BasePart") then
				snapshot[#snapshot + 1] = {
					part = object,
					canCollide = object.CanCollide,
				}

				-- Only clipping mechanism used by this test.
				-- Position is still changed only by SafeMove/velocity.
				object.CanCollide = false
			end
		end

		test.collisionSnapshot = snapshot
		return #snapshot > 0
	end

	local snapshot =
		test.collisionSnapshot

	if snapshot then
		for _, record in ipairs(snapshot) do
			local part = record.part

			if part and part.Parent then
				pcall(function()
					part.CanCollide =
						record.canCollide == true
				end)
			end
		end
	end

	test.collisionSnapshot = nil
	return true
end

function state.drinkTestSetTransitPhysics(
	character,
	humanoid,
	enabled
)
	local test = state.drinkTest

	if not character or not humanoid then
		return false
	end

	if enabled then
		local root = character:FindFirstChild("HumanoidRootPart")

		if not test.humanoidSnapshot then
			local freefallEnabled
			local fallingDownEnabled
			local ragdollEnabled

			pcall(function()
				freefallEnabled = humanoid:GetStateEnabled(
					Enum.HumanoidStateType.Freefall
				)
				fallingDownEnabled = humanoid:GetStateEnabled(
					Enum.HumanoidStateType.FallingDown
				)
				ragdollEnabled = humanoid:GetStateEnabled(
					Enum.HumanoidStateType.Ragdoll
				)
			end)

			test.humanoidSnapshot = {
				platformStand = humanoid.PlatformStand,
				autoRotate = humanoid.AutoRotate,
				sit = humanoid.Sit,
				movementDisabled = character:GetAttribute(
					"MovementDisabled"
				),
				freefallEnabled = freefallEnabled,
				fallingDownEnabled = fallingDownEnabled,
				ragdollEnabled = ragdollEnabled,
			}
		end

		-- Underground Drink must NEVER use Physics, PlatformStand OR Anchored.
		-- Anchoring can stop Savannah from accepting Eating/Drinking. Keep the
		-- assembly live, disable ragdoll/fall states, and pin CFrame every frame.
		pcall(function()
			humanoid:SetStateEnabled(
				Enum.HumanoidStateType.Freefall,
				false
			)
			humanoid:SetStateEnabled(
				Enum.HumanoidStateType.FallingDown,
				false
			)
			humanoid:SetStateEnabled(
				Enum.HumanoidStateType.Ragdoll,
				false
			)
			humanoid.PlatformStand = false
			humanoid.Sit = false
			humanoid.AutoRotate = false

			local currentState = humanoid:GetState()
			if currentState == Enum.HumanoidStateType.Physics
				or currentState == Enum.HumanoidStateType.Ragdoll
				or currentState == Enum.HumanoidStateType.FallingDown
				or currentState == Enum.HumanoidStateType.Freefall then

				humanoid:ChangeState(
					Enum.HumanoidStateType.GettingUp
				)
			end
		end)

		if root then
			pcall(function()
				root.Anchored = false
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
			end)
		end

		character:SetAttribute(
			"MovementDisabled",
			true
		)

		return true
	end

	local snapshot =
		test.humanoidSnapshot

	if snapshot then
		local root = character:FindFirstChild("HumanoidRootPart")

		-- Underground Drink never anchors the character. Keep it unanchored on
		-- restore as well; the surface exit already places it at supported height.
		if root then
			pcall(function()
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
				root.Anchored = false
			end)
		end

		pcall(function()
			if snapshot.freefallEnabled ~= nil then
				humanoid:SetStateEnabled(
					Enum.HumanoidStateType.Freefall,
					snapshot.freefallEnabled == true
				)
			end

			if snapshot.fallingDownEnabled ~= nil then
				humanoid:SetStateEnabled(
					Enum.HumanoidStateType.FallingDown,
					snapshot.fallingDownEnabled == true
				)
			end

			if snapshot.ragdollEnabled ~= nil then
				humanoid:SetStateEnabled(
					Enum.HumanoidStateType.Ragdoll,
					snapshot.ragdollEnabled == true
				)
			end

			humanoid.PlatformStand = snapshot.platformStand == true
			humanoid.Sit = snapshot.sit == true
			humanoid.AutoRotate = snapshot.autoRotate ~= false
			humanoid:ChangeState(
				Enum.HumanoidStateType.GettingUp
			)
		end)

		if snapshot.movementDisabled == nil then
			character:SetAttribute(
				"MovementDisabled",
				false
			)
		else
			character:SetAttribute(
				"MovementDisabled",
				snapshot.movementDisabled
			)
		end
	else
		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			pcall(function()
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
				root.Anchored = false
			end)
		end

		pcall(function()
			humanoid:SetStateEnabled(
				Enum.HumanoidStateType.Freefall,
				true
			)
			humanoid:SetStateEnabled(
				Enum.HumanoidStateType.FallingDown,
				true
			)
			humanoid:SetStateEnabled(
				Enum.HumanoidStateType.Ragdoll,
				true
			)
			humanoid.PlatformStand = false
			humanoid.Sit = false
			humanoid.AutoRotate = true
			humanoid:ChangeState(
				Enum.HumanoidStateType.GettingUp
			)
		end)

		character:SetAttribute(
			"MovementDisabled",
			false
		)
	end

	test.humanoidSnapshot = nil
	return true
end

function state.drinkTestMaintainTransit(
	character,
	root,
	humanoid
)
	if not character
		or not root
		or not humanoid then
		return false
	end

	for _, object in ipairs(
		character:GetDescendants()
	) do
		if object:IsA("BasePart")
			and object.CanCollide then
			object.CanCollide = false
		end
	end

	state.drinkTestSetTransitPhysics(
		character,
		humanoid,
		true
	)

	-- Reassert an upright LIVE assembly. Position locking is done by CFrame/PivotTo
	-- every frame; never Anchor because Savannah can reject Drinking/Eating then.
	pcall(function()
		root.Anchored = false
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		humanoid.PlatformStand = false
		humanoid.Sit = false

		local currentState = humanoid:GetState()
		if currentState == Enum.HumanoidStateType.Physics
			or currentState == Enum.HumanoidStateType.Ragdoll
			or currentState == Enum.HumanoidStateType.FallingDown
			or currentState == Enum.HumanoidStateType.Freefall then

			humanoid:ChangeState(
				Enum.HumanoidStateType.GettingUp
			)
		end
	end)

	return true
end

function state.drinkTestSmoothMove(
	targetPosition,
	label,
	ignoreCancel,
	maxDuration
)
	local test = state.drinkTest

	if typeof(targetPosition) ~= "Vector3" then
		return false, "invalid_target"
	end

	local character, root, humanoid =
		characterParts()

	if not character
		or character ~= test.character
		or not root
		or not humanoid
		or humanoid.Health <= 0 then
		return false, "character"
	end

	if not state.drinkTestGhostCharacter(character, true) then
		return false, "collision"
	end

	state.drinkTestMaintainTransit(character, root, humanoid)

	if state.questSetW then
		pcall(state.questSetW, false)
	end

	local startRootCFrame = root.CFrame
	local goalRootCFrame =
		CFrame.new(targetPosition)
		* startRootCFrame.Rotation

	-- Preserve the complete rig relative to HRP. Moving only HRP can visually
	-- compress large custom rigs against Terrain; PivotTo translates the whole
	-- animal as one assembly while collision is disabled.
	local rootToPivot
	pcall(function()
		rootToPivot =
			startRootCFrame:ToObjectSpace(
				character:GetPivot()
			)
	end)

	local function placeWholeRig(desiredRootCFrame)
		if not character.Parent or not root.Parent then
			return false
		end

		state.drinkTestGhostCharacter(character, true)
		state.drinkTestMaintainTransit(character, root, humanoid)

		local placed = false
		if rootToPivot then
			placed = pcall(function()
				character:PivotTo(
					desiredRootCFrame * rootToPivot
				)
			end)
		end

		if not placed then
			pcall(function()
				root.CFrame = desiredRootCFrame
			end)
		end

		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		return true
	end

	local distance =
		(targetPosition - root.Position).Magnitude

	local transitSpeed =
		math.max(
			260,
			state.safeMovementSpeed(character) * 5
		)

	local duration
	if label == "descent" then
		-- Crossing Terrain must be decisive. A long interpolation lets the game
		-- controller keep pushing a huge animal back onto the surface.
		duration = math.clamp(
			distance / transitSpeed,
			0.05,
			0.18
		)
	else
		duration = math.clamp(
			distance / transitSpeed,
			0.06,
			0.32
		)
	end

	if tonumber(maxDuration) then
		duration = math.min(duration, math.max(0.05, tonumber(maxDuration)))
	end

	local startedAt = tick()
	local lastActualPosition = root.Position
	local lastActualProgressAt = tick()
	local lastDistance = distance

	while state.alive
		and character.Parent
		and root.Parent
		and humanoid.Parent
		and humanoid.Health > 0 do

		if test.cancelRequested and not ignoreCancel then
			return false, "cancel"
		end

		local abort =
			state.drinkTestTransitAbortReason(
				character,
				root,
				humanoid
			)

		if abort
			and not (ignoreCancel and abort == "cancel") then
			return false, abort
		end

		local alpha =
			math.clamp(
				(tick() - startedAt) / duration,
				0,
				1
			)

		local desired =
			startRootCFrame:Lerp(
				goalRootCFrame,
				alpha
			)

		if not placeWholeRig(desired) then
			return false, "character"
		end

		local actualDistance =
			(targetPosition - root.Position).Magnitude

		if actualDistance < lastDistance - 0.35 then
			lastDistance = actualDistance
			lastActualProgressAt = tick()
			lastActualPosition = root.Position
		elseif (root.Position - lastActualPosition).Magnitude >= 0.75 then
			lastActualPosition = root.Position
			lastActualProgressAt = tick()
		end

		if tick() - lastActualProgressAt >= 1.25 then
			break
		end

		if alpha >= 1 then
			break
		end

		RunService.Heartbeat:Wait()
	end

	-- Endpoint authority: reassert the entire rig for several frames. This is
	-- important for Elephant because its custom controller may correct one frame
	-- back toward the Terrain surface.
	for _ = 1, 12 do
		if not character.Parent or not root.Parent or not humanoid.Parent then
			break
		end
		placeWholeRig(goalRootCFrame)
		RunService.Heartbeat:Wait()
	end

	local finalDistance =
		root.Parent
		and (root.Position - targetPosition).Magnitude
		or math.huge

	if finalDistance > 4 then
		-- One final hard reassertion before declaring failure. Never remain half
		-- embedded at the Terrain surface.
		for _ = 1, 10 do
			if not placeWholeRig(goalRootCFrame) then break end
			RunService.Heartbeat:Wait()
		end
		finalDistance =
			root.Parent
			and (root.Position - targetPosition).Magnitude
			or math.huge
	end

	if finalDistance > 4 then
		return false,
			string.format(
				"whole_rig_final_distance_%.1f",
				finalDistance
			)
	end

	return true, "arrived"
end

function state.drinkTestFindLocalSpot(origin, character)
	if not isSavannahLife
		or typeof(origin) ~= "Vector3"
		or not character then
		return nil
	end

	local waterPart =
		workspace:FindFirstChild(
			"MainWaterPart"
		)

	if not waterPart
		or not waterPart:IsA("BasePart") then
		return nil
	end

	local waterY =
		waterPart.Position.Y
		+ waterPart.Size.Y * 0.5

	if waterY <= config.dangerY + 8 then
		return nil
	end

	local _, root, humanoid =
		characterParts()

	local lift =
		humanoid
			and math.max(
				humanoid.HipHeight,
				1.5
			)
			or 2.5

	local head =
		character:FindFirstChild(
			"Head"
		)

	local headOffset =
		root
			and head
			and math.max(
				0,
				head.Position.Y - root.Position.Y
			)
			or 0

	local bodyHeight =
		state.movementBodySize(
			character
		).Y

	-- Drinking is decided around the animal's interaction/head height, not by
	-- forcing the HRP to a generic body-depth. For Elephant the head can be many
	-- studs above HRP, so HRP must cross Terrain decisively until the head is
	-- actually a few studs inside MainWaterPart.
	local interactionOffset =
		headOffset > 0.5
			and headOffset
			or math.max(
				lift,
				bodyHeight * 0.18
			)

	local submergeDepth =
		math.clamp(
			waterPart.Size.Y * 0.18,
			1.75,
			3.5
		)

	local desiredInteractionY =
		waterY - submergeDepth

	local undergroundStandY =
		math.max(
			desiredInteractionY - interactionOffset,
			config.dangerY + 16
		)

	-- Collision is disabled during the transaction, so large HipHeight must NOT
	-- increase the required Terrain cover. That old rule rejected the local point
	-- for adult Elephant and made the controller appear to press into the floor.
	local minimumCover = 6
	local maximumCover = 110
	local angleOffset =
		(player.UserId % 360)
		* math.pi / 180

	local best
	local bestScore = math.huge

	local searchRadii = {}
	for radius = 0, 160, 10 do
		table.insert(searchRadii, radius)
	end
	for radius = 180, 520, 20 do
		table.insert(searchRadii, radius)
	end

	for _, radius in ipairs(searchRadii) do
		local samples =
			radius == 0 and 1
			or radius <= 60 and 16
			or 20

		for index = 0, samples - 1 do
			local angle =
				angleOffset
				+ index / samples
					* math.pi * 2

			local x =
				origin.X
				+ math.cos(angle)
					* radius

			local z =
				origin.Z
				+ math.sin(angle)
					* radius

			if state.drinkMainWaterContainsXZ(
				waterPart,
				x,
				z
			) then
				local castY =
					math.max(
						origin.Y,
						waterY
					) + 500

				local surfaceHit =
					state.drinkSolidTerrainHit(
						x,
						z,
						castY
					)

				if surfaceHit then
					local cover =
						surfaceHit.Position.Y
						- waterY

					if cover >= minimumCover
						and cover <= maximumCover
						and undergroundStandY
							>= config.dangerY + 12 then

						-- Favor local X/Z strongly; cover depth is secondary.
						local score =
							radius
							+ cover * 0.12

						if score < bestScore then
							bestScore = score

							best = {
								water =
									Vector3.new(
										x,
										waterY,
										z
									),

								-- Stable current-body depth; no shoreline micro-adjust loop.
								stand =
									Vector3.new(
										x,
										undergroundStandY,
										z
									),

								surfaceHit =
									surfaceHit.Position,

								exit =
									Vector3.new(
										x,
										surfaceHit.Position.Y
											+ lift
											+ 7,
										z
									),

								coverDepth = cover,
								radius = radius,
								waterPart = waterPart,
							}
						end
					end
				end
			end
		end

		-- Prefer the current locality aggressively. Direct vertical descent at the
		-- same/near XZ is safer than a diagonal underground translation.
		if best and radius <= 20 then
			break
		end
	end

	return best
end

function state.drinkTestAboveTerrainConfirmed()
	local test = state.drinkTest
	local character, root =
		characterParts()

	if not character or not root then
		return false
	end

	if root.Position.Y < config.dangerY then
		return false
	end

	if state.drinkIsBuriedUnderTerrain(
		root
	) then
		return false
	end

	if test.surfaceY
		and root.Position.Y
			< test.surfaceY + 1.5 then
		return false
	end

	return true
end

function state.drinkTestTransitAbortReason(
	character,
	root,
	humanoid
)
	local test = state.drinkTest

	if test.cancelRequested then
		return "cancel"
	end

	if not character
		or character ~= test.character
		or not root
		or not humanoid
		or humanoid.Health <= 0 then
		return "character"
	end

	if root.Position.Y
		< config.dangerY + 4 then
		return "void"
	end

	if state.drinkTestHealthHazard
		and state.drinkTestHealthHazard(
			humanoid
		) then
		return "health"
	end

	return nil
end


local function escapeDinoToSafety(label)
	label = label or "solo seguro"

	-- REGRA ABSOLUTA: o AquaticNestRock é EXCLUSIVO do watchdog de void.
	-- Se o personagem não estiver abaixo do dangerY, essa função não faz nada.
	local _, root = characterParts()
	if not root or root.Position.Y >= config.dangerY then
		return false
	end

	runtimeMessage = "VOID detectado; usando rota AquaticNestRock"

	local aquatic = findAquaticNestRock()
	if aquatic then
		ensureOnSolidGround(aquatic.Position, "AquaticNestRock (saindo do void)")
	end

	local nestRock1 = findNestRock1()
	if nestRock1 then
		return ensureOnSolidGround(nestRock1.Position, "NestRock1")
	end

	if not aquatic then
		runtimeMessage = "Void: nem AquaticNestRock nem NestRock1 encontrados"
	end
	return aquatic ~= nil
end


function DAMAGE.modeName()
	if state.growExisting then return "Grow Existing Slots" end
	if state.growNew then return "Grow New Slots" end
	if state.farmCoins then return "AFK Coin Farm" end
	return "modo atual"
end

function DAMAGE.isSafeSpawn(part)
	if not part or not part:IsA("BasePart") or not part.Parent then return false end

	local name = part.Name:lower()
	if name:find("aquatic", 1, true)
		or name:find("water", 1, true)
		or name:find("ocean", 1, true)
		or name:find("river", 1, true)
		or name:find("priderock", 1, true) then
		-- Pride Rock is a Growth/slot-staging destination, not a watchdog escape.
		return false
	end

	return true
end

function DAMAGE.getNearestSafeSpawns(root, maxDistance)
	refreshCompletionSpawns()

	maxDistance = tonumber(maxDistance)
		or DAMAGE.maxEmergencySpawnDistance
		or 380

	local candidates = {}
	for _, part in ipairs(completionSpawnParts) do
		if DAMAGE.isSafeSpawn(part) then
			local distance =
				(part.Position - root.Position).Magnitude

			if distance <= maxDistance then
				table.insert(candidates, part)
			end
		end
	end

	table.sort(candidates, function(a, b)
		return (a.Position - root.Position).Magnitude
			< (b.Position - root.Position).Magnitude
	end)

	return candidates
end

function DAMAGE.tryLocalDryEscape(character, root, label)
	if not character or not root then return false end

	local localExit =
		state.findNearestDryWaterExit
		and state.findNearestDryWaterExit(root)

	if not localExit then
		localExit = findSafeTerrainSpot(
			root.Position,
			18,
			DAMAGE.localEscapeRadius or 170
		)
	end

	if not localExit then
		return false
	end

	local flatDistance = Vector3.new(
		localExit.X - root.Position.X,
		0,
		localExit.Z - root.Position.Z
	).Magnitude

	if flatDistance > (DAMAGE.localEscapeRadius or 170) then
		return false
	end

	local buried =
		root.Position.Y < config.dangerY
		or (
			not isDinoLife
			and state.drinkIsBuriedUnderTerrain(root)
		)

	local startsInWater = isStandingInWater(root)

	runtimeMessage = label
		or string.format(
			"Watchdog: local dry escape (%.0f studs)",
			flatDistance
		)

	local moved = safeMoveToPosition(
		localExit,
		7,
		nil,
		{
			purpose = "safety",
			tolerance = 14,
			vertical = buried,
			forceMoveToLand = not buried,
			constantSpeed = not buried,
			-- Water/void escape may finish on the first verified dry patch. A damage
			-- watchdog that already started on land must actually walk away instead.
			stopOnDryGround = startsInWater or buried,
			maxDuration = 180,
		}
	)

	task.wait(0.18)

	local liveCharacter, liveRoot = characterParts()
	return moved == true
		and liveCharacter ~= nil
		and liveRoot ~= nil
		and liveRoot.Position.Y >= config.dangerY
		and not isStandingInWater(liveRoot)
		and (
			isDinoLife
			or not state.drinkIsBuriedUnderTerrain(liveRoot)
		)
end

function DAMAGE.moveToSafety()
	local character, root = characterParts()
	if not character or not root then return false, nil end

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	if waterPart and waterPart:IsA("BasePart") then
		local crocHippo =
			state.isCrocOrHippoMovementCharacter(
				character
			)

		local exitActive =
			crocHippo
			and state.aquaticRiverEscape
			and (
				state.aquaticRiverEscape.busy
					or state.aquaticRiverEscape.survivalSuspended
			)

		if isDinoLife then
			waterPart.CanCollide = false
		elseif exitActive then
			waterPart.CanCollide = false
		elseif crocHippo then
			waterPart.CanCollide = true
		else
			waterPart.CanCollide =
				isAquaticCharacter(
					character
				)
		end
	end

	local crocHippoUnderWater =
		state.isCrocOrHippoMovementCharacter(
			character
		)
		and state.isUnderMainWaterPart(
			root
		)

	if crocHippoUnderWater
		and state.moveAquaticToDryTerrain then

		local aquaticEscaped =
			state.moveAquaticToDryTerrain(
				character,
				root
			)

		if aquaticEscaped then
			setAquaticWaterCollision(
				character,
				false
			)

			state.releaseMovementNow(
				character,
				true
			)

			return true, nil
		end

		runtimeMessage =
			CROC.isCharacter(character)
				and "Croc under MainWaterPart: generic watchdog blocked"
				or "Hippo under MainWaterPart: generic watchdog blocked"

		return false, nil
	end

	-- Local Terrain is always preferred. Do not walk to a spawn when a dry
	-- patch is available beside the animal.
	if DAMAGE.tryLocalDryEscape(
		character,
		root,
		"Watchdog: escaping to nearby dry Terrain"
	) then
		if isAquaticCharacter(character) then
			setAquaticWaterCollision(character, false)
		end
		state.releaseMovementNow(character, true)
		return true, nil
	end

	local candidates = DAMAGE.getNearestSafeSpawns(
		root,
		DAMAGE.maxEmergencySpawnDistance
	)
	for _, spawnPart in ipairs(candidates) do
		runtimeMessage = "Watchdog: fugindo para " .. spawnPart.Name

		local _, routeRoot = characterParts()
		local buried =
			routeRoot
			and (
				routeRoot.Position.Y < config.dangerY
				or (
					not isDinoLife
					and state.drinkIsBuriedUnderTerrain(routeRoot)
				)
			)
			or false

		local ok = safeMoveToPosition(
			spawnPart.Position,
			7,
			nil,
			{
				purpose = "safety",
				tolerance = 20,
				vertical = buried,
				forceMoveToLand = not buried,
				constantSpeed = not buried,
				maxDuration = 300,
			}
		)
		task.wait(0.25)

		local _, newRoot = characterParts()
		if ok
			and newRoot
			and not isStandingInWater(
				newRoot
			) then

			if isAquaticCharacter(
				character
			) then
				setAquaticWaterCollision(
					character,
					false
				)
			end

			state.releaseMovementNow(
				character,
				true
			)

			return true, spawnPart
		end
	end

	-- No global farm/Pride fallback here. If nearby spawns fail, retry local Terrain.

	local retryCharacter, retryRoot = characterParts()
	if retryCharacter and retryRoot
		and DAMAGE.tryLocalDryEscape(
			retryCharacter,
			retryRoot,
			"Watchdog: retrying local Terrain instead of crossing the map"
		) then
		state.releaseMovementNow(retryCharacter, true)
		return true, nil
	end

	return false, nil
end

function DAMAGE.recover(character, humanoid, healthBefore, healthAfter, reason, forceMinimumWait)
	-- Underground Drink has a dedicated health/exit watchdog. A delayed
	-- HealthChanged task from the descent must never start the global 25s
	-- protection routine after the transaction has already taken ownership.
	if state.drinkTest
		and state.drinkTest.active == true
		and state.drinkTest.character == character then
		return
	end

	if not state.aiSupervisorPermitController(
		"Safety",
		"DamageRecovery",
		reason or "damage/health recovery",
		1000
	) then
		return
	end

	if state.questGrowthReset.exclusive
		and not state.aiSupervisorSafetyOverride() then
		return
	end
	if DAMAGE.active or tick() < DAMAGE.cooldownUntil then return end
	if character ~= player.Character or not humanoid.Parent or humanoid.Health <= 0 then return end

	DAMAGE.cancelToken += 1
	local recoveryToken = DAMAGE.cancelToken
	DAMAGE.active = true

	local previousCriticalRecovery = criticalRecoveryActive
	local previousMode = DAMAGE.modeName()

	criticalRecoveryActive = true

	-- IMPORTANT: watchdog recovery must NEVER change the user's Survival toggles.
	-- DAMAGE.active + criticalRecoveryActive already pause competing Auto Eat /
	-- Auto Drink / quest movement controllers while the escape is running.
	-- Keeping the toggles untouched means they resume automatically when the
	-- recovery lock ends instead of being accidentally restored as false.
	removeSwimBarrier()
	drinkingToFull = false
	eatingToFull = false
	if not activeCarcassCommitted then
		clearActiveCarcass(false)
	end
	state.questBaboonFeeding = false
	state.questGiraffeFeeding = false
	BABOON.cancel()
	GIRAFFE.cancel()
	drinkingSourcePosition = nil

	if renders then
		if renders.autoEat then renders.autoEat() end
		if renders.autoDrink then renders.autoDrink() end
	end

	local maxHealth = math.max(humanoid.MaxHealth, 1)
	local lostPercent = math.max(0, math.floor(((healthBefore - healthAfter) / maxHealth) * 100 + 0.5))

	if reason == "critical" then
		runtimeMessage = string.format(
			"Watchdog CRITICO: vida em %d%%; fugindo agora",
			math.floor((healthAfter / maxHealth) * 100)
		)
	elseif reason == "slow" then
		runtimeMessage = string.format(
			"Watchdog: vida caindo sem controle (-%d%%); fugindo",
			lostPercent
		)
	else
		runtimeMessage = string.format("Watchdog: dano alto (-%d%%); fugindo", lostPercent)
	end

	-- Espera brevemente uma ação anterior liberar state.busy.
	local busyDeadline = tick() + 2
	while state.busy
		and tick() < busyDeadline
		and state.alive
		and DAMAGE.cancelToken == recoveryToken do
		task.wait(0.05)
	end

	if DAMAGE.cancelToken ~= recoveryToken then
		return
	end

	-- Emergência tem prioridade.
	if state.busy then
		state.busy = false
	end

	local escaped, safeSpawn = DAMAGE.moveToSafety()

	character = player.Character
	humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if escaped and character and humanoid and humanoid.Health > 0 then
		local food = character:GetAttribute("Food") or 0
		local water = character:GetAttribute("Water") or 0
		local waitStartedAt = tick()
		local minimumWaitUntil = waitStartedAt + DAMAGE.criticalMinWait

		while state.alive
			and character == player.Character
			and humanoid.Parent
			and humanoid.Health > 0
			and DAMAGE.cancelToken == recoveryToken
			and tick() < minimumWaitUntil do

			food = character:GetAttribute("Food") or 0
			water = character:GetAttribute("Water") or 0

			-- Não mata um slot de fome/sede só para cumprir o timer.
			-- Se um recurso ficar realmente baixo, libera o survival mais cedo.
			if food <= 45 or water <= 45 then
				runtimeMessage = string.format(
					"Watchdog: seguro, mas Food %d%% Water %d%%; liberando survival",
					math.floor(food),
					math.floor(water)
				)
				break
			end

			runtimeMessage = string.format(
				"Watchdog: protegido em %s (%ds) | HP %d%%",
				safeSpawn and safeSpawn.Name or "local seguro",
				math.max(0, math.ceil(minimumWaitUntil - tick())),
				math.floor((humanoid.Health / math.max(humanoid.MaxHealth, 1)) * 100)
			)
			task.wait(0.5)
		end

		food = character:GetAttribute("Food") or 0
		water = character:GetAttribute("Water") or 0

		if food >= DAMAGE.safeFoodWater and water >= DAMAGE.safeFoodWater then
			local startHealth = humanoid.Health
			local targetHealth = math.min(
				humanoid.MaxHealth,
				startHealth + humanoid.MaxHealth * DAMAGE.targetHealFraction
			)
			local deadline = tick() + DAMAGE.maxRecoveryWait

			while state.alive
				and character == player.Character
				and humanoid.Parent
				and humanoid.Health > 0
				and DAMAGE.cancelToken == recoveryToken
				and tick() < deadline
				and humanoid.Health < targetHealth do

				food = character:GetAttribute("Food") or 0
				water = character:GetAttribute("Water") or 0

				if food < DAMAGE.safeFoodWater or water < DAMAGE.safeFoodWater then
					break
				end

				runtimeMessage = string.format(
					"Watchdog: recuperando vida em %s (%ds)",
					safeSpawn and safeSpawn.Name or "local seguro",
					math.max(0, math.ceil(deadline - tick()))
				)
				task.wait(0.5)
			end
		elseif not forceMinimumWait then
			runtimeMessage = string.format(
				"Watchdog: Food %d%% Water %d%%; retomando para repor",
				math.floor(food),
				math.floor(water)
			)
			task.wait(1)
		end
	elseif not escaped then
		runtimeMessage = "Watchdog: nenhum spawn seguro confirmado"
		task.wait(0.5)
	end

	-- Do not restore/rewrite Auto Eat or Auto Drink here. Their values were
	-- intentionally preserved throughout the watchdog transaction.
	if renders then
		if renders.autoEat then renders.autoEat() end
		if renders.autoDrink then renders.autoDrink() end
	end

	if DAMAGE.cancelToken == recoveryToken then
		criticalRecoveryActive = previousCriticalRecovery
		DAMAGE.active = false
		DAMAGE.cooldownUntil = tick() + 2
		runtimeMessage = "Watchdog: seguro; retomando " .. previousMode
	end
end

function DAMAGE.bind(character)
	if DAMAGE.connection then
		DAMAGE.connection:Disconnect()
		DAMAGE.connection = nil
	end

	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
		or character:WaitForChild("Humanoid", 10)
	if not humanoid then return end

	local lastHealth = humanoid.Health
	local windowStartHealth = nil
	local windowStartedAt = nil

	-- Maior vida observada na janela lenta.
	local slowPeakHealth = humanoid.Health
	local slowPeakAt = tick()

	DAMAGE.connection = humanoid.HealthChanged:Connect(function(newHealth)
		if not state.alive or character ~= player.Character then return end

		if state.drinkTest
			and state.drinkTest.active == true
			and state.drinkTest.character == character then

			-- The Underground transaction evaluates this health change itself. Keep
			-- global watchdog baselines synchronized so no stale loss is replayed
			-- after the animal returns to the surface.
			lastHealth = newHealth
			windowStartHealth = nil
			windowStartedAt = nil
			slowPeakHealth = newHealth
			slowPeakAt = tick()
			return
		end

		if state.questGrowthReset.exclusive then
			lastHealth = newHealth
			windowStartHealth = nil
			windowStartedAt = nil
			slowPeakHealth = newHealth
			slowPeakAt = tick()
			return
		end

		if newHealth <= 0 then
			lastHealth = newHealth
			return
		end

		local now = tick()
		local maxHealth = math.max(humanoid.MaxHealth, 1)

		-- Emergência ignora cooldown. O cooldown só bloqueia duplicatas normais.
		if not DAMAGE.active
			and newHealth <= maxHealth * DAMAGE.criticalHealthFraction then
			local before = math.max(lastHealth, slowPeakHealth, newHealth)
			lastHealth = newHealth
			windowStartHealth = nil
			windowStartedAt = nil
			slowPeakHealth = newHealth
			slowPeakAt = now
			task.spawn(DAMAGE.recover, character, humanoid, before, newHealth, "critical", true)
			return
		end

		if DAMAGE.active or now < DAMAGE.cooldownUntil then
			lastHealth = newHealth
			windowStartHealth = nil
			windowStartedAt = nil
			slowPeakHealth = math.max(slowPeakHealth, newHealth)
			return
		end

		-- Atualiza/reinicia a referência de vida alta da janela lenta.
		if newHealth > slowPeakHealth then
			slowPeakHealth = newHealth
			slowPeakAt = now
		elseif now - slowPeakAt > DAMAGE.slowWindowSeconds then
			-- A cada janela, carrega a vida atual como nova referência.
			-- Assim detecta uma queda prolongada em "degraus" sem depender de hit grande.
			slowPeakHealth = math.max(newHealth, lastHealth)
			slowPeakAt = now
		end

		-- Dano rápido: mantém a lógica anterior de 35% em até 4 segundos.
		if newHealth < lastHealth then
			if not windowStartedAt or now - windowStartedAt > DAMAGE.windowSeconds then
				windowStartedAt = now
				windowStartHealth = lastHealth
			end

			local baseline = windowStartHealth or lastHealth
			local loss = baseline - newHealth
			local fastThreshold = maxHealth * DAMAGE.dropFraction

			if loss >= fastThreshold then
				windowStartHealth = nil
				windowStartedAt = nil
				lastHealth = newHealth
				task.spawn(DAMAGE.recover, character, humanoid, baseline, newHealth, "fast", true)
				return
			end

			-- Dano lento/descontrolado: a vida pode ir caindo pouco a pouco.
			local slowLoss = slowPeakHealth - newHealth
			local slowThreshold = maxHealth * DAMAGE.slowDropFraction

			if slowLoss >= slowThreshold then
				local before = slowPeakHealth
				windowStartHealth = nil
				windowStartedAt = nil
				lastHealth = newHealth
				slowPeakHealth = newHealth
				slowPeakAt = now
				task.spawn(DAMAGE.recover, character, humanoid, before, newHealth, "slow", true)
				return
			end
		elseif newHealth > lastHealth then
			-- Regenerou: zera a janela rápida. A lenta conserva o novo pico.
			windowStartHealth = nil
			windowStartedAt = nil
			if newHealth >= slowPeakHealth then
				slowPeakHealth = newHealth
				slowPeakAt = now
			end
		end

		lastHealth = newHealth
	end)
end

DAMAGE.bind(player.Character)

task.spawn(function()
	local trackedCharacter
	local trackedHumanoid
	local peakHealth
	local peakAt

	while state.alive do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		if character ~= trackedCharacter or humanoid ~= trackedHumanoid then
			trackedCharacter = character
			trackedHumanoid = humanoid
			peakHealth = humanoid and humanoid.Health or nil
			peakAt = tick()
		elseif humanoid
			and humanoid.Parent
			and humanoid.Health > 0
			and not state.questGrowthReset.exclusive then
			local now = tick()

			if state.drinkTest
				and state.drinkTest.active == true
				and state.drinkTest.character == character then

				peakHealth = humanoid.Health
				peakAt = now
				task.wait(DAMAGE.pollInterval)
				continue
			end
			local maxHealth = math.max(humanoid.MaxHealth, 1)
			local currentHealth = humanoid.Health

			if not peakHealth or currentHealth > peakHealth then
				peakHealth = currentHealth
				peakAt = now
			elseif now - (peakAt or now) > DAMAGE.pollWindow then
				-- Carry current HP forward so repeated small drops continue
				-- being detectable instead of keeping a stale lifetime peak.
				peakHealth = math.max(currentHealth, peakHealth - maxHealth * 0.05)
				peakAt = now
			end

			if not DAMAGE.active then
				-- Layer 1: current HP alone is enough to trigger safety.
				if currentHealth <= maxHealth * DAMAGE.criticalHealthFraction then
					task.spawn(
						DAMAGE.recover,
						character,
						humanoid,
						math.max(peakHealth or currentHealth, currentHealth),
						currentHealth,
						"critical",
						true
					)
				else
					-- Layer 2: continuous small loss in the polling window.
					local pollLoss = (peakHealth or currentHealth) - currentHealth
					if pollLoss >= maxHealth * DAMAGE.pollDropFraction
						and now - (peakAt or now) <= DAMAGE.pollWindow then

						local before = peakHealth or currentHealth
						peakHealth = currentHealth
						peakAt = now

						task.spawn(
							DAMAGE.recover,
							character,
							humanoid,
							before,
							currentHealth,
							"slow",
							true
						)
					end
				end
			end
		end

		task.wait(DAMAGE.pollInterval)
	end
end)

table.insert(connections, player.CharacterAdded:Connect(function(character)
	DAMAGE.cooldownUntil = tick() + 1.5
	DAMAGE.active = false

	-- A newly spawned animal must NEVER inherit the previous animal's food route.
	-- This is especially visible on Herbivore -> Carnivore switches: the new Dog
	-- could keep walking toward the Impala's old grass target until Auto Eat was
	-- manually toggled OFF/ON. Cancel only Survival-food movement here; other
	-- intentional slot/quest transactions keep their own controllers.
	if state.safeMove
		and state.safeMove.active
		and state.safeMove.reason == "food" then
		state.safeMove.cancelToken += 1
	end

	eatingToFull = false
	eatingSourcePosition = nil
	eatingTargetReachedAt = nil
	eatingStuckSince = nil
	lastEatWatchdogFood = nil
	clearActiveCarcass(true)
	nextCarnivoreExploreCheck = 0
	savannahCarcassSpawnIndex = 0
	savannahCarcassCurrentSpawn = nil

	state.questCarnivoreFeeding = false
	state.questBaboonFeeding = false
	state.questGiraffeFeeding = false
	state.questTravelHerbivoreFeed.active = false
	if state.questPostSwimHandoff then
		state.questPostSwimHandoff.token = (state.questPostSwimHandoff.token or 0) + 1
		state.questPostSwimHandoff.active = false
		state.questPostSwimHandoff.character = nil
		state.questPostSwimHandoff.target = nil
	end
	BABOON.cancel()
	GIRAFFE.cancel()

	if state.survivalArbiterReset then
		state.survivalArbiterReset("character added")
	end

	state.questZoneLastMoveAt = 0
	state.questZoneLastTarget = nil
	if state.autoQuests then
		state.questForceFastRecheckUntil = tick() + 20
	end

	resetEatingSearch(character:GetAttribute("Food"))

	state.oxygenGuardApply(character)
	state.staminaGuardApply(character)
	mmbTaskDefer(DAMAGE.bind, character)
	mmbTaskDefer(function()
		task.wait(0.35)
		if character ~= player.Character then return end
		state.oxygenGuardApply(character)
		state.staminaGuardApply(character)
		state.releaseMovementNow(character, true)

		-- A new Character must never inherit the previous animal's temporary
		-- Underground failure/retry fallback. Otherwise the UI can still show
		-- Underground while Auto Drink silently walks to exposed water for 8-20s.
		if state.drinkTest then
			state.drinkTest.retryAfter = 0
			state.drinkTest.forceSurfaceUntil = 0
			state.drinkTest.emergencyFallback = false
		end

		if state.drinkSearch then
			state.drinkSearch.currentWaterPoint = nil
			state.drinkSearch.failedCount = 0
			state.drinkSearch.retryAfter = 0
		end

		state.drinkClearUndergroundMode()
		state.drinkProgressReset()

		if isDinoLife then
			state.autoDrinkMode = "surface"
			state.autoDrinkPreferredMode = "surface"
			state.autoQuests = false
			state.autoClaimQuests = false
			state.coinFarmAllowAutoQuests = false
			local dinoWater = workspace:FindFirstChild("MainWaterPart")
			if dinoWater and dinoWater:IsA("BasePart") then dinoWater.CanCollide = false end
		elseif state.isCrocOrHippoMovementCharacter(
			character
		) then
			-- Croc/Hippo force Surface only for the CURRENT animal. Do not overwrite
			-- the player's saved preference, so the next normal animal restores it.
			state.autoDrinkMode = "surface"
		else
			local preferred = state.autoDrinkPreferredMode
			if preferred ~= "surface" and preferred ~= "underground" then
				preferred = "underground"
				state.autoDrinkPreferredMode = preferred
			end

			-- Survive-in-Zone is an intentional temporary override and still wins
			-- across a respawn/slot change. Outside it, restore the real preference.
			local zoneOverrideActive =
				state.questZoneDrinkOverride
				and state.questZoneDrinkOverride.active

			state.autoDrinkMode =
				zoneOverrideActive
				and "underground"
				or preferred
		end

		if state.renderAutoDrinkModeButtons then pcall(state.renderAutoDrinkModeButtons) end
	end)

	mmbTaskDelay(0.65, function()
		if character ~= player.Character
			or not state.autoEat
			or state.questGrowthReset.exclusive then
			return
		end

		-- Equivalent to the useful part of an OFF/ON Auto Eat cycle, but automatic:
		-- re-evaluate the CURRENT animal's diet and acquire a fresh target.
		pcall(autoEatStep)
	end)
end))

local function forcePostDrinkMove(wasUnderground)
	if forcingPostDrinkMove then return end

	forcingPostDrinkMove = true
	criticalRecoveryActive = true

	-- Hard lock before the drinking state is released.
	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil
	if state.questSetW then
		state.questSetW(false)
	end

	state.releaseMovementNow(
		player.Character,
		true
	)

	do
		local emergencyCharacter =
			player.Character

		if emergencyCharacter
			and isSavannahLife
			and state.isGrowthHerbivore(
				emergencyCharacter
			)
			and not isGiraffeCharacter(
				emergencyCharacter
			)
			and not isBaboonCharacter(
				emergencyCharacter
			)
			and not isCarnivoreCharacter(
				emergencyCharacter
			) then

			local emergencyFood =
				tonumber(
					emergencyCharacter:GetAttribute(
						"Food"
					)
				) or 100

			local emergencyWater =
				tonumber(
					emergencyCharacter:GetAttribute(
						"Water"
					)
				) or 100

			if state.survivalFoodEmergency(
				emergencyFood,
				emergencyWater
			) then

				-- IMPORTANT: transfer the lock; do not leave two recovery owners.
				forcingPostDrinkMove = false
				criticalRecoveryActive = false

				state.forceStopActiveDrink(
					emergencyCharacter,
					"CRITICAL FOOD: post-drink exit handed to central Food watchdog"
				)

				mmbTaskDefer(function()
					task.wait(0.03)

					state.startHerbivoreFoodRecovery(
						"critical_food_post_drink_handoff"
					)
				end)

				return
			end
		end
	end

	runtimeMessage = wasUnderground
		and "Agua cheia; SAINDO de baixo do Terrain antes de liberar Auto Run"
		or "Agua cheia; saindo da agua antes de liberar quests"

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	local aquaticExit = isAquaticCharacter(player.Character)
	if waterPart and waterPart:IsA("BasePart") then
		local crocHippo =
			player.Character
			and state.isCrocOrHippoMovementCharacter(
				player.Character
			)

		local exitActive =
			crocHippo
			and state.aquaticRiverEscape
			and (
				state.aquaticRiverEscape.busy
					or state.aquaticRiverEscape.survivalSuspended
			)

		if isDinoLife then
			waterPart.CanCollide = false
		elseif exitActive then
			waterPart.CanCollide =
				false
		elseif crocHippo then
			waterPart.CanCollide =
				true
		else
			waterPart.CanCollide =
				aquaticExit == true
		end
	end

	local function confirmedOutside()
		local character, root = characterParts()
		if not character or not root then return false end

		-- Crocodile/Hippo use their OWN strict river-exit proof.
		-- The generic dry-ground test can see the solid river bottom and falsely
		-- conclude that the animal is already outside the water.
		if state.isCrocOrHippoMovementCharacter(
			character
		) then
			if type(
				state.aquaticFlyDryGroundReached
			) ~= "function" then
				return false
			end

			return state.aquaticFlyDryGroundReached(
				character,
				root
			)
		end

		if state.nonAquaticDryBankConfirmed(character, root) then
			return true
		end

		if state.isBodyActuallyInWater(
			character,
			root
		) then
			return false
		end

		return state.normalizeDryLandState(
			character,
			root
		)
	end

	-- If the animal already reached dry ground through normal physics,
	-- stop the water-exit controller immediately.
	if confirmedOutside() then
		state.drinkClearUndergroundMode()
		resetEatingSearch(nil)
		drinkingSourcePosition = nil

		local dryCharacter =
			player.Character

		if dryCharacter
			and isAquaticCharacter(
				dryCharacter
			) then

			setAquaticWaterCollision(
				dryCharacter,
				false
			)
		end

		state.releaseMovementNow(
			dryCharacter,
			true
		)

		criticalRecoveryActive = false
		forcingPostDrinkMove = false
		state.questForceFastRecheckUntil =
			tick() + 25

		local currentWater =
			dryCharacter
			and tonumber(
				dryCharacter:GetAttribute(
					"Water"
				)
			)
			or 100

		if dryCharacter
			and state.autoDrink
			and currentWater <= 75
			and state.survivalForceWaterHandoff(
				dryCharacter,
				"Water Fly completed while still thirsty"
			) then

			drinkingToFull = true
			runtimeMessage =
				"Water Fly complete; Auto Drink resumed"
		else
			runtimeMessage =
				"Dry Terrain + body outside water confirmed; quests resumed"
		end

		return
	end

	local escaped = false

	-- Dino Life now shares Savannah's proven exposed-water exit semantics. The
	-- old NestRock relocation is reserved for a genuine void only; a dog standing
	-- on the bank must simply be released to Auto Eat instead of crossing the map.
	if isDinoLife then
		local _, dinoRoot = characterParts()
		if dinoRoot and dinoRoot.Position.Y < config.dangerY then
			escaped = escapeDinoToSafety("void depois de beber")
		end
	end

		local aquaticCharacter, aquaticRoot = characterParts()
		local crocHippo =
			aquaticCharacter
			and state.isCrocOrHippoMovementCharacter(
				aquaticCharacter
			)

		if aquaticCharacter
			and aquaticRoot
			and (
				isAquaticCharacter(
					aquaticCharacter
				)
				or crocHippo
			) then

			runtimeMessage =
				crocHippo
					and (
						CROC.isCharacter(
							aquaticCharacter
						)
							and "Croc water exit: aquatic Fly owns recovery"
							or "Hippo water exit: aquatic Fly owns recovery"
					)
					or "Aquatic exit: finding verified dry Terrain"

			escaped =
				state.moveAquaticToDryTerrain(
					aquaticCharacter,
					aquaticRoot
				)
		end

		-- Croc/Hippo NEVER use generic dry-bank/spawn recovery. If Fly did not
		-- finish yet, keep the transaction pending and let the aquatic cooldown
		-- retry it instead of mistaking the solid river bottom for dry land.
		if crocHippo and not escaped then
			local waterPart =
				workspace:FindFirstChild(
					"MainWaterPart"
				)

			if waterPart
				and waterPart:IsA(
					"BasePart"
				)
				and state.mainWaterDryBankReached(
					aquaticCharacter,
					aquaticRoot,
					waterPart
				) then

				state.aquaticRiverEscape.busy =
					false

				state.aquaticRiverEscape.retryAt =
					0

				state.aquaticSurvivalResume(
					aquaticCharacter
				)

				resetEatingSearch(nil)
				drinkingSourcePosition = nil
				forcingPostDrinkMove = false
				criticalRecoveryActive = false

				runtimeMessage =
					"Dry bank confirmed after Fly; Auto Eat + Auto Drink restored"

				return
			end

			resetEatingSearch(nil)
			drinkingSourcePosition = nil
			forcingPostDrinkMove = false
			criticalRecoveryActive = false

			runtimeMessage =
				CROC.isCharacter(
					aquaticCharacter
				)
					and "Croc aquatic Fly pending; waiting for nearby bank"
					or "Hippo aquatic Fly pending; waiting for nearby bank"

			return
		end

		if not escaped then refreshCompletionSpawns() end

		local candidates = {}
		local _, root = characterParts()

		-- Nearest dry bank first. Do not march to a distant spawn when the
		-- shoreline is physically reachable right beside the animal.
		if root then
			local localExit =
				state.findNearestDryWaterExit(root)

			if localExit then
				table.insert(
					candidates,
					localExit
				)
			end
		end

		-- Never inherit a manual Move To destination during automatic safety exit.

		if root then
			for _, part in ipairs(
				DAMAGE.getNearestSafeSpawns(
					root,
					DAMAGE.maxEmergencySpawnDistance
				)
			) do
				table.insert(candidates, part.Position)
			end
		end

		for _, position in ipairs(candidates) do
			if escaped then break end
			if ensureOnSolidGround(
				position,
				wasUnderground
					and "terra firme ACIMA do Terrain"
					or "ponto de saida da agua"
			) then
				escaped = true
				break
			end
		end

	resetEatingSearch(nil)
	drinkingSourcePosition = nil

	-- Final independent proof. Reaching a target is not enough.
	if escaped and confirmedOutside() then
		state.drinkClearUndergroundMode()
		local dryCharacter = player.Character
		if dryCharacter and isAquaticCharacter(dryCharacter) then setAquaticWaterCollision(dryCharacter, false) end
		state.releaseMovementNow(dryCharacter, true)

		criticalRecoveryActive = false
		forcingPostDrinkMove = false
		state.questForceFastRecheckUntil = tick() + 25

		local currentWater =
			dryCharacter
			and tonumber(
				dryCharacter:GetAttribute(
					"Water"
				)
			)
			or 100

		if dryCharacter
			and state.autoDrink
			and currentWater <= 75
			and state.survivalForceWaterHandoff(
				dryCharacter,
				"Water Fly completed while still thirsty"
			) then

			drinkingToFull = true
			runtimeMessage =
				"Water Fly complete; Auto Drink resumed"
		else
			runtimeMessage = wasUnderground
				and "Saiu do Terrain CONFIRMADO; Auto Run liberado"
				or "Saiu da agua; quests liberadas"
		end

		return
	end

	-- One last strict dry-ground proof before escalating.
	if confirmedOutside() then
		state.drinkClearUndergroundMode()
		local dryCharacter = player.Character
		if dryCharacter and isAquaticCharacter(dryCharacter) then setAquaticWaterCollision(dryCharacter, false) end
		state.releaseMovementNow(dryCharacter, true)
		criticalRecoveryActive = false
		forcingPostDrinkMove = false
		state.questForceFastRecheckUntil =
			tick() + 25

		local currentWater =
			dryCharacter
			and tonumber(
				dryCharacter:GetAttribute(
					"Water"
				)
			)
			or 100

		if dryCharacter
			and state.autoDrink
			and currentWater <= 75
			and state.survivalForceWaterHandoff(
				dryCharacter,
				"Water Fly completed while still thirsty"
			) then

			drinkingToFull = true
			runtimeMessage =
				"Water Fly complete; Auto Drink resumed"
		else
			runtimeMessage =
				"Body outside water + dry Terrain confirmed; quests resumed"
		end

		return
	end

	forcingPostDrinkMove = false

	local liveCharacter, liveRoot = characterParts()
	state.releaseMovementNow(liveCharacter, true)
	if liveCharacter and isAquaticCharacter(liveCharacter) then
		setAquaticWaterCollision(liveCharacter, true)
	end

	if liveCharacter and liveRoot then
		state.drinkEmergencyEscape(
			liveCharacter,
			liveRoot,
			"Post-drink still unsafe after strict ground check"
		)
	else
		criticalRecoveryActive = false
	end
end

-- Expose the shared post-drink extractor to workers declared earlier in this
-- file. More importantly, give Dino a single-flight self-healing entry point:
-- Food may observe a high-Water Rex still inside the river after a Drink worker
-- was cancelled/released, but Food itself must never try to solve that topology.
state.forcePostDrinkMove = forcePostDrinkMove
state.dinoPostDrinkExit = state.dinoPostDrinkExit or {
	active = false,
	character = nil,
	token = 0,
	startedAt = 0,
	retryAfter = 0,
	reason = nil,
}

function state.requestDinoPostDrinkDryExit(character, reason)
	if not isDinoLife
		or not character
		or character ~= player.Character then
		return false
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then return false end
	if not state.dinoPostDrinkDryExitRequired(character, root) then return false end

	local controller = state.dinoPostDrinkExit
	local now = tick()
	if controller.active or forcingPostDrinkMove then return true end
	if now < (controller.retryAfter or 0) then return true end

	controller.token += 1
	local token = controller.token
	controller.active = true
	controller.character = character
	controller.startedAt = now
	controller.reason = tostring(reason or "Dino post-drink dry-bank handoff")

	-- This is no longer a Food or Water route. Tear down ONLY stale physical
	-- owners before Safety starts, while preserving the user's automation toggles.
	state.carcassController.cancelRequested = true
	state.carcassController.token += 1
	carcassEatBusy = false
	clearActiveCarcass(true)
	eatingToFull = false
	eatingSourcePosition = nil
	eatingTargetReachedAt = nil
	eatingStuckSince = nil
	drinkingToFull = false
	drinkingSourcePosition = nil
	drinkingStuckSince = nil
	state.drinkProgressReset()
	state.carcassWaterTransitReset()

	if state.survivalArbiterReset then
		state.survivalArbiterReset("Dino post-drink Safety owns dry-bank exit")
	end

	local ai = state.MMBAI
	local manager = ai and ai.MovementManager
	if manager and type(manager.ActualOwners) == "function" then
		local ok, owners = pcall(manager.ActualOwners, manager, ai.Blackboard)
		if ok and type(owners) == "table" then
			local seen = {}
			for _, entry in ipairs(owners) do
				local owner = entry and entry.owner
				if owner and owner ~= "Safety" and not seen[owner] then
					seen[owner] = true
					pcall(manager.CancelOwner, manager, owner, "Dino post-drink dry-bank handoff", true)
				end
			end
		end
	end

	if state.safeMove and state.safeMove.active
		and state.safeMove.reason ~= "safety" then
		state.safeMove.cancelToken += 1
		state.safeMove.active = false
		state.safeMove.target = nil
		state.safeMove.reason = nil
		state.safeMove.manualLabel = nil
	end

	state.busy = false
	criticalRecoveryActive = true

	if state.aiSupervisorSignal then
		pcall(
			state.aiSupervisorSignal,
			"DinoPostDrinkDryExit",
			"Safety",
			controller.reason,
			1000,
			6
		)
	end

	runtimeMessage = "DINO POST-DRINK SAFETY: dry bank owns movement; Food paused"

	task.spawn(function()
		local ok = pcall(forcePostDrinkMove, false)

		if controller.token ~= token then return end
		controller.active = false
		controller.character = nil
		controller.reason = nil

		local liveCharacter, liveRoot = characterParts()
		local stillWet = liveCharacter == character
			and liveRoot
			and state.dinoPostDrinkDryExitRequired(liveCharacter, liveRoot)

		if stillWet then
			-- A failed/partial extractor must not leave its own legacy latches set.
			-- The next 0.4s no-idle pass is then free to launch one clean retry.
			forcingPostDrinkMove = false
			if not DAMAGE.active
				and not (state.drinkTest and state.drinkTest.active)
				and not (state.dinoShorelineRecovery and state.dinoShorelineRecovery.active)
				and not (state.dinoRockEmergency and state.dinoRockEmergency.supervisorActive) then
				criticalRecoveryActive = false
			end
			controller.retryAfter = tick() + 0.35
			runtimeMessage = ok
				and "DINO POST-DRINK SAFETY: exit incomplete; retrying dry bank"
				or "DINO POST-DRINK SAFETY: exit worker errored; retrying"
			return
		end

		controller.retryAfter = 0
		if not DAMAGE.active then
			criticalRecoveryActive = false
		end
		if ai and ai.WatchdogManager
			and type(ai.WatchdogManager.ResetModuleProbe) == "function" then
			pcall(ai.WatchdogManager.ResetModuleProbe, ai.WatchdogManager, "Movement", tick())
			pcall(ai.WatchdogManager.ResetModuleProbe, ai.WatchdogManager, "AutoEat", tick())
			pcall(ai.WatchdogManager.ResetModuleProbe, ai.WatchdogManager, "Safety", tick())
		end

		if state.autoEat then
			mmbTaskDefer(function()
				task.wait(0.06)
				pcall(autoEatStep)
			end)
		end
	end)

	return true
end

state.dinoShorelineRecovery =
	state.dinoShorelineRecovery
	or {
		active = false,
		deadlocked = false,
		token = 0,
		character = nil,
		target = nil,
		savedCarcass = nil,
		probeCharacter = nil,
		probeTarget = nil,
		probePosition = nil,
		probeDistance = math.huge,
		probeFood = nil,
		probeProgressAt = 0,
	}

function state.dinoShorelineResetProbe()
	local data = state.dinoShorelineRecovery
	data.deadlocked = false
	data.probeCharacter = nil
	data.probeTarget = nil
	data.probePosition = nil
	data.probeDistance = math.huge
	data.probeFood = nil
	data.probeProgressAt = 0
end

function state.dinoShorelineWaterProof(character, root)
	if not isDinoLife
		or not character
		or not root
		or isAquaticCharacter(character) then
		return false
	end

	if state.isBodyActuallyInWater(character, root) then
		return true
	end

	if state.drinkGamePromptAvailable(character) then
		return true
	end

	return state.drinkVisualPromptVisible()
end

function state.dinoShorelineFoodOwnerActive()
	return activeCarcass ~= nil
		or carcassEatBusy
		or (state.safeMove and state.safeMove.active and state.safeMove.reason == "food")
		or (state.survivalArbiter and state.survivalArbiter.owner == "food")
end

function state.dinoShorelineFoodDeadlockProbe(character, root)
	local data = state.dinoShorelineRecovery

	if not isDinoLife
		or data.active
		or (
			state.drinkTransactionProtected
			and state.drinkTransactionProtected(
				character
			)
		)
		or not character
		or not root
		or isAquaticCharacter(character)
		or state.intentionalWaterTransitActive(character, root)
		or not state.dinoShorelineWaterProof(character, root)
		or not state.dinoShorelineFoodOwnerActive()
		or state.carcassEatPromptReady(character) then
		state.dinoShorelineResetProbe()
		return false
	end

	local carcass = activeCarcass
	local carcassRoot = carcass and carcass.Parent
		and (carcass:FindFirstChild("HumanoidRootPart") or carcass:FindFirstChildWhichIsA("BasePart", true))
		or nil
	local target = carcassRoot and carcassRoot.Position
		or (state.safeMove and state.safeMove.reason == "food" and state.safeMove.target)
		or nil
	local distance = typeof(target) == "Vector3"
		and Vector3.new(target.X-root.Position.X,0,target.Z-root.Position.Z).Magnitude
		or math.huge
	local food = tonumber(character:GetAttribute("Food")) or 100
	local now = tick()
	local targetChanged = data.probeTarget == nil and target ~= nil
		or target == nil and data.probeTarget ~= nil
		or (typeof(target)=="Vector3" and typeof(data.probeTarget)=="Vector3" and (target-data.probeTarget).Magnitude > 4)

	if data.probeCharacter ~= character or not data.probePosition or targetChanged then
		data.probeCharacter = character
		data.probeTarget = target
		data.probePosition = root.Position
		data.probeDistance = distance
		data.probeFood = food
		data.probeProgressAt = now
		data.deadlocked = false
		return false
	end

	local displacement = Vector3.new(
		root.Position.X-data.probePosition.X,
		0,
		root.Position.Z-data.probePosition.Z
	).Magnitude
	local targetProgress = distance < (data.probeDistance or math.huge) - 0.85
	local foodProgress = data.probeFood and food > data.probeFood + 0.01

	if displacement >= 1.35 or targetProgress or foodProgress then
		data.probeTarget = target
		data.probePosition = root.Position
		data.probeDistance = distance
		data.probeFood = food
		data.probeProgressAt = now
		data.deadlocked = false
		return false
	end

	if distance < (data.probeDistance or math.huge) then data.probeDistance = distance end
	data.probeFood = food

	local water = tonumber(character:GetAttribute("Water")) or 100
	local timeout = food <= 25 and 0.90 or water >= 95 and 1.65 or water >= 85 and 2.20 or 3.00
	data.deadlocked = now - (data.probeProgressAt or now) >= timeout
	return data.deadlocked
end

function state.dinoShorelineNoclipToDry(character, root, humanoid, target)
	if not character or not root or not humanoid or typeof(target) ~= "Vector3" then return false end
	local snapshot = {}
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			snapshot[#snapshot+1] = {part=part, canCollide=part.CanCollide}
			part.CanCollide = false
		end
	end
	local oldAutoRotate = humanoid.AutoRotate
	local oldPlatformStand = humanoid.PlatformStand
	local oldMovementDisabled = character:GetAttribute("MovementDisabled")
	humanoid.AutoRotate = false
	humanoid.PlatformStand = true
	character:SetAttribute("MovementDisabled", true)

	local start = root.Position
	local planar = Vector3.new(target.X-start.X,0,target.Z-start.Z)
	local facing = planar.Magnitude > 0.05 and planar.Unit or Vector3.new(0,0,-1)
	local cruiseY = math.max(start.Y,target.Y)+7
	local rise = Vector3.new(start.X,cruiseY,start.Z)
	local cross = Vector3.new(target.X,cruiseY,target.Z)

	local function phase(a,b,duration)
		local started=tick()
		while state.alive and character==player.Character and root.Parent and tick()-started<duration do
			local alpha=math.clamp((tick()-started)/math.max(duration,0.01),0,1)
			local pos=a:Lerp(b,alpha)
			for _, rec in ipairs(snapshot) do if rec.part and rec.part.Parent then rec.part.CanCollide=false end end
			character:PivotTo(CFrame.lookAt(pos,pos+facing))
			root.AssemblyLinearVelocity=Vector3.zero
			root.AssemblyAngularVelocity=Vector3.zero
			RunService.Heartbeat:Wait()
		end
		character:PivotTo(CFrame.lookAt(b,b+facing))
	end

	phase(start,rise,0.15)
	phase(rise,cross,math.clamp(planar.Magnitude/95,0.18,0.72))
	phase(cross,target,0.20)

	for _, rec in ipairs(snapshot) do if rec.part and rec.part.Parent then rec.part.CanCollide=rec.canCollide==true end end
	humanoid.PlatformStand = oldPlatformStand == true
	humanoid.AutoRotate = oldAutoRotate ~= false
	humanoid.Sit = false
	if not humanoid.PlatformStand then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
	if oldMovementDisabled == nil then character:SetAttribute("MovementDisabled",false) else character:SetAttribute("MovementDisabled",oldMovementDisabled) end
	root.AssemblyLinearVelocity=Vector3.zero
	root.AssemblyAngularVelocity=Vector3.zero
	task.wait(0.12)
	return state.nonAquaticDryBankConfirmed(character,root) and not state.isBodyActuallyInWater(character,root)
end

function state.startDinoShorelineFoodRecovery(reason)
	if not isDinoLife then return false end
	local data=state.dinoShorelineRecovery
	if data.active then return true end
	local character,root,humanoid=characterParts()
	if not character or not root or not humanoid or humanoid.Health<=0
		or (
			state.drinkTransactionProtected
			and state.drinkTransactionProtected(
				character
			)
		)
		or isAquaticCharacter(character)
		or state.intentionalWaterTransitActive(character,root)
		or not state.dinoShorelineWaterProof(character,root)
		or not state.dinoShorelineFoodOwnerActive()
		or state.carcassEatPromptReady(character) then return false end

	if not state.aiSupervisorPermitController(
		"Safety",
		"DinoShorelineRecovery",
		reason or "Dino shoreline deadlock",
		1000
	) then
		return false
	end

	data.token += 1
	local token=data.token
	data.active=true
	data.deadlocked=true
	data.character=character
	data.savedCarcass=activeCarcass

	state.carcassController=state.carcassController or {token=0,cancelRequested=false}
	state.carcassController.cancelRequested=true
	state.carcassController.token += 1
	carcassEatBusy=false
	clearActiveCarcass(true)
	eatingToFull=false
	eatingSourcePosition=nil
	eatingTargetReachedAt=nil
	eatingStuckSince=nil

	if state.requestAllMovementCancellation then
		state.requestAllMovementCancellation("Dino shoreline Food deadlock -> Safety","Safety")
	elseif state.safeMove and state.safeMove.active then
		state.safeMove.cancelToken += 1
	end
	if state.safeMove and state.safeMove.active and state.safeMove.reason=="food" then state.safeMove.cancelToken += 1 end
	state.busy=false
	if state.survivalArbiterReset then state.survivalArbiterReset("Dino shoreline Food deadlock") end
	if state.forceStopActiveDrink then state.forceStopActiveDrink(character,"DINO SHORELINE SAFETY: leaving water before Food") end
	runtimeMessage="DINO SHORELINE SAFETY ONLY: carcass cancelled; dry bank owns movement"

	task.spawn(function()
		local completed=false
		for attempt=1,2 do
			if not state.alive or not data.active or data.token~=token then break end
			local liveCharacter,liveRoot,liveHumanoid=characterParts()
			if liveCharacter~=character or not liveRoot or not liveHumanoid or liveHumanoid.Health<=0 then break end
			if state.nonAquaticDryBankConfirmed(character,liveRoot) and not state.isBodyActuallyInWater(character,liveRoot) then completed=true break end
			local target=state.findNearestDryWaterExit(liveRoot)
			data.target=target
			if typeof(target)~="Vector3" then break end
			runtimeMessage=string.format("DINO SHORELINE SAFETY ONLY: dry-bank exit %d/2",attempt)
			state.busy=false
			safeMoveToPosition(target,3,nil,{purpose="safety",tolerance=7,speedScale=0.95,constantSpeed=false,forceMoveToLand=true,stopOnDryGround=true,maxDuration=4.5})
			liveCharacter,liveRoot,liveHumanoid=characterParts()
			if liveCharacter~=character or not liveRoot or not liveHumanoid then break end
			if state.nonAquaticDryBankConfirmed(character,liveRoot) and not state.isBodyActuallyInWater(character,liveRoot) then completed=true break end
			runtimeMessage="DINO SHORELINE SAFETY: normal exit stalled -> emergency NOCLIP"
			completed=state.dinoShorelineNoclipToDry(character,liveRoot,liveHumanoid,target)
			if completed then break end
		end

		if not completed and data.active and data.token==token then
			local liveCharacter,liveRoot,liveHumanoid=characterParts()
			if liveCharacter==character and liveRoot and liveHumanoid then
				local openTarget=state.dinoRockEmergencyFindSafePoint(character,liveRoot,liveHumanoid)
				if typeof(openTarget)=="Vector3" then
					runtimeMessage="DINO SHORELINE SAFETY: bank failed -> open-ground NOCLIP"
					completed=state.dinoShorelineNoclipToDry(character,liveRoot,liveHumanoid,openTarget)
				end
			end
		end

		if data.token~=token then return end
		data.active=false
		data.character=nil
		data.target=nil
		state.busy=false

		if completed then
			local savedCarcass=data.savedCarcass
			data.savedCarcass=nil
			state.dinoShorelineResetProbe()
			local liveCharacter,liveRoot=characterParts()
			if savedCarcass and savedCarcass.Parent and liveCharacter and liveRoot then
				local savedRoot=savedCarcass:FindFirstChild("HumanoidRootPart") or savedCarcass:FindFirstChildWhichIsA("BasePart",true)
				if savedRoot and state.carcassCandidateUsable(savedCarcass,savedRoot,liveCharacter) then
					activeCarcass=savedCarcass
					activeCarcassCommitted=false
				end
			end
			if state.survivalArbiterReset then state.survivalArbiterReset("Dino shoreline dry bank confirmed") end
			local ai=state.MMBAI
			if ai and ai.ModuleRegistry and type(ai.ModuleRegistry.ResetRuntime)=="function" then
				pcall(ai.ModuleRegistry.ResetRuntime,ai.ModuleRegistry,"Movement","shoreline topology changed")
				pcall(ai.ModuleRegistry.ResetRuntime,ai.ModuleRegistry,"AutoEat","shoreline topology changed")
				pcall(ai.ModuleRegistry.ResetRuntime,ai.ModuleRegistry,"Safety","shoreline recovery completed")
			end
			runtimeMessage=activeCarcass and "DINO SHORELINE SAFETY: DRY BANK confirmed; resuming carcass" or "DINO SHORELINE SAFETY: DRY BANK confirmed; Food released"
		else
			data.savedCarcass=nil
			data.deadlocked=true
			data.probeProgressAt=tick()-5
			runtimeMessage="DINO SHORELINE SAFETY: extraction failed; Safety stays armed"
		end
	end)
	return true
end

task.spawn(function()
	while state.alive do
		pcall(function()
			if not isDinoLife or state.dinoShorelineRecovery.active then return end
			local character,root,humanoid=characterParts()
			if not character or not root or not humanoid or humanoid.Health<=0 then state.dinoShorelineResetProbe() return end
			if state.dinoShorelineFoodDeadlockProbe(character,root) then
				state.startDinoShorelineFoodRecovery("central invariant: Food stalled at Dino shoreline")
			end
		end)
		task.wait(0.30)
	end
end)

state.drinkTransactionGuard =
	state.drinkTransactionGuard
	or {
		character = nil,
		firstEvidenceAt = 0,
		lastProtectedAt = 0,
		lastWater = nil,
	}

function state.drinkTransactionGuardReset()
	local guard =
		state.drinkTransactionGuard

	guard.character = nil
	guard.firstEvidenceAt = 0
	guard.lastProtectedAt = 0
	guard.lastWater = nil
end

-- v5.3: Underground Drink owns the intentional Terrain crossing from the first
-- prepare frame until the surface exit is fully confirmed. Small rigs such as
-- WildDog can satisfy the generic "buried" geometry test during the intended
-- descent, so Terrain Safety must not preempt this Water-owned transaction.
function state.undergroundDrinkTerrainProtected(character)
	local test = state.drinkTest
	if not isSavannahLife
		or character == nil
		or character ~= player.Character then
		return false
	end

	if test ~= nil
		and test.active == true
		and test.character == character then
		return true
	end

	-- v5.5: keep Terrain protection through the legacy sustain/phase handoff.
	-- Small rigs can already be below Terrain during this tiny window.
	return state.autoDrink == true
		and state.autoDrinkMode == "underground"
		and state.drinkSearch ~= nil
		and state.drinkSearch.undergroundMode == true
		and drinkingToFull == true
		and not (test and test.hardExitBusy == true)
end

function state.drinkTransactionProtected(character)
	if not character
		or character ~= player.Character then

		state.drinkTransactionGuardReset()
		return false
	end

	-- Underground Drink is itself a verified Water transaction. It intentionally
	-- crosses Terrain and can overlap MainWaterPart, including the small sustain
	-- handoff where drinkTest may have changed phase but the body is still buried.
	if state.undergroundDrinkTerrainProtected
		and state.undergroundDrinkTerrainProtected(character) then
		return true
	end

	if not drinkingToFull then
		state.drinkTransactionGuardReset()
		return false
	end

	local water =
		tonumber(
			character:GetAttribute(
				"Water"
			)
		) or 100

	local food =
		tonumber(
			character:GetAttribute(
				"Food"
			)
		) or 100

	local target =
		state.questTravelRefillWaterTarget()

	-- Once the requested amount was reached, Water must release control so a
	-- terrestrial animal can leave the shoreline normally.
	if water >= target then
		state.drinkTransactionGuardReset()
		return false
	end

	-- Existing starvation policy remains authoritative. Drinking may NOT protect
	-- itself while Food is at emergency level and Water is already safe enough.
	if state.survivalFoodEmergency
		and state.survivalFoodEmergency(
			food,
			water
		) then

		state.drinkTransactionGuardReset()
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if humanoid
		and humanoid.MaxHealth > 0
		and humanoid.Health
			/ humanoid.MaxHealth <= 0.35 then

		return false
	end

	if DAMAGE.active then
		return false
	end

	if state.dinoRockEmergency
		and state.dinoRockEmergency.supervisorActive then

		return false
	end

	if state.drinkTest
		and state.drinkTest.hardExitBusy then

		return false
	end

	local guard =
		state.drinkTransactionGuard

	local now =
		tick()

	if guard.character ~= character then
		guard.character = character
		guard.firstEvidenceAt = 0
		guard.lastProtectedAt = 0
		guard.lastWater = water
	end

	local progress =
		state.drinkProgress

	-- Once Water actually increased, that is the strongest proof possible.
	-- Protect for slightly less than the existing 5-second Drink stall timeout.
	-- If Water stops increasing for that long, Safety is allowed to recover.
	if progress
		and progress.confirmed
		and (
			now
				- (
					progress.lastProgressAt
						or 0
				)
		) <= 4.75 then

		guard.lastProtectedAt =
			now

		guard.lastWater =
			water

		return true
	end

	-- Before the first Water tick, the Supervisor consumes ONLY evidence already
	-- produced by the Drink worker. It must never call GameUtils or scan PlayerGui
	-- from Authority/Election code; those calls can happen dozens of times/sec.
	local promptStopAt =
		state.drinkSearch
		and tonumber(
			state.drinkSearch.promptStopTime
		)
		or 0

	local promptEvidence =
		(
			state.drinkPromptHoldActive
			and state.drinkPromptHoldActive()
		)
		or (
			state.drinkVisualPrompt
			and state.drinkVisualPrompt.visible == true
			and now - (state.drinkVisualPrompt.at or 0) <= 0.35
		)
		or (
			promptStopAt > 0
			and now - promptStopAt <= 1.50
		)

	if not promptEvidence then
		guard.firstEvidenceAt = 0
		return false
	end

	if guard.firstEvidenceAt <= 0 then
		guard.firstEvidenceAt =
			now
	end

	local protected =
		now - guard.firstEvidenceAt
			<= 2.75

	if protected then
		guard.lastProtectedAt =
			now
	end

	return protected
end

function state.aiSupervisorReleaseWaterSafetyForDrink(
	character
)
	if not character
		or character ~= player.Character
		or not state.drinkTransactionProtected(
			character
		) then

		return false
	end

	-- A shoreline recovery created before the first Water tick is now stale.
	-- Drinking is making REAL progress, so cancel that executor instead of
	-- allowing it to physically pull the animal out of its Drink interaction.
	local shoreline =
		state.dinoShorelineRecovery

	if shoreline
		and shoreline.active then

		shoreline.token =
			(shoreline.token or 0) + 1

		shoreline.active = false
		shoreline.deadlocked = false
		shoreline.character = nil
		shoreline.target = nil
		shoreline.savedCarcass = nil
	end

	if state.dinoShorelineResetProbe then
		pcall(
			state.dinoShorelineResetProbe
		)
	end

	local ai =
		state.MMBAI

	local authority =
		ai
		and ai.Authority

	if authority then
		-- Water/shoreline watchdog signals are observations from the OLD state.
		-- A real Water increase invalidates them immediately.
		for key, signal in pairs(
			authority.signals or {}
		) do
			local name =
				tostring(
					signal.name
						or key
				):lower()

			local reason =
				tostring(
					signal.reason
						or ""
				):lower()

			local waterRelated =
				name:find(
					"water",
					1,
					true
				)
				or name:find(
					"shoreline",
					1,
					true
				)
				or name:find(
					"drink",
					1,
					true
				)
				or reason:find(
					"water",
					1,
					true
				)
				or reason:find(
					"shoreline",
					1,
					true
				)
				or reason:find(
					"drink",
					1,
					true
				)

			if signal.owner == "Safety"
				and waterRelated then

				authority.signals[key] =
					nil
			end
		end

		local authorityReason =
			tostring(
				authority.currentReason
					or ""
			):lower()

		local waterSafetyOwner =
			authority.currentOwner == "Safety"
			and (
				authorityReason:find(
					"water",
					1,
					true
				)
				or authorityReason:find(
					"shoreline",
					1,
					true
				)
				or authorityReason:find(
					"drink",
					1,
					true
				)
			)

		if waterSafetyOwner then
			authority.currentOwner =
				"Water"

			authority.currentController =
				"DrinkTransaction"

			authority.currentReason =
				"confirmed Drink transaction"

			authority.currentScore =
				10850

			authority.currentSince =
				tick()

			authority.exclusive =
				true

			authority.controllerLeaseUntil =
				tick() + 2.5

			authority.epoch =
				(authority.epoch or 0) + 1
		end
	end

	-- Cancel ONLY a stale Safety route. Real rock/void/damage Safety is excluded
	-- by drinkTransactionProtected() above.
	if state.safeMove
		and state.safeMove.active
		and state.safeMove.reason == "safety" then

		state.safeMove.cancelToken += 1
	end

	state.busy = false

	return true
end

function state.noIdleWaterSafetyStep()
	local drinkCharacter =
		player.Character

	if drinkCharacter
		and state.drinkTransactionProtected(
			drinkCharacter
		) then

		return
	end

	if state.herbivoreFoodRecovery
		and state.herbivoreFoodRecovery.active
		and state.herbivoreFoodRecovery.character
			== player.Character then

		return
	end

	if state.slotParkingAudit and state.slotParkingAudit.active then return end
	if state.dinoShorelineRecovery and state.dinoShorelineRecovery.active then return end

	if not state.alive
		or state.questGrowthReset.exclusive
		or state.questSwimActive
		or drinkingToFull
		or DAMAGE.active then
		return
	end

	local character, root, humanoid =
		characterParts()

	if not character
		or not root
		or not humanoid
		or humanoid.Health <= 0 then
		return
	end

	-- High-Water Dino post-drink exit is a dedicated Safety transaction and must
	-- run BEFORE the generic busy gate. Previously a stale Food/Water busy flag
	-- made this function return forever while Auto Eat kept printing that it was
	-- waiting for dry ground.
	if isDinoLife
		and state.dinoPostDrinkDryExitRequired(character, root) then
		state.requestDinoPostDrinkDryExit(
			character,
			"no-idle watchdog found Rex still in water after Drink"
		)
		return
	end

	-- For every other case, preserve the original protected-recovery gate.
	if forcingPostDrinkMove or criticalRecoveryActive then return end

	if state.dinoShorelineFoodDeadlockProbe(character,root) then
		state.startDinoShorelineFoodRecovery("water safety: Food-owned shoreline deadlock")
		return
	end

	if state.busy then return end

	-- Ordinary land animals can keep a stale Swimming state / body overlap for a
	-- few frames at the shoreline. Solid Terrain directly under HRP means the
	-- water-exit watchdog is DONE; never launch the expensive escape scanner.
	if state.nonAquaticDryBankConfirmed(character, root) then
		return
	end

	-- Dino Manual Move To may deliberately cross an exposed river.
	-- Do not turn a valid crossing into a "return to dry bank" loop.
	if state.intentionalWaterTransitActive(
		character,
		root
	) then
		return
	end

	-- A terrestrial Savannah carnivore may deliberately swim across a river to a
	-- dry locked carcass. Do NOT bounce it back to the nearest bank while its
	-- distance to that carcass is still decreasing. Once progress stalls for the
	-- grace window, the helper returns false and the normal safety escape resumes.
	if not isAquaticCharacter(character)
		and state.carcassIntentionalWaterTransitActive
		and state.carcassIntentionalWaterTransitActive(character, root) then
		return
	end

	-- Crocodile AND Hippo use the same verified dry-Terrain extraction used
	-- after drinking. Other aquatic animals may remain in water normally.
	if isAquaticCharacter(character)
		and not state.isCrocOrHippoMovementCharacter(
			character
		) then

		return
	end

	if state.isCrocOrHippoMovementCharacter(
		character
	) then
		local controller =
			state.aquaticRiverEscape

		local waterPart =
			workspace:FindFirstChild(
				"MainWaterPart"
			)

		if controller
			and controller.survivalSuspended
			and waterPart
			and waterPart:IsA(
				"BasePart"
			)
			and state.mainWaterDryBankReached(
				character,
				root,
				waterPart
			) then

			controller.busy = false
			controller.retryAt = 0

			state.aquaticSurvivalResume(
				character
			)

			runtimeMessage =
				"Croc/Hippo dry bank confirmed; Auto Eat + Auto Drink restored"

			return
		end

		local under =
			state.isUnderMainWaterPart(
				root
			)

		if not under
			and not (
				controller
				and controller.survivalSuspended
			) then
			return
		end
	elseif not state.isBodyActuallyInWater(
		character,
		root
	) then
		return
	end

	state.noIdleWaterLastAt =
		state.noIdleWaterLastAt or 0

	if tick() - state.noIdleWaterLastAt < 2.0 then
		return
	end

	state.noIdleWaterLastAt = tick()

	if not state.aiSupervisorPermitController(
		"Safety",
		"WaterIdleWatchdog",
		"verified animal idle/stuck inside water",
		960
	) then
		return
	end

	if state.isCrocOrHippoMovementCharacter(
		character
	)
		and state.aquaticRiverEscape
		and (
			state.aquaticRiverEscape.busy
			or tick()
				< (
					state.aquaticRiverEscape.retryAt
					or 0
				)
		) then
		return
	end

	-- Immediately clear any idle/feeding ownership that could keep the animal
	-- stationary in the puddle.
	if state.dinoPostDrinkDryExitRequired(
		character,
		root
	) then

		state.carcassController.cancelRequested =
			true

		state.carcassController.token += 1

		carcassEatBusy = false

		-- A committed target from before Drink is not allowed to keep Food
		-- ownership while the body is still in water.
		clearActiveCarcass(
			true
		)
	end

	eatingToFull = false
	eatingSourcePosition = nil
	eatingTargetReachedAt = nil
	if not activeCarcassCommitted then
		clearActiveCarcass(false)
	end
	state.questCarnivoreFeeding = false
	state.questBaboonFeeding = false
	state.questGiraffeFeeding = false
	BABOON.cancel()
	GIRAFFE.cancel()

	-- If Croc/Hippo entered water while thirsty, abandoning the feeding route
	-- must also abandon its arbiter ownership. Keep Water latched through the
	-- short Fly escape so Auto Drink resumes immediately after landing.
	local liveWater =
		tonumber(
			character:GetAttribute(
				"Water"
			)
		) or 100

	if state.autoDrink
		and liveWater <= 75
		and state.survivalForceWaterHandoff(
			character,
			"Water exit interrupted Food"
		) then

		drinkingToFull = true
	end

	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil

	if state.questSetW then
		state.questSetW(false)
	end

	runtimeMessage =
		CROC.isCharacter(character)
			and "Croc water safety: forcing verified dry Terrain exit"
			or (
				state.safeMovementAnimalKey(character) == "hippo"
					and "Hippo water safety: forcing verified dry Terrain exit"
					or "Water safety: animal is still inside water; moving to dry bank"
			)

	task.spawn(
		forcePostDrinkMove,
		false
	)
end

task.spawn(function()
	while state.alive do
		pcall(
			state.noIdleWaterSafetyStep
		)
		task.wait(0.40)
	end
end)

local drinkingStuckSince
-- Dino Life now uses the same exposed-water sustain loop as Savannah.
local lastDrinkWatchdogWater
local drinkPromptSustainBusy = false
local drinkPromptLastKickAt = 0

local function sustainDrinkAtCurrentPrompt()
	if drinkPromptSustainBusy then return end
	drinkPromptSustainBusy = true

	local lastWater
	local lastProgressAt = tick()
	local promptMissingSince

	while state.alive
		and state.autoDrink
		and drinkingToFull
		and not criticalRecoveryActive
		and not state.questGrowthReset.exclusive do

		local character, root, humanoid =
			characterParts()

		if not character
			or not root
			or not humanoid then
			break
		end

		local water =
			tonumber(
				character:GetAttribute("Water")
			) or 100

		local food =
			tonumber(
				character:GetAttribute(
					"Food"
				)
			) or 100

		if state.survivalFoodEmergency(
			food,
			water
		) then

			state.forceStopActiveDrink(
				character,
				"CRITICAL FOOD: Drinking aborted; food recovery taking priority"
			)

			if isSavannahLife
				and state.isGrowthHerbivore(
					character
				)
				and not isGiraffeCharacter(
					character
				)
				and not isBaboonCharacter(
					character
				)
				and not isCarnivoreCharacter(
					character
				) then

				state.startHerbivoreFoodRecovery(
					"critical_hunger_inside_drink_loop"
				)
			end

			break
		end

		local targetWater =
			state.questTravelRefillWaterTarget()

		if water >= targetWater then
			break
		end

		if lastWater == nil then
			lastWater = water
			lastProgressAt = tick()

		elseif water > lastWater + 0.01 then
			lastWater = water
			lastProgressAt = tick()
			drinkingStuckSince = tick()
			lastDrinkWatchdogWater = water

			state.drinkProgressConfirm(
				water
			)
		end

		local detected =
			detectAvailableFood(character)

		local visualDetected =
			state.drinkVisualPromptVisible
			and state.drinkVisualPromptVisible()

		local progressConfirmed =
			state.drinkProgress
			and state.drinkProgress.confirmed

		if detected == "Drink"
			or visualDetected
			or progressConfirmed then

			if visualDetected then
				state.drinkLatchVisualPrompt()
			end

			promptMissingSince = nil
			drinkingSourcePosition =
				drinkingSourcePosition
				or root.Position

			-- Once Water has increased, do not reposition/rotate/search.
			local velocity =
				root.AssemblyLinearVelocity

			root.AssemblyLinearVelocity =
				Vector3.new(
					0,
					math.clamp(
						velocity.Y,
						-3,
						3
					),
					0
				)

			if progressConfirmed then
				root.AssemblyAngularVelocity =
					Vector3.zero
			else
				root.AssemblyAngularVelocity =
					root.AssemblyAngularVelocity
					* 0.15
			end

			if state.questSetW then
				state.questSetW(false)
			end

			if not progressConfirmed
				and state.drinkIsUpsideDown(
					root
				) then

				state.drinkUprightCharacter(
					character,
					root,
					state.drinkSearch.currentWaterPoint
				)
			end

			if isAquaticCharacter(character) then
				setAquaticWaterCollision(
					character,
					true
				)
			end

			blockClientSubState = false
			setSubState("Drinking")
			blockClientSubState = false

			local stalledFor =
				tick() - lastProgressAt

			if progressConfirmed then
				stalledFor =
					tick()
					- (
						state.drinkProgress.lastProgressAt
						or lastProgressAt
					)
			end

			-- The server sub-state remote is sufficient. Never press E here:
			-- repeated visual toggles can cancel a valid drinking session.

			if progressConfirmed
				and stalledFor >= 5.0 then

				runtimeMessage =
					"Confirmed drink stopped for 5s; releasing source"

				state.drinkProgressReset()
				break
			end

			runtimeMessage =
				progressConfirmed
					and string.format(
						"Drinking confirmed (%d%% -> %d%%)",
						math.floor(water),
						math.floor(targetWater)
					)
					or string.format(
						"Starting drink (%d%% -> %d%%)",
						math.floor(water),
						math.floor(targetWater)
					)

		else
			if not promptMissingSince then
				promptMissingSince = tick()
			end

			-- Before Water has ever increased, the bank may really be invalid.
			if tick() - promptMissingSince >= 1.8 then
				break
			end

			setSubState("Drinking")
		end

		task.wait(0.07)
	end

	local liveCharacter = player.Character

	if liveCharacter then
		local liveWater =
			tonumber(
				liveCharacter:GetAttribute(
					"Water"
				)
			) or 100

		local finalTarget =
			state.questTravelRefillWaterTarget()

		if liveWater >= finalTarget
			and state.forceStopActiveDrink then

			state.forceStopActiveDrink(
				liveCharacter,
				"Water target reached; Drinking substate released"
			)
		end
	end

	if liveCharacter
		and isAquaticCharacter(liveCharacter) then
		-- Do not create a one-frame sink window between drinking and dry exit.
		setAquaticWaterCollision(liveCharacter, true)
	end

	drinkPromptSustainBusy = false
end

function state.drinkEmergencyEscape(character, root, reason)
	state.drinkProgressReset()

	if not character or not root then return false end

	if state.nonAquaticDryBankConfirmed(character, root) then
		state.drinkClearUndergroundMode()
		drinkingToFull = false
		drinkingSourcePosition = nil
		drinkingStuckSince = nil
		criticalRecoveryActive = false
		forcingPostDrinkMove = false
		state.releaseMovementNow(character, true)
		state.questForceFastRecheckUntil = tick() + 12
		runtimeMessage = "Dry bank confirmed; survival resumed"
		return true
	end

	local badPoint = state.drinkSearch.currentWaterPoint
		or drinkingSourcePosition
		or root.Position

	state.drinkMarkFailed(badPoint, 300)

	-- These are now the REAL locals, not accidental globals.
	criticalRecoveryActive = true
	drinkingToFull = false
	drinkingSourcePosition = nil
	drinkingStuckSince = nil
	lastDrinkWatchdogWater = nil

	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil
	if state.questSetW then state.questSetW(false) end

	state.drinkSearch.currentWaterPoint = nil
	state.drinkSearch.failedCount = 0
	state.drinkSearch.retryAfter = tick() + 8
	state.drinkSearch.upsideDownSince = nil
	state.drinkSearch.waterHealth = nil
	state.drinkSearch.waterHealthAt = 0

	removeSwimBarrier()

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	if waterPart and waterPart:IsA("BasePart") then
		local crocHippo =
			state.isCrocOrHippoMovementCharacter(
				character
			)

		local exitActive =
			crocHippo
			and state.aquaticRiverEscape
			and (
				state.aquaticRiverEscape.busy
					or state.aquaticRiverEscape.survivalSuspended
			)

		if isDinoLife then
			waterPart.CanCollide = false
		elseif exitActive then
			waterPart.CanCollide =
				false
		elseif crocHippo then
			waterPart.CanCollide =
				true
		else
			waterPart.CanCollide =
				isAquaticCharacter(
					character
				)
		end
	end

	runtimeMessage = reason or "ANTI-AFOGAMENTO: escapando para cima do Terrain"

	if (
		isAquaticCharacter(
			character
		)
		or state.isCrocOrHippoMovementCharacter(
			character
		)
	) and state.moveAquaticToDryTerrain then

		local aquaticEscaped =
			state.moveAquaticToDryTerrain(
				character,
				root
			)

		if aquaticEscaped then
			setAquaticWaterCollision(
				character,
				false
			)

			state.releaseMovementNow(
				character,
				true
			)

			state.drinkClearUndergroundMode()
			criticalRecoveryActive = false
			state.questForceFastRecheckUntil =
				tick() + 25

			runtimeMessage =
				"Aquatic safety: verified dry Terrain confirmed"

			return true
		end

		setAquaticWaterCollision(
			character,
			true
		)

		-- Crocodile/Hippo MUST NOT fall through to the generic Terrain/spawn
		-- anti-drowning backend. The solid river bottom makes that backend report
		-- "above Terrain" even though the animal is still underwater.
		if state.isCrocOrHippoMovementCharacter(
			character
		) then
			criticalRecoveryActive = false

			runtimeMessage =
				CROC.isCharacter(character)
					and "Croc water Fly did not exit yet; retrying after cooldown"
					or "Hippo water Fly did not exit yet; retrying after cooldown"

			return false
		end
	end

	local function confirmedAboveTerrain()
		local liveCharacter, liveRoot =
			characterParts()

		if not liveCharacter
			or not liveRoot then
			return false
		end

		if liveRoot.Position.Y
			< config.dangerY then
			return false
		end

		-- Ordinary land animals on a real solid bank are already safe even if the
		-- game's Swimming state/body overlap is one frame stale. This prevents the
		-- recursive 1-second escape loop that could collapse FPS at shorelines.
		if state.nonAquaticDryBankConfirmed(liveCharacter, liveRoot) then
			return true
		end

		-- Aquatic/ambiguous cases still require the strict full-body proof.
		if not state.dryGroundUnderCharacter(
			liveCharacter,
			liveRoot
		) then
			return false
		end

		-- Require a second clean sample so a one-frame Swimming/shore transition
		-- cannot produce the false "confirmed above Terrain" seen on Impala.
		task.wait(0.16)

		liveCharacter, liveRoot =
			characterParts()

		if not liveCharacter
			or not liveRoot
			or liveRoot.Position.Y
				< config.dangerY then
			return false
		end

		return state.dryGroundUnderCharacter(
			liveCharacter,
			liveRoot
		)
	end

	refreshCompletionSpawns()

	local candidates = {}
	local _, liveRoot = characterParts()

	-- Emergency escape never inherits a manual Move To selection.

	if liveRoot then
		local localExit =
			state.findNearestDryWaterExit
			and state.findNearestDryWaterExit(liveRoot)

		if localExit then
			local localDistance = Vector3.new(
				localExit.X - liveRoot.Position.X,
				0,
				localExit.Z - liveRoot.Position.Z
			).Magnitude

			if localDistance <= (DAMAGE.localEscapeRadius or 170) then
				table.insert(candidates, localExit)
			end
		end

		for _, part in ipairs(
			DAMAGE.getNearestSafeSpawns(
				liveRoot,
				DAMAGE.maxEmergencySpawnDistance
			)
		) do
			if part
				and part.Parent
				and state.waterExitPointIsTrulyDry(
					part.Position
				) then

				table.insert(
					candidates,
					part.Position
				)
			end
		end
	end

	if #candidates == 0 then
		local localCharacter, localRoot = characterParts()
		if localCharacter and localRoot
			and DAMAGE.tryLocalDryEscape(
				localCharacter,
				localRoot,
				"ANTI-AFOGAMENTO: procurando Terrain seco local"
			) then
			state.drinkClearUndergroundMode()
			criticalRecoveryActive = false
			state.questForceFastRecheckUntil = tick() + 25
			return true
		end
	end

	for round = 1, 3 do
		for _, position in ipairs(candidates) do
			runtimeMessage = string.format(
				"ANTI-AFOGAMENTO: tentando sair do Terrain (%d/3)",
				round
			)

			local _, escapeRoot = characterParts()
			local needsVertical =
				escapeRoot
				and (
					escapeRoot.Position.Y < config.dangerY
					or (
						not isDinoLife
						and state.drinkIsBuriedUnderTerrain(escapeRoot)
					)
				)
				or false

			safeMoveToPosition(
				position,
				7,
				nil,
				{
					purpose = "safety",
					tolerance = 20,
					vertical = needsVertical,
					forceMoveToLand = not needsVertical,
					constantSpeed = not needsVertical,
					maxDuration = 300,
				}
			)
			task.wait(0.35)

			if confirmedAboveTerrain() then
				state.drinkClearUndergroundMode()

				local safeCharacter =
					player.Character

				if safeCharacter
					and isAquaticCharacter(
						safeCharacter
					) then
					setAquaticWaterCollision(
						safeCharacter,
						false
					)
				end

				state.releaseMovementNow(
					safeCharacter,
					true
				)

				criticalRecoveryActive = false
				state.questForceFastRecheckUntil = tick() + 25
				runtimeMessage = "ANTI-AFOGAMENTO: ACIMA do Terrain confirmado"
				return true
			end
		end

		if DAMAGE and type(DAMAGE.moveToSafety) == "function" then
			pcall(DAMAGE.moveToSafety)
			task.wait(0.45)

			if confirmedAboveTerrain() then
				state.drinkClearUndergroundMode()

				local safeCharacter =
					player.Character

				if safeCharacter
					and isAquaticCharacter(
						safeCharacter
					) then
					setAquaticWaterCollision(
						safeCharacter,
						false
					)
				end

				state.releaseMovementNow(
					safeCharacter,
					true
				)

				criticalRecoveryActive = false
				state.questForceFastRecheckUntil = tick() + 25
				runtimeMessage = "ANTI-AFOGAMENTO: spawn seguro confirmado"
				return true
			end
		end
	end

	-- Keep the lock and retry. Do NOT resume movement under Terrain.
	runtimeMessage = "CRITICO: ainda sob Terrain; Auto Run BLOQUEADO; repetindo escape"

	mmbTaskDelay(1.0, function()
		if not state.alive then return end

		local liveCharacter, retryRoot = characterParts()
		if liveCharacter and retryRoot then
			state.drinkEmergencyEscape(
				liveCharacter,
				retryRoot,
				"Repetindo escape anti-afogamento"
			)
		else
			criticalRecoveryActive = false
		end
	end)

	return false
end


function state.drinkTestRestoreEnvironment()
	local test = state.drinkTest

	local character =
		test.character

	if character and character.Parent then
		local humanoid =
			character:FindFirstChildOfClass(
				"Humanoid"
			)

		if humanoid then
			state.drinkTestSetTransitPhysics(
				character,
				humanoid,
				false
			)
		end

		state.drinkTestGhostCharacter(
			character,
			false
		)
	else
		test.collisionSnapshot = nil
		test.humanoidSnapshot = nil
	end

	local waterPart =
		test.waterPart

	if waterPart
		and waterPart.Parent
		and test.waterPartCanCollide ~= nil then

		pcall(function()
			waterPart.CanCollide =
				test.waterPartCanCollide == true
		end)
	end

	if DAMAGE
		and test.savedDamageCooldown ~= nil then

		DAMAGE.cooldownUntil =
			math.max(
				tonumber(
					test.savedDamageCooldown
				) or 0,
				tick() + 2
			)
	end

	state.drinkClearUndergroundMode()
	state.drinkProgressReset()

	state.drinkSearch.currentWaterPoint = nil
	state.drinkSearch.waterHealth = nil
	state.drinkSearch.waterHealthAt = 0
	state.drinkSearch.undergroundLastWater = nil
	state.drinkSearch.undergroundLastProgressAt = 0

	test.character = nil
	test.entryPosition = nil
	test.entryZone = nil
	test.undergroundSpot = nil
	test.surfaceExit = nil
	test.surfaceY = nil
	test.startHealth = nil
	test.startWater = nil
	test.waterPart = nil
	test.waterPartCanCollide = nil
	test.savedDamageCooldown = nil
	test.emergencyFallback = false
	test.hardExitBusy = false
	test.healthLossSince = 0
	test.healthLossLowest = nil

	state.drinkTestDisableSelfDamageGuard()

	-- Never leave the normal Savannah sub-state remote blocked after a drink
	-- transaction. A stale block can prevent later Eat/Drink sessions.
	blockClientSubState = false
end

-- Absolute anti-drowning fallback for the underground route.
-- This is intentionally stronger than normal navigation: if the controlled
-- vertical exit ever fails, preserving the slot has priority over route style.
function state.drinkTestHardEject(reason)
	local test = state.drinkTest

	if test.hardExitBusy then
		return state.drinkTestAboveTerrainConfirmed()
	end

	test.hardExitBusy = true
	criticalRecoveryActive = true

	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil

	if state.questSetW then
		pcall(state.questSetW, false)
	end

	if state.safeMove and state.safeMove.active then
		state.safeMove.cancelToken += 1
	end

	local character, root, humanoid =
		characterParts()

	if not character
		or not root
		or not humanoid
		or humanoid.Health <= 0 then
		test.hardExitBusy = false
		return false
	end

	-- If the old transaction belongs to a character that has already been
	-- replaced, there is nothing useful to rescue in that transaction.
	if test.character
		and character ~= test.character then
		test.hardExitBusy = false
		return false
	end

	test.character = character

	state.drinkTestSetPhase(
		"hard_exit",
		"ANTI-DROWNING: forcing immediate exit above Terrain"
			.. (
				reason
					and (" (" .. tostring(reason) .. ")")
					or ""
			)
	)

	-- Keep every character part non-collidable while crossing Terrain.
	state.drinkTestGhostCharacter(
		character,
		true
	)

	if test.waterPart
		and test.waterPart.Parent then
		pcall(function()
			test.waterPart.CanCollide = false
		end)
	end

	character:SetAttribute(
		"MovementDisabled",
		true
	)

	state.drinkTestSetTransitPhysics(
		character,
		humanoid,
		true
	)

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	local rotation =
		root.CFrame.Rotation

	local function placeAndHold(position, frames)
		if typeof(position) ~= "Vector3" then
			return false
		end

		for _ = 1, (frames or 8) do
			character, root, humanoid =
				characterParts()

			if not character
				or not root
				or not humanoid
				or humanoid.Health <= 0 then
				return false
			end

			state.drinkTestGhostCharacter(
				character,
				true
			)

			state.drinkTestMaintainTransit(
				character,
				root,
				humanoid
			)

			root.CFrame =
				CFrame.new(position)
				* rotation

			root.AssemblyLinearVelocity =
				Vector3.zero

			root.AssemblyAngularVelocity =
				Vector3.zero

			RunService.Heartbeat:Wait()
		end

		return true
	end

	-- First choice is ALWAYS a straight vertical ejection at the same X/Z.
	local surfaceExit =
		test.surfaceExit

	local surfaceY =
		tonumber(test.surfaceY)

	local current =
		root.Position

	local exitX =
		typeof(surfaceExit) == "Vector3"
			and surfaceExit.X
			or current.X

	local exitZ =
		typeof(surfaceExit) == "Vector3"
			and surfaceExit.Z
			or current.Z

	local standClearance =
		math.clamp(
			state.movementRootClearance(character) + 1.25,
			3.5,
			11
		)

	local surfaceBaseY =
		surfaceY
			or (
				typeof(surfaceExit) == "Vector3"
					and (surfaceExit.Y - standClearance - 2)
					or nil
			)

	-- Restore normal physics only when the HRP is already at a real standing
	-- height. The old +28 exit created its own fall after every underground drink.
	local verticalY =
		typeof(surfaceBaseY) == "number"
			and (surfaceBaseY + standClearance)
			or (current.Y + standClearance + 8)

	placeAndHold(
		Vector3.new(
			exitX,
			verticalY,
			exitZ
		),
		10
	)

	local confirmed =
		state.drinkTestAboveTerrainConfirmed()

	-- If Roblox/server correction defeated the vertical ejection, return to
	-- the exact pre-descent position. This is a safety-only last resort.
	if not confirmed
		and typeof(test.entryPosition) == "Vector3" then

		local entryTarget =
			test.entryPosition
				+ Vector3.new(
					0,
					0.75,
					0
				)

		placeAndHold(
			entryTarget,
			12
		)

		confirmed =
			root.Position.Y >= config.dangerY
			and not state.drinkIsBuriedUnderTerrain(
				root
			)
	end

	-- Final failsafe for Savannah: the configured farm point is known dry land.
	-- This should almost never execute, but prevents a slot being sacrificed to
	-- a bad Terrain replication state.
	if not confirmed and isSavannahLife then
		local safe =
			getSafeFarmPosition()

		if typeof(safe) == "Vector3" then
			placeAndHold(
				safe
					+ Vector3.new(
						0,
						math.max(1.5, standClearance * 0.35),
						0
					),
				14
			)

			confirmed =
				root.Position.Y >= config.dangerY
				and not state.drinkIsBuriedUnderTerrain(
					root
				)
		end
	end

	if confirmed then
		-- Restore collision while Physics still owns the Humanoid, then give the
		-- game a few frames at zero velocity before re-enabling Freefall. This
		-- prevents the surface transition itself from registering as a landing.
		state.drinkTestGhostCharacter(
			character,
			false
		)

		for _ = 1, 4 do
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			RunService.Heartbeat:Wait()
		end

		state.drinkTestSetTransitPhysics(
			character,
			humanoid,
			false
		)

		character:SetAttribute(
			"MovementDisabled",
			false
		)

		root.AssemblyLinearVelocity =
			Vector3.zero

		root.AssemblyAngularVelocity =
			Vector3.zero

		blockClientSubState = false
	else
		-- Keep collision disabled and push upward instead of freezing the animal
		-- below Terrain. The caller will retry the emergency recovery.
		state.drinkTestGhostCharacter(
			character,
			true
		)

		root.AssemblyLinearVelocity =
			Vector3.new(
				0,
				math.max(
					35,
					state.safeMovementSpeed(character)
						* 0.75
				),
				0
			)
	end

	test.hardExitBusy = false
	return confirmed
end


function state.drinkTestEmergencySurfaceExit(reason)
	local test = state.drinkTest

	state.drinkTestSetPhase(
		"exit",
		reason
			and (
				"Underground Drink: immediate surface exit - "
				.. tostring(reason)
			)
			or "Underground Drink: immediate surface exit"
	)

	-- Do not spend extra time pathing while buried. The old controlled exit
	-- could retry several long smooth moves and leave the slot drowning below
	-- Terrain. Crossing upward is now an immediate anti-drowning transaction.
	return state.drinkTestHardEject(
		reason or "surface exit"
	)
end


function state.runUndergroundDrinkTest()
	local test = state.drinkTest

	if test.active then
		return
	end

	if forcingPostDrinkMove
		or state.questGrowthReset.exclusive
		or state.questGrowthReset.busy
		or DAMAGE.active then

		runtimeMessage =
			"Underground Drink unavailable: another safety/reset controller is active"

		return
	end

	local character, root, humanoid =
		characterParts()

	if not character
		or not root
		or not humanoid
		or humanoid.Health <= 0 then

		runtimeMessage =
			"Underground Drink: no valid character"

		return
	end

	test.active = true
	test.cancelRequested = false
	test.hardExitBusy = false
	test.phase = "prepare"
	test.startedAt = tick()
	test.character = character
	test.entryPosition = root.Position
	test.entryZone =
		state.questCurrentZoneName
			and state.questCurrentZoneName()
			or nil
	test.startHealth = humanoid.Health
	test.startWater =
		tonumber(
			character:GetAttribute("Water")
		) or 100
	test.lastError = nil
	test.lastResult = nil
	test.healthLossSince = 0
	test.healthLossLowest = humanoid.Health

	-- Clear stale Safety state BEFORE the first downward frame. Underground Drink
	-- is an intentional Water-owned transaction, not terrain-clip recovery.
	do
		local ai = state.MMBAI
		local authority = ai and ai.Authority
		if authority then
			if type(authority.ClearSignalsForOwner) == "function" then
				pcall(authority.ClearSignalsForOwner, authority, "Safety")
			end
			if authority.currentOwner == "Safety" then
				authority.currentOwner = "None"
				authority.currentController = "None"
				authority.currentReason = "Underground Drink took intentional Terrain ownership"
				authority.currentScore = 0
				authority.exclusive = false
				authority.controllerLeaseUntil = 0
				authority.epoch = (authority.epoch or 0) + 1
			end
		end

		local manager = ai and ai.MovementManager
		if manager and manager.lease and manager.lease.owner == "Safety"
			and type(manager.CancelOwner) == "function" then
			pcall(manager.CancelOwner, manager, "Safety", "Underground Drink owns Terrain crossing", true)
		end
	end

	if DAMAGE then
		test.savedDamageCooldown =
			DAMAGE.cooldownUntil

		-- Test has a stricter internal health watchdog; prevent another safety
		-- controller from fighting the same movement.
		DAMAGE.cooldownUntil =
			math.max(
				DAMAGE.cooldownUntil or 0,
				tick() + 90
			)
	end

	-- Take ownership from any existing survival route.
	drinkingToFull = false
	drinkingSourcePosition = nil
	drinkingStuckSince = nil
	lastDrinkWatchdogWater = nil
	state.drinkProgressReset()

	if state.safeMove
		and state.safeMove.active then
		state.safeMove.cancelToken += 1
	end

	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil

	if state.questSetW then
		pcall(state.questSetW, false)
	end

	criticalRecoveryActive = true
	blockClientSubState = false

	-- Start every underground transaction with a full oxygen reserve. The global
	-- Oxygen Guard keeps it at 100 while the animal remains submerged.
	state.oxygenGuardApply(character)

	-- Enable before the first Y displacement so FallDamageHandler never records
	-- the scripted Terrain crossing as a real fall. The same scoped guard also
	-- prevents Oxygen self-damage while intentionally below Terrain.
	state.drinkTestEnableSelfDamageGuard(
		character
	)

	state.drinkTestRender()

	local ok, failure =
		xpcall(
			function()
				state.drinkTestSetPhase(
					"scan",
					"Underground Drink: finding local buried water"
				)

				local spot =
					state.drinkTestFindLocalSpot(
						root.Position,
						character
					)

				if not spot then
					error(
						"no buried MainWaterPart found within 520 studs"
					)
				end

				test.undergroundSpot = spot
				test.surfaceExit = spot.exit
				test.surfaceY =
					spot.surfaceHit.Y
				test.waterPart =
					spot.waterPart
				test.waterPartCanCollide =
					spot.waterPart.CanCollide

				state.drinkSearch.currentWaterPoint =
					spot.water

				state.drinkSearch.undergroundMode =
					true

				state.drinkSearch.undergroundSince =
					tick()

				state.drinkSearch.undergroundLastProgressAt =
					tick()

				state.drinkSearch.undergroundLastWater =
					test.startWater

				state.drinkSearch.waterHealth =
					humanoid.Health

				state.drinkSearch.waterHealthAt =
					tick()

				state.drinkTestSetPhase(
					"descend",
					string.format(
						"Underground Drink: descending to hidden water (cover %.1f, targetY %.1f)",
						spot.coverDepth,
						spot.stand.Y
					)
				)

				-- Hidden water must not act as a physical wall during transit.
				spot.waterPart.CanCollide = false

				if not state.drinkTestGhostCharacter(
					character,
					true
				) then
					error(
						"could not disable character collision"
					)
				end

				-- Underground crossing uses fast PivotTo translation while fully UNANCHORED.
				-- No SafeMove, Freefall, Physics state or ragdoll is used.
				local descended, descentMoveReason =
					state.drinkTestSmoothMove(
						spot.stand,
						"descent",
						false,
						14
					)

				if not descended
					and descentMoveReason ~= "cancel" then

					error(
						"descent move failed: "
						.. tostring(
							descentMoveReason
						)
					)
				end

				character, root, humanoid =
					characterParts()

				if not character
					or character ~= test.character
					or not root
					or not humanoid then
					error(
						"character changed during descent"
					)
				end

				local descentError =
					state.drinkTestTransitAbortReason(
						character,
						root,
						humanoid
					)

				if descentError
					and descentError ~= "cancel" then
					error(
						"descent safety: "
						.. descentError
					)
				end

				if test.cancelRequested then
					return
				end

				local targetDistance =
					(
						root.Position
						- spot.stand
					).Magnitude

				if not descended
					or targetDistance > 4 then

					error(
						string.format(
							"underground target not reached (distance %.1f)",
							targetDistance
						)
					)
				end

				if not state.drinkIsBuriedUnderTerrain(
					root
				) then

					local actualCover =
						test.surfaceY
						and (
							test.surfaceY
							- root.Position.Y
						)
						or -999

					error(
						string.format(
							"Terrain cover not confirmed after strict descent (rootY %.1f, surfaceY %.1f, cover %.1f, targetDistance %.1f)",
							root.Position.Y,
							tonumber(
								test.surfaceY
							) or -999,
							actualCover,
							targetDistance
						)
					)
				end

				state.drinkTestMaintainTransit(
					character,
					root,
					humanoid
				)

				-- Lock one exact underground pose for the whole drinking transaction.
				-- The remote does not require physical animation, so there is no reason
				-- to let the animal tumble, slide or rotate below Terrain.
				local flatLook = Vector3.new(
					root.CFrame.LookVector.X,
					0,
					root.CFrame.LookVector.Z
				)

				if flatLook.Magnitude < 0.05 then
					flatLook = Vector3.new(0, 0, -1)
				else
					flatLook = flatLook.Unit
				end

				local rigidRootCFrame = CFrame.lookAt(
					spot.stand,
					spot.stand + flatLook,
					Vector3.yAxis
				)

				local rigidRootToPivot
				pcall(function()
					rigidRootToPivot = root.CFrame:ToObjectSpace(
						character:GetPivot()
					)
				end)

				if rigidRootToPivot then
					pcall(function()
						character:PivotTo(
							rigidRootCFrame * rigidRootToPivot
						)
					end)
				else
					pcall(function()
						root.CFrame = rigidRootCFrame
					end)
				end

				root.Anchored = false
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero

				local rigidPivotCFrame
				pcall(function()
					rigidPivotCFrame = character:GetPivot()
				end)

				-- Underground transit/drinking always stays non-collidable. Do not
				-- re-enable MainWaterPart collision while the animal is below Terrain.
				spot.waterPart.CanCollide = false

				state.drinkTestSetPhase(
					"drink",
					"Underground Drink: underground position confirmed; testing Drink"
				)

				local drinkStartedAt =
					tick()

				local lastWater =
					tonumber(
						character:GetAttribute(
							"Water"
						)
					) or 100

				local lastProgressAt =
					tick()

				local lastRemoteAt = 0
				local progressConfirmed = false

				local initialProgressGrace =
					state.isHeavyGroundMover(
						character
					)
						and 12
						or 8

				-- Keep a safety reserve for surfacing. The animal is never allowed
				-- to spend the full 90-second ceiling waiting below Terrain.
				local hardSafetyDeadline =
					tick() + 80

				-- Underground mode is a full refill. Leaving at 98% could start a
				-- new drink transaction almost immediately and increased exposure.
				local targetWater = 100

				while state.alive
					and character
						== player.Character
					and humanoid.Parent
					and humanoid.Health > 0 do

					local now = tick()
					local water =
						tonumber(
							character:GetAttribute(
								"Water"
							)
						) or 100

					-- Reassert clipping on every frame while buried. This is the
					-- Terrain-crossing safety mechanism for both automatic and
					-- manually selected Underground Drink.
					for _, object in ipairs(
						character:GetDescendants()
					) do
						if object:IsA("BasePart")
							and object.CanCollide then
							object.CanCollide = false
						end
					end

					if spot.waterPart
						and spot.waterPart.Parent
						and spot.waterPart.CanCollide then
						spot.waterPart.CanCollide = false
					end

					character:SetAttribute(
						"MovementDisabled",
						true
					)

					state.drinkTestMaintainTransit(
						character,
						root,
						humanoid
					)

					root.AssemblyLinearVelocity =
						Vector3.zero

					root.AssemblyAngularVelocity =
						Vector3.zero

					pcall(
						humanoid.Move,
						humanoid,
						Vector3.zero,
						false
					)

					if state.questSetW then
						state.questSetW(false)
					end

					if test.cancelRequested then
						break
					end

					-- Water 100% is an unconditional EXIT condition.
					if water >= targetWater then
						test.lastResult =
							"water_full"
						break
					end

					if root.Position.Y
						< config.dangerY + 4 then
						error(
							"void threshold reached underground"
						)
					end

					if state.drinkTestHealthHazard
						and state.drinkTestHealthHazard(
							humanoid
						) then

						error(
							"verified sustained health loss underground"
						)
					end

					-- Unanchored hard pin: keep exactly one pose while the server still sees
					-- a normal live character. Reapply every Heartbeat; no ragdoll/impulses.
					root.Anchored = false
					if rigidPivotCFrame then
						pcall(function()
							character:PivotTo(rigidPivotCFrame)
						end)
					elseif rigidRootCFrame then
						pcall(function()
							root.CFrame = rigidRootCFrame
						end)
					end

					root.AssemblyLinearVelocity = Vector3.zero
					root.AssemblyAngularVelocity = Vector3.zero

					if water
						> lastWater + 0.01 then

						lastWater = water
						lastProgressAt = now
						progressConfirmed = true

						state.drinkSearch.undergroundLastWater =
							water

						state.drinkSearch.undergroundLastProgressAt =
							now

						state.drinkTestSetPhase(
							"drink",
							string.format(
								"Underground Drink: remote active (%d%% -> 100%%)",
								math.floor(water)
							)
						)
					end

					-- E/prompt is visual only. The server sub-state remote is what
					-- actually starts/maintains drinking, so underground mode calls
					-- it directly instead of waiting for a prompt that may never
					-- replicate below Terrain.
					if now - lastRemoteAt >= 0.08 then
						lastRemoteAt = now
						blockClientSubState = false
						setSubState(
							"Drinking"
						)
						blockClientSubState = false
					end

					if not progressConfirmed
						and now - drinkStartedAt
							>= initialProgressGrace then

						error(
							string.format(
								"underground Drink produced no Water progress within %.0fs",
								initialProgressGrace
							)
						)
					end

					if progressConfirmed
						and now - lastProgressAt
							>= 5.0 then

						error(
							"underground Water stopped progressing for 5s"
						)
					end

					if now >= hardSafetyDeadline then
						error(
							"80s underground safety ceiling; reserving time for exit"
						)
					end

					-- Pin every physics frame without Anchored. This is the old fixed-position
					-- behavior, but with the complete rig kept upright and non-collidable.
					RunService.Heartbeat:Wait()
				end
			end,
			function(err)
				return tostring(err)
			end
		)

	if not ok then
		test.lastError =
			tostring(failure)

		test.lastResult = "failed"
	end

	-- Every outcome performs a controlled surface exit.
	local exitReason

	if test.cancelRequested then
		exitReason =
			"cancel requested"
	elseif not ok then
		exitReason =
			test.lastError
	elseif test.lastResult == "water_full" then
		exitReason =
			"water full"
	else
		exitReason =
			"test complete"
	end

	local safeExit =
		state.drinkTestEmergencySurfaceExit(
			exitReason
		)

	-- One final immediate attempt before any state can remain locked. With a
	-- live Savannah character this also has a dry-farm last resort.
	if not safeExit then
		safeExit =
			state.drinkTestHardEject(
				"final anti-drowning retry"
			)
	end

	if safeExit then
		state.drinkTestRestoreEnvironment()

		test.active = false
		test.cancelRequested = false
		test.phase = "idle"

		criticalRecoveryActive = false

		drinkingToFull = false
		drinkingSourcePosition = nil
		drinkingStuckSince = nil
		lastDrinkWatchdogWater = nil
		state.drinkProgressReset()
		state.drinkClearUndergroundMode()

		state.questForceFastRecheckUntil =
			tick() + 20

		if test.lastResult == "failed"
			or not ok then
			test.retryAfter =
				tick() + 20
		else
			test.retryAfter = 0
		end

		runtimeMessage =
			ok
				and "Underground Drink complete: surface exit confirmed"
				or (
					"Underground Drink aborted safely: "
					.. tostring(
						test.lastError
						or exitReason
					)
				)
	else
		-- Reaching this branch normally means the character disappeared/died while
		-- the transaction was being rescued. Never preserve a stale global safety
		-- lock, because that would permanently disable Auto Eat/Drink afterwards.
		test.lastError =
			test.lastError
			or "surface exit could not be confirmed because character changed"

		state.drinkTestRestoreEnvironment()

		test.active = false
		test.cancelRequested = false
		test.phase = "idle"
		test.retryAfter = tick() + 20

		criticalRecoveryActive = false
		drinkingToFull = false
		drinkingSourcePosition = nil
		drinkingStuckSince = nil
		lastDrinkWatchdogWater = nil
		blockClientSubState = false

		runtimeMessage =
			"Underground Drink recovery transaction ended; survival controller unlocked"
	end

	state.drinkTestRender()
end


local function virtualDrinkKick()
	local character, root = characterParts()
	if not character or not root then return end

	local detected = detectAvailableFood(character)

	if detected == "Drink" then
		runtimeMessage = "Drink stalled; prompt still active, reasserting in place"
		drinkingSourcePosition = root.Position
	else
		runtimeMessage = "Drink stalled; reasserting server Drinking state"

		if state.isCrocOrHippoMovementCharacter(
			character
		) then

			removeSwimBarrier()
			local _, waterPart = CROC.getWaterSurfaceY()
			if waterPart then
				waterPart.CanCollide = true
			end

			local liveHumanoid =
				character:FindFirstChildOfClass(
					"Humanoid"
				)

			local rememberedWater =
				state.drinkSearch.currentWaterPoint

			local acquired =
				liveHumanoid
				and state.drinkAcquirePromptAfterMove(
					{ water = rememberedWater },
					character,
					root,
					liveHumanoid,
					tonumber(character:GetAttribute("Water")) or 0,
					1.8
				)

			if acquired then
				local _, heldRoot = characterParts()
				if heldRoot then
					drinkingSourcePosition = heldRoot.Position
				end
				runtimeMessage =
					"Croco: recovered Drink by rotating in place"
				task.spawn(sustainDrinkAtCurrentPrompt)
			else
				drinkingSourcePosition = nil
				CROC.approachDrink()
			end
		elseif drinkingSourcePosition then
			state.drinkAbandonCurrent("Watchdog: fonte sem progresso; trocando de agua")
			return
		end

		task.wait(0.2)
	end

	-- E and Auto Drink off/on toggles are unnecessary. Reassert the server
	-- state directly so a watchdog recovery cannot accidentally disable survival.
	blockClientSubState = false
	setSubState("Drinking")
	blockClientSubState = false
	if not state.isCrocOrHippoMovementCharacter(character) then
		task.spawn(sustainDrinkAtCurrentPrompt)
	end
	drinkingStuckSince = nil
end


-- Surface Drink search transit.
-- Savannah walks toward Pride Rock while rescanning. Dino Life uses the same
-- watchdog concept, but cycles through the normal workspace.Spawns locations.
-- The instant exposed water is detected, the transit is cancelled and normal
-- precise Surface Drink takes over.
function state.drinkSurfaceSearchTransit(character)
	if not (isSavannahLife or isDinoLife)
		or state.autoDrinkMode ~= "surface"
		or not state.autoDrink
		or not character
		or character ~= player.Character then
		return nil, "not_applicable"
	end

	if isAquaticCharacter(character)
		or state.isCrocOrHippoMovementCharacter(character)
		or (
			type(state.isFlyingMovementCharacter) == "function"
			and state.isFlyingMovementCharacter(character)
		) then
		return nil, "special_movement"
	end

	local liveCharacter, root = characterParts()
	if not liveCharacter or not root then
		return nil, "no_character"
	end

	-- One final CHEAP local check before starting transit. autoDrinkStep already
	-- performed the full 420-stud Dino scan; repeating it here caused a second
	-- expensive search before the Rex even started moving.
	local immediate =
		state.drinkFindAccessibleSpot(
			root.Position,
			liveCharacter,
			isDinoLife
				and {
					dinoQuick = true,
				}
				or nil
		)

	if immediate then
		return immediate,
			"water_found"
	end

	local destination
	local destinationLabel

	if isDinoLife then
		refreshCompletionSpawns()
		if #completionSpawnParts == 0 then
			return nil, "no_spawn_target"
		end

		state.drinkSearch.dinoSpawnVisited =
			state.drinkSearch.dinoSpawnVisited
			or {}

		local visited =
			state.drinkSearch.dinoSpawnVisited

		local now =
			tick()

		local eligible = {}

		for index, part in ipairs(
			completionSpawnParts
		) do
			if part
				and part.Parent
				and part:IsA("BasePart") then

				local spawnForbidden =
					state.dinoRestrictedBasinPointForbidden
					and state.dinoRestrictedBasinPointForbidden(
						part.Position,
						liveCharacter,
						5
					)
					or false

				if not spawnForbidden then
					local flatDistance =
						Vector3.new(
							part.Position.X - root.Position.X,
							0,
							part.Position.Z - root.Position.Z
						).Magnitude

					if flatDistance >= 45 then
						local lastVisit =
							visited[part]
							or 0

						eligible[#eligible + 1] = {
							part = part,
							index = index,
							distance = flatDistance,
							fresh =
								now - lastVisit >= 45,
						}
					end
				end
			end
		end

		if #eligible == 0 then
			return nil, "no_spawn_target"
		end

		table.sort(
			eligible,
			function(a, b)
				if a.fresh ~= b.fresh then
					return a.fresh
				end

				return a.distance < b.distance
			end
		)

		local selected =
			eligible[1]

		local chosen =
			selected.part

		visited[chosen] =
			now

		destination =
			chosen.Position

		destinationLabel =
			state.spawnLocationLabel(
				chosen
			)

		state.drinkSearch.dinoSpawnTransitIndex =
			(selected.index % #completionSpawnParts) + 1
	else
		destination =
			state.growthPride
			and state.growthPride.home
			or nil

		if typeof(destination) ~= "Vector3" then
			local spawns = workspace:FindFirstChild("Spawns")
			local prideSpawn = spawns and spawns:FindFirstChild("PrideRockSpawn1", true)
			if prideSpawn and prideSpawn:IsA("BasePart") then
				destination = prideSpawn.Position
			end
		end
		destinationLabel = "Pride Rock"
	end

	if typeof(destination) ~= "Vector3" then
		return nil, isDinoLife and "no_spawn_target" or "no_pride_target"
	end

	state.drinkSearch.surfaceTransitActive = true
	state.drinkSearch.surfaceTransitFoundSpot = nil
	state.drinkSearch.surfaceTransitLastScanAt = 0
	state.drinkSearch.surfaceTransitReason = nil

	local workerCharacter = liveCharacter

	local transitProgressPosition =
		root.Position

	local transitProgressAt =
		tick()

	runtimeMessage = isDinoLife
		and ("Dino water watchdog: moving toward " .. tostring(destinationLabel) .. " and scanning")
		or "Surface water search: moving toward Pride Rock and scanning"

	local moved = safeMoveToPosition(
		destination,
		10,
		nil,
		{
			purpose = "water_search",
			forceMoveToLand = true,
			tolerance = 24,
			speedScale = 1,
			constantSpeed = true,
			maxDuration = isDinoLife and 55 or 360,
			routeCheckInterval = isDinoLife and 0.55 or 0.30,
			routeCheck = function(routeCharacter, routeRoot)
				if not state.autoDrink
					or state.autoDrinkMode ~= "surface" then
					state.drinkSearch.surfaceTransitReason = "drink_disabled"
					return true, "drink_disabled"
				end

				if routeCharacter ~= workerCharacter
					or not routeCharacter
					or not routeRoot then
					state.drinkSearch.surfaceTransitReason = "character_changed"
					return true, "character_changed"
				end

				if state.questGrowthReset.exclusive
					or criticalRecoveryActive then
					state.drinkSearch.surfaceTransitReason = "priority"
					return true, "priority"
				end

				local liveWater =
					tonumber(routeCharacter:GetAttribute("Water")) or 100

				if isDinoLife then
					local movedSinceProbe =
						Vector3.new(
							routeRoot.Position.X
								- transitProgressPosition.X,
							0,
							routeRoot.Position.Z
								- transitProgressPosition.Z
						).Magnitude

					if movedSinceProbe >= 4 then
						transitProgressPosition =
							routeRoot.Position
						transitProgressAt =
							tick()
					elseif tick() - transitProgressAt >= 7 then
						local rockNear =
							state.movementDinoRockNearby(
								routeRoot.Position,
								12
							)

						state.drinkSearch.surfaceTransitReason =
							rockNear
								and "dino_rock_stall"
								or "dino_route_stall"

						runtimeMessage =
							rockNear
								and "Dino water watchdog: rock route stalled; escaping now"
								or "Dino water watchdog: route made no progress; changing spawn"

						return true,
							state.drinkSearch.surfaceTransitReason
					end
				end

				-- If Dino physically reaches a valid drinking contact while travelling
				-- toward a search spawn, WATER ITSELF wins immediately. Do not continue
				-- crossing the river to search for water on the other side.
				if isDinoLife then
					local drinkContact =
						detectAvailableFood(routeCharacter) == "Drink"
						or (
							state.drinkGamePromptAvailable
							and state.drinkGamePromptAvailable(routeCharacter)
						)
						or (
							state.drinkVisualPromptVisible
							and state.drinkVisualPromptVisible()
						)

					if drinkContact then
						if state.drinkVisualPromptVisible
							and state.drinkVisualPromptVisible()
							and state.drinkLatchVisualPrompt then
							state.drinkLatchVisualPrompt()
						end

						state.drinkSearch.surfaceTransitFoundSpot = {
							water = routeRoot.Position,
							stand = routeRoot.Position,
							source = "CurrentDrinkContact",
							promptContact = true,
						}
						state.drinkSearch.surfaceTransitReason = "water_found"
						runtimeMessage =
							"Dino water watchdog: Drink detected; stopping here"
						return true, "surface_water_found"
					end
				end

				if liveWater >= 98 then
					state.drinkSearch.surfaceTransitReason = "full"
					return true, "full"
				end

				local now = tick()
				if now - (state.drinkSearch.surfaceTransitLastScanAt or 0) >= (isDinoLife and 1.05 or 1.15) then
					state.drinkSearch.surfaceTransitLastScanAt = now

					local found =
						state.drinkFindAccessibleSpot(
							routeRoot.Position,
							routeCharacter,
							isDinoLife
								and {
									dinoQuick = true,
									dinoTransitScan = true,
								}
								or nil
						)

					if found then
						state.drinkSearch.surfaceTransitFoundSpot = found
						state.drinkSearch.surfaceTransitReason = "water_found"
						runtimeMessage = isDinoLife
							and "Dino water watchdog: exposed water found; taking over"
							or "Surface water found on route; cancelling Pride Rock search"
						return true, "surface_water_found"
					end
				end

				return false
			end,
		}
	)

	local found = state.drinkSearch.surfaceTransitFoundSpot
	local reason = state.drinkSearch.surfaceTransitReason

	state.drinkSearch.surfaceTransitActive = false
	state.drinkSearch.surfaceTransitFoundSpot = nil
	state.drinkSearch.surfaceTransitLastScanAt = 0
	state.drinkSearch.surfaceTransitReason = nil

	if found then
		return found, "water_found"
	end

	liveCharacter, root = characterParts()

	if isDinoLife
		and reason == "dino_rock_stall"
		and liveCharacter == workerCharacter
		and root then

		local liveHumanoid =
			liveCharacter:FindFirstChildOfClass(
				"Humanoid"
			)

		if liveHumanoid then
			pcall(
				state.dinoRockEmergencyNoclipEscape,
				liveCharacter,
				root,
				liveHumanoid,
				"water"
			)

			local _, escapedRoot =
				characterParts()

			if escapedRoot then
				local escapedSpot =
					state.drinkFindAccessibleSpot(
						escapedRoot.Position,
						liveCharacter,
						{
							dinoQuick = true,
						}
					)

				if escapedSpot then
					return escapedSpot,
						"water_found"
				end
			end
		end
	end
	if liveCharacter == workerCharacter
		and root
		and state.autoDrink
		and state.autoDrinkMode == "surface"
		and not state.questGrowthReset.exclusive
		and not criticalRecoveryActive then

		local finalSpot =
			state.drinkFindAccessibleSpot(
				root.Position,
				liveCharacter,
				isDinoLife
					and {
						dinoQuick = true,
					}
					or nil
			)

		if finalSpot then
			return finalSpot, "water_found"
		end
	end

	return nil, reason or (moved and "arrived_no_water" or "route_failed")
end

local function autoDrinkStep()
	if isDinoLife
		and state.dinoDrinkFastScan
		and state.dinoDrinkFastScan.busy then

		return
	end

	if state.dinoShorelineRecovery and state.dinoShorelineRecovery.active then return end
	if state.dinoRockEmergency and state.dinoRockEmergency.supervisorActive
		and state.dinoRockEmergency.supervisorCharacter == player.Character then
		return
	end
	if not state.aiModuleOperational("AutoDrink") then return end
	if not state.aiMovementOperational("Water") then return end
	if state.herbivoreFoodRecovery
		and state.herbivoreFoodRecovery.active
		and state.herbivoreFoodRecovery.character
			== player.Character then

		return
	end

	if GIRAFFE.exclusiveRecovery
		and GIRAFFE.exclusiveRecovery.active
		and isGiraffeCharacter(
			player.Character
		) then

		return
	end

	if state.slotParkingAudit and state.slotParkingAudit.active then return end
	if state.aquaticRiverEscape
		and state.aquaticRiverEscape.survivalSuspended then
		return
	end

	if state.questGrowthReset.exclusive then return end
	if not state.autoDrink or criticalRecoveryActive then return end

	local character, root, humanoid = characterParts()
	if not character or not root or not humanoid then return end

	if isDinoLife and state.autoDrinkMode ~= "surface" then
		state.autoDrinkMode = "surface"
		state.autoDrinkPreferredMode = "surface"
		state.drinkClearUndergroundMode()
	end

	if isDinoLife then
		-- A stale failed-source cooldown may never postpone a fresh local scan.
		-- The fast sensor is cheap enough to let the Water owner re-evaluate the
		-- current area immediately.
		if state.drinkSearch.retryAfter
			and state.drinkSearch.retryAfter > tick()
			and (
				tonumber(
					character:GetAttribute(
						"Water"
					)
				) or 100
			) <= 75 then

			state.drinkSearch.retryAfter =
				0
		end
	end

	local isCroc = CROC.isCharacter(character)

	local earlyWater =
		tonumber(
			character:GetAttribute("Water")
		) or 100

	local earlyFood =
		tonumber(
			character:GetAttribute("Food")
		) or 100

	local travelFullRefillWater =
		state.questTravelFullRefill
		and state.questTravelFullRefill.active
		and state.questTravelFullRefill.owner == "water"

	state.survivalArbiterNoteProgress("water", earlyWater)
	state.survivalArbiterNoteProgress("food", earlyFood)

	local authoritativeOwner =
		state.authoritativeSurvivalOwner()

	if authoritativeOwner == "food"
		and not state.drinkTransactionProtected(character) then
		if state.survivalArbiter.owner ~= "food" then
			state.survivalArbiterReset(
				"Auto Drink yielded to Supervisor Food"
			)
			state.survivalArbiterAcquire(
				"food",
				earlyFood,
				earlyWater,
				"Auto Drink yielded to Supervisor Food"
			)
		end
		return
	end

	if state.survivalFoodEmergency(
		earlyFood,
		earlyWater
	) then

		state.forceStopActiveDrink(
			character,
			string.format(
				"CRITICAL FOOD %d%%: stopping Drink immediately",
				math.floor(
					earlyFood
				)
			)
		)

		if state.survivalArbiter.owner == "water" then
			state.survivalArbiterComplete(
				"water"
			)
		end

		state.survivalArbiterAcquire(
			"food",
			earlyFood,
			earlyWater,
			"critical starvation preempted Drink"
		)

		if isSavannahLife
			and state.isGrowthHerbivore(
				character
			)
			and not isGiraffeCharacter(
				character
			)
			and not isBaboonCharacter(
				character
			)
			and not isCarnivoreCharacter(
				character
			) then

			state.startHerbivoreFoodRecovery(
				"critical_hunger_auto_drink_preempt"
			)
		end

		return
	end

	local survivalOwner = state.survivalArbiter.owner

	-- GIRAFFE WATER PRIORITY:
	-- A Giraffe can keep the survival arbiter on "food" while walking to /
	-- interacting with Leaves. Unlike Baboon/carnivores, the old logic had no
	-- normal-thirst handoff, so Auto Drink could remain blocked until Water <=45.
	-- At the normal Drink threshold, immediately release every Giraffe food
	-- controller and hand survival ownership to Water.
	local giraffeWaterYield =
		authoritativeOwner ~= "food"
		and state.autoDrink
		and earlyWater <= 75
		and isGiraffeCharacter(character)
		and (
			survivalOwner == "food"
			or GIRAFFE.busy
			or GIRAFFE.targetTree ~= nil
			or state.questGiraffeFeeding
			or eatingToFull
		)

	if giraffeWaterYield then
		state.questGiraffeFeeding = false
		eatingToFull = false
		eatingSourcePosition = nil
		eatingTargetReachedAt = nil
		eatingStuckSince = nil
		blockClientSubState = false

		GIRAFFE.cancel()

		-- If the Giraffe was still travelling to a Leaves target, stop only that
		-- food SafeMove. The next Auto Drink pass owns movement instead.
		if state.safeMove
			and state.safeMove.active
			and state.safeMove.reason == "food" then

			state.safeMove.cancelToken += 1
		end

		state.survivalForceWaterHandoff(
			character,
			"Giraffe feeding yielded to Water"
		)

		drinkingToFull = true
		survivalOwner = state.survivalArbiter.owner
		runtimeMessage = string.format(
			"Giraffe: Water %d%%; pausing Leaves to drink",
			math.floor(earlyWater)
		)
	end

	local carnivoreWaterYield =
		authoritativeOwner ~= "food"
		and survivalOwner == "food"
		and state.autoEat
		and isCarnivoreCharacter(
			character
		)
		and earlyWater <= 70

	-- Water may temporarily pause a locked carcass, but it must never release it.
	-- After drinking, Auto Eat returns to the same Instance if it still exists.

	if carnivoreWaterYield then
		state.survivalForceWaterHandoff(
			character,
			"Carnivore search yielded to Water"
		)

		drinkingToFull = true
		survivalOwner =
			state.survivalArbiter.owner
	end

	-- Surface Drink arbitration restored from 2.4a: a committed Food route keeps
	-- ownership above critical thirst; normal water search starts when Food releases it.

	-- A committed food route may keep ownership, but it must NOT block a FREE
	-- opportunistic Drink already available under the moving animal. This does
	-- not abandon the carcass/grass destination.
	local preOwnerMovementInteraction

	if state.questMovementOpportunisticInteract then
		preOwnerMovementInteraction =
			state.questMovementOpportunisticInteract(
				character,
				root
			)
	end

	if preOwnerMovementInteraction == "drink"
		or preOwnerMovementInteraction == "drink_grace" then

		return
	end

	if survivalOwner == "food"
		and earlyWater > 45 then

		-- Food route keeps ownership only when there is no free Drink contact.
		return
	end

	if earlyWater <= 75 or travelFullRefillWater or drinkingToFull then
		-- Symmetric arbitration with Auto Eat.
		--
		-- The scheduler executes Auto Drink before Auto Eat. Previously Drink tried
		-- to acquire "water" immediately at <=75, which let Water win purely because
		-- it ran first. Example from the reported Savannah stall:
		-- Food 76 / Water 75. survivalArbiterChoose() says FOOD, but the old Drink
		-- path grabbed Water first and Auto Eat never got a chance to launch the
		-- carcass search.
		if survivalOwner == nil
			and not drinkingToFull then
			local preferredNeed =
				state.survivalArbiterChoose(
					earlyFood,
					earlyWater
				)

			if preferredNeed == "food" then
				return
			end
		end

		if not state.survivalArbiterAcquire(
			"water",
			earlyFood,
			earlyWater,
			earlyWater <= 45
				and "critical thirst preemption"
				or "Auto Drink committed"
		) then
			return
		end

		survivalOwner =
			state.survivalArbiter.owner
	end

	local movementInteraction =
		preOwnerMovementInteraction

	if not movementInteraction
		and state.questMovementOpportunisticInteract then

		movementInteraction =
			state.questMovementOpportunisticInteract(
				character,
				root
			)
	end

	local movingVelocity =
		root.AssemblyLinearVelocity

	local movingPlanarSpeed =
		Vector3.new(
			movingVelocity.X,
			0,
			movingVelocity.Z
		).Magnitude

	local movingDrinkGrace =
		state.questMoveInteract
			and (
				movingPlanarSpeed >= 1.5
					or (
						state.safeMove
						and state.safeMove.active
					)
			)
			and tick()
				< (
					state.questMoveInteract.drinkGraceUntil
						or 0
				)

	-- Water encountered naturally on the running path gets first chance.
	-- Keep the route moving; only if that contact stops helping does the normal
	-- Auto Drink search take ownership.
	if movementInteraction == "drink"
		or movementInteraction == "drink_grace"
		or movingDrinkGrace then

		return
	end

	-- IMPORTANT: Crocodile has a very low/long body. At the CORRECT drinking
	-- position part of the rig can overlap the water volume while the feet/HRP
	-- are still exactly where the game expects them. Never use body-water overlap
	-- alone as a reason to force a dry-bank exit here. Prompt acquisition and
	-- in-place facing correction get first priority; the dedicated aquatic exit
	-- routine is still used after drinking or for a real swimming/escape state.

	-- Croc/Hippo drink from a dry Terrain lip and require MainWaterPart to stay
	-- SOLID during the whole approach. Collision is disabled only by the dedicated
	-- underwater-exit transaction after the animal is already in the water.
	if isAquaticCharacter(character)
		and (earlyWater <= 75 or drinkingToFull) then

		if state.isCrocOrHippoMovementCharacter(
			character
		) then
			setAquaticWaterCollision(
				character,
				true
			)
		else
			setAquaticWaterCollision(
				character,
				true
			)
		end
	end

	-- Crocodile can NEVER use Underground Drink. Its low body/physics make the
	-- hidden-water transit unsafe; Surface Water is mandatory.
	if state.autoDrinkMode == "underground"
		and state.isCrocOrHippoMovementCharacter(
			character
		) then
		-- Effective Surface override only. Preserve autoDrinkPreferredMode so a
		-- later non-aquatic spawn returns to the player's selected backend.
		state.autoDrinkMode = "surface"
		state.drinkClearUndergroundMode()
		runtimeMessage = "Underground Drink is disabled for Crocodile/Hippo; Surface Water forced"
		if state.renderAutoDrinkModeButtons then pcall(state.renderAutoDrinkModeButtons) end
	end

	-- v103 permanent underground Auto Drink mode.
	if state.autoDrinkMode == "underground"
		and isSavannahLife
		and not state.isCrocOrHippoMovementCharacter(
			character
		)
		and (
			earlyWater <= 75
			or travelFullRefillWater
			or (
				drinkingToFull
				and earlyWater < state.questTravelRefillWaterTarget()
			)
		) then

		if state.drinkTest.active then
			return
		end

		if tick()
			< (
				state.drinkTest.retryAfter
				or 0
			) then

			runtimeMessage =
				"Underground Drink: safety cooldown before retry"

			return
		end

		-- Underground mode owns the survival movement from this point.
		drinkingToFull = true
		eatingToFull = false
		eatingSourcePosition = nil
		if not activeCarcassCommitted then
			clearActiveCarcass(false)
		end

		state.questBaboonFeeding = false
		state.questGiraffeFeeding = false

		BABOON.cancel()
		GIRAFFE.cancel()

		if state.safeMove
			and state.safeMove.active then
			state.safeMove.cancelToken += 1
		end

		if state.questSetW then
			pcall(
				state.questSetW,
				false
			)
		end

		runtimeMessage =
			"Underground Drink: preparing protected descent"

		local undergroundCharacter = character

		task.spawn(function()
			state.runUndergroundDrinkTest()

			-- A failure belonging to an OLD Character must never impose the
			-- 8-second Surface fallback on the newly spawned animal.
			if player.Character ~= undergroundCharacter then
				state.drinkTest.retryAfter = 0
				state.drinkTest.forceSurfaceUntil = 0
				return
			end

			-- Strict Underground preference: failure may delay the next protected
			-- attempt briefly, but it must NEVER switch this animal to Surface search.
			if state.drinkTest.lastResult
				== "failed" then

				state.drinkTest.retryAfter =
					tick() + 4
				state.drinkTest.forceSurfaceUntil = 0
			else
				state.drinkTest.retryAfter = 0
				state.drinkTest.forceSurfaceUntil = 0
			end
		end)

		return
	end

	-- Underground is strict when explicitly selected. There is no automatic
	-- Surface-water fallback for Savannah normal animals.

	-- If this mode is selected in another game, keep existing surface behavior
	-- rather than leaving Auto Drink dead.
	if state.autoDrinkMode == "underground"
		and not isSavannahLife
		and earlyWater <= 75 then

		runtimeMessage =
			"Underground Drink is unavailable here; using surface water search"
	end

	-- Defensive Giraffe cleanup: even if Water already owned the arbiter before
	-- this pass, no stale Leaves target/worker may keep state.busy and block Drink.
	if isGiraffeCharacter(character) and earlyWater <= 75 then
		state.questGiraffeFeeding = false
		eatingToFull = false
		eatingSourcePosition = nil
		eatingTargetReachedAt = nil
		eatingStuckSince = nil
		GIRAFFE.cancel()
		blockClientSubState = false

		if state.safeMove
			and state.safeMove.active
			and state.safeMove.reason == "food" then

			state.safeMove.cancelToken += 1
		end

		if state.survivalArbiter.owner ~= "water" then
			state.survivalForceWaterHandoff(
				character,
				"Giraffe Water priority cleanup"
			)
		end

		drinkingToFull = true
	end

	-- Baboon food must NEVER block thirst handling. Cancel its logical ownership
	-- before checking state.busy; if a one-shot AntHill TP is still settling,
	-- Auto Drink will take over on the next scan instead of restarting food.
	if isBaboonCharacter(character) and earlyWater <= 75 then
		state.questBaboonFeeding = false
		eatingToFull = false
		eatingSourcePosition = nil
		activeCarcass = nil
		BABOON.cancel()
		eatingStuckSince = nil
		blockClientSubState = false
	end

	-- Dino water safety watchdog runs BEFORE the generic busy gate. If SafeMove is
	-- the thing wedged inside a rock pocket, waiting for busy=false would make the
	-- recovery impossible. Noclip is emergency-only and is restored immediately.
	if isDinoLife
		and earlyWater <= 75
		and state.dinoWaterRockEscapeWatch(
			character,
			root,
			humanoid,
			earlyWater
		) then
		return
	end

	-- One-frame defensive cleanup if a Food SafeMove was still unwinding after
	-- Water became the survival owner.
	if state.survivalArbiter.owner == "water"
		and earlyWater <= 75
		and state.busy
		and state.safeMove
		and state.safeMove.active
		and state.safeMove.reason == "food" then
		state.safeMove.cancelToken += 1
		state.safeMove.active = false
		state.safeMove.target = nil
		state.safeMove.reason = nil
		state.busy = false
		state.releaseMovementNow(character, true)
	end

	if state.busy then return end

	if state.drinkPostureWatch(character, root, humanoid) then
		return
	end

	local currentAnimalName = CROC.getAnimalName(character)
	if not isGiraffeCharacter(character)
		and (GIRAFFE.busy or GIRAFFE.targetTree) then
		state.questGiraffeFeeding = false
		GIRAFFE.cancel()
	end

	if not isBaboonCharacter(character) and (BABOON.busy or BABOON.targetObject) then
		state.questBaboonFeeding = false
		BABOON.cancel()
	end

	if currentAnimalName ~= CROC.lastDrinkAnimalName then
		local waterPart = workspace:FindFirstChild("MainWaterPart")
		if waterPart and waterPart:IsA("BasePart") then
			if isDinoLife then
				waterPart.CanCollide = false
			elseif state.isCrocOrHippoMovementCharacter(character) then
				waterPart.CanCollide = true
			else
				waterPart.CanCollide = false
			end
		end

		drinkingToFull = false
		drinkingSourcePosition = nil
		drinkingStuckSince = nil
		lastDrinkWatchdogWater = nil
		state.drinkProgressReset()
		state.drinkSearch.currentWaterPoint = nil
		state.drinkSearch.failedCount = 0
		state.drinkSearch.retryAfter = 0
		state.drinkSearch.upsideDownSince = nil
		state.drinkSearch.waterHealth = nil
		state.drinkSearch.waterHealthAt = 0
		state.drinkClearUndergroundMode()
		removeSwimBarrier()
		CROC.lastDrinkAnimalName = currentAnimalName
		CROC.dinoLastMoveAt = nil
	end

	local water = earlyWater

	if state.drinkProgress
		and state.drinkProgress.confirmed
		and drinkingToFull then

		local sinceProgress =
			tick()
			- (
				state.drinkProgress.lastProgressAt
				or 0
			)

		if sinceProgress < 5.0 then
			runtimeMessage =
				"Drinking confirmed; holding current position"

			task.spawn(
				sustainDrinkAtCurrentPrompt
			)

			return
		else
			state.drinkProgressReset()
		end
	end

	if not state.questSwimActive
		and tick() < (state.drinkSearch.retryAfter or 0) then
		-- Comfortable Water can honor the normal cooldown. At dangerous Water,
		-- keep ownership latched so SurvivalBrain can clear/retry the source rather
		-- than leaving the animal idle and allowing quests to steal control.
		if water > 60 then
			drinkingToFull = false
		end
		return
	end

	-- Swim quest + thirst:
	-- Water <=75 now latches a FULL drink cycle. Swim movement pauses until
	-- Water reaches the normal target (~98), then resumes in the same water.
	-- This fixes the old 58 -> 59 single-sip behavior.
	if state.questSwimActive then
		removeSwimBarrier()

		if water <= 75 then
			drinkingToFull = true
		end

		if not drinkingToFull then
			lastDrinkWatchdogWater = water
			return
		end

		state.questSwimLastDrinkAt = tick()
		state.questMotionMoving = false
		state.questMotionMode = nil
		if state.questSetW then state.questSetW(false) end

		local detected =
			detectAvailableFood(character)

		local visualDetected =
			state.drinkVisualPromptVisible
			and state.drinkVisualPromptVisible()

		if detected == "Drink"
			or visualDetected then

			if visualDetected then
				state.drinkLatchVisualPrompt()
			end

			drinkingSourcePosition = root.Position
			runtimeMessage = string.format(
				"Swim paused: drinking to full (%d%%)",
				math.floor(water)
			)
			task.spawn(sustainDrinkAtCurrentPrompt)
		else
			runtimeMessage = string.format(
				"Swim paused: finding drinkable water (%d%%)",
				math.floor(water)
			)
		end

		-- Do not return here. The normal drinking state machine below handles
		-- prompt/search/watchdog/completion while Swim movement remains paused.
	end

	if water <= 75 or travelFullRefillWater then
		-- Reaching this block means the arbiter granted Water ownership. Only now
		-- may Drink clear Food state (normal Water <=75 by itself cannot do it).
		drinkingToFull = true
		eatingToFull = false
		eatingSourcePosition = nil
		if not activeCarcassCommitted then
			clearActiveCarcass(false)
		end
		state.questBaboonFeeding = false
		state.questGiraffeFeeding = false
		BABOON.cancel()
		GIRAFFE.cancel()
		blockClientSubState = false
		runtimeMessage = isBaboonCharacter(character)
			and "Baboon: Water <= 75%; drinking has priority"
			or "Indo beber agua"
	end
	if drinkingToFull and water >= state.questTravelRefillWaterTarget() then
		local wasUnderground = state.drinkSearch.undergroundMode

		state.questTravelActive = false
		state.questLandInputActive = false
		state.questMotionMoving = false
		state.questMotionMode = nil
		if state.questSetW then state.questSetW(false) end

		state.forceStopActiveDrink(
			character,
			"Water full enough; releasing Drinking before next survival job"
		)

		drinkingStuckSince = nil
		lastDrinkWatchdogWater = water
		state.drinkProgressReset()
		state.survivalArbiterNoteProgress("water", water)
		state.survivalArbiterComplete("water")

		if state.autoQuests then
			state.questForceFastRecheckUntil = tick() + 12
		end
		state.drinkSearch.currentWaterPoint = nil
		state.drinkSearch.failedCount = 0
		state.drinkSearch.retryAfter = 0
		state.drinkSearch.upsideDownSince = nil
		state.drinkSearch.waterHealth = nil
		state.drinkSearch.waterHealthAt = 0
		state.drinkTest.emergencyFallback = false

		removeSwimBarrier()

		if isAquaticCharacter(character) then
			-- Keep solid water until dry Terrain is confirmed by the exit routine.
			setAquaticWaterCollision(character, true)
		end

		if state.questSwimActive and not wasUnderground then
			criticalRecoveryActive = false

			-- Drinking can happen at ANY valid water source. Completing that drink
			-- does not mean this puddle is the Swim mission area.
			state.questSwimReady =
				isNearSavedSwimLocation(root, 68)
				and isValidSwimQuestWater(root)

			if state.questSwimReady then
				setSubState("Swimming")
				runtimeMessage =
					"Water full; already at saved Swim location"
			else
				runtimeMessage =
					"Water full; survival check before moving to Swim location"
			end

			state.questForceFastRecheckUntil = tick() + 12
			return
		end

		-- Outside Swim, retain the existing safe post-drink move.
		criticalRecoveryActive = true
		task.spawn(forcePostDrinkMove, wasUnderground)
		return
	end
	if not drinkingToFull then return end

	if state.drinkSearch.undergroundMode then
		if state.drinkUndergroundSafety(character, root, humanoid, water) then
			return
		end
	end

	-- Buried water is invalid unless we deliberately entered the protected
	-- Savannah drought fallback mode.
	-- Do this before prompt/watchdog logic so we react on the very next scan.
	if not isDinoLife
		and not state.drinkSearch.undergroundMode
		and state.drinkIsBuriedUnderTerrain(root) then
		state.drinkEmergencyEscape(
			character,
			root,
			"Watchdog agua: Terrain acima do personagem; abortando fonte"
		)
		return
	end

	if not isAquaticCharacter(character)
		and state.drinkSearch.currentWaterPoint
		and root.Position.Y < state.drinkSearch.currentWaterPoint.Y - 7 then

		state.drinkEmergencyEscape(
			character,
			root,
			"Watchdog agua: personagem afundou demais; abortando fonte"
		)
		return
	end

	if lastDrinkWatchdogWater == nil or water > lastDrinkWatchdogWater then
		lastDrinkWatchdogWater = water
		drinkingStuckSince = tick()
		state.drinkSearch.failedCount = 0

		if state.drinkSearch.undergroundMode then
			state.drinkSearch.undergroundLastProgressAt = tick()
			state.drinkSearch.undergroundLastWater = water
		end
	elseif not drinkingStuckSince then
		drinkingStuckSince = tick()
	end
	if drinkingStuckSince and tick() - drinkingStuckSince >= 6 then
		lastDrinkWatchdogWater = water
		drinkingStuckSince = tick()

		if not state.isCrocOrHippoMovementCharacter(
			character
		)
			and detectAvailableFood(character) ~= "Drink"
			and not (
				state.drinkVisualPromptVisible
				and state.drinkVisualPromptVisible()
			) then
			state.drinkAbandonCurrent("Agua sem prompt/progresso; descartando ponto e procurando outro")
			return
		end

		virtualDrinkKick()
		return
	end

	-- Se o prompt já está disponível, não reposiciona nem deixa outra rotina
	-- assumir o personagem: simplesmente mantém a posição e bebe.
	local drinkDetectedNow =
		detectAvailableFood(character)

	local visualDrinkNow =
		state.drinkVisualPromptVisible
		and state.drinkVisualPromptVisible()

	if drinkDetectedNow == "Drink"
		or visualDrinkNow then

		if visualDrinkNow then
			state.drinkLatchVisualPrompt()
		end

		drinkingSourcePosition = root.Position

		-- Não congele o ragdoll se ele chegou de ponta-cabeça.
		if state.drinkIsUpsideDown(root) then
			state.drinkUprightCharacter(
				character,
				root,
				state.drinkSearch.currentWaterPoint
			)
		else
			root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
			root.AssemblyAngularVelocity = Vector3.zero
		end

		runtimeMessage = "Prompt de agua detectado; bebendo"
		setSubState("Drinking")
		task.spawn(sustainDrinkAtCurrentPrompt)
		return
	end

	-- Dino Life now uses the SAME exposed-water finder, bank positioning and
	-- sustained Drinking remote as Savannah. No fixed DINO_DRINK_POSITION route.


	local isCrocHippo =
		state.isCrocOrHippoMovementCharacter(
			character
		)

	if isCrocHippo then
		-- Croc/Hippo drink from the Terrain lip with normal water collision.
		setAquaticWaterCollision(
			character,
			true
		)
	end

	local isAquatic = isAquaticCharacter(character)

	if drinkingSourcePosition and (root.Position - drinkingSourcePosition).Magnitude <= 16 then
		if not state.drinkSearch.undergroundMode
			and state.drinkIsBuriedUnderTerrain(root) then
			state.drinkEmergencyEscape(
				character,
				root,
				"Fonte lembrada ficou sob Terrain; saindo"
			)
			return
		end

		local detectedHere =
			detectAvailableFood(character)

		local visualHere =
			state.drinkVisualPromptVisible
			and state.drinkVisualPromptVisible()

		if detectedHere == "Drink"
			or visualHere then

			if visualHere then
				state.drinkLatchVisualPrompt()
			end

			runtimeMessage = "Bebendo ate encher"

			if isAquatic then
				setAquaticWaterCollision(
					character,
					true
				)
			end

			if state.drinkIsUpsideDown(root) then
				state.drinkUprightCharacter(
					character,
					root,
					state.drinkSearch.currentWaterPoint
				)
			end

			setSubState("Drinking")
			task.spawn(sustainDrinkAtCurrentPrompt)
			return
		end

		-- We reached the selected water but the game itself says Drink is not
		-- available. Give physics/prompt a short grace period, then blacklist it.
		if drinkingStuckSince and tick() - drinkingStuckSince >= 3.5 then
			state.drinkAbandonCurrent("Poca/agua nao utilizavel; mudando para outra fonte")
			return
		end
	end

	-- Mode 1: prefer exposed/above-Terrain water whenever it exists.
	local spot = state.drinkFindAccessibleSpot(root.Position, character)

	-- Movement-only mode cannot safely cross solid Terrain to the hidden
	-- MainWaterPart. During drought, only exposed/physically reachable water
	-- is accepted.
	if not spot and isSavannahLife then
		state.drinkClearUndergroundMode()
		runtimeMessage =
			"Drought: no exposed water found; underground clipping disabled"
	end

	if not spot
		and isDinoLife
		and state.dinoDrinkFastScan
		and state.dinoDrinkFastScan.lockedCharacter == character
		and tick() <= (state.dinoDrinkFastScan.lockedUntil or 0)
		and state.dinoDrinkFastSpotStillUsable(
			state.dinoDrinkFastScan.lockedSpot,
			root.Position,
			character
		) then

		spot =
			state.dinoDrinkFastScan.lockedSpot
	end

	if not spot
		and (isSavannahLife or isDinoLife)
		and state.autoDrinkMode == "surface"
		and not isAquatic
		and not state.isCrocOrHippoMovementCharacter(character)
		and not (
			type(state.isFlyingMovementCharacter) == "function"
			and state.isFlyingMovementCharacter(character)
		) then

		local transitReason
		spot, transitReason =
			state.drinkSurfaceSearchTransit(
				character
			)

		if not state.autoDrink
			or state.autoDrinkMode ~= "surface"
			or state.questGrowthReset.exclusive
			or criticalRecoveryActive
			or transitReason == "character_changed"
			or transitReason == "drink_disabled"
			or transitReason == "priority"
			or transitReason == "full" then
			return
		end

		-- The search transit can run for a long distance, so refresh all live
		-- references before using the normal precise Surface Drink approach.
		character, root, humanoid = characterParts()
		if not character or not root or not humanoid then
			return
		end

		water = tonumber(character:GetAttribute("Water")) or water
	end

	if not spot then
		-- Dino Life has no Underground Drink fallback. At <=70 Water remains the
		-- survival owner and the spawn-search watchdog keeps cycling locations.
		-- Never release control back to a carcass for 10 seconds while thirst drops.
		if isDinoLife and water <= 70 then
			state.drinkSearch.failedCount = 0
			state.drinkSearch.retryAfter = tick() + 0.20
			drinkingToFull = true
			eatingToFull = false
			eatingSourcePosition = nil
			state.survivalForceWaterHandoff(
				character,
				"Dino water watchdog continuing spawn search"
			)
			runtimeMessage =
				"Dino water watchdog: no water here; trying another spawn"
			return
		end

		-- v107 EMERGENCY RULE:
		-- If Surface Water cannot find a usable puddle/river and Water is
		-- already below 70%, temporarily use the protected underground backend.
		-- This does NOT change autoDrinkMode or the player's saved preference.
		local emergencyUnderground =
			isSavannahLife
				and water < 70
				and state.autoDrinkMode == "surface"
				and not state.isCrocOrHippoMovementCharacter(
					character
				)

		if emergencyUnderground then
			state.drinkSearch.failedCount = 0
			state.drinkSearch.retryAfter = 0

			drinkingToFull = true
			eatingToFull = false
			eatingSourcePosition = nil
			if not activeCarcassCommitted then
				clearActiveCarcass(false)
			end

			state.questBaboonFeeding = false
			state.questGiraffeFeeding = false
			state.questTravelActive = false
			state.questLandInputActive = false
			state.questMotionMoving = false
			state.questMotionMode = nil

			BABOON.cancel()
			GIRAFFE.cancel()

			if state.questSetW then
				pcall(
					state.questSetW,
					false
				)
			end

			if state.safeMove
				and state.safeMove.active then
				state.safeMove.cancelToken += 1
			end

			if state.drinkTest.active
				or state.drinkTest.emergencyFallback then

				runtimeMessage =
					string.format(
						"Emergency Underground Drink active (Water %d%%)",
						math.floor(water)
					)

				return
			end

			if tick()
				< (
					state.drinkTest.retryAfter or 0
				) then

				runtimeMessage =
					string.format(
						"Emergency Underground Drink cooling down (Water %d%%)",
						math.floor(water)
					)

				return
			end

			state.drinkTest.emergencyFallback = true

			runtimeMessage =
				string.format(
					"No safe surface water found at %d%%; emergency Underground Drink",
					math.floor(water)
				)

			task.spawn(function()
				local ok, err =
					pcall(
						state.runUndergroundDrinkTest
					)

				state.drinkTest.emergencyFallback = false
				state.drinkSearch.failedCount = 0
				state.drinkSearch.retryAfter = 0

				if not ok then
					state.drinkTest.lastResult = "failed"
					state.drinkTest.lastError =
						tostring(err)
					state.drinkTest.retryAfter =
						tick() + 4

					runtimeMessage =
						"Emergency Underground Drink error; retrying safely"

					return
				end

				if state.drinkTest.lastResult == "failed" then
					state.drinkTest.retryAfter =
						tick() + 4
				else
					state.drinkTest.retryAfter = 0
				end
			end)

			return
		end

		-- Above the emergency threshold, keep the normal surface retry behavior.
		state.drinkSearch.failedCount =
			(state.drinkSearch.failedCount or 0) + 1

		runtimeMessage =
			"No exposed water reachable with safe movement"

		if state.drinkSearch.failedCount >= 2 then
			state.drinkSearch.failedCount = 0
			state.drinkSearch.retryAfter = tick() + 10
			drinkingToFull = false

			-- A Surface search cooldown must release the arbiter too, otherwise
			-- Auto Eat sees owner="water" and remains dead even though Drink backed off.
			if state.survivalArbiter
				and state.survivalArbiter.owner == "water" then
				state.survivalArbiterComplete("water")
			end

			runtimeMessage =
				"Water search failed; Auto Run/Food released for 10s"
		end

		return
	end

	-- Dino Life: do NOT judge the current standing surface before movement.
	-- Being close to water while still on ordinary high ground is normal for Rex
	-- and was causing the false "water below rock" rejection. The destination bank
	-- itself has already passed shoreline validation; verify the actual support only
	-- after SafeMove reaches that bank.

	-- Final pre-TP validation only for normal exposed drinking. Underground
	-- fallback is intentionally underneath Terrain and has its own watchdog.
	if not spot.underground
		and not isAquatic
		and state.drinkLandingCovered(spot.stand) then
		state.drinkMarkFailed(spot.water, 300)
		state.drinkSearch.currentWaterPoint = nil
		runtimeMessage = "Fonte rejeitada: ponto de bebida esta sob Terrain"
		return
	end

	state.drinkSearch.currentWaterPoint = spot.water
	state.drinkSearch.promptStopAt = nil
	state.drinkSearch.promptStopTime = nil

	if spot.underground then
		state.drinkSearch.undergroundMode = true
		state.drinkSearch.undergroundSince = tick()
		state.drinkSearch.undergroundLastProgressAt = tick()
		state.drinkSearch.undergroundLastWater = water
		state.drinkSearch.waterHealth = humanoid.Health
		state.drinkSearch.waterHealthAt = tick()
		runtimeMessage = "Descendo para MainWaterPart subterranea com watchdog anti-afogamento"
	else
		state.drinkClearUndergroundMode()

		local routeDistance =
			Vector3.new(
				spot.stand.X - root.Position.X,
				0,
				spot.stand.Z - root.Position.Z
			).Magnitude

		runtimeMessage =
			string.format(
				isDinoLife
					and spot.dinoOpenWater
					and "Dino: going to nearby open water (%s, %.0f studs, open %d/4)"
					or "Indo para agua exposta (%s, %.0f studs)",
				tostring(
					spot.source
				),
				routeDistance,
				tonumber(
					spot.dinoOpenWater
				) or 0
			)
	end

	local landed

	if isCroc then
		-- Croc: stay on Terrain at the selected bank with collision enabled.
		setAquaticWaterCollision(character, true)

		landed = state.surfaceDrinkRouteMove(
			spot.stand,
			9,
			spot.water,
			{
				purpose = "water",
				underground = spot.underground == true,
				tolerance =
					spot.source == "MainWaterPart"
						and math.clamp(state.movementFootprint(character) * 0.22, 2.0, 3.8)
						or 3.0,
				speedScale = 0.72,
				constantSpeed = true,
				riverApproach =
					spot.source
						== "MainWaterPart",
				riverApproachRadius = 36,
				maxDuration = 300,
			}
		)
	elseif isAquatic then
		setAquaticWaterCollision(character, true)

		landed = state.surfaceDrinkRouteMove(
			spot.stand,
			10,
			spot.water,
			{
				purpose = "water",
				underground = spot.underground == true,
				tolerance = math.clamp(state.movementFootprint(character) * 0.48, 4.5, 8),
				speedScale = 0.72,
				maxDuration = 300,
			}
		)
	else
		-- Land animals must reach the selected bank precisely. The old 9-stud
		-- tolerance could stop on the dry strip between adjacent puddles.
		landed = state.surfaceDrinkRouteMove(
			spot.stand,
			8,
			spot.water,
			{
				purpose = "water",
				underground = spot.underground == true,
				tolerance =
					spot.source
						== "MainWaterPart"
						and 1.15
						or 2.75,
				speedScale = 1,
				riverApproach =
					spot.source
						== "MainWaterPart",
				riverApproachRadius = 36,
				maxDuration = 240,

				-- Do not judge ordinary higher ground during the approach. But once Rex is
				-- essentially on the target X/Z, it MUST also be physically down at water
				-- level. This prevents the legacy flat-distance completion from accepting
				-- a rock ledge directly above the intended Terrain bank.
				routeCheckInterval = isDinoLife and 0.55 or nil,
				routeCheck = isDinoLife and function(liveCharacter, liveRoot)
					if not state.autoDrink then
						return true, "drink_disabled"
					end

					if state.drinkGamePromptAvailable
						and state.drinkGamePromptAvailable(liveCharacter) then
						return false
					end

					local flatToWater = Vector3.new(
						spot.water.X - liveRoot.Position.X,
						0,
						spot.water.Z - liveRoot.Position.Z
					).Magnitude

					if flatToWater <= 1.75
						and state.dinoDrinkArrivalRejected(
							liveCharacter,
							liveRoot,
							spot.water
						) then
						state.drinkMarkFailed(spot.water, 120)
						return true, "dino_not_at_water_level"
					end

					return false
				end or nil,
			}
		)
	end

	if not landed then
		state.drinkAbandonCurrent("Falhou ao chegar na fonte; procurando outra")
		return
	end

	task.wait(
		spot.underground
			and 0.45
			or (isAquatic and 0.22 or 0.08)
	)

	local _, newRoot = characterParts()
	if not newRoot then
		state.drinkAbandonCurrent("Personagem sumiu ao chegar na agua; procurando outra")
		return
	end

	if not spot.underground and state.drinkIsBuriedUnderTerrain(newRoot) then
		state.drinkEmergencyEscape(
			character,
			newRoot,
			"BUG DE AGUA: personagem caiu sob Terrain; escapando imediatamente"
		)
		return
	end

	-- Land animals should remain around the bank/water surface. If the HRP
	-- somehow sank deeply below the selected water, treat it as the same bug.
	if not spot.underground
		and not isAquatic
		and state.drinkSearch.currentWaterPoint
		and newRoot.Position.Y < state.drinkSearch.currentWaterPoint.Y - 7 then

		state.drinkEmergencyEscape(
			character,
			newRoot,
			"BUG DE AGUA: animal afundou abaixo da fonte; escapando"
		)
		return
	end

	-- Dino Life: navigation success is not enough. A large dinosaur can stand on
	-- a high rock whose X/Z overlaps the water and then try to drink far below.
	if not spot.underground
		and isDinoLife
		and not isAquatic
		and state.dinoDrinkArrivalRejected(
			character,
			newRoot,
			spot.water
		) then

		state.drinkAbandonCurrent(
			"Dino Drink: high/blocked bank rejected; searching another shoreline"
		)
		return
	end

	-- v125: exposed-water arrival handshake for the MoveTo engine.
	-- Once navigation succeeded, interaction gets a stationary transaction.
	if not spot.underground then
		local acquired,
			heldRoot =
				state.drinkAcquirePromptAfterMove(
					spot,
					character,
					newRoot,
					humanoid,
					water
				)

		newRoot =
			heldRoot or newRoot

		if not acquired then
			state.drinkAbandonCurrent(
				"Chegou na agua, mas Drink nao confirmou apos parada controlada"
			)

			return
		end

		drinkingSourcePosition =
			newRoot.Position

		drinkingStuckSince =
			tick()

		lastDrinkWatchdogWater =
			water

		state.drinkSearch.failedCount =
			0

		if isAquatic then
			setAquaticWaterCollision(
				character,
				true
			)
		end

		runtimeMessage =
			"Fonte confirmada; iniciando bebida sem sair da margem"

		setSubState(
			"Drinking"
		)

		task.spawn(
			sustainDrinkAtCurrentPrompt
		)

		return
	end

	local detectedAfterArrival =
		detectAvailableFood(character)

	local visualAfterArrival =
		state.drinkVisualPromptVisible
		and state.drinkVisualPromptVisible()

	if visualAfterArrival then
		state.drinkLatchVisualPrompt()
		detectedAfterArrival = "Drink"
	end

	if detectedAfterArrival ~= "Drink" then
		local flat = Vector3.new(
			spot.water.X - newRoot.Position.X,
			0,
			spot.water.Z - newRoot.Position.Z
		)
		if flat.Magnitude > 0.5 then
			pcall(function()
				newRoot.CFrame = CFrame.lookAt(
					newRoot.Position,
					newRoot.Position + flat.Unit,
					Vector3.yAxis
				)
			end)
		end

		if spot.underground then
			local promptDeadline = tick() + 4.0

			repeat
				if state.drinkUndergroundSafety(
					character,
					newRoot,
					humanoid,
					water
				) then
					return
				end

				setSubState("Drinking")
				task.wait(0.25)
				detectedAfterArrival = detectAvailableFood(character)
			until detectedAfterArrival == "Drink" or tick() >= promptDeadline
		else
			task.wait(0.35)
			detectedAfterArrival = detectAvailableFood(character)
		end
	end

	-- v92: NO second movement/refinement at the shoreline.
	-- Once safeMoveToPosition reached spot.stand, the animal stays there.
	-- We only re-check the prompt once after a short stationary grace period.
	if detectedAfterArrival ~= "Drink"
		and not spot.underground then

		newRoot.AssemblyLinearVelocity =
			Vector3.new(
				0,
				newRoot.AssemblyLinearVelocity.Y,
				0
			)

		newRoot.AssemblyAngularVelocity =
			Vector3.zero

		if state.questSetW then
			pcall(state.questSetW, false)
		end

		task.wait(0.30)

		character, newRoot = characterParts()

		if character and newRoot then
			detectedAfterArrival =
				detectAvailableFood(character)

			local visualAfterStationary =
				state.drinkVisualPromptVisible
				and state.drinkVisualPromptVisible()

			if visualAfterStationary then
				state.drinkLatchVisualPrompt()
				detectedAfterArrival = "Drink"
			end
		end
	end

	if detectedAfterArrival ~= "Drink" then
		if spot.underground then
			state.drinkEmergencyEscape(
				character,
				newRoot,
				"Agua subterranea sem prompt Drink; saindo imediatamente"
			)
		else
			state.drinkAbandonCurrent(
				"Selected bank had no Drink prompt; trying another water source"
			)
		end
		return
	end

	drinkingSourcePosition = newRoot.Position
	drinkingStuckSince = tick()
	lastDrinkWatchdogWater = water
	state.drinkSearch.failedCount = 0

	if spot.underground then
		state.drinkSearch.undergroundSince = tick()
		state.drinkSearch.undergroundLastProgressAt = tick()
		state.drinkSearch.undergroundLastWater = water
	end

	if state.drinkIsUpsideDown(newRoot) then
		state.drinkUprightCharacter(character, newRoot, spot.water)
	end

	-- Barrier only after the game confirms the source is actually drinkable.
	-- We never freeze the animal beside an invalid puddle anymore.
	if isAquatic then
		updateSwimBarrier(newRoot, true)
	end

	runtimeMessage = spot.underground
		and "Agua subterranea valida; bebendo com watchdog ativo"
		or "Fonte exposta valida confirmada; bebendo"
	setSubState("Drinking")

	task.spawn(sustainDrinkAtCurrentPrompt)
end

function state.drinkRefineSelectedBankPrompt(spot, character, root)
	-- v92 compatibility stub:
	-- Refinement movement was removed. This function NEVER moves, turns,
	-- nudges, jumps, or starts SafeMove. It only reports whether Drink is
	-- already available at the current position.
	if not spot
		or not character
		or not root
		or spot.underground then
		return false
	end

	if detectAvailableFood(character) == "Drink" then
		return true
	end

	if state.drinkVisualPromptVisible
		and state.drinkVisualPromptVisible() then
		state.drinkLatchVisualPrompt()
		return true
	end

	return false
end


local function isInsideTerrain(character, root)
	if not character or not root then return false end
	local region = Region3.new(root.Position - Vector3.new(2,2,2), root.Position + Vector3.new(2,2,2)):ExpandToGrid(4)
	local ok, _, occupancy = pcall(function()
		local materials, values = workspace.Terrain:ReadVoxels(region, 4)
		return materials, values
	end)
	return ok and occupancy and occupancy[1][1][1] > 0.55
end

local function resolveReplication()
	if shared._playerDataReplication and type(shared._playerDataReplication.GetKeyData) == "function" then
		return shared._playerDataReplication
	end
	for _, root in ipairs({ ReplicatedStorage, player:FindFirstChild("PlayerScripts"), player:FindFirstChild("PlayerGui") }) do
		local module = root and root:FindFirstChild("PlayerDataReplication", true)
		if module and module:IsA("ModuleScript") then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" and type(result.GetKeyData) == "function" then
				shared._playerDataReplication = result
				return result
			end
		end
	end
end

local function savedCharacters()
	local replication = resolveReplication()
	if not replication then runtimeMessage = "Dados de slots nao encontrados"; return {} end
	local ok, records = pcall(replication.GetKeyData, "SavedCharacters")
	if (not ok or type(records) ~= "table") and type(replication.GetData) == "function" then
		local dataOk, data = pcall(replication.GetData)
		if dataOk and type(data) == "table" then
			records = data.SavedCharacters
			ok = type(records) == "table"
		end
	end
	if not ok or type(records) ~= "table" then
		runtimeMessage = "Falha ao ler SavedCharacters"
		return {}
	end

	local normalized = {}
	for key, entry in pairs(records) do
		if type(entry) == "table" then
			if not entry.CharacterName and type(key) == "string" then
				entry.CharacterName = key
			end
			table.insert(normalized, entry)
		end
	end
	table.sort(normalized, function(a, b)
		return tostring(a.CharacterName or "") < tostring(b.CharacterName or "")
	end)
	return normalized
end

local function motherNameFor(entry)
	if type(entry) ~= "table" or (entry.GrowthPercentage or 1) > 0.01 then return nil end
	local remote = ReplicatedStorage:FindFirstChild("BabySpawnsRequestMotherNamesRemoteFunction")
	if not remote then return nil end
	local ok, result = pcall(remote.InvokeServer, remote, entry.AnimalName)
	if not ok then return nil end
	if type(result) == "string" then return result end
	if type(result) == "table" then
		for _, value in pairs(result) do
			if type(value) == "string" then return value end
			if type(value) == "table" then return value.PlayerName or value.Name or value.Username end
		end
	end
end

local function spawnSlot(
	entry,
	skipSafeMove,
	strictExpected
)
	local uniqueName = type(entry) == "table"
		and (entry.UniqueCharacterName or entry.CharacterName)
	if not SpawnRemote or not uniqueName then return false end

	local expectedName =
		entry.CharacterName

	local expectedUnique =
		entry.UniqueCharacterName
			or entry.CharacterUniqueName

	local expectedAnimal =
		entry.AnimalName

	state.questExpectedSlot = {
		uniqueName =
			expectedUnique
				or expectedName,
		characterName = expectedName,
		animalName = expectedAnimal,
		requestedAt = tick(),
	}

	runtimeMessage = "Trocando para " .. tostring(expectedName)

	if state.slotGuardianMarkPlanned then
		state.slotGuardianMarkPlanned(
			"script spawn -> "
				.. tostring(expectedName),
			24
		)
	end

	local mother = motherNameFor(entry)
	local oldCharacter = player.Character
	local ok = pcall(function()
		if mother then
			SpawnRemote:InvokeServer(uniqueName, mother)
		else
			SpawnRemote:InvokeServer(uniqueName)
		end
	end)

	if not ok then
		state.questExpectedSlot = nil
		runtimeMessage = "Spawn falhou: " .. tostring(expectedName)
		return false
	end

	local deadline = tick() + 16
	local changedSince
	local matched

	repeat
		task.wait(0.25)

		local candidate = player.Character
		local root = candidate and candidate:FindFirstChild("HumanoidRootPart")

		if candidate and root then
			if candidate ~= oldCharacter then
				changedSince = changedSince or tick()
			end

			local charName =
				candidate:GetAttribute(
					"CharacterName"
				)

			local candidateUnique =
				candidate:GetAttribute(
					"UniqueCharacterName"
				)
				or candidate:GetAttribute(
					"CharacterUniqueName"
				)

			local animalName =
				candidate:GetAttribute(
					"AnimalName"
				)

			local nameMatches =
				type(expectedName) == "string"
				and expectedName ~= ""
				and charName == expectedName

			local uniqueMatches =
				type(expectedUnique) == "string"
				and expectedUnique ~= ""
				and (
					candidateUnique == expectedUnique
						or charName == expectedUnique
				)

			local animalMatches =
				type(expectedAnimal) == "string"
				and state.questAnimalKey(animalName)
					== state.questAnimalKey(expectedAnimal)

			if nameMatches
				or uniqueMatches
				or (
					not strictExpected
					and animalMatches
				) then

				matched = candidate
				break
			end

			-- New Character but attributes are still loading.
			-- For a quest-only slot transaction we KNOW the exact requested
			-- CharacterName + AnimalName, so never accept a different spawned
			-- character merely because two seconds elapsed.
			if not strictExpected
				and candidate ~= oldCharacter
				and changedSince
				and tick() - changedSince >= 2 then

				matched = candidate
				break
			end
		end
	until tick() >= deadline

	if not matched then
		state.questExpectedSlot = nil
		runtimeMessage = "Spawn nao confirmou o slot " .. tostring(expectedName)
		return false
	end

	task.wait(1)
	state.questExpectedSlot = nil

	if not skipSafeMove then
		local postSpawnTarget =
			state.growthPrideRestrictionActive(
				matched
			)
			and state.growthPride.home
			or getSafeFarmPosition()

		local prideGrowthSpawn =
			state.growthPrideRestrictionActive(
				matched
			)

		safeMoveToPosition(
			postSpawnTarget,
			8,
			nil,
			{
				purpose = "spawn",
				-- Small herbivores must use the same reliable world-space MoveTo
				-- motor as Move To Locations when being staged into Pride Rock.
				forceMoveToLand = prideGrowthSpawn,
				tolerance = prideGrowthSpawn and 55 or 18,
				maxDuration = 300,
			}
		)
	end

	if state.slotGuardian then
		state.slotGuardian.plannedUntil =
			0

		state.slotGuardian.plannedReason =
			nil
	end

	if state.slotGuardianRemember then
		pcall(
			state.slotGuardianRemember,
			matched
		)
	end

	runtimeMessage = "Slot ativo: " .. tostring(expectedName)
	return true
end

function state.questSlotsNormalizeControl(character)
	character =
		character
		or player.Character

	if not character then
		return false
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not root or not humanoid then
		return false
	end

	-- A quest slot must never inherit a movement lock from SafeMove,
	-- underground transit, a reset transaction, or a previous execution.
	character:SetAttribute(
		"MovementDisabled",
		false
	)

	pcall(function()
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true

		if humanoid:GetState()
			== Enum.HumanoidStateType.Physics then

			humanoid:ChangeState(
				Enum.HumanoidStateType.GettingUp
			)
		end

		humanoid:Move(
			Vector3.zero,
			false
		)
	end)

	local velocity =
		root.AssemblyLinearVelocity

	root.AssemblyLinearVelocity =
		Vector3.new(
			0,
			velocity.Y,
			0
		)

	root.AssemblyAngularVelocity =
		Vector3.zero

	blockClientSubState = false

	if state.questSetW then
		pcall(
			state.questSetW,
			false
		)
	end

	if state.questSetLandPermanentW then
		pcall(
			state.questSetLandPermanentW,
			false
		)
	end

	return true
end

function state.questSlotsCurrentPositionSafe()
	local character, root =
		characterParts()

	if not character or not root then
		return false
	end

	if root.Position.Y
		<= config.dangerY + 8 then
		return false
	end

	if state.drinkIsBuriedUnderTerrain
		and state.drinkIsBuriedUnderTerrain(
			root
		) then
		return false
	end

	if state.isBodyActuallyInWater
		and state.isBodyActuallyInWater(
			character,
			root
		) then
		return false
	end

	return state.normalizeDryLandState
		and state.normalizeDryLandState(
			character,
			root
		)
end

function state.questSlotsPrepareForCreate()
	local character =
		player.Character

	if not character then
		return false
	end

	state.questSlotsNormalizeControl(
		character
	)

	-- Slot-switch point belongs to the OUTGOING animal. Never reset first and
	-- let the replacement animal perform the staging walk afterward.
	runtimeMessage =
		"Quest slot: staging current animal before switch"

	if state.moveBeforeSlotChange then
		return state.moveBeforeSlotChange()
	end

	return false
end

function state.questSlotsFinishTransaction(
	message,
	forceRecheck
)
	state.questSlots.busy = false
	questSwitchingAnimal = false

	state.questSlotsNormalizeControl(
		player.Character
	)

	if forceRecheck ~= false then
		state.questForceFastRecheckUntil =
			tick() + 25
	end

	if message then
		runtimeMessage = message
	end
end

local slotIndex = 0
local sessionCompletedSlots = {}
local function isGrowthComplete(value)
	value = tonumber(value)
	if value == nil then return false end
	if value <= 1 then return value >= 0.999 end
	return value >= 99.9
end

local function nextExistingSlot(animalName, records, includeAllAnimals)
	records = records or savedCharacters()
	if #records == 0 then return nil end

	local currentCharacter = player.Character
	local currentName = currentCharacter
		and currentCharacter:GetAttribute("CharacterName")

	for _ = 1, #records do
		slotIndex = slotIndex % #records + 1
		local entry = records[slotIndex]
		local name = type(entry) == "table"
			and entry.CharacterName

		local animalAllowed =
			includeAllAnimals == true
			or (
				type(entry) == "table"
				and not state.questIsFlyingAnimalName(entry.AnimalName)
				and (
					not animalName
					or entry.AnimalName == animalName
				)
			)

		if type(name) == "string"
			and name ~= ""
			and name ~= currentName
			and not sessionCompletedSlots[name]
			and animalAllowed
			and not isGrowthComplete(entry.GrowthPercentage) then

			runtimeMessage = includeAllAnimals
				and string.format(
					"AUTO Grow All: next %s slot -> %s (%s%%)",
					tostring(entry.AnimalName or "animal"),
					name,
					tostring(entry.GrowthPercentage or "?")
				)
				or string.format(
					"Testando slot: %s (salvo: %s)",
					name,
					tostring(entry.GrowthPercentage or "?")
				)

			return entry
		end
	end
end


