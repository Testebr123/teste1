		and state.safeMove
		and state.safeMove.active
		and (
			state.safeMove.reason == "water"
			or state.safeMove.reason == "water_search"
		) then

		local physicalProgressAt =
			tonumber(state.safeMove.lastProgressAt)
			or tonumber(state.safeMove.startedAt)
			or now

		local lease =
			ai.MovementManager
			and ai.MovementManager.lease

		if lease and lease.owner == "Water" then
			physicalProgressAt = math.max(
				physicalProgressAt,
				tonumber(lease.lastProgressAt) or 0
			)
		end

		if now - physicalProgressAt <= 4.5 then
			progressed = true
		end

		local schedulerLate =
			ai.Health
			and (
				now - (ai.Health.criticalAt or now) > 0.75
				or now - (ai.Health.coordinationAt or now) > 1.6
			)

		if schedulerLate then
			-- A late heartbeat is not proof that Water failed. Reset the generic
			-- Supervisor timer instead of starting a cancel/restart storm.
			self.progressAt = now
			self.progressPosition = context.position
			self.progressDistance = distance
			return
		end
	end

