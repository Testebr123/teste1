function state.questGroup.resolveHandler()
	if state.questGroup.handler and type(state.questGroup.handler.GetData) == "function" then
		return state.questGroup.handler
	end

	local scripts = player:FindFirstChild("PlayerScripts")
	local framework = scripts and scripts:FindFirstChild("AnimalGameFramework")
	local external = framework and framework:FindFirstChild("ExternalAccessModules")
	local module = external and external:FindFirstChild("PackHandlerClient")
	if not module then
		module = scripts and scripts:FindFirstChild("PackHandlerClient", true)
	end
	if not module or not module:IsA("ModuleScript") then return nil end

	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		state.questGroup.handler = result
		return result
	end
end

function state.questGroup.samePlayer(a, b)
	if a == b then return true end
	if not a or not b then return false end
	local okA, idA = pcall(function() return a.UserId end)
	local okB, idB = pcall(function() return b.UserId end)
	return okA and okB and idA ~= nil and idA == idB
end

function state.questGroup.getPlayerTeamName(targetPlayer)
	if not targetPlayer then return nil end

	local ok, team =
		pcall(function()
			return targetPlayer.Team
		end)

	if not ok or not team then
		return nil
	end

	local name

	if typeof(team) == "Instance" then
		name = team.Name
	elseif type(team) == "string" then
		name = team
	end

	if type(name) == "string"
		and name ~= "" then
		return name
	end

	return nil
end

function state.questGroup.getPlayerMMBTeamName(targetPlayer)
	local name =
		state.questGroup.getPlayerTeamName(
			targetPlayer
		)

	if type(name) == "string"
		and name:match("^MMB[%w]$") then
		return name
	end

	return nil
end

function state.questGroup.getPlayerAnimal(targetPlayer)
	if not targetPlayer then return nil end
	local character = targetPlayer.Character or workspace:FindFirstChild(targetPlayer.Name)
	if not character then return nil end
	local animal = character:GetAttribute("AnimalName")
	if type(animal) == "string" and animal ~= "" then return animal end
	local value = character:FindFirstChild("AnimalName")
	if value and value:IsA("StringValue") and value.Value ~= "" then return value.Value end
end

function state.questGroup.sameAnimal(a, b)
	return type(a) == "string" and type(b) == "string" and a:lower() == b:lower()
end

function state.questGroup.getPlayerPack(
	handler,
	targetPlayer
)
	if not handler
		or not targetPlayer then
		return nil
	end

	local teamMMBName =
		state.questGroup.getPlayerMMBTeamName(
			targetPlayer
		)

	if type(handler.GetPlayerPackData)
		== "function" then

		local ok, pack =
			pcall(
				handler.GetPlayerPackData,
				targetPlayer
			)

		if not ok then
			ok, pack =
				pcall(
					handler.GetPlayerPackData,
					handler,
					targetPlayer
				)
		end

		if ok and type(pack) == "table" then
			if teamMMBName
				and state.questGroup.getMMBPackName then

				local directName =
					state.questGroup.getMMBPackName(
						pack
					)

				if type(directName) == "string"
					and directName:lower()
						== teamMMBName:lower() then

					return pack
				end

				-- Team says the player is in another MMB pack. Treat this direct
				-- result as stale and continue to the all-pack scan.
			else
				return pack
			end
		end
	end

	-- If direct player-pack replication is late, scan all packs too.
	if type(handler.GetData)
		== "function" then

		local ok, packs =
			pcall(
				handler.GetData
			)

		if not ok then
			ok, packs =
				pcall(
					handler.GetData,
					handler
				)
		end

		if ok and type(packs) == "table" then
			for _, candidate in pairs(
				packs
			) do
				if type(candidate)
					== "table" then

					-- Player.Team is authoritative for MMB membership. The game sets
					-- Team to the pack name (e.g. MMB3) before PackHandler membership
					-- tables are always fully replicated.
					if teamMMBName
						and state.questGroup.getMMBPackName then

						local candidateName =
							state.questGroup.getMMBPackName(
								candidate
							)

						if type(candidateName) == "string"
							and candidateName:lower()
								== teamMMBName:lower() then

							return candidate
						end
					end

					if candidate.Owner
						and state.questGroup.samePlayer(
							candidate.Owner,
							targetPlayer
						) then
						return candidate
					end

					if type(
						candidate.NormalMembers
					) == "table" then

						for _, member in pairs(
							candidate.NormalMembers
						) do
							if member
								and state.questGroup.samePlayer(
									member,
									targetPlayer
								) then
								return candidate
							end
						end
					end
				end
			end
		end
	end

	return nil
end

function state.questGroup.requestJoinIfFree(handler, packId)
	if not handler or type(handler.RequestJoin) ~= "function" or packId == nil then
		return false, "unavailable"
	end

	local teamName =
		state.questGroup.getPlayerMMBTeamName(
			player
		)

	if teamName then
		return false, "already_grouped_team"
	end

	local current = state.questGroup.getPlayerPack(handler, player)
	if current then return false, "already_grouped" end
	local ok = pcall(handler.RequestJoin, packId)
	if not ok then ok = pcall(handler.RequestJoin, handler, packId) end
	return ok, ok and "requested" or "request_failed"
end

function state.questGroup.acceptInviteIfFree(handler)
	if not handler
		or type(handler.AcceptInvite) ~= "function" then
		return false, "unavailable"
	end

	if state.questGroup.getPlayerMMBTeamName(
		player
	) then
		return false, "already_grouped_team"
	end

	if state.questGroup.getPlayerPack(
		handler,
		player
	) then
		return false, "already_grouped"
	end

	local ok =
		pcall(handler.AcceptInvite)

	if not ok then
		ok =
			pcall(
				handler.AcceptInvite,
				handler
			)
	end

	return ok,
		ok and "accepted"
			or "accept_failed"
end

function state.questGroup.getCurrentPack(handler)
	return state.questGroup.getPlayerPack(handler, player)
end

function state.questGroup.hasOtherMember(pack)
	if type(pack) ~= "table" then return false end

	if pack.Owner
		and not state.questGroup.samePlayer(
			pack.Owner,
			player
		) then

		return true
	end

	if type(pack.NormalMembers) == "table" then
		for _, member in pairs(pack.NormalMembers) do
			if member
				and not state.questGroup.samePlayer(
					member,
					player
				) then

				return true
			end
		end
	end

	-- PackHandler member tables can lag. The live Team property is visible on
	-- each Player immediately and carries the exact MMB pack name.
	local packName =
		state.questGroup.getMMBPackName
			and state.questGroup.getMMBPackName(
				pack
			)

	if type(packName) == "string" then
		for _, other in ipairs(
			Players:GetPlayers()
		) do
			if other ~= player then
				local otherTeam =
					state.questGroup.getPlayerMMBTeamName(
						other
					)

				if type(otherTeam) == "string"
					and otherTeam:lower()
						== packName:lower() then

					return true
				end
			end
		end
	end

	return false
end

function state.questGroup.questComplete(quest)
	if type(quest) ~= "table" or type(quest.props) ~= "table" then return false end
	local maxProgress
	if type(quest.props.GetMaxProgress) == "function" then
		local ok, value = pcall(quest.props.GetMaxProgress, quest.props)
		if ok and type(value) == "number" and value > 0 then maxProgress = value end
	end
	if not maxProgress then return false end

	local function scan(value, seen)
		if type(value) ~= "table" then return nil end
		seen = seen or {}
		if seen[value] then return nil end
		seen[value] = true
		local best
		for key, child in pairs(value) do
			if type(child) == "number" and type(key) == "string"
				and key:lower():find("progress", 1, true) then
				best = math.max(best or 0, child)
			elseif type(child) == "table" then
				local nested = scan(child, seen)
				if nested then best = math.max(best or 0, nested) end
			end
		end
		return best
	end

	local current = scan(quest.entry)
	if type(current) == "number" then
		return current >= maxProgress * 0.999
	end

	-- Fallback pela HUD para Grouping concluída mas ainda não removida dos dados.
	local gui = player:FindFirstChild("PlayerGui")
	local questsGui = gui and gui:FindFirstChild("QuestsScreenGui")
	local scrolling = questsGui and questsGui:FindFirstChild("RefScrollingFrame", true)
	local wantedTitle = type(quest.props.Title) == "string" and quest.props.Title:lower() or nil
	if scrolling and wantedTitle then
		for _, frame in ipairs(scrolling:GetChildren()) do
			if frame:IsA("GuiObject") and frame.Name:match("^QuestFrame%d+$") then
				local pieces = {}
				for _, object in ipairs(frame:GetDescendants()) do
					if object:IsA("TextLabel") or object:IsA("TextButton") then
						table.insert(pieces, tostring(object.Text))
					end
				end
				local combined = table.concat(pieces, " ")
				if combined:lower():find(wantedTitle, 1, true) then
					local shownCurrent, shownMax = combined:match("([%d,%.]+)%s*/%s*([%d,%.]+)")
					if shownCurrent and shownMax then
						shownCurrent = tonumber((shownCurrent:gsub("[,%.]", "")))
						shownMax = tonumber((shownMax:gsub("[,%.]", "")))
						if shownCurrent and shownMax and shownMax > 0 then
							return shownCurrent >= shownMax
						end
					end
				end
			end
		end
	end
	return false
end

function state.questGroup.inviteMatchingPlayers(handler, animalName)
	if not handler or type(handler.RequestInvite) ~= "function" then return 0 end

	local ownTeamName =
		state.questGroup.getPlayerMMBTeamName(
			player
		)

	local ownPack =
		state.questGroup.getCurrentPack(
			handler
		)

	local ownPackName =
		ownTeamName
			or (
				ownPack
					and state.questGroup.getMMBPackName
					and state.questGroup.getMMBPackName(
						ownPack
					)
			)

	local invited = 0

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player
			and state.questGroup.sameAnimal(
				state.questGroup.getPlayerAnimal(other),
				animalName
			) then

			local otherTeamName =
				state.questGroup.getPlayerMMBTeamName(
					other
				)

			local teamAlreadyConfirmsMembership =
				type(otherTeamName) == "string"
					and (
						not ownPackName
							or otherTeamName:lower()
								== ownPackName:lower()
							or otherTeamName:match("^MMB[%w]$")
					)

			-- Team replication is treated as authoritative. If Properties already
			-- shows Team = MMBx, never send another invite even if PackHandler's
			-- NormalMembers table is temporarily stale.
			if not teamAlreadyConfirmsMembership then
				local otherPack =
					state.questGroup.getPlayerPack(
						handler,
						other
					)

				if not otherPack then
					local last =
						state.questGroup.lastInviteAt[
							other.UserId
						] or 0

					if tick() - last >= 30 then
						local ok =
							pcall(
								handler.RequestInvite,
								other
							)

						if not ok then
							ok =
								pcall(
									handler.RequestInvite,
									handler,
									other
								)
						end

						if ok then
							state.questGroup.lastInviteAt[
								other.UserId
							] = tick()

							invited += 1

							if invited >= 3 then
								break
							end
						end
					end
				end
			end
		end
	end

	return invited
end

function state.questGroup.memberCount(pack)
	if type(pack) ~= "table" then return 0 end

	local count = 0
	local seenUserIds = {}

	local function addMember(member)
		if not member then return end

		local ok, userId =
			pcall(function()
				return member.UserId
			end)

		if ok and userId ~= nil then
			if seenUserIds[userId] then return end
			seenUserIds[userId] = true
		end

		count += 1
	end

	addMember(pack.Owner)

	if type(pack.NormalMembers) == "table" then
		for _, member in pairs(pack.NormalMembers) do
			addMember(member)
		end
	end

	-- Include Team-confirmed members that have not reached NormalMembers yet.
	local packName =
		state.questGroup.getMMBPackName
			and state.questGroup.getMMBPackName(
				pack
			)

	if type(packName) == "string" then
		for _, livePlayer in ipairs(
			Players:GetPlayers()
		) do
			local teamName =
				state.questGroup.getPlayerMMBTeamName(
					livePlayer
				)

			if type(teamName) == "string"
				and teamName:lower()
					== packName:lower() then

				addMember(livePlayer)
			end
		end
	end

	return count
end

function state.questGroup.getMMBPackName(pack)
	if type(pack) ~= "table" then return nil end

	-- Different PackHandler versions expose the display identifier under
	-- different fields. Only an EXACT four-character MMBx name is trusted.
	for _, key in ipairs({
		"Name",
		"UniqueName",
		"GroupName",
		"PackName",
		"DisplayName",
		"GroupUniqueName",
	}) do
		local value = pack[key]
		if type(value) == "string"
			and value:match("^MMB[%w]$") then
			return value
		end
	end

	return nil
end

function state.questGroup.teamMatchesPack(
	targetPlayer,
	pack
)
	local teamName =
		state.questGroup.getPlayerMMBTeamName(
			targetPlayer
		)

	local packName =
		state.questGroup.getMMBPackName(
			pack
		)

	return type(teamName) == "string"
		and type(packName) == "string"
		and teamName:lower()
			== packName:lower()
end

function state.questGroup.isMMBPack(pack)
	return state.questGroup.getMMBPackName(pack) ~= nil
end

function state.questGroup.samePackRecord(a, b)
	if a == b then return true end
	if type(a) ~= "table" or type(b) ~= "table" then return false end

	local aUnique = a.UniqueName
	local bUnique = b.UniqueName
	if type(aUnique) == "string"
		and aUnique ~= ""
		and aUnique == bUnique then
		return true
	end

	local aName = state.questGroup.getMMBPackName(a)
	local bName = state.questGroup.getMMBPackName(b)
	return aName ~= nil
		and aName == bName
		and state.questGroup.samePlayer(a.Owner, b.Owner)
end

function state.questGroup.nextMMBGroupName(handler)
	if not handler or type(handler.GetData) ~= "function" then
		return nil
	end

	local used = {}
	local ok, packs = pcall(handler.GetData)

	if ok and type(packs) == "table" then
		for _, candidate in pairs(packs) do
			local name = state.questGroup.getMMBPackName(candidate)
			if name then
				used[name:lower()] = true
			end
		end
	end

	local suffixes = state.questGroup.mmbSuffixes
	if type(suffixes) ~= "string" or #suffixes == 0 then
		suffixes = "1234567890abcdefghijklmnopqrstuvwxyz"
	end

	-- Deterministic starting point reduces simultaneous multi-account
	-- collisions. We still scan every suffix in case that preferred name
	-- already exists in this server.
	local start = (player.UserId % #suffixes) + 1

	for offset = 0, #suffixes - 1 do
		local index = ((start - 1 + offset) % #suffixes) + 1
		local suffix = suffixes:sub(index, index)
		local name = "MMB" .. suffix

		if not used[name:lower()] then
			return name
		end
	end

	return nil
end

function state.questGroup.findBestMMBPack(
	handler,
	records,
	currentAnimal,
	allowAnimalSwitch,
	sameSpeciesOnly
)
	if not handler or type(handler.GetData) ~= "function" then
		return nil, false
	end

	local ok, packs = pcall(handler.GetData)
	if not ok or type(packs) ~= "table" then
		return nil, false
	end

	records = records or savedCharacters()

	local best
	local externalFound = false

	for packId, candidate in pairs(packs) do
		local mmbName = state.questGroup.getMMBPackName(candidate)

		if mmbName
			and type(candidate) == "table"
			and type(candidate.AnimalName) == "string"
			and candidate.AnimalName ~= ""
			and candidate.Owner then

			local isOwn =
				state.questGroup.samePlayer(candidate.Owner, player)

			-- Our own freshly-created pack may take a moment before AutoAccept
			-- is reflected. External MMB packs are considered joinable only
			-- after their owner has opened them.
			local joinable =
				isOwn or candidate.JoinRequirements == "AutoAccept"

			if joinable then
				local sameSpecies = state.questGroup.sameAnimal(
					candidate.AnimalName,
					currentAnimal
				)

				local slot
				local viable = sameSpecies

				if not sameSpecies
					and not sameSpeciesOnly
					and allowAnimalSwitch
					and not (
						state.questIsFlyingAnimalName(candidate.AnimalName)
						and (
							state.questBlockFlying
							or (state.questPendingLandCount or 0) > 0
						)
					) then

					slot = state.questGroup.findOwnedSlot(
						records,
						candidate.AnimalName
					)

					viable = slot ~= nil
				end

				if viable then
					if not isOwn then
						externalFound = true
					end

					local count = state.questGroup.memberCount(candidate)
					local idText = tostring(packId)

					-- Stable leader election:
					--   1) most members;
					--   2) smallest MMBx name;
					--   3) stable pack id text.
					-- It deliberately does NOT depend on the local player's
					-- current species when cross-species cooperation is allowed,
					-- preventing A->B / B->A simultaneous swaps.
					local better = not best
						or count > best.count
						or (
							count == best.count
							and mmbName:lower() < best.mmbName:lower()
						)
						or (
							count == best.count
							and mmbName:lower() == best.mmbName:lower()
							and idText < best.idText
						)

					if better then
						best = {
							packId = packId,
							pack = candidate,
							count = count,
							animalName = candidate.AnimalName,
							sameSpecies = sameSpecies,
							slot = sameSpecies and nil or slot,
							isOwn = isOwn,
							isMMB = true,
							mmbName = mmbName,
							idText = idText,
						}
					end
				end
			end
		end
	end

	return best, externalFound
end

function state.questGroup.findOwnedSlot(records, animalName)
	if type(records) ~= "table" or type(animalName) ~= "string" then return nil end
	local bestComplete
	local bestIncomplete
	local bestIncompleteGrowth = -1

	for _, entry in ipairs(records) do
		if type(entry) == "table"
			and type(entry.AnimalName) == "string"
			and entry.AnimalName:lower() == animalName:lower() then

			if isGrowthComplete(entry.GrowthPercentage) then
				if not bestComplete then bestComplete = entry end
			else
				local growth = tonumber(entry.GrowthPercentage) or 0
				if growth <= 1 then growth *= 100 end
				if growth > bestIncompleteGrowth then
					bestIncompleteGrowth = growth
					bestIncomplete = entry
				end
			end
		end
	end

	-- Para trocar só por causa de Grouping, prefere um slot adulto/100%.
	-- Se não houver, usa o slot incompleto mais avançado que o jogador possui.
	return bestComplete or bestIncomplete
end

function state.questGroup.findBestServerPack(handler, records, currentAnimal, allowAnimalSwitch)
	if not handler or type(handler.GetData) ~= "function" then return nil end
	local ok, packs = pcall(handler.GetData)
	if not ok or type(packs) ~= "table" then return nil end

	local best
	for packId, candidate in pairs(packs) do
		if type(candidate) == "table"
			and type(candidate.AnimalName) == "string"
			and candidate.AnimalName ~= ""
			and candidate.Owner
			and not state.questGroup.samePlayer(candidate.Owner, player)
			and candidate.JoinRequirements == "AutoAccept" then

			local sameSpecies = state.questGroup.sameAnimal(
				candidate.AnimalName,
				currentAnimal
			)

			local genericSpeciesSwitchAllowed = allowAnimalSwitch
				and not (
					state.questIsFlyingAnimalName(candidate.AnimalName)
					and (
						state.questBlockFlying
						or (state.questPendingLandCount or 0) > 0
					)
				)

			local ownedSlot = sameSpecies and true
				or (
					genericSpeciesSwitchAllowed
					and state.questGroup.findOwnedSlot(
						records,
						candidate.AnimalName
					)
				)

			if ownedSlot then
				local count = state.questGroup.memberCount(candidate)
				local mmbName = state.questGroup.getMMBPackName(candidate)
				local isMMB = mmbName ~= nil
				local idText = tostring(packId)

				local better = not best
					-- Never change species when a usable same-species pack
					-- exists just because a remote pack is larger.
					or (sameSpecies and not best.sameSpecies)
					or (
						sameSpecies == best.sameSpecies
						and isMMB
						and not best.isMMB
					)
					or (
						sameSpecies == best.sameSpecies
						and isMMB == best.isMMB
						and count > best.count
					)
					or (
						sameSpecies == best.sameSpecies
						and isMMB == best.isMMB
						and count == best.count
						and idText < best.idText
					)

				if better then
					best = {
						packId = packId,
						pack = candidate,
						count = count,
						animalName = candidate.AnimalName,
						sameSpecies = sameSpecies,
						slot = sameSpecies and nil or ownedSlot,
						isMMB = isMMB,
						mmbName = mmbName,
						idText = idText,
					}
				end
			end
		end
	end

	return best
end


function state.questGroup.findOwnedPack(handler)
	if not handler then return nil end

	local current = state.questGroup.getCurrentPack(handler)
	if current
		and state.questGroup.samePlayer(current.Owner, player) then
		return current
	end

	if type(handler.GetData) ~= "function" then return nil end

	local ok, packs = pcall(handler.GetData)
	if not ok or type(packs) ~= "table" then return nil end

	for _, candidate in pairs(packs) do
		if type(candidate) == "table"
			and candidate.Owner
			and state.questGroup.samePlayer(
				candidate.Owner,
				player
			) then
			return candidate
		end
	end
end

function state.questGroup.openOwnedPackAutoAccept(handler, pack)
	if not handler or not pack then return false end
	if not state.questGroup.samePlayer(pack.Owner, player) then
		return false
	end

	if pack.JoinRequirements == "AutoAccept" then
		return true
	end

	if type(handler.SetJoinRequirements) ~= "function" then
		return false
	end

	local ok = pcall(
		handler.SetJoinRequirements,
		"AutoAccept"
	)

	if not ok then
		-- Compatibility with PackHandler variants that expose a method-style
		-- function rather than a closure-style function.
		ok = pcall(
			handler.SetJoinRequirements,
			handler,
			"AutoAccept"
		)
	end

	return ok
end

function state.questGroup.tryCreateMMBPack(handler, animalName)
	if not handler
		or type(handler.CreateGroup) ~= "function"
		or type(animalName) ~= "string"
		or animalName == "" then
		return false
	end

	local owned = state.questGroup.findOwnedPack(handler)
	if owned then
		state.questGroup.createInFlight = false
		state.questGroup.createFailures = 0
		state.questGroup.openOwnedPackAutoAccept(
			handler,
			owned
		)
		return true
	end

	if state.questGroup.createInFlight then
		state.questGroup.statusText =
			"MMB co-op: waiting for group creation confirmation"
		return false
	end

	-- Dedicated creation retry clock. Invites/joins no longer postpone creation.
	if tick() - (state.questGroup.lastCreateAttemptAt or 0) < 2.5 then
		return false
	end

	local groupName =
		state.questGroup.nextMMBGroupName(handler)

	if not groupName then
		state.questGroup.statusText =
			"MMB co-op: no free MMBx name found"
		return false
	end

	state.questGroup.createInFlight = true
	state.questGroup.lastCreateAttemptAt = tick()
	state.questGroup.lastMMBCreateName = groupName
	state.questGroup.statusText =
		"MMB co-op: creating "
		.. groupName
		.. " · "
		.. animalName

	task.spawn(function()
		-- v61-style invocation first.
		local invoked = pcall(
			handler.CreateGroup,
			groupName
		)

		-- Wait for replication and verify that WE actually own a pack.
		local deadline = tick() + 3.5
		local verified

		repeat
			task.wait(0.20)
			verified =
				state.questGroup.findOwnedPack(handler)
		until verified or tick() >= deadline

		-- Some PackHandler versions expose CreateGroup as a method requiring
		-- self. Only try that signature if the first attempt did not produce
		-- any owned pack after the replication window.
		if not verified then
			local methodInvoked = pcall(
				handler.CreateGroup,
				handler,
				groupName
			)

			invoked = invoked or methodInvoked
			deadline = tick() + 3.5

			repeat
				task.wait(0.20)
				verified =
					state.questGroup.findOwnedPack(handler)
			until verified or tick() >= deadline
		end

		if verified then
			state.questGroup.createFailures = 0
			state.questGroup.lastCreateVerifiedAt = tick()
			state.questGroup.createInFlight = false

			state.questGroup.openOwnedPackAutoAccept(
				handler,
				verified
			)

			local actualName =
				state.questGroup.getMMBPackName(verified)
				or groupName

			state.questGroup.statusText =
				"MMB co-op created: "
				.. actualName
				.. " · AutoAccept"

			runtimeMessage =
				"GroupTime: MMB group ready ("
				.. actualName
				.. ")"

			state.questForceFastRecheckUntil =
				tick() + 20
			return
		end

		state.questGroup.createInFlight = false
		state.questGroup.createFailures =
			(state.questGroup.createFailures or 0) + 1

		state.questGroup.statusText =
			string.format(
				"MMB co-op: creation failed (%d); retrying",
				state.questGroup.createFailures
			)

		runtimeMessage =
			"GroupTime: CreateGroup did not produce a pack; retry scheduled"
	end)

	return false
end


function state.questGroup.ensureForCurrentAnimal(records, allowAnimalSwitch)
	local handler = state.questGroup.resolveHandler()
	if not handler then
		state.questGroup.statusText = "Grouping: PackHandlerClient not found"
		return false
	end

	records = records or savedCharacters()
	local animalName = state.questGroup.getPlayerAnimal(player)
	if not animalName then
		state.questGroup.statusText = "Grouping: waiting for animal"
		return false
	end

	if state.questGroup.lastAnimal ~= animalName then
		state.questGroup.lastAnimal = animalName
		state.questGroup.lastActionAt = 0
		state.questGroup.difficultySince = tick()
	end

	local pack = state.questGroup.getCurrentPack(handler)
	local liveTeamName =
		state.questGroup.getPlayerMMBTeamName(
			player
		)

	-- If Roblox already exposes Team = MMBx, membership is confirmed even when
	-- PackHandler is one replication step behind. Do not create/join/leave any
	-- pack until the handler catches up.
	if not pack
		and liveTeamName then

		state.questGroup.difficultySince = nil
		state.questGroup.pendingPackAnimal = nil
		state.questGroup.statusText =
			"MMB co-op active via Team: "
			.. liveTeamName

		return true
	end

	if pack then
		-- Do not act on the short stale PackHandler cache after an animal switch.
		if not state.questGroup.sameAnimal(pack.AnimalName, animalName) then
			state.questGroup.statusText =
				"Grouping: waiting for species pack update"
			return false
		end

		-- If this pack already has another animal, the mission is progressing.
		-- Do not disrupt a working public pack merely to move to an MMB pack.
		if state.questGroup.hasOtherMember(pack) then
			if state.questGroup.samePlayer(pack.Owner, player)
				and pack.JoinRequirements ~= "AutoAccept"
				and type(handler.SetJoinRequirements) == "function"
				and tick() - state.questGroup.lastActionAt >= 3 then

				state.questGroup.lastActionAt = tick()
				pcall(handler.SetJoinRequirements, "AutoAccept")
			end

			state.questGroup.difficultySince = nil
			state.questGroup.pendingPackAnimal = nil

			local packName = state.questGroup.getMMBPackName(pack)
			state.questGroup.statusText = packName
				and string.format(
					"MMB co-op active: %s · %s (%d animals)",
					packName,
					animalName,
					state.questGroup.memberCount(pack)
				)
				or string.format(
					"Grouping active: %s (%d animals)",
					animalName,
					state.questGroup.memberCount(pack)
				)

			return true
		end
	end

	if not state.questGroup.difficultySince then
		state.questGroup.difficultySince = tick()
	end

	-- --------------------------------------------------------
	-- Immediate same-species MMB consolidation.
	-- If two Hub clients created MMB packs at nearly the same time, every
	-- client computes the SAME winner (members -> MMB name -> pack id).
	-- The winner stays; losing empty packs leave/disband and join it.
	-- --------------------------------------------------------
	local sameMMB, hasExternalSameMMB =
		state.questGroup.findBestMMBPack(
			handler,
			records,
			animalName,
			false,
			true
		)

	if sameMMB then
		local currentIsWinner =
			pack
			and state.questGroup.samePackRecord(
				pack,
				sameMMB.pack
			)

		if currentIsWinner then
			if state.questGroup.samePlayer(pack.Owner, player) then
				if pack.JoinRequirements ~= "AutoAccept"
					and type(handler.SetJoinRequirements) == "function"
					and tick() - state.questGroup.lastActionAt >= 2 then

					state.questGroup.lastActionAt = tick()
					pcall(handler.SetJoinRequirements, "AutoAccept")
				end

				local invited =
					state.questGroup.inviteMatchingPlayers(
						handler,
						animalName
					)

				state.questGroup.statusText = invited > 0
					and (
						"MMB co-op "
						.. sameMMB.mmbName
						.. ": invited "
						.. animalName
						.. " players"
					)
					or (
						"MMB co-op "
						.. sameMMB.mmbName
						.. ": waiting for another "
						.. animalName
					)
			end

		elseif hasExternalSameMMB then
			if pack then
				if tick() - state.questGroup.lastActionAt >= 3 then
					state.questGroup.lastActionAt = tick()

					if state.questGroup.samePlayer(pack.Owner, player)
						and type(handler.Disband) == "function" then
						pcall(handler.Disband)
					elseif type(handler.Leave) == "function" then
						pcall(handler.Leave)
					end

					state.questGroup.statusText =
						"MMB co-op: consolidating into "
						.. sameMMB.mmbName
				end
				return false

			elseif not sameMMB.isOwn
				and type(handler.RequestJoin) == "function" then

				if tick() - state.questGroup.lastActionAt >= 2 then
					state.questGroup.lastActionAt = tick()
					state.questGroup.requestJoinIfFree(handler, sameMMB.packId)
				end

				state.questGroup.statusText =
					"MMB co-op: joining "
					.. sameMMB.mmbName
					.. " · "
					.. animalName

				return false
			end
		end
	end

	-- Existing empty owner pack: keep it open and invite matching animals.
	if pack and state.questGroup.samePlayer(pack.Owner, player) then
		if pack.JoinRequirements ~= "AutoAccept"
			and type(handler.SetJoinRequirements) == "function"
			and tick() - state.questGroup.lastActionAt >= 3 then

			state.questGroup.lastActionAt = tick()
			pcall(handler.SetJoinRequirements, "AutoAccept")
		end

		local invited =
			state.questGroup.inviteMatchingPlayers(
				handler,
				animalName
			)

		local ownMMBName = state.questGroup.getMMBPackName(pack)
		state.questGroup.statusText = ownMMBName
			and (
				"MMB co-op "
				.. ownMMBName
				.. ": waiting for another "
				.. animalName
			)
			or (
				invited > 0
				and ("Grouping: invited " .. animalName .. " players")
				or ("Grouping: waiting for another " .. animalName)
			)
	end

	-- --------------------------------------------------------
	-- After the normal grace period, coordinate different-species MMB packs.
	-- This is deterministic and prevents two Hub accounts swapping into each
	-- other's species at the same time.
	-- --------------------------------------------------------
	local difficultFor =
		tick() - (state.questGroup.difficultySince or tick())
	local shouldAnalyze = difficultFor >= 20

	if shouldAnalyze
		and tick() - (state.questGroup.lastServerAnalysisAt or 0) >= 5 then

		state.questGroup.lastServerAnalysisAt = tick()

		local mmbLeader, hasExternalMMB =
			state.questGroup.findBestMMBPack(
				handler,
				records,
				animalName,
				allowAnimalSwitch == true,
				false
			)

		if hasExternalMMB and mmbLeader then
			local currentIsLeader =
				pack
				and state.questGroup.samePackRecord(
					pack,
					mmbLeader.pack
				)

			if currentIsLeader then
				state.questGroup.statusText =
					"MMB co-op leader: "
					.. mmbLeader.mmbName
					.. " · waiting for Hub accounts"

				-- Winner never abandons its pack while other MMB packs are
				-- converging toward it.
				return false
			end

			if mmbLeader.sameSpecies then
				if pack then
					if tick() - state.questGroup.lastActionAt >= 3 then
						state.questGroup.lastActionAt = tick()
						if state.questGroup.samePlayer(pack.Owner, player)
							and type(handler.Disband) == "function" then
							pcall(handler.Disband)
						elseif type(handler.Leave) == "function" then
							pcall(handler.Leave)
						end
						state.questGroup.statusText =
							"MMB co-op: leaving old pack for "
							.. mmbLeader.mmbName
					end
					return false
				end

				if type(handler.RequestJoin) == "function"
					and tick() - state.questGroup.lastActionAt >= 2 then
					state.questGroup.lastActionAt = tick()
					state.questGroup.requestJoinIfFree(handler, mmbLeader.packId)
				end

				state.questGroup.statusText =
					"MMB co-op: joining leader "
					.. mmbLeader.mmbName

				return false
			end

			if not mmbLeader.sameSpecies
				and allowAnimalSwitch
				and mmbLeader.slot then

				if pack then
					if tick() - state.questGroup.lastActionAt >= 3 then
						state.questGroup.lastActionAt = tick()

						if state.questGroup.samePlayer(pack.Owner, player)
							and type(handler.Disband) == "function" then
							pcall(handler.Disband)
						elseif type(handler.Leave) == "function" then
							pcall(handler.Leave)
						end

						state.questGroup.pendingPackAnimal =
							mmbLeader.animalName

						state.questGroup.statusText =
							"MMB co-op: leaving pack before switching to "
							.. mmbLeader.animalName
					end

					return false
				end

				if not questSwitchingAnimal
					and not state.busy
					and not criticalRecoveryActive
					and tick() - questLastAnimalSwitch >= 20 then

					questLastAnimalSwitch = tick()
					questSwitchingAnimal = true
					questTravelWanted = false
					state.questTravelActive = false
					state.questGroup.pendingPackAnimal =
						mmbLeader.animalName

					runtimeMessage = string.format(
						"MMB co-op: switching to %s for leader %s",
						mmbLeader.animalName,
						mmbLeader.mmbName
					)

					task.spawn(function()
						if not state.prepareCurrentSlotForSwitch(
						"MMB group: staging current animal before species switch"
					) then
						questSwitchingAnimal = false
						runtimeMessage = "MMB group switch postponed: staging failed"
						return
					end

					if ResetRemote then
							pcall(
								ResetRemote.InvokeServer,
								ResetRemote
							)
							task.wait(1.5)
						end

						spawnSlot(mmbLeader.slot, true)
						questSwitchingAnimal = false
					end)

					return false
				end
			end
		end

		-- No other viable MMB pack: preserve the normal public-pack fallback.
		local best = state.questGroup.findBestServerPack(
			handler,
			records,
			animalName,
			allowAnimalSwitch == true
		)

		if best then
			state.questGroup.statusText = string.format(
				best.isMMB
					and "Grouping: best MMB pack %s (%d animals)"
					or "Grouping: best server pack %s (%d animals)",
				best.isMMB and best.mmbName or best.animalName,
				best.count
			)

			if best.sameSpecies then
				if pack
					and state.questGroup.samePlayer(pack.Owner, player) then

					if type(handler.Disband) == "function"
						and tick() - state.questGroup.lastActionAt >= 4 then

						state.questGroup.lastActionAt = tick()
						pcall(handler.Disband)
						state.questGroup.statusText =
							"Grouping: moving to better "
							.. animalName
							.. " pack"
					end

					return false

				elseif not pack
					and type(handler.RequestJoin) == "function"
					and tick() - state.questGroup.lastActionAt >= 4 then

					state.questGroup.lastActionAt = tick()
					state.questGroup.requestJoinIfFree(handler, best.packId)
					state.questGroup.statusText = string.format(
						"Grouping: joining %s pack (%d animals)",
						animalName,
						best.count
					)
					return false
				end
			end

			if not best.sameSpecies
				and allowAnimalSwitch
				and best.slot then

				if pack then
					if tick() - state.questGroup.lastActionAt >= 4 then
						state.questGroup.lastActionAt = tick()

						if state.questGroup.samePlayer(pack.Owner, player)
							and type(handler.Disband) == "function" then
							pcall(handler.Disband)
						elseif type(handler.Leave) == "function" then
							pcall(handler.Leave)
						end

						state.questGroup.pendingPackAnimal =
							best.animalName

						state.questGroup.statusText =
							"Grouping: leaving pack before species switch"
					end

					return false
				end

				if not questSwitchingAnimal
					and not state.busy
					and not criticalRecoveryActive
					and tick() - questLastAnimalSwitch >= 20 then

					questLastAnimalSwitch = tick()
					questSwitchingAnimal = true
					questTravelWanted = false
					state.questTravelActive = false
					state.questGroup.pendingPackAnimal =
						best.animalName

					runtimeMessage = string.format(
						"Grouping: switching to %s for bigger pack (%d)",
						best.animalName,
						best.count
					)

					task.spawn(function()
						if not state.prepareCurrentSlotForSwitch(
						"Group quest: staging current animal before species switch"
					) then
						questSwitchingAnimal = false
						runtimeMessage = "Group switch postponed: staging failed"
						return
					end

					if ResetRemote then
							pcall(
								ResetRemote.InvokeServer,
								ResetRemote
							)
							task.wait(1.5)
						end
						spawnSlot(best.slot, true)
						questSwitchingAnimal = false
					end)

					return false
				end
			end
		end
	end

	-- --------------------------------------------------------
	-- No current pack: MMB pack first, then public AutoAccept, then create.
	-- --------------------------------------------------------
	if not pack then
		local lateMMB, hasLateExternalMMB =
			state.questGroup.findBestMMBPack(
				handler,
				records,
				animalName,
				false,
				true
			)

		if hasLateExternalMMB
			and lateMMB
			and not lateMMB.isOwn
			and type(handler.RequestJoin) == "function" then

			if tick() - state.questGroup.lastActionAt >= 2 then
				state.questGroup.lastActionAt = tick()
				state.questGroup.requestJoinIfFree(handler, lateMMB.packId)
			end

			state.questGroup.statusText =
				"MMB co-op: joining "
				.. lateMMB.mmbName
				.. " · "
				.. animalName

			return false
		end

		local ok, packs = pcall(handler.GetData)
		if ok and type(packs) == "table" then
			local preferredId
			local preferredCount = -1

			for packId, candidate in pairs(packs) do
				if type(candidate) == "table"
					and state.questGroup.sameAnimal(
						candidate.AnimalName,
						animalName
					)
					and candidate.Owner
					and not state.questGroup.samePlayer(
						candidate.Owner,
						player
					)
					and candidate.JoinRequirements == "AutoAccept" then

					local count =
						state.questGroup.memberCount(candidate)

					if count > preferredCount then
						preferredCount = count
						preferredId = packId
					end
				end
			end

			if preferredId ~= nil
				and type(handler.RequestJoin) == "function" then

				if tick() - state.questGroup.lastActionAt >= 5 then
					state.questGroup.lastActionAt = tick()
					state.questGroup.requestJoinIfFree(handler, preferredId)
				end

				state.questGroup.statusText = string.format(
					"Grouping: joining biggest %s pack (%d animals)",
					animalName,
					math.max(preferredCount, 1)
				)

				return false
			end
		end

		-- v71: advertise the GroupTime quickly. We still check existing MMB/public
		-- packs first, but creation no longer waits 8-13 seconds or shares the
		-- lastActionAt timer with unrelated group actions.
		local createDelay =
			1.5 + ((player.UserId % 5) * 0.35)

		if tick() - (state.questGroup.difficultySince or tick())
			>= createDelay then

			state.questGroup.tryCreateMMBPack(
				handler,
				animalName
			)
		else
			state.questGroup.statusText =
				"Grouping: checking for existing "
				.. animalName
				.. " MMB pack"
		end
	end

	return false
end


-- Hub accounts WITHOUT GroupTime can still help another Hub account when they
-- are already using the same animal species. This helper NEVER changes species
-- and NEVER creates a pack; it only joins/consolidates an existing MMBx pack.
function state.questGroup.assistMMBForCurrentAnimal()
	if tick() - (state.questGroup.lastMMBAssistAt or 0) < 3 then
		return false
	end
	state.questGroup.lastMMBAssistAt = tick()

	if state.questGrowthReset.exclusive
		or questSwitchingAnimal
		or state.busy
		or criticalRecoveryActive
		or DAMAGE.active
		or state.coinFarmSwitching then
		return false
	end

	local automationActive =
		state.autoQuests
		or state.farmCoins
		or state.growExisting
		or state.growAllSlots
		or state.growNew

	if not automationActive then
		return false
	end

	local handler = state.questGroup.resolveHandler()
	if not handler then return false end

	local animalName = state.questGroup.getPlayerAnimal(player)
	if type(animalName) ~= "string" or animalName == "" then
		return false
	end

	local pack = state.questGroup.getCurrentPack(handler)

	-- PackHandler may briefly report the old species after a slot switch.
	-- Never disband/leave based on that stale snapshot.
	if pack
		and not state.questGroup.sameAnimal(
			pack.AnimalName,
			animalName
		) then
		return false
	end

	if pack and state.questGroup.hasOtherMember(pack) then
		return true
	end

	local best, hasExternal =
		state.questGroup.findBestMMBPack(
			handler,
			savedCharacters(),
			animalName,
			false,
			true
		)

	if not best or not hasExternal then
		return false
	end

	if pack
		and state.questGroup.samePackRecord(pack, best.pack) then

		if state.questGroup.samePlayer(pack.Owner, player)
			and pack.JoinRequirements ~= "AutoAccept"
			and type(handler.SetJoinRequirements) == "function" then

			pcall(handler.SetJoinRequirements, "AutoAccept")
		end

		return false
	end

	if pack then
		if tick() - state.questGroup.lastActionAt < 3 then
			return false
		end

		state.questGroup.lastActionAt = tick()

		if state.questGroup.samePlayer(pack.Owner, player)
			and type(handler.Disband) == "function" then
			pcall(handler.Disband)
		elseif type(handler.Leave) == "function" then
			pcall(handler.Leave)
		end

		state.questGroup.statusText =
			"MMB helper: consolidating into "
			.. best.mmbName

		return false
	end

	if not best.isOwn
		and type(handler.RequestJoin) == "function"
		and tick() - state.questGroup.lastActionAt >= 2 then

		state.questGroup.lastActionAt = tick()
		state.questGroup.requestJoinIfFree(handler, best.packId)

		state.questGroup.statusText =
			"MMB helper: joining "
			.. best.mmbName
			.. " to help another Hub account"

		runtimeMessage =
			"MMB co-op: helping another script account's GroupTime"

		return true
	end

	return false
end



-- ============================================================
-- v79: MMB cooperative membership protocol
-- ============================================================
function state.questGroup.coopServerTime()
	local ok, value = pcall(
		workspace.GetServerTimeNow,
		workspace
	)

	if ok and type(value) == "number" then
		return value
	end

	return tick()
end

function state.questGroup.coopProbeState()
	local coop = state.questGroup.coop
	local period =
		math.max(
			8,
			tonumber(coop.probePeriod) or 16
		)

	local window =
		math.clamp(
			tonumber(coop.probeWindow) or 2.2,
			1.0,
			period - 2
		)

	local now =
		state.questGroup.coopServerTime()

	local phase = now % period
	return phase < window, phase, period, window
end

function state.questGroup.localHasActiveGroupTime()
	local ok, quests = pcall(getAllQuests)
	if not ok or type(quests) ~= "table" then
		return false
	end

	for _, quest in ipairs(quests) do
		if quest.props
			and quest.props.QuestType == "GroupTime"
			and not state.questGroup.questComplete(quest) then
			return true
		end
	end

	return false
end

function state.questGroup.findMMBPackByName(handler, wantedName)
	if not handler
		or type(handler.GetData) ~= "function"
		or type(wantedName) ~= "string"
		or wantedName == "" then
		return nil, nil
	end

	local ok, packs = pcall(handler.GetData)
	if not ok or type(packs) ~= "table" then
		return nil, nil
	end

	for packId, candidate in pairs(packs) do
		local name =
			state.questGroup.getMMBPackName(
				candidate
			)

		if name
			and name:lower()
				== wantedName:lower() then
			return packId, candidate
		end
	end

	return nil, nil
end

function state.questGroup.findSavedSlotByCharacterName(records, characterName)
	if type(records) ~= "table"
		or type(characterName) ~= "string"
		or characterName == "" then
		return nil
	end

	for _, entry in ipairs(records) do
		if type(entry) == "table"
			and (
				entry.CharacterName == characterName
				or entry.UniqueCharacterName == characterName
			) then
			return entry
		end
	end
end

function state.questGroup.findAFKHelpTarget(handler, records, currentAnimal)
	if not handler or type(handler.GetData) ~= "function" then
		return nil
	end

	local ok, packs = pcall(handler.GetData)
	if not ok or type(packs) ~= "table" then
		return nil
	end

	records = records or savedCharacters()

	local best

	for packId, candidate in pairs(packs) do
		local mmbName =
			state.questGroup.getMMBPackName(
				candidate
			)

		if mmbName
			and type(candidate) == "table"
			and candidate.Owner
			and not state.questGroup.samePlayer(
				candidate.Owner,
				player
			)
			and candidate.JoinRequirements == "AutoAccept"
			and type(candidate.AnimalName) == "string"
			and candidate.AnimalName ~= "" then

			local count =
				state.questGroup.memberCount(
					candidate
				)

			-- GroupTime only needs another member in the current logic.
			-- Do not steal an AFK account for a pack that is already helped.
			if count < 2 then
				local sameSpecies =
					state.questGroup.sameAnimal(
						candidate.AnimalName,
						currentAnimal
					)

				local slot =
					sameSpecies
					and true
					or state.questGroup.findOwnedSlot(
						records,
						candidate.AnimalName
					)

				if slot then
					local better =
						not best
						or (
							sameSpecies
							and not best.sameSpecies
						)
						or (
							sameSpecies
								== best.sameSpecies
							and count < best.count
						)
						or (
							sameSpecies
								== best.sameSpecies
							and count == best.count
							and mmbName:lower()
								< best.mmbName:lower()
						)

					if better then
						best = {
							packId = packId,
							pack = candidate,
							mmbName = mmbName,
							animalName =
								candidate.AnimalName,
							sameSpecies = sameSpecies,
							slot =
								sameSpecies
								and nil
								or slot,
							count = count,
						}
					end
				end
			end
		end
	end

	return best
end

function state.questGroup.clearAFKHelperState()
	local coop = state.questGroup.coop

	coop.helperActive = false
	coop.helperSwitching = false
	coop.helperTargetName = nil
	coop.helperTargetAnimal = nil
	coop.helperTargetPackId = nil
	coop.helperReturnCharacterName = nil
	coop.helperReturnAnimal = nil
	coop.helperLastActionAt = 0
	coop.helperStartedAt = 0
end

function state.questGroup.restoreAFKAfterHelp()
	local coop = state.questGroup.coop

	if coop.helperSwitching then
		return false
	end

	if not coop.helperActive then
		return true
	end

	-- If another real local quest took over, stop being a helper and let the
	-- quest controller choose the correct animal instead of forcing AFK return.
	if not state.farmCoins then
		state.questGroup.clearAFKHelperState()
		return true
	end

	local records = savedCharacters()
	local target

	if type(state.coinFarmPreferredAnimal) == "string"
		and state.coinFarmPreferredAnimal ~= ""
		and state.coinFarmFindPreferredSlot then

		target =
			state.coinFarmFindPreferredSlot(
				records,
				state.coinFarmPreferredAnimal
			)
	end

	if not target then
		target =
			state.questGroup.findSavedSlotByCharacterName(
				records,
				coop.helperReturnCharacterName
			)
	end

	if not target
		and type(coop.helperReturnAnimal) == "string" then

		target =
			state.questGroup.findOwnedSlot(
				records,
				coop.helperReturnAnimal
			)
	end

	local character = player.Character
	local currentAnimal =
		character
		and character:GetAttribute("AnimalName")

	local currentCharacterName =
		character
		and (
			character:GetAttribute("CharacterName")
			or character:GetAttribute(
				"UniqueCharacterName"
			)
		)

	if target then
		local targetName =
			target.CharacterName
			or target.UniqueCharacterName

		local alreadyCorrect =
			type(targetName) == "string"
			and type(currentCharacterName) == "string"
			and targetName == currentCharacterName

		if not alreadyCorrect then
			coop.helperSwitching = true
			questSwitchingAnimal = true
			questTravelWanted = false
			state.questTravelActive = false

			runtimeMessage =
				"MMB helper complete: restoring AFK Coin animal"

			task.spawn(function()
				if not state.prepareCurrentSlotForSwitch(
					"MMB helper: staging current animal before restoring AFK slot"
				) then
					questSwitchingAnimal = false
					coop.helperSwitching = false
					runtimeMessage = "MMB helper restore postponed: staging failed"
					return
				end

				if ResetRemote then
					pcall(
						ResetRemote.InvokeServer,
						ResetRemote
					)
					task.wait(1.35)
				end

				spawnSlot(target, true)
				task.wait(0.60)

				questSwitchingAnimal = false
				coop.helperSwitching = false
				state.questGroup.clearAFKHelperState()

				state.coinFarmSwitchPending = false
				state.coinFarmRetryAt = 0

				if state.coinFarmPreferredAnimal
					and state.coinFarmRequestPreferredSwitch then
					state.coinFarmRequestPreferredSwitch(
						"MMB helper finished"
					)
				end

				runtimeMessage =
					"MMB help finished; AFK Coin routine restored"
			end)

			return false
		end
	end

	state.questGroup.clearAFKHelperState()

	if state.coinFarmPreferredAnimal
		and state.coinFarmRequestPreferredSwitch then
		state.coinFarmRequestPreferredSwitch(
			"MMB helper finished"
		)
	end

	runtimeMessage =
		"MMB help finished; AFK Coin routine restored"

	return true
end

function state.questGroup.beginAFKHelp(handler, target)
	local coop = state.questGroup.coop

	if coop.helperActive
		or coop.helperSwitching
		or not state.farmCoins
		or not target
		or state.questGroup.localHasActiveGroupTime()
		or questSwitchingAnimal
		or state.busy
		or criticalRecoveryActive
		or DAMAGE.active
		or state.questGrowthReset.exclusive then
		return false
	end

	local character = player.Character
	if not character then return false end

	local records = savedCharacters()
	local currentEntry =
		state.questFindCurrentSavedEntry(
			records,
			character
		)

	coop.helperActive = true
	coop.helperStartedAt = tick()
	coop.helperTargetName = target.mmbName
	coop.helperTargetAnimal = target.animalName
	coop.helperTargetPackId = target.packId
	coop.helperReturnCharacterName =
		currentEntry
		and (
			currentEntry.CharacterName
			or currentEntry.UniqueCharacterName
		)
		or character:GetAttribute("CharacterName")

	coop.helperReturnAnimal =
		character:GetAttribute("AnimalName")

	state.coinFarmSwitchPending = false
	state.coinFarmSwitchReason = nil

	if target.sameSpecies then
		coop.helperLastActionAt = tick()

		state.questGroup.requestJoinIfFree(handler, target.packId)

		runtimeMessage =
			"MMB helper: joining "
			.. target.mmbName
			.. " while keeping AFK Coin animal"

		return true
	end

	if not target.slot then
		state.questGroup.clearAFKHelperState()
		return false
	end

	coop.helperSwitching = true
	questSwitchingAnimal = true
	questTravelWanted = false
	state.questTravelActive = false

	runtimeMessage = string.format(
		"MMB helper: switching %s -> %s to help %s",
		tostring(coop.helperReturnAnimal or "current"),
		target.animalName,
		target.mmbName
	)

	task.spawn(function()
		if not state.prepareCurrentSlotForSwitch(
			"MMB helper: staging current animal before helper slot"
		) then
			questSwitchingAnimal = false
			coop.helperSwitching = false
			runtimeMessage = "MMB helper switch postponed: staging failed"
			return
		end

		if ResetRemote then
			pcall(
				ResetRemote.InvokeServer,
				ResetRemote
			)
			task.wait(1.35)
		end

		spawnSlot(target.slot, true)
		task.wait(0.75)

		questSwitchingAnimal = false
		coop.helperSwitching = false

		if not state.alive
			or not state.farmCoins
			or not coop.helperActive then
			state.questGroup.restoreAFKAfterHelp()
			return
		end

		local liveHandler =
			state.questGroup.resolveHandler()

		local packId, pack =
			state.questGroup.findMMBPackByName(
				liveHandler,
				coop.helperTargetName
			)

		if packId
			and pack
			and state.questGroup.sameAnimal(
				pack.AnimalName,
				coop.helperTargetAnimal
			)
			and pack.JoinRequirements == "AutoAccept" then

			coop.helperTargetPackId = packId
			coop.helperLastActionAt = tick()

			state.questGroup.requestJoinIfFree(liveHandler, packId)

			runtimeMessage =
				"MMB helper: switched species and requested join to "
				.. tostring(coop.helperTargetName)
		else
			state.questGroup.restoreAFKAfterHelp()
		end
	end)

	return true
end

function state.questGroup.coopLeaveForProbe(handler, pack)
	local coop = state.questGroup.coop

	if coop.probeLeft
		or not handler
		or not pack
		or type(handler.Leave) ~= "function" then
		return false
	end

	-- The actual Player.Team value is a stronger live membership signal than
	-- the synchronized probe. Never force a confirmed MMB member to leave and
	-- rejoin just to test PackHandler replication.
	if state.questGroup.teamMatchesPack(
		player,
		pack
	) then
		state.questGroup.statusText =
			"MMB co-op: Team confirms membership; staying in group"

		return false
	end

	coop.probePackName =
		state.questGroup.getMMBPackName(pack)

	coop.probePackAnimal = pack.AnimalName
	coop.probePackId = nil
	coop.probeLeft = true
	coop.probeLeftAt =
		state.questGroup.coopServerTime()

	pcall(handler.Leave)

	state.questGroup.statusText =
		"MMB co-op probe: temporarily released membership"

	return true
end

function state.questGroup.coopResumeAfterProbe(handler)
	local coop = state.questGroup.coop

	if not coop.probeLeft then
		return false
	end

	local liveTeamName =
		state.questGroup.getPlayerMMBTeamName(
			player
		)

	if type(liveTeamName) == "string"
		and type(coop.probePackName) == "string"
		and liveTeamName:lower()
			== coop.probePackName:lower() then

		coop.probeLeft = false
		coop.probePackName = nil
		coop.probePackAnimal = nil
		coop.probePackId = nil

		state.questGroup.statusText =
			"MMB co-op: Team already confirms group membership"

		return true
	end

	local inWindow =
		state.questGroup.coopProbeState()

	if inWindow then
		return false
	end

	local packId, pack =
		state.questGroup.findMMBPackByName(
			handler,
			coop.probePackName
		)

	if pack
		and packId
		and type(handler.RequestJoin) == "function" then

		local character = player.Character
		local currentAnimal =
			character
			and character:GetAttribute("AnimalName")

		if state.questGroup.sameAnimal(
			currentAnimal,
			pack.AnimalName
		)
			and pack.JoinRequirements == "AutoAccept" then

			local requested, joinReason =
				state.questGroup.requestJoinIfFree(
					handler,
					packId
				)

			-- After Leave(), PackHandler can briefly keep the old membership
			-- replicated. Do not clear probeLeft until RequestJoin was ACTUALLY
			-- sent; otherwise the client can believe it rejoined while the old
			-- Leave is still finishing.
			if not requested then
				state.questGroup.statusText =
					joinReason == "already_grouped"
						and "MMB co-op probe: waiting for Leave replication before rejoin"
						or "MMB co-op probe: rejoin request not ready"

				return false
			end

			coop.probeLeft = false
			coop.probePackName = nil
			coop.probePackAnimal = nil
			coop.probePackId = nil

			state.questGroup.statusText =
				"MMB co-op probe complete: rejoining surviving group"

			return true
		end
	end

	-- Pack disappeared during the synchronized probe: the owner safely closed
	-- it, so an AFK helper can return to its original/preferred coin animal.
	coop.probeLeft = false
	coop.probePackName = nil
	coop.probePackAnimal = nil
	coop.probePackId = nil

	if coop.helperActive then
		state.questGroup.restoreAFKAfterHelp()
	end

	return false
end

function state.questGroup.coopLifecycleStep()
	if not state.alive
		or state.questGrowthReset.exclusive
		or questSwitchingAnimal
		or state.questGroup.coop.helperSwitching then
		return
	end

	local handler =
		state.questGroup.resolveHandler()

	if not handler then return end

	local coop = state.questGroup.coop
	local hasActiveGroupTime =
		state.questGroup.localHasActiveGroupTime()

	local inProbeWindow =
		state.questGroup.coopProbeState()

	local pack =
		state.questGroup.getCurrentPack(handler)

	local liveTeamName =
		state.questGroup.getPlayerMMBTeamName(
			player
		)

	-- PackHandler can lag behind Player.Team. While Team already says MMBx,
	-- never fall through to the "not grouped" branch and request another join.
	if not pack
		and liveTeamName then

		if coop.probeLeft then
			coop.probeLeft = false
			coop.probePackName = nil
			coop.probePackAnimal = nil
			coop.probePackId = nil
		end

		state.questGroup.statusText =
			"MMB co-op active via Team: "
			.. liveTeamName

		return
	end

	-- --------------------------------------------------------
	-- CURRENTLY IN AN MMB PACK
	-- --------------------------------------------------------
	if pack and state.questGroup.isMMBPack(pack) then
		local isOwner =
			state.questGroup.samePlayer(
				pack.Owner,
				player
			)

		if isOwner then
			-- Owner's quest still needs the pack: never close it.
			if hasActiveGroupTime then
				coop.ownerCompletedAt = 0
				coop.ownerSawMembersAfterComplete = false
				coop.ownerEmptyChecks = 0
				return
			end

			if coop.ownerCompletedAt <= 0 then
				coop.ownerCompletedAt =
					state.questGroup.coopServerTime()

				coop.ownerSawMembersAfterComplete =
					state.questGroup.hasOtherMember(pack)

				coop.ownerEmptyChecks = 0
			end

			local hasOthers =
				state.questGroup.hasOtherMember(pack)

			if hasOthers then
				coop.ownerSawMembersAfterComplete = true
				coop.ownerEmptyChecks = 0

				state.questGroup.statusText =
					inProbeWindow
					and "MMB owner complete: probe sees another active/dependent member"
					or "MMB owner complete: waiting for synchronized member probe"

				return
			end

			-- If nobody was present when our quest completed, two confirmations
			-- are enough. If somebody WAS present, only trust emptiness during
			-- the synchronized release window.
			local canConfirmEmpty =
				not coop.ownerSawMembersAfterComplete
				or inProbeWindow

			if canConfirmEmpty then
				coop.ownerEmptyChecks += 1
			else
				coop.ownerEmptyChecks = 0
			end

			if coop.ownerEmptyChecks >= 2
				and type(handler.Disband) == "function" then

				state.questGroup.statusText =
					"MMB owner: GroupTime complete and no active dependent member; disbanding"

				runtimeMessage =
					"MMB GroupTime finished: safely disbanding owned group"

				pcall(handler.Disband)

				coop.ownerCompletedAt = 0
				coop.ownerSawMembersAfterComplete = false
				coop.ownerEmptyChecks = 0
			end

			return
		end

		-- Non-owner with ACTIVE GroupTime is the key communication signal:
		-- remain in the pack even during the probe window.
		if hasActiveGroupTime then
			return
		end

		-- Non-owner without active GroupTime normally remains in the pack, as
		-- requested. Only during the short synchronized probe does it leave
		-- temporarily, so the owner can distinguish helpers/completed accounts
		-- from accounts that STILL have GroupTime.
		if inProbeWindow then
			state.questGroup.coopLeaveForProbe(
				handler,
				pack
			)
		end

		return
	end

	-- --------------------------------------------------------
	-- NOT CURRENTLY IN AN MMB PACK
	-- --------------------------------------------------------
	if coop.probeLeft then
		state.questGroup.coopResumeAfterProbe(
			handler
		)
		return
	end

	coop.ownerCompletedAt = 0
	coop.ownerSawMembersAfterComplete = false
	coop.ownerEmptyChecks = 0

	-- If our own GroupTime is active, normal ensureForCurrentAnimal owns all
	-- species/group decisions. AFK helper mode must not compete with it.
	if hasActiveGroupTime then
		if coop.helperActive then
			state.questGroup.clearAFKHelperState()
		end
		return
	end

	-- --------------------------------------------------------
	-- AFK Coin cooperative help, including CROSS-SPECIES switching.
	-- --------------------------------------------------------
	if state.farmCoins then
		if coop.helperActive then
			local packId, targetPack =
				state.questGroup.findMMBPackByName(
					handler,
					coop.helperTargetName
				)

			if not targetPack then
				state.questGroup.restoreAFKAfterHelp()
				return
			end

			local character = player.Character
			local currentAnimal =
				character
				and character:GetAttribute("AnimalName")

			if state.questGroup.sameAnimal(
				currentAnimal,
				targetPack.AnimalName
			)
				and targetPack.JoinRequirements == "AutoAccept"
				and type(handler.RequestJoin) == "function"
				and tick() - (coop.helperLastActionAt or 0) >= 2 then

				coop.helperLastActionAt = tick()
				coop.helperTargetPackId = packId

				state.questGroup.requestJoinIfFree(handler, packId)
			end

			return
		end

		if state.busy
			or criticalRecoveryActive
			or DAMAGE.active
			or state.coinFarmSwitching
			or drinkingToFull
			or eatingToFull then
			return
		end

		local character = player.Character
		local currentAnimal =
			character
			and character:GetAttribute("AnimalName")

		if type(currentAnimal) ~= "string"
			or currentAnimal == "" then
			return
		end

		local target =
			state.questGroup.findAFKHelpTarget(
				handler,
				savedCharacters(),
				currentAnimal
			)

		if target then
			state.questGroup.beginAFKHelp(
				handler,
				target
			)
		end

		return
	end

	-- Helper session is no longer relevant if AFK Coin itself was disabled.
	if coop.helperActive then
		state.questGroup.clearAFKHelperState()
	end
end


local function recursiveStringMatch(value, lookup, seen)
	local valueType = type(value)
	if valueType == "string" then
		return lookup[value:lower()]
	end
	if valueType ~= "table" then return nil end
	seen = seen or {}
	if seen[value] then return nil end
	seen[value] = true
	for key, child in pairs(value) do
		local result = recursiveStringMatch(child, lookup, seen)
		if result then return result end
		if type(key) == "string" then
			result = lookup[key:lower()]
			if result then return result end
		end
	end
end

local zoneLookup = {}
local function refreshZoneLookup()
	for zoneName in pairs(QUEST_ZONES) do
		zoneLookup[zoneName:lower()] = zoneName
	end
	zoneLookup["pride rock"] = "Pride Rock"
	local mapZones = workspace:FindFirstChild("MapZones")
	if mapZones then
		for _, zoneObject in ipairs(mapZones:GetChildren()) do
			zoneLookup[zoneObject.Name:lower()] = zoneObject.Name
		end
	end
end
refreshZoneLookup()

local function findZoneInQuest(quest)
	refreshZoneLookup()

	local entry = quest and quest.entry or quest
	local zone = recursiveStringMatch(entry, zoneLookup)
	if zone then return zone end

	-- Fallback da HUD: só aceita uma zona encontrada no frame que também
	-- contém o título da própria missão. Isso evita pegar a zona de outra quest.
	local gui = player:FindFirstChild("PlayerGui")
	local questsGui = gui and gui:FindFirstChild("QuestsScreenGui")
	local title = quest and quest.props and quest.props.Title
	local wantedTitle = type(title) == "string" and title:lower() or nil
	if questsGui and wantedTitle then
		local scrolling = questsGui:FindFirstChild("RefScrollingFrame", true)
		if scrolling then
			for _, frame in ipairs(scrolling:GetChildren()) do
				if frame:IsA("GuiObject") and frame.Name:match("^QuestFrame%d+$") then
					local pieces = {}
					for _, object in ipairs(frame:GetDescendants()) do
						if object:IsA("TextLabel") or object:IsA("TextButton") then
							table.insert(pieces, tostring(object.Text))
						end
					end
					local combined = table.concat(pieces, " "):lower()
					if combined:find(wantedTitle, 1, true) then
						for key, canonical in pairs(zoneLookup) do
							if combined:find(key, 1, true) then
								return canonical
							end
						end
					end
				end
			end
		end
	end
end

local function getPlayerZoneName()
	return state.questCurrentZoneName()
end

local function getZonePosition(zoneName)
	if QUEST_ZONES[zoneName] then return QUEST_ZONES[zoneName] end

	if zoneName == "Pride Rock" then
		local spawns = workspace:FindFirstChild("Spawns")
		local pride = spawns and spawns:FindFirstChild("PrideRockSpawn1", true)
		if pride and pride:IsA("BasePart") then return pride.Position end
	end

	local mapZones = workspace:FindFirstChild("MapZones")
	local zoneModel = mapZones and mapZones:FindFirstChild(zoneName)
	if not zoneModel then return nil end

	local bestPart, bestVolume
	for _, object in ipairs(zoneModel:GetDescendants()) do
		if object:IsA("BasePart") then
			local volume = object.Size.X * object.Size.Y * object.Size.Z
			if not bestVolume or volume > bestVolume then
				bestPart, bestVolume = object, volume
			end
		end
	end
	return bestPart and bestPart.Position or nil
end

function state.questAnimalKey(animalName)
	if type(animalName) ~= "string" then return "" end

	-- "Yellow Hornbill", "YellowHornbill" and "yellow-hornbill"
	-- must all resolve to the same species.
	return animalName:lower():gsub("[^%w]", "")
end

function state.questIsFlyingAnimalName(animalName)
	local key = state.questAnimalKey(animalName)
	return key ~= "" and state.questFlyingAnimals[key] == true
end

function state.questIsFlyingCharacter(character)
	if not character then return false end
	local animalName = character:GetAttribute("AnimalName")
	if type(animalName) ~= "string" or animalName == "" then
		animalName = CROC.getAnimalName(character)
	end
	return state.questIsFlyingAnimalName(animalName)
end

local function isSwimQuest(props)
	if not props or props.QuestType ~= "TravelDistance" then return false end
	local allowed = props.QuestData and props.QuestData.AllowedMovementStates
	if type(allowed) ~= "table" or #allowed == 0 then return false end

	local hasSwimming = false
	for _, movementState in ipairs(allowed) do
		if movementState == "Swimming" then
			hasSwimming = true
		else
			return false
		end
	end
	return hasSwimming
end

local function isLandDistanceQuest(props)
	if not props or props.QuestType ~= "TravelDistance" then return false end
	local allowed = props.QuestData and props.QuestData.AllowedMovementStates
	if type(allowed) ~= "table" or #allowed == 0 then return false end

	local hasLandState = false
	for _, movementState in ipairs(allowed) do
		if movementState == "Swimming" then
			return false
		end
		if movementState == "Walking"
			or movementState == "Trotting"
			or movementState == "Running"
			or movementState == "Sprinting" then
			hasLandState = true
		end
	end
	return hasLandState
end

function state.questSetW(active, forceReassert)
	if active and state.questLandRefreshingW and not forceReassert then
		return
	end

	if not active then
		if state.questLandKeyDown then
			pcall(function()
				local env = (getgenv and getgenv()) or _G
				local release = env and env.keyrelease
				if type(release) == "function" then
					release(0x57) -- W
				end
			end)

			pcall(function()
				VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
			end)
		end

		state.questLandKeyDown = false
		state.questLandLastPulseAt = 0
		state.questLandLastRefreshAt = 0
		return
	end

	-- Normal path: W was already held by us, so do nothing.
	-- forceReassert is used only after real player input. A physical KeyUp can
	-- cancel an executor-generated KeyDown even though our boolean is still true.
	if state.questLandKeyDown and not forceReassert then
		return
	end

	local pressed = false

	-- Prefer the executor keyboard API: this is a genuine KeyDown that remains
	-- held until keyrelease(). Calling it again after user input simply restores
	-- the held state; it does not spam while the player is idle.
	pcall(function()
		local env = (getgenv and getgenv()) or _G
		local press = env and env.keypress
		if type(press) == "function" then
			press(0x57) -- W
			pressed = true
		end
	end)

	if not pressed then
		pcall(function()
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, game)
			pressed = true
		end)
	end

	state.questLandKeyDown = pressed or state.questLandKeyDown
end

function state.questPulseWForAutoRun()
	if state.questAutoRunWPulseBusy
		or not state.alive then
		return false
	end

	state.questAutoRunWPulseBusy = true

	task.spawn(function()
		-- Kill any old held-W state first. Pure AutoRun steering is MoveTo.
		state.questSetW(false)

		if not state.alive
			or not state.autoQuests
			or not state.autoRunMoveOwnsInput
			or state.busy
			or drinkingToFull
			or eatingToFull
			or criticalRecoveryActive
			or DAMAGE.active then

			state.questAutoRunWPulseBusy = false
			return
		end

		local pressed = false

		pcall(function()
			local env =
				(getgenv and getgenv())
				or _G

			local press =
				env and env.keypress

			if type(press) == "function" then
				press(0x57)
				pressed = true
			end
		end)

		if not pressed then
			pcall(function()
				VirtualInputManager:SendKeyEvent(
					true,
					Enum.KeyCode.W,
					false,
					game
				)
				pressed = true
			end)
		end

		-- Only a short state pulse. It must never become the steering source.
		task.wait(0.045)

		pcall(function()
			local env =
				(getgenv and getgenv())
				or _G

			local release =
				env and env.keyrelease

			if type(release) == "function" then
				release(0x57)
			end
		end)

		pcall(function()
			VirtualInputManager:SendKeyEvent(
				false,
				Enum.KeyCode.W,
				false,
				game
			)
		end)

		state.questLandKeyDown = false
		state.questLandLastPulseAt = tick()
		state.questAutoRunWPulseBusy = false
	end)

	return true
end

function state.questHardRefreshW(reason, silent)
	if state.questLandRefreshingW then
		return false
	end

	if not state.alive
		or not state.autoQuests
		or state.questGrowthReset.exclusive
		or not (state.questLandInputActive or state.questSwimActive)
		or questSwitchingAnimal
		or state.busy
		or criticalRecoveryActive
		or DAMAGE.active
		or drinkingToFull
		or eatingToFull then
		return false
	end

	state.questLandRefreshingW = true

	-- A real player KeyUp can cancel an executor KeyDown while our boolean still
	-- says W is held. Do a REAL release -> short settle -> fresh press.
	pcall(function()
		local env = (getgenv and getgenv()) or _G
		local release = env and env.keyrelease
		if type(release) == "function" then
			release(0x57)
		end
	end)

	pcall(function()
		VirtualInputManager:SendKeyEvent(
			false,
			Enum.KeyCode.W,
			false,
			game
		)
	end)

	state.questLandKeyDown = false
	task.wait(0.045)

	local pressed = false

	if state.alive
		and state.autoQuests
		and not state.questGrowthReset.exclusive
		and (state.questLandInputActive or state.questSwimActive)
		and not questSwitchingAnimal
		and not state.busy
		and not criticalRecoveryActive
		and not DAMAGE.active
		and not drinkingToFull
		and not eatingToFull then

		pcall(function()
			local env = (getgenv and getgenv()) or _G
			local press = env and env.keypress
			if type(press) == "function" then
				press(0x57)
				pressed = true
			end
		end)

		if not pressed then
			pcall(function()
				VirtualInputManager:SendKeyEvent(
					true,
					Enum.KeyCode.W,
					false,
					game
				)
				pressed = true
			end)
		end

		if pressed then
			state.questLandKeyDown = true
			state.questLandLastRefreshAt = tick()

			-- Refresh the movement state too. If W was cancelled, Savannah can
			-- also stop accepting distance until Running/Sprinting is reasserted.
			blockClientSubState = false
			setSubState(
				state.questSwimActive
					and "Swimming"
					or (state.questMoveSubState or "Running")
			)
			blockClientSubState = false
		end
	end

	state.questLandRefreshingW = false

	if pressed and reason and not silent then
		runtimeMessage = reason
	end

	return pressed
end


local function isTravelQuestForAutoRun(props)
	if not props or props.QuestType ~= "TravelDistance" then return false end
	local allowed = props.QuestData and props.QuestData.AllowedMovementStates
	if type(allowed) ~= "table" or #allowed == 0 then return true end
	for _, movementState in ipairs(allowed) do
		if movementState ~= "Swimming" then return true end
	end
	return false
end

local function findSpecificAnimalTarget(quest, records)
	local data = quest.props and quest.props.QuestData
	if not data or not data.ShouldBeSpawnedAsSpecificAnimalName then return nil end

	local lookup = {}

	-- Existing slots are the most reliable spelling/casing source.
	for _, entry in ipairs(records or {}) do
		if type(entry.AnimalName) == "string" and entry.AnimalName ~= "" then
			lookup[entry.AnimalName:lower()] = entry.AnimalName
		end
	end

	-- AnimalConfig[AnimalType][AnimalName] lets us recognize a quest target
	-- even if this account currently has no SavedCharacter for that species.
	if type(AnimalConfig) == "table" then
		for _, animalTypeBucket in pairs(AnimalConfig) do
			if type(animalTypeBucket) == "table" then
				for animalName, configData in pairs(animalTypeBucket) do
					if type(animalName) == "string"
						and animalName ~= ""
						and type(configData) == "table" then
						lookup[animalName:lower()] = animalName
					end
				end
			end
		end
	end

	local target = recursiveStringMatch(quest.entry, lookup)
	if target then return target end

	-- Fallback da HUD para quests cujo animal escolhido só aparece no texto.
	local gui = player:FindFirstChild("PlayerGui")
	local questsGui = gui and gui:FindFirstChild("QuestsScreenGui")
	local scrolling = questsGui and questsGui:FindFirstChild("RefScrollingFrame", true)
	local title = quest.props and quest.props.Title
	local wantedTitle = type(title) == "string" and title:lower() or nil

	if scrolling and wantedTitle then
		for _, frame in ipairs(scrolling:GetChildren()) do
			if frame:IsA("GuiObject") and frame.Name:match("^QuestFrame%d+$") then
				local pieces = {}
				for _, object in ipairs(frame:GetDescendants()) do
					if object:IsA("TextLabel") or object:IsA("TextButton") then
						table.insert(pieces, tostring(object.Text))
					end
				end

				local combined = table.concat(pieces, " "):lower()
				if combined:find(wantedTitle, 1, true) then
					for lowerName, canonical in pairs(lookup) do
						if combined:find(lowerName, 1, true) then
							return canonical
						end
					end
				end
			end
		end
	end
end


function state.questSlots.findAnimalSlot(records, animalName)
	local wantedKey = state.questAnimalKey(animalName)
	if wantedKey == "" then return nil end

	for _, entry in ipairs(records or {}) do
		if type(entry) == "table"
			and type(entry.AnimalName) == "string"
			and state.questAnimalKey(entry.AnimalName) == wantedKey then
			return entry
		end
	end
end

function state.questSlots.findExactSlot(records, characterName, animalName)
	if type(characterName) ~= "string" then return nil end
	for _, entry in ipairs(records or {}) do
		if type(entry) == "table"
			and entry.CharacterName == characterName
			and (not animalName
				or (type(entry.AnimalName) == "string"
					and entry.AnimalName:lower() == animalName:lower())) then
			return entry
		end
	end
end

function state.questSlots.generateQuestName(records)
	local used = {}
	for _, entry in ipairs(records or {}) do
		if type(entry.CharacterName) == "string" then
			used[entry.CharacterName:lower()] = true
		end
	end

	-- Apenas letras para evitar qualquer validação de nome que rejeite números.
	local alphabet = "abcdefghijklmnopqrstuvwxyz"
	for attempt = 1, 40 do
		local seed = player.UserId + math.floor(tick() * 10) + attempt * 7919
		local chars = { "Q" }
		for index = 1, 7 do
			local position = ((seed + index * 3571) % #alphabet) + 1
			chars[#chars + 1] = alphabet:sub(position, position)
			seed = math.floor(seed / 3) + position * 97
		end
		local candidate = table.concat(chars)
		if not used[candidate:lower()] then return candidate end
	end
end

function state.questSlots.deleteTempForNext(nextAnimal)
	local temp = state.questSlots.temp
	if not temp or state.questSlots.busy then return false end
	if type(nextAnimal) == "string"
		and type(temp.animalName) == "string"
		and temp.animalName:lower() == nextAnimal:lower() then
		return false
	end

	local records = savedCharacters()
	local exact = state.questSlots.findExactSlot(records, temp.characterName, temp.animalName)
	if not exact then
		-- Só apagamos slots que ESTA execução criou e confirmou. Se ele já não
		-- existe, limpamos o marcador sem tocar em nenhum outro slot do usuário.
		state.questSlots.temp = nil
		return false
	end

	local deleteRemote = ReplicatedStorage:FindFirstChild("DeleteCharacterRemoteFunction")
		or ReplicatedStorage:WaitForChild("DeleteCharacterRemoteFunction", 5)
	if not deleteRemote then
		state.questSlots.statusText = "Quest slot: DeleteCharacterRemoteFunction not found"
		questStatusText = "Cannot replace temporary quest slot"
		return true
	end

	state.questSlots.busy = true
	questSwitchingAnimal = true
	questTravelWanted = false
	state.questTravelActive = false

	task.spawn(function()
		if not state.alive then
			state.questSlotsFinishTransaction(
				nil,
				false
			)

			return
		end

		runtimeMessage =
			"Quest slot: removing temporary "
			.. tostring(temp.animalName)

		local current = player.Character
		local currentName = current and current:GetAttribute("CharacterName")
		if currentName == temp.characterName
			and not state.prepareCurrentSlotForSwitch(
				"Quest slot: staging temporary animal before deletion"
			) then
			state.questSlotsFinishTransaction(
				"Temporary quest slot deletion postponed: staging failed"
			)
			return
		end

		if currentName == temp.characterName
			and ResetRemote then

			pcall(
				ResetRemote.InvokeServer,
				ResetRemote
			)

			task.wait(1.5)
		end

		if not state.alive then
			state.questSlotsFinishTransaction(
				nil,
				false
			)

			return
		end

		local ok =
			pcall(
				deleteRemote.InvokeServer,
				deleteRemote,
				temp.characterName
			)
		if ok then
			local deadline = tick() + 7
			local removed = false
			repeat
				task.wait(0.35)
				local refreshed = savedCharacters()
				removed = state.questSlots.findExactSlot(
					refreshed,
					temp.characterName,
					temp.animalName
				) == nil
			until removed or tick() >= deadline

			if removed then
				state.questSlots.temp = nil
				runtimeMessage = "Quest slot removed; preparing " .. tostring(nextAnimal)
			else
				runtimeMessage = "Quest slot deletion was not confirmed; keeping it"
				questStatusText = "Temporary slot deletion not confirmed"
			end
		else
			runtimeMessage = "Quest slot delete remote failed; keeping slot"
			questStatusText = "Temporary slot deletion failed"
		end

		state.questSlotsFinishTransaction(
			nil
		)
	end)

	return true
end

function state.questSlots.createForQuest(
	quest,
	targetAnimal,
	records
)
	if state.questSlots.busy
		or questSwitchingAnimal
		or state.busy
		or criticalRecoveryActive then

		return true
	end

	if not CreateRemote
		or type(targetAnimal) ~= "string"
		or targetAnimal == "" then

		return false
	end

	-- Hard rule: flying species are forbidden until ALL Auto Run quests finish.
	if state.questIsFlyingAnimalName(targetAnimal)
		and (
			state.questBlockFlying
			or (
				state.questPendingLandCount
				or 0
			) > 0
		) then

		questStatusText =
			string.format(
				"Running quests first (%d pending); flying animal blocked",
				state.questPendingLandCount
					or 0
			)

		runtimeMessage =
			"Flying quest slot blocked until all running quests finish"

		return true
	end

	records =
		records
		or savedCharacters()

	local previousEntry
	local currentCharacter =
		player.Character

	local currentCharacterName =
		currentCharacter
			and currentCharacter:GetAttribute(
				"CharacterName"
			)

	if type(currentCharacterName)
		== "string" then

		for _, entry in ipairs(records) do
			if type(entry) == "table"
				and entry.CharacterName
					== currentCharacterName then

				previousEntry = entry
				break
			end
		end
	end

	-- Never create a duplicate if replication changed since the previous scan.
	local existing =
		state.questSlots.findAnimalSlot(
			records,
			targetAnimal
		)

	if existing then
		return false
	end

	if #records
			>= (
				state.questSlots.maxSlots
				or 40
			)
		and not state.questSlots.hasDeletableTemp(
			records,
			targetAnimal
		) then

		state.questSlots.markBlocked(
			targetAnimal,
			"no_free_slot"
		)

		questStatusText =
			"Skipping "
			.. targetAnimal
			.. ": NO FREE SLOT"

		runtimeMessage =
			"Specific-animal quest skipped; checking other quests / Growth / AFK Coins"

		return false
	end

	local failedUntil =
		state.questSlots.failedUntil[
			targetAnimal:lower()
		] or 0

	if tick() < failedUntil then
		state.questSlots.markBlocked(
			targetAnimal,
			"create_retry"
		)

		questStatusText =
			"Skipping "
			.. targetAnimal
			.. " until slot-create retry"

		return false
	end

	local characterName =
		state.questSlots.generateQuestName(
			records
		)

	if not characterName then
		questStatusText =
			"Could not generate a safe quest slot name"

		return false
	end

	state.questSlots.busy = true
	questSwitchingAnimal = true
	questTravelWanted = false
	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil

	if state.questSetW then
		pcall(
			state.questSetW,
			false
		)
	end

	task.spawn(function()
		runtimeMessage =
			"Quest slot: preparing "
			.. targetAnimal

		-- v110: the previous code ALWAYS walked to getSafeFarmPosition() here.
		-- On ordinary dry ground that movement is unnecessary and hijacks the
		-- current animal's controls. Only recover physically if position is
		-- genuinely unsafe.
		local prepared =
			state.questSlotsPrepareForCreate()

		if not state.alive then
			state.questSlotsFinishTransaction(
				nil,
				false
			)

			return
		end

		if not prepared then
			state.questSlotsFinishTransaction(
				"Quest slot: could not confirm safe position; retrying later"
			)

			state.questSlots.failedUntil[
				targetAnimal:lower()
			] = tick() + 4

			return
		end

		runtimeMessage =
			"Quest slot: validating/creating "
			.. targetAnimal

		if ResetRemote then
			pcall(
				ResetRemote.InvokeServer,
				ResetRemote
			)

			task.wait(1.5)
		end

		-- CRITICAL re-execution guard:
		-- an old script execution is forbidden from creating/spawning a slot
		-- after its cleanup has already set state.alive=false.
		if not state.alive then
			state.questSlotsFinishTransaction(
				nil,
				false
			)

			return
		end

		local refreshedBefore =
			savedCharacters()

		local appearedExisting =
			state.questSlots.findAnimalSlot(
				refreshedBefore,
				targetAnimal
			)

		if appearedExisting then
			local spawned =
				spawnSlot(
					appearedExisting,
					true,
					true
				)

			if not state.alive then
				state.questSlotsFinishTransaction(
					nil,
					false
				)

				return
			end

			state.applySurvivalDefaults(false)

			state.questSlotsFinishTransaction(
				spawned
					and "Quest animal ready; resuming quest automation"
					or "Quest slot found but spawn was not confirmed; retrying"
			)

			questStatusText =
				spawned
					and "Quest animal ready; rescanning missions"
					or "Quest animal spawn retry pending"

			return
		end

		if #refreshedBefore
			>= (
				state.questSlots.maxSlots
				or 40
			) then

			state.questSlots.markBlocked(
				targetAnimal,
				"no_free_slot"
			)

			questStatusText =
				"Skipping "
				.. targetAnimal
				.. ": NO FREE SLOT"

			runtimeMessage =
				"Quest slot creation cancelled at 40/40; recovering previous slot and moving on"

			if previousEntry
				and state.alive then

				spawnSlot(
					previousEntry,
					true,
					true
				)
			end

			state.applySurvivalDefaults(false)

			state.questSlotsFinishTransaction(
				"Quest slot: no free slot; previous animal restored"
			)

			return
		end

		if not state.alive then
			state.questSlotsFinishTransaction(
				nil,
				false
			)

			return
		end

		local gender =
			state.newSlotGender
			or "Male"

		local invokeOk =
			pcall(
				CreateRemote.InvokeServer,
				CreateRemote,
				characterName,
				targetAnimal,
				gender,
				"Default"
			)

		if not state.alive then
			state.questSlotsFinishTransaction(
				nil,
				false
			)

			return
		end

		local created

		if invokeOk then
			local deadline =
				tick() + 8

			repeat
				task.wait(0.4)

				if not state.alive then
					break
				end

				local refreshed =
					savedCharacters()

				created =
					state.questSlots.findExactSlot(
						refreshed,
						characterName,
						targetAnimal
					)

			until created
				or tick() >= deadline
		end

		if not state.alive then
			state.questSlotsFinishTransaction(
				nil,
				false
			)

			return
		end

		if created then
			state.questSlots.temp = {
				characterName =
					characterName,
				animalName =
					targetAnimal,
				questId =
					quest
						and quest.id
						or nil,
			}

			runtimeMessage =
				"Quest-only slot confirmed: "
				.. targetAnimal

			questStatusText =
				"Created quest slot: "
				.. targetAnimal

			-- v110:
			-- DO NOT call normal spawnSlot post-spawn SafeMove here. The quest
			-- worker should take over immediately after the exact slot appears.
			local spawned =
				spawnSlot(
					created,
					true,
					true
				)

			if not state.alive then
				state.questSlotsFinishTransaction(
					nil,
					false
				)

				return
			end

			state.questSlotsNormalizeControl(
				player.Character
			)

			state.applySurvivalDefaults(false)

			if spawned then
				questStatusText =
					"Quest animal ready; rescanning missions"

				state.questSlotsFinishTransaction(
					"Quest animal ready; resuming quest automation"
				)
			else
				questStatusText =
					"Created quest slot; spawn retry pending"

				-- Slot exists in SavedCharacters, so the next quest scan can
				-- switch to it normally instead of trying to CREATE it again.
				state.questSlotsFinishTransaction(
					"Quest slot created but spawn was not confirmed; rescanning"
				)
			end

		else
			state.questSlots.failedUntil[
				targetAnimal:lower()
			] = tick() + 60

			state.questSlots.markBlocked(
				targetAnimal,
				"create_retry"
			)

			runtimeMessage =
				"Quest slot unavailable/rejected; previous slot restored and other quests continue"

			questStatusText =
				"Skipping unavailable quest animal for now: "
				.. targetAnimal

			if previousEntry
				and state.alive then

				spawnSlot(
					previousEntry,
					true,
					true
				)
			end

			state.applySurvivalDefaults(false)

			state.questSlotsFinishTransaction(
				"Quest slot unavailable; previous animal restored"
			)
		end
	end)

	return true
end

function state.questSlots.hasDeletableTemp(records, targetAnimal)
	local temp = state.questSlots.temp
	if type(temp) ~= "table"
		or type(temp.characterName) ~= "string"
		or type(temp.animalName) ~= "string" then
		return false
	end

	if type(targetAnimal) == "string"
		and state.questAnimalKey(temp.animalName)
			== state.questAnimalKey(targetAnimal) then
		return false
	end

	return state.questSlots.findExactSlot(
		records or {},
		temp.characterName,
		temp.animalName
	) ~= nil
end

function state.questSlots.markBlocked(targetAnimal, reason)
	if type(targetAnimal) ~= "string" or targetAnimal == "" then return end

	local key = state.questAnimalKey(targetAnimal)
	if key == "" then return end

	local previous = state.questSlots.blockedAnimals[key]

	state.questSlots.blockedAnimals[key] = {
		animalName = targetAnimal,
		reason = reason or "unavailable",
		since = previous and previous.since or tick(),
	}

	state.questSlots.lastSkippedAnimal = targetAnimal
	state.questForceFastRecheckUntil = tick() + 15
end

function state.questSlots.clearBlocked(targetAnimal)
	if type(targetAnimal) ~= "string" then return end
	local key = state.questAnimalKey(targetAnimal)
	if key ~= "" then
		state.questSlots.blockedAnimals[key] = nil
	end
end

function state.questSlots.unavailableReason(targetAnimal, records)
	if type(targetAnimal) ~= "string" or targetAnimal == "" then
		return nil
	end

	records = records or savedCharacters()

	-- A slot appeared later: immediately make the quest viable again.
	if state.questSlots.findAnimalSlot(records, targetAnimal) then
		state.questSlots.clearBlocked(targetAnimal)
		state.questSlots.failedUntil[targetAnimal:lower()] = nil
		return nil
	end

	-- Flying PlayTime quests are optional when the account does not already own
	-- that bird. Do not let slot creation / retry monopolize Auto Quests while a
	-- ZoneTime, TravelDistance or GroupTime quest can continue in parallel.
	if state.questIsFlyingAnimalName(targetAnimal) then
		state.questSlots.markBlocked(
			targetAnimal,
			"missing_flying_slot"
		)
		return "missing_flying_slot"
	end

	local key = state.questAnimalKey(targetAnimal)
	local maxSlots = state.questSlots.maxSlots or 40

	-- A confirmed script-created temp slot can be deleted to make room, so a
	-- 40/40 account is NOT considered impossible in that case.
	local deletableTemp =
		state.questSlots.hasDeletableTemp(records, targetAnimal)

	if #records >= maxSlots and not deletableTemp then
		state.questSlots.markBlocked(targetAnimal, "no_free_slot")
		return "no_free_slot"
	end

	-- If a slot has been manually deleted later, clear a persistent 40/40
	-- block and let Auto Quests try the animal again.
	local blocked = state.questSlots.blockedAnimals[key]
	if blocked and blocked.reason == "no_free_slot" then
		state.questSlots.blockedAnimals[key] = nil
	end

	-- A server rejection / ownership failure should not freeze every other
	-- quest for a minute. Ignore only THIS animal until its retry cooldown ends.
	local failedUntil =
		state.questSlots.failedUntil[targetAnimal:lower()] or 0

	if tick() < failedUntil then
		state.questSlots.markBlocked(targetAnimal, "create_retry")
		return "create_retry"
	end

	if blocked and blocked.reason == "create_retry" then
		state.questSlots.blockedAnimals[key] = nil
	end

	return nil
end

-- ============================================================
-- GroupTime viability
-- ============================================================
function state.questGroup.hasRealPossibility(records, allowAnimalSwitch)
	local handler = state.questGroup.resolveHandler()
	if not handler then return false end

	records = records or savedCharacters()

	local animalName = state.questGroup.getPlayerAnimal(player)
	if type(animalName) ~= "string" or animalName == "" then
		return false
	end

	local currentPack = state.questGroup.getCurrentPack(handler)
	if currentPack
		and state.questGroup.sameAnimal(currentPack.AnimalName, animalName)
		and state.questGroup.hasOtherMember(currentPack) then
		return true
	end

	-- Somebody of our current species exists: we can invite them or they can
	-- join our AutoAccept pack.
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player
			and state.questGroup.sameAnimal(
				state.questGroup.getPlayerAnimal(other),
				animalName
			) then
			return true
		end
	end

	-- Existing AutoAccept packs are also real possibilities. Generic GroupTime
	-- may switch species only when we already own a usable saved slot.
	if type(handler.GetData) == "function" then
		local ok, packs = pcall(handler.GetData)

		if ok and type(packs) == "table" then
			for _, candidate in pairs(packs) do
				if type(candidate) == "table"
					and type(candidate.AnimalName) == "string"
					and candidate.AnimalName ~= ""
					and candidate.Owner
					and not state.questGroup.samePlayer(candidate.Owner, player)
					and candidate.JoinRequirements == "AutoAccept" then

					if state.questGroup.sameAnimal(
						candidate.AnimalName,
						animalName
					) then
						return true
					end

					if allowAnimalSwitch
						and not (
							state.questIsFlyingAnimalName(candidate.AnimalName)
							and (
								state.questBlockFlying
								or (state.questPendingLandCount or 0) > 0
							)
						)
						and state.questGroup.findOwnedSlot(
							records,
							candidate.AnimalName
						) then
						return true
					end
				end
			end
		end
	end

	return false
end

function state.questGroup.refreshAvailability(records, allowAnimalSwitch)
	local animalName = state.questGroup.getPlayerAnimal(player)

	if state.questGroup.availabilityAnimal ~= animalName then
		state.questGroup.availabilityAnimal = animalName
		state.questGroup.impossibleSince = nil
		state.questGroup.ignoredUntilPossibility = false
	end

	local possible = state.questGroup.hasRealPossibility(
		records,
		allowAnimalSwitch == true
	)

	if possible then
		local wasIgnored = state.questGroup.ignoredUntilPossibility

		state.questGroup.impossibleSince = nil
		state.questGroup.ignoredUntilPossibility = false
		state.questGroup.lastPossibilityAt = tick()

		if wasIgnored then
			state.questGroup.difficultySince = tick()
			state.questGroup.statusText =
				"Grouping: new server possibility detected; GroupTime resumed"
			runtimeMessage =
				"GroupTime resumed: a valid player/pack is now available"
			state.questForceFastRecheckUntil = tick() + 20
		end

		return true
	end

	if not state.questGroup.impossibleSince then
		state.questGroup.impossibleSince = tick()
	end

	-- Empty server can be classified quickly. Otherwise give players/packs a
	-- short grace period before declaring this GroupTime currently impossible.
	local grace = #Players:GetPlayers() <= 1 and 8 or 25

	if tick() - state.questGroup.impossibleSince >= grace then
		if not state.questGroup.ignoredUntilPossibility then
			state.questGroup.ignoredUntilPossibility = true
			state.questGroup.statusText =
				"Grouping ignored: no viable player/pack in this server"
			runtimeMessage =
				"GroupTime skipped until a new grouping possibility appears"
			state.questForceFastRecheckUntil = tick() + 20
		end

		return false
	end

	state.questGroup.statusText =
		"Grouping: checking server possibilities before skipping"

	return true
end

-- ============================================================
-- One common "can this quest actually be worked on now?" filter.
-- Ignored quests stay visible/incomplete on Roblox, but they no longer block
-- Growth Existing Slots -> AFK Coin handoff.
-- ============================================================
function state.questIsActionable(quest, records)
	if type(quest) ~= "table"
		or type(quest.props) ~= "table"
		or state.questGroup.questComplete(quest) then
		return false
	end

	records = records or savedCharacters()

	local targetAnimal = findSpecificAnimalTarget(quest, records)
	local questData =
		quest.props.QuestData or {}

	-- If Roblox says this PlayTime requires a specific animal but the target
	-- cannot be resolved to a real species, it is not actionable on this
	-- account/runtime. Skip only this quest and continue Zone/Travel/Group.
	if questData.ShouldBeSpawnedAsSpecificAnimalName
		and not targetAnimal then
		return false, "specific_animal_unresolved", nil
	end

	if targetAnimal then
		local reason =
			state.questSlots.unavailableReason(targetAnimal, records)

		if reason then
			return false, reason, targetAnimal
		end
	end

	if quest.props.QuestType == "GroupTime" then
		local possible = state.questGroup.refreshAvailability(
			records,
			true
		)

		if not possible
			and state.questGroup.ignoredUntilPossibility then
			return false, "group_unavailable", nil
		end
	end

	return true, nil, targetAnimal
end

function state.questHasActionablePending(quests, records)
	records = records or savedCharacters()

	for _, quest in ipairs(quests or {}) do
		local actionable = state.questIsActionable(quest, records)
		if actionable then
			return true
		end
	end

	return false
end


function state.questAnimalIsCarnivoreName(animalName)
	if type(animalName) ~= "string" or animalName == "" then return false end
	if CARNIVORE_NAMES_LOWER[animalName:lower()] then return true end

	-- AnimalConfig fallback in case a carnivore is added later and is not in
	-- the static compatibility list.
	if type(AnimalConfig) == "table" then
		local function scan(value, depth)
			if depth > 5 or type(value) ~= "table" then return nil end
			for key, child in pairs(value) do
				if type(key) == "string" and type(child) == "string" then
					local lowerKey = key:lower()
					local lowerValue = child:lower()
					if lowerKey:find("class", 1, true)
						or lowerKey:find("diet", 1, true)
						or lowerKey:find("food", 1, true) then
						if lowerValue:find("carn", 1, true) then return true end
						if lowerValue:find("herb", 1, true) then return false end
					end
				elseif type(child) == "table" then
					local found = scan(child, depth + 1)
					if found ~= nil then return found end
				end
			end
			return nil
		end

		for _, bucket in pairs(AnimalConfig) do
			if type(bucket) == "table" then
				for configuredName, data in pairs(bucket) do
					if type(configuredName) == "string"
						and configuredName:lower() == animalName:lower()
						and type(data) == "table" then
						local found = scan(data, 0)
						if found ~= nil then return found end
					end
				end
			end
		end
	end

	-- Savannah/Dino Life are effectively herbivore unless explicitly known
	-- as carnivore above. This keeps Growth on the easier diet when possible.
	return false
end

function state.questFindCurrentSavedEntry(records, character)
	if type(records) ~= "table" or not character then return nil end

	local characterName = character:GetAttribute("CharacterName")
	local uniqueName = character:GetAttribute("UniqueCharacterName")
		or character:GetAttribute("CharacterUniqueName")

	for _, entry in ipairs(records) do
		if type(entry) == "table" then
			if type(characterName) == "string"
				and (entry.CharacterName == characterName
					or entry.UniqueCharacterName == characterName) then
				return entry
			end

			if type(uniqueName) == "string"
				and (entry.UniqueCharacterName == uniqueName
					or entry.CharacterName == uniqueName) then
				return entry
			end
		end
	end

	-- Spawn replication can lag behind SavedCharacters. The expected slot is
	-- more reliable than guessing another mature slot during that window.
	local expected = state.questExpectedSlot
	if type(expected) == "table" then
		for _, entry in ipairs(records) do
			if type(entry) == "table" then
				local sameUnique = expected.uniqueName
					and entry.UniqueCharacterName == expected.uniqueName
				local sameName = expected.characterName
					and entry.CharacterName == expected.characterName
				if sameUnique or sameName then
					return entry
				end
			end
		end
	end
end

function state.questFindHerbivoreSlot(records, requireComplete, excludedName, animalName)
	local best
	local bestGrowth = -math.huge

	for _, entry in ipairs(records or {}) do
		if type(entry) == "table"
			and entry.CharacterName ~= excludedName
			and type(entry.AnimalName) == "string"
			and not state.questIsFlyingAnimalName(entry.AnimalName)
			and (not animalName or entry.AnimalName:lower() == animalName:lower())
			and not state.questAnimalIsCarnivoreName(entry.AnimalName) then

			local complete = isGrowthComplete(entry.GrowthPercentage)
			if (requireComplete == nil)
				or (requireComplete and complete)
				or (requireComplete == false and not complete) then

				local growth = tonumber(entry.GrowthPercentage) or 0
				if growth <= 1 then growth *= 100 end

				-- For incomplete growth prefer the most advanced slot so the
				-- first cycle finishes sooner; for mature any herbivore is fine.
				if not best or growth > bestGrowth then
					best = entry
					bestGrowth = growth
				end
			end
		end
	end

	return best
end

function state.questFindGroundedSlot(records, excludedName, preferIncomplete)
	records = records or {}

	-- Prefer an easy herbivore first.
	if preferIncomplete ~= false then
		local herbIncomplete = state.questFindHerbivoreSlot(
			records,
			false,
			excludedName
		)
		if herbIncomplete then return herbIncomplete end
	end

	local herbComplete = state.questFindHerbivoreSlot(
		records,
		true,
		excludedName
	)
	if herbComplete then return herbComplete end

	local fallbackIncomplete
	local fallbackComplete

	for _, entry in ipairs(records) do
		if type(entry) == "table"
			and entry.CharacterName ~= excludedName
			and type(entry.AnimalName) == "string"
			and not state.questIsFlyingAnimalName(entry.AnimalName) then

			if isGrowthComplete(entry.GrowthPercentage) then
				fallbackComplete = fallbackComplete or entry
			else
				fallbackIncomplete = fallbackIncomplete or entry
			end
		end
	end

	if preferIncomplete == false then
		return fallbackComplete or fallbackIncomplete
	end
	return fallbackIncomplete or fallbackComplete
end

function state.questGrowthResetFindTracked(records, tracked)
	if type(tracked) ~= "table" then return nil end
	for _, entry in ipairs(records or {}) do
		if type(entry) == "table" then
			local sameUnique = tracked.uniqueName
				and entry.UniqueCharacterName == tracked.uniqueName
			local sameName = tracked.characterName
				and entry.CharacterName == tracked.characterName
			if sameUnique or sameName then
				return entry
			end
		end
	end
end

function state.questGrowthResetIsZero(value)
	value = tonumber(value)
	if value == nil then return false end

	-- SavedCharacters can expose growth as 0..1 or 0..100.
	-- A real reset is expected very close to zero, never merely "not 100".
	if value <= 1 then
		return value <= 0.02
	end
	return value <= 1
end

function state.questGrowthResetStageDebt(reason)
	local resetState =
		state.questGrowthReset

	local tracked =
		resetState.active

	if not tracked then
		return false
	end

	if resetState.stagingBusy then
		return true
	end

	if tick()
		< (
			resetState.stagingRetryAt
				or 0
		) then
		return true
	end

	local character =
		player.Character

	if not character then
		return true
	end

	local currentName =
		character:GetAttribute(
			"CharacterName"
		)

	if type(tracked.characterName) == "string"
		and tracked.characterName ~= ""
		and currentName ~= tracked.characterName then

		-- Do not accidentally move another slot while replication/switching is
		-- catching up. Keep the Growth debt alive and retry shortly.
		resetState.stagingRetryAt =
			tick() + 2

		return true
	end

	if state.atSlotSwitchPoint
		and state.atSlotSwitchPoint() then

		resetState.debtStageCharacterName =
			tracked.characterName

		resetState.debtStageDone = true
		return false
	end

	resetState.stagingBusy = true

	runtimeMessage =
		reason
			or "Growth debt: moving slot to switch point"

	task.spawn(function()
		local moved =
			state.moveBeforeSlotChange
			and state.moveBeforeSlotChange()

		resetState.stagingBusy = false

		if moved then
			resetState.debtStageCharacterName =
				tracked.characterName

			resetState.debtStageDone = true
			resetState.stagingRetryAt = 0

			runtimeMessage =
				"Growth debt: slot staged at switch point"
		else
			resetState.debtStageDone = false
			resetState.stagingRetryAt =
				tick() + 3

			runtimeMessage =
				"Growth debt: staging failed; retrying"
		end

		state.questForceFastRecheckUntil =
			tick() + 8
	end)

	return true
end

function state.questGrowthResetMaintain(records)
	local tracked = state.questGrowthReset.active
	if not tracked then return false end

	records = records or savedCharacters()
	local entry = state.questGrowthResetFindTracked(records, tracked)
	if not entry then
		-- Replication can briefly disappear during reset/spawn. Keep the debt,
		-- but force fast quest checks so the automation never looks "dead".
		state.questForceFastRecheckUntil = tick() + 10
		return state.questGrowthReset.busy
	end

	if isGrowthComplete(entry.GrowthPercentage) then
		-- v108: final handoff is forbidden while this quest-reset slot is still
		-- scattered somewhere in the world. Bring it back to the SAME slot
		-- switch location used by Grow Slots first.
		if not state.atSlotSwitchPoint
			or not state.atSlotSwitchPoint() then

			state.questGrowthResetStageDebt(
				"Growth debt 100%: returning slot to switch point before handoff"
			)

			return true
		end

		state.questGrowthReset.active = nil
		state.questGrowthReset.busy = false
		state.questGrowthReset.debtStageCharacterName = nil
		state.questGrowthReset.debtStageDone = false
		state.questGrowthReset.stagingRetryAt = 0

		runtimeMessage =
			"Quest growth reset slot returned to 100% at switch point"

		state.questForceFastRecheckUntil =
			tick() + 12

		return false
	end

	-- IMPORTANT: while this slot is below 100%, do not abandon it for another
	-- animal-specific/growth slot. Other compatible quests (Zone/Travel/Group)
	-- are still allowed to run normally on this animal.
	return true
end

function state.questGrowthResetLeaveGame()
	if not ResetRemote then return false end

	local oldCharacter = player.Character
	local ok = pcall(ResetRemote.InvokeServer, ResetRemote)
	if not ok then return false end

	local deadline = tick() + 8
	repeat
		task.wait(0.15)

		local current = player.Character
		local oldGone = not oldCharacter
			or not oldCharacter.Parent
			or not oldCharacter:FindFirstChild("HumanoidRootPart")
		local changed = current ~= oldCharacter

		if oldGone or changed then
			task.wait(0.45)
			return true
		end
	until tick() >= deadline

	-- Some versions keep the old Character object referenced for a little while
	-- even though the player is already back on the character-selection UI.
	-- We still allow the next step, but only after the full reset wait elapsed.
	return true
end


function state.questGrowthResetBeginExclusive()
	if state.questGrowthReset.exclusive then
		return true
	end

	state.questGrowthReset.exclusive = true
	state.questGrowthReset.exclusiveSince = tick()
	state.questGrowthReset.restoreAutoEat = state.autoEat
	state.questGrowthReset.restoreAutoDrink = state.autoDrink

	-- Pause every system that could move, feed, drink or change state.
	state.autoEat = false
	state.autoDrink = false
	state.questCarnivoreFeeding = false
	state.questBaboonFeeding = false
	state.questGiraffeFeeding = false
	BABOON.cancel()
	GIRAFFE.cancel()
	state.questSwimActive = false
	state.questSwimReady = false
	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil

	questTravelWanted = false
	questTargetZoneName = nil

	drinkingToFull = false
	eatingToFull = false
	preSwitchFoodTarget = nil
	preSwitchWaterTarget = nil

	drinkingSourcePosition = nil
	eatingSourcePosition = nil
	eatingTargetReachedAt = nil
	activeCarcass = nil
	drinkingStuckSince = nil
	lastDrinkWatchdogWater = nil
	eatingStuckSince = nil
	lastEatWatchdogFood = nil

	blockClientSubState = true
	state.questSetW(false)

	removeSwimBarrier()
	state.drinkClearUndergroundMode()

	local character = player.Character
	if character and isAquaticCharacter(character) then
		setAquaticWaterCollision(character, false)
	end

	-- Character removal during a deliberate reset must not trigger damage recovery.
	DAMAGE.cooldownUntil = math.max(DAMAGE.cooldownUntil or 0, tick() + 30)

	if renders then
		if renders.autoEat then renders.autoEat() end
		if renders.autoDrink then renders.autoDrink() end
	end

	runtimeMessage = "Growth reset: EXCLUSIVE mode; Eat/Drink/Quest/Run paused"
	return true
end

function state.questGrowthResetEndExclusive(reason)
	if not state.questGrowthReset.exclusive then
		return
	end

	local restoreEat = state.questGrowthReset.restoreAutoEat
	local restoreDrink = state.questGrowthReset.restoreAutoDrink

	state.questGrowthReset.exclusive = false
	state.questGrowthReset.exclusiveSince = 0
	state.questGrowthReset.restoreAutoEat = nil
	state.questGrowthReset.restoreAutoDrink = nil

	if state.autoQuests then
		state.applySurvivalDefaults(false)
	else
		if restoreEat ~= nil then state.autoEat = restoreEat end
		if restoreDrink ~= nil then state.autoDrink = restoreDrink end
	end

	blockClientSubState = false
	state.questForceFastRecheckUntil = tick() + 30
	DAMAGE.cooldownUntil = math.max(DAMAGE.cooldownUntil or 0, tick() + 2)

	if renders then
		if renders.autoEat then renders.autoEat() end
		if renders.autoDrink then renders.autoDrink() end
	end

	runtimeMessage = reason or "Growth reset finished; automation resumed"
end

function state.questGrowthResetWaitForSilence(timeoutSeconds)
	local deadline = tick() + (timeoutSeconds or 4)

	repeat
		local quiet = not state.busy
			and not carcassEatBusy
			and not CROC.approachBusy
			and not forcingPostDrinkMove
			and not DAMAGE.active

		if quiet then
			task.wait(0.35)
			return true
		end

		task.wait(0.10)
	until tick() >= deadline

	return not state.busy
		and not carcassEatBusy
		and not CROC.approachBusy
		and not forcingPostDrinkMove
		and not DAMAGE.active
end

function state.questReleaseStaleRecoveryLock()
	if state.questGrowthReset.exclusive then return false end
	if not criticalRecoveryActive then return true end

	-- Never interfere with a REAL recovery.
	if DAMAGE.active
		or forcingPostDrinkMove
		or drinkingToFull
		or state.drinkSearch.undergroundMode then
		return false
	end

	local character, root, humanoid = characterParts()
	if not character or not root or not humanoid then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	if root.Position.Y < config.dangerY
		or isStandingInWater(root)
		or (not isDinoLife and state.drinkIsBuriedUnderTerrain(root)) then
		return false
	end

	-- If we're alive, on dry ground, above Terrain and no recovery owner is
	-- active, the flag is stale. Release it so Growth/Run cannot stay dead.
	criticalRecoveryActive = false
	state.questForceFastRecheckUntil = tick() + 20
	runtimeMessage = "Recovery lock stale cleared; quests resumed"
	return true
end


-- Independent survival liveness watchdog.
-- It exists specifically to prevent stale drink/eat/recovery flags from
-- disabling survival after a long session or after a character/slot change.
task.spawn(function()
	local lastCharacter =
		player.Character

	local lastDefaultsAt = 0
	local busyOrphanSince
	local buriedOutsideDrinkSince

	while state.alive do
		pcall(function()
			local character, root, humanoid =
				characterParts()

			local test =
				state.drinkTest

			if character ~= lastCharacter then
				lastCharacter = character
				state.survivalArbiterReset("character changed")

				-- State below belongs to the previous slot and must never leak
				-- into a newly spawned one.
				drinkingToFull = false
				eatingToFull = false
				drinkingSourcePosition = nil
				drinkingStuckSince = nil
				lastDrinkWatchdogWater = nil
				activeCarcass = nil
				eatingStuckSince = nil
				blockClientSubState = false

				state.questCarnivoreFeeding = false
				state.questBaboonFeeding = false
				state.questGiraffeFeeding = false
				state.questTravelHerbivoreFeed.active = false

				BABOON.cancel()
				GIRAFFE.cancel()

				if character then
					resetEatingSearch(
						character:GetAttribute("Food")
					)
				end

				if test.active
					and test.character ~= character then
					test.cancelRequested = true
				end
			end

			if not character
				or not root
				or not humanoid
				or humanoid.Health <= 0 then
				return
			end

			local food =
				tonumber(
					character:GetAttribute("Food")
				) or 100

			local water =
				tonumber(
					character:GetAttribute("Water")
				) or 100

			if test.active
				and test.character == character then

				local elapsed =
					tick()
					- (
						test.startedAt or tick()
					)

				-- Full water or approaching the absolute ceiling requests exit
				-- even if the Underground Drink worker itself ever stalls.
				if water >= 100 then
					test.lastResult = "water_full"
					test.cancelRequested = true
				elseif elapsed >= 78 then
					test.cancelRequested = true
				end

				-- Hard independent ceiling. The normal worker should have surfaced
				-- long before this; if not, force the character above Terrain now.
				if elapsed >= 88
					and state.drinkIsBuriedUnderTerrain(
						root
					)
					and not test.hardExitBusy then

					state.drinkTestHardEject(
						"independent 90s anti-drowning watchdog"
					)

					test.cancelRequested = true
				end

				return
			end

			-- Outside the intentional Underground Drink transaction, being buried
			-- under solid Terrain is never a valid state. Rescue it automatically
			-- even when the optional Escape Terrain toggle is off.
			if isSavannahLife
				and state.drinkIsBuriedUnderTerrain(
					root
				) then

				buriedOutsideDrinkSince =
					buriedOutsideDrinkSince or tick()

				if tick() - buriedOutsideDrinkSince >= 1.25
					and not test.hardExitBusy then

					local escaped =
						state.drinkTestHardEject(
							"global buried-Terrain watchdog"
						)

					if escaped then
						state.drinkTestRestoreEnvironment()
						criticalRecoveryActive = false
						buriedOutsideDrinkSince = nil
						state.questForceFastRecheckUntil =
							tick() + 20
					end
				end

				return
			else
				buriedOutsideDrinkSince = nil
			end

			-- A completed drink must never leave Auto Eat blocked behind a stale
			-- drinkingToFull boolean.
			if water >= 100
				and drinkingToFull
				and not forcingPostDrinkMove then

				drinkingToFull = false
				drinkingSourcePosition = nil
				drinkingStuckSince = nil
				lastDrinkWatchdogWater = water
				state.drinkProgressReset()
				blockClientSubState = false
			end

			-- Same protection for an eating transaction that reached full Food
			-- but whose normal completion callback was interrupted.
			if food >= 100
				and eatingToFull then

				eatingToFull = false
				activeCarcass = nil
				eatingStuckSince = nil

				state.questCarnivoreFeeding = false
				state.questBaboonFeeding = false
				state.questGiraffeFeeding = false
				state.questTravelHerbivoreFeed.active = false

				BABOON.cancel()
				GIRAFFE.cancel()
				resetEatingSearch(food)
				blockClientSubState = false
			end

			-- state.busy belongs mainly to SafeMove and the short water-prompt
			-- handshake. If neither still owns anything for several seconds, release
			-- the orphaned flag so Auto Eat cannot remain permanently blocked.
			local busyHasOwner =
				state.safeMove.active
					or carcassEatBusy
					or BABOON.busy
					or GIRAFFE.busy
					or CROC.approachBusy
					or growthBusy
					or forcingPostDrinkMove
					or DAMAGE.active

			if state.busy
				and not busyHasOwner then

				busyOrphanSince =
					busyOrphanSince or tick()

				if tick() - busyOrphanSince >= 4 then
					state.busy = false
					busyOrphanSince = nil
					runtimeMessage =
						"Survival watchdog: stale movement lock released"
				end
			else
				busyOrphanSince = nil
			end

			-- Existing helper already proves dry/above-Terrain/no owner before
			-- clearing criticalRecoveryActive. Run it independently of Auto Quests
			-- so Auto Eat cannot remain dead just because quests are idle.
			if criticalRecoveryActive then
				state.questReleaseStaleRecoveryLock()
			end

			-- Growth/Quest/Coin automation expects survival to stay enabled unless
			-- the player explicitly turned one of the toggles off.
			local automationActive =
				state.autoQuests
				or state.farmCoins
				or state.growExisting
				or state.growAllSlots
				or state.growNew
				or state.growExistingAutomaticAll
				or state.questPostGrowAll
				or state.questGrowthOwnsCurrent

			if automationActive
				and not DAMAGE.active
				and not forcingPostDrinkMove
				and not criticalRecoveryActive
				and not state.questGrowthReset.exclusive
				and tick() - lastDefaultsAt >= 2 then

				lastDefaultsAt = tick()
				state.applySurvivalDefaults(false)
			end
		end)

		task.wait(0.35)
	end
end)


-- ============================================================
-- SURVIVAL DECISION WATCHDOG
-- Food/Water must never sit low while unrelated controllers trade messages.
-- This watchdog measures ACTUAL attribute progress and physical movement. When
-- neither is happening, it cancels stale ownership and restarts the need that
-- is currently more urgent.
-- ============================================================
state.survivalBrain = state.survivalBrain or {
	mode = nil,
	modeSince = 0,
	lastForceAt = 0,
	lastUndergroundRetryOverrideAt = 0,
}

function state.survivalBrainTakeover(kind, reason)
	local brain = state.survivalBrain
	local now = tick()

	if now - (brain.lastForceAt or 0) < 2.5 then
		return false
	end

	local character, root, humanoid = characterParts()
	if not character or not root or not humanoid or humanoid.Health <= 0 then
		return false
	end

	local food = tonumber(character:GetAttribute("Food")) or 100
	local water = tonumber(character:GetAttribute("Water")) or 100

	if kind == "water"
		and (
			not state.autoDrink
			or (water > 75 and state.survivalArbiter.owner ~= "water")
		) then
		return false
	end
	if kind == "food"
		and (
			not state.autoEat
			or (food > 70 and state.survivalArbiter.owner ~= "food")
		) then
		return false
	end

	-- A real underground transaction already has full ownership and its own
	-- hard-exit watchdog. Never interrupt it from the general decision brain.
	if state.drinkTest.active then
		return false
	end

	-- Respect the committed survival job. The only cross-job preemption allowed is
	-- critical Water (<=45), handled by survivalArbiterAcquire.
	if kind == "food" and state.autoDrink and water <= 45 then
		kind = "water"
	end

	if not state.survivalArbiterAcquire(
		kind,
		food,
		water,
		"Survival Brain recovery"
	) then
		return false
	end

	brain.lastForceAt = now
	brain.mode = kind
	brain.modeSince = brain.modeSince > 0 and brain.modeSince or now

	questTravelWanted = false
	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil
	state.autoRunMoveOwnsInput = false
	if state.questSetW then pcall(state.questSetW, false) end

	-- Cancel any path that is not successfully servicing the current need.
	if state.safeMove and state.safeMove.active then
		state.safeMove.cancelToken += 1
		state.safeMove.active = false
		state.safeMove.reason = nil
		state.busy = false
	end

	state.releaseMovementNow(character, true)

	if kind == "water" then
		eatingToFull = false
		eatingSourcePosition = nil
		eatingTargetReachedAt = nil
		eatingStuckSince = nil
		activeCarcass = nil
		state.questCarnivoreFeeding = false
		state.questBaboonFeeding = false
		state.questGiraffeFeeding = false
		BABOON.cancel()
		GIRAFFE.cancel()

		drinkingToFull = true
		drinkingSourcePosition = nil
		drinkingStuckSince = nil
		lastDrinkWatchdogWater = water
		state.drinkProgressReset()

		-- If a previous failed source imposed a long cooldown while thirst keeps
		-- falling, allow the brain to retry instead of standing still for 20s.
		if water <= 60 then
			state.drinkSearch.retryAfter = 0
			if now - (brain.lastUndergroundRetryOverrideAt or 0) >= 12 then
				brain.lastUndergroundRetryOverrideAt = now
				state.drinkTest.retryAfter = 0
				if water <= 45 then
					state.drinkTest.forceSurfaceUntil = 0
				end
			end
		end

		runtimeMessage =
			string.format(
				"SURVIVAL RECOVERY: Water %d%%; taking control (%s)",
				math.floor(water),
				tostring(reason or "no progress")
			)

		mmbTaskDefer(function()
			task.wait(0.12)
			pcall(autoDrinkStep)
		end)
	else
		drinkingToFull = false
		drinkingSourcePosition = nil
		drinkingStuckSince = nil
		state.drinkProgressReset()
		blockClientSubState = false

		eatingToFull = true
		activeCarcass = nil
		eatingStuckSince = nil
		resetEatingSearch(food)

		-- If a special food controller was alive but made no progress, reacquire a
		-- fresh target rather than remaining locked on a bad tree/carcass/AntHill.
		BABOON.cancel()
		GIRAFFE.cancel()
		-- Do not forge carcassEatBusy=false while its coroutine is still unwinding;
		-- cancelling SafeMove is enough and prevents two carcass workers overlapping.

		runtimeMessage =
			string.format(
				"SURVIVAL RECOVERY: Food %d%%; reacquiring food (%s)",
				math.floor(food),
				tostring(reason or "no progress")
			)

		mmbTaskDefer(function()
			task.wait(0.12)
			pcall(autoEatStep)
		end)
	end

	return true
end


task.spawn(function()
	local lastCharacter
	local lastFood
	local lastWater
	local lastPosition
	local foodProgressAt = tick()
	local waterProgressAt = tick()
	local motionAt = tick()

	while state.alive do
		pcall(function()
			local now = tick()
			local character, root, humanoid = characterParts()

			if not character or not root or not humanoid or humanoid.Health <= 0 then
				return
			end

			local food = tonumber(character:GetAttribute("Food")) or 100
			local water = tonumber(character:GetAttribute("Water")) or 100

			-- Manual toggle changes must release ownership immediately; otherwise a
			-- disabled Food job could keep Auto Drink locked (or vice versa).
			if state.survivalArbiter.owner == "food" and not state.autoEat then
				state.survivalArbiterReset("Auto Eat disabled")
			elseif state.survivalArbiter.owner == "water" and not state.autoDrink then
				state.survivalArbiterReset("Auto Drink disabled")
			end

			if character ~= lastCharacter then
				lastCharacter = character
				lastFood = food
				lastWater = water
				lastPosition = root.Position
				foodProgressAt = now
				waterProgressAt = now
				motionAt = now
				state.survivalBrain.mode = nil
				state.survivalBrain.modeSince = 0
				return
			end

			if lastFood == nil or food > lastFood + 0.05 then
				foodProgressAt = now
			end
			if lastWater == nil or water > lastWater + 0.05 then
				waterProgressAt = now
			end
			lastFood = food
			lastWater = water

			if not lastPosition
				or Vector3.new(
					root.Position.X - lastPosition.X,
					0,
					root.Position.Z - lastPosition.Z
				).Magnitude >= 1.5 then
				motionAt = now
				lastPosition = root.Position
			end

			-- A committed job remains a need until its refill target is reached. This
			-- lets the watchdog keep diagnosing a Drink at 80% or Eat at 80% instead
			-- of forgetting it merely because it crossed the start threshold.
			if state.survivalArbiter.owner == "water" and water >= 98 then
				state.survivalArbiterComplete("water")
			elseif state.survivalArbiter.owner == "food"
				and food >= 92
				and not eatingToFull
				and not state.questCarnivoreFeeding
				and not state.questBaboonFeeding
				and not state.questGiraffeFeeding then
				state.survivalArbiterComplete("food")
			end

			local waterNeed = state.autoDrink
				and (water <= 75 or (state.survivalArbiter.owner == "water" and water < 98))
			local foodNeed = state.autoEat
				and (food <= 70 or (state.survivalArbiter.owner == "food" and food < 92))

			if not waterNeed and not foodNeed then
				state.survivalBrain.mode = nil
				state.survivalBrain.modeSince = 0
				if state.survivalArbiter.owner == "water" and water >= 98 then
					state.survivalArbiterComplete("water")
				elseif state.survivalArbiter.owner == "food" and food >= 92 then
					state.survivalArbiterComplete("food")
				end
				return
			end

			local wanted = state.survivalArbiter.owner

			-- Once Food/Water is committed, percentages may fluctuate without changing
			-- jobs. Only critical thirst may preempt Food.
			if wanted == "food" and state.autoDrink and water <= 45 then
				state.survivalArbiterAcquire(
					"water",
					food,
					water,
					"critical thirst while feeding"
				)
				wanted = state.survivalArbiter.owner
			end

			if not wanted then
				wanted = state.survivalArbiterChoose(food, water)
				if wanted then
					state.survivalArbiterAcquire(
						wanted,
						food,
						water,
						"Survival Brain initial choice"
					)
					wanted = state.survivalArbiter.owner or wanted
				end
			end

			if not wanted then
				return
			end

			if state.survivalBrain.mode ~= wanted then
				state.survivalBrain.mode = wanted
				state.survivalBrain.modeSince = now
			end

			if state.drinkTest.active
				or forcingPostDrinkMove
				or DAMAGE.active
				or state.questGrowthReset.exclusive then
				return
			end

			local progressAt = wanted == "water" and waterProgressAt or foodProgressAt
			local sameNeedOwner =
				wanted == "water"
					and (drinkingToFull or (state.safeMove.active and state.safeMove.reason == "water") or CROC.approachBusy)
				or wanted == "food"
					and (eatingToFull or carcassEatBusy or BABOON.busy or GIRAFFE.busy or (state.safeMove.active and state.safeMove.reason == "food"))

			local noAttributeProgress = now - progressAt
			local noMotion = now - motionAt
			local modeAge = now - (state.survivalBrain.modeSince or now)

			-- No owner at all: react quickly. An owner that is at least moving gets a
			-- longer chance; an owner standing still with no attribute gain is stale.
			if (not sameNeedOwner and modeAge >= 2.0)
				or (noAttributeProgress >= 7 and noMotion >= 3.0)
				or (noAttributeProgress >= 22 and noMotion >= 1.5) then

				state.survivalBrainTakeover(
					wanted,
					string.format(
						"progress %.1fs / motion %.1fs",
						noAttributeProgress,
						noMotion
					)
				)
			end
		end)

		task.wait(0.40)
	end
end)


function state.questGrowthResetCurrent(entry)
	if tick() < (state.questGrowthReset.failedUntil or 0) then
		return false
	end

	if criticalRecoveryActive then
		state.questReleaseStaleRecoveryLock()
	end

	if state.questGrowthReset.busy
		or state.questGrowthReset.active
		or state.busy
		or questSwitchingAnimal
		or criticalRecoveryActive then

		if criticalRecoveryActive then
			questStatusText = "Growth waiting: active safety recovery"
		end
		return true
	end

	if type(entry) ~= "table" then return false end

	local uniqueName = entry.UniqueCharacterName or entry.CharacterName
	local characterName = entry.CharacterName
	if type(characterName) ~= "string" or characterName == "" then
		return false
	end

	local clearRemote = ReplicatedStorage:FindFirstChild("ClearCharacterGrowthRemoteFunction")
		or ReplicatedStorage:WaitForChild("ClearCharacterGrowthRemoteFunction", 5)

	if not clearRemote then
		questStatusText = "Growth: ClearCharacterGrowthRemoteFunction not found"
		state.questGrowthReset.failedUntil = tick() + 30
		return false
	end

	state.questGrowthResetBeginExclusive()

	state.questGrowthReset.busy = true
	state.questGrowthReset.pendingResetName = nil
	state.questGrowthReset.lastAttemptAt = tick()
	state.questGrowthReset.stagingBusy = false
	state.questGrowthReset.stagingRetryAt = 0
	state.questGrowthReset.debtStageCharacterName = nil
	state.questGrowthReset.debtStageDone = false
	questSwitchingAnimal = true
	questTravelWanted = false
	state.questTravelActive = false
	state.questLandInputActive = false
	state.questSetW(false)
	state.questMotionMoving = false
	state.questMotionMode = nil

	task.spawn(function()
		local tracked = {
			uniqueName = uniqueName,
			characterName = characterName,
			animalName = entry.AnimalName,
		}

		questStatusText = "Growth: reset BEFORE spawn -> " .. tostring(entry.AnimalName or characterName)
		runtimeMessage = "Growth: waiting for Eat/Drink/Quest controllers to release"

		if not state.questGrowthResetWaitForSilence(4) then
			state.questGrowthReset.failedUntil = tick() + 5
			state.questGrowthReset.busy = false
			questSwitchingAnimal = false
			questStatusText = "Growth: competing controller did not release"
			state.questGrowthResetEndExclusive(
				"Growth reset postponed; another controller was still active"
			)
			return
		end

		runtimeMessage =
			"Growth: exclusive reset ready; staging slot before reset"

		-- v108: use the exact same safe slot-switch location as Grow Slots
		-- BEFORE clearing this mature quest slot. This prevents saved slots
		-- from being left scattered at the last quest position.
		if not state.moveBeforeSlotChange
			or not state.moveBeforeSlotChange() then

			state.questGrowthReset.failedUntil =
				tick() + 6

			state.questGrowthReset.busy = false
			questSwitchingAnimal = false

			questStatusText =
				"Growth: could not stage slot before reset"

			state.questGrowthResetEndExclusive(
				"Growth reset postponed; slot-switch point was not confirmed"
			)

			return
		end

		task.wait(0.25)

		runtimeMessage =
			"Growth: slot staged; leaving current animal"

		-- Correct order:
		-- 0) stage at the shared slot-switch point;
		-- 1) leave/restart the currently spawned animal;
		-- 2) clear the SAVED slot growth;
		-- 3) prove SavedCharacters says ~0%;
		-- 4) start the game again with SpawnAsCharacterRemoteFunction.
		if not state.questGrowthResetLeaveGame() then
			state.questGrowthReset.failedUntil = tick() + 20
			state.questGrowthReset.busy = false
			questSwitchingAnimal = false
			questStatusText = "Growth: character reset failed"
			state.questGrowthResetEndExclusive(
				"Growth reset failed before edit context; automation resumed"
			)
			return
		end

		runtimeMessage = "Growth: character reset complete; opening edit context"

		local statsRemote = ReplicatedStorage:FindFirstChild("GuiOpenStatsCounterRemoteEvent")
		if statsRemote then
			pcall(statsRemote.FireServer, statsRemote, "EditCharacter")
			task.wait(0.75)
		end

		runtimeMessage = "Growth: edit context ready; clearing saved growth"

		-- Cobalt capture shows ClearCharacterGrowth receiving an ARRAY:
		-- InvokeServer({ "StarterCharacter1" })
		-- v24 incorrectly sent only the raw string, so the server ignored it.
		pcall(clearRemote.InvokeServer, clearRemote, { characterName })

		local resetEntry
		local lastKnownEntry
		local deadline = tick() + 9
		repeat
			task.wait(0.3)
			local refreshed = savedCharacters()
			local candidate = state.questGrowthResetFindTracked(refreshed, tracked)
			if candidate then
				lastKnownEntry = candidate
				if state.questGrowthResetIsZero(candidate.GrowthPercentage) then
					resetEntry = candidate
				end
			end
		until resetEntry or tick() >= deadline

		-- Compatibility fallbacks, but always verify SavedCharacters after each.
		if not resetEntry then
			pcall(clearRemote.InvokeServer, clearRemote, characterName)

			local stringDeadline = tick() + 3
			repeat
				task.wait(0.3)
				local refreshed = savedCharacters()
				local candidate = state.questGrowthResetFindTracked(refreshed, tracked)
				if candidate then
					lastKnownEntry = candidate
					if state.questGrowthResetIsZero(candidate.GrowthPercentage) then
						resetEntry = candidate
					end
				end
			until resetEntry or tick() >= stringDeadline
		end

		if not resetEntry
			and type(uniqueName) == "string"
			and uniqueName ~= ""
			and uniqueName ~= characterName then

			pcall(clearRemote.InvokeServer, clearRemote, { uniqueName })

			local uniqueDeadline = tick() + 4
			repeat
				task.wait(0.3)
				local refreshed = savedCharacters()
				local candidate = state.questGrowthResetFindTracked(refreshed, tracked)
				if candidate then
					lastKnownEntry = candidate
					if state.questGrowthResetIsZero(candidate.GrowthPercentage) then
						resetEntry = candidate
					end
				end
			until resetEntry or tick() >= uniqueDeadline
		end

		if not resetEntry then
			-- Never leave the player trapped on the main menu. If clearing did
			-- not verify, start the same saved slot again at whatever growth the
			-- server currently reports, then retry the reset later.
			state.questGrowthReset.failedUntil = tick() + 12
			state.questGrowthReset.busy = false
			questSwitchingAnimal = false
			questStatusText = "Growth reset not confirmed; recovering from menu"
			runtimeMessage = "Growth clear failed; respawning saved slot before retry"

			lastKnownEntry = lastKnownEntry
				or state.questGrowthResetFindTracked(savedCharacters(), tracked)

			if lastKnownEntry then
				local recoverySpawned = spawnSlot(lastKnownEntry, true)
				if recoverySpawned then
					state.questForceFastRecheckUntil = tick() + 20
					questStatusText = "Recovered from menu; Growth reset will retry"
				end
			end

			state.questGrowthResetEndExclusive(
				"Growth reset not confirmed; slot recovered and automation resumed"
			)
			return
		end

		state.questGrowthReset.active = tracked
		questStatusText = "Growth: 0% confirmed -> starting animal again"
		runtimeMessage = "Growth 0% confirmed; spawning same saved slot"

		local spawned = spawnSlot(resetEntry, true)
		if spawned then
			state.questForceFastRecheckUntil = tick() + 45
			questStatusText = "Growth cycle active; resuming Run/Zone/Group"
			runtimeMessage = "Growth reset slot respawned; quest scanner forced awake"
		else
			questStatusText = "Growth: 0% confirmed; respawn failed, retry pending"
			runtimeMessage = "Growth slot is 0% but SpawnAsCharacter failed"
		end

		state.questGrowthReset.busy = false
		questSwitchingAnimal = false

		state.questGrowthResetEndExclusive(
			spawned
				and "Growth reset complete; slot active and automation resumed"
				or "Growth reset reached 0%; spawn retry pending"
		)
	end)

	return true
end

local function trySwitchToQuestAnimal(quest, records, resolvedTarget)
	if state.questGrowthResetMaintain(records) then return false end
	if tick() - questLastAnimalSwitch < 20 or questSwitchingAnimal or state.busy or criticalRecoveryActive then return false end
	local targetAnimal = resolvedTarget or findSpecificAnimalTarget(quest, records)
	if not targetAnimal then return false end

	-- Absolute priority: no Yellow Hornbill / Flamingo / Vulture until every
	-- running/land TravelDistance quest is complete.
	if state.questIsFlyingAnimalName(targetAnimal)
		and (state.questBlockFlying or (state.questPendingLandCount or 0) > 0) then
		questStatusText = string.format(
			"Running quests first (%d pending); %s deferred",
			state.questPendingLandCount or 0,
			tostring(targetAnimal)
		)
		runtimeMessage = "Flying animal switch denied until Auto Run quests finish"
		return false
	end

	local character = player.Character
	local currentAnimal = character and character:GetAttribute("AnimalName")
	if type(currentAnimal) == "string"
		and state.questAnimalKey(currentAnimal) == state.questAnimalKey(targetAnimal) then
		return false
	end

	local targetSlot = state.questSlots.findAnimalSlot(records, targetAnimal)
	if not targetSlot then
		questStatusText = "Specific animal needed: " .. targetAnimal
		return false
	end

	questLastAnimalSwitch = tick()
	questSwitchingAnimal = true
	questTravelWanted = false
	state.questTravelActive = false
	runtimeMessage = "Quest: switching to " .. targetAnimal
	task.spawn(function()
		if not state.prepareCurrentSlotForSwitch(
			"Quest: staging current animal before switching to " .. tostring(targetAnimal)
		) then
			questSwitchingAnimal = false
			runtimeMessage = "Quest switch postponed: staging failed"
			return
		end

		if ResetRemote then
			pcall(ResetRemote.InvokeServer, ResetRemote)
			task.wait(1.5)
		end
		local spawned =
			spawnSlot(
				targetSlot,
				true,
				true
			)

		questSwitchingAnimal = false

		state.questSlotsNormalizeControl(
			player.Character
		)

		if spawned then
			state.applySurvivalDefaults(false)
			state.questForceFastRecheckUntil =
				tick() + 25

			questStatusText =
				"Quest animal ready; rescanning missions"

			runtimeMessage =
				"Quest animal ready; resuming quest automation"
		end
	end)
	return true
end

function state.questIsGrowthQuest(quest)
	if type(quest) ~= "table" or type(quest.props) ~= "table" then
		return false
	end

	if quest.props.QuestType == "GrowTime" then
		return true
	end

	-- Defensive fallback in case a game update changes the internal QuestType
	-- while keeping the same visible quest wording.
	local title = tostring(quest.props.Title or ""):lower()
	return title:find("grow", 1, true) ~= nil
		or title:find("growth", 1, true) ~= nil
end

function state.questGrowthQuestIncomplete(quest)
	if not state.questIsGrowthQuest(quest) then
		return false
	end

	-- Prefer the actual progress reader when available.
	if type(state.questProgressValues) == "function" then
		local current, maximum = state.questProgressValues(quest)
		if type(current) == "number"
			and type(maximum) == "number"
			and maximum > 0 then
			return current < maximum * 0.999
		end
	end

	-- If progress cannot be read, only call it complete when the normal quest
	-- checker can prove completion. Unknown Growth quests are treated as active
	-- rather than silently discarded.
	return not state.questGroup.questComplete(quest)
end

function state.questHasIncompleteGrowth(quests)
	for _, quest in ipairs(quests or {}) do
		if state.questGrowthQuestIncomplete(quest) then
			return true
		end
	end
	return false
end

function state.questGrowthIsProtectedAnimal(animalName)
	local key = state.questAnimalKey(animalName)

	if key == "elephant"
		or key == "crocodile"
		or key == "croc"
		or key == "hippo"
		or key == "hippopotamus"
		or key == "rhino"
		or key == "rhinoceros" then
		return true
	end

	-- Covers variants such as WhiteRhino / BlackRhino without making unrelated
	-- animals protected.
	return key:find("rhino", 1, true) ~= nil
end

function state.questGrowthSlotAllowed(entry)
	if type(entry) ~= "table" or type(entry.AnimalName) ~= "string" then
		return false
	end

	-- Latest rule: flyers may participate in Growth, but only after every
	-- terrestrial running quest is finished.
	if state.questIsFlyingAnimalName(entry.AnimalName)
		and (state.questBlockFlying or (state.questPendingLandCount or 0) > 0) then
		return false
	end

	return true
end

function state.questGrowthFindIncompleteSlot(records, currentName, focusAnimal)
	records = records or {}

	local function usable(entry)
		return type(entry) == "table"
			and not isGrowthComplete(entry.GrowthPercentage)
			and state.questGrowthSlotAllowed(entry)
	end

	-- 1) Never abandon the current slot if it is already growing and is allowed
	--    by the terrestrial/flying rule.
	for _, entry in ipairs(records) do
		if usable(entry)
			and type(currentName) == "string"
			and entry.CharacterName == currentName then
			return entry, "current"
		end
	end

	-- 2) Among pre-existing growing slots, prefer the species that also satisfies
	--    the currently required specific-animal quest.
	if type(focusAnimal) == "string" then
		local wanted = state.questAnimalKey(focusAnimal)
		for _, entry in ipairs(records) do
			if usable(entry)
				and state.questAnimalKey(entry.AnimalName) == wanted then
				return entry, "specific"
			end
		end
	end

	-- 3) Prefer grounded growing slots before flyers. Flyers only reach the
	--    second pass after all terrestrial Run quests are complete.
	for _, entry in ipairs(records) do
		if usable(entry)
			and not state.questIsFlyingAnimalName(entry.AnimalName) then
			return entry, "grounded"
		end
	end

	for _, entry in ipairs(records) do
		if usable(entry) then
			return entry, "flying"
		end
	end

	return nil, nil
end

function state.questGrowthRemainingTime(quests)
	local longestRemaining
	local foundGrowth = false

	for _, quest in ipairs(quests or {}) do
		if state.questGrowthQuestIncomplete(quest) then
			foundGrowth = true
			local current, maximum = state.questProgressValues(quest)

			if type(current) == "number"
				and type(maximum) == "number"
				and maximum > 0 then

				local remaining = math.max(maximum - current, 0)
				longestRemaining = math.max(longestRemaining or 0, remaining)
			end
		end
	end

	return longestRemaining, foundGrowth
end

function state.questSpecificPlayRemainingTime(quests, records, animalName)
	if type(animalName) ~= "string" then
		return nil, false
	end

	local wanted = state.questAnimalKey(animalName)
	local longestRemaining
	local foundSpecific = false

	for _, quest in ipairs(quests or {}) do
		local props = quest.props
		local data = props and props.QuestData

		if props
			and props.QuestType == "PlayTime"
			and data
			and data.ShouldBeSpawnedAsAnimal == true
			and data.ShouldBeSpawnedAsSpecificAnimalName
			and not state.questGroup.questComplete(quest) then

			local target = findSpecificAnimalTarget(quest, records)
			if type(target) == "string"
				and state.questAnimalKey(target) == wanted then

				foundSpecific = true
				local current, maximum = state.questProgressValues(quest)

				if type(current) == "number"
					and type(maximum) == "number"
					and maximum > 0 then

					local remaining = math.max(maximum - current, 0)
					longestRemaining = math.max(
						longestRemaining or 0,
						remaining
					)
				end
			end
		end
	end

	return longestRemaining, foundSpecific
end

function state.questGrowthChooseResetSlot(
	quests,
	records,
	currentEntry,
	focusAnimal
)
	records = records or {}

	local normal = {}
	local protected = {}

	for _, entry in ipairs(records) do
		if type(entry) == "table"
			and isGrowthComplete(entry.GrowthPercentage)
			and state.questGrowthSlotAllowed(entry) then

			if state.questGrowthIsProtectedAnimal(entry.AnimalName) then
				protected[#protected + 1] = entry
			else
				normal[#normal + 1] = entry
			end
		end
	end

	local function sameAnimal(entry, animalName)
		return entry
			and type(animalName) == "string"
			and state.questAnimalKey(entry.AnimalName)
				== state.questAnimalKey(animalName)
	end

	local function preferFrom(list)
		if type(focusAnimal) == "string" then
			for _, entry in ipairs(list) do
				if sameAnimal(entry, focusAnimal) then
					return entry
				end
			end
		end

		if currentEntry then
			for _, entry in ipairs(list) do
				if entry.CharacterName == currentEntry.CharacterName then
					return entry
				end
			end
		end

		-- Even after Run quests finish, keep a grounded mature animal ahead of a
		-- flyer when both are equally valid reset choices.
		for _, entry in ipairs(list) do
			if not state.questIsFlyingAnimalName(entry.AnimalName) then
				return entry
			end
		end

		return list[1]
	end

	local normalChoice = preferFrom(normal)
	local growthRemaining = state.questGrowthRemainingTime(quests)

	-- Protected exception #1:
	-- If that exact expensive species MUST still be played, only prefer
	-- resetting it over a normal alternative when the mandatory PlayTime
	-- remaining is at least the remaining GrowTime. Then the expensive growth
	-- happens "for free" underneath time we already had to spend as that animal.
	local bestCoveredProtected
	local bestCoveredPlay = -1

	if type(growthRemaining) == "number" and growthRemaining > 0 then
		for _, entry in ipairs(protected) do
			local playRemaining, hasSpecific =
				state.questSpecificPlayRemainingTime(
					quests,
					records,
					entry.AnimalName
				)

			if hasSpecific
				and type(playRemaining) == "number"
				and playRemaining >= growthRemaining
				and playRemaining > bestCoveredPlay then

				bestCoveredProtected = entry
				bestCoveredPlay = playRemaining
			end
		end
	end

	if bestCoveredProtected then
		return bestCoveredProtected, "protected_play_covers_growth",
			growthRemaining, bestCoveredPlay
	end

	-- Normal mature animals always win if there is a viable one.
	if normalChoice then
		return normalChoice, "normal_reset", growthRemaining, nil
	end

	-- Protected exception #2:
	-- No mature non-protected animal exists. We are now genuinely out of safer
	-- reset choices, so a protected animal is allowed as LAST RESORT.
	if #protected > 0 then
		local bestProtected
		local bestPlay = -1

		-- If one of the protected species also has mandatory PlayTime remaining,
		-- choose the one that gives the most overlap.
		for _, entry in ipairs(protected) do
			local playRemaining, hasSpecific =
				state.questSpecificPlayRemainingTime(
					quests,
					records,
					entry.AnimalName
				)

			if hasSpecific then
				local score = type(playRemaining) == "number"
					and playRemaining
					or 0

				if score > bestPlay then
					bestPlay = score
					bestProtected = entry
				end
			end
		end

		if not bestProtected then
			bestProtected = preferFrom(protected)
		end

		return bestProtected, "protected_last_resort",
			growthRemaining,
			bestPlay >= 0 and bestPlay or nil
	end

	return nil, "no_reset_candidate", growthRemaining, nil
end


function state.questFindGroundedGrowthSlot(records, excludedName)
	records = records or {}

	-- Best possible combination for Land/Travel + Growth:
	-- 1) incomplete grounded herbivore;
	-- 2) ANY incomplete grounded animal;
	-- 3) mature grounded herbivore (will be reset);
	-- 4) any mature grounded animal (will be reset).
	local herbIncomplete = state.questFindHerbivoreSlot(
		records,
		false,
		excludedName
	)
	if herbIncomplete then return herbIncomplete end

	local anyIncomplete
	for _, entry in ipairs(records) do
		if type(entry) == "table"
			and entry.CharacterName ~= excludedName
			and type(entry.AnimalName) == "string"
			and not state.questIsFlyingAnimalName(entry.AnimalName)
			and not isGrowthComplete(entry.GrowthPercentage) then

			anyIncomplete = entry
			break
		end
	end
	if anyIncomplete then return anyIncomplete end

	local herbComplete = state.questFindHerbivoreSlot(
		records,
		true,
		excludedName
	)
	if herbComplete then return herbComplete end

	for _, entry in ipairs(records) do
		if type(entry) == "table"
			and entry.CharacterName ~= excludedName
			and type(entry.AnimalName) == "string"
			and not state.questIsFlyingAnimalName(entry.AnimalName)
			and isGrowthComplete(entry.GrowthPercentage) then

			return entry
		end
	end

	return nil
end

local function trySwitchToGrowingSlot(
	quests,
	records,
	specificAnimalFocus,
	focusAnimal
)
	state.questGrowthOwnsCurrent = false

	if not state.questHasIncompleteGrowth(quests) then
		state.questGrowthResetMaintain(records)
		return false
	end

	-- Growth + Zone must start on the Growth slot FIRST. Zone movement resumes
	-- immediately after the slot is active, so both timers can progress together.
	-- Keep Zone priority unresolved during the switch so the Pride Rock leash can
	-- never steal the freshly spawned herbivore before the next quest scan.
	local zoneQuestPending = false
	for _, quest in ipairs(quests or {}) do
		if quest.props
			and quest.props.QuestType == "ZoneTime"
			and not state.questGroup.questComplete(quest) then
			zoneQuestPending = true
			break
		end
	end

	if zoneQuestPending and state.questZonePriority then
		state.questZonePriority.active = false
		state.questZonePriority.zone = nil
		state.questZonePriority.resolved = false
	end

	if questSwitchingAnimal or criticalRecoveryActive then
		return false
	end

	-- A Zone route may already own SafeMove from the previous scan. That must not
	-- postpone a Growth slot switch until the animal reaches the zone. Cancel only
	-- quest/Pride movement here; Food, Water, damage recovery and other survival
	-- owners remain non-preemptible. The cancelled SafeMove unwinds this frame and
	-- the forced fast scan performs the slot switch immediately afterwards.
	if state.busy then
		local moveReason = state.safeMove
			and state.safeMove.active
			and state.safeMove.reason

		local survivalBusy =
			drinkingToFull
			or eatingToFull
			or carcassEatBusy
			or BABOON.busy
			or GIRAFFE.busy
			or CROC.approachBusy
			or forcingPostDrinkMove
			or DAMAGE.active
			or (state.drinkTest and state.drinkTest.active)

		if not survivalBusy
			and (moveReason == "quest" or moveReason == "growth_home") then

			state.safeMove.cancelToken += 1
			state.growthPride.returning = false
			state.growthPride.returnRequested = false
			state.questZoneLastMoveAt = 0
			state.questZoneLastTarget = nil
			state.questForceFastRecheckUntil = tick() + 12

			if state.questSetW then
				pcall(state.questSetW, false)
			end

			state.releaseMovementNow(player.Character, true)

			questStatusText = zoneQuestPending
				and "Growth + Zone: switching Growth slot before Zone movement"
				or "Growth priority: stopping quest movement before slot switch"

			runtimeMessage =
				"Growth priority preempted the current quest route; slot switch queued"

			return true
		end

		return false
	end

	records = records or savedCharacters()

	-- A slot deliberately reset by us becomes an existing <100% slot. Keep it
	-- until 100%; never abandon that debt for another mature reset.
	if state.questGrowthResetMaintain(records) then
		state.questGrowthOwnsCurrent = true
		questStatusText = "Growth: finishing previously reset slot before any new reset"
		return false
	end

	local character = player.Character
	if not character then return false end

	local currentName = character:GetAttribute("CharacterName")
	local currentAnimal = character:GetAttribute("AnimalName")
	local currentEntry = state.questFindCurrentSavedEntry(records, character)

	if not currentEntry and state.questExpectedSlot then
		local requestedAt = state.questExpectedSlot.requestedAt or 0
		if requestedAt > 0 and tick() - requestedAt <= 8 then
			questStatusText = "Growth: waiting for current slot replication"
			return false
		end
		state.questExpectedSlot = nil
	end

	-- ========================================================
	-- RULE #1: EXISTING <100% SLOTS FIRST. NO RESET BEFORE THIS.
	-- ========================================================
	local incompleteSlot, incompleteReason =
		state.questGrowthFindIncompleteSlot(
			records,
			currentName,
			focusAnimal
		)

	if incompleteSlot then
		local sameCurrent = type(currentName) == "string"
			and incompleteSlot.CharacterName == currentName

		if sameCurrent then
			state.questGrowthOwnsCurrent = true
			questStatusText = state.questIsFlyingAnimalName(
				incompleteSlot.AnimalName
			)
				and "Growth: existing flying slot <100% (Run quests already complete)"
				or "Growth: existing slot <100% has absolute priority"

			runtimeMessage = "Growth reset denied: continuing an existing slot below 100%"
			return false
		end

		if tick() - questLastAnimalSwitch < 2.5 then
			questStatusText = "Growth: existing <100% slot queued before any reset"
			return false
		end

		questLastAnimalSwitch = tick()
		questSwitchingAnimal = true
		questTravelWanted = false
		state.questTravelActive = false
		state.questLandInputActive = false
		state.questSetW(false)
		state.questMotionMoving = false
		state.questMotionMode = nil

		questStatusText = zoneQuestPending
			and ("Growth + Zone first: <100% -> " .. tostring(incompleteSlot.AnimalName))
			or ("Growth priority: existing <100% -> " .. tostring(incompleteSlot.AnimalName))

		runtimeMessage = zoneQuestPending
			and "Switching to the Growth slot first; ZoneTime will run on the same slot"
			or string.format(
				"Using existing growing slot (%s); mature reset blocked",
				tostring(incompleteReason or "available")
			)

		if zoneQuestPending then
			state.questZoneLastMoveAt = 0
			state.questZoneLastTarget = nil
		end

		task.spawn(function()
			if not state.prepareCurrentSlotForSwitch(
				"Growth: staging current animal before existing-slot switch"
			) then
				questSwitchingAnimal = false
				runtimeMessage = "Growth switch postponed: staging failed"
				return
			end

			if ResetRemote then
				pcall(ResetRemote.InvokeServer, ResetRemote)
				task.wait(1.15)
			end

			local spawned = spawnSlot(incompleteSlot, true)
			questSwitchingAnimal = false

			if spawned then
				state.questGrowthOwnsCurrent = true
				state.questForceFastRecheckUntil = tick() + 25

				if zoneQuestPending then
					state.questZoneLastMoveAt = 0
					state.questZoneLastTarget = nil
					state.questZonePriority.active = false
					state.questZonePriority.zone = nil
					state.questZonePriority.resolved = false
					runtimeMessage =
						"Growth slot active; moving to Zone on next immediate quest scan"
				else
					runtimeMessage =
						"Existing <100% Growth slot active; compatible quests resumed"
				end
			end
		end)

		return true
	end

	-- If an existing <100% slot exists but it is a flyer currently blocked by a
	-- terrestrial Run quest, WAIT for Run. Never reset some other mature grounded
	-- slot just because the real Growth debt is temporarily deferred.
	local deferredFlyingGrowth
	if state.questBlockFlying or (state.questPendingLandCount or 0) > 0 then
		for _, entry in ipairs(records) do
			if type(entry) == "table"
				and type(entry.AnimalName) == "string"
				and state.questIsFlyingAnimalName(entry.AnimalName)
				and not isGrowthComplete(entry.GrowthPercentage) then

				deferredFlyingGrowth = entry
				break
			end
		end
	end

	if deferredFlyingGrowth then
		questStatusText = string.format(
			"Run first: Growth slot %s is flying (%d Run pending)",
			tostring(deferredFlyingGrowth.AnimalName),
			state.questPendingLandCount or 0
		)
		runtimeMessage =
			"Existing flying Growth slot deferred; no mature grounded slot will be reset"
		return false
	end

	-- There is now NO eligible existing slot below 100%.
	-- Only at this point is a reset legal.
	if tick() - questLastAnimalSwitch < 2.5 then
		return false
	end

	local resetSlot, resetReason, growthRemaining, playRemaining =
		state.questGrowthChooseResetSlot(
			quests,
			records,
			currentEntry,
			specificAnimalFocus and focusAnimal or nil
		)

	if not resetSlot then
		questStatusText = state.questBlockFlying
			and "Growth pending: no grounded <100% or safe reset slot; flyers wait for Run"
			or "Growth pending: no saved slot available for growth/reset"
		return false
	end

	state.questGrowthReset.pendingResetName = nil

	if zoneQuestPending then
		state.questZoneLastMoveAt = 0
		state.questZoneLastTarget = nil
		state.questZonePriority.active = false
		state.questZonePriority.zone = nil
		state.questZonePriority.resolved = false
	end

	if resetReason == "protected_play_covers_growth" then
		questStatusText = string.format(
			"Growth protected exception: %s PlayTime covers GrowTime",
			tostring(resetSlot.AnimalName)
		)

		runtimeMessage = string.format(
			"Protected reset approved: %s play %.0f >= growth %.0f",
			tostring(resetSlot.AnimalName),
			tonumber(playRemaining) or 0,
			tonumber(growthRemaining) or 0
		)

	elseif resetReason == "protected_last_resort" then
		questStatusText = "Growth last resort: no normal mature reset candidate -> "
			.. tostring(resetSlot.AnimalName)

		if type(playRemaining) == "number" and playRemaining > 0 then
			runtimeMessage = string.format(
				"Protected last-resort reset: %s; required PlayTime overlap %.0f",
				tostring(resetSlot.AnimalName),
				playRemaining
			)
		else
			runtimeMessage = "Protected last-resort reset: no non-protected mature slot exists"
		end

	else
		questStatusText = "Growth: no existing <100%; safe reset -> "
			.. tostring(resetSlot.AnimalName)

		runtimeMessage = "Growth reset allowed only after every eligible existing <100% slot was exhausted"
	end

	return state.questGrowthResetCurrent(resetSlot)
end

local function claimQuestRewards(quests)
	if not ClaimQuestRemote then return end
	for _, quest in ipairs(quests) do
		local ok, claimed = pcall(
			ClaimQuestRemote.InvokeServer,
			ClaimQuestRemote,
			quest.category,
			quest.entry.QuestUniqueKey
		)
		if ok and claimed then
			questSessionClaimed[quest.id] = true
			questStatusText = "Claimed: " .. tostring(quest.props.Title or quest.entry.QuestUniqueKey)
			runtimeMessage = "Quest reward claimed"
			task.wait(0.2)
		end
	end
end

function state.questZoneDrinkRender()
	if state.renderAutoDrinkModeButtons then
		pcall(state.renderAutoDrinkModeButtons)
	end
end

function state.questZoneDrinkApply(zoneName)
	local override = state.questZoneDrinkOverride
	if not override or type(zoneName) ~= "string" or zoneName == "" then
		return
	end

	if not override.active then
		if state.autoDrinkMode == "surface"
			or state.autoDrinkMode == "underground" then
			state.autoDrinkPreferredMode = state.autoDrinkMode
		end
	end

	override.active = true
	override.zone = zoneName
	override.startedAt =
		override.startedAt > 0 and override.startedAt
		or tick()

	if CROC.isCharacter(player.Character) then
		state.autoDrinkMode = "surface"
		runtimeMessage = "Survive in Zone: Crocodile cannot use Underground Drink"
		state.questZoneDrinkRender()
		return
	end

	if state.autoDrinkMode ~= "underground" then
		state.autoDrinkMode = "underground"
		state.drinkTest.retryAfter = 0

		if state.safeMove
			and state.safeMove.active
			and state.safeMove.reason == "water" then
			state.safeMove.cancelToken += 1
		end

		state.drinkSearch.currentWaterPoint = nil
		state.drinkSearch.failedCount = 0
		state.drinkSearch.retryAfter = 0
		state.drinkProgressReset()

		runtimeMessage =
			"Survive in Zone: Underground Drink temporarily forced"
	end

	state.questZoneDrinkRender()
end

function state.questZoneDrinkRelease(reason)
	local override = state.questZoneDrinkOverride
	if not override or not override.active then
		return
	end

	override.active = false
	override.zone = nil
	override.startedAt = 0

	local preferred = state.autoDrinkPreferredMode
	if preferred ~= "surface"
		and preferred ~= "underground" then
		preferred = "surface"
		state.autoDrinkPreferredMode = preferred
	end

	if CROC.isCharacter(player.Character) then
		state.autoDrinkMode = "surface"
	else
		state.autoDrinkMode = preferred
	end

	if state.autoDrinkMode == "surface"
		and state.drinkTest
		and state.drinkTest.active then
		state.drinkTest.cancelRequested = true
		runtimeMessage =
			"Survive in Zone ended; restoring Surface Water after safe vertical exit"
	elseif reason == "zone_complete"
		or reason == "zone_inactive" then
		runtimeMessage =
			"Survive in Zone ended; restored Auto Drink preference"
	end

	state.questZoneDrinkRender()
end

function state.questZoneDrinkUpdate(targetZone, insideTarget)
	local override = state.questZoneDrinkOverride

	if type(targetZone) ~= "string" or targetZone == "" then
		state.questZoneDrinkRelease("zone_inactive")
		return
	end

	if insideTarget then
		state.questZoneDrinkApply(targetZone)
		return
	end

	-- Keep override only if survival temporarily pulled us out of the SAME zone.
	local savedReturnZone =
		state.questReturnZone
			and state.questReturnZone.name

	local returningToSameZone =
		override
			and override.active
			and override.zone == targetZone
			and type(savedReturnZone) == "string"
			and savedReturnZone:lower() == targetZone:lower()

	if returningToSameZone then
		return
	end

	if override and override.active then
		state.questZoneDrinkRelease("zone_inactive")
	end
end

function state.questReturnZoneStillNeeded(quests, zoneName)
	if type(zoneName) ~= "string" or zoneName == "" then return false end

	for _, quest in ipairs(quests or {}) do
		if quest.props
			and quest.props.QuestType == "ZoneTime"
			and not state.questGroup.questComplete(quest) then

			local targetZone = findZoneInQuest(quest)
			if type(targetZone) == "string"
				and targetZone:lower() == zoneName:lower() then
				return true
			end
		end
	end

	return false
end

function state.questReturnToZoneAfterFeeding(quests)
	local returnZone = state.questReturnZone.name
	if type(returnZone) ~= "string" or returnZone == "" then
		return false
	end

	-- Only return if that exact zone still has an incomplete ZoneTime quest.
	if not state.questReturnZoneStillNeeded(quests, returnZone) then
		state.questClearReturnZone()
		return false
	end

	-- Feeding/drinking/reset still owns the animal: keep the zone remembered,
	-- but let the normal survival pause code handle this scan.
	if state.questGrowthReset.exclusive
		or state.questGrowthReset.busy
		or state.questGrowthReset.active
		or state.busy
		or questSwitchingAnimal
		or criticalRecoveryActive
		or DAMAGE.active
		or drinkingToFull
		or eatingToFull
		or state.questCarnivoreFeeding
		or state.questBaboonFeeding
		or state.questGiraffeFeeding
		or carcassEatBusy
		or BABOON.busy
		or GIRAFFE.busy
		or CROC.approachBusy
		or forcingPostDrinkMove then
		return false
	end

	local character, root = characterParts()
	if not character or not root then return true end

	local food = character:GetAttribute("Food") or 100
	local water = character:GetAttribute("Water") or 100

	-- Don't return just to leave again for survival.
	if food <= 68 or water <= 75 then
		return false
	end

	local position = getZonePosition(returnZone)
	if not position then
		runtimeMessage = "Could not resolve saved quest zone after feeding"
		state.questClearReturnZone()
		return false
	end

	local currentZone = getPlayerZoneName()

	local zoneMatches = type(currentZone) == "string"
		and currentZone:lower() == returnZone:lower()

	-- Distance to the saved coordinate is NOT proof that Savannah registered the
	-- zone. Only the live zone name can finish a Survive-in-Zone return.
	if zoneMatches then
		state.questClearReturnZone()
		state.questForceFastRecheckUntil = tick() + 20
		runtimeMessage = "Returned to " .. returnZone .. " after feeding; quest resumed"
		return false
	end

	-- Hard-block other quest movement until the saved ZoneTime location is back.
	questTravelWanted = false
	state.questTravelActive = false
	state.questLandInputActive = false
	state.autoRunMoveOwnsInput = false
	state.questMotionMoving = false
	state.questMotionMode = nil
	state.questSetW(false)

	questStatusText = "Returning to " .. returnZone .. " after feeding"

	if tick() - (state.questReturnZone.lastMoveAt or 0) >= 3 then
		state.questReturnZone.lastMoveAt = tick()
		runtimeMessage = "Feeding complete; returning to quest zone: " .. returnZone
		local targetReturnZone = returnZone
		local moved = safeMoveToPosition(
			position,
			10,
			nil,
			{
				purpose = "quest",
				forceMoveToLand = true,
				tolerance = 18,
				maxDuration = 360,
				routeCheckInterval = 0.20,
				routeCheck = function()
					local liveZone = getPlayerZoneName()
					if type(liveZone) == "string"
						and liveZone:lower() == targetReturnZone:lower() then
						return true, "zone_entered"
					end
					return false
				end,
			}
		)

		if state.safeMove.routeInterruptReason == "zone_entered" then
			runtimeMessage = "Entered " .. targetReturnZone .. "; quest resumed"
		elseif not moved then
			runtimeMessage = "Could not enter " .. targetReturnZone .. "; retrying route"
		end
	end

	return true
end


local function updateQuestAutomation()
	-- v67: resolve the live character at the START of every quest scan.
	-- v65 introduced Swim survival checks that read character:GetAttribute()
	-- before the old later declaration of `character`. That nil access killed
	-- the quest worker thread while the independent Eat/Drink loop kept running.
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if not character or not root then
		state.questZoneDrinkRelease("zone_inactive")
		questTravelWanted = false
		state.questTravelActive = false
		state.questLandInputActive = false
		state.questSwimReady = false
		state.questMotionMoving = false
		state.questMotionMode = nil
		state.questSetW(false)
		questStatusText = "Auto Quests: waiting for active character"
		return
	end

	if state.questGrowthReset.exclusive then
		state.questZoneDrinkRelease("zone_inactive")
		questTargetZoneName = nil
		questTravelWanted = false
		state.questTravelActive = false
		state.questLandInputActive = false
		state.questSwimActive = false
		state.questSwimReady = false
		state.questMotionMoving = false
		state.questMotionMode = nil
		state.questSetW(false)
		questStatusText = "Growth reset in progress - other quest automation paused"
		return
	end

	-- Water/void safety can temporarily own the character. If that owner is
	-- gone and we're demonstrably safe, release a stale recovery flag.
	if criticalRecoveryActive then
		state.questReleaseStaleRecoveryLock()
	end

	if not state.autoQuests then
		state.questZonePriority.active = false
		state.questZonePriority.zone = nil
		state.questZonePriority.resolved = true
		state.questZoneDrinkRelease("zone_inactive")
		state.questTravelHerbivoreFeed.active = false
		questTargetZoneName = nil
		questTravelWanted = false
		state.questTravelActive = false
		state.questLandInputActive = false
		state.questSetW(false)
		state.questSwimActive = false
		state.questSwimReady = false
		state.questCarnivoreFeeding = false
		state.questBaboonFeeding = false
		state.questGiraffeFeeding = false
		BABOON.cancel()
		GIRAFFE.cancel()
		state.questGroup.statusText = ""
		state.questMoveSubState = "Running"
		if not state.autoClaimQuests then questStatusText = "Ready" end
		return
	end

	if not criticalRecoveryActive and not questSwitchingAnimal then
		state.applySurvivalDefaults(false)
		if renders then
			if renders.autoEat then renders.autoEat() end
			if renders.autoDrink then renders.autoDrink() end
		end
	end

	-- Acquire feeding ownership BEFORE quest routing can switch animal/group/zone.
	-- This prevents the first frame of a low-food carnivore/Giraffe/Baboon from
	-- starting another quest transaction before Auto Eat gets its next 1s tick.
	local earlyFood =
		tonumber(
			character:GetAttribute(
				"Food"
			)
		) or 100

	if state.autoEat
		and not preSwitchFoodTarget
		and earlyFood <= 70 then

		if isGiraffeCharacter(character) then
			state.questGiraffeFeeding = true
			eatingToFull = true
		elseif isBaboonCharacter(character) then
			state.questBaboonFeeding = true
			eatingToFull = true
		elseif isCarnivoreCharacter(character) then
			state.questCarnivoreFeeding = true
			eatingToFull = true
		end
	end

	-- Food/Water owns the character exclusively. Opportunistic remote eating/
	-- drinking during an Auto Run circle does not set these ownership flags.
	local earlyWater =
		tonumber(
			character:GetAttribute(
				"Water"
			)
		) or 100

	local directSurvivalNeed =
		(state.autoDrink and earlyWater <= 75)
		or (state.autoEat and earlyFood <= 70)

	local survivalOwnsQuestControl =
		directSurvivalNeed
		or drinkingToFull
		or eatingToFull
		or carcassEatBusy
		or CROC.approachBusy
		or BABOON.busy
		or GIRAFFE.busy
		or state.questCarnivoreFeeding
		or state.questBaboonFeeding
		or state.questGiraffeFeeding
		or forcingPostDrinkMove
		or criticalRecoveryActive
		or DAMAGE.active

	if survivalOwnsQuestControl then
		questTravelWanted = false
		state.questTravelActive = false
		state.questLandInputActive = false
		state.questMotionMoving = false
		state.questMotionMode = nil
		state.questSetW(false)

		questStatusText =
			(state.autoDrink and earlyWater <= 75)
				and string.format("Paused: water priority (%d%%)", math.floor(earlyWater))
			or (state.autoEat and earlyFood <= 70)
				and string.format("Paused: food priority (%d%%)", math.floor(earlyFood))
			or drinkingToFull
				and "Paused: drinking"
			or state.questCarnivoreFeeding
				and "Paused: carnivore feeding"
			or state.questGiraffeFeeding
				and "Paused: Giraffe feeding"
			or state.questBaboonFeeding
				and "Paused: Baboon feeding"
			or eatingToFull
				and "Paused: eating"
			or "Paused: survival controller"

		return
	end

	local quests = getAllQuests()

	-- Evita interpretar um atraso de replicação como "acabaram as quests".
	-- Com lista vazia, exige 3 leituras consecutivas (15s). Se alguma quest
	-- apareceu nesta sessão, zeramos o contador sempre que os dados voltam.
	if #quests > 0 then
		state.questSeenAny = true
		state.questEmptyScans = 0
	else
		state.questEmptyScans = (state.questEmptyScans or 0) + 1
		if state.questEmptyScans < 3 then
			questTargetZoneName = nil
			questTravelWanted = false
			state.questTravelActive = false
			state.questLandInputActive = false
			state.questSetW(false)
			state.questSwimActive = false
			state.questSwimReady = false
			questStatusText = string.format(
				"Waiting for quest data (%d/3)",
				state.questEmptyScans
			)
			return
		end
	end

	-- Quando todas as Daily/Weekly atuais estiverem concluídas, encerra o
	-- controlador de quests e passa automaticamente para:
	-- 1) crescer TODOS os slots existentes abaixo de 100%;
	-- 2) quando não restar nenhum, AFK Coin Farm.
	local incompleteQuestCount = 0
	local actionableQuestCount = 0
	state.questTravelActive = false

	do
		local availabilityRecords = savedCharacters()

		for _, quest in ipairs(quests) do
			if not state.questGroup.questComplete(quest) then
				incompleteQuestCount += 1

				local actionable =
					state.questIsActionable(quest, availabilityRecords)

				if actionable then
					actionableQuestCount += 1

					if isTravelQuestForAutoRun(quest.props) then
						state.questTravelActive = true
					end
				end
			end
		end
	end

	local growthDebtActive = false
	if state.questGrowthReset.active then
		growthDebtActive = state.questGrowthResetMaintain(savedCharacters())
	end

	if actionableQuestCount == 0 and growthDebtActive then
		state.questZoneDrinkRelease(
			"zone_complete"
		)

		state.questClearReturnZone()
		questTargetZoneName = nil
		questTravelWanted = false
		state.questTravelActive = false
		state.questLandInputActive = false
		state.questSetW(false)
		state.applySurvivalDefaults(false)

		local tracked =
			state.questGrowthReset.active

		local trackedName =
			tracked
				and tracked.characterName

		local stagedThisDebt =
			state.questGrowthReset.debtStageDone
				and trackedName
					== state.questGrowthReset.debtStageCharacterName

		if not stagedThisDebt then
			state.questGrowthResetStageDebt(
				"Quests done: moving reset Growth slot to switch point"
			)

			questStatusText =
				"Quests done; staging reset Growth slot"

			return
		end

		questStatusText =
			"Quests done; returning reset Growth slot to 100%"

		runtimeMessage =
			"Growth debt active: staged slot must reach 100% before handoff"

		return
	end

	if #quests == 0 or actionableQuestCount == 0 then
		state.questZoneDrinkRelease("zone_complete")
		state.questClearReturnZone()
		questTargetZoneName = nil
		questTravelWanted = false
		state.questTravelActive = false
		state.questLandInputActive = false
		state.questSetW(false)
		state.questSwimActive = false
		state.questSwimReady = false
		state.questCarnivoreFeeding = false
		state.questBaboonFeeding = false
		state.questGiraffeFeeding = false
		BABOON.cancel()
		GIRAFFE.cancel()
		state.questGroup.statusText = ""

		local records = savedCharacters()
		local hasIncompleteSlot = false
		for _, entry in ipairs(records) do
			if type(entry) == "table" and not isGrowthComplete(entry.GrowthPercentage) then
				hasIncompleteSlot = true
				break
			end
		end

		local coopPackHandler =
			state.questGroup.resolveHandler()

		local coopPack =
			coopPackHandler
			and state.questGroup.getCurrentPack(
				coopPackHandler
			)

		local coopHoldForAnotherMMB =
			coopPack
			and state.questGroup.isMMBPack(coopPack)
			and not state.questGroup.samePlayer(
				coopPack.Owner,
				player
			)
			and state.questGroup.hasOtherMember(
				coopPack
			)

		-- If we're a NON-OWNER member of an MMB group, remain available to the
		-- other account instead of immediately switching species for Growth.
		-- The synchronized probe/lifecycle will release us when the owner closes.
		if coopHoldForAnotherMMB then
			questStatusText =
				"MMB co-op: local quests done; remaining in group to help another account"

			runtimeMessage =
				"MMB co-op hold: staying in current species until owner safely closes group"

			return
		end

		state.autoQuests = false
		state.growNew = false

		if hasIncompleteSlot then
			state.questPostGrowAll = true
			state.growExisting = true
			state.growExistingAutomaticAll = true
			state.growAllSlots = false
			state.farmCoins = false

			if incompleteQuestCount > 0 then
				questStatusText =
					"AUTO Grow Existing: ALL ANIMALS (<100%)"
				runtimeMessage =
					"Automatic Growth mode: switching across ALL animal species until every existing slot reaches 100%"
			else
				questStatusText = "AUTO Grow Existing: ALL ANIMALS (<100%)"
				runtimeMessage =
					"Quests complete: automatic all-species Growth enabled until every existing slot reaches 100%"
			end
		else
			state.questPostGrowAll = false
			state.growExisting = false
			state.growExistingAutomaticAll = false
			state.growAllSlots = false
			state.farmCoins = true

			if incompleteQuestCount > 0 then
				questStatusText =
					"Remaining quests unavailable -> AFK Coin Farm"
				runtimeMessage =
					"Unworkable quests skipped; AFK coin farming until a real possibility appears"
			else
				questStatusText = "All quests + slots complete -> AFK Coin Farm"
				runtimeMessage = "All quests/slots complete: AFK coin farming"
			end
		end

		state.applySurvivalDefaults(
			false
		)
		if renders then
			for _, key in ipairs({
				"autoQuests", "growExisting", "growAllSlots", "growNew",
				"farmCoins", "autoEat", "autoDrink"
			}) do
				if renders[key] then renders[key]() end
			end
		end
		return
	end


	-- ========================================================
	-- Swim quests
	-- ========================================================
	-- Pure Swimming TravelDistance quests are intentionally handled before
	-- Zone/Grouping/Growth because they complete quickly and require a very
	-- specific movement state. Generic Survive/PlayTime quests continue to
	-- progress naturally while this happens.
	local incompleteSwimCount = 0
	local firstSwimTitle

	for _, quest in ipairs(quests) do
		if isSwimQuest(quest.props) and not state.questGroup.questComplete(quest) then
			incompleteSwimCount += 1
			firstSwimTitle = firstSwimTitle or quest.props.Title
		end
	end

	if incompleteSwimCount > 0 then
		state.questZoneDrinkRelease("zone_inactive")
		state.questSwimActive = true
		state.questTravelActive = false
		state.questLandInputActive = false
		state.questSetW(false)
		questTravelWanted = false
		questTargetZoneName = nil
		state.questMoveSubState = "Swimming"

		-- v65 survival priority during Swim:
		--   1) Water <=75 -> drink to full.
		--   2) Food <=68 (or an already-active feeding cycle) -> eat.
		--   3) Only when survival is stable do we travel to/run the Swim farm.
		state.applySurvivalDefaults(false)

		local swimWater =
			tonumber(character:GetAttribute("Water")) or 100
		local swimFood =
			tonumber(character:GetAttribute("Food")) or 100

		if swimWater <= 75 then
			drinkingToFull = true
		end

		if not drinkingToFull then
			drinkingSourcePosition = nil
			drinkingStuckSince = nil
		end

		removeSwimBarrier()

		if renders then
			if renders.autoEat then renders.autoEat() end
			if renders.autoDrink then renders.autoDrink() end
		end

		-- Water has absolute priority.
		if drinkingToFull then
			state.questSwimReady = false
			state.questTravelActive = false
			state.questLandInputActive = false
			state.questMotionMoving = false
			state.questMotionMode = nil
			state.questSetW(false)
			questStatusText = string.format(
				"Swim paused: drinking to full (%d%%)",
				math.floor(swimWater)
			)
			return
		end

		-- Food is serviced before travelling to / continuing the Swim location.
		if eatingToFull or swimFood <= 68 then
			state.questSwimReady = false
			state.questTravelActive = false
			state.questLandInputActive = false
			state.questMotionMoving = false
			state.questMotionMode = nil
			state.questSetW(false)
			questStatusText = string.format(
				"Swim paused: eating (%d%%)",
				math.floor(swimFood)
			)
			return
		end

		-- Never fight an already-running recovery/slot/movement routine.
		if questSwitchingAnimal or state.busy or criticalRecoveryActive
			or DAMAGE.active or forcingPostDrinkMove then
			state.questSwimReady = false
			questStatusText = "Swim: waiting for current recovery/movement"
			return
		end

		local swimCharacter, swimRoot = characterParts()
		if not swimCharacter or not swimRoot then
			state.questSwimReady = false
			questStatusText = "Swim: waiting for character"
			return
		end

		local target = state.questSwimPosition
		local horizontalDelta = Vector3.new(
			swimRoot.Position.X - target.X,
			0,
			swimRoot.Position.Z - target.Z
		)

		-- Only the saved farm region is accepted. A random puddle can satisfy
		-- Auto Drink, but it can never satisfy the Swim mission.
		local inSavedSwimArea = horizontalDelta.Magnitude <= 68
		local inValidSwimWater =
			inSavedSwimArea and isValidSwimQuestWater(swimRoot)

		if not inValidSwimWater then
			state.questSwimReady = false
			questStatusText = "Swim: moving to water"
			runtimeMessage = "Swim quest: moving to swim area"

			local moved = safeMoveToPosition(
				target,
				10,
				nil,
				{
					purpose = "quest",
					tolerance = 20,

					-- Walk/run with full obstacle + mountain avoidance first.
					-- Only within ~58 studs of the saved Swim location does the
					-- controller switch to 3D Swimming approach.
					swimming = true,
					swimActivationDistance = 58,
					maxDuration = 360,
				}
			)
			task.wait(0.45)

			local _, landedRoot, landedHumanoid = characterParts()
			if landedHumanoid then
				pcall(landedHumanoid.ChangeState, landedHumanoid, Enum.HumanoidStateType.Swimming)
			end
			setSubState("Swimming")
			task.wait(0.25)

			if moved and landedRoot and isValidSwimQuestWater(landedRoot) then
				state.questSwimReady = true
				state.questSwimLastWaterCheck = tick()
				setSubState("Swimming")
				questStatusText = string.format(
					"%s: swimming (%d active)",
					tostring(firstSwimTitle or "Swim"),
					incompleteSwimCount
				)
			else
				state.questSwimReady = false
				questStatusText = "Swim: water verification failed; retrying"
				runtimeMessage = "Swim quest: target did not verify as water"
			end
			return
		end

		state.questSwimReady = true
		state.questSwimWaterMisses = 0
		state.questSwimLastWaterCheck = tick()
		questStatusText = string.format(
			"%s: swimming (%d active)",
			tostring(firstSwimTitle or "Swim"),
			incompleteSwimCount
		)
		return
	elseif state.questSwimActive then
		-- A scan confirmed every Swim quest at 100%. Stop the movement mode
		-- immediately and restore normal survival automation. We do NOT
		-- move back to the swim position again.
		state.questSwimActive = false
		state.questSwimReady = false
		state.questMoveSubState = "Running"
		questTravelWanted = false
		state.questTravelActive = false

		local _, swimRoot = characterParts()
		if swimRoot then
			local velocity = swimRoot.AssemblyLinearVelocity
			swimRoot.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
		end

		drinkingToFull = false
		drinkingSourcePosition = nil
		drinkingStuckSince = nil
		lastDrinkWatchdogWater = nil
		removeSwimBarrier()
		blockClientSubState = false

		state.applySurvivalDefaults(false)
		if renders then
			if renders.autoEat then renders.autoEat() end
			if renders.autoDrink then renders.autoDrink() end
		end

		runtimeMessage = "Swim quests complete; resuming normal quests"
	end

	-- ========================================================
	-- Terrestrial Auto Run state -- computed EARLY
	-- ========================================================
	-- This must happen before Growth/flying/specific-animal routing. Those
	-- systems may return early, but Run must remain enabled in parallel.
	questTravelWanted = false
	state.questLandInputActive = false
	state.questMoveSubState = "Running"

	local incompleteTravelCount = 0
	for _, quest in ipairs(quests) do
		if isTravelQuestForAutoRun(quest.props)
			and not state.questGroup.questComplete(quest) then

			incompleteTravelCount += 1
			questTravelWanted = true

			-- Any TravelDistance handled on land needs virtual W held so the game
			-- sees the normal movement input state while MoveTo owns steering.
			if not isSwimQuest(quest.props) then
				state.questLandInputActive = true
			end

			local allowed = quest.props.QuestData
				and quest.props.QuestData.AllowedMovementStates

			if type(allowed) == "table" then
				local hasRunning = false
				local hasSprinting = false

				for _, movementState in ipairs(allowed) do
					if movementState == "Running" then hasRunning = true end
					if movementState == "Sprinting" then hasSprinting = true end
				end

				if hasRunning then
					state.questMoveSubState = "Running"
				elseif hasSprinting then
					state.questMoveSubState = "Sprinting"
				end
			end
		end
	end

	state.questTravelActive = questTravelWanted
	if not state.questLandInputActive then
		state.questSetW(false)
	end

	-- Feeding may temporarily move any animal away from an active ZoneTime
	-- mission. Once survival is stable, return there BEFORE other quest routing.
	if state.questReturnToZoneAfterFeeding(quests) then
		return
	end

	-- ========================================================
	-- Flying animals vs Land Distance
	-- ========================================================
	-- Yellow Hornbill / Flamingo / Vulture do not participate in generic
	-- auto-selection. More importantly, every incomplete on-land travel quest
	-- is completed BEFORE Auto Quests is allowed to switch into one of them.
	state.questPendingLandCount = 0
	for _, quest in ipairs(quests) do
		-- Anything our terrestrial Auto Run handles counts here.
		-- Swim-only quests intentionally do NOT block flying animals.
		if isTravelQuestForAutoRun(quest.props)
			and not state.questGroup.questComplete(quest) then
			state.questPendingLandCount += 1
		end
	end

	state.questBlockFlying = state.questPendingLandCount > 0

	if state.questBlockFlying then
		local landCharacter = player.Character
		if state.questIsFlyingCharacter(landCharacter)
			and not questSwitchingAnimal
			and not state.busy
			and not criticalRecoveryActive then

			local landRecords = savedCharacters()
			local currentName = landCharacter
				and landCharacter:GetAttribute("CharacterName")
			local growthPending = state.questHasIncompleteGrowth(quests)

			local grounded

			if growthPending then
				-- Only an ALREADY-growing grounded slot may be selected here.
				-- Mature reset decisions are centralized later so protected species
				-- and global <100%-first rules cannot be bypassed.
				for _, entry in ipairs(landRecords) do
					if type(entry) == "table"
						and entry.CharacterName ~= currentName
						and type(entry.AnimalName) == "string"
						and not state.questIsFlyingAnimalName(entry.AnimalName)
						and not isGrowthComplete(entry.GrowthPercentage) then
						grounded = entry
						break
					end
				end
			else
				grounded = state.questFindGroundedSlot(
					landRecords,
					currentName,
					true
				)
			end

			if grounded then
				questLastAnimalSwitch = tick()
				questSwitchingAnimal = true
				questTravelWanted = false
				state.questTravelActive = false
				state.questLandInputActive = false
				state.questSetW(false)

				if growthPending then
					questStatusText = "Land + Growth: existing <100% grounded -> "
						.. tostring(grounded.AnimalName)
				else
					questStatusText = string.format(
						"Land Distance first (%d pending) -> %s",
						state.questPendingLandCount,
						tostring(grounded.AnimalName)
					)
				end

				runtimeMessage = growthPending
					and "Existing grounded Growth slot selected; no reset performed"
					or "Flying animal blocked until Land Distance quests finish"

				task.spawn(function()
					if not state.prepareCurrentSlotForSwitch(
						"Run/Growth: staging current animal before grounded-slot switch"
					) then
						questSwitchingAnimal = false
						runtimeMessage = "Grounded-slot switch postponed: staging failed"
						return
					end

					if ResetRemote then
						pcall(ResetRemote.InvokeServer, ResetRemote)
						task.wait(1.3)
					end

					local spawned = spawnSlot(grounded, true)
					questSwitchingAnimal = false

					if spawned then
						state.questForceFastRecheckUntil = tick() + 25
						runtimeMessage = growthPending
							and "Run + existing Growth slot active together"
							or "Ground animal ready; completing Land Distance first"
					end
				end)

				return
			elseif growthPending then
				questStatusText = "Land + Growth: no grounded <100%; safe reset policy will choose next"
			else
				questStatusText = "Land Distance pending, but no grounded saved slot was found"
			end
		end
	end

	-- ========================================================
	-- Run + Growth coordinator
	-- ========================================================
	-- Running quests are the primary route. A deferred flying quest has ZERO
	-- influence here. Growth is stacked onto the CURRENT grounded runner.
	if state.questBlockFlying and state.questHasIncompleteGrowth(quests) then
		local runCharacter = player.Character

		if runCharacter
			and not state.questIsFlyingCharacter(runCharacter)
			and not questSwitchingAnimal
			and not state.busy
			and not criticalRecoveryActive then

			local runRecords = savedCharacters()
			local runEntry = state.questFindCurrentSavedEntry(
				runRecords,
				runCharacter
			)

			if runEntry then
				if not isGrowthComplete(runEntry.GrowthPercentage) then
					-- Perfect: current runner is one of the existing <100% slots.
					state.questGrowthResetMaintain(runRecords)
				else
					-- DO NOT reset here. Another saved slot may already be below 100%,
					-- and protected animals must pass the centralized reset policy.
					questStatusText = "Run + Growth: mature runner; checking all existing <100% slots first"
					runtimeMessage = "Growth reset deferred to global incomplete-first policy"
				end
			else
				-- Never guess another 100% slot just because CharacterName
				-- replication is late. Keep running and retry the lookup.
				runtimeMessage = "Run + Growth: waiting for current saved-slot identity; not switching slots"
			end
		end
	end

	-- Comer/beber tem prioridade absoluta. Sem isso o scanner de zona podia
	-- mover o jogador no meio da água ou enquanto ele tentava comer.
	-- Reuse the character validated at the start of this quest scan.
	character = player.Character or character
	local food = character and (character:GetAttribute("Food") or 100) or 100
	local water = character and (character:GetAttribute("Water") or 100) or 100
	local giraffe = character and isGiraffeCharacter(character)
	local baboon = character and not giraffe and isBaboonCharacter(character)
	local carnivore = character and not giraffe and not baboon and isCarnivoreCharacter(character)

	if state.autoQuests
		and giraffe
		and food <= 70
		and not preSwitchFoodTarget then

		state.questRememberZoneBeforeFeeding("Giraffe feeding")
		state.questGiraffeFeeding = true
		eatingToFull = true
		state.questForceFastRecheckUntil = tick() + 10
		runtimeMessage = string.format(
			"Giraffe quest slot: feeding on tree leaves to 100%% (%d%%)",
			math.floor(food)
		)
	end

	if state.autoQuests
		and baboon
		and food <= 70
		and not preSwitchFoodTarget then

		state.questRememberZoneBeforeFeeding("Baboon feeding")
		state.questBaboonFeeding = true
		eatingToFull = true
		state.questForceFastRecheckUntil = tick() + 10
		runtimeMessage = string.format(
			"Baboon quest slot: feeding to 100%% before route resume (%d%%)",
			math.floor(food)
		)
	end

	if state.autoQuests and carnivore and food <= 70 and not preSwitchFoodTarget then
		state.questRememberZoneBeforeFeeding("Carnivore feeding")
		state.questCarnivoreFeeding = true
		eatingToFull = true
		state.questForceFastRecheckUntil = tick() + 10
		runtimeMessage = string.format(
			"Carnivore quest slot: feeding to 100%% before route resume (%d%%)",
			math.floor(food)
		)
	end

	local waterCritical = water <= 45

	if state.autoQuests
		and not carnivore
		and not baboon
		and not giraffe
		and food <= 68 then
		state.questRememberZoneBeforeFeeding("feeding")
	end

	if state.questCarnivoreFeeding
		or state.questBaboonFeeding
		or state.questGiraffeFeeding
		or BABOON.busy
		or GIRAFFE.busy
		or drinkingToFull
		or eatingToFull
		or carcassEatBusy
		or CROC.approachBusy
		or forcingPostDrinkMove
		or waterCritical
		or (not carnivore and not baboon and not giraffe and food <= 68) then

		questStatusText = state.questGiraffeFeeding
			and string.format("Paused: Giraffe eating tree leaves to 100%% (%d%%)", math.floor(food))
			or state.questBaboonFeeding
				and string.format("Paused: Baboon feeding to 100%% (%d%%)", math.floor(food))
			or state.questCarnivoreFeeding
				and string.format("Paused: carnivore eating to 100%% (%d%%)", math.floor(food))
			or drinkingToFull and "Paused: drinking"
			or eatingToFull and "Paused: eating"
			or waterCritical and "Paused: water critically low"
			or (not carnivore and not baboon and not giraffe and food <= 68) and "Paused: food low"
			or "Paused: survival routine"
		return
	end

	local records = savedCharacters()
	state.questGrowthResetMaintain(records)
	state.questGrowthOwnsCurrent = false

	local specificAnimalFocus = false
	local focusQuest
	local focusAnimal
	state.questFlyingDeferred = false

	for _, quest in ipairs(quests) do
		if not state.questGroup.questComplete(quest) then
			local targetAnimal = findSpecificAnimalTarget(quest, records)

			if targetAnimal then
				local unavailableReason =
					state.questSlots.unavailableReason(
						targetAnimal,
						records
					)

				if unavailableReason then
					-- Keep scanning for another specific-animal quest that CAN be
					-- completed. This quest remains visible but cannot monopolize
					-- Auto Eat/Drink, Growth, Zone, Travel or Coin handoff.
					state.questSlots.lastSkippedAnimal = targetAnimal

				elseif state.questIsFlyingAnimalName(targetAnimal)
					and state.questBlockFlying then

					state.questFlyingDeferred = true
				else
					specificAnimalFocus = true
					focusQuest = quest
					focusAnimal = targetAnimal
					break
				end
			end
		end
	end

	if state.questFlyingDeferred and not focusQuest then
		runtimeMessage = string.format(
			"Flying-animal quest deferred: finish %d Land Distance quest(s) first",
			state.questPendingLandCount
		)
	end

	if focusQuest
		and focusAnimal
		and state.questIsFlyingAnimalName(focusAnimal)
		and state.questBlockFlying then

		state.questFlyingDeferred = true
		questStatusText = string.format(
			"Running quests first (%d pending); flying quest waits",
			state.questPendingLandCount
		)
		focusQuest = nil
		focusAnimal = nil
	end

	-- Growth policy runs BEFORE a specific-animal switch. This guarantees that a
	-- mature Baboon/Elephant/etc. can never steal priority from ANY existing
	-- <100% slot just because a PlayTime quest also exists.
	if state.questHasIncompleteGrowth(quests) then
		if trySwitchToGrowingSlot(
			quests,
			records,
			specificAnimalFocus,
			focusAnimal
		) then
			questStatusText = state.questGrowthReset.busy
				and "Growth policy: resetting approved mature slot"
				or "Growth policy: using existing <100% slot"
			return
		end
	end

	if focusQuest
		and focusAnimal
		and not state.questGrowthReset.active
		and not state.questGrowthOwnsCurrent then

		local character = player.Character
		local currentAnimal = character and character:GetAttribute("AnimalName")
		local targetSlot = state.questSlots.findAnimalSlot(records, focusAnimal)

		if targetSlot then
			if trySwitchToQuestAnimal(focusQuest, records, focusAnimal) then
				questStatusText = "Changing animal for " .. tostring(focusQuest.props.Title)
				return
			end
		elseif type(currentAnimal) == "string"
			and state.questAnimalKey(currentAnimal) == state.questAnimalKey(focusAnimal) then
			-- Already spawned as the requested species; no reason to create a slot.
		else
			-- If a previous quest-only slot exists for another species, remove ONLY
			-- that confirmed temp slot before creating the next one, even if there
			-- are still spare slots. This prevents accumulating quest-only slots.
			if state.questSlots.temp
				and type(state.questSlots.temp.animalName) == "string"
				and state.questSlots.temp.animalName:lower() ~= focusAnimal:lower() then

				if state.questSlots.deleteTempForNext(focusAnimal) then
					questStatusText = "Replacing previous quest-only slot -> " .. focusAnimal
					return
				end
			end

			-- Re-read after any possible cleanup before the final create validation.
			records = savedCharacters()
			targetSlot = state.questSlots.findAnimalSlot(records, focusAnimal)
			if not targetSlot then
				if state.questSlots.createForQuest(focusQuest, focusAnimal, records) then
					questStatusText = "Preparing quest-only slot: " .. focusAnimal
					return
				end

				if state.questSlots.unavailableReason(
					focusAnimal,
					savedCharacters()
				) then
					focusQuest = nil
					focusAnimal = nil
					specificAnimalFocus = false
				end
			end
		end
	end

	-- Grouping roda em paralelo com Zone/Travel. A cada verificação confirma
	-- que o pack pertence ao animal atual; se o jogador trocar de animal,
	-- sai/desfaz o pack incompatível e procura/cria outro correto.
	local groupingQuestActive = false
	for _, quest in ipairs(quests) do
		if quest.props.QuestType == "GroupTime"
			and not state.questGroup.questComplete(quest) then

			local allowGroupAnimalSwitch =
				not specificAnimalFocus
				or state.questGrowthOwnsCurrent

			-- IMPORTANT v71:
			-- Ensure FIRST. The previous order asked whether a "real possibility"
			-- existed before creating our own MMB pack. On some servers that meant
			-- GroupTime was eventually ignored without ever advertising MMBx.
			state.questGroup.ensureForCurrentAnimal(
				records,
				allowGroupAnimalSwitch
			)

			local groupingPossible =
				state.questGroup.refreshAvailability(
					records,
					allowGroupAnimalSwitch
				)

			if groupingPossible then
				groupingQuestActive = true
			elseif state.questGroup.ignoredUntilPossibility then
				-- Keep the MMB pack open as a beacon, but don't block unrelated
				-- quests while there is still no second compatible animal.
				groupingQuestActive = false
			end

			break
		end
	end

	-- Terrestrial Auto Run was already computed before Growth/flying routing.
	-- Do not reset questTravelWanted here; compatible quests must keep moving.

	-- Escolhe a missão de zona com maior progresso detectável.
	-- Se o runtime não expuser um campo de progresso, mantém a ordem normal.
	local function progressRatio(quest)
		local maxProgress
		if quest.props and type(quest.props.GetMaxProgress) == "function" then
			local ok, value = pcall(quest.props.GetMaxProgress, quest.props)
			if ok and type(value) == "number" and value > 0 then maxProgress = value end
		end
		if not maxProgress then return 0 end

		local function scan(value, seen)
			if type(value) ~= "table" then return nil end
			seen = seen or {}
			if seen[value] then return nil end
			seen[value] = true

			local best
			for key, child in pairs(value) do
				if type(child) == "number" and type(key) == "string"
					and key:lower():find("progress", 1, true) then
					best = math.max(best or 0, child)
				elseif type(child) == "table" then
					local nested = scan(child, seen)
					if nested then best = math.max(best or 0, nested) end
				end
			end
			return best
		end

		local current = scan(quest.entry)
		if type(current) == "number" then
			return math.clamp(current / maxProgress, 0, 1)
		end

		local gui = player:FindFirstChild("PlayerGui")
		local questsGui = gui and gui:FindFirstChild("QuestsScreenGui")
		local scrolling = questsGui and questsGui:FindFirstChild("RefScrollingFrame", true)
		local title = quest.props and quest.props.Title
		local wantedTitle = type(title) == "string" and title:lower() or nil
		if scrolling and wantedTitle then
			for _, frame in ipairs(scrolling:GetChildren()) do
				if frame:IsA("GuiObject") and frame.Name:match("^QuestFrame%d+$") then
					local pieces = {}
					for _, object in ipairs(frame:GetDescendants()) do
						if object:IsA("TextLabel") or object:IsA("TextButton") then
							table.insert(pieces, tostring(object.Text))
						end
					end
					local combined = table.concat(pieces, " ")
					if combined:lower():find(wantedTitle, 1, true) then
						local shownCurrent, shownMax = combined:match("([%d,%.]+)%s*/%s*([%d,%.]+)")
						if shownCurrent and shownMax then
							shownCurrent = tonumber((shownCurrent:gsub("[,%.]", "")))
							shownMax = tonumber((shownMax:gsub("[,%.]", "")))
							if shownCurrent and shownMax and shownMax > 0 then
								return math.clamp(shownCurrent / shownMax, 0, 1)
							end
						end
					end
				end
			end
		end

		return 0
	end

	questTargetZoneName = nil
	local zoneQuestTitle
	local bestZoneRatio = -1
	for _, quest in ipairs(quests) do
		if quest.props.QuestType == "ZoneTime" then
			local targetZone = findZoneInQuest(quest)
			if targetZone then
				local ratio = progressRatio(quest)

				-- Quest de zona concluída continua aparecendo nos dados/HUD até ser
				-- resgatada. Nunca usa uma de 100% como destino; entre as incompletas,
				-- continua priorizando a que está mais perto de terminar.
				if ratio < 0.999 and ratio > bestZoneRatio then
					bestZoneRatio = ratio
					questTargetZoneName = targetZone
					zoneQuestTitle = quest.props.Title
				end
			end
		end
	end

	state.questZonePriority.resolved = true
	state.questZonePriority.active =
		type(questTargetZoneName) == "string"
		and questTargetZoneName ~= ""
	state.questZonePriority.zone =
		state.questZonePriority.active
		and questTargetZoneName
		or nil

	if state.questZonePriority.active
		and state.safeMove
		and state.safeMove.active
		and state.safeMove.reason == "growth_home" then

		state.safeMove.cancelToken += 1
		state.growthPride.returning = false
		state.growthPride.returnRequested = false
		state.releaseMovementNow(
			player.Character,
			true
		)
	end

	local passiveSurviveTitle
	for _, quest in ipairs(quests) do
		local data = quest.props and quest.props.QuestData
		if quest.props
			and quest.props.QuestType == "PlayTime"
			and data
			and data.ShouldBeSpawnedAsAnimal == true
			and not data.ShouldBeSpawnedAsSpecificAnimalName
			and not state.questGroup.questComplete(quest) then
			passiveSurviveTitle = passiveSurviveTitle or quest.props.Title
		end
	end

	if questTargetZoneName then
		local currentZone = getPlayerZoneName()
		local position = getZonePosition(questTargetZoneName)

		local zoneNameMatches = type(currentZone) == "string"
			and currentZone:lower() == questTargetZoneName:lower()

		-- Never substitute coordinate proximity for the game's actual zone state.
		-- Being 100-150 studs from a center point may still be outside ZoneTime.
		state.questZoneDrinkUpdate(
			questTargetZoneName,
			zoneNameMatches
		)

		if not zoneNameMatches then
			local sameTarget = state.questZoneLastTarget == questTargetZoneName
			local canMoveAgain = not sameTarget
				or tick() - (state.questZoneLastMoveAt or 0) >= 8

			if position
				and canMoveAgain
				and not state.busy
				and not criticalRecoveryActive
				and not DAMAGE.active
				and not drinkingToFull
				and not eatingToFull then

				state.questZoneLastTarget = questTargetZoneName
				state.questZoneLastMoveAt = tick()
				questStatusText = "Going to " .. questTargetZoneName
				runtimeMessage = "Quest zone: " .. questTargetZoneName
				local targetZoneName = questTargetZoneName
				local moved = safeMoveToPosition(
					position,
					10,
					nil,
					{
						purpose = "quest",
						forceMoveToLand = true,
						tolerance = 18,
						maxDuration = 360,
						routeCheckInterval = 0.20,
						routeCheck = function()
							local liveZone = getPlayerZoneName()
							if type(liveZone) == "string"
								and liveZone:lower() == targetZoneName:lower() then
								return true, "zone_entered"
							end
							return false
						end,
					}
				)

				if state.safeMove.routeInterruptReason == "zone_entered" then
					questStatusText = "Entered " .. targetZoneName
					runtimeMessage = "Quest zone confirmed: " .. targetZoneName
				elseif not moved then
					runtimeMessage = "Quest zone route interrupted; retrying " .. targetZoneName
				end
			else
				questStatusText = "Waiting to enter " .. questTargetZoneName
			end
		else
			local progressText = bestZoneRatio > 0
				and string.format(" (%.0f%%)", bestZoneRatio * 100)
				or ""
			questStatusText = string.format("%s: %s%s", tostring(zoneQuestTitle or "Zone quest"), questTargetZoneName, progressText)
		end
	else
		state.questZoneDrinkUpdate(nil, false)

		if questTravelWanted then
			questStatusText = string.format("Auto Run: Travel/Land Distance (%d active)", incompleteTravelCount)
		elseif groupingQuestActive then
			questStatusText = state.questGroup.statusText ~= "" and state.questGroup.statusText or "Grouping: checking pack"
		elseif passiveSurviveTitle then
			questStatusText = "Passive: " .. tostring(passiveSurviveTitle) .. " (stay alive as any animal)"
		else
			local first = quests[1]
			questStatusText = "Progressing: " .. tostring(first and first.props and first.props.Title or "quests")
		end
	end
end

function state.questProgressValues(quest)
	if type(quest) ~= "table" or type(quest.props) ~= "table" then
		return nil, nil, nil
	end

	local maxProgress
	if type(quest.props.GetMaxProgress) == "function" then
		local ok, value = pcall(quest.props.GetMaxProgress, quest.props)
		if ok and type(value) == "number" and value > 0 then
			maxProgress = value
		end
	end

	local function scan(value, seen)
		if type(value) ~= "table" then return nil end
		seen = seen or {}
		if seen[value] then return nil end
		seen[value] = true

		local best
		for key, child in pairs(value) do
			if type(child) == "number" and type(key) == "string"
				and key:lower():find("progress", 1, true) then
				best = math.max(best or 0, child)
			elseif type(child) == "table" then
				local nested = scan(child, seen)
				if nested then best = math.max(best or 0, nested) end
			end
		end
		return best
	end

	local current = scan(quest.entry)
	if type(current) == "number" and type(maxProgress) == "number" then
		return current, maxProgress, math.clamp(current / maxProgress, 0, 1)
	end

	-- HUD fallback. This is also useful because some replicated quest entries
	-- do not expose a numeric Progress field directly.
	local gui = player:FindFirstChild("PlayerGui")
	local questsGui = gui and gui:FindFirstChild("QuestsScreenGui")
	local scrolling = questsGui and questsGui:FindFirstChild("RefScrollingFrame", true)
	local wantedTitle = type(quest.props.Title) == "string"
		and quest.props.Title:lower()
		or nil

	if scrolling and wantedTitle then
		for _, frame in ipairs(scrolling:GetChildren()) do
			if frame:IsA("GuiObject") and frame.Name:match("^QuestFrame%d+$") then
				local pieces = {}
				for _, object in ipairs(frame:GetDescendants()) do
					if object:IsA("TextLabel") or object:IsA("TextButton") then
						table.insert(pieces, tostring(object.Text))
					end
				end

				local combined = table.concat(pieces, " ")
				if combined:lower():find(wantedTitle, 1, true) then
					local shownCurrent, shownMax =
						combined:match("([%d,%.]+)%s*/%s*([%d,%.]+)")

					if shownCurrent and shownMax then
						shownCurrent = tonumber((shownCurrent:gsub("[,%.]", "")))
						shownMax = tonumber((shownMax:gsub("[,%.]", "")))

						if shownCurrent and shownMax and shownMax > 0 then
							return shownCurrent, shownMax,
								math.clamp(shownCurrent / shownMax, 0, 1)
						end
					end
				end
			end
		end
	end

	return nil, maxProgress, nil
end

function state.questFormatProgress(quest)
	local current, maximum, ratio = state.questProgressValues(quest)

	if current and maximum then
		local function compact(value)
			if math.abs(value - math.floor(value)) < 0.001 then
				return tostring(math.floor(value))
			end
			return string.format("%.1f", value)
		end

		return string.format(
			"%s/%s (%d%%)",
			compact(current),
			compact(maximum),
			math.floor((ratio or 0) * 100 + 0.5)
		)
	end

	if ratio then
		return string.format("%d%%", math.floor(ratio * 100 + 0.5))
	end

	return nil
end

function state.questLandWWatchReset()
	state.questLandWWatch.snapshots = {}
	state.questLandWWatch.activeSince = 0
	state.questLandWWatch.lastProgressAt = 0
	state.questLandWWatch.lastSampleAt = 0
	state.questLandWWatch.hardRefreshCount = 0
	state.questLandWWatch.lastQuestCount = 0
end

function state.questLandWWatchStep()
	local watch = state.questLandWWatch
	local now = tick()

	if state.questGrowthReset.exclusive
		or not state.autoQuests
		or not questTravelWanted
		or not state.questLandInputActive
		or not state.questMotionMoving
		or state.questMotionMode ~= "Land"
		or questSwitchingAnimal
		or state.busy
		or criticalRecoveryActive
		or DAMAGE.active
		or drinkingToFull
		or eatingToFull then

		state.questLandWWatchReset()
		return
	end

	local character, root = characterParts()
	if not character or not root then
		state.questLandWWatchReset()
		return
	end

	local velocity = root.AssemblyLinearVelocity
	local planarSpeed = Vector3.new(
		velocity.X,
		0,
		velocity.Z
	).Magnitude

	-- We only diagnose W when the Auto Run engine itself is clearly moving the
	-- animal. If it is physically stopped, another controller/problem owns it.
	if planarSpeed < 3 then
		state.questLandWWatchReset()
		return
	end

	local activeCount = 0
	local readableCount = 0
	local progressed = false
	local newSnapshots = {}

	for _, quest in ipairs(getAllQuests()) do
		local props = quest.props

		local terrestrialTravel = props
			and (
				isLandDistanceQuest(props)
				or (
					isTravelQuestForAutoRun(props)
					and not isSwimQuest(props)
				)
			)

		if terrestrialTravel
			and not state.questGroup.questComplete(quest) then

			local current, maximum = state.questProgressValues(quest)

			-- Replication can briefly leave a completed quest in the list.
			if not (
				type(current) == "number"
				and type(maximum) == "number"
				and maximum > 0
				and current >= maximum * 0.999
			) then
				activeCount += 1

				local key = tostring(
					(quest.entry and quest.entry.QuestUniqueKey)
						or (props and props.Title)
						or activeCount
				)

				if type(current) == "number" then
					readableCount += 1
					newSnapshots[key] = current

					local previous = watch.snapshots[key]
					if type(previous) == "number"
						and current > previous + 0.001 then
						progressed = true
					end
				end
			end
		end
	end

	if activeCount == 0 then
		state.questLandWWatchReset()
		return
	end

	watch.lastQuestCount = activeCount

	if watch.activeSince == 0 then
		watch.activeSince = now
		watch.lastProgressAt = now
	end

	if readableCount > 0 then
		-- Keep the most recent readable snapshot for each land quest.
		watch.snapshots = newSnapshots

		if progressed then
			local hadRecovery = watch.hardRefreshCount > 0
			watch.lastProgressAt = now
			watch.hardRefreshCount = 0

			if hadRecovery then
				runtimeMessage = "Land quest progress restored; virtual W is healthy again"
			end
		end

		-- If we're visibly running but NONE of the terrestrial distance quests
		-- move for 6 seconds, the most likely cause is the virtual W being
		-- cancelled by real player input. Hard-release and recreate W.
		local stalledFor = now - (watch.lastProgressAt or now)

		if stalledFor >= 6
			and now - (watch.lastHardRefreshAt or 0) >= 4 then

			watch.lastHardRefreshAt = now
			watch.lastProgressAt = now
			watch.hardRefreshCount += 1

			state.questHardRefreshW(
				string.format(
					"Land quest stalled for %.0fs; virtual W refreshed automatically",
					stalledFor
				),
				false
			)
		end
	else
		-- Rare fallback: if this server does not expose readable quest progress,
		-- still refresh W periodically while genuine Land Auto Run is active.
		if now - (watch.lastHardRefreshAt or 0) >= 12 then
			watch.lastHardRefreshAt = now

			state.questHardRefreshW(
				"Land quest progress unreadable; virtual W refreshed as a safeguard",
				true
			)
		end
	end

	watch.lastSampleAt = now
end


function state.questIsProgressingNow(quest, records, character, currentAnimal, currentZone, currentPack)
	if not state.autoQuests
		or type(quest) ~= "table"
		or type(quest.props) ~= "table"
		or state.questGroup.questComplete(quest) then
		return false
	end

	local props = quest.props
	local data = props.QuestData or {}
	local questType = props.QuestType

	if questType == "PlayTime" then
		-- Normal Playtime always progresses while connected.
		if not data.ShouldBeSpawnedAsAnimal then
			return true
		end

		-- Survive as a specific animal only progresses while that exact
		-- requested species is currently spawned.
		if data.ShouldBeSpawnedAsSpecificAnimalName then
			local targetAnimal = findSpecificAnimalTarget(quest, records)
			return type(targetAnimal) == "string"
				and type(currentAnimal) == "string"
				and targetAnimal:lower() == currentAnimal:lower()
		end

		-- Generic Survive only requires being spawned as any animal.
		return character ~= nil
			and type(currentAnimal) == "string"
			and currentAnimal ~= ""
	end

	if state.questIsGrowthQuest(quest) then
		if not character then return false end

		local currentEntry = state.questFindCurrentSavedEntry(records, character)
		local growth = currentEntry and currentEntry.GrowthPercentage
		if growth == nil then
			growth = character:GetAttribute("GrowthPercentage")
		end

		return type(growth) == "number" and not isGrowthComplete(growth)
	end

	if questType == "ZoneTime" then
		if type(currentZone) ~= "string" or currentZone == "" then return false end
		local targetZone = findZoneInQuest(quest)
		return type(targetZone) == "string"
			and targetZone:lower() == currentZone:lower()
	end

	if questType == "GroupTime" then
		return currentPack ~= nil
			and state.questGroup.hasOtherMember(currentPack)
	end

	if questType == "TravelDistance" then
		-- Use the ACTUAL motion loop state, not merely the existence of a quest.
		-- This prevents Land/Travel appearing while food, water, damage or a
		-- another movement controller has temporarily stopped movement.
		if not state.questMotionMoving then return false end

		if isSwimQuest(props) then
			return state.questMotionMode == "Swimming"
		end

		if isLandDistanceQuest(props) then
			return state.questMotionMode == "Land"
		end

		-- Generic Travel counts any real travel performed by our motion loop,
		-- including swimming.
		return state.questMotionMode == "Land"
			or state.questMotionMode == "Swimming"
	end

	return false
end

