function state.deathReportUI.render()
	if not state.deathReportUI.list
		or not state.deathReportUI.list.Parent then
		return
	end

	for _, child in ipairs(
		state.deathReportUI.list:GetChildren()
	) do
		if child ~= state.deathReportUI.layout
			and child ~= state.deathReportUI.padding then

			child:Destroy()
		end
	end

	local reports =
		state.slotGuardian
		and state.slotGuardian.deathReports
		or {}

	if #reports == 0 then
		local empty =
			Instance.new(
				"TextLabel"
