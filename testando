local function coinFarmAnimalSelector(parent, order)
	local wrap = Instance.new("Frame")
	wrap.Size = UDim2.new(1, 0, 0, 40)
	wrap.LayoutOrder = order or 0
	wrap.BackgroundTransparency = 1
	wrap.ClipsDescendants = true
	wrap.Parent = parent

	local main = Instance.new("TextButton")
	main.Size = UDim2.new(1, 0, 0, 40)
	main.BackgroundColor3 = COLOR_CARD
	main.BorderSizePixel = 0
	main.AutoButtonColor = false
	main.Font = FONT_BUTTON
	main.TextSize = 11
	main.TextColor3 = COLOR_TEXT
	main.TextXAlignment = Enum.TextXAlignment.Left
	main.Parent = wrap
	corner(main, 999)
	local mainStroke = stroke(main, Color3.fromRGB(48, 24, 42), 1)

	local mainPadding = Instance.new("UIPadding")
	mainPadding.PaddingLeft = UDim.new(0, 14)
	mainPadding.PaddingRight = UDim.new(0, 14)
	mainPadding.Parent = main

	local options = Instance.new("Frame")
	options.Position = UDim2.fromOffset(0, 46)
	options.Size = UDim2.new(1, 0, 0, 0)
	options.BackgroundTransparency = 1
	options.Visible = false
	options.Parent = wrap

	local optionLayout = Instance.new("UIListLayout")
	optionLayout.Padding = UDim.new(0, 5)
	optionLayout.SortOrder = Enum.SortOrder.LayoutOrder
	optionLayout.Parent = options

	local open = false

	local function renderMain()
		local selected = state.coinFarmPreferredAnimal
		main.Text = selected
			and ("AFK Coin Animal:  " .. selected .. "   ▴")
			or "AFK Coin Animal:  Current (no switch)   ▾"

		if not open and selected then
			main.Text = "AFK Coin Animal:  " .. selected .. "   ▾"
		elseif open and not selected then
			main.Text = "AFK Coin Animal:  Current (no switch)   ▴"
		end

		mainStroke.Color = selected
			and COLOR_ACCENT
			or Color3.fromRGB(48, 24, 42)
	end

	local function clearOptions()
		for _, child in ipairs(options:GetChildren()) do
			if child ~= optionLayout then
				child:Destroy()
			end
		end
	end

	local function addOption(textValue, animalName, orderIndex)
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, 0, 0, 32)
		button.LayoutOrder = orderIndex
		button.BackgroundColor3 = COLOR_CARD
		button.BorderSizePixel = 0
		button.AutoButtonColor = false
		button.Font = FONT_BODY
		button.TextSize = 11
		button.TextColor3 = COLOR_TEXT
		button.TextXAlignment = Enum.TextXAlignment.Left
		button.Text = textValue
		button.Parent = options
		corner(button, 8)
		stroke(button, Color3.fromRGB(48, 24, 42), 1)

		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0, 12)
		padding.PaddingRight = UDim.new(0, 12)
		padding.Parent = button

		button.Activated:Connect(function()
			state.coinFarmPreferredAnimal = animalName
			open = false
			options.Visible = false
			options.Size = UDim2.new(1, 0, 0, 0)
			wrap.Size = UDim2.new(1, 0, 0, 40)

			renderMain()

			if state.farmCoins then
				state.coinFarmRequestPreferredSwitch(
					"AFK Coin animal changed by player"
				)
			else
				runtimeMessage = animalName
					and (
						"AFK Coin preferred animal saved: "
						.. animalName
					)
					or "AFK Coin animal selection cleared; current animal will be kept"
			end
		end)
	end

	local function rebuildOptions()
		clearOptions()

		local animals = state.coinFarmUniqueAnimals(
			savedCharacters()
		)

		addOption(
			"Current animal (no automatic switch)",
			nil,
			1
		)

		for index, animalName in ipairs(animals) do
			addOption(
				animalName,
				animalName,
				index + 1
			)
		end

		local count = #animals + 1
		local height = count * 32
			+ math.max(0, count - 1) * 5

		options.Size = UDim2.new(1, 0, 0, height)
		wrap.Size = UDim2.new(1, 0, 0, 46 + height)
	end

	main.Activated:Connect(function()
		open = not open

		if open then
			rebuildOptions()
			options.Visible = true
		else
			options.Visible = false
			options.Size = UDim2.new(1, 0, 0, 0)
			wrap.Size = UDim2.new(1, 0, 0, 40)
		end

		renderMain()
	end)

	main.MouseEnter:Connect(function()
		main.BackgroundColor3 = COLOR_CARD_ON
	end)

	main.MouseLeave:Connect(function()
		main.BackgroundColor3 = COLOR_CARD
	end)

	renders.coinFarmAnimal = renderMain
	renderMain()

	return wrap
end

