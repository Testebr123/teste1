renders = {}

-- Any user-disabled automation must immediately surrender locomotion.
-- Safety/void/under-Terrain extraction remains authoritative because cancelling
-- those mid-transaction could strand or kill the character. Normal automation
-- routes, however, may never keep dragging the player after their toggle is OFF.
function state.cancelDisabledAutomationMovement(key)
	local safeMove = state.safeMove
	local cancelSafeMove = false
	local releaseNow = false

	if key == "autoQuests" then
		state.questTravelFullRefillReset("Auto Quests movement cancelled")
		questTravelWanted = false
		state.questTravelActive = false
		state.questLandInputActive = false
		state.questMotionMoving = false
		state.questMotionMode = nil
		state.questSwimActive = false
		state.questSwimReady = false
		state.autoRunMoveOwnsInput = false
		state.questSetW(false)

		if state.questSetLandPermanentW then
			state.questSetLandPermanentW(false)
		end

		removeSwimBarrier()

		if safeMove and safeMove.active and safeMove.reason == "quest" then
			cancelSafeMove = true
		end

		if state.heavyWalk and state.heavyWalk.owner == "autoRun" then
			pcall(state.heavyWalkStop, player.Character)
		end

		releaseNow = true

	elseif key == "growExisting"
		or key == "growAllSlots"
		or key == "growNew" then

		-- Only surrender Growth locomotion when no manual Auto Grow mode remains.
		if not state.autoGrowModeActive() then
			state.growthPride.returnRequested = false
			state.growthPride.returning = false
			state.growthTopUp.active = false
			state.growthTopUp.startedAt = nil
			state.growthTopUpResetWatch()
			preSwitchFoodTarget = nil
			preSwitchWaterTarget = nil

			if safeMove and safeMove.active
				and (safeMove.reason == "growth_home"
					or safeMove.reason == "slot_switch") then
				cancelSafeMove = true
			end

			releaseNow = true
		end

	elseif key == "farmCoins" then
		state.coinFarmSwitchPending = false
		state.coinFarmSwitchReason = nil
		if state.questGroup and state.questGroup.clearAFKHelperState then
			pcall(state.questGroup.clearAFKHelperState)
		end

		-- AFK Coin slot staging shares purpose=slot_switch with other safe staging.
		-- Cancel the current one immediately; any still-enabled Growth/Quest owner can
		-- reacquire its own route on the next scheduler pass.
		if safeMove and safeMove.active and safeMove.reason == "slot_switch" then
			cancelSafeMove = true
		end

		releaseNow = true

	elseif key == "autoEat" then
		if safeMove and safeMove.active and safeMove.reason == "food" then
			cancelSafeMove = true
		end

	elseif key == "autoDrink" then
		-- Underground Drink must finish its vertical safety exit even after OFF.
		if not (state.drinkTest and state.drinkTest.active) then
			if safeMove and safeMove.active and safeMove.reason == "water" then
				cancelSafeMove = true
			end
		end

	elseif key == "growthPrideEnabled" then
		if safeMove and safeMove.active and safeMove.reason == "growth_home" then
			cancelSafeMove = true
		end
	end

	if cancelSafeMove and safeMove then
		safeMove.cancelToken += 1
		safeMove.active = false
		safeMove.reason = nil
		releaseNow = true
	end

	if releaseNow then
		state.releaseMovementNow(player.Character, true)
	end
end

function state.coinFarmTryAutoQuestRestart(source)
	if isDinoLife then
		state.coinFarmAllowAutoQuests = false
		state.autoQuests = false
		return false
	end

	if not state.alive
		or not state.coinFarmAllowAutoQuests
		or state.autoQuests
		or not state.farmCoins
		or (
			state.questGrowthReset
			and state.questGrowthReset.exclusive
		) then
		return false
	end

	local quests = getAllQuests()
	local records = savedCharacters()
	local ok, hasPending = pcall(
		state.questHasActionablePending,
		quests,
		records
	)

	if not ok or not hasPending then
		if source == "toggle" then
			runtimeMessage =
				"Auto Quest restart watcher enabled; waiting for an actionable Daily/Weekly quest"
		end
		return false
	end

	state.farmCoins = false
	state.growExisting = false
	state.growExistingAutomaticAll = false
	state.growAllSlots = false
	state.growNew = false
	state.questPostGrowAll = false
	state.questSeenAny = true
	state.questEmptyScans = 0
	state.autoQuests = true
	state.questActionablePending = true
	state.questMovementPriorityPending = true
	state.questZonePriority.active = false
	state.questZonePriority.zone = nil
	state.questZonePriority.resolved = false
	state.questForceFastRecheckUntil = tick() + 20
	state.applySurvivalDefaults(false)

	questStatusText =
		"Actionable quest found -> Auto Quests restarted"
	runtimeMessage =
		"AFK Coin watcher: actionable Daily/Weekly quest detected; Auto Quests restarted"

	if renders then
		for _, renderKey in ipairs({
			"farmCoins", "growExisting", "growAllSlots", "growNew",
			"autoQuests", "autoEat", "autoDrink",
			"coinFarmAllowAutoQuests"
		}) do
			if renders[renderKey] then
				renders[renderKey]()
			end
		end
	end

	return true
end

local function toggle(parent, label, key, order)
	local row = Instance.new("TextButton")
	row.Size = UDim2.new(1, 0, 0, UserInputService.TouchEnabled and 50 or 44)
	row.LayoutOrder = order or 0
	row.BackgroundColor3 = COLOR_CARD
	row.BorderSizePixel = 0
	row.ClipsDescendants = true
	row.Text = ""
	row.AutoButtonColor = false
	row.Parent = parent
	corner(row, 999) -- Roblox limita automaticamente à metade da altura -> pílula completa nas duas pontas
	local rowStroke = stroke(row, Color3.fromRGB(48, 24, 42), 1)

	local labelText = Instance.new("TextLabel")
	labelText.Size = UDim2.new(1, -58, 1, 0)
	labelText.Position = UDim2.fromOffset(14, 0)
	labelText.BackgroundTransparency = 1
	labelText.Font = FONT_BUTTON
	labelText.Text = label
	labelText.TextSize =
		UserInputService.TouchEnabled
			and 13
			or 14
	labelText.TextColor3 = COLOR_TEXT
	labelText.TextXAlignment = Enum.TextXAlignment.Left
	labelText.TextYAlignment = Enum.TextYAlignment.Center
	labelText.TextWrapped = true
	labelText.LineHeight = 1.0
	labelText.Parent = row

	-- Switch de verdade (trilho + bolinha), em vez de um botão que só muda
	-- de cor — a bolinha desliza e fecha redonda nas duas pontas.
	local track = Instance.new("Frame")
	track.Size = UDim2.fromOffset(38, 20)
	track.AnchorPoint = Vector2.new(1, 0.5)
	track.Position = UDim2.new(1, -14, 0.5, 0)
	track.BackgroundColor3 = Color3.fromRGB(50, 27, 44)
	track.BorderSizePixel = 0
	track.Parent = row
	corner(track, 10)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(16, 16)
	knob.Position = UDim2.fromOffset(2, 2)
	knob.BackgroundColor3 = Color3.fromRGB(220, 224, 230)
	knob.BorderSizePixel = 0
	knob.Parent = track
	corner(knob, 8)

	local disabledMark = Instance.new("TextLabel")
	disabledMark.Size = UDim2.new(1, 0, 1, 0)
	disabledMark.Position = UDim2.fromOffset(0, 0)
	disabledMark.BackgroundTransparency = 1
	disabledMark.Font = Enum.Font.GothamBlack
	disabledMark.Text = "X"
	disabledMark.TextSize = 12
	disabledMark.TextColor3 = COLOR_ACCENT
	disabledMark.TextXAlignment = Enum.TextXAlignment.Center
	disabledMark.TextYAlignment = Enum.TextYAlignment.Center
	disabledMark.Visible = false
	disabledMark.ZIndex = 3
	disabledMark.Parent = track

	local hovering = false

	local function prideDisabledForCurrentAnimal()
		return key == "growthPrideEnabled"
			and isCarnivoreCharacter(
				player.Character
					or workspace:FindFirstChild(
						player.Name
					)
			)
	end

	local function dinoGrowAllUnsupported()
		return isDinoLife
			and key == "growAllSlots"
	end

	local function applyVisual()
		local disabled =
			prideDisabledForCurrentAnimal()
			or dinoGrowAllUnsupported()

		local on =
			state[key]
			and not disabled

		if disabled then
			row.BackgroundColor3 = Color3.fromRGB(23, 16, 21)
			rowStroke.Color = Color3.fromRGB(55, 38, 49)
		elseif on then
			row.BackgroundColor3 = COLOR_CARD_ON
			rowStroke.Color = COLOR_ACCENT
		elseif hovering then
			row.BackgroundColor3 = Color3.fromRGB(38, 20, 34)
			rowStroke.Color = Color3.fromRGB(70, 34, 58)
		else
			row.BackgroundColor3 = COLOR_CARD
			rowStroke.Color = Color3.fromRGB(48, 24, 42)
		end
	end

	local function render()
		local disabled =
			prideDisabledForCurrentAnimal()
			or dinoGrowAllUnsupported()

		local on =
			state[key]
			and not disabled

		if key == "growExisting" then
			labelText.Text =
				on and state.growExistingAutomaticAll
				and "Grow Existing Slots  [AUTO: ALL ANIMALS]"
				or label
			labelText.TextSize =
				on and state.growExistingAutomaticAll
					and (
						UserInputService.TouchEnabled
							and 11
							or 12
					)
					or (
						UserInputService.TouchEnabled
							and 12
							or 13
					)
		end

		if key == "coinFarmAllowAutoQuests"
			or key == "growthPrideEnabled" then
			labelText.TextSize =
				UserInputService.TouchEnabled
					and 12
					or 13
		end

		if dinoGrowAllUnsupported() then
			labelText.Text =
				"Grow All Slots · Não suportado no Dino Life"
			labelText.TextSize =
				UserInputService.TouchEnabled
					and 11
					or 12
		end

		if disabled then
			labelText.TextColor3 =
				Color3.fromRGB(
					112,
					94,
					105
				)

			track.BackgroundColor3 =
				Color3.fromRGB(
					34,
					25,
					31
				)

			knob.Visible =
				false

			disabledMark.Visible =
				true
		else
			labelText.TextColor3 =
				on
					and COLOR_ACCENT
					or COLOR_TEXT

			knob.Visible =
				true

			disabledMark.Visible =
				false

			TweenService:Create(
				track,
				TweenInfo.new(
					0.15,
					Enum.EasingStyle.Quad
				),
				{
					BackgroundColor3 =
						on
							and COLOR_ACCENT
							or Color3.fromRGB(
								50,
								27,
								44
							),
				}
			):Play()

			TweenService:Create(
				knob,
				TweenInfo.new(
					0.15,
					Enum.EasingStyle.Quad
				),
				{
					Position =
						on
							and UDim2.fromOffset(
								20,
								2
							)
							or UDim2.fromOffset(
								2,
								2
							),
				}
			):Play()
		end

		applyVisual()
	end
	renders[key] = render
	row.MouseEnter:Connect(function() hovering = true; applyVisual() end)
	row.MouseLeave:Connect(function() hovering = false; applyVisual() end)
	row.Activated:Connect(function()
		if dinoGrowAllUnsupported() then
			state.growAllSlots = false
			runtimeMessage =
				"Grow All Slots não é suportado no Dino Life"
			render()
			return
		end

		if state.slotParkingAudit
			and state.slotParkingAudit.active
			and (
				key == "farmCoins"
				or key == "growExisting"
				or key == "growAllSlots"
				or key == "growNew"
				or key == "autoQuests"
			) then

			-- Manual input always outranks final parking. A broken audit must never
			-- force the user to restart Roblox just to regain the controls.
			if state.slotParkingAuditAbort then
				state.slotParkingAuditAbort(
					"Final parking cancelled by user; controls unlocked"
				)
			end
		end

		if isDinoLife
			and (
				key == "autoQuests"
				or key == "autoClaimQuests"
				or key == "coinFarmAllowAutoQuests"
			) then

			state[key] = false
			runtimeMessage = "Quest automation is unavailable in Dino Life"
			render()
			return
		end

		if key == "growthPrideEnabled"
			and prideDisabledForCurrentAnimal() then

			runtimeMessage =
				"Pride Rock Growth is unavailable for carnivores"

			render()
			return
		end

		if (
			key == "autoEat"
			or key == "autoDrink"
		)
			and state.aquaticRiverEscape
			and state.aquaticRiverEscape.survivalSuspended then

			state[key] = false
			render()

			runtimeMessage =
				"Water Fly active: Auto Eat/Drink locked OFF until exit"

			return
		end

		state[key] = not state[key]

		if state.MMBAI and type(state.MMBAI.OnUserIntentChanged) == "function" then
			pcall(
				state.MMBAI.OnUserIntentChanged,
				state.MMBAI,
				key,
				state[key]
			)
		end

		if not state[key]
			and state.cancelDisabledAutomationMovement then
			pcall(state.cancelDisabledAutomationMovement, key)
		end

		if key == "antiLag" then
			if state[key] then
				state.antiLagEnable(false)
			else
				state.antiLagDisable(false)
			end
		end

		if key == "autoEat" then
			state.autoEatManualDisabled = not state[key]
		elseif key == "autoDrink" then
			state.autoDrinkManualDisabled = not state[key]
		end

		if key == "coinFarmAllowAutoQuests" then
			if state[key] then
				runtimeMessage =
					state.farmCoins
					and "Auto Quest restart watcher enabled; checking AFK Coin quests now"
					or "Auto Quest restart watcher enabled for the next AFK Coin session"

				if state.farmCoins then
					task.spawn(function()
						task.wait(0.05)
						pcall(
							state.coinFarmTryAutoQuestRestart,
							"toggle"
						)
					end)
				end
			else
				runtimeMessage =
					"Auto Quest restart watcher disabled"
			end
		end

		if key == "autoEat" and not state[key] then
			eatingToFull = false
			clearActiveCarcass(true)
			state.questCarnivoreFeeding = false
			state.questBaboonFeeding = false
			state.questGiraffeFeeding = false

			BABOON.cancel()
			GIRAFFE.cancel()

			if state.safeMove.active
				and state.safeMove.reason == "food" then
				state.safeMove.cancelToken += 1
			end

			state.releaseMovementNow(player.Character, true)
			runtimeMessage =
				"Auto Eat disabled; current food route cancelled"
		end

		if key == "autoDrink"
			and not state[key] then

			if state.drinkTest
				and state.drinkTest.active then

				-- Turning Auto Drink off must NEVER abandon the animal below
				-- Terrain. The backend interprets this as a safe vertical exit.
				state.drinkTest.cancelRequested =
					true

				runtimeMessage =
					"Auto Drink disabled; Underground Drink is exiting vertically"
			else
				drinkingToFull = false
				drinkingSourcePosition = nil
				drinkingStuckSince = nil
				lastDrinkWatchdogWater = nil
				state.drinkProgressReset()

				if state.safeMove.active
					and state.safeMove.reason == "water" then

					state.safeMove.cancelToken += 1
				end

				state.releaseMovementNow(player.Character, true)
				runtimeMessage =
					"Auto Drink disabled; current water route cancelled"
			end
		end

		-- User interaction always means a MANUAL Growth mode.
		if key == "growExisting" then
			state.growExistingAutomaticAll = false
			if state[key] then
				state.growAllSlots = false
				state.growNew = false
			end

		elseif key == "growAllSlots" and state[key] then
			state.growExistingAutomaticAll = false
			state.growExisting = false
			state.growNew = false
			questStatusText = "Grow All Slots: ALL animal species"
			runtimeMessage =
				"Grow All Slots active: growing every existing slot below 100% across all animals"

		elseif key == "growNew" and state[key] then
			state.growAllSlots = false
			state.growExisting = false
		end

		if key == "growthPrideEnabled" then
			state.growthPrideUserSet =
				true

			if not state[key] then
				state.growthPride.returnRequested = false
				state.growthPride.returning = false

				if state.safeMove
					and state.safeMove.active
					and state.safeMove.reason == "growth_home" then
					state.safeMove.cancelToken += 1
				end

				state.releaseMovementNow(
					player.Character,
					true
				)

				runtimeMessage =
					"Pride Rock Growth home disabled by player"
			else
				runtimeMessage =
					"Pride Rock Growth home enabled (recommended)"
			end
		end

		if key == "farmCoins" and state[key] then
			state.coinFarmCharacterMissingSince = nil
			state.coinFarmMenuRecovering = false
			state.coinFarmMenuRetryAt = 0
			state.coinFarmRememberCurrentSlot()

			local questsWereActive = state.autoQuests == true
			local growWasActive = state.autoGrowModeActive()

			state.questPostGrowAll = false
			state.growExistingAutomaticAll = false
			state.growAllSlots = false
			state.growExisting, state.growNew, state.autoQuests = false, false, false

			if questsWereActive and state.cancelDisabledAutomationMovement then
				pcall(state.cancelDisabledAutomationMovement, "autoQuests")
			end
			if growWasActive and state.cancelDisabledAutomationMovement then
				pcall(state.cancelDisabledAutomationMovement, "growExisting")
			end

			state.enableSurvivalForAutomation(
				"AFK Coin Farm"
			)
			runtimeMessage = state.coinFarmPreferredAnimal
				and (
					"AFK Coin Farm active; preferred animal queued: "
					.. state.coinFarmPreferredAnimal
				)
				or "AFK Coin Farm active; current animal will be kept"
		elseif (
			key == "growExisting"
			or key == "growAllSlots"
			or key == "growNew"
		) and state[key] then
			local farmCoinsWasActive = state.farmCoins == true
			state.questPostGrowAll = false
			state.growExistingAutomaticAll = false
			state.farmCoins = false

			-- Growth must always carry its Survival dependencies across the handoff,
			-- especially after Auto Quests finished/parking was aborted.
			state.prepareGrowthAutomationHandoff(
				key == "growNew"
					and "Grow New Slots"
					or key == "growAllSlots"
						and "Grow All Slots"
						or "Grow Existing Slots"
			)

			if farmCoinsWasActive and state.cancelDisabledAutomationMovement then
				pcall(state.cancelDisabledAutomationMovement, "farmCoins")
			end

			-- Auto Grow and Auto Quests are now intentionally concurrent. Turning Grow
			-- on must NEVER turn quests off, clear their destination, or discard Swim/Zone.
			if state.autoQuests then
				state.questSeenAny = false
				state.questEmptyScans = 0
				state.questZoneLastMoveAt = 0
				state.questZoneLastTarget = nil
				state.questForceFastRecheckUntil = tick() + 25

				if state.autoGrowCurrentSlotComplete(player.Character) then
					questStatusText = "Growth 100%: returning to Reset Point before quests continue"
					runtimeMessage = "Auto Grow + Auto Quests active: current 100% slot must switch first"
				else
					questStatusText = "Auto Grow + Auto Quests: Zone/Swim/Run/Group parallel"
					runtimeMessage = "Parallel mode active: growing slot continues available location quests"
				end
			end

		elseif key == "autoQuests" and state[key] then
			local alreadyGrowing = state.autoGrowModeActive()

			-- The old code forced questMovementPriorityPending=true until the first
			-- full scan. That recreated the same passive-Survive carcass deadlock.
			-- Keep lifecycle pessimism on questActionablePending, but movement
			-- ownership itself must come from a real quest snapshot.
			state.questActionablePending = true
			state.questMovementPriorityPending = false
			state.questMovementPriorityVerified = false
			state.questMovementPriorityLastSnapshotAt = 0
			state.questZonePriority.active = false
			state.questZonePriority.zone = nil
			state.questZonePriority.resolved = alreadyGrowing == true
			state.questSeenAny = false
			state.questEmptyScans = 0
			state.questGroup.difficultySince = nil

			local farmCoinsWasActive = state.farmCoins == true
			state.farmCoins = false
			if farmCoinsWasActive and state.cancelDisabledAutomationMovement then
				pcall(state.cancelDisabledAutomationMovement, "farmCoins")
			end

			-- Auto Quests-only Growth is allowed to progress anywhere while Run/Group
			-- work. Kill a growth_home SafeMove that may have been started by the
			-- background Growth loop immediately before this toggle.
			if not alreadyGrowing then
				state.growthPride.returnRequested = false
				state.growthPride.returning = false

				if state.safeMove
					and state.safeMove.active
					and state.safeMove.reason == "growth_home" then

					state.safeMove.cancelToken += 1
					state.releaseMovementNow(player.Character, true)
				end
			end

			-- If Auto Eat was passively eating before quests were enabled, release it
			-- immediately when hunger is already above the real quest threshold. A
			-- genuine low-food quest feeding cycle will be reacquired by the scan.
			local questCharacter = player.Character
			if questCharacter and not preSwitchFoodTarget then
				local questFood =
					tonumber(questCharacter:GetAttribute("Food")) or 100

				local questCarnivore = isCarnivoreCharacter(questCharacter)
				local comfortableThreshold = 70

				if questFood > comfortableThreshold then
					state.questCarnivoreFeeding = false
					state.questBaboonFeeding = false
					state.questGiraffeFeeding = false
					eatingToFull = false
					eatingSourcePosition = nil
					eatingTargetReachedAt = nil
					eatingStuckSince = nil
					BABOON.cancel()
					GIRAFFE.cancel()
					state.survivalArbiterComplete("food")

					if questCarnivore then
						clearActiveCarcass(true)
					end
				end
			end

			if criticalRecoveryActive
				and state.questReleaseStaleRecoveryLock then
				pcall(state.questReleaseStaleRecoveryLock)
			end

			state.questForceFastRecheckUntil = tick() + 20
			state.enableSurvivalForAutomation(
				"Auto Quests"
			)

			mmbTaskDefer(function()
				task.wait(0.05)

				if state.autoQuests
					and state.questRefreshMovementPrioritySnapshot then

					pcall(
						state.questRefreshMovementPrioritySnapshot,
						true
					)

					-- Passive-only quest set: resume carcass logic immediately.
					if state.questMovementPriorityPending ~= true
						and state.autoEat then

						pcall(
							autoEatStep
						)
					end
				end
			end)

			if alreadyGrowing then
				state.questZonePriority.active = false
				state.questZonePriority.zone = nil
				state.questZonePriority.resolved = false
				state.questZoneLastMoveAt = 0
				state.questZoneLastTarget = nil

				-- If Growth was previously walking an incomplete herbivore home, Quests
				-- now own travel. A 100% slot is the only exception: it must stage/switch.
				if not state.autoGrowCurrentSlotComplete(player.Character)
					and state.safeMove
					and state.safeMove.active
					and state.safeMove.reason == "growth_home" then
					state.safeMove.cancelToken += 1
					state.releaseMovementNow(player.Character, true)
				end

				questStatusText = "Auto Grow + Auto Quests: Zone/Swim/Run/Group parallel"
				runtimeMessage = "Auto Quests joined Auto Grow: location and Swim quests enabled"
			else
				state.questPostGrowAll = false
				questStatusText = "Scanning Daily + Weekly quests"
				runtimeMessage = "Auto Quests active"
			end
		elseif key == "autoQuests" and not state[key] then
			state.questTravelFullRefillReset("Auto Quests disabled")
			state.questActionablePending = false
			state.questMovementPriorityPending = false
			state.questMovementPriorityVerified = true
			state.questMovementPriorityLastSnapshotAt = tick()
			state.questZonePriority.active = false
			state.questZonePriority.zone = nil
			state.questZonePriority.resolved = true
			state.questClearReturnZone()
			questTravelWanted = false
			state.questTravelActive = false
			state.questLandInputActive = false
			state.questSetW(false)
			state.releaseMovementNow(player.Character, true)
			state.questLandWWatchReset()
			state.questSwimActive = false
			state.questSwimReady = false
			questTargetZoneName = nil
			questStatusText = "Ready"
		elseif key == "autoClaimQuests" then
			questStatusText = state[key] and "Auto Claim active" or "Ready"
		end
		for _, changedKey in ipairs({
			key, "farmCoins", "coinFarmAllowAutoQuests",
			"growExisting", "growAllSlots", "growNew", "growthPrideEnabled",
			"autoQuests", "autoClaimQuests", "autoEat", "autoDrink"
		}) do
			if renders[changedKey] then renders[changedKey]() end
		end
	end)
	render()
	return row
end

local function sectionLabel(parent, text, order)
	local wrap = Instance.new("Frame")
	wrap.Size = UDim2.new(1, 0, 0, 18)
	wrap.LayoutOrder = order or 0
	wrap.BackgroundTransparency = 1
	wrap.Parent = parent

	local mark = Instance.new("Frame")
	mark.Size = UDim2.fromOffset(3, 11)
	mark.Position = UDim2.new(0, 0, 0.5, -5)
	mark.BackgroundColor3 = COLOR_ACCENT
	mark.BorderSizePixel = 0
	mark.Parent = wrap
	corner(mark, 2)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -10, 1, 0)
	label.Position = UDim2.fromOffset(9, 0)
	label.BackgroundTransparency = 1
	label.Font = FONT_BUTTON
	label.Text = text
	label.TextColor3 = COLOR_SUBTEXT
	label.TextSize =
		UserInputService.TouchEnabled
			and 11
			or 12
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = wrap
	return wrap
end


local function coinFarmAnimalSelector(parent, order)
	local wrap = Instance.new("Frame")
	wrap.Size = UDim2.new(1, 0, 0, 40)
	wrap.LayoutOrder = order or 0
	wrap.BackgroundTransparency = 1
	wrap.ClipsDescendants = true
	wrap.Parent = parent

	local main = Instance.new("TextButton")
	main.Size = UDim2.new(1, 0, 0, 40)
	main.BackgroundColor3 = COLOR_CARD
	main.BorderSizePixel = 0
	main.AutoButtonColor = false
	main.Font = FONT_BUTTON
	main.TextSize =
		UserInputService.TouchEnabled
			and 13
			or 14
	main.TextColor3 = COLOR_TEXT
	main.TextXAlignment = Enum.TextXAlignment.Left
	main.Parent = wrap
	corner(main, 999)
	local mainStroke = stroke(main, Color3.fromRGB(48, 24, 42), 1)

	local mainPadding = Instance.new("UIPadding")
	mainPadding.PaddingLeft = UDim.new(0, 14)
	mainPadding.PaddingRight = UDim.new(0, 14)
	mainPadding.Parent = main

	local options = Instance.new("Frame")
	options.Position = UDim2.fromOffset(0, 46)
	options.Size = UDim2.new(1, 0, 0, 0)
	options.BackgroundTransparency = 1
	options.Visible = false
	options.Parent = wrap

	local optionLayout = Instance.new("UIListLayout")
	optionLayout.Padding = UDim.new(0, 5)
	optionLayout.SortOrder = Enum.SortOrder.LayoutOrder
	optionLayout.Parent = options

	local open = false

	local function renderMain()
		local selected = state.coinFarmPreferredAnimal
		main.Text = selected
			and ("AFK Coin Animal:  " .. selected .. "   ▴")
			or "AFK Coin Animal:  Current (no switch)   ▾"

		if not open and selected then
			main.Text = "AFK Coin Animal:  " .. selected .. "   ▾"
		elseif open and not selected then
			main.Text = "AFK Coin Animal:  Current (no switch)   ▴"
		end

		mainStroke.Color = selected
			and COLOR_ACCENT
			or Color3.fromRGB(48, 24, 42)
	end

	local function clearOptions()
		for _, child in ipairs(options:GetChildren()) do
			if child ~= optionLayout then
				child:Destroy()
			end
		end
	end

	local function addOption(textValue, animalName, orderIndex)
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, 0, 0, 32)
		button.LayoutOrder = orderIndex
		button.BackgroundColor3 = COLOR_CARD
		button.BorderSizePixel = 0
		button.AutoButtonColor = false
		button.Font = FONT_BODY
		button.TextSize =
			UserInputService.TouchEnabled
				and 13
				or 14
		button.TextColor3 = COLOR_TEXT
		button.TextXAlignment = Enum.TextXAlignment.Left
		button.Text = textValue
		button.Parent = options
		corner(button, 8)
		stroke(button, Color3.fromRGB(48, 24, 42), 1)

		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0, 12)
		padding.PaddingRight = UDim.new(0, 12)
		padding.Parent = button

		button.Activated:Connect(function()
			state.coinFarmPreferredAnimal = animalName
			open = false
			options.Visible = false
			options.Size = UDim2.new(1, 0, 0, 0)
			wrap.Size = UDim2.new(1, 0, 0, 40)

			renderMain()

			if state.farmCoins then
				state.coinFarmRequestPreferredSwitch(
					"AFK Coin animal changed by player"
				)
			else
				runtimeMessage = animalName
					and (
						"AFK Coin preferred animal saved: "
						.. animalName
					)
					or "AFK Coin animal selection cleared; current animal will be kept"
			end
		end)
	end

	local function rebuildOptions()
		clearOptions()

		local animals = state.coinFarmUniqueAnimals(
			savedCharacters()
		)

		addOption(
			"Current animal (no automatic switch)",
			nil,
			1
		)

		for index, animalName in ipairs(animals) do
			addOption(
				animalName,
				animalName,
				index + 1
			)
		end

		local count = #animals + 1
		local height = count * 32
			+ math.max(0, count - 1) * 5

		options.Size = UDim2.new(1, 0, 0, height)
		wrap.Size = UDim2.new(1, 0, 0, 46 + height)
	end

	main.Activated:Connect(function()
		open = not open

		if open then
			rebuildOptions()
			options.Visible = true
		else
			options.Visible = false
			options.Size = UDim2.new(1, 0, 0, 0)
			wrap.Size = UDim2.new(1, 0, 0, 40)
		end

		renderMain()
	end)

	main.MouseEnter:Connect(function()
		main.BackgroundColor3 = COLOR_CARD_ON
	end)

	main.MouseLeave:Connect(function()
		main.BackgroundColor3 = COLOR_CARD
	end)

	renders.coinFarmAnimal = renderMain
	renderMain()

	return wrap
end

