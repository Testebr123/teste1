function state.mainWaterPartInfo(root)
	if not root then
		return nil
	end

	local waterPart =
		workspace:FindFirstChild(
			"MainWaterPart"
		)

	if not waterPart
		or not waterPart:IsA(
			"BasePart"
		) then
		return nil
	end

	local localPosition =
		waterPart.CFrame:PointToObjectSpace(
			root.Position
		)

	local halfX =
		waterPart.Size.X * 0.5

	local halfY =
		waterPart.Size.Y * 0.5

	local halfZ =
		waterPart.Size.Z * 0.5

	local insideXZ =
		math.abs(localPosition.X)
			<= halfX
		and math.abs(localPosition.Z)
			<= halfZ

	-- Water top at the current local X/Z. This also remains valid if the part
	-- is ever slightly rotated instead of perfectly axis-aligned.
	local topPoint =
		waterPart.CFrame:PointToWorldSpace(
			Vector3.new(
				localPosition.X,
				halfY,
				localPosition.Z
			)
		)

	return {
		part = waterPart,
		localPosition = localPosition,
		halfX = halfX,
		halfY = halfY,
		halfZ = halfZ,
		insideXZ = insideXZ,
		topY = topPoint.Y,
	}
end

function state.isUnderMainWaterPart(root)
	local info =
		state.mainWaterPartInfo(
			root
		)

	if not info then
		return false,
			nil
	end

	-- The intentionally simple rule requested for Croc/Hippo:
	-- if the water part is horizontally over us and its top is above the HRP,
	-- we are in the water-exit condition.
	local under =
		info.insideXZ
		and info.topY
			> root.Position.Y + 0.10

	return under,
		info
end

function state.mainWaterDryBankReached(
	character,
	root,
	waterPart
)
	if not character
		or not root then
		return false
	end

	waterPart =
		waterPart
		or workspace:FindFirstChild(
			"MainWaterPart"
		)

	if not waterPart
		or not waterPart:IsA(
			"BasePart"
		) then
		return false
	end

	local localPosition =
		waterPart.CFrame:PointToObjectSpace(
			root.Position
		)

	local halfY =
		waterPart.Size.Y * 0.5

	local topWorld =
		waterPart.CFrame:PointToWorldSpace(
			Vector3.new(
				localPosition.X,
				halfY,
				localPosition.Z
			)
		)

	-- IMPORTANT: cast against the REAL world, not Terrain-only.
	-- The first collidable support under the animal MUST itself be Terrain.
	-- Therefore Rock3Var3 / MeshParts / Parts / models can never be accepted
	-- as a valid aquatic exit even if there is Terrain somewhere below them.
	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {
		character,
		waterPart,
	}

	params.IgnoreWater = true

	pcall(function()
		params.RespectCanCollide =
			true
	end)

	local hit =
		workspace:Raycast(
			root.Position
				+ Vector3.new(
					0,
					8,
					0
				),
			Vector3.new(
				0,
				-24,
				0
			),
			params
		)

	if not hit
		or hit.Instance
			~= workspace.Terrain
		or hit.Material
			== Enum.Material.Water
		or hit.Normal.Y < 0.10 then
		return false
	end

	return hit.Position.Y
		>= topWorld.Y - 0.35
end


function state.aquaticTerrainBankCandidateClear(
	character,
	root,
	waterPart,
	terrainHit,
	rootOffset
)
	if not character
		or not root
		or not waterPart
		or not terrainHit
		or terrainHit.Instance
			~= workspace.Terrain then

		return false
	end

	local terrainLocal =
		waterPart.CFrame:PointToObjectSpace(
			terrainHit.Position
		)

	local waterTop =
		waterPart.CFrame:PointToWorldSpace(
			Vector3.new(
				terrainLocal.X,
				waterPart.Size.Y * 0.5,
				terrainLocal.Z
			)
		)

	-- Underwater Terrain (even a steep hill) is not a bank.
	if terrainHit.Position.Y
		< waterTop.Y - 0.35 then
		return false
	end

	-- Validate ONLY the landing column. The first real collidable support at
	-- this X/Z must be Terrain. Thus Rock3Var3 / MeshPart / Part sitting on top
	-- of the Terrain is rejected, without rejecting a perfectly valid bank just
	-- because some unrelated object exists along the underwater travel line.
	local supportParams =
		RaycastParams.new()

	supportParams.FilterType =
		Enum.RaycastFilterType.Exclude

	supportParams.FilterDescendantsInstances = {
		character,
		waterPart,
	}

	supportParams.IgnoreWater = true

	pcall(function()
		supportParams.RespectCanCollide =
			true
	end)

	local supportOrigin =
		terrainHit.Position
			+ Vector3.new(
				0,
				math.max(
					14,
					rootOffset + 8
				),
				0
			)

	local support =
		workspace:Raycast(
			supportOrigin,
			Vector3.new(
				0,
				-math.max(
					24,
					rootOffset + 16
				),
				0
			),
			supportParams
		)

	if not support
		or support.Instance
			~= workspace.Terrain
		or support.Material
			== Enum.Material.Water then

		return false
	end

	return math.abs(
		support.Position.Y
			- terrainHit.Position.Y
	) <= 1.5
end

function state.findNearbyMainWaterBankTarget(
	character,
	root,
	preferredTarget
)
	local under, info =
		state.isUnderMainWaterPart(
			root
		)

	if not info then
		return nil
	end

	local waterPart =
		info.part

	-- Same rule that worked for Croc: Terrain below the water plane is river
	-- bottom / underwater hill and is NEVER a valid exit bank.
	local waterTopY =
		info.topY

	local baseDirection

	if typeof(preferredTarget)
		== "Vector3" then

		baseDirection =
			Vector3.new(
				preferredTarget.X
					- root.Position.X,
				0,
				preferredTarget.Z
					- root.Position.Z
			)
	end

	if not baseDirection
		or baseDirection.Magnitude
			< 0.1 then

		baseDirection =
			root.CFrame.LookVector

		baseDirection =
			Vector3.new(
				baseDirection.X,
				0,
				baseDirection.Z
			)
	end

	if baseDirection.Magnitude
		< 0.1 then

		baseDirection =
			Vector3.new(
				1,
				0,
				0
			)
	else
		baseDirection =
			baseDirection.Unit
	end

	local function rotated(
		direction,
		degrees
	)
		local angle =
			math.rad(
				degrees
			)

		local cosA =
			math.cos(
				angle
			)

		local sinA =
			math.sin(
				angle
			)

		return Vector3.new(
			direction.X * cosA
				- direction.Z * sinA,
			0,
			direction.X * sinA
				+ direction.Z * cosA
		)
	end

	-- Prefer the requested route direction, then progressively fan around it.
	local directions = {}

	for _, degrees in ipairs({
		0,
		45,
		-45,
		90,
		-90,
		135,
		-135,
		180,
	}) do

		table.insert(
			directions,
			rotated(
				baseDirection,
				degrees
			)
		)
	end

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Include

	params.FilterDescendantsInstances = {
		workspace.Terrain,
	}

	params.IgnoreWater = true

	-- Use the animal's REAL root-to-body clearance. The previous 0.24x
	-- value placed a Hippo HRP almost inside the Terrain and could make the
	-- positional controller look completely stuck.
	local clearance =
		state.aquaticWaterStandOffset(
			character
		)

	-- One-time, progressive local scan. It stops on the FIRST radius that has
	-- any usable bank, so nearby rises win over distant MainWaterPart edges.
	for _, radius in ipairs({
		12,
		22,
		36,
		54,
		78,
		108,
	}) do

		local best
		local bestScore =
			math.huge

		for directionIndex,
			direction in ipairs(
				directions
			) do

			local candidateXZ =
				root.Position
				+ direction
					* radius

			local hit =
				workspace:Raycast(
					Vector3.new(
						candidateXZ.X,
						math.max(
							info.topY,
							root.Position.Y
						) + 28,
						candidateXZ.Z
					),
					Vector3.new(
						0,
						-56,
						0
					),
					params
				)

			if hit
				and hit.Instance
					== workspace.Terrain
				and hit.Material
					~= Enum.Material.Water
				and hit.Normal.Y
					>= 0.10
				and hit.Position.Y
					>= waterTopY - 0.35
				and state.aquaticTerrainBankCandidateClear(
					character,
					root,
					waterPart,
					hit,
					clearance
				) then

				local heightPenalty =
					math.max(
						0,
						hit.Position.Y
							- waterTopY
					) * 0.08

				local directionPenalty =
					(directionIndex - 1)
						* 0.08

				local score =
					radius
					+ heightPenalty
					+ directionPenalty

				if score < bestScore then
					bestScore =
						score

					best =
						hit.Position
						+ Vector3.new(
							0,
							clearance,
							0
						)
				end
			end
		end

		if best then
			return best
		end
	end

	-- Wider sparse fallback for large Hippo bodies / broad river sections.
	-- This runs only if the near scan found nothing.
	for _, radius in ipairs({
		145,
		180,
	}) do

		for _,
			direction in ipairs(
				directions
			) do

			local candidateXZ =
				root.Position
				+ direction
					* radius

			local hit =
				workspace:Raycast(
					Vector3.new(
						candidateXZ.X,
						root.Position.Y + 110,
						candidateXZ.Z
					),
					Vector3.new(
						0,
						-240,
						0
					),
					params
				)

			if hit
				and hit.Instance
					== workspace.Terrain
				and hit.Material
					~= Enum.Material.Water
				and hit.Normal.Y
					>= 0.10
				and hit.Position.Y
					>= waterTopY - 0.35
				and state.aquaticTerrainBankCandidateClear(
					character,
					root,
					waterPart,
					hit,
					clearance
				) then

				return hit.Position
					+ Vector3.new(
						0,
						clearance,
						0
					)
			end
		end
	end

	return nil
end

function state.mainWaterNearestExitTarget(
	character,
	root
)
	local under, info =
		state.isUnderMainWaterPart(
			root
		)

	if not under or not info then
		return nil,
			info
	end

	local p =
		info.localPosition

	-- Nearest rectangle edge, no raycasts.
	local options = {
		{
			distance = info.halfX - p.X,
			axis = "x",
			sign = 1,
		},
		{
			distance = info.halfX + p.X,
			axis = "x",
			sign = -1,
		},
		{
			distance = info.halfZ - p.Z,
			axis = "z",
			sign = 1,
		},
		{
			distance = info.halfZ + p.Z,
			axis = "z",
			sign = -1,
		},
	}

	local nearest =
		options[1]

	for index = 2, #options do
		if options[index].distance
			< nearest.distance then
			nearest =
				options[index]
		end
	end

	local footprint =
		character
		and state.movementFootprint(
			character
		)
		or 8

	-- Go a few studs beyond the water-part edge so UNFLY does not happen on
	-- the exact boundary.
	local outsideMargin =
		math.clamp(
			footprint * 0.14,
			2.5,
			4
		)

	local lift =
		math.clamp(
			state.movementRootClearance(
				character
			) * 0.24,
			0.65,
			1.65
		)

	local targetX =
		math.clamp(
			p.X,
			-info.halfX,
			info.halfX
		)

	local targetZ =
		math.clamp(
			p.Z,
			-info.halfZ,
			info.halfZ
		)

	if nearest.axis == "x" then
		targetX =
			nearest.sign
			* (
				info.halfX
				+ outsideMargin
			)
	else
		targetZ =
			nearest.sign
			* (
				info.halfZ
				+ outsideMargin
			)
	end

	local localTarget =
		Vector3.new(
			targetX,
			info.halfY + lift,
			targetZ
		)

	return info.part.CFrame:PointToWorldSpace(
		localTarget
	),
		info
end

function state.mainWaterExitReached(
	root,
	waterPart,
	character
)
	if not root
		or not waterPart
		or not waterPart.Parent then
		return false
	end

	character =
		character
		or root.Parent

	if not character then
		return false
	end

	return state.mainWaterDryBankReached(
		character,
		root,
		waterPart
	)
end

function state.aquaticFlyDryGroundReached(
	character,
	root,
	_unusedWaterY
)
	if not character or not root then
		return false
	end

	local info =
		state.mainWaterPartInfo(
			root
		)

	if not info then
		return false
	end

	return state.mainWaterExitReached(
		root,
		info.part,
		character
	)
end

function state.findAquaticDryTerrainExit(
	character,
	root,
	preferredTarget
)
	-- Compatibility wrapper is Terrain-only as well. No MainWaterPart-edge,
	-- Rock, MeshPart or arbitrary BasePart fallback is allowed.
	return state.findNearbyMainWaterBankTarget(
		character,
		root,
		preferredTarget
	)
end

function state.aquaticRiverInfinityFlyExit(
	character,
	root,
	_preferredTarget
)
	if not character
		or not root
		or not state.isCrocOrHippoMovementCharacter(
			character
		) then

		return false
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not humanoid
		or humanoid.Health <= 0 then
		return false
	end

	local under, info =
		state.isUnderMainWaterPart(
			root
		)

	if not info then
		runtimeMessage =
			"Water Fly: MainWaterPart not found"
		return false
	end

	-- If the previous Fly already placed us on a real nearby bank, recover
	-- Survival immediately even if the prior transaction timed out.
	if state.mainWaterDryBankReached(
		character,
		root,
		info.part
	) then

		state.aquaticSurvivalResume(
			character
		)

		return true
	end

	-- A running/suspended water-exit transaction may already have lifted the
	-- HRP above MainWaterPart while still over open water. Do NOT interpret
	-- that as land; continue toward a real bank.
	if not under
		and not (
			state.aquaticRiverEscape
			and state.aquaticRiverEscape.survivalSuspended
		) then

		return false
	end

	local target
	local targetOk,
		targetResult =
			pcall(
				state.findNearbyMainWaterBankTarget,
				character,
				root,
				_preferredTarget
			)

	if not targetOk then
		runtimeMessage =
			"Aquatic bank scan error: "
			.. tostring(
				targetResult
			)

		return false
	end

	target =
		targetResult

	if typeof(target) ~= "Vector3" then
		runtimeMessage =
			CROC.isCharacter(
				character
			)
				and "Croc water exit: no ABOVE-WATER Terrain bank nearby; retrying"
				or "Hippo water exit: no ABOVE-WATER Terrain bank nearby; retrying"

		return false
	end

	local waterPart =
		info.part

	-- Exclusive transaction: Eat + Drink are physically OFF until UNFLY has
	-- completed outside MainWaterPart.
	state.aquaticSurvivalSuspend(
		character
	)

	state.releaseMovementNow(
		character,
		true
	)

	local fly =
		state.aquaticRiverEscape

	pcall(function()
		local old =
			root:FindFirstChild(
				"MMB_AquaticFlyVelocity"
			)

		if old then
			old:Destroy()
		end
	end)

	pcall(function()
		local old =
			root:FindFirstChild(
				"MMB_AquaticFlyGyro"
			)

		if old then
			old:Destroy()
		end
	end)

	pcall(function()
		local old =
			root:FindFirstChild(
				"MMB_AquaticFlyPosition"
			)

		if old then
			old:Destroy()
		end
	end)

	local oldAutoRotate =
		humanoid.AutoRotate

	local oldMovementDisabled =
		character:GetAttribute(
			"MovementDisabled"
		)

	local oldWaterCollision =
		waterPart.CanCollide

	state.aquaticFlyEnableFallGuard(
		character
	)

	-- Only during Fly, so the collision plane cannot trap the rig below it.
	waterPart.CanCollide = false

	local BG =
		Instance.new(
			"BodyGyro"
		)

	local BP =
		Instance.new(
			"BodyPosition"
		)

	BG.Name =
		"MMB_AquaticFlyGyro"

	BP.Name =
		"MMB_AquaticFlyPosition"

	-- Underwater exit needs POSITION ownership, not just velocity.
	-- BodyPosition is fed a moving world-space setpoint each Heartbeat.
	BG.P = 9e4
	BG.MaxTorque =
		Vector3.new(
			9e9,
			9e9,
			9e9
		)

	BG.CFrame =
		root.CFrame

	BP.P = 26000
	BP.D = 3200
	BP.MaxForce =
		Vector3.new(
			9e8,
			9e8,
			9e8
		)

	BP.Position =
		root.Position

	BG.Parent =
		root

	BP.Parent =
		root

	fly.bodyGyro = BG
	fly.bodyPosition = BP
	fly.bodyVelocity = nil

	runtimeMessage =
		CROC.isCharacter(
			character
		)
			and string.format(
				"Croc water position-control START · bank %.0f studs",
				(target - root.Position).Magnitude
			)
			or string.format(
				"Hippo water position-control START · bank %.0f studs",
				(target - root.Position).Magnitude
			)

	pcall(function()
		humanoid.PlatformStand = true
		humanoid.AutoRotate = false
	end)

	-- CRITICAL: Savannah's SwimmingController must stop issuing its own
	-- locomotion commands while the positional water-exit controller owns HRP.
	character:SetAttribute(
		"MovementDisabled",
		true
	)

	-- Maximum rate at which the world-space setpoint advances.
	local WATER_EXIT_SPEED = 50

	local initialDistance =
		(target - root.Position).Magnitude

	local deadline =
		tick()
		+ math.clamp(
			initialDistance
				/ WATER_EXIT_SPEED
				+ 2.5,
			3.0,
			12.0
		)

	local success =
		false

	local nextDryBankCheckAt =
		0

	local commandedPosition =
		root.Position

	local lastHeartbeatAt =
		tick()

	local callOk, callError =
		pcall(function()
			while state.alive
				and character.Parent
				and root.Parent
				and humanoid.Parent
				and humanoid.Health > 0
				and tick() < deadline do

				-- Only one short Terrain ray every 0.125 s. This catches the
				-- FIRST nearby rise/bank we pass over, so the Croc/Hippo does not
				-- continue flying toward some distant MainWaterPart edge.
				local now =
					tick()

				if now
					>= nextDryBankCheckAt then

					nextDryBankCheckAt =
						now + 0.125

					if state.mainWaterDryBankReached(
						character,
						root,
						waterPart
					) then

						success = true
						break
					end
				end

				local delta =
					target - root.Position

				local nowHeartbeat =
					tick()

				local dt =
					math.clamp(
						nowHeartbeat
							- lastHeartbeatAt,
						1 / 120,
						1 / 20
					)

				lastHeartbeatAt =
					nowHeartbeat

				local commandDelta =
					target
						- commandedPosition

				if commandDelta.Magnitude > 0.05 then
					local commandSpeed =
						math.clamp(
							commandDelta.Magnitude * 2.0,
							10,
							WATER_EXIT_SPEED
						)

					local step =
						math.min(
							commandDelta.Magnitude,
							commandSpeed * dt
						)

					commandedPosition =
						commandedPosition
						+ commandDelta.Unit
							* step
				else
					commandedPosition =
						target
				end

				BP.Position =
					commandedPosition

				local flat =
					Vector3.new(
						target.X
							- root.Position.X,
						0,
						target.Z
							- root.Position.Z
					)

				if flat.Magnitude > 0.20 then
					BG.CFrame =
						CFrame.lookAt(
							root.Position,
							root.Position
								+ flat.Unit,
							Vector3.yAxis
						)
				end

				-- Kill inherited swimming momentum. Position is controlled by BP.
				root.AssemblyLinearVelocity =
					root.AssemblyLinearVelocity
						* 0.18

				root.AssemblyAngularVelocity =
					Vector3.zero

				runtimeMessage =
					CROC.isCharacter(
						character
					)
						and string.format(
							"Croc water position-control -> nearby bank (%.0f)",
							delta.Magnitude
						)
						or string.format(
							"Hippo water position-control -> nearby bank (%.0f)",
							delta.Magnitude
						)

				RunService.Heartbeat:Wait()
			end
		end)

	-- One final proof before UNFLY. This also catches a bank reached on the
	-- exact timeout frame.
	if not success
		and root
		and root.Parent
		and state.mainWaterDryBankReached(
			character,
			root,
			waterPart
		) then

		success = true
	end

	-- UNFLY
	pcall(function()
		if BP and BP.Parent then
			BP:Destroy()
		end
	end)

	pcall(function()
		if BG and BG.Parent then
			BG:Destroy()
		end
	end)

	fly.bodyPosition = nil
	fly.bodyVelocity = nil
	fly.bodyGyro = nil

	if root and root.Parent then
		root.AssemblyLinearVelocity =
			Vector3.zero

		root.AssemblyAngularVelocity =
			Vector3.zero
	end

	pcall(function()
		humanoid.PlatformStand = false
		humanoid.AutoRotate =
			oldAutoRotate ~= false

		humanoid:ChangeState(
			Enum.HumanoidStateType.GettingUp
		)
	end)

	if oldMovementDisabled == nil then
		character:SetAttribute(
			"MovementDisabled",
			false
		)
	else
		character:SetAttribute(
			"MovementDisabled",
			oldMovementDisabled
		)
	end

	-- Underwater exit is the ONLY Croc/Hippo phase with collision disabled.
	-- UNFLY is complete here, so immediately restore the normal solid surface.
	if waterPart
		and waterPart.Parent then

		if state.isCrocOrHippoMovementCharacter(
			character
		) then
			waterPart.CanCollide =
				true
		else
			waterPart.CanCollide =
				oldWaterCollision
		end
	end

	-- Keep fall protection for only two landing frames.
	if success then
		for _ = 1, 2 do
			RunService.Heartbeat:Wait()
		end
	end

	state.aquaticFlyDisableFallGuard()

	if success then
		state.aquaticSurvivalResume(
			character
		)

		runtimeMessage =
			CROC.isCharacter(
				character
			)
				and "Croc water Fly OFF: outside MainWaterPart"
				or "Hippo water Fly OFF: outside MainWaterPart"

		return true
	end

	if not callOk then
		runtimeMessage =
			"Aquatic Fly error: "
			.. tostring(callError)
	else
		runtimeMessage =
			CROC.isCharacter(
				character
			)
				and "Croc water Fly timed out; retrying later"
				or "Hippo water Fly timed out; retrying later"
	end

	return false
end

function state.moveAquaticToDryTerrain(character, root, preferredTarget)
	if not character or not root then
		return false
	end

	-- Never stack the Croc/Hippo water Fly on top of the emergency land-slope
	-- position controller. The land assist will release itself first.
	if state.landSlopeAssist
		and state.landSlopeAssist.busy then
		return false
	end

	local controller = state.aquaticRiverEscape

	if controller.busy then
		return false
	end

	if tick() < (controller.retryAt or 0) then
		return false
	end

	-- Crocodile/Hippo: the whole water decision is MainWaterPart geometry.
	if state.nonAquaticDryBankConfirmed(
		character,
		root
	) then

		if isDinoLife
			and state.dinoShorelineResetProbe then

			state.dinoShorelineResetProbe()
		end

		return
	end

	if state.isCrocOrHippoMovementCharacter(
		character
	) then
		local under, info =
			state.isUnderMainWaterPart(
				root
			)

		if info
			and state.mainWaterDryBankReached(
				character,
				root,
				info.part
			) then

			state.aquaticSurvivalResume(
				character
			)

			controller.retryAt = 0
			return true
		end

		local suspended =
			controller.survivalSuspended
				== true

		if not under
			and not suspended then
			return false
		end

		controller.busy = true

		local ok =
			state.aquaticRiverInfinityFlyExit(
				character,
				root,
				preferredTarget
			)

		controller.busy = false
		controller.retryAt =
			ok
				and 0
				or tick() + 2.5

		return ok
	end

	-- Other aquatic animals keep the prior physical bank movement.
	local target =
		state.findAquaticDryTerrainExit(
			character,
			root,
			preferredTarget
		)

	if not target then
		return false
	end

	setAquaticWaterCollision(character, true)

	local moved =
		safeMoveToPosition(
			target,
			7,
			nil,
			{
				purpose = "safety",
				tolerance =
					math.clamp(
						state.movementFootprint(character) * 0.65,
						8,
						15
					),
				vertical = false,
				forceMoveToLand = true,
				constantSpeed = true,
				stopOnDryGround = true,
				maxDuration = 180,
			}
		)

	character, root = characterParts()

	if moved
		and character
		and root
		and state.normalizeDryLandState(character, root) then

		setAquaticWaterCollision(character, false)
		state.releaseMovementNow(character, true)
		return true
	end

	return false
end


function state.forceStopActiveDrink(
	character,
	reason
)
	if not character
		or character ~= player.Character then

		return false
	end

	drinkingToFull = false
	drinkingSourcePosition = nil
	blockClientSubState = false

	if state.drinkProgressReset then
		state.drinkProgressReset()
	end

	if state.safeMove
		and state.safeMove.active
		and (
			state.safeMove.reason == "water"
			or state.safeMove.reason == "water_search"
		) then

		state.safeMove.cancelToken += 1
		state.safeMove.active = false
		state.safeMove.target = nil
		state.safeMove.reason = nil
		state.safeMove.manualLabel = nil
		state.busy = false
	end

	-- A search transit is part of the same Drink transaction. Leaving this flag
	-- alive after a starvation preemption made the quest/water worker look active
	-- even though Food had already taken priority.
	if state.drinkSearch then
		state.drinkSearch.surfaceTransitActive = false
		state.drinkSearch.surfaceTransitFoundSpot = nil
		state.drinkSearch.surfaceTransitReason = reason or "drink_cancelled"
	end

	if state.questSetW then
		pcall(
			state.questSetW,
			false
		)
	end

	-- Stop the game's actual Drinking substate.
	-- Send once now and once shortly afterwards to defeat a stale drink worker
	-- that was already mid-iteration when the emergency was raised.
	if AskSubState then
		pcall(
			AskSubState.InvokeServer,
			AskSubState,
			"Walking"
		)

		mmbTaskDefer(function()
			task.wait(0.12)

			if player.Character == character then
				blockClientSubState = false

				pcall(
					AskSubState.InvokeServer,
					AskSubState,
					"Walking"
				)
			end
		end)
	end

	state.releaseMovementNow(
		character,
		true
	)

	if reason then
		runtimeMessage =
			tostring(reason)
	end

	return true
end

-- ============================================================
-- CENTRAL SAVANNAH HERBIVORE FOOD RECOVERY
--
-- Invariant:
-- a hungry herbivore is never allowed to remain stationary because grass search,
-- water-exit, Growth, Zone, Quest or a stale SafeMove disagree about ownership.
--
-- Trigger:
--   Food low + no real Food progress + no meaningful movement progress.
--
-- Recovery:
--   1) stop EVERY competing controller;
--   2) if Hippo/Croc is under MainWaterPart, use the existing verified aquatic
--      Fly to reach dry Terrain;
--   3) move directly to the known Pride Rock home;
--   4) temporarily allow Pride-area grass despite stale Zone/Growth policy;
--   5) release exclusive ownership and restart Auto Eat.
-- ============================================================

function state.herbivoreFoodRecoveryStopOthers(
	character,
	token
)
	local recovery =
		state.herbivoreFoodRecovery

	if not recovery
		or not recovery.active
		or recovery.token ~= token
		or recovery.character ~= character
		or character ~= player.Character then

		return false
	end

	-- Food / Drink interaction state.
	-- IMPORTANT: stopping the boolean is not enough; stop Savannah's real
	-- Drinking substate too, otherwise Hippo remains rooted with
	-- "Tap to stop drinking" while this watchdog tries to move it.
	eatingToFull = false
	eatingSourcePosition = nil
	eatingTargetReachedAt = nil
	eatingStuckSince = nil
	drinkingStuckSince = nil
	blockClientSubState = false

	if state.forceStopActiveDrink then
		state.forceStopActiveDrink(
			character,
			"FOOD WATCHDOG: stopping Drinking before Pride recovery"
		)
	else
		drinkingToFull = false
		drinkingSourcePosition = nil
	end

	-- Species-specific food workers.
	BABOON.cancel()
	GIRAFFE.cancel()
	state.questCarnivoreFeeding = false
	state.questBaboonFeeding = false
	state.questGiraffeFeeding = false

	-- Growth / Pride controller.
	state.growthPride.returnRequested = false
	state.growthPride.returning = false

	-- Quest / Auto Run ownership.
	questTravelWanted = false
	state.questTravelActive = false
	state.questLandInputActive = false
	state.questSwimActive = false
	state.questSwimReady = false
	state.questMotionMoving = false
	state.questMotionMode = nil
	state.autoRunMoveOwnsInput = false

	if state.questTravelHerbivoreFeed then
		state.questTravelHerbivoreFeed.active = false
	end

	state.questSetW(false)

	if state.questSetLandPermanentW then
		pcall(
			state.questSetLandPermanentW,
			false
		)
	end

	if state.heavyWalk
		and state.heavyWalk.owner == "autoRun"
		and state.heavyWalkStop then

		pcall(
			state.heavyWalkStop,
			character
		)
	end

	-- Cancel any SafeMove except the one owned by this watchdog.
	if state.safeMove
		and state.safeMove.active
		and state.safeMove.reason
			~= "herbivore_food_recovery" then

		state.safeMove.cancelToken += 1
		state.safeMove.active = false
		state.safeMove.target = nil
		state.safeMove.reason = nil
		state.safeMove.manualLabel = nil
		state.busy = false

		state.releaseMovementNow(
			character,
			true
		)
	end

	-- A stale Survival owner is not allowed to re-acquire movement while this
	-- exclusive transaction is active.
	if state.survivalArbiterReset then
		state.survivalArbiterReset(
			"Central herbivore food recovery"
		)
	end

	if AskSubState then
		pcall(
			AskSubState.InvokeServer,
			AskSubState,
			"Walking"
		)
	end

	return true
end

function state.herbivoreFoodRecoveryFinish(
	token,
	reached,
	message
)
	local recovery =
		state.herbivoreFoodRecovery

	if not recovery
		or recovery.token ~= token then

		return
	end

	local character =
		recovery.character

	if state.safeMove
		and state.safeMove.active
		and state.safeMove.reason
			== "herbivore_food_recovery" then

		state.safeMove.cancelToken += 1
		state.safeMove.active = false
		state.safeMove.target = nil
		state.safeMove.reason = nil
		state.safeMove.manualLabel = nil
		state.busy = false
	end

	if character
		and character == player.Character then

		state.releaseMovementNow(
			character,
			true
		)
	end

	recovery.active = false
	recovery.character = nil
	recovery.reason = nil
	recovery.startedAt = 0
	recovery.attempt = 0
	recovery.requested = false
	recovery.requestReason = nil
	recovery.stuckSince = 0
	recovery.lastPosition = nil
	recovery.lastProgressAt = tick()
	recovery.replanCount = 0
	recovery.replanSign = nil
	recovery.lastReplanAt = 0
	recovery.lastReplanReason = nil

	-- Give Auto Eat a short window around Pride in which stale Zone/Growth food
	-- restrictions cannot re-create the same "no grass allowed" deadlock.
	recovery.foodOverrideUntil =
		reached
			and tick() + 22
			or tick() + 4

	if recovery.ownsCriticalLock then
		criticalRecoveryActive = false
	end

	recovery.ownsCriticalLock = false

	runtimeMessage =
		message
			or (
				reached
					and "Herbivore food recovery complete at Pride Rock; Auto Eat resumed"
					or "Herbivore food recovery released; retrying"
			)

	if reached
		and character
		and character == player.Character
		and state.autoEat then

		mmbTaskDefer(function()
			task.wait(0.15)

			if player.Character == character
				and state.autoEat
				and not (
					state.herbivoreFoodRecovery
					and state.herbivoreFoodRecovery.active
				)
				and not state.busy
				and not criticalRecoveryActive then

				pcall(
					autoEatStep
				)
			end
		end)
	end
end

function state.herbivoreFoodRecoveryRequestReplan(reason)
	local recovery = state.herbivoreFoodRecovery
	local character = player.Character

	if not recovery
		or not recovery.active
		or recovery.character ~= character then
		return false
	end

	local now = tick()

	-- v5.2: a recovery/replan request is NOT permission to tear down a route that
	-- is currently moving. SafeMove now reports real physical progress for this
	-- transit, so preserve the same generation while that signal is fresh.
	if state.safeMove
		and state.safeMove.active
		and state.safeMove.reason == "herbivore_food_recovery"
		and now - (tonumber(state.safeMove.lastProgressAt) or 0) <= 1.35 then

		recovery.lastProgressAt = now
		recovery.stuckSince = 0
		recovery.lastReplanReason = "suppressed_while_physically_moving"
		return true
	end

	if now - (recovery.lastReplanAt or 0) < 1.25 then
		return true
	end

	recovery.lastReplanAt = now
	recovery.replanCount = (recovery.replanCount or 0) + 1
	recovery.lastReplanReason = reason or "blocked Pride transit"

	local defaultSign = ((player.UserId % 2) == 0) and 1 or -1
	local previousSign = tonumber(recovery.replanSign) or defaultSign
	recovery.replanSign = previousSign >= 0 and -1 or 1

	-- Cancel ONLY the current physical generation. Do not ForceCancelOwner(Food):
	-- that path calls herbivoreFoodRecoveryFinish(), destroys the recovery, and
	-- falls back to generic AutoEat outside Pride where Growth policy forbids food
	-- movement. The worker loop below will immediately acquire a fresh route.
	if state.safeMove
		and state.safeMove.active
		and state.safeMove.reason == "herbivore_food_recovery" then
		state.safeMove.cancelToken += 1
	end

	-- Forget the old Pride-side commitment so the new generation can genuinely
	-- try the alternate opening instead of inheriting the same oscillation.
	if state.prideRockObstacleCache then
		state.prideRockObstacleCache.commitSign = nil
		state.prideRockObstacleCache.commitDirection = nil
		state.prideRockObstacleCache.commitStartedAt = 0
		state.prideRockObstacleCache.commitUntil = 0
	end

	recovery.lastProgressAt = now
	recovery.stuckSince = 0

	runtimeMessage = string.format(
		"FOOD WATCHDOG: Pride route blocked; replanning side (%d)",
		recovery.replanCount
	)

	return true
end

function state.startHerbivoreFoodRecovery(reason)
	if not isSavannahLife
		or not state.herbivoreFoodRecoveryEatWanted() then

		return false
	end

	local character,
		root,
		humanoid =
			characterParts()

	if not character
		or not root
		or not humanoid
		or humanoid.Health <= 0
		or not state.isGrowthHerbivore(
			character
		)
		or isGiraffeCharacter(
			character
		)
		or isBaboonCharacter(
			character
		)
		or isCarnivoreCharacter(
			character
		) then

		return false
	end

	local food =
		tonumber(
			character:GetAttribute(
				"Food"
			)
		) or 100

	local water =
		tonumber(
			character:GetAttribute(
				"Water"
			)
		) or 100

	-- v5.5: a real Water transaction wins over Pride Food recovery unless Food
	-- is at hard starvation emergency. Underground Drink must never be stopped
	-- at Water 46-75 by the no-food-progress watchdog.
	local foodEmergency = state.survivalFoodEmergency(food, water)
	local waterOwnsNow = state.authoritativeSurvivalOwner
		and state.authoritativeSurvivalOwner() == "water"
	local protectedDrink = state.drinkTransactionProtected
		and state.drinkTransactionProtected(character)
	if not foodEmergency
		and (waterOwnsNow or protectedDrink or drinkingToFull) then
		return false
	end

	-- A normal Swim mission remains food-free, but it is NEVER allowed to kill
	-- the slot. Critical starvation aborts/pause Swim and hands control to Food.
	if state.questSwimActive
		and not state.survivalFoodEmergency(
			food,
			water
		) then

		return false
	end

	-- Truly critical Water saves the animal first. The Food watchdog will retry
	-- immediately after Drink completes.
	if state.autoDrink
		and water <= 45 then

		return false
	end

	local recovery =
		state.herbivoreFoodRecovery

	local supervisorFoodSeverity =
		food <= 25 and 995
		or food <= 45 and 955
		or 915

	if not state.aiSupervisorPermitController(
		"Food",
		"HerbivoreFoodRecovery",
		reason or "Herbivore food recovery",
		supervisorFoodSeverity
	) then
		return false
	end

	if recovery.active then
		return recovery.character
			== character
	end

	-- Do not stack on top of another genuine emergency.
	-- Exception: a starving Hippo may take ownership from the generic post-drink
	-- controller. That controller is a predecessor of THIS same recovery job.
	if criticalRecoveryActive then
		if forcingPostDrinkMove
			and state.survivalFoodEmergency(
				food,
				water
			) then

			recovery.requested = true
			recovery.requestReason =
				reason
					or "waiting_for_post_drink_handoff"

			return false
		end

		return false
	end

	-- Let an aquatic Fly already in progress finish instead of creating two
	-- BodyPosition owners.
	if state.aquaticRiverEscape
		and state.aquaticRiverEscape.busy then

		recovery.requested = true
		recovery.requestReason =
			reason or "waiting_for_aquatic_exit"

		return false
	end

	recovery.token += 1

	local token =
		recovery.token

	recovery.active = true
	recovery.character = character
	recovery.reason =
		reason or "food_stuck"
	recovery.startedAt = tick()
	recovery.attempt = 0
	recovery.requested = false
	recovery.requestReason = nil
	recovery.replanCount = 0
	recovery.replanSign = ((player.UserId % 2) == 0) and 1 or -1
	recovery.lastReplanAt = 0
	recovery.lastReplanReason = nil
	recovery.ownsCriticalLock = true

	criticalRecoveryActive = true

	-- If we were repeatedly targeting one bogus grass point, invalidate it now.
	if typeof(eatingSourcePosition)
		== "Vector3" then

		temporarilyIgnoreGrass(
			eatingSourcePosition,
			25,
			22
		)
	end

	state.herbivoreFoodRecoveryStopOthers(
		character,
		token
	)

	runtimeMessage =
		"FOOD WATCHDOG: all other movement stopped; Pride Rock recovery owns animal"

	task.spawn(function()
		local pride =
			state.herbivoreFoodRecoveryTarget()

		if typeof(pride) ~= "Vector3" then
			state.herbivoreFoodRecoveryFinish(
				token,
				false,
				"FOOD WATCHDOG: Pride Rock target unavailable; controls released"
			)

			return
		end

		local deadline =
			tick() + 150

		while state.alive
			and recovery.active
			and recovery.token == token
			and tick() < deadline do

			local liveCharacter,
				liveRoot,
				liveHumanoid =
					characterParts()

			if liveCharacter ~= character
				or not liveRoot
				or not liveHumanoid
				or liveHumanoid.Health <= 0 then

				state.herbivoreFoodRecoveryFinish(
					token,
					false,
					"FOOD WATCHDOG: character changed; recovery released"
				)

				return
			end

			local liveFood = tonumber(liveCharacter:GetAttribute("Food")) or 100
			local liveWater = tonumber(liveCharacter:GetAttribute("Water")) or 100
			local liveFoodEmergency = state.survivalFoodEmergency(liveFood, liveWater)
			local liveWaterOwns = state.authoritativeSurvivalOwner
				and state.authoritativeSurvivalOwner() == "water"
			local liveProtectedDrink = state.drinkTransactionProtected
				and state.drinkTransactionProtected(liveCharacter)

			if not liveFoodEmergency
				and (liveWaterOwns or liveProtectedDrink or drinkingToFull) then
				state.herbivoreFoodRecoveryFinish(
					token,
					false,
					"FOOD WATCHDOG: Water transaction owns survival; Pride route yielded"
				)
				return
			end

			state.herbivoreFoodRecoveryStopOthers(
				character,
				token
			)

			local distance =
				Vector3.new(
					liveRoot.Position.X - pride.X,
					0,
					liveRoot.Position.Z - pride.Z
				).Magnitude

			if distance <= 18 then
				state.herbivoreFoodRecoveryFinish(
					token,
					true,
					"FOOD WATCHDOG: Pride Rock reached; searching grass again"
				)

				return
			end

			recovery.attempt += 1

			-- Hippo/Croc in water must FIRST use the existing verified dry-bank
			-- position controller. The Pride target biases which bank is chosen.
			if state.isCrocOrHippoMovementCharacter(
				liveCharacter
			) then

				local under =
					state.isUnderMainWaterPart(
						liveRoot
					)

				local suspended =
					state.aquaticRiverEscape
					and state.aquaticRiverEscape.survivalSuspended

				if under
					or suspended then

					runtimeMessage =
						"FOOD WATCHDOG: Hippo/Croc trapped in water; exclusive dry-bank exit"

					local escaped =
						state.moveAquaticToDryTerrain(
							liveCharacter,
							liveRoot,
							pride
						)

					if not escaped then
						task.wait(0.55)
						continue
					end

					task.wait(0.20)

					liveCharacter,
						liveRoot =
							characterParts()

					if liveCharacter ~= character
						or not liveRoot then

						continue
					end
				end
			end

			-- Clear any stale busy bit once more immediately before OUR route.
			if not (
				state.safeMove
					and state.safeMove.active
					and state.safeMove.reason
						== "herbivore_food_recovery"
			) then

				state.busy = false
			end

			runtimeMessage =
				string.format(
					"FOOD WATCHDOG ONLY: moving herbivore to Pride Rock (%.0f studs)",
					distance
				)

			safeMoveToPosition(
				pride,
				10,
				pride,
				{
					purpose =
						"herbivore_food_recovery",
					forceMoveToLand = true,
					tolerance = 16,
					speedScale = 0.90,
					constantSpeed = false,
					preferredObstacleSign = recovery.replanSign,
					maxDuration = 90,
					routeCheckInterval = 0.25,
					routeCheck = function()
						if not recovery.active
							or recovery.token
								~= token then

							return true,
								"food_recovery_cancelled"
						end

						local checkCharacter,
							checkRoot =
								characterParts()

						if checkCharacter
								~= character
							or not checkRoot then

							return true,
								"character_changed"
						end

						local remaining =
							Vector3.new(
								checkRoot.Position.X
									- pride.X,
								0,
								checkRoot.Position.Z
									- pride.Z
							).Magnitude

						if remaining <= 18 then
							return true,
								"pride_reached"
						end

						return false
					end,
				}
			)

			task.wait(0.15)
		end

		state.herbivoreFoodRecoveryFinish(
			token,
			false,
			"FOOD WATCHDOG: Pride recovery timed out; controls released safely"
		)
	end)

	return true
end

-- Repair stale Croc/Hippo water-exit suspension.
-- This specifically catches: Fly ended/failed -> busy=false -> survivalSuspended
-- remained true -> effective Auto Eat false -> Hippo watches water forever.
task.spawn(function()
	while state.alive do
		pcall(function()
			if not isSavannahLife
				or not state.aquaticRiverEscape
				or not state.aquaticRiverEscape.survivalSuspended
				or state.aquaticRiverEscape.busy then

				return
			end

			local character,
				root,
				humanoid =
					characterParts()

			if not character
				or not root
				or not humanoid
				or humanoid.Health <= 0
				or not state.isCrocOrHippoMovementCharacter(
					character
				) then

				return
			end

			local waterPart =
				workspace:FindFirstChild(
					"MainWaterPart"
				)

			-- Already on a real bank: clear stale suspension immediately.
			if waterPart
				and waterPart:IsA("BasePart")
				and state.mainWaterDryBankReached(
					character,
					root,
					waterPart
				) then

				state.aquaticRiverEscape.retryAt = 0

				state.aquaticSurvivalResume(
					character
				)

				runtimeMessage =
					"Hippo/Croc stale water-exit suspension cleared on dry bank"

				return
			end

			local food =
				tonumber(
					character:GetAttribute(
						"Food"
					)
				) or 100

			local water =
				tonumber(
					character:GetAttribute(
						"Water"
					)
				) or 100

			-- If still in/near water and hungry, DO NOT wait for the normal
			-- Survival workers: they are the exact workers suspension paused.
			if food <= 75
				and water > 45
				and state.autoEatManualDisabled ~= true then

				state.requestHerbivoreFoodRecovery(
					"stale_aquatic_suspension_hungry"
				)

				state.startHerbivoreFoodRecovery(
					"stale_aquatic_suspension_hungry"
				)
			end
		end)

		task.wait(0.35)
	end
end)

-- Lightweight CENTRAL liveness monitor.
-- It does NOT run grass scans. It only asks whether the hungry animal is making
-- real progress: Food rising OR character physically moving toward some solution.
task.spawn(function()
	while state.alive do
		pcall(function()
			local recovery =
				state.herbivoreFoodRecovery

			if not recovery then
				return
			end

			if recovery.active then
				local character =
					player.Character

				if character
					and character
						== recovery.character then

					state.herbivoreFoodRecoveryStopOthers(
						character,
						recovery.token
					)
				end

				return
			end

			if not isSavannahLife
				or not state.herbivoreFoodRecoveryEatWanted()
				or state.questGrowthReset.exclusive
				or state.slotParkingAudit
					and state.slotParkingAudit.active then

				return
			end

			local character,
				root,
				humanoid =
					characterParts()

			if not character
				or not root
				or not humanoid
				or humanoid.Health <= 0
				or not state.isGrowthHerbivore(
					character
				)
				or isGiraffeCharacter(
					character
				)
				or isBaboonCharacter(
					character
				)
				or isCarnivoreCharacter(
					character
				) then

				recovery.lastCharacter = character
				recovery.lastFood = nil
				recovery.lastPosition = nil
				recovery.lastProgressAt = tick()
				recovery.stuckSince = 0
				recovery.requested = false
				return
			end

			local food =
				tonumber(
					character:GetAttribute(
						"Food"
					)
				) or 100

			local water =
				tonumber(
					character:GetAttribute(
						"Water"
					)
				) or 100

			local foodEmergency = state.survivalFoodEmergency(food, water)
			local waterOwnsNow = state.authoritativeSurvivalOwner
				and state.authoritativeSurvivalOwner() == "water"
			local protectedDrink = state.drinkTransactionProtected
				and state.drinkTransactionProtected(character)

			if not foodEmergency
				and (waterOwnsNow or protectedDrink or drinkingToFull) then
				recovery.lastFood = food
				recovery.lastPosition = root.Position
				recovery.lastProgressAt = tick()
				recovery.stuckSince = 0
				recovery.requested = false
				return
			end

			if state.questSwimActive
				and not state.survivalFoodEmergency(
					food,
					water
				) then

				recovery.lastFood = food
				recovery.lastPosition = root.Position
				recovery.lastProgressAt = tick()
				recovery.stuckSince = 0
				return
			end

			if recovery.lastCharacter
				~= character then

				recovery.lastCharacter =
					character

				recovery.lastFood =
					food

				recovery.lastPosition =
					root.Position

				recovery.lastProgressAt =
					tick()

				recovery.stuckSince =
					0

				return
			end

			-- STARVATION HARD INTERRUPT:
			-- no grace timer, no route-progress excuse, no Drink ownership.
			-- If Water is above the critical dehydration threshold, Food <=25
			-- immediately hands the whole animal to the Pride food watchdog.
			if state.survivalFoodEmergency(
				food,
				water
			) then

				state.startHerbivoreFoodRecovery(
					"critical_hunger_preempts_all_noncritical_water"
				)

				return
			end

			-- Food comfortable: watchdog fully disarms.
			if food >= 88 then
				recovery.lastFood = food
				recovery.lastPosition = root.Position
				recovery.lastProgressAt = tick()
				recovery.stuckSince = 0
				recovery.requested = false
				return
			end

			-- Critical thirst is allowed to finish first.
			if state.autoDrink
				and water <= 45 then

				recovery.lastProgressAt = tick()
				recovery.stuckSince = 0
				return
			end

			local now =
				tick()

			-- REAL Food progress.
			if recovery.lastFood == nil
				or food
					> recovery.lastFood + 0.01 then

				recovery.lastFood = food
				recovery.lastProgressAt = now
				recovery.stuckSince = 0
			else
				recovery.lastFood = food
			end

			-- REAL locomotion progress. A legitimate long trip to grass is fine.
			if not recovery.lastPosition
				or Vector3.new(
					root.Position.X
						- recovery.lastPosition.X,
					0,
					root.Position.Z
						- recovery.lastPosition.Z
				).Magnitude >= 2.25 then

				recovery.lastPosition =
					root.Position

				recovery.lastProgressAt =
					now

				recovery.stuckSince =
					0
			end

			local crocHippo =
				state.isCrocOrHippoMovementCharacter(
					character
				)

			local inWater =
				crocHippo
				and (
					state.isUnderMainWaterPart(
						root
					)
					or state.isBodyActuallyInWater(
						character,
						root
					)
					or (
						state.aquaticRiverEscape
						and state.aquaticRiverEscape.survivalSuspended
					)
				)

			recovery.stuckSince =
				recovery.stuckSince > 0
					and recovery.stuckSince
					or now

			local stuckFor =
				now
					- math.max(
						recovery.lastProgressAt
							or 0,
						recovery.stuckSince
							or 0
					)

			-- Explicit failure from the grass controller starts recovery faster.
			local requested =
				recovery.requested
					== true

			local threshold

			if crocHippo
				and inWater
				and food <= 70 then

				threshold = 2.5
			elseif inWater then
				threshold = 4.0
			else
				threshold = 6.0
			end

			if requested
				or stuckFor >= threshold then

				local reason =
					recovery.requestReason
						or (
							inWater
								and "hungry_herbivore_stuck_in_water"
								or "hungry_herbivore_no_food_or_movement_progress"
						)

				recovery.requested = false
				recovery.requestReason = nil

				state.startHerbivoreFoodRecovery(
					reason
				)
			end
		end)

		task.wait(0.30)
	end
end)

local function isNearSavedSwimLocation(root, radius)
	if not root or not state.questSwimPosition then return false end

	local target = state.questSwimPosition
	local horizontal = Vector3.new(
		root.Position.X - target.X,
		0,
		root.Position.Z - target.Z
	).Magnitude

	return horizontal <= (radius or 68)
end

local function isValidSwimQuestWater(root)
	if not root or not state.questSwimPosition then return false end

	-- CRITICAL v65:
	-- A random puddle / Drink prompt is NEVER valid for the Swim quest.
	-- The mission only runs around the fixed saved swim farm location.
	if not isNearSavedSwimLocation(root, 68) then
		return false
	end

	if isStandingInWater(root) then
		return true
	end

	-- Wider terrain confirmation is allowed ONLY after confirming proximity
	-- to the saved Swim location.
	if isPositionInWaterTerrain(root.Position, 12, 16) then
		return true
	end

	-- The exact saved point is known to be the intended Swim area. Near the
	-- center, trust that fixed point even if the animal HRP is awkwardly placed.
	if isNearSavedSwimLocation(root, 34) then
		local _, _, humanoid = characterParts()
		if humanoid then
			pcall(
				humanoid.ChangeState,
				humanoid,
				Enum.HumanoidStateType.Swimming
			)
		end
		setSubState("Swimming")
		return true
	end

	return false
end


function state.drinkIsUpsideDown(root)
	if not root then return false end
	return root.CFrame.UpVector.Y < 0.35
end

function state.drinkUprightCharacter(character, root, faceTowards)
	if not character or not root or not root.Parent then return false end

	local forward
	if faceTowards then
		local flatTarget = Vector3.new(
			faceTowards.X - root.Position.X,
			0,
			faceTowards.Z - root.Position.Z
		)
		if flatTarget.Magnitude > 0.5 then
			forward = flatTarget.Unit
		end
	end

	if not forward then
		local look = root.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		if flatLook.Magnitude > 0.25 then
			forward = flatLook.Unit
		else
			local right = root.CFrame.RightVector
			local flatRight = Vector3.new(right.X, 0, right.Z)
			forward = flatRight.Magnitude > 0.25
				and flatRight.Unit
				or Vector3.new(0, 0, -1)
		end
	end

	local ok = pcall(function()
		root.CFrame = CFrame.lookAt(
			root.Position,
			root.Position + forward,
			Vector3.yAxis
		)

		root.AssemblyAngularVelocity = Vector3.zero
		local velocity = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(
			velocity.X * 0.25,
			math.clamp(velocity.Y, -1.5, 2),
			velocity.Z * 0.25
		)
		character:SetAttribute("MovementDisabled", false)
	end)

	if ok then
		state.drinkSearch.upsideDownSince = nil
		state.drinkSearch.lastUprightAt = tick()
	end

	return ok
end

function state.drinkPostureWatch(character, root, humanoid)
	if not drinkingToFull
		or state.questSwimActive
		or not character
		or not root
		or not humanoid then

		state.drinkSearch.upsideDownSince = nil
		state.drinkSearch.waterHealth = nil
		return false
	end

	local now = tick()
	local inWater = isStandingInWater(root)
		or state.drinkSearch.undergroundMode
	local upsideDown = state.drinkIsUpsideDown(root)

	if upsideDown then
		if not state.drinkSearch.upsideDownSince then
			state.drinkSearch.upsideDownSince = now
		end

		local invertedFor = now - state.drinkSearch.upsideDownSince

		-- Pequeno flip durante o ragdoll é normal. Preso invertido não é.
		if invertedFor >= 0.65
			and now - (state.drinkSearch.lastUprightAt or 0) >= 0.75 then

			state.drinkUprightCharacter(
				character,
				root,
				state.drinkSearch.currentWaterPoint
			)
			runtimeMessage = "Agua: animal virou; corrigindo postura"
		end

		local maxInverted = state.drinkSearch.undergroundMode and 1.5 or 2.5
		if inWater and invertedFor >= maxInverted then
			state.drinkEmergencyEscape(
				character,
				root,
				"Watchdog agua: animal preso de ponta-cabeca; saindo da fonte"
			)
			return true
		end
	else
		state.drinkSearch.upsideDownSince = nil
	end

	-- Dano enquanto parado na água para beber é tratado como risco de afogamento.
	if inWater then
		local health = humanoid.Health
		local maxHealth = math.max(humanoid.MaxHealth, 1)

		if state.drinkSearch.waterHealth == nil then
			state.drinkSearch.waterHealth = health
			state.drinkSearch.waterHealthAt = now
		elseif health > state.drinkSearch.waterHealth then
			state.drinkSearch.waterHealth = health
			state.drinkSearch.waterHealthAt = now
		else
			local lost = state.drinkSearch.waterHealth - health
			local elapsed = now - (state.drinkSearch.waterHealthAt or now)

			local damageLimit = state.drinkSearch.undergroundMode and 0.03 or 0.05
			if elapsed <= 5 and lost >= maxHealth * damageLimit then
				state.drinkEmergencyEscape(
					character,
					root,
					"Watchdog agua: tomando dano enquanto bebia; abortando antes de afogar"
				)
				return true
			elseif elapsed > 5 then
				state.drinkSearch.waterHealth = health
				state.drinkSearch.waterHealthAt = now
			end
		end
	else
		state.drinkSearch.waterHealth = nil
		state.drinkSearch.waterHealthAt = 0
	end

	return false
end

local forcingPostDrinkMove = false

