local carcassEatBusy = false
local function approachCarcass(carcassRoot, distance)
	local character, root = characterParts()
	if not character or not root then return false end
	local approachDirection = Vector3.new(root.Position.X - carcassRoot.Position.X, 0, root.Position.Z - carcassRoot.Position.Z)
	if approachDirection.Magnitude < 0.5 then
		approachDirection = root.CFrame.LookVector * -1
	end
	approachDirection = approachDirection.Unit
	local standTarget = carcassRoot.Position + approachDirection * distance
	return ragdollTeleport(standTarget, 3, carcassRoot.Position)
end

local function eatCarcass(carcass, carcassRoot)
	if carcassEatBusy or not carcass or not carcassRoot then return end
	local character, root, humanoid = characterParts()
	if not character or not root or not humanoid then return end
	carcassEatBusy = true
	activeCarcass = carcass

	-- Não pousa em cima da carcaça (carcaça pequena some embaixo de um
	-- animal grande), mas também não pode ficar longe demais — se passar
	-- do alcance de detecção do jogo, o botão "Eat" nem aparece.
	-- Começa perto (5 studs) e só se afasta um pouco se precisar.
	local standoffDistance = 5

	if (root.Position - carcassRoot.Position).Magnitude > 12 then
		approachCarcass(carcassRoot, standoffDistance)
		task.wait(0.2)
	end

	character, root, humanoid = characterParts()
	if not character or not root or not humanoid then carcassEatBusy = false return end

	-- Se autoEat foi desligado nesse meio tempo (ex: o script está saindo
	-- da água por causa do autoDrink), aborta e não segura a posição —
	-- senão essa rotina briga com o teleporte de saída da água.
	if not state.autoEat then
		carcassEatBusy = false
		return
	end

	-- Se mesmo depois do teleporte o animal ficou nadando, a carcaça está
	-- na água (ou embaixo dela) e essa detecção de "underwater" pode ter
	-- falhado antes (ex: correnteza moveu a carcaça). Ignora e desiste.
	if humanoid:GetState() == Enum.HumanoidStateType.Swimming then
		runtimeMessage = "Carcaça na água; ignorando e procurando outra"
		ignoreCarcass(carcass, 180)
		if activeCarcass == carcass then activeCarcass = nil end
		carcassEatBusy = false
		return
	end

	-- Se o botão "Eat" não apareceu, tenta uma vez bem mais perto (2 studs)
	-- antes de desistir — a distância padrão pode ter ficado longe demais
	-- dependendo do alcance de detecção específico desse jogo.
	if detectAvailableFood(character) ~= "Eat" then
		approachCarcass(carcassRoot, 2)
		task.wait(0.2)
		character, root, humanoid = characterParts()
		if not character or not root or not humanoid then carcassEatBusy = false return end
	end

	-- Não ancora (isso pode travar animação/física e conflitar com o servidor).
	-- Em vez disso segura a posição perto da carcaça zerando a velocidade e
	-- corrigindo se o animal escorregar, igual à barreira de natação.
	local holdPosition = root.Position

	setSubState("Eating")
	if CarcassRemote then pcall(CarcassRemote.FireServer, CarcassRemote, carcass) end
	runtimeMessage = "Comendo carcaça"

	local startFood = character:GetAttribute("Food") or 0
	local foodEverRose = false
	local deadline = tick() + 6
	while tick() < deadline do
		task.wait(0.3)
		character, root, humanoid = characterParts()
		if not character or not root or not humanoid then break end
		if not carcass.Parent then break end -- carcaça sumiu (foi consumida)

		-- Autodrink pode ter assumido o controle pra sair da água — solta
		-- imediatamente pra não brigar com o teleporte.
		if not state.autoEat then
			runtimeMessage = "Comer pausado (outra rotina assumiu)"
			break
		end

		-- Caiu na água durante o ciclo (ex: maré/correnteza): aborta e ignora.
		if humanoid:GetState() == Enum.HumanoidStateType.Swimming then
			runtimeMessage = "Carcaça na água; ignorando e procurando outra"
			ignoreCarcass(carcass, 180)
			if activeCarcass == carcass then activeCarcass = nil end
			break
		end

		-- Se o jogo está oferecendo "Drink" em vez de "Eat" aqui, é sinal
		-- de que a carcaça está na beiradinha da água. Troca de carcaça.
		if detectAvailableFood(character) == "Drink" then
			runtimeMessage = "Carcaça na beira da água (oferecendo beber); trocando"
			ignoreCarcass(carcass, 180)
			if activeCarcass == carcass then activeCarcass = nil end
			break
		end

		local curFood = character:GetAttribute("Food") or 0
		if curFood > startFood then
			startFood = curFood
			foodEverRose = true
			deadline = tick() + 4 -- ainda subindo, estende o prazo
		end
		local targetFood = (state.autoQuests and state.questCarnivoreFeeding and not preSwitchFoodTarget)
			and 100
			or (preSwitchFoodTarget or 92)
		if curFood >= targetFood then break end

		root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
		if (root.Position - holdPosition).Magnitude > 6 then
			root.CFrame = CFrame.new(holdPosition) * root.CFrame.Rotation
		end

		if RAGDOLL_STATES[humanoid:GetState()] then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end

		if CarcassRemote then pcall(CarcassRemote.FireServer, CarcassRemote, carcass) end
		setSubState("Eating")
	end

	character, root = characterParts()
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	-- Watchdog: se passou o tempo todo tentando e a comida nunca subiu nem
	-- um pouco, essa carcaça não é comível daqui (posição ruim, presa em
	-- algo, etc). Ignora por um tempo pra não ficar insistindo pra sempre.
	if not foodEverRose and carcass.Parent then
		runtimeMessage = "Não consegui comer essa carcaça; ignorando e trocando"
		ignoreCarcass(carcass, 90)
	end

	if not carcass.Parent then activeCarcass = nil end
	if activeCarcass == carcass and not foodEverRose then activeCarcass = nil end
	carcassEatBusy = false
end
local drinkingToFull = false
local eatingToFull = false
-- Quando definidos (por growthStep, antes de trocar de slot), sobrescrevem
-- os tetos normais de "já tá bom" (92% comida / 98% água) para forçar
-- encher de verdade até perto de 100%, dando uma margem de segurança.
local preSwitchFoodTarget = nil
local preSwitchWaterTarget = nil
-- Fica true enquanto forcePostDrinkTeleport ou ensureOnSolidGround estão
-- ativamente controlando o personagem (saindo da água/void). Enquanto isso,
-- nenhuma outra rotina (comer, beber, trocar de slot) pode mexer no
-- personagem — senão ficam brigando pra teleportar pra lugares diferentes
-- ao mesmo tempo (foi isso que matou um Rex no Dino Life).
local criticalRecoveryActive = false
local eatingSourcePosition
local eatingTargetReachedAt
local activeCarcass
local drinkingSourcePosition
local swimBarrier
local swimAnchorPosition
local ignoredGrassPosition
local ignoredGrassUntil = 0
local lastObservedFood
local lastFoodIncreaseAt = tick()
local nextEmergencyGrassCheck = 0
local nextCarnivoreExploreCheck = 0
local savannahCarcassSpawnIndex = 0
local savannahCarcassCurrentSpawn
local SAVANNAH_CARCASS_SPAWN_WAIT = 15

local function resetEatingSearch(food)
	eatingSourcePosition = nil
	eatingTargetReachedAt = nil
	ignoredGrassPosition = nil
	ignoredGrassUntil = 0
	lastObservedFood = food
	lastFoodIncreaseAt = tick()
end

-- Savannah: quando um carnivoro nao encontra carcaca, percorre em ordem
-- exatamente os mesmos spawns exibidos na aba Teleport. Fica 15s em cada
-- ponto para dar tempo do mapa/carcacas carregarem antes de ir ao proximo.
local function exploreSavannahCarcassSpawns()
	if not isSavannahLife then return false end
	if tick() < nextCarnivoreExploreCheck then
		local remaining = math.max(0, math.ceil(nextCarnivoreExploreCheck - tick()))
		local spawnName = savannahCarcassCurrentSpawn and savannahCarcassCurrentSpawn.Name or "spawn"
		runtimeMessage = string.format("Procurando carcaca em %s (%ds)", spawnName, remaining)
		return true
	end

	refreshCompletionSpawns()
	if #completionSpawnParts == 0 then
		runtimeMessage = "Nenhum spawn encontrado para procurar carcaca"
		nextCarnivoreExploreCheck = tick() + SAVANNAH_CARCASS_SPAWN_WAIT
		return true
	end

	-- Round-robin: nunca escolhe aleatorio e so repete depois de passar
	-- por todos os spawns que aparecem na lista da aba Teleport.
	savannahCarcassSpawnIndex = savannahCarcassSpawnIndex % #completionSpawnParts + 1
	local destination = completionSpawnParts[savannahCarcassSpawnIndex]

	-- Se a lista mudou e o destino deixou de existir, atualiza e tenta no
	-- proximo ciclo, sem cair de volta na exploracao aleatoria antiga.
	if not destination or not destination.Parent then
		refreshCompletionSpawns()
		nextCarnivoreExploreCheck = tick() + 1
		return true
	end

	savannahCarcassCurrentSpawn = destination
	runtimeMessage = "Procurando carcaca: teleportando para " .. destination.Name
	local teleported = ragdollTeleport(destination.Position, 5)

	if teleported then
		runtimeMessage = "Procurando carcaca em " .. destination.Name .. " (15s)"
		nextCarnivoreExploreCheck = tick() + SAVANNAH_CARCASS_SPAWN_WAIT
	else
		runtimeMessage = "Falha ao teleportar para " .. destination.Name .. "; tentando proximo"
		nextCarnivoreExploreCheck = tick() + 2
	end

	return true
end

local function removeSwimBarrier()
	if swimBarrier then swimBarrier:Destroy(); swimBarrier = nil end
	swimAnchorPosition = nil
end

local function updateSwimBarrier(root, resetAnchor)
	if not swimBarrier then
		swimBarrier = Instance.new("Folder")
		swimBarrier.Name = "FarmLocalSwimBarrier"
		swimBarrier.Parent = workspace
		for index = 1, 4 do
			local wall = Instance.new("Part")
			wall.Name = "Wall" .. index
			wall.Anchored = true
			wall.CanCollide = true
			wall.CanTouch = false
			wall.CanQuery = false
			wall.Transparency = 1
			wall.Parent = swimBarrier
		end
	end
	if resetAnchor or not swimAnchorPosition then swimAnchorPosition = root.Position end
	local center = Vector3.new(swimAnchorPosition.X, root.Position.Y, swimAnchorPosition.Z)
	local walls = swimBarrier:GetChildren()
	if #walls >= 4 then
		walls[1].Size, walls[1].CFrame = Vector3.new(16,18,2), CFrame.new(center + Vector3.new(0,0,7))
		walls[2].Size, walls[2].CFrame = Vector3.new(16,18,2), CFrame.new(center + Vector3.new(0,0,-7))
		walls[3].Size, walls[3].CFrame = Vector3.new(2,18,16), CFrame.new(center + Vector3.new(7,0,0))
		walls[4].Size, walls[4].CFrame = Vector3.new(2,18,16), CFrame.new(center + Vector3.new(-7,0,0))
	end
end

-- Crocodile: rota exclusiva de bebida pela margem.
-- MainWaterPart cobre uma area enorme e continua por baixo do Terrain.
-- Por isso NAO procuramos "onde existe agua" no X/Z: ela existe praticamente
-- em todo lugar. A margem e encontrada comparando o topo do Terrain SOLIDO
-- com a altura da superficie da MainWaterPart. Enquanto o Terrain estiver
-- acima da agua, ela esta enterrada e e ignorada. Quando o Terrain desce para
-- baixo do nivel da agua, aquela agua passa a estar exposta.
CROC.solidTerrainParams = RaycastParams.new()
CROC.solidTerrainParams.FilterType = Enum.RaycastFilterType.Include
CROC.solidTerrainParams.FilterDescendantsInstances = { workspace.Terrain }
CROC.solidTerrainParams.IgnoreWater = true
CROC.lastShoreDirection = nil
CROC.lastShorePosition = nil

function CROC.findPrideRockSpawn1()
	local spawns = workspace:FindFirstChild("Spawns")
	if not spawns then return nil end
	local part = spawns:FindFirstChild("PrideRockSpawn1", true)
	if part and part:IsA("BasePart") then return part end
	return nil
end

function CROC.getWaterSurfaceY()
	local waterPart = workspace:FindFirstChild("MainWaterPart")
	if not waterPart or not waterPart:IsA("BasePart") then return nil, nil end
	return waterPart.Position.Y + waterPart.Size.Y / 2, waterPart
end

function CROC.solidTerrainHitAt(position, castY)
	return workspace:Raycast(
		Vector3.new(position.X, castY, position.Z),
		Vector3.new(0, -1200, 0),
		CROC.solidTerrainParams
	)
end

function CROC.findVisibleShoreFrom(origin)
	local waterY = CROC.getWaterSurfaceY()
	if not waterY then return nil end

	local castY = math.max(origin.Y, waterY) + 350
	local maxRadius = 900
	local step = 5
	local directions = 72
	local exposureDepth = 0.75
	local bestPosition, bestDirection, bestDistance

	local function waterIsExposedAt(position)
		local hit = CROC.solidTerrainHitAt(position, castY)
		-- Sem Terrain solido acima/na superficie = agua visivel.
		if not hit then return true, nil end
		return hit.Position.Y <= waterY - exposureDepth, hit
	end

	for index = 0, directions - 1 do
		local angle = index / directions * math.pi * 2
		local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local lastDryDistance = nil
		local lastDryHit = nil

		for distance = 0, maxRadius, step do
			local probe = origin + direction * distance
			local exposed, hit = waterIsExposedAt(probe)

			if exposed then
				if lastDryDistance and lastDryHit then
					-- Refina a transicao terra -> agua para achar a margem real.
					local low = lastDryDistance
					local high = distance
					for _ = 1, 8 do
						local mid = (low + high) / 2
						local midExposed = waterIsExposedAt(origin + direction * mid)
						if midExposed then
							high = mid
						else
							low = mid
						end
					end

					-- Fica um pouco ANTES do inicio da agua. Assim o corpo permanece
					-- no Terrain, mas a cabeca fica perto o bastante para beber.
					local shoreDistance = math.max(0, low - 1.25)
					local shoreProbe = origin + direction * shoreDistance
					local shoreHit = CROC.solidTerrainHitAt(shoreProbe, castY) or lastDryHit

					if shoreHit and (not bestDistance or shoreDistance < bestDistance) then
						bestDistance = shoreDistance
						bestPosition = shoreHit.Position
						bestDirection = direction
					end
				end
				break
			end

			lastDryDistance = distance
			lastDryHit = hit
		end
	end

	return bestPosition, bestDirection, bestDistance
end

function CROC.teleportToPrideRock(prideRock)
	if state.busy then return false end
	state.busy = true
	local character, root, humanoid = characterParts()
	if not character or not root or not humanoid then state.busy = false return false end

	local target = prideRock.Position + Vector3.new(0, math.max(humanoid.HipHeight, 2) + 2, 0)
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	for _ = 1, 45 do
		if not character.Parent or not root.Parent then break end
		character:PivotTo(CFrame.new(target) * prideRock.CFrame.Rotation)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		RunService.Heartbeat:Wait()
	end
	if humanoid.Parent then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
	for _ = 1, 4 do
		if not character.Parent then break end
		character:SetAttribute("MovementDisabled", false)
		task.wait(0.08)
	end
	state.busy = false
	return root.Parent and (root.Position - target).Magnitude <= 18
end

function CROC.approachDrink()
	if CROC.approachBusy or criticalRecoveryActive then return false end
	local character = player.Character
	if not character or not CROC.isCharacter(character) then return false end

	CROC.approachBusy = true
	removeSwimBarrier()
	drinkingSourcePosition = nil
	CROC.lastShoreDirection = nil
	CROC.lastShorePosition = nil

	-- Para o Croco a agua fica colidivel. A diferenca agora e que ele NAO e
	-- teleportado para ela: sai do PrideRock e chega fisicamente ate a margem.
	local _, waterPart = CROC.getWaterSurfaceY()
	if waterPart then waterPart.CanCollide = true end

	local prideRock = CROC.findPrideRockSpawn1()
	if not prideRock then
		runtimeMessage = "Croco: PrideRockSpawn1 nao encontrado"
		CROC.approachBusy = false
		return false
	end

	local _, currentRoot = characterParts()
	local prideDistance = currentRoot and (currentRoot.Position - prideRock.Position).Magnitude or math.huge
	if prideDistance > 28 then
		runtimeMessage = "Croco: TP -> PrideRockSpawn1"
		if not CROC.teleportToPrideRock(prideRock) then
			runtimeMessage = "Croco: falhou TP PrideRockSpawn1"
			CROC.approachBusy = false
			return false
		end
	else
		runtimeMessage = "Croco: ja esta no PrideRockSpawn1"
	end

	task.wait(0.2)
	character, root = characterParts()
	if not character or not root or not CROC.isCharacter(character) then
		CROC.approachBusy = false
		return false
	end

	runtimeMessage = "Croco: procurando onde a agua sai do Terrain"
	local shorePosition, shoreDirection, shoreDistance = CROC.findVisibleShoreFrom(root.Position)
	if not shorePosition then
		runtimeMessage = "Croco: nao achei transicao Terrain -> agua"
		CROC.approachBusy = false
		return false
	end

	CROC.lastShoreDirection = shoreDirection
	CROC.lastShorePosition = shorePosition
	runtimeMessage = string.format("Croco: margem a %d studs; indo ate ela", math.floor(shoreDistance or 0))

	-- Croco anda com metade da velocidade normal para evitar o limitador do jogo.
	local moved = moveToGrass(shorePosition, 27.5)
	task.wait(0.25)
	character, root = characterParts()
	if character and root and CROC.isCharacter(character) then
		drinkingSourcePosition = root.Position
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		runtimeMessage = "Croco: na margem; bebendo"
		for _ = 1, 5 do
			setSubState("Drinking")
			task.wait(0.2)
		end
	end

	CROC.approachBusy = false
	return moved
end

local VirtualInputManager = game:GetService("VirtualInputManager")
local eatingStuckSince
local lastEatWatchdogFood

local function virtualEatKick()
	local character, root = characterParts()
	if not character or not root then return end

	local animal = character:GetAttribute("AnimalName") or ""
	if isCarnivoreCharacter(character) then
		runtimeMessage = "Comer sumiu (carnivoro); refazendo teleporte na carcaça"
		activeCarcass = nil -- força procurar carcaça de novo, pode ter sido consumida/sumido
		local carcass, carcassRoot = nearestCarcass(root)
		if carcass and carcassRoot and not carcassEatBusy then
			task.spawn(eatCarcass, carcass, carcassRoot)
		elseif not carcass then
			runtimeMessage = "Comer sumiu (carnivoro); nenhuma carcaça encontrada por perto"
		end

		eatingStuckSince = nil
		return
	end

	runtimeMessage = "Comer sumiu; forcando na grama com tecla E"

	local grass = findNearestGrass(root.Position) or findDistantGrass(root.Position)
	if grass then moveToGrass(grass) end
	task.wait(0.2)

	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
		task.wait(0.05)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
	end)
	task.wait(0.2)

	state.autoEat = false
	if renders and renders.autoEat then renders.autoEat() end
	task.wait(0.3)
	state.autoEat = true
	if renders and renders.autoEat then renders.autoEat() end

	setSubState("Eating")
	eatingStuckSince = nil
end

local function autoEatStep()
	if state.questSwimActive then return end
	if not state.autoEat or state.busy or drinkingToFull or criticalRecoveryActive then return end
	local character, root = characterParts()
	if not character or not root then return end
	if carcassEatBusy then return end

	local food = character:GetAttribute("Food") or 100
	local carnivore = isCarnivoreCharacter(character)
	local questCarnivore = state.autoQuests and carnivore and not preSwitchFoodTarget

	-- Carnívoro durante Auto Quests:
	-- só interrompe as quests quando Food chegar a 70% ou menos.
	-- Depois que começa, continua procurando/comendo carcaça até 100%.
	if questCarnivore then
		if not state.questCarnivoreFeeding and food <= 70 then
			state.questCarnivoreFeeding = true
			eatingToFull = true
			runtimeMessage = "Carnivore: Food <= 70%; pausing quests to eat"
		end

		if state.questCarnivoreFeeding then
			if food >= 100 then
				state.questCarnivoreFeeding = false
				eatingToFull = false
				resetEatingSearch(food)
				activeCarcass = nil
				eatingStuckSince = nil
				runtimeMessage = "Carnivore full; returning to quests"
				return
			end
		else
			-- Acima de 70% o carnívoro não abandona Auto Run/Zone para caçar.
			return
		end
	elseif state.questCarnivoreFeeding then
		state.questCarnivoreFeeding = false
	end

	local foodCap = questCarnivore and 100 or (preSwitchFoodTarget or 92)
	if food >= foodCap then
		eatingToFull = false
		resetEatingSearch(food)
		activeCarcass = nil
		eatingStuckSince = nil
		return
	end

	local availableFood = detectAvailableFood(character)

	-- Herbívoro durante Auto Quests:
	-- o modo especial "Eat enquanto corre" só existe se ainda houver uma
	-- Travel/Land Distance incompleta. Sem missão de corrida, volta ao Auto Eat
	-- padrão: procura a grama e vai até ela normalmente.
	if state.autoQuests and state.questTravelActive
		and not preSwitchFoodTarget and not carnivore then
		if availableFood == "Eat" then
			eatingToFull = false
			eatingSourcePosition = nil
			eatingTargetReachedAt = nil
			eatingStuckSince = nil
			runtimeMessage = "Eating while running"

			if tick() - (state.questLastEatTapAt or 0) >= 0.8 then
				state.questLastEatTapAt = tick()
				pcall(function()
					VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
					task.wait(0.04)
					VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
				end)
				setSubState("Eating")
			end
			return
		end

		if not eatingToFull and food > 68 then
			return
		end
	end

	eatingToFull = true

	if lastEatWatchdogFood == nil or food > lastEatWatchdogFood then
		lastEatWatchdogFood = food
		eatingStuckSince = tick()
	elseif not eatingStuckSince then
		eatingStuckSince = tick()
	end
	if eatingStuckSince and tick() - eatingStuckSince >= 15 then
		lastEatWatchdogFood = food
		eatingStuckSince = tick()
		virtualEatKick()
		return
	end

	if carnivore then
		if carcassEatBusy then return end

		local carcass = activeCarcass
		local carcassRoot = carcass and (
			carcass:FindFirstChild("HumanoidRootPart")
			or carcass:FindFirstChildWhichIsA("BasePart", true)
		)

		if not carcassRoot then
			carcass, carcassRoot = nearestCarcass(root)
		end

		if carcass and carcassRoot then
			runtimeMessage = questCarnivore
				and string.format("Carnivore feeding to 100%% (Food %d%%)", math.floor(food))
				or "Indo comer carcaça"
			task.spawn(eatCarcass, carcass, carcassRoot)
		else
			runtimeMessage = questCarnivore
				and string.format("Carnivore feeding: searching carcass (Food %d%%)", math.floor(food))
				or "Carnivoro sem carcaça por perto"

			if isSavannahLife then
				exploreSavannahCarcassSpawns()
			elseif tick() >= nextCarnivoreExploreCheck then
				nextCarnivoreExploreCheck = tick() + 20
				local spot = findSafeTerrainSpot(root.Position, 20, 60)
				if spot then
					runtimeMessage = "Procurando carcaça em outra area (terreno seguro)"
					ragdollTeleport(spot)
				end
			end
		end
		return
	end

	if food <= 55 and tick() >= nextEmergencyGrassCheck then
		nextEmergencyGrassCheck = tick() + 120
		local distantGrass = findDistantGrass(root.Position)
		if distantGrass then
			runtimeMessage = "Fome critica; teleportando para outra area com grama"
			resetEatingSearch(food)
			ragdollTeleport(distantGrass)
			task.wait(0.4)
			return
		else
			runtimeMessage = "Fome critica; nenhuma area distante encontrada"
		end
	end

	if availableFood == "Eat" then
		eatingSourcePosition = root.Position
		eatingTargetReachedAt = tick()
		runtimeMessage = "Comendo a grama proxima"
		setSubState("Eating")
		return
	end

	if eatingSourcePosition and eatingTargetReachedAt
		and (root.Position - eatingSourcePosition).Magnitude <= 10
		and tick() - eatingTargetReachedAt < 5 then
		runtimeMessage = "Tentando comer na grama atual"
		setSubState("Eating")
		return
	end

	local grass = findNearestGrass(root.Position)
	if not grass then
		runtimeMessage = "Nenhuma grama detectada por perto"
		return
	end

	runtimeMessage = "Indo para uma grama proxima"
	moveToGrass(grass)
	task.wait(0.2)
	eatingSourcePosition = grass
	eatingTargetReachedAt = tick()

	local detectedAfterMove = detectAvailableFood(character)
	if detectedAfterMove == "Eat" or not GameUtils or not AnimalConfig then
		setSubState("Eating")
	end
end

local function isPositionInWaterTerrain(position, radiusXZ, radiusY)
	radiusXZ = radiusXZ or 5
	radiusY = radiusY or 7

	local ok, materials, occupancies = pcall(function()
		local half = Vector3.new(radiusXZ, radiusY, radiusXZ)
		local region = Region3.new(position - half, position + half):ExpandToGrid(4)
		return workspace.Terrain:ReadVoxels(region, 4)
	end)
	if not ok or type(materials) ~= "table" then return false end

	-- ReadVoxels returns a 3D matrix. The old check only inspected [1][1][1],
	-- so it could report false even with the animal visibly inside water.
	for x = 1, #materials do
		local ys = materials[x]
		if type(ys) == "table" then
			for y = 1, #ys do
				local zs = ys[y]
				if type(zs) == "table" then
					for z = 1, #zs do
						if zs[z] == Enum.Material.Water then
							local occupancy = occupancies
								and occupancies[x]
								and occupancies[x][y]
								and occupancies[x][y][z]
							if occupancy == nil or occupancy > 0.05 then
								return true
							end
						end
					end
				end
			end
		end
	end

	return false
end

local function isStandingInWater(root)
	if not root then return false end

	local _, _, humanoid = characterParts()
	if humanoid and humanoid:GetState() == Enum.HumanoidStateType.Swimming then
		return true
	end

	if isPositionInWaterTerrain(root.Position, 6, 9) then
		return true
	end

	-- Probe several points around the body instead of one tiny 3-stud ray.
	local offsets = {
		Vector3.new(0, 5, 0),
		Vector3.new(0, 2, 0),
		Vector3.new(3, 3, 0),
		Vector3.new(-3, 3, 0),
		Vector3.new(0, 3, 3),
		Vector3.new(0, 3, -3),
	}
	for _, offset in ipairs(offsets) do
		local hit = workspace:Raycast(
			root.Position + offset,
			Vector3.new(0, -14, 0),
			terrainParams
		)
		if hit and hit.Material == Enum.Material.Water then
			return true
		end
	end

	return false
end

local function isValidSwimQuestWater(root)
	if not root then return false end

	if isStandingInWater(root) then
		return true
	end

	-- Wider scan used only for the known Swim farm location. Large animals can
	-- have their HRP above/below the water voxel even while the body is swimming.
	if isPositionInWaterTerrain(root.Position, 12, 16) then
		return true
	end

	-- The supplied farm point is known to be inside the swim area. If we are
	-- very close to it, force Swimming once and accept the area after physics
	-- has had a moment to update instead of teleporting forever.
	local target = state.questSwimPosition
	if target and (root.Position - target).Magnitude <= 28 then
		local _, _, humanoid = characterParts()
		if humanoid then
			pcall(humanoid.ChangeState, humanoid, Enum.HumanoidStateType.Swimming)
		end
		setSubState("Swimming")
		return true
	end

	return false
end

local forcingPostDrinkTeleport = false

local function ensureOnSolidGround(targetPosition, label)
	label = label or "solo seguro"
	criticalRecoveryActive = true

	-- Desliga comer/beber durante TODA a tentativa de sair do void/água —
	-- essas rotinas ficam mexendo na posição e brigam com o teleporte,
	-- fazendo o personagem cair de novo.
	state.autoEat, state.autoDrink = false, false
	if renders then
		if renders.autoEat then renders.autoEat() end
		if renders.autoDrink then renders.autoDrink() end
	end

	local totalAttempts = 14
	for attempt = 1, totalAttempts do
		ragdollTeleport(targetPosition, 8)
		task.wait(0.3)

		local character, root = characterParts()
		if character and root then
			local inVoid = root.Position.Y < config.dangerY
			local inWater = isStandingInWater(root)
			if not inVoid and not inWater then
				runtimeMessage = "Confirmado em " .. label
				criticalRecoveryActive = false
				return true
			end
			runtimeMessage = string.format(
				"Ainda preso (void:%s agua:%s); tentando de novo (%d/%d)",
				tostring(inVoid), tostring(inWater), attempt, totalAttempts
			)
		end
		task.wait(0.2)
	end

	runtimeMessage = "Não consegui confirmar saída do void/água após várias tentativas"
	criticalRecoveryActive = false
	return false
end

-- No Dino Life os AquaticNestRock1/2 ficam na água e são só uma PASSAGEM
-- pra sair do void — não são o destino final. Fluxo correto: 1) teleporta
-- pro Aquatic mais próximo e CONFIRMA que saiu do void, 2) só então
-- teleporta pro NestRock1 (destino final, em terra firme de verdade).
local function escapeDinoToSafety(label)
	label = label or "solo seguro"

	-- REGRA ABSOLUTA: o AquaticNestRock é EXCLUSIVO do watchdog de void.
	-- Se o personagem não estiver abaixo do dangerY, essa função não faz nada.
	local _, root = characterParts()
	if not root or root.Position.Y >= config.dangerY then
		return false
	end

	runtimeMessage = "VOID detectado; usando rota AquaticNestRock"

	local aquatic = findAquaticNestRock()
	if aquatic then
		ensureOnSolidGround(aquatic.Position, "AquaticNestRock (saindo do void)")
	end

	local nestRock1 = findNestRock1()
	if nestRock1 then
		return ensureOnSolidGround(nestRock1.Position, "NestRock1")
	end

	if not aquatic then
		runtimeMessage = "Void: nem AquaticNestRock nem NestRock1 encontrados"
	end
	return aquatic ~= nil
end


function DAMAGE.modeName()
	if state.growExisting then return "Grow Existing Slots" end
	if state.growNew then return "Grow New Slots" end
	if state.farmCoins then return "AFK Coin Farm" end
	return "modo atual"
end

function DAMAGE.isSafeSpawn(part)
	if not part or not part:IsA("BasePart") or not part.Parent then return false end

	local name = part.Name:lower()
	if name:find("aquatic", 1, true)
		or name:find("water", 1, true)
		or name:find("ocean", 1, true)
		or name:find("river", 1, true) then
		return false
	end

	return true
end

function DAMAGE.getNearestSafeSpawns(root)
	refreshCompletionSpawns()

	local candidates = {}
	for _, part in ipairs(completionSpawnParts) do
		if DAMAGE.isSafeSpawn(part) then
			table.insert(candidates, part)
		end
	end

	table.sort(candidates, function(a, b)
		return (a.Position - root.Position).Magnitude < (b.Position - root.Position).Magnitude
	end)

	return candidates
end

function DAMAGE.teleportToSafety()
	local character, root = characterParts()
	if not character or not root then return false, nil end

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	if waterPart and waterPart:IsA("BasePart") then
		waterPart.CanCollide = false
	end

	local candidates = DAMAGE.getNearestSafeSpawns(root)
	for _, spawnPart in ipairs(candidates) do
		runtimeMessage = "Watchdog: fugindo para " .. spawnPart.Name

		local ok = ragdollTeleport(spawnPart.Position, 5)
		task.wait(0.25)

		local _, newRoot = characterParts()
		if ok and newRoot and not isStandingInWater(newRoot) then
			return true, spawnPart
		end
	end

	local fallback = getSafeFarmPosition()
	if fallback then
		runtimeMessage = "Watchdog: usando ponto seguro alternativo"
		local ok = ragdollTeleport(fallback, 5)
		task.wait(0.25)

		local _, newRoot = characterParts()
		if ok and newRoot and not isStandingInWater(newRoot) then
			return true, nil
		end
	end

	return false, nil
end

function DAMAGE.recover(character, humanoid, healthBefore, healthAfter, reason, forceMinimumWait)
	if DAMAGE.active or tick() < DAMAGE.cooldownUntil then return end
	if character ~= player.Character or not humanoid.Parent or humanoid.Health <= 0 then return end

	DAMAGE.active = true

	local previousCriticalRecovery = criticalRecoveryActive
	local previousAutoEat = state.autoEat
	local previousAutoDrink = state.autoDrink
	local previousMode = DAMAGE.modeName()

	criticalRecoveryActive = true
	state.autoEat = false
	state.autoDrink = false
	removeSwimBarrier()
	drinkingToFull = false
	eatingToFull = false
	activeCarcass = nil
	drinkingSourcePosition = nil

	if renders then
		if renders.autoEat then renders.autoEat() end
		if renders.autoDrink then renders.autoDrink() end
	end

	local maxHealth = math.max(humanoid.MaxHealth, 1)
	local lostPercent = math.max(0, math.floor(((healthBefore - healthAfter) / maxHealth) * 100 + 0.5))

	if reason == "critical" then
		runtimeMessage = string.format(
			"Watchdog CRITICO: vida em %d%%; fugindo agora",
			math.floor((healthAfter / maxHealth) * 100)
		)
	elseif reason == "slow" then
		runtimeMessage = string.format(
			"Watchdog: vida caindo sem controle (-%d%%); fugindo",
			lostPercent
		)
	else
		runtimeMessage = string.format("Watchdog: dano alto (-%d%%); fugindo", lostPercent)
	end

	-- Espera brevemente uma ação anterior liberar state.busy.
	local busyDeadline = tick() + 2
	while state.busy and tick() < busyDeadline and state.alive do
		task.wait(0.05)
	end

	-- Emergência tem prioridade.
	if state.busy then
		state.busy = false
	end

	local escaped, safeSpawn = DAMAGE.teleportToSafety()

	character = player.Character
	humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if escaped and character and humanoid and humanoid.Health > 0 then
		local food = character:GetAttribute("Food") or 0
		local water = character:GetAttribute("Water") or 0
		local waitStartedAt = tick()
		local minimumWaitUntil = forceMinimumWait and (waitStartedAt + DAMAGE.criticalMinWait) or waitStartedAt

		if forceMinimumWait then
			while state.alive
				and character == player.Character
				and humanoid.Parent
				and humanoid.Health > 0
				and tick() < minimumWaitUntil do

				runtimeMessage = string.format(
					"Watchdog CRITICO: recuperando em %s (%ds)",
					safeSpawn and safeSpawn.Name or "local seguro",
					math.max(0, math.ceil(minimumWaitUntil - tick()))
				)
				task.wait(0.5)
			end
		end

		food = character:GetAttribute("Food") or 0
		water = character:GetAttribute("Water") or 0

		if food >= DAMAGE.safeFoodWater and water >= DAMAGE.safeFoodWater then
			local startHealth = humanoid.Health
			local targetHealth = math.min(
				humanoid.MaxHealth,
				startHealth + humanoid.MaxHealth * DAMAGE.targetHealFraction
			)
			local deadline = tick() + DAMAGE.maxRecoveryWait

			while state.alive
				and character == player.Character
				and humanoid.Parent
				and humanoid.Health > 0
				and tick() < deadline
				and humanoid.Health < targetHealth do

				food = character:GetAttribute("Food") or 0
				water = character:GetAttribute("Water") or 0

				if food < DAMAGE.safeFoodWater or water < DAMAGE.safeFoodWater then
					break
				end

				runtimeMessage = string.format(
					"Watchdog: recuperando vida em %s (%ds)",
					safeSpawn and safeSpawn.Name or "local seguro",
					math.max(0, math.ceil(deadline - tick()))
				)
				task.wait(0.5)
			end
		elseif not forceMinimumWait then
			runtimeMessage = string.format(
				"Watchdog: Food %d%% Water %d%%; retomando para repor",
				math.floor(food),
				math.floor(water)
			)
			task.wait(1)
		end
	elseif not escaped then
		runtimeMessage = "Watchdog: nenhum spawn seguro confirmado"
		task.wait(0.5)
	end

	state.autoEat = previousAutoEat
	state.autoDrink = previousAutoDrink

	if state.farmCoins or state.growExisting or state.growNew then
		state.autoEat = true
		state.autoDrink = true
	end

	if renders then
		if renders.autoEat then renders.autoEat() end
		if renders.autoDrink then renders.autoDrink() end
	end

	criticalRecoveryActive = previousCriticalRecovery
	DAMAGE.active = false
	DAMAGE.cooldownUntil = tick() + 6
	runtimeMessage = "Watchdog: seguro; retomando " .. previousMode
end

function DAMAGE.bind(character)
	if DAMAGE.connection then
		DAMAGE.connection:Disconnect()
		DAMAGE.connection = nil
	end

	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
		or character:WaitForChild("Humanoid", 10)
	if not humanoid then return end

	local lastHealth = humanoid.Health
	local windowStartHealth = nil
	local windowStartedAt = nil

	-- Maior vida observada na janela lenta.
	local slowPeakHealth = humanoid.Health
	local slowPeakAt = tick()

	DAMAGE.connection = humanoid.HealthChanged:Connect(function(newHealth)
		if not state.alive or character ~= player.Character then return end

		if newHealth <= 0 then
			lastHealth = newHealth
			return
		end

		local now = tick()
		local maxHealth = math.max(humanoid.MaxHealth, 1)

		if DAMAGE.active or now < DAMAGE.cooldownUntil then
			lastHealth = newHealth
			windowStartHealth = nil
			windowStartedAt = nil
			slowPeakHealth = newHealth
			slowPeakAt = now
			return
		end

		-- ALERTA MÁXIMO: bateu 50% ou menos, sai imediatamente.
		if newHealth <= maxHealth * DAMAGE.criticalHealthFraction then
			local before = math.max(lastHealth, slowPeakHealth, newHealth)
			lastHealth = newHealth
			windowStartHealth = nil
			windowStartedAt = nil
			slowPeakHealth = newHealth
			slowPeakAt = now
			task.spawn(DAMAGE.recover, character, humanoid, before, newHealth, "critical", true)
			return
		end

		-- Atualiza/reinicia a referência de vida alta da janela lenta.
		if newHealth > slowPeakHealth then
			slowPeakHealth = newHealth
			slowPeakAt = now
		elseif now - slowPeakAt > DAMAGE.slowWindowSeconds then
			-- A cada janela, carrega a vida atual como nova referência.
			-- Assim detecta uma queda prolongada em "degraus" sem depender de hit grande.
			slowPeakHealth = math.max(newHealth, lastHealth)
			slowPeakAt = now
		end

		-- Dano rápido: mantém a lógica anterior de 35% em até 4 segundos.
		if newHealth < lastHealth then
			if not windowStartedAt or now - windowStartedAt > DAMAGE.windowSeconds then
				windowStartedAt = now
				windowStartHealth = lastHealth
			end

			local baseline = windowStartHealth or lastHealth
			local loss = baseline - newHealth
			local fastThreshold = maxHealth * DAMAGE.dropFraction

			if loss >= fastThreshold then
				windowStartHealth = nil
				windowStartedAt = nil
				lastHealth = newHealth
				task.spawn(DAMAGE.recover, character, humanoid, baseline, newHealth, "fast", false)
				return
			end

			-- Dano lento/descontrolado: a vida pode ir caindo pouco a pouco.
			local slowLoss = slowPeakHealth - newHealth
			local slowThreshold = maxHealth * DAMAGE.slowDropFraction

			if slowLoss >= slowThreshold then
				local before = slowPeakHealth
				windowStartHealth = nil
				windowStartedAt = nil
				lastHealth = newHealth
				slowPeakHealth = newHealth
				slowPeakAt = now
				task.spawn(DAMAGE.recover, character, humanoid, before, newHealth, "slow", false)
				return
			end
		elseif newHealth > lastHealth then
			-- Regenerou: zera a janela rápida. A lenta conserva o novo pico.
			windowStartHealth = nil
			windowStartedAt = nil
			if newHealth >= slowPeakHealth then
				slowPeakHealth = newHealth
				slowPeakAt = now
			end
		end

		lastHealth = newHealth
	end)
end

