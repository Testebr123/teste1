		bestOwner = "Water"
		bestScore = math.max(waterScore, bestScore)
		bestReason =
			"Water transaction locked · "
			.. math.floor(water)
			.. "%"
		bestExclusive = true

	elseif foodTransaction
		and food <= 70
		and water > 25
		and (
			self.currentOwner == "Food"
			or physicalOwner == "Food"
			or (food < water and food <= 55)
		) then

		local foodScore =
			select(
				1,
				self:OwnerScore(
					"Food",
					context
				)
			)

		bestOwner = "Food"
		bestScore = math.max(foodScore, bestScore)
		bestReason =
			"Food transaction locked · "
			.. math.floor(food)
			.. "%"
		bestExclusive = true
	end

	-- Critical owners are selected from live state every election. Normal owners
	-- are informative/coordination state and do not block compatible background jobs.
	local changed = bestOwner ~= self.currentOwner or bestExclusive ~= self.exclusive
	if changed then
		local previous = self.currentOwner
		self.currentOwner = bestOwner
		self.currentReason = bestReason
		self.currentScore = bestScore
		self.currentSince = tick()
		self.exclusive = bestExclusive
		self.epoch += 1
		if bestOwner ~= previous then self.currentController = "DecisionEngine"; self.controllerLeaseUntil = 0 end
		if ai.Telemetry then
			ai.Telemetry:Push("SupervisorAuthority", "authority", {
				reason = bestReason,
				owner = bestOwner,
				result = tostring(previous) .. " -> " .. tostring(bestOwner) .. (bestExclusive and " [EXCLUSIVE]" or ""),
				debounce = 1,
			}, "authority:" .. tostring(bestOwner), "Supervisor authority: " .. tostring(bestOwner))
		end
	else
		self.currentReason = bestReason
		self.currentScore = bestScore
		self.exclusive = bestExclusive
	end
	context.supervisorOwner = self.currentOwner
	context.supervisorExclusive = self.exclusive
	context.supervisorReason = self.currentReason
	context.supervisorEpoch = self.epoch
	self.lastElectionAt = tick()
	return self.currentOwner, self.currentScore, self.exclusive
end

function Authority:RequestController(owner, controller, reason, severity)
	severity = tonumber(severity) or 500
	self:Signal(controller, owner, reason, severity, 4)
	self:Elect(ai.Blackboard)

	if self.exclusive and self.currentOwner ~= owner then
		return false
	end

	-- For an exclusive semantic owner, one recovery controller at a time. A stale
	-- controller lease expires quickly and can then be replaced by the Supervisor.
	if self.exclusive and self.currentOwner == owner then
		local now = tick()
		if self.currentController ~= "None"
			and self.currentController ~= "DecisionEngine"
			and self.currentController ~= controller
			and now < (self.controllerLeaseUntil or 0) then
			return false
		end
		self.currentController = controller
		self.controllerLeaseUntil = now + 3.5
	end
	return true
end

function Authority:PermitMovement(owner, purpose, target, options)
	self:Elect(ai.Blackboard)
	if self.exclusive and self.currentOwner ~= owner then
		return false, "Supervisor exclusive owner: " .. tostring(self.currentOwner)
	end
	return true, self.exclusive and "Supervisor exclusive permit" or "Supervisor coordinated permit"
end

function Authority:PermitsWorker(module, context)
	if not module or module.needsMovement ~= true then return true end
	self:Elect(context or ai.Blackboard)
	if not self.exclusive then return true end
	return module.owner == self.currentOwner
end

function Authority:ForceCancelOwner(owner, reason)
	if not ai.MovementManager or type(ai.MovementManager.CancelOwner) ~= "function" then return false end
	return ai.MovementManager:CancelOwner(owner, "SUPERVISOR: " .. tostring(reason), true)
end

function Authority:Enforce(context)
	context = context or ai.Blackboard

	-- Tick/Coordination/Reconcile can call Enforce back-to-back in the same
	-- scheduler slice. Reuse a fresh election instead of rescoring everything.
	if tick() - (self.lastElectionAt or 0) > 0.03 then
		self:Elect(context)
	end
	if not self.exclusive or self.currentOwner == "None" or not ai.MovementManager then return end
	for _, entry in ipairs(ai.MovementManager:ActualOwners(context)) do
		if entry.owner and entry.owner ~= self.currentOwner then
			self:ForceCancelOwner(entry.owner, "exclusive " .. self.currentOwner .. " authority")
		end
	end
	if state.safeMove and state.safeMove.active then
		local owner = ai.MovementManager:OwnerForPurpose(state.safeMove.reason)
		if owner ~= self.currentOwner then state.safeMove.cancelToken += 1 end
	end
	self.lastEnforceAt = tick()
end

function Authority:ProgressTimeout(owner, context)
	local _, food, water = self:Vitals(context)
	if owner == "Safety" then return 1.8 end
	if owner == "Food" then
		if state.herbivoreFoodRecovery
			and state.herbivoreFoodRecovery.active
			and state.herbivoreFoodRecovery.character == context.character then
			-- SafeMove has its own sub-second stall detector. Give a long Pride transit
			-- enough time to negotiate one obstacle before asking for a local replan.
			return food <= 25 and 8 or food <= 45 and 11 or 14
		end
		return food <= 25 and 5.5 or food <= 45 and 8 or 10
	end

	-- SafeMove already owns physical stall detection. The Supervisor must not
	-- destroy a valid Dino Water route after a 2-3 second frame/movement delay.
	if owner == "Water" then
		return water <= 25 and 8 or water <= 45 and 11 or 14
	end

	if owner == "Manual" then return 9 end
	if owner == "Quest" then return 12 end
	if owner == "Growth" then return 14 end
	if owner == "Slots" then return 12 end
	return 10
end

function Authority:ObserveProgress(context)
	if self.currentOwner == "Safety"
		and not self:SafetyHazard(
			context
		) then

		self:ReleaseStaleSafety(
			context,
			"Safety progress revalidated"
		)

		return
	end

	if not self.exclusive or self.currentOwner == "None" or not context.characterAlive then
		self.progressOwner = self.currentOwner
		self.progressPosition = context.position
		self.progressDistance = nil
		self.progressFood = context.food
		self.progressWater = context.water
		self.progressHealth = context.healthFraction
		self.progressAt = tick()
		return
	end
	local distance = ai.MovementManager and ai.MovementManager:DistanceToTarget(context) or nil
	if self.progressOwner ~= self.currentOwner then
		self.progressOwner = self.currentOwner
		self.progressPosition = context.position
		self.progressDistance = distance
		self.progressFood = context.food
		self.progressWater = context.water
		self.progressHealth = context.healthFraction
		self.progressAt = tick()
		return
	end
