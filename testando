	-- A Swim destination should NOT disable land obstacle avoidance across the
	-- whole map. Only the final approach near the saved water point becomes 3D
	-- Swimming movement.
	local swimActivationDistance =
		tonumber(options.swimActivationDistance) or 58

	local obstacleSign =
		tonumber(options.preferredObstacleSign)
		and (tonumber(options.preferredObstacleSign) >= 0 and 1 or -1)
		or (((player.UserId % 2) == 0) and 1 or -1)
	local stallCount = 0
	local lastDistance = math.huge
	local lastProgressAt = tick()
	local lastJumpAt = 0

	-- Track the SAME blocking object/terrain across frames. We steer first;
	-- Space is virtualized only if the obstacle persists or movement stalls.
	local lastBlockingInstance = nil
	local blockingSince = 0

	-- v4.2: ordinary rocks/trees need a COMMITTED geometric bypass. The old
	-- 48-degree per-frame steer kept recomputing toward the final target and could
	-- pin a large animal against the same boulder forever. This state remembers one
	-- side waypoint until the body has actually cleared the blocker.
	local objectBypass = {
		instance = nil,
		point = nil,
		sign = nil,
		untilAt = 0,
		startedAt = 0,
		radius = 0,
