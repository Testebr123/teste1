		local character, root = context.character, context.root

		if state.slotSwitchStagingActive ~= true
			and activeCarcassCommitted
			and activeCarcassStillExists() then
			self.progressAt = tick()
			self.progressPosition = context.position
			self.progressDistance = nil
			self.progressFood = context.food
			self.currentController = "CommittedCarcass"
			self.controllerLeaseUntil = tick() + 4
			if not carcassEatBusy then
				ai:RequestWorker("AutoEat", "resume SAME committed carcass", 0.05)
			end
			return
		end

		-- v5.1: Central Savannah herbivore recovery is a TRANSIT phase of Food.
		-- Generic ForceCancelOwner("Food") calls herbivoreFoodRecoveryFinish(),
		-- which destroyed the only legal path to Pride and then restarted AutoEat in
		-- a location where Growth intentionally forbids food movement. Preserve the
		-- transaction and rebuild only its physical route instead.
		if isSavannahLife
			and state.herbivoreFoodRecovery
			and state.herbivoreFoodRecovery.active
			and state.herbivoreFoodRecovery.character == character then

			if state.herbivoreFoodRecoveryRequestReplan then
				state.herbivoreFoodRecoveryRequestReplan(reason)
			end

			self.progressAt = tick()
			self.progressPosition = context.position
			self.progressDistance = nil
			self.progressFood = context.food
			self.currentController = "HerbivoreFoodRecovery"
			self.controllerLeaseUntil = tick() + 3.5
			return
		end

		if isDinoLife and character and root and state.dinoShorelineWaterProof
			and state.dinoShorelineWaterProof(character, root) then
			if state.dinoShorelineRecovery then state.dinoShorelineRecovery.deadlocked = true end
			self:Signal("FoodShorelineDeadlock", "Safety", "Food stalled while Dino remained in water", 1000, 5)
			self:Elect(context)
			state.startDinoShorelineFoodRecovery("Supervisor detected Food/water deadlock")
			return
		end
		self:ForceCancelOwner("Food", reason)
		nextCarnivoreExploreCheck = 0
		state.survivalArbiterReset(
			"Supervisor restarted stalled Food"
		)
		state.survivalArbiterAcquire(
			"food",
			context.food,
			context.water,
			"Supervisor restarted stalled Food"
		)
		if state.survivalBrainTakeover then
			state.survivalBrainTakeover(
				"food",
				"Supervisor forced fresh Food strategy"
			)
		end
		ai:RequestWorker(
			"AutoEat",
			"Supervisor forced fresh Food strategy",
			0.05
		)
		return
	end

	if owner == "Water" then
		local now = tick()
		local liveWaterRoute =
			state.safeMove
			and state.safeMove.active
			and (
				state.safeMove.reason == "water"
				or state.safeMove.reason == "water_search"
			)

		if liveWaterRoute then
			local physicalProgressAt =
				tonumber(state.safeMove.lastProgressAt)
				or tonumber(state.safeMove.startedAt)
				or now

			local lease =
				ai.MovementManager
				and ai.MovementManager.lease

			if lease and lease.owner == "Water" then
				physicalProgressAt = math.max(
					physicalProgressAt,
					tonumber(lease.lastProgressAt) or 0
				)
			end

			local schedulerLate =
				ai.Health
				and (
					now - (ai.Health.criticalAt or now) > 0.75
					or now - (ai.Health.coordinationAt or now) > 1.6
				)

			if schedulerLate
				or now - physicalProgressAt < 9.5 then
				self.progressAt = now
				return
			end
		end

		if now - (self.lastWaterRouteRestartAt or 0) < 8 then
			self.progressAt = now
			return
		end

		self.lastWaterRouteRestartAt = now
		self:ForceCancelOwner("Water", reason)
		if state.drinkSearch then
			state.drinkSearch.retryAfter = 0
			state.drinkSearch.currentWaterPoint = nil
		end
		if state.survivalBrainTakeover then
			state.survivalBrainTakeover(
				"water",
				"Supervisor restarted Water after verified 9.5s physical stall"
			)
		end
		return
	end

	self:ForceCancelOwner(owner, reason)
end

function Authority:Tick(context)
	context =
		context
		or ai.Blackboard

	if self.currentOwner == "Safety" then
		self:ReleaseStaleSafety(
			context,
			"Supervisor tick revalidated Safety"
		)
	end

	self:Elect(context)
	self:Enforce(context)
	self:ObserveProgress(context)
	context.supervisorOwner = self.currentOwner
	context.supervisorExclusive = self.exclusive
	context.supervisorReason = self.currentReason
