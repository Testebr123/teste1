	local function autoRunWaterNearby(root)
		if not root then
			return false
		end

		-- 16-38 stud buffer around the animal. This catches running parallel
		-- to a river, not only heading directly into it.
		for _, radiusProbe in ipairs({
			16,
			28,
			38,
		}) do
			local samples =
				radiusProbe == 16
					and 4
					or 8

			for index = 0, samples - 1 do
				local angleProbe =
					index / samples
						* math.pi * 2

				local point =
					root.Position
					+ Vector3.new(
						math.cos(angleProbe)
							* radiusProbe,
						0,
						math.sin(angleProbe)
							* radiusProbe
					)

				if autoRunWaterAt(
					point,
					root.Position.Y
				) then
					return true
				end
			end
		end

		return false
	end

	local function autoRunWaterAhead(
		root,
		direction
	)
		if not root
			or direction.Magnitude <= 0.05 then
			return false
		end

		for _, degrees in ipairs({
			-24,
			0,
			24,
		}) do
