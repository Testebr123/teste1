		or carcassEatBusy
		or BABOON.busy
		or GIRAFFE.busy
		or CROC.approachBusy
		or state.growthBusy
		or forcingPostDrinkMove
		or DAMAGE.active
		or state.drinkTest.active
		or state.questGrowthReset.exclusive
	if self:Mature("busy-orphan", state.busy and not busyHasOwner, 4) then
		self:Fix("busy-orphan", "orphan busy flag released", function()
			state.busy = false
			return true
		end)
	end

