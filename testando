local function rebuildMoveToList()
	refreshCompletionSpawns()
	for _, child in ipairs(spawnList:GetChildren()) do
		if child:IsA("TextButton") or child:IsA("TextLabel") then child:Destroy() end
	end
	if #completionSpawnParts == 0 then
		local empty = Instance.new("TextLabel")
		empty.Size = UDim2.new(1, 0, 0, 34)
		empty.BackgroundTransparency = 1
		empty.Font = FONT_BODY
		empty.TextColor3 = COLOR_SUBTEXT
		empty.TextSize = 11
		empty.Text = "No locations found in workspace.Spawns"
		empty.Parent = spawnList
		return
	end
	for _, part in ipairs(completionSpawnParts) do
		local destination = part
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, 0, 0, UserInputService.TouchEnabled and 36 or 30)
		button.BackgroundColor3 = COLOR_CARD_ON
		button.BorderSizePixel = 0
		button.Font = FONT_BUTTON
		button.TextColor3 = COLOR_TEXT
		button.TextSize =
			UserInputService.TouchEnabled
				and 12
				or 13
		button.TextWrapped = true
		button.Text = completionSpawnLabel(destination)
		button.AutoButtonColor = false
		button.Parent = spawnList
		corner(button, 15)
		button.Activated:Connect(function()
			if not destination.Parent then
				runtimeMessage = "That location no longer exists"
				rebuildMoveToList()
				return
			end
			selectedMoveToSpawn = destination
			runtimeMessage =
				"Moving safely to "
				.. completionSpawnLabel(
					destination
				)

			local currentCharacter =
				player.Character

			state.releaseMovementNow(
				currentCharacter,
				true
			)

			resetEatingSearch(
				currentCharacter
					and currentCharacter:GetAttribute(
						"Food"
					)
					or nil
			)

			local manualLabel =
				completionSpawnLabel(
					destination
				)

			local requestGeneration =
				state.beginManualMoveRequest(
					destination.Position,
					manualLabel
				)

			task.spawn(function()
				if not state.manualMoveRequestIsCurrent(
					requestGeneration
				) then
					return
				end

				local moved =
					safeMoveToPosition(
						destination.Position,
						10,
						nil,
						{
							purpose = "manual",
							manualLabel = manualLabel,
							allowWaterTransit = (isSavannahLife or isDinoLife),
							tolerance = 8,
							maxDuration = 420,
						}
					)

				if moved then
					state.finishManualMoveRequest(
						requestGeneration
					)
				end
			end)
		end)
	end
end
