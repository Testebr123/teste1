function state.drinkTestEnableSelfDamageGuard(character)
	local test = state.drinkTest

	test.selfDamageGuard = true
	test.fallDamageConfig = nil
	test.fallDamageConfigOld = nil

	if not character or not AnimalConfig then
		return
	end

	local animalType =
		character:GetAttribute(
			"AnimalType"
		)

	local animalName =
		character:GetAttribute(
			"AnimalName"
		)

	local configForAnimal =
		animalType
			and animalName
			and AnimalConfig[animalType]
			and AnimalConfig[animalType][animalName]

	if type(configForAnimal) == "table" then
		test.fallDamageConfig = configForAnimal
		test.fallDamageConfigOld =
			configForAnimal.DisableFallDamage

		configForAnimal.DisableFallDamage = true
	end
end

function state.drinkTestDisableSelfDamageGuard()
	local test = state.drinkTest

	-- Anti Fall Damage is SCOPED only to the Underground/Inside-Terrain Drink
	-- transaction. Restore the exact value that existed before entering Terrain.
	if test.fallDamageConfig then
		local oldValue = test.fallDamageConfigOld
		pcall(function()
			test.fallDamageConfig.DisableFallDamage = oldValue
		end)
	end

	test.fallDamageConfig = nil
	test.fallDamageConfigOld = nil
	test.selfDamageGuard = false
end

function state.drinkTestHealthHazard(humanoid)
	local test = state.drinkTest

	if not test
		or not test.active
		or not humanoid
		or humanoid.Health <= 0 then
		return false
	end

	local startHealth = tonumber(test.startHealth) or humanoid.Health
	local maxHealth = math.max(humanoid.MaxHealth, 1)
	local loss = math.max(0, startHealth - humanoid.Health)

	if loss < maxHealth * 0.035 then
		test.healthLossSince = 0
		test.healthLossLowest = humanoid.Health
		return false
	end

	test.healthLossLowest = math.min(
		tonumber(test.healthLossLowest) or humanoid.Health,
		humanoid.Health
	)

	-- A genuinely large hit remains immediate. Smaller drops must persist long
	-- enough to prove they are real rather than a Terrain/fall-state correction.
	if loss >= maxHealth * 0.15 then
		return true
	end

	if (tonumber(test.healthLossSince) or 0) <= 0 then
		test.healthLossSince = tick()
		return false
	end

	return tick() - test.healthLossSince >= 0.60
end

function state.drinkProgressReset()
	local data =
		state.drinkProgress

	data.confirmed = false
	data.lastWater = nil
	data.lastProgressAt = 0
	data.lastKickAt = 0

	if state.drinkTransactionGuardReset then
		state.drinkTransactionGuardReset()
	end
end

function state.drinkProgressConfirm(water)
	local data =
		state.drinkProgress

	data.confirmed = true
	data.lastWater =
		tonumber(water) or 0

	data.lastProgressAt =
		tick()

	local character =
		player.Character

	if character
		and state.aiSupervisorReleaseWaterSafetyForDrink then

		pcall(
