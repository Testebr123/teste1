	local circuitBlocked = ai.ModuleRegistry:CircuitBlocked(module, now)
	local authorityBypass = ai.Authority
		and ai.Authority.exclusive
		and module.vital
		and module.owner == ai.Authority.currentOwner
	if circuitBlocked and not authorityBypass then return false end
	if runtime.circuitHalfOpen then
		return self:OpenCircuit(
			module,
			"half-open verification failed: " .. tostring(reason),
			context,
			90
		)
	end

	local minimumGap = math.min(25, 2 + (runtime.recoveryLevel or 0) * 2.5)
	if now - (runtime.lastRecoveryAt or 0) < minimumGap then return false end

	-- L0 is a real, non-destructive diagnosis pass. A persistent failure must
	-- survive one fresh observation before any controller is touched.
	if runtime.levelZeroAt == nil then
		runtime.levelZeroAt = now
		runtime.lastRecoveryAt = now
		runtime.failureReason = tostring(reason or "no verified progress")
		runtime.status = "diagnosing"
		runtime.verificationDeadline = now + 2
		self.activeModule = module.name
		self.lastRecovery = {
			module = module.name,
			level = 0,
			reason = runtime.failureReason,
			at = now,
		}
		context.recoveryLevel = 0
		context.lastProblem = module.name .. ": " .. runtime.failureReason
		context.aiState = "RECOVER"
		context.currentAction = "Recovery L0 - diagnosing " .. module.name
		ai.Telemetry:Push(module.name, "diagnosis", {
			reason = runtime.failureReason,
			owner = module.owner,
			result = "L0 observation window",
		}, "recovery:" .. module.name .. ":L0",
			module.name .. " stalled - diagnosis level 0")
		return true
	end

	runtime.recoveryLevel = math.min(8, (runtime.recoveryLevel or 0) + 1)
	runtime.consecutiveFailures = (runtime.consecutiveFailures or 0) + 1
	runtime.lastRecoveryAt = now
	runtime.failureReason = tostring(reason or "no verified progress")
	runtime.status = "recovering"
	runtime.verificationDeadline = now + math.max(5, minimumGap)
	self.activeModule = module.name
	self.lastRecovery = {
		module = module.name,
		level = runtime.recoveryLevel,
		reason = runtime.failureReason,
		at = now,
	}
	context.recoveryLevel = runtime.recoveryLevel
	context.lastProblem = module.name .. ": " .. runtime.failureReason
	context.aiState = "RECOVER"
	context.currentAction = "Recovery L" .. runtime.recoveryLevel .. " - " .. module.name

	local strategy = module.name .. ":L" .. runtime.recoveryLevel
	local blocked = ai.Memory:IsBlocked("strategy", strategy)
	if blocked then
		runtime.recoveryLevel = math.min(8, runtime.recoveryLevel + 1)
		strategy = module.name .. ":L" .. runtime.recoveryLevel
		context.recoveryLevel = runtime.recoveryLevel
		context.currentAction = "Recovery L" .. runtime.recoveryLevel .. " - " .. module.name
		self.lastRecovery.level = runtime.recoveryLevel
	end

	local ok, result
	if type(module.recover) == "function" then
		ok, result = ai:SafeCall(
			"module.recover:" .. module.name,
			module.recover,
			runtime.recoveryLevel,
			runtime.failureReason,
			context,
			runtime
		)
	else
		ok, result = false, "no recovery callback"
	end

	ai.Memory:Remember("recoveries", strategy, runtime.failureReason, 600)
	if not ok or result == false then
		ai.Memory:MarkFailure("strategy", strategy, runtime.failureReason, 30)
	end
	ai.Telemetry:Push(module.name, "recovery", {
		reason = runtime.failureReason,
		owner = module.owner,
		result = ok and tostring(result) or "callback error",
		debounce = 5,
	}, "recovery:" .. strategy,
		module.name .. " stalled - recovery level " .. runtime.recoveryLevel)

	if runtime.recoveryLevel >= 8 and runtime.consecutiveFailures >= 4 then
		self:OpenCircuit(module, runtime.failureReason, context, 60)
	end
	return ok
end

ai.ProgressMonitor = {
	globalLastProgressAt = tick(),
}

function ai.ProgressMonitor:Changed(module, oldValue, newValue)
	if newValue == nil then return false end
	if oldValue == nil then return true end
	if type(newValue) == "number" and type(oldValue) == "number" then
		local epsilon = tonumber(module.progressEpsilon) or 0.01
		if module.progressDirection == "decrease" then
			return newValue < oldValue - epsilon
		end
		return newValue > oldValue + epsilon
	end
	return tostring(newValue) ~= tostring(oldValue)
end

function ai.ProgressMonitor:DynamicTimeout(module, context)
	if type(module.dynamicTimeout) == "function" then
		local ok, value = ai:SafeCall(
			"module.timeout:" .. module.name,
			module.dynamicTimeout,
			context,
			module.runtime
		)
		if ok and type(value) == "number" then
			return math.clamp(value, 4, 420)
		end
	end
	return math.clamp(tonumber(module.timeout) or 45, 4, 420)
end

function ai.ProgressMonitor:Report(name, value, reason)
	local module = ai.ModuleRegistry:Get(name)
	if not module then return false end
	local runtime = module.runtime
	runtime.lastValue = value
	runtime.lastProgressAt = tick()
	runtime.status = "working"
	self.globalLastProgressAt = tick()
	ai.Blackboard.lastProgressAt = tick()
	ai.Memory:Remember("progress", name, reason, 300)
	ai.RecoveryManager:Reset(module, reason)
	return true
end

function ai.ProgressMonitor:Sweep(context)
	local now = tick()
	local recoveryCandidates = {}
	local function queueRecovery(module, reason, source)
		table.insert(recoveryCandidates, {
			module = module,
			reason = tostring(reason or "no verified progress"),
			source = source,
		})
	end
	for _, name in ipairs(ai.ModuleRegistry.order) do
		local module = ai.ModuleRegistry.modules[name]
		local runtime = module.runtime
		local desired = ai.ModuleRegistry:Desired(module, context)

		if not desired then
			if module.circuitPersistsWhenIdle
				and (
					runtime.circuitHalfOpen
					or (runtime.circuitOpenUntil or 0) > 0
				) then
				local blocked, remaining, reason =
					ai.ModuleRegistry:CircuitBlocked(module, now)
				runtime.status = blocked and "circuit_open" or "revalidating"
				runtime.failureReason = reason
					or (blocked and string.format("circuit cooldown %.0fs", remaining))
				continue
			end
			if runtime.active or runtime.recoveryLevel > 0
				or runtime.circuitHalfOpen
				or (runtime.circuitOpenUntil or 0) > 0
				or ai.RecoveryManager.activeModule == name then
				ai.RecoveryManager:Reset(module, "module disabled or objective completed")
				ai.ModuleRegistry:ResetRuntime(name, "disabled")
			end
			continue
		end

		local circuitBlocked, circuitRemaining, circuitReason =
			ai.ModuleRegistry:CircuitBlocked(module, now)
		if circuitBlocked then
			runtime.active = false
			runtime.status = "circuit_open"
			runtime.failureReason = circuitReason
				or string.format("circuit cooldown %.0fs", circuitRemaining)
			if ai.RecoveryManager.activeModule == name then
				ai.RecoveryManager.activeModule = nil
			end
			continue
		end

		if not runtime.active then
			runtime.active = true
			runtime.activeSince = now
			runtime.lastProgressAt = now
			runtime.status = "observing"
		end

		local dependenciesReady, dependencyReason =
			ai.ModuleRegistry:DependenciesReady(module, context)
		if not dependenciesReady then
			runtime.status = "waiting"
			runtime.failureReason = dependencyReason
			runtime.waitingSince = runtime.waitingSince or now
			runtime.lastProgressAt = now
			continue
		end

		local expected = false
		if type(module.expectedProgress) == "function" then
			local ok, value = ai:SafeCall(
				"module.expected:" .. name,
				module.expectedProgress,
				context,
				runtime
			)
			expected = ok and value or false
		end
		runtime.lastExpected = expected

		local current
		if type(module.currentProgress) == "function" then
			local ok, value = ai:SafeCall(
				"module.progress:" .. name,
				module.currentProgress,
				context,
				runtime
			)
			if ok then current = value end
		end

		if runtime.circuitProbeBaselinePending then
			runtime.circuitProbeBaselinePending = false
			runtime.lastValue = current
			runtime.lastProgressAt = now
			runtime.status = "revalidating"
		elseif self:Changed(module, runtime.lastValue, current) then
			runtime.lastValue = current
			runtime.lastProgressAt = now
			runtime.status = "working"
			self.globalLastProgressAt = now
			context.lastProgressAt = now
			local keepQuestRecovery = name == "AutoQuests"
				and ai.QuestTracker:StalledQuest(now, context) ~= nil
			if not keepQuestRecovery then
				ai.RecoveryManager:Reset(module, "objective progress verified")
			end
		elseif current ~= nil and runtime.lastValue == nil then
			runtime.lastValue = current
		end

		local health = { healthy = true, waiting = false }
		if type(module.healthCheck) == "function" then
			local ok, result = ai:SafeCall(
				"module.health:" .. name,
				module.healthCheck,
				context,
				runtime
			)
			if ok then
				if type(result) == "table" then
					health = result
				elseif result == false then
					health = { healthy = false, reason = "health check failed" }
				end
			else
				health = { healthy = false, reason = tostring(result) }
			end
		end

		if health.waiting then
			runtime.status = "waiting"
			runtime.failureReason = health.reason
			runtime.waitingSince = runtime.waitingSince or now
			-- Legitimate dependency waits are excluded from the stall clock.
			runtime.lastProgressAt = now
			continue
		end
		if runtime.waitingSince then
			runtime.waitingSince = nil
			runtime.lastProgressAt = now
			runtime.lastValue = current
			runtime.status = "observing"
		end

		-- Resource/quest/growth progress can legitimately stay flat while its
		-- owned SafeMove is closing distance. Movement owns recovery for that
		-- phase; keep the dependent objective's clock paused until arrival or a
		-- real movement stall, rather than shrinking a distance-based timeout.
		local lease = ai.MovementManager.lease
		local movementDependencyHealthy = lease
			and module.name ~= "Movement"
			and module.owner == lease.owner
			and state.safeMove.active == true
			and now - (tonumber(lease.lastProgressAt) or 0) <= 3.5
		if movementDependencyHealthy and health.healthy ~= false then
			runtime.status = "moving"
			runtime.failureReason = "owned route is making verified distance progress"
			runtime.lastProgressAt = now
			continue
		end

		if runtime.watchdogFailure then
			runtime.status = "stalled"
			queueRecovery(module, runtime.watchdogFailure, "watchdog")
			continue
		elseif health.healthy == false then
			runtime.status = "stalled"
			ai.Telemetry:Push(name, "stall", {
				reason = health.reason or "health check failed",
				owner = module.owner,
			})
			queueRecovery(module, health.reason or "health check failed", "health")
			continue
		end

		local timeout = self:DynamicTimeout(module, context)
		if expected
			and now - (runtime.lastProgressAt or now) >= timeout then
			runtime.status = "stalled"
			local reason = type(expected) == "string"
				and (expected .. " made no objective progress")
				or "expected progress did not change"
			ai.Telemetry:Push(name, "stall", {
				reason = reason,
				owner = module.owner,
				result = string.format("%.1fs", now - runtime.lastProgressAt),
			})
			queueRecovery(module, reason, "timeout")
		elseif runtime.status ~= "recovering" then
			runtime.status = expected and "working" or "healthy"
		end
		if runtime.circuitHalfOpen
			and not expected
			and health.healthy ~= false
			and now - (runtime.circuitProbeStartedAt or now) >= 6 then
			ai.RecoveryManager:Reset(module, "half-open health verification passed")
		end
		if (runtime.recoveryLevel > 0 or runtime.levelZeroAt ~= nil)
			and now >= (runtime.verificationDeadline or 0)
			and not expected
			and health.healthy ~= false then
			ai.RecoveryManager:Reset(module, "post-recovery health verified")
		end
	end

	if #recoveryCandidates == 0 then return end
	local active = ai.RecoveryManager.activeModule
	local activeModule = active and ai.ModuleRegistry:Get(active) or nil
	local activeVerifying = activeModule
		and now < (activeModule.runtime.verificationDeadline or 0)
	local primaryModule = context.primaryModule
		or ai.GoalManager.currentModule
		or ai.GoalManager:ModuleForGoal(context.primaryGoal)
	local best
	local bestScore = -math.huge
	for _, candidate in ipairs(recoveryCandidates) do
		local module = candidate.module
		local allowed = true
		if activeVerifying and activeModule ~= module then
			allowed = module.owner == "Safety"
				and activeModule.owner ~= "Safety"
		end
		if allowed and activeModule and activeModule ~= module
			and activeModule.interruptible == false
			and module.owner ~= "Safety" then
			allowed = false
		end
		if allowed and activeModule and activeModule ~= module
			and ai.ModuleRegistry:ConflictsWith(module, activeModule)
			and (tonumber(module.priority) or 0) <= (tonumber(activeModule.priority) or 0)
			and module.owner ~= "Safety" then
			allowed = false
		end
		if allowed then
			local score = tonumber(module.priority) or 0
			if module.name == primaryModule then score += 140 end
			if active == module.name then score += 75 end
			if module.owner == "Safety" then score += 300 end
			local goalChoice = ai.GoalManager.lastChoice
			if goalChoice and goalChoice.owner == module.owner then score += 60 end
			if score > bestScore then
				best = candidate
				bestScore = score
			end
		end
	end
	if best then
		ai.RecoveryManager:Trigger(best.module, best.reason, context)
	end
end

function ai:ReportProgress(name, value, reason)
	return self.ProgressMonitor:Report(name, value, reason)
end

ai.SanityAudit = {
	timers = {},
	lastFixAt = {},
}

function ai.SanityAudit:Mature(key, condition, seconds)
	if not condition then
		self.timers[key] = nil
		return false
	end
	local now = tick()
	self.timers[key] = self.timers[key] or now
	return now - self.timers[key] >= (tonumber(seconds) or 3)
end

function ai.SanityAudit:Fix(key, reason, callback)
	local now = tick()
	if now - (self.lastFixAt[key] or 0) < 3 then return false end
	self.lastFixAt[key] = now
	local ok, result = ai:SafeCall("sanity:" .. key, callback)
	ai.Blackboard.lastProblem = reason
	ai.Telemetry:Push("SanityAudit", "auto-heal", {
		reason = reason,
		result = ok and tostring(result) or "error",
	}, "sanity:" .. key, "Auto-heal: " .. reason)
	self.timers[key] = nil
	return ok
end

function ai.SanityAudit:Run(context)
	local safeMove = state.safeMove
	local invalidSafeMove = safeMove.active
		and (typeof(safeMove.target) ~= "Vector3" or type(safeMove.reason) ~= "string")
	if self:Mature("safeMove-invalid", invalidSafeMove, 2) then
		self:Fix("safeMove-invalid", "orphan SafeMove reference removed", function()
			safeMove.cancelToken += 1
			return true
		end)
	end

	local routeOwner = safeMove.active
		and ai.MovementManager:OwnerForPurpose(safeMove.reason)
		or nil
	local disabledRoute = routeOwner
		and not ai.MovementManager:IsOwnerEnabled(routeOwner, context)
	if self:Mature("disabled-route", disabledRoute, 1.5) then
		self:Fix("disabled-route", "disabled module released movement", function()
			ai.MovementManager:CancelOwner(routeOwner, "owner disabled")
			return true
		end)
	end

