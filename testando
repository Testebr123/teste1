task.spawn(function()
	local radius = 30
	local center
	local angle = 0
	local trackedCharacter
	local wasMoving = false
	local wasSwimming = false

	while state.alive do
		local character, root = characterParts()
		local food = character and (character:GetAttribute("Food") or 100) or 100
		local water = character and (character:GetAttribute("Water") or 100) or 100

		local swimMove = state.autoQuests
			and state.questSwimActive
			and state.questSwimReady

		local landMove = state.autoQuests
			and questTravelWanted
			and not state.questSwimActive

		local buriedNow = character
			and root
			and not isDinoLife
			and state.drinkIsBuriedUnderTerrain(root)

		local commonSafe = not questSwitchingAnimal
			and not state.busy
			and not criticalRecoveryActive
			and not DAMAGE.active
			and not carcassEatBusy
			and not CROC.approachBusy
			and not forcingPostDrinkTeleport
			and not state.questGrowthReset.exclusive
			and not state.questCarnivoreFeeding
			and not state.questBaboonFeeding
			and not state.questGiraffeFeeding
			and not BABOON.busy
			and not GIRAFFE.busy
			and not buriedNow
			and character and root

		local canMove = commonSafe and (
			swimMove
			or (
				landMove
				and not drinkingToFull
				and not eatingToFull
				and food > 68
				and (
					water > 75
					or (
						tick() < (state.drinkSearch.retryAfter or 0)
						and water > 45
					)
				)
			)
		)

		if canMove and swimMove then
			-- Cheap watchdog: the known swim circle is entirely inside water.
			-- Only leaving the area triggers re-verification/teleport; no heavy
			-- ReadVoxels call every second while we're already swimming correctly.
			local swimCenter = state.questSwimPosition
			local dx = root.Position.X - swimCenter.X
			local dz = root.Position.Z - swimCenter.Z
			if math.sqrt(dx * dx + dz * dz) > 92 then
				state.questSwimReady = false
				canMove = false
				questStatusText = "Swim: left farm area; repositioning"
			end
		end

		if canMove then
			state.questMotionMoving = true
			state.questMotionMode = swimMove and "Swimming" or "Land"

			-- Land and Swim now use the same forward-input model.
			local wantsMoveW = (landMove and state.questLandInputActive) or swimMove
			state.questSetW(wantsMoveW)

			if trackedCharacter ~= character
				or not center
				or wasSwimming ~= swimMove
				or (not swimMove and (root.Position - center).Magnitude > 80) then

				trackedCharacter = character
				wasSwimming = swimMove
				center = swimMove and state.questSwimPosition or root.Position
				angle = 0
			end

			if tick() - (state.questLastSubStateAt or 0) >= (swimMove and 1.25 or 0.75) then
				state.questLastSubStateAt = tick()
				blockClientSubState = false
				setSubState(swimMove and "Swimming" or (state.questMoveSubState or "Running"))
				blockClientSubState = false
			end

			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local loopDt = state.questSwimActive and 0.03 or 0.05

			if swimMove then
				-- SAME engine as Land Auto Run.
				-- The only swim-specific pieces are:
				--   1) center is the verified underwater farm point;
				--   2) radius is kept inside the known water area;
				--   3) vertical correction keeps the animal submerged;
				--   4) substate stays Swimming.
				local speed = getQuestMoveSpeed(character)
				local moveRadius = 30
				angle += (speed / moveRadius) * 0.05

				local target = Vector3.new(
					center.X + math.cos(angle) * moveRadius,
					center.Y,
					center.Z + math.sin(angle) * moveRadius
				)

				local flat = Vector3.new(
					target.X - root.Position.X,
					0,
					target.Z - root.Position.Z
				)

				if flat.Magnitude > 0.1 then
					local direction = flat.Unit
					local velocity = root.AssemblyLinearVelocity

					pcall(function()
						root.CFrame = CFrame.lookAt(
							root.Position,
							root.Position + direction,
							Vector3.yAxis
						)
					end)

					if humanoid then
						pcall(humanoid.Move, humanoid, Vector3.new(0, 0, -1), true)
					end

					-- Same horizontal velocity as Land Auto Run.
					-- Only add a small Y correction so it cannot float out of or sink
					-- beneath the swimming layer.
					local yError = center.Y - root.Position.Y
					local yVelocity = math.clamp(yError * 2.2, -8, 8)

					root.AssemblyLinearVelocity = Vector3.new(
						direction.X * speed,
						yVelocity,
						direction.Z * speed
					)

					wasMoving = true
				end
			else
				local speed = getQuestMoveSpeed(character)
				local moveRadius = radius
				angle += (speed / moveRadius) * 0.05

				local target = Vector3.new(
					center.X + math.cos(angle) * moveRadius,
					root.Position.Y,
					center.Z + math.sin(angle) * moveRadius
				)

				local flat = Vector3.new(
					target.X - root.Position.X,
					0,
					target.Z - root.Position.Z
				)

				if flat.Magnitude > 0.1 then
					local direction = flat.Unit
					local velocity = root.AssemblyLinearVelocity

					if landMove and state.questLandInputActive then
						pcall(function()
							root.CFrame = CFrame.lookAt(
								root.Position,
								root.Position + direction,
								Vector3.yAxis
							)
						end)
					end

					root.AssemblyLinearVelocity = Vector3.new(
						direction.X * speed,
						velocity.Y,
						direction.Z * speed
					)
					wasMoving = true
				end
			end
		else
			state.questMotionMoving = false
			state.questMotionMode = nil
			state.questSetW(false)

			if root then
				local stopCharacter = player.Character
				local stopHumanoid = stopCharacter
					and stopCharacter:FindFirstChildOfClass("Humanoid")
				if stopHumanoid then
					pcall(stopHumanoid.Move, stopHumanoid, Vector3.zero, false)
				end
			end

			wasMoving = false
			wasSwimming = false
			center = nil
			state.questMotionCal.key = nil
			state.questMotionCal.targetSpeed = 0
			state.questMotionCal.actualSpeed = 0
			blockClientSubState = false
		end

		task.wait(state.questSwimActive and 0.03 or 0.05)
	end
end)

