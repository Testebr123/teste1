function state.drinkVisualPromptVisible()
	local data = state.drinkVisualPrompt
	local now = tick()

	if now - (data.at or 0) < 0.10 then
		return data.visible == true
	end

	data.at = now
	data.visible = false

	local playerGui =
		player:FindFirstChildOfClass("PlayerGui")

	if not playerGui then
		return false
	end

	local camera = workspace.CurrentCamera
	local viewport =
		camera and camera.ViewportSize
		or Vector2.new(1280, 720)

	for _, object in ipairs(
		playerGui:GetDescendants()
	) do
		if (
			object:IsA("TextLabel")
			or object:IsA("TextButton")
			or object:IsA("TextBox")
		)
			and object.Visible
			and object.TextTransparency < 0.95 then

			local raw =
				tostring(object.Text or "")

			local lower = raw:lower()

			-- v94: Savannah can render the key [E] separately.
			-- In the strict bottom-center interaction region, "para beber" /
			-- "to drink" alone is enough and still cannot match MMB status text.
			local portuguesePrompt =
				lower:find(
					"para beber",
					1,
					true
				)

			local englishPrompt =
				lower:find(
					"to drink",
					1,
					true
				)

			if portuguesePrompt or englishPrompt then
				local centerX =
					object.AbsolutePosition.X
					+ object.AbsoluteSize.X * 0.5

				local centerY =
					object.AbsolutePosition.Y
					+ object.AbsoluteSize.Y * 0.5

				-- Savannah's E interaction prompt is bottom-center.
				-- This deliberately excludes:
				-- - MMB Hub on the left
				-- - status card in the top-right
				-- - quest/menu text
				local inBottom =
					centerY >= viewport.Y * 0.72

				local inCenter =
					centerX >= viewport.X * 0.22
					and centerX <= viewport.X * 0.78

				if inBottom and inCenter then
					data.visible = true
					return true
				end
			end
		end
	end

	return false
end

