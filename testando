function Authority:Elect(context)
	self:PruneSignals()

	context =
		context
		or ai.Blackboard

	if self.currentOwner == "Safety" then
		self:ReleaseStaleSafety(
			context,
			"Safety election revalidated"
		)
	elseif not self:SafetyHazard(
		context
	) then
		self:ClearSignalsForOwner(
			"Safety"
		)
	end
	local bestOwner, bestScore, bestReason, bestExclusive = "None", -math.huge, "No active authority", false
	for _, owner in ipairs({"Safety", "Water", "Food", "Slots", "Manual", "Quest", "Growth", "AFKCoins"}) do
		local score, reason, exclusive = self:OwnerScore(owner, context)
		if score > bestScore then
			bestOwner, bestScore, bestReason, bestExclusive = owner, score, reason, exclusive == true
		end
	end
	if bestScore == -math.huge then
		bestOwner, bestScore, bestReason, bestExclusive =
