			or (context.buried and not undergroundDrinkTerrainProtected)
			or (
				context.dangerousWater
					and not context.drinkingProtected
					and not context.drinking
					and not context.intentionalWaterTransit
			)
			or context.dinoRockTrapped
			or (context.dinoShorelineFoodDeadlock and not context.intentionalWaterTransit)
			or forcingPostDrinkMove
			or (state.dinoPostDrinkExit and state.dinoPostDrinkExit.active)
			or context.healthFraction <= 0.35
			or context.healthRate < -0.8

		local movementManager =
			ai.MovementManager

		local safetyMoveActive =
			state.safeMove
			and state.safeMove.active
			and movementManager
			and movementManager:OwnerForPurpose(
				state.safeMove.reason
			) == "Safety"

		local recoveryOwned =
			DAMAGE.active
			or state.drinkTest.active
			or forcingPostDrinkMove
			or criticalRecoveryActive
			or (state.dinoShorelineRecovery and state.dinoShorelineRecovery.active)
			or (state.dinoRockEmergency and state.dinoRockEmergency.supervisorActive)
			or safetyMoveActive

		if hazard
			and not recoveryOwned
			and tick() - runtime.activeSince > 2 then

			return {
				healthy = false,
				reason =
					"environment hazard has no recovery owner",
			}
		end
		return { healthy = true }
	end,
	dynamicTimeout = function(context)
		return context.inVoid and 8 or 30
	end,
	recover = function(level, reason, context)
		if not context.characterAlive or DAMAGE.active then return "waiting" end
		if level == 1 then
			ai.Context:Update(true)
			return "safety references and live hazard revalidated"
		elseif level == 2 then
			ai:RequestWorker("Safety", reason)
			return "safety worker requested"
		elseif level == 3 and state.safeMove.active
			and ai.MovementManager:OwnerForPurpose(state.safeMove.reason) ~= "Safety" then
			ai.MovementManager:CancelOwner(
				ai.MovementManager:OwnerForPurpose(state.safeMove.reason),
				"Safety recovery"
			)
			return "lower-priority movement release requested"
		elseif level == 4 then
			DAMAGE.cooldownUntil = math.min(DAMAGE.cooldownUntil or 0, tick())
			ai:RequestWorker("Safety", "local safety retry")
			return "local safety route retried"
		elseif level == 5 then
			if ai.MovementManager.lease and ai.MovementManager.lease.owner ~= "Safety" then
				ai.MovementManager:CancelOwner(ai.MovementManager.lease.owner, "Safety handoff")
			end
			ai:RequestWorker("Safety", reason)
			return "Safety received exclusive emergency handoff"
		elseif level == 6 then
			pcall(state.questReleaseStaleRecoveryLock)
			ai:RequestWorker("Safety", reason)
			return "stale safety lock surgically revalidated"
		elseif level == 7 then
			DAMAGE.cooldownUntil = 0
			ai:RequestWorker("Safety", "safety pipeline reconstruction")
			return "safety pipeline reconstructed"
		end
		ai.Capabilities:Refresh()
		ai:RequestWorker("Safety", "game-adapter emergency fallback")
		return "game-adapter emergency fallback requested"
	end,
	resume = function() return true end,
})

ai:RegisterModule("Movement", {
	owner = "Movement",
	priority = 90,
	circuitPersistsWhenIdle = true,
	enabled = function()
		return ai.MovementManager.lease ~= nil
	end,
	expectedProgress = function(context)
		local lease = ai.MovementManager.lease
		if lease and lease.controllerKind == "direct"
			and (lease.owner == "Food" or lease.owner == "Water") then
			return false
		end
		return lease and typeof(lease.target) == "Vector3" and "distance to target" or false
	end,
	currentProgress = function(context)
		local lease = ai.MovementManager.lease
		if lease and lease.owner == "Quest" and not state.safeMove.active then
			return tonumber(context.travelDistance) or 0
		end
		local distance = ai.MovementManager:DistanceToTarget(context)
		return distance and -distance or nil
	end,
	healthCheck = function(context)
		local lease = ai.MovementManager.lease
		if not lease then return { healthy = true, waiting = true } end
		if lease.controllerKind == "direct"
			and (lease.owner == "Food" or lease.owner == "Water") then
			return { healthy = true, waiting = true, reason = "stationary survival interaction" }
		end
		if typeof(lease.target) ~= "Vector3" then
			return { healthy = false, reason = "movement lease has no target" }
		end
		if not ai.MovementManager:IsOwnerEnabled(lease.owner, context) then
			-- A genuinely disabled owner (toggle/capability off) is stale bookkeeping,
			-- not a Movement failure. Releasing it as a failure used to trip Movement's
			-- circuit and cascade into Food/Water waiting behind that same circuit.
			local staleOwner = lease.owner
			ai.MovementManager:CancelOwner(
				staleOwner,
				"stale disabled movement owner",
				true
			)
			return {
				healthy = true,
				waiting = true,
				reason = "stale movement owner released: " .. tostring(staleOwner),
			}
		end
		return { healthy = true }
	end,
	dynamicTimeout = function(context)
		local distance = ai.MovementManager:DistanceToTarget(context) or 0
		local speed = math.max(1, context.speedLimit or 12)
		local animalScale = math.clamp(state.movementFootprint(context.character) / 8, 0.8, 2.5)
		return math.clamp((distance / speed) * 2.4 * animalScale + 8, 7, 210)
	end,
	recover = function(level, reason, context)
		local lease = ai.MovementManager.lease
		if not lease then return "lease already released" end
		if level == 1 then
			lease.lastPulseAt = tick()
			return "lease references revalidated"
		elseif level == 2 then
			lease.lastProgressAt = tick()
			requestUnderlyingWorker(lease.owner, "movement verification retry")
			return "owning worker asked for a non-destructive retry"
		elseif level == 3 then
			ai.Memory:MarkFailure("route", lease.target, reason, 35)
			ai.MovementManager:CancelOwner(lease.owner, "stalled route recalculation")
			requestUnderlyingWorker(lease.owner, reason)
			return "route cancelled for local recalculation"
		elseif level == 4 then
			ai.MovementManager:CancelOwner(lease.owner, "controller-local rebuild")
			requestUnderlyingWorker(lease.owner, "rebuild only owning controller")
			return "only the stalled movement controller was rebuilt"
		elseif level == 5 then
			local urgent = ai.MovementManager:StrongestUrgentOwner(context or ai.Blackboard)
			if urgent and urgent ~= lease.owner then
				ai.MovementManager:CancelOwner(lease.owner, "verified priority handoff")
				requestUnderlyingWorker(urgent, reason)
				return "movement yielded to verified higher-priority owner"
			end
			requestUnderlyingWorker(lease.owner, "priority ownership reasserted")
			return "movement ownership reasserted without global reset"
		elseif level == 6 then
			lease.lastDistance = math.huge
			lease.lastProgressAt = tick()
			lease.lastPulseAt = tick()
			requestUnderlyingWorker(lease.owner, "lease progress state repaired")
			return "orphan progress markers repaired"
		elseif level == 7 then
			ai.MovementManager:CancelOwner(lease.owner, "movement pipeline reconstruction")
			requestUnderlyingWorker(lease.owner, "movement pipeline reconstruction")
			return "owning movement pipeline reconstructed"
		end
		ai.Memory:MarkFailure("route", lease.target, reason, 90)
		ai.Capabilities:Refresh()
		ai.MovementManager:CancelOwner(lease.owner, "adapter-safe movement fallback")
		requestUnderlyingWorker(lease.owner, "adapter-safe movement fallback")
		return "blocked route isolated and adapter-safe fallback queued"
	end,
})

