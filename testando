end


local function isCarnivoreCharacter(character)
	if not character then return false end
	local class = getAnimalClass(character)
	if class then return class:lower():find("carn", 1, true) ~= nil end

	-- Fallback (só se o AnimalClass não existir por algum motivo): nome
	-- conhecido ou o antigo atributo AnimalType.
	local animal = character:GetAttribute("AnimalName")
	if type(animal) == "string" and CARNIVORE_NAMES_LOWER[animal:lower()] then return true end
	local animalType = character:GetAttribute("AnimalType")
	if type(animalType) == "string" and animalType:lower():find("carn", 1, true) then return true end
	return false
end
function state.growthModeActive()
	-- Growth can be owned either by the manual Growth tab or temporarily by
	-- Auto Quests while it finishes/resets a growing slot. Pride Rock must
	-- remain enforced in both cases.
	return state.growExisting
		or state.growAllSlots
		or state.growNew
		or state.growExistingAutomaticAll
		or state.questPostGrowAll
		or state.questGrowthOwnsCurrent
		or (
			state.questGrowthReset
			and state.questGrowthReset.active ~= nil
		)
end

function state.isGrowthHerbivore(character)
	if not character then return false end

	local class = getAnimalClass(character)

	if type(class) == "string" and class ~= "" then
		return class:lower():find(
			"herb",
			1,
			true
		) ~= nil
	end

	-- Fallback only if AnimalClass has not replicated yet.
	local animal =
		character:GetAttribute("AnimalName")

	if type(animal) == "string" then
		local key = animal:lower()

		-- Baboon is omnivore; never apply the herbivore Pride leash.
		if key == "baboon" then
			return false
		end

		if CARNIVORE_NAMES_LOWER[key] then
			return false
		end
	end

	return true
end

function state.questZonePriorityActive()
	local zoneState = state.questZonePriority

	return state.autoQuests
		and zoneState
		and zoneState.resolved == true
		and zoneState.active == true
		and type(zoneState.zone) == "string"
		and zoneState.zone ~= ""
end

function state.positionInsideMapZone(position, zoneName)
	if typeof(position) ~= "Vector3"
		or type(zoneName) ~= "string"
		or zoneName == "" then
		return nil
	end

	local mapZones =
		workspace:FindFirstChild(
			"MapZones"
		)

	local zoneModel =
		mapZones
		and mapZones:FindFirstChild(
			zoneName
		)

	if not zoneModel then
		return nil
	end

	local foundVolume = false
	local zoneParts = {}

	if zoneModel:IsA("BasePart") then
		table.insert(zoneParts, zoneModel)
	end

	for _, object in ipairs(
		zoneModel:GetDescendants()
	) do
		if object:IsA("BasePart") then
			table.insert(zoneParts, object)
		end
	end

	for _, object in ipairs(zoneParts) do
		foundVolume = true

		local localPoint =
			object.CFrame:PointToObjectSpace(
				position
			)

		if math.abs(localPoint.X)
			<= object.Size.X * 0.5 + 3
			and math.abs(localPoint.Z)
				<= object.Size.Z * 0.5 + 3 then
			return true
		end
	end

	if foundVolume then
		return false
	end

	return nil
end

function state.questZoneFoodPositionAllowed(position)
	if not state.questZonePriorityActive() then
		return true
	end

	local inside =
		state.positionInsideMapZone(
			position,
			state.questZonePriority.zone
		)

	-- No exposed zone volume: don't risk starvation.
	if inside == nil then
		return true
	end

	return inside
end

function state.growthPrideRestrictionActive(character)
	-- ZoneTime always outranks the normal Growth home.
	if not state.growthPrideEnabled
		or (
			state.autoQuests
			and state.questZonePriority
			and state.questZonePriority.resolved == false
		)
		or state.questZonePriorityActive() then
		return false
	end

	return isSavannahLife
		and state.growthModeActive()
		and state.isGrowthHerbivore(character)
end

function state.growthPrideHorizontalDistance(position)
	if typeof(position) ~= "Vector3" then
		return math.huge
	end

	local center = state.growthPride.center

	return Vector3.new(
		position.X - center.X,
		0,
		position.Z - center.Z
	).Magnitude
end

function state.growthPridePositionInsideZone(position)
	if typeof(position) ~= "Vector3" then
		return nil
	end

	local mapZones = workspace:FindFirstChild("MapZones")
	local prideZone = mapZones and mapZones:FindFirstChild("Pride Rock")
	if not prideZone then
		return nil
	end

	local foundVolume = false

	for _, object in ipairs(prideZone:GetDescendants()) do
		if object:IsA("BasePart") then
			foundVolume = true

			local localPoint =
				object.CFrame:PointToObjectSpace(
					position
				)

			-- Zone parts are trigger volumes. X/Z is what matters for keeping
			-- the animal and grass target inside the actual Pride Rock territory.
			if math.abs(localPoint.X)
				<= object.Size.X * 0.5 + 3
				and math.abs(localPoint.Z)
					<= object.Size.Z * 0.5 + 3 then

				return true
			end
		end
	end

	if foundVolume then
		return false
	end

	return nil
end

function state.growthPrideInside(character, root)
	if not state.growthPrideRestrictionActive(character)
		or not root then
		return true
	end

	-- ZoneName is authoritative. The old 650-stud fallback was large enough
	-- to classify animals outside Pride Rock as already inside, so the return
	-- controller never started. If Roblox reports ANY zone, trust it.
	local zone = state.questCurrentZoneName()

	if type(zone) == "string" and zone ~= "" then
		return zone:lower() == "pride rock"
	end

	-- If ZoneName has not replicated yet, use the real MapZones volume.
	local geometricInside =
		state.growthPridePositionInsideZone(
			root.Position
		)

	if geometricInside ~= nil then
		return geometricInside
	end

	-- Last-resort replication fallback: accept only the dedicated safe HOME
	-- point, never the old 650-stud approximate radius.
	local home = state.growthPride.home
	local distanceToHome = Vector3.new(
		root.Position.X - home.X,
		0,
		root.Position.Z - home.Z
	).Magnitude

	return distanceToHome <= 110
end

function state.growthPrideFoodPositionAllowed(position)
	local character = player.Character

	if not state.growthPrideRestrictionActive(character) then
		return true
	end

	-- Prefer the real Pride Rock MapZones volume so grass routing cannot pull
	-- a growing herbivore just outside the territory.
	local geometricInside =
		state.growthPridePositionInsideZone(
			position
		)

	if geometricInside ~= nil then
		return geometricInside
	end

	return state.growthPrideHorizontalDistance(
		position
	) <= state.growthPride.foodRadius
end

function state.autoFoodPositionAllowed(position)
	local character =
		player.Character

	-- Zone-local food restriction applies only to herbivores (including
	-- Giraffe). Carnivores/Baboon may still leave briefly for their valid food
	-- source; quest movement remains paused until feeding finishes.
	if state.questZonePriorityActive()
		and state.isGrowthHerbivore(
			character
		) then

		return state.questZoneFoodPositionAllowed(
			position
		)
	end

	return state.growthPrideFoodPositionAllowed(
		position
	)
end

