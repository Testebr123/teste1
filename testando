	}
	return owners[purpose] or "Movement"
end

function state.aiSupervisorPermitController(owner, controller, reason, severity)
	local ai = state.MMBAI
	local authority = ai and ai.Authority
	if not ai or ai.Enabled ~= true or not authority
		or type(authority.RequestController) ~= "function" then
		return true
	end
	return authority:RequestController(
		tostring(owner or "Movement"),
		tostring(controller or owner or "LegacyController"),
		tostring(reason or "controller request"),
		tonumber(severity) or 500
	) == true
end

function state.aiSupervisorSignal(name, owner, reason, severity, ttl)
	local ai = state.MMBAI
	local authority = ai and ai.Authority
	if not authority or type(authority.Signal) ~= "function" then
		return false
	end
	authority:Signal(
		tostring(name or "LegacyWatchdog"),
		tostring(owner or "Safety"),
		tostring(reason or "watchdog signal"),
		tonumber(severity) or 500,
		tonumber(ttl) or 4
	)
	return true
end

function state.aiSupervisorPermitMovement(purpose, target, options)
	local ai = state.MMBAI
	local authority = ai and ai.Authority
	if not ai or ai.Enabled ~= true or not authority
		or type(authority.PermitMovement) ~= "function" then
		return true, "Supervisor not initialized"
	end
	return authority:PermitMovement(
		state.aiSupervisorOwnerForPurpose(purpose),
		tostring(purpose or "movement"),
		target,
		options
	)
end

function state.aiSupervisorSafetyOverride()
	local ai = state.MMBAI
