function state.aiModuleOperational(moduleName)
	local supervisor =
		state.MMBAI

	local registry =
		supervisor
		and supervisor.ModuleRegistry

	local authority =
		supervisor
		and supervisor.Authority

	if not registry
		or type(
			registry.PermitsWorker
		) ~= "function" then

		return true
	end

	-- AUTHORITATIVE OWNER BYPASS:
	-- Circuit breakers are diagnostic protection, not a second authority layer.
	-- If the Supervisor already elected an exclusive owner, that owner's worker
	-- must be allowed to execute so the Supervisor can actually recover the slot.
	if authority
		and authority.currentOwner
		and authority.currentOwner ~= "None"
		and type(
			registry.Get
		) == "function" then

		local module =
			registry:Get(
				moduleName
			)

		if module
			and module.owner
				== authority.currentOwner
			and authority.exclusive then

			return true
		end
	end

	return registry:PermitsWorker(
		moduleName,
		supervisor.Blackboard
	) == true
end

function state.aiMovementOperational(owner)
	local supervisor =
		state.MMBAI

	local registry =
		supervisor
		and supervisor.ModuleRegistry

	local authority =
		supervisor
		and supervisor.Authority

	if authority
		and authority.exclusive
		and authority.currentOwner ~= "None" then

		-- The elected owner must be able to MOVE. Otherwise a stale Movement
		-- circuit breaker can deadlock Water until 55%, which is exactly the
		-- "Supervisor only saves it very late" behavior.
		return owner
			== authority.currentOwner
	end

	if not registry
		or type(
			registry.PermitsWorker
		) ~= "function"
		or registry:PermitsWorker(
			"Movement",
			supervisor.Blackboard
		) then

		return true
	end

	if owner == "Safety"
		or owner == "Manual" then

		return true
	end

	-- Growth/slot staging are user-requested automation transactions, not optional
	-- diagnostics. A Movement circuit left open by the previous Quest route must
	-- never strand a completed slot with no controller. The concrete SafeMove still
	-- performs its own stall/obstacle validation.
	if owner == "Slots"
		and state.slotSwitchStagingActive == true then

		return true
	end

	if owner == "Growth"
		and state.autoGrowModeActive
		and state.autoGrowModeActive() then

		return true
	end

	local character =
		player.Character

	-- Survival owners get a direct fail-open path at their NORMAL activation
	-- thresholds. A Movement circuit may force a fresh route, but it may not
	-- postpone survival until the animal is nearly dead.
	if owner == "Water" then
		local water =
			character
			and tonumber(
				character:GetAttribute(
					"Water"
				)
			)
			or 100

		return state.autoDrink == true
			and (
				drinkingToFull
					or water <= 75
			)

	elseif owner == "Food" then
		local food =
			character
			and tonumber(
				character:GetAttribute(
					"Food"
				)
			)
			or 100

		return state.autoEat == true
			and (
				eatingToFull
					or food <= 70
			)
	end

	return false
end

local function ensureOnSolidGround(
	targetPosition,
	label,
	allowDuringGrowthReset
)
	label = label or "safe ground"
	criticalRecoveryActive = true

	-- criticalRecoveryActive already blocks competing controllers.
	-- Preserve the user's Auto Eat/Drink toggle choices.
	for attempt = 1, 3 do
		local character, root = characterParts()
		if not character or not root then break end

		local inVoid =
			root.Position.Y < config.dangerY

		local buried =
			not isDinoLife
			and state.drinkIsBuriedUnderTerrain(root)

		runtimeMessage = string.format(
			"Moving safely to %s (%d/3)",
			label,
			attempt
		)

		local moved = safeMoveToPosition(
			targetPosition,
			7,
			nil,
			{
				purpose = "safety",
				tolerance = 12,

				-- Only a character that is ACTUALLY in the void/buried may use the
				-- vertical recovery motor. Once above Terrain, safety routes must use
				-- the same reliable Humanoid:MoveTo motor as Move To / Zone.
				vertical = inVoid or buried,
				forceMoveToLand = not inVoid and not buried,

				-- Above Terrain, use normal land movement and stop after dry ground
				-- is genuinely confirmed. Never make a healthy land animal slide via
				-- the vertical/velocity recovery motor.
				constantSpeed = not inVoid and not buried,
				stopOnDryGround = not inVoid and not buried,

				-- v108: quest Growth-reset staging is an intentional safety
				-- movement performed while the exclusive reset lock is active.
				allowDuringGrowthReset =
					allowDuringGrowthReset == true,

				maxDuration = 240,
			}
		)

		task.wait(0.18)

		character, root = characterParts()

		if character
			and root
			and state.normalizeDryLandState(
				character,
				root
			) then

			runtimeMessage =
				"Safe ground confirmed at "
				.. label

			if not forcingPostDrinkMove then
				criticalRecoveryActive = false
			end

			return true
		end

		if character and root then
			runtimeMessage = string.format(
				"Still unsafe (void:%s directWater:%s terrain:%s); retrying",
				tostring(
					root.Position.Y < config.dangerY
				),
				tostring(
					state.isDirectWaterContact(root)
				),
				tostring(
					not isDinoLife
						and state.drinkIsBuriedUnderTerrain(root)
				)
			)
		end

		if not moved then
			task.wait(0.12)
		end
	end

	if not forcingPostDrinkMove then
		criticalRecoveryActive = false
	end

	return false
end

