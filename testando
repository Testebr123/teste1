-- ============================================================
-- v131: movement-object classification
-- Carcasses are interaction targets, never navigation obstacles.
-- PrideRock is the opposite: its cave-like mesh needs a much wider/longer
-- obstacle envelope so animals do not enter an opening and get trapped inside.
-- ============================================================
function state.movementCarcassModelForInstance(instance)
	if not instance then return nil end

	local storage =
		workspace:FindFirstChild(
			"CarcassesStorageModel"
		)

	if storage then
		local insideStorage =
			instance == storage

		if not insideStorage then
			pcall(function()
				insideStorage =
					instance:IsDescendantOf(
						storage
					)
			end)
		end

		if insideStorage then
			local current = instance
			while current
				and current.Parent
				and current.Parent ~= storage do
				current = current.Parent
			end
			return current or storage
		end
	end

	-- Compatibility fallback for Dino Life / servers that put carcasses in a
	-- differently-located model. Keep the same strict naming policy already
	-- used by nearestCarcass(): carcass/carcaca only, never generic "dead".
	local current = instance
	while current and current ~= workspace do
		if current:IsA("Model") then
			local lower = current.Name:lower()
			if lower:find("carcass", 1, true)
				or lower:find("carcaca", 1, true) then
				return current
			end
		end
		current = current.Parent
	end

	return nil
end

function state.movementRaycastIgnoringCarcasses(origin, ray, params)
	if typeof(origin) ~= "Vector3"
		or typeof(ray) ~= "Vector3"
		or not params then
		return nil
	end

	if params.FilterType ~= Enum.RaycastFilterType.Exclude then
		return workspace:Raycast(origin, ray, params)
	end

	local ignored = {}
	for _, object in ipairs(params.FilterDescendantsInstances or {}) do
		table.insert(ignored, object)
	end

	local storage =
		workspace:FindFirstChild(
			"CarcassesStorageModel"
		)
	if storage then
		table.insert(ignored, storage)
	end

	for _ = 1, 12 do
		params.FilterDescendantsInstances = ignored
		local hit = workspace:Raycast(origin, ray, params)
		if not hit then return nil end

		local carcassModel =
			state.movementCarcassModelForInstance(
				hit.Instance
			)

		if carcassModel then
			table.insert(ignored, carcassModel)
		else
			return hit
		end
	end

	return nil
end

state.prideRockObstacleCache =
	state.prideRockObstacleCache or {
		model = nil,
		boundsAt = 0,
		cf = nil,
		size = nil,
		escapeAt = 0,
		escapePosition = nil,
		escapeDirection = nil,

		-- PrideRock v2: long rays are awareness only. Once the rock is close
		-- enough to require steering, keep one side/heading committed instead
		-- of re-scoring left/right every probe and making the animal oscillate.
		commitDirection = nil,
		commitSign = nil,
		commitUntil = 0,
		commitStartedAt = 0,
	}

function state.movementPrideRockModel()
	local cache = state.prideRockObstacleCache
	if cache.model and cache.model.Parent then
		return cache.model
	end

	local mapAssets =
		workspace:FindFirstChild("MapAssets")

	-- Dino Life must NOT treat MapAssets.Plants.Rock as one giant protected
	-- PrideRock-style obstacle. That container can represent shoreline/generic
	-- rock geometry spread over a large area; model-level bounds made the Dino
	-- planner steer long before any real collision existed. Dino now uses the SAME
	-- physical body-envelope obstacle probe as Savannah on real collidable parts.
	if isDinoLife then
		cache.model = nil
		cache.cf = nil
		cache.size = nil
		cache.boundsAt = 0
		cache.commitDirection = nil
		cache.commitSign = nil
		cache.commitUntil = 0
		state.safeMove.prideRockEscapeDirection = nil
		return nil
	end

	local persistent =
		mapAssets
		and mapAssets:FindFirstChild(
			"LargeRocksPersistentStreaming"
		)
	local pride =
		persistent
		and persistent:FindFirstChild(
			"PrideRock"
		)

	if pride
		and (
			pride:IsA("Model")
				or pride:IsA("BasePart")
		) then
		cache.model = pride
		cache.boundsAt = 0
		return pride
	end

	cache.model = nil
	return nil
end

function state.movementPrideRockBounds()
	local pride = state.movementPrideRockModel()
	if not pride then return nil, nil, nil end

	local cache = state.prideRockObstacleCache
	if cache.cf
		and cache.size
		and tick() - (cache.boundsAt or 0) <= 1.0 then
		return pride, cache.cf, cache.size
	end

	local cf, size
	if pride:IsA("BasePart") then
		cf, size = pride.CFrame, pride.Size
	else
		local ok, boxCF, boxSize =
			pcall(pride.GetBoundingBox, pride)
		if ok then
			cf, size = boxCF, boxSize
		end
	end

	if typeof(cf) ~= "CFrame"
		or typeof(size) ~= "Vector3" then
		return pride, nil, nil
	end

	cache.cf = cf
	cache.size = size
	cache.boundsAt = tick()
	return pride, cf, size
end


-- ============================================================
-- Dino Life: INDIVIDUAL rock protection for workspace.MapAssets.Rocks.
-- IMPORTANT: never build one giant bounding circle for the whole folder.
-- Every collidable BasePart gets its own compact horizontal envelope, and only
-- rocks that actually intersect the current route are allowed to steer movement.
-- ============================================================
state.dinoRockObstacleCache = state.dinoRockObstacleCache or {
	folder = nil,
	entries = {},
	scanAt = 0,

	-- Static Dino map geometry: never rescan this folder every few seconds.
	refreshInterval = 60,
	gridCellSize = 96,
	grid = {},
	maxRockReach = 0,

	activePart = nil,
	commitSign = nil,
	commitDirection = nil,
	commitUntil = 0,

	lastProbeAt = 0,
	lastProbePosition = nil,
	lastProbeDirection = nil,
	lastProbeDistance = 0,
	lastProbeResult = nil,
}

function state.movementDinoRocksFolder()
	if not isDinoLife then return nil end

	local mapAssets = workspace:FindFirstChild("MapAssets")
	local rocks = mapAssets and mapAssets:FindFirstChild("Rocks")

	if rocks and (rocks:IsA("Folder") or rocks:IsA("Model")) then
		return rocks
	end

	return nil
end

function state.movementDinoRockEntries(forceRefresh)
	if not isDinoLife then
		return {}
	end

	local cache = state.dinoRockObstacleCache
	local folder = state.movementDinoRocksFolder()
	local now = tick()

	if not folder then
		cache.folder = nil
		cache.entries = {}
		cache.grid = {}
		cache.maxRockReach = 0
		cache.scanAt = now
		cache.activePart = nil
		cache.commitSign = nil
		cache.commitDirection = nil
		cache.commitUntil = 0
		return cache.entries
	end

	local refreshInterval =
		tonumber(cache.refreshInterval) or 60

	if not forceRefresh
		and cache.folder == folder
		and type(cache.entries) == "table"
		and #cache.entries > 0
		and now - (cache.scanAt or 0) <= refreshInterval then

		return cache.entries
	end

	local entries = {}
	local grid = {}
	local cellSize = tonumber(cache.gridCellSize) or 96
	local maxRockReach = 0

	for _, object in ipairs(folder:GetDescendants()) do
		if object:IsA("BasePart")
			and object.CanCollide
			and math.max(object.Size.X, object.Size.Z) >= 0.75 then

			local reach =
				math.max(object.Size.X, object.Size.Z) * 0.72 + 12

			local entry = {
				part = object,
				reach = reach,
			}

			entries[#entries + 1] = entry
			maxRockReach = math.max(maxRockReach, reach)

			local cx = math.floor(object.Position.X / cellSize)
			local cz = math.floor(object.Position.Z / cellSize)
			local key = tostring(cx) .. ":" .. tostring(cz)

			local bucket = grid[key]
			if not bucket then
				bucket = {}
				grid[key] = bucket
			end

			bucket[#bucket + 1] = entry
		end
	end

	cache.folder = folder
	cache.entries = entries
	cache.grid = grid
	cache.maxRockReach = maxRockReach
	cache.scanAt = now

	if cache.activePart
		and not cache.activePart:IsDescendantOf(folder) then

		cache.activePart = nil
		cache.commitSign = nil
		cache.commitDirection = nil
		cache.commitUntil = 0
	end

	return entries
end

function state.movementDinoRockNearbyEntries(position, radius)
	if not isDinoLife
		or typeof(position) ~= "Vector3" then

		return {}
	end

	state.movementDinoRockEntries(false)

	local cache = state.dinoRockObstacleCache
	local grid = cache.grid

	if type(grid) ~= "table" then
		return cache.entries or {}
	end

	local cellSize = tonumber(cache.gridCellSize) or 96
	local queryRadius = math.max(8, tonumber(radius) or 48)
	local expanded =
		queryRadius
		+ math.min(tonumber(cache.maxRockReach) or 0, 180)

	local minX = math.floor((position.X - expanded) / cellSize)
	local maxX = math.floor((position.X + expanded) / cellSize)
	local minZ = math.floor((position.Z - expanded) / cellSize)
	local maxZ = math.floor((position.Z + expanded) / cellSize)

	local result = {}

	for cx = minX, maxX do
		for cz = minZ, maxZ do
			local bucket =
				grid[tostring(cx) .. ":" .. tostring(cz)]

			if bucket then
				for _, entry in ipairs(bucket) do
					local part = entry.part

					if part and part.Parent then
						local reach =
							tonumber(entry.reach)
							or (
								math.max(part.Size.X, part.Size.Z) * 0.72
								+ 12
							)

						local dx = part.Position.X - position.X
						local dz = part.Position.Z - position.Z
						local allowed = queryRadius + reach

						if dx * dx + dz * dz <= allowed * allowed then
							result[#result + 1] = entry
						end
					end
				end
			end
		end
	end

	return result
end

function state.movementDinoRockFrame(entry, character, extraMargin)
	local part = entry and entry.part
	if not part or not part.Parent or not part:IsA("BasePart") then
		return nil
	end

	local cf = part.CFrame
	local size = part.Size
	local right = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)

	if right.Magnitude <= 0.05 then
		right = Vector3.new(1, 0, 0)
	else
		right = right.Unit
	end

	local forward = Vector3.new(-right.Z, 0, right.X)
	local rawForward = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	if rawForward.Magnitude > 0.05 and forward:Dot(rawForward.Unit) < 0 then
		forward = -forward
	end

	-- Exact horizontal projection of this single BasePart onto the two planar
	-- axes. Tilted rocks therefore keep a realistic footprint instead of gaining
	-- a huge model-wide radius.
	local hx = size.X * 0.5
	local hy = size.Y * 0.5
	local hz = size.Z * 0.5

	local halfRight =
		hx * math.abs(cf.RightVector:Dot(right))
		+ hy * math.abs(cf.UpVector:Dot(right))
		+ hz * math.abs(cf.LookVector:Dot(right))

	local halfForward =
		hx * math.abs(cf.RightVector:Dot(forward))
		+ hy * math.abs(cf.UpVector:Dot(forward))
		+ hz * math.abs(cf.LookVector:Dot(forward))

	local footprint = character and state.movementFootprint(character) or 4

	-- Protect the actual Dino body without turning every rock into a huge
	-- invisible circle. The previous envelope was too wide for passages.
	local bodyMargin =
		math.clamp(
			footprint * 0.18 + 0.8,
			1.6,
			6.2
		)

	local margin =
		bodyMargin
		+ math.max(
			0,
			tonumber(extraMargin) or 0
		)

	return {
		part = part,
		center = Vector3.new(cf.Position.X, 0, cf.Position.Z),
		right = right,
		forward = forward,
		halfRight = math.max(0.5, halfRight) + margin,
		halfForward = math.max(0.5, halfForward) + margin,
	}
end

function state.movementDinoRockLocalData(position, frame)
	if typeof(position) ~= "Vector3" or not frame then return nil end

	local delta = Vector3.new(
		position.X - frame.center.X,
		0,
		position.Z - frame.center.Z
	)

	local x = delta:Dot(frame.right)
	local z = delta:Dot(frame.forward)
	local outsideX = math.max(math.abs(x) - frame.halfRight, 0)
	local outsideZ = math.max(math.abs(z) - frame.halfForward, 0)
	local inside = outsideX <= 0 and outsideZ <= 0
	local gap

	if inside then
		gap = -math.min(
			frame.halfRight - math.abs(x),
			frame.halfForward - math.abs(z)
		)
	else
		gap = math.sqrt(outsideX * outsideX + outsideZ * outsideZ)
	end

	return x, z, inside, gap
end

function state.movementDinoRockSegmentIntersects(
	startPosition,
	endPosition,
	frame
)
	if typeof(startPosition) ~= "Vector3"
		or typeof(endPosition) ~= "Vector3"
		or not frame then
		return false
	end

	local startDelta = Vector3.new(
		startPosition.X - frame.center.X,
		0,
		startPosition.Z - frame.center.Z
	)
	local endDelta = Vector3.new(
		endPosition.X - frame.center.X,
		0,
		endPosition.Z - frame.center.Z
	)

	local sx = startDelta:Dot(frame.right)
	local sz = startDelta:Dot(frame.forward)
	local ex = endDelta:Dot(frame.right)
	local ez = endDelta:Dot(frame.forward)
	local dx = ex - sx
	local dz = ez - sz
	local tMin = 0
	local tMax = 1

	local function slab(startValue, deltaValue, halfExtent)
		if math.abs(deltaValue) <= 1e-5 then
			return math.abs(startValue) <= halfExtent
		end

		local inv = 1 / deltaValue
		local t1 = (-halfExtent - startValue) * inv
		local t2 = (halfExtent - startValue) * inv
		if t1 > t2 then t1, t2 = t2, t1 end

		tMin = math.max(tMin, t1)
		tMax = math.min(tMax, t2)
		return tMin <= tMax
	end

	return slab(sx, dx, frame.halfRight)
		and slab(sz, dz, frame.halfForward)
end

function state.movementDinoRockPointForbidden(
	position,
	character,
	extraMargin
)
	if not isDinoLife or typeof(position) ~= "Vector3" then
		return false, nil
	end

	local basinForbidden, basin =
		state.dinoRestrictedBasinPointForbidden(
			position,
			character,
			extraMargin
		)

	if basinForbidden then
		return true, basin
	end

	for _, entry in ipairs(
		state.movementDinoRockNearbyEntries(
			position,
			48
				+ math.max(
					0,
					tonumber(extraMargin) or 0
				)
		)
	) do
		local part = entry.part
		if part and part.Parent then
			-- Cheap broad phase before the oriented-envelope math.
			local footprint = character and state.movementFootprint(character) or 4
			local broadRadius =
				math.max(part.Size.X, part.Size.Z) * 0.56
				+ math.clamp(
					footprint * 0.22 + 3,
					4.5,
					10
				)
				+ math.max(
					0,
					tonumber(extraMargin) or 0
				)

			local dx = position.X - part.Position.X
			local dz = position.Z - part.Position.Z
			if dx * dx + dz * dz <= broadRadius * broadRadius then
				local frame = state.movementDinoRockFrame(entry, character, extraMargin)
				local _, _, inside = state.movementDinoRockLocalData(position, frame)
				if inside then
					return true, part
				end
			end
		end
	end

	return false, nil
end

function state.movementDinoRockNearby(position, extraDistance)
	if not isDinoLife or typeof(position) ~= "Vector3" then return false end

	-- Awareness is intentionally local. Callers sometimes ask PrideRock for 90
	-- studs; applying 90 studs to EVERY Dino rock would recreate the giant-halo bug.
	local extra =
		math.clamp(
			tonumber(extraDistance) or 16,
			0,
			20
		)

	for _, entry in ipairs(
		state.movementDinoRockNearbyEntries(
			position,
			extra + 42
		)
	) do
		local part = entry.part
		if part and part.Parent then
			local broad =
				math.max(part.Size.X, part.Size.Z) * 0.56
				+ extra
				+ 4
			local dx = position.X - part.Position.X
			local dz = position.Z - part.Position.Z
			if dx * dx + dz * dz <= broad * broad then
				local frame = state.movementDinoRockFrame(entry, nil, extra)
				local _, _, inside, gap = state.movementDinoRockLocalData(position, frame)
				if inside or (gap and gap <= 0.5) then
					return true
				end
			end
		end
	end

	return false
end


-- ============================================================
-- Dino Life: LOCAL restricted rock basins.
--
-- Individual MapAssets.Rocks parts remain individual blockers everywhere.
-- A combined restricted zone is created ONLY around a water candidate that is
-- surrounded by a dense local rock group. This solves the enclosed rock-pit
-- problem without turning unrelated rocks around the map into one giant zone.
-- ============================================================
state.dinoRestrictedBasins =
	state.dinoRestrictedBasins
	or {
		zones = {},
		nextId = 0,
		activeId = nil,
		commitSign = nil,
		commitUntil = 0,
	}

function state.dinoRestrictedBasinRegister(waterPosition, character)
	if not isDinoLife
		or typeof(waterPosition) ~= "Vector3"
		or not character then
		return nil
	end

	local footprint =
		state.movementFootprint(
			character
		)

	local gatherRadius =
		math.clamp(
			footprint * 1.65 + 38,
			48,
			82
		)

	local entries =
		state.movementDinoRockNearbyEntries(
			waterPosition,
			gatherRadius + 18
		)

	if #entries == 0 then
		return nil
	end

	local members = {}
	local centerSum =
		Vector3.new(
			waterPosition.X * 2,
			0,
			waterPosition.Z * 2
		)
	local centerWeight = 2

	for _, entry in ipairs(entries) do
		local part = entry.part
		if part and part.Parent then
			local delta =
				Vector3.new(
					part.Position.X - waterPosition.X,
					0,
					part.Position.Z - waterPosition.Z
				)
			local partReach =
				math.max(
					part.Size.X,
					part.Size.Z
				) * 0.5

			if delta.Magnitude - partReach <= gatherRadius then
				members[#members + 1] = part
				centerSum += Vector3.new(
					part.Position.X,
					0,
					part.Position.Z
				)
				centerWeight += 1
			end
		end
	end

	-- Four nearby physical rock parts are required before a water source can
	-- become a combined basin restriction. Two ordinary rocks beside a river
	-- therefore stay as normal individual obstacles.
	if #members < 4 then
		return nil
	end

	local averaged =
		centerSum / math.max(centerWeight, 1)
	local center =
		Vector3.new(
			averaged.X,
			waterPosition.Y,
			averaged.Z
		)

	local radius = 0
	for _, part in ipairs(members) do
		if part and part.Parent then
			local distance =
				Vector3.new(
					part.Position.X - center.X,
					0,
					part.Position.Z - center.Z
				).Magnitude
			local partReach =
				math.max(
					part.Size.X,
					part.Size.Z
				) * 0.36

			radius =
				math.max(
					radius,
					distance + partReach
				)
		end
	end

	-- Include the dangerous water itself, plus just enough body clearance for Rex.
	radius =
		math.max(
			radius,
			Vector3.new(
				waterPosition.X - center.X,
				0,
				waterPosition.Z - center.Z
			).Magnitude + 8
		)

	radius =
		math.clamp(
			radius
				+ math.clamp(
					footprint * 0.22 + 3,
					4.5,
					10
				),
			22,
			82
		)

	local data = state.dinoRestrictedBasins

	-- Merge repeated samples from the SAME pit. Never merge distant clusters.
	for _, zone in ipairs(data.zones) do
		local separation =
			Vector3.new(
				zone.center.X - center.X,
				0,
				zone.center.Z - center.Z
			).Magnitude

		if separation
			<= math.max(
				24,
				math.min(zone.radius, radius) * 0.58
			) then

			-- Keep the center stable to prevent a moving/oscillating exclusion zone.
			zone.radius =
				math.max(
					zone.radius,
					math.min(
						82,
						separation + radius
					)
				)
			zone.lastSeenAt = tick()
			zone.memberCount =
				math.max(
					zone.memberCount or 0,
					#members
				)

			return zone
		end
	end

	data.nextId += 1

	local zone = {
		id = data.nextId,
		center = center,
		radius = radius,
		memberCount = #members,
		createdAt = tick(),
		lastSeenAt = tick(),
	}

	data.zones[#data.zones + 1] = zone
	return zone
end

function state.dinoRestrictedBasinPointForbidden(
	position,
	character,
	extraMargin
)
	if not isDinoLife
		or typeof(position) ~= "Vector3" then
		return false, nil
	end

	local data = state.dinoRestrictedBasins
	if not data or type(data.zones) ~= "table" then
		return false, nil
	end

	local footprint =
		character
			and state.movementFootprint(character)
			or 4

	local margin =
		math.clamp(
			footprint * 0.11
				+ math.max(
					0,
					tonumber(extraMargin) or 0
				),
			1.5,
			8
		)

	for _, zone in ipairs(data.zones) do
		if zone
			and typeof(zone.center) == "Vector3"
			and tonumber(zone.radius) then

			local distance =
				Vector3.new(
					position.X - zone.center.X,
					0,
					position.Z - zone.center.Z
				).Magnitude

			if distance <= zone.radius + margin then
				return true, zone
			end
		end
	end

	return false, nil
end

function state.dinoRestrictedBasinSegmentIntersects(
	startPosition,
	endPosition,
	zone,
	extraMargin
)
	if typeof(startPosition) ~= "Vector3"
		or typeof(endPosition) ~= "Vector3"
		or not zone
		or typeof(zone.center) ~= "Vector3"
		or not tonumber(zone.radius) then
		return false
	end

	local sx = startPosition.X
	local sz = startPosition.Z
	local ex = endPosition.X
	local ez = endPosition.Z
	local cx = zone.center.X
	local cz = zone.center.Z

	local dx = ex - sx
	local dz = ez - sz
	local lengthSq = dx * dx + dz * dz

	local t = 0
	if lengthSq > 1e-5 then
		t =
			math.clamp(
				((cx - sx) * dx + (cz - sz) * dz)
					/ lengthSq,
				0,
				1
			)
	end

	local px = sx + dx * t
	local pz = sz + dz * t
	local ox = px - cx
	local oz = pz - cz
	local radius =
		zone.radius
			+ math.max(
				0,
				tonumber(extraMargin) or 0
			)

	return ox * ox + oz * oz <= radius * radius
end

function state.dinoRestrictedBasinObstacleProbe(
	character,
	root,
	direction,
	probeDistance
)
	if not isDinoLife
		or not character
		or not root
		or typeof(direction) ~= "Vector3"
		or direction.Magnitude <= 0.05 then
		return nil
	end

	local data = state.dinoRestrictedBasins
	if not data
		or type(data.zones) ~= "table"
		or #data.zones == 0 then
		if state.safeMove then
			state.safeMove.dinoBasinBypassActive = false
		end
		return nil
	end

	local forward =
		Vector3.new(
			direction.X,
			0,
			direction.Z
		)

	if forward.Magnitude <= 0.05 then
		return nil
	end
	forward = forward.Unit

	local footprint = state.movementFootprint(character)
	local guardDistance =
		math.clamp(
			math.max(
				tonumber(probeDistance) or 24,
				footprint * 1.20 + 14
			),
			22,
			56
		)

	local localEnd =
		root.Position
			+ forward * guardDistance

	local routeTarget =
		state.safeMove
			and state.safeMove.target
			or nil

	local selected
	local selectedGap = math.huge

	-- Keep an already-selected basin stable while we are going around it.
	if data.activeId then
		for _, zone in ipairs(data.zones) do
			if zone.id == data.activeId then
				local centerDelta =
					Vector3.new(
						root.Position.X - zone.center.X,
						0,
						root.Position.Z - zone.center.Z
					)
				local gap =
					centerDelta.Magnitude
						- (
							zone.radius
							+ math.clamp(
								footprint * 0.20,
								2,
								8
							)
						)

				local routeStillCrosses =
					typeof(routeTarget) == "Vector3"
					and state.dinoRestrictedBasinSegmentIntersects(
						root.Position,
						routeTarget,
						zone,
						footprint * 0.16
					)

				if gap <= guardDistance + 22
					and (
						routeStillCrosses
						or tick()
							<= (
								data.commitUntil or 0
							)
					) then
					selected = zone
					selectedGap = gap
				else
					data.activeId = nil
					data.commitSign = nil
					data.commitUntil = 0
				end
				break
			end
		end
	end

	-- Acquire a NEW basin only when the short local route is about to enter it.
	-- Therefore a pit hundreds of studs away never makes Rex curve prematurely.
	if not selected then
		for _, zone in ipairs(data.zones) do
			local centerDelta =
				Vector3.new(
					root.Position.X - zone.center.X,
					0,
					root.Position.Z - zone.center.Z
				)

			local margin =
				math.clamp(
					footprint * 0.20,
					2,
					8
				)

			local gap =
				centerDelta.Magnitude
					- (zone.radius + margin)

			local inside = gap <= 0
			local localCross =
				state.dinoRestrictedBasinSegmentIntersects(
					root.Position,
					localEnd,
					zone,
					margin
				)

			if (inside or localCross)
				and gap < selectedGap then
				selected = zone
				selectedGap = gap
			end
		end
	end

	if not selected then
		data.activeId = nil
		data.commitSign = nil
		data.commitUntil = 0
		if state.safeMove then
			state.safeMove.dinoBasinBypassActive = false
		end
		return nil
	end

	if data.activeId ~= selected.id then
		data.activeId = selected.id
		data.commitSign = nil
		data.commitUntil = 0
	end

	local radial =
		Vector3.new(
			root.Position.X - selected.center.X,
			0,
			root.Position.Z - selected.center.Z
		)

	if radial.Magnitude <= 0.05 then
		radial = -forward
	end

	local outward = radial.Unit
	local targetDirection = forward

	if typeof(routeTarget) == "Vector3" then
		local toTarget =
			Vector3.new(
				routeTarget.X - root.Position.X,
				0,
				routeTarget.Z - root.Position.Z
			)

		if toTarget.Magnitude > 0.05 then
			targetDirection = toTarget.Unit
		end
	end

	local function directionForSign(sign)
		local tangent =
			sign >= 0
				and Vector3.new(
					-outward.Z,
					0,
					outward.X
				)
				or Vector3.new(
					outward.Z,
					0,
					-outward.X
				)

		-- Mostly tangent, with a steady outward component. That makes Rex orbit
		-- around the pit instead of alternating left/right against individual rocks.
		local candidate =
			tangent * 0.94
				+ outward * 0.38

		return candidate.Magnitude > 0.05
			and candidate.Unit
			or outward
	end

	local function directionScore(candidate)
		local score =
			targetDirection:Dot(candidate) * 22

		local sampleDistances = {
			math.clamp(
				footprint * 1.15 + 9,
				14,
				30
			),
			math.clamp(
				footprint * 2.0 + 16,
				26,
				48
			),
			math.clamp(
				footprint * 2.9 + 24,
				38,
				68
			),
		}

		for index, distance in ipairs(sampleDistances) do
			local sample =
				root.Position
					+ candidate * distance

			local basinBlocked =
				state.dinoRestrictedBasinPointForbidden(
					sample,
					character,
					1
				)

			local rockBlocked =
				false

			if not basinBlocked then
				-- Individual rock blockers still matter OUTSIDE the pit.
				for _, entry in ipairs(
					state.movementDinoRockNearbyEntries(
						sample,
						footprint + 34
					)
				) do
					local frame =
						state.movementDinoRockFrame(
							entry,
							character,
							1
						)
					local _, _, inside =
						state.movementDinoRockLocalData(
							sample,
							frame
						)
					if inside then
						rockBlocked = true
						break
					end
				end
			end

			if basinBlocked or rockBlocked then
				score -= 90 / index
			else
				score += 8
			end
		end

		return score
	end

	local chosenDirection

	if data.commitSign
		and tick()
			<= (
				data.commitUntil or 0
			) then
		chosenDirection =
			directionForSign(
				data.commitSign
			)
	else
		local left =
			directionForSign(-1)
		local right =
			directionForSign(1)

		local leftScore =
			directionScore(left)
		local rightScore =
			directionScore(right)

		if rightScore > leftScore then
			data.commitSign = 1
			chosenDirection = right
		else
			data.commitSign = -1
			chosenDirection = left
		end

		-- Long enough to get around the basin without changing its mind at every
		-- separate boulder, but still short enough to re-evaluate after clearing it.
		data.commitUntil =
			tick() + 7.5
	end

	local smarterDirection = state.dinoRockRouteDirection(
		character,
		root,
		targetDirection,
		routeTarget,
		"basin:" .. tostring(selected.id)
	)

	if smarterDirection then
		chosenDirection = smarterDirection
		data.commitUntil = tick() + 5.8
	end

	if state.safeMove then
		state.safeMove.prideRockEscapeDirection =
			chosenDirection
		state.safeMove.dinoBasinBypassActive =
			true
	end

	local rocksFolder =
		state.movementDinoRocksFolder()

	return {
		Instance = rocksFolder
			or (
				state.movementDinoRockEntries(false)[1]
				and state.movementDinoRockEntries(false)[1].part
			),
		Position =
			root.Position
				+ chosenDirection * 2,
		Normal =
			Vector3.new(
				-chosenDirection.X,
				0,
				-chosenDirection.Z
			),
		Distance =
			math.max(
				0,
				selectedGap
			),
		RestrictedBasin = selected,
	}
end


-- ============================================================
-- Dino Life: stable local route planner around rock groups.
-- It evaluates clear corridors through ALL nearby blocked geometry and commits
-- to one route instead of alternating left/right for each individual rock.
-- ============================================================
state.dinoRockRoutePlanner =
	state.dinoRockRoutePlanner
	or {
		direction = nil,
		obstacleKey = nil,
		target = nil,
		commitUntil = 0,
		lastPlanAt = 0,
	}

function state.dinoRockRouteDirection(character, root, forward, routeTarget, obstacleKey)
	if not isDinoLife
		or not character
		or not root
		or typeof(forward) ~= "Vector3" then
		return nil
	end

	local base = Vector3.new(forward.X, 0, forward.Z)
	if base.Magnitude <= 0.05 then return nil end
	base = base.Unit

	local planner = state.dinoRockRoutePlanner
	local now = tick()
	local sameTarget = true

	if typeof(routeTarget) == "Vector3" and typeof(planner.target) == "Vector3" then
		sameTarget = Vector3.new(
			routeTarget.X - planner.target.X,
			0,
			routeTarget.Z - planner.target.Z
		).Magnitude <= 28
	elseif typeof(routeTarget) == "Vector3" or typeof(planner.target) == "Vector3" then
		sameTarget = false
	end

	if planner.direction
		and planner.obstacleKey == obstacleKey
		and sameTarget
		and now <= (planner.commitUntil or 0) then

		local shortProbe = root.Position + planner.direction * math.clamp(
			state.movementFootprint(character) * 1.1 + 9,
			12,
			26
		)

		if not state.movementDinoRockPointForbidden(shortProbe, character, 0) then
			return planner.direction
		end
	end

	local footprint = state.movementFootprint(character)
	local targetDirection = base
	if typeof(routeTarget) == "Vector3" then
		local delta = Vector3.new(
			routeTarget.X - root.Position.X,
			0,
			routeTarget.Z - root.Position.Z
		)
		if delta.Magnitude > 0.05 then targetDirection = delta.Unit end
	end

	local function rotate(direction, degrees)
		local r = math.rad(degrees)
		local c, s = math.cos(r), math.sin(r)
		return Vector3.new(
			direction.X * c - direction.Z * s,
			0,
			direction.X * s + direction.Z * c
		).Unit
	end

	local angles = { 0, -18, 18, -32, 32, -46, 46, -60, 60, -74, 74, -88, 88, -104, 104 }
	local distances = {
		math.clamp(footprint * 0.85 + 7, 10, 20),
		math.clamp(footprint * 1.45 + 12, 18, 34),
		math.clamp(footprint * 2.15 + 18, 28, 48),
		math.clamp(footprint * 3.0 + 25, 40, 68),
	}

	local routeEntries =
		state.movementDinoRockNearbyEntries(
			root.Position,
			distances[#distances] + footprint + 44
		)

	-- First ask the simplest question: is the real route immediately in front of
	-- Rex actually clear? If yes, nearby side rocks must have ZERO influence.
	local directEnd =
		root.Position
		+ targetDirection
			* distances[3]

	local directBlocked =
		state.movementDinoRockPointForbidden(
			directEnd,
			character,
			0
		)

	if not directBlocked then
		for _, entry in ipairs(routeEntries) do
			local frame =
				state.movementDinoRockFrame(
					entry,
					character,
					0
				)

			if frame
				and state.movementDinoRockSegmentIntersects(
					root.Position,
					directEnd,
					frame
				) then

				directBlocked = true
				break
			end
		end
	end

	if not directBlocked then
		planner.direction = targetDirection
		planner.obstacleKey = obstacleKey
		planner.target = routeTarget
		planner.lastPlanAt = now
		planner.commitUntil = now + 1.0
		return targetDirection
	end

	local best, bestScore = nil, -math.huge

	for _, angle in ipairs(angles) do
		local candidate = rotate(targetDirection, angle)
		local blocked = false
		local clearanceScore = 0
		local previous = root.Position

		for index, distance in ipairs(distances) do
			local sample = root.Position + candidate * distance

			if state.movementDinoRockPointForbidden(sample, character, 0) then
				blocked = true
				break
			end

			for _, entry in ipairs(routeEntries) do
				local frame = state.movementDinoRockFrame(entry, character, 0)
				if frame and state.movementDinoRockSegmentIntersects(previous, sample, frame) then
					if index > 1 then
						blocked = true
						break
					end
				end
			end

			if blocked then break end
			previous = sample
			clearanceScore += 9
		end

		if not blocked then
			local corner = root.Position + candidate * distances[#distances]
			if typeof(routeTarget) == "Vector3" then
				local rejoin = Vector3.new(
					routeTarget.X - corner.X,
					0,
					routeTarget.Z - corner.Z
				)
				if rejoin.Magnitude > 0.05 then
					rejoin = rejoin.Unit
					for _, d in ipairs({
						math.clamp(footprint * 0.8 + 6, 9, 18),
						math.clamp(footprint * 1.45 + 10, 16, 30),
					}) do
						if state.movementDinoRockPointForbidden(corner + rejoin * d, character, 0) then
							clearanceScore -= 18
							break
						else
							clearanceScore += 5
						end
					end
				end
			end

			local score = clearanceScore
				+ targetDirection:Dot(candidate) * 34
				+ base:Dot(candidate) * 8
				- math.abs(angle) * 0.11

			if score > bestScore then
				bestScore = score
				best = candidate
			end
		end
	end

	if not best then return nil end

	planner.direction = best
	planner.obstacleKey = obstacleKey
	planner.target = routeTarget
	planner.lastPlanAt = now
	planner.commitUntil = now + 5.8
	return best
end

function state.dinoRocksObstacleProbe(
	character,
	root,
	direction,
	probeDistance
)
	if not isDinoLife
		or not character
		or not root
		or typeof(direction) ~= "Vector3"
		or direction.Magnitude <= 0.05 then
		return nil
	end

	local forward = Vector3.new(direction.X, 0, direction.Z)
	if forward.Magnitude <= 0.05 then return nil end
	forward = forward.Unit

	local probeCache = state.dinoRockObstacleCache
	local probeNow = tick()

	if probeCache.lastProbePosition
		and probeCache.lastProbeDirection
		and probeNow - (probeCache.lastProbeAt or 0) <= 0.10 then

		local moved =
			Vector3.new(
				root.Position.X - probeCache.lastProbePosition.X,
				0,
				root.Position.Z - probeCache.lastProbePosition.Z
			).Magnitude

		local aligned =
			forward:Dot(probeCache.lastProbeDirection)

		if moved <= 4
			and aligned >= 0.965
			and math.abs(
				(tonumber(probeDistance) or 0)
				- (tonumber(probeCache.lastProbeDistance) or 0)
			) <= 4 then

			return probeCache.lastProbeResult
		end
	end

	-- A dense water-filled rock pit is treated as ONE local restricted zone.
	-- This has priority over the individual rocks so separate boulders cannot make
	-- the planner alternate left/right while trying to enter the same basin.
	local basinObstacle =
		state.dinoRestrictedBasinObstacleProbe(
			character,
			root,
			forward,
			probeDistance
		)

	if basinObstacle then
		return basinObstacle
	end

	if state.safeMove then
		state.safeMove.dinoBasinBypassActive = false
	end

	local footprint = state.movementFootprint(character)
	local guardDistance = math.clamp(
		math.max(tonumber(probeDistance) or 24, footprint * 1.15 + 12),
		18,
		48
	)

	local localEntries =
		state.movementDinoRockNearbyEntries(
			root.Position,
			guardDistance + footprint + 44
		)

	local target = state.safeMove and state.safeMove.target

	-- Collision ownership is LOCAL. The long-range target is used only for scoring
	-- the best bypass direction. It must not make a rock 40+ studs away seize
	-- steering while Rex still has a perfectly clear corridor in front of him.
	local localRouteEnd =
		root.Position
		+ forward
			* guardDistance

	local routeEnd =
		typeof(target) == "Vector3"
			and target
			or localRouteEnd

	local chosenEntry
	local chosenFrame
	local chosenGap = math.huge
	local chosenInside = false

	for _, entry in ipairs(localEntries) do
		local part = entry.part
		if part and part.Parent then
			local centerDelta = Vector3.new(
				part.Position.X - root.Position.X,
				0,
				part.Position.Z - root.Position.Z
			)
			local broadRadius =
				guardDistance
				+ math.max(part.Size.X, part.Size.Z) * 0.85
				+ footprint

			if centerDelta.Magnitude <= broadRadius then
				local frame =
					state.movementDinoRockFrame(
						entry,
						character,
						0.5
					)

				local _, _, inside, gap =
					state.movementDinoRockLocalData(
						root.Position,
						frame
					)

				local intersects =
					state.movementDinoRockSegmentIntersects(
						root.Position,
						localRouteEnd,
						frame
					)

				-- A nearby rock that is beside/behind the route does NOTHING. Only the
				-- individual envelope currently occupied or crossed may own steering.
				if inside or intersects then
					local metric = inside and -1000 + (gap or 0) or (gap or math.huge)
					if metric < chosenGap then
						chosenEntry = entry
						chosenFrame = frame
						chosenGap = metric
						chosenInside = inside
					end
				end
			end
		end
	end

	local cache = state.dinoRockObstacleCache

	if not chosenEntry or not chosenFrame then
		cache.activePart = nil
		cache.commitSign = nil
		cache.commitDirection = nil
		cache.commitUntil = 0
		state.safeMove.prideRockEscapeDirection = nil

		probeCache.lastProbeAt = probeNow
		probeCache.lastProbePosition = root.Position
		probeCache.lastProbeDirection = forward
		probeCache.lastProbeDistance = tonumber(probeDistance) or 0
		probeCache.lastProbeResult = nil

		return nil
	end

	local part = chosenEntry.part
	if cache.activePart ~= part then
		cache.activePart = part
		cache.commitSign = nil
		cache.commitDirection = nil
		cache.commitUntil = 0
	end

	local x, z, inside, gap =
		state.movementDinoRockLocalData(root.Position, chosenFrame)
	inside = chosenInside or inside
	gap = gap or 0

	local outward
	if inside then
		local exitRight = chosenFrame.halfRight - math.abs(x)
		local exitForward = chosenFrame.halfForward - math.abs(z)
		if exitRight <= exitForward then
			outward = chosenFrame.right * (x >= 0 and 1 or -1)
		else
			outward = chosenFrame.forward * (z >= 0 and 1 or -1)
		end
	else
		local closestX = math.clamp(x, -chosenFrame.halfRight, chosenFrame.halfRight)
		local closestZ = math.clamp(z, -chosenFrame.halfForward, chosenFrame.halfForward)
		outward =
			chosenFrame.right * (x - closestX)
			+ chosenFrame.forward * (z - closestZ)

		if outward.Magnitude <= 0.05 then
			outward = Vector3.new(
				root.Position.X - chosenFrame.center.X,
				0,
				root.Position.Z - chosenFrame.center.Z
			)
		end
	end

	if outward.Magnitude <= 0.05 then outward = -forward end
	outward = outward.Unit

	local function directionForSign(sign)
		local tangent = sign >= 0
			and Vector3.new(-outward.Z, 0, outward.X)
			or Vector3.new(outward.Z, 0, -outward.X)

		local outwardWeight = inside
			and 0.92
			or math.clamp(0.22 + math.max(0, 8 - math.max(gap, 0)) / 13, 0.22, 0.78)

		local result = tangent * 0.94 + outward * outwardWeight
		return result.Magnitude > 0.05 and result.Unit or outward
	end

	local function directionScore(candidate)
		local score = forward:Dot(candidate) * 18
		local sampleDistances = {
			math.clamp(footprint * 1.10 + 7, 12, 28),
			math.clamp(footprint * 1.85 + 12, 20, 42),
			math.clamp(footprint * 2.55 + 18, 28, 58),
		}

		for index, distance in ipairs(sampleDistances) do
			local sample = root.Position + candidate * distance
			local blocked = state.movementDinoRockPointForbidden(sample, character, 1)
			if blocked then
				score -= 80 / index
			else
				score += 7
			end
		end

		return score
	end

	local chosenDirection = state.dinoRockRouteDirection(
		character,
		root,
		forward,
		routeEnd,
		part
	)

	if not chosenDirection then
		if cache.commitSign and tick() <= (cache.commitUntil or 0) then
			chosenDirection = directionForSign(cache.commitSign)
		else
			local left = directionForSign(-1)
			local rightDirection = directionForSign(1)
			local leftScore = directionScore(left)
			local rightScore = directionScore(rightDirection)

			if rightScore > leftScore then
				cache.commitSign = 1
				chosenDirection = rightDirection
			else
				cache.commitSign = -1
				chosenDirection = left
			end
			cache.commitUntil = tick() + 5.8
		end
	else
		local cross = forward.X * chosenDirection.Z - forward.Z * chosenDirection.X
		cache.commitSign = cross >= 0 and 1 or -1
		cache.commitUntil = tick() + 5.8
	end

	cache.commitDirection = chosenDirection
	state.safeMove.prideRockEscapeDirection = chosenDirection

	local cross = forward.X * chosenDirection.Z - forward.Z * chosenDirection.X
	state.safeMove.heavyObstacleSign = cross >= 0 and 1 or -1

	local result = {
		Instance = part,
		Position = root.Position + chosenDirection * 2,
		Normal = Vector3.new(-chosenDirection.X, 0, -chosenDirection.Z),
		Distance = math.max(0, gap),
	}

	probeCache.lastProbeAt = probeNow
	probeCache.lastProbePosition = root.Position
	probeCache.lastProbeDirection = forward
	probeCache.lastProbeDistance = tonumber(probeDistance) or 0
	probeCache.lastProbeResult = result

	return result
end

function state.movementIsPrideRockInstance(instance)
	if not instance then return false end

	if isDinoLife then
		local rocks = state.movementDinoRocksFolder()
		if not rocks then return false end
		if instance == rocks then return true end

		local result = false
		pcall(function()
			result = instance:IsDescendantOf(rocks)
		end)
		return result
	end

	local pride = state.movementPrideRockModel()
	if not pride then return false end
	if instance == pride then return true end

	local result = false
	pcall(function()
		result = instance:IsDescendantOf(pride)
	end)
	return result
end

-- Dino Life: WaterMossTexture1 is only visual decoration over water.
-- Explicitly exclude it from obstacle raycasts because RespectCanCollide is not
-- guaranteed to behave consistently in every executor/client.
function state.movementDinoWaterMossVisual()
	if not isDinoLife then return nil end

	local cached = state.dinoWaterMossVisual
	if cached and cached.Parent then
		return cached
	end

	local mapAssets = workspace:FindFirstChild("MapAssets")
	local aquatics = mapAssets and mapAssets:FindFirstChild("Aquatics")
	local moss = aquatics and aquatics:FindFirstChild("WaterMossTexture1")

	state.dinoWaterMossVisual = moss
	return moss
end

function state.movementIsDinoWaterMossVisual(instance)
	if not isDinoLife or not instance then return false end

	local moss = state.movementDinoWaterMossVisual()
	if not moss then return false end
	if instance == moss then return true end

	local result = false
	pcall(function()
		-- Covers both possible layouts: the named object may itself be the raycast
		-- part/model, or it may be a Texture/child inside the part that was hit.
		result = instance:IsDescendantOf(moss) or moss:IsDescendantOf(instance)
	end)
	return result
end

function state.movementObstacleIgnoreList(character, includeTerrain)
	local ignored = { character }

	if includeTerrain then
		ignored[#ignored + 1] = workspace.Terrain
	end

	local moss = state.movementDinoWaterMossVisual()
	if moss then
		ignored[#ignored + 1] = moss
	end

	if isDinoLife then
		local rocks = state.movementDinoRocksFolder()
		if rocks then
			-- The dedicated per-rock OBB protector handles this folder. Excluding it
			-- here prevents the generic fan ray from treating a whole rock cluster as
			-- one noisy obstacle or fighting the committed per-rock bypass direction.
			ignored[#ignored + 1] = rocks
		end
	end

	return ignored
end


-- v97 tight PrideRock geometry: close-range avoidance only; no giant empty halo.
function state.movementPrideRockCircle(
	character,
	extraMargin
)
	local pride, cf, size =
		state.movementPrideRockBounds()

	if not pride or not cf or not size then
		return nil, nil, nil, nil
	end

	-- PrideRock is represented as one horizontal avoidance circle, but do NOT
	-- use the AABB diagonal as the radius: on this irregular model that creates
	-- a huge empty forbidden area around the real rock. Use the dominant
	-- horizontal half-extent, with a small contribution from the shorter axis.
	-- This still scales with the complete model/meshes without avoiding half
	-- the biome before the animal is actually near the rock.
	local halfX = size.X * 0.5
	local halfZ = size.Z * 0.5
	local longHalf =
		math.max(
			halfX,
			halfZ
		)
	local shortHalf =
		math.min(
			halfX,
			halfZ
		)

	local baseRadius =
		longHalf * 0.78
			+ shortHalf * 0.10

	local footprint =
		character
			and state.movementFootprint(
				character
			)
			or 4

	-- Only enough clearance for the animal body. The old +8 / minimum 11
	-- expanded the rock far beyond its visible surface.
	local bodyMargin =
		math.clamp(
			footprint * 0.45 + 3,
			5,
			12
		)

	local safeRadius =
		baseRadius
			+ bodyMargin
			+ math.max(
				0,
				tonumber(extraMargin) or 0
			)

	local center =
		Vector3.new(
			cf.Position.X,
			0,
			cf.Position.Z
		)

	return pride,
		center,
		baseRadius,
		safeRadius
end

function state.movementPrideRockPointForbidden(
	position,
	character,
	extraMargin
)
	if typeof(position) ~= "Vector3" then
		return false
	end

	if isDinoLife then
		local forbidden = state.movementDinoRockPointForbidden(
			position,
			character,
			extraMargin
		)
		return forbidden == true
	end

	local _, center, _, safeRadius =
		state.movementPrideRockCircle(
			character,
			extraMargin
		)

	if not center or not safeRadius then
		return false
	end

	local distance =
		Vector3.new(
			position.X - center.X,
			0,
			position.Z - center.Z
		).Magnitude

	return distance <= safeRadius
end

function state.movementPrideRockNearby(position, extraDistance)
	if typeof(position) ~= "Vector3" then
		return false
	end

	if isDinoLife then
		return state.movementDinoRockNearby(position, extraDistance)
	end

	local _, center, baseRadius =
		state.movementPrideRockCircle(
			nil,
			0
		)

	if not center or not baseRadius then
		return false
	end

	local distance =
		Vector3.new(
			position.X - center.X,
			0,
			position.Z - center.Z
		).Magnitude

	return distance
		<= baseRadius
			+ math.max(
				0,
				tonumber(extraDistance) or 28
			)
end

function state.prideRockSegmentIntersectsCircle(
	startPosition,
	endPosition,
	radius
)
	if typeof(startPosition) ~= "Vector3"
		or typeof(endPosition) ~= "Vector3"
		or not tonumber(radius) then
		return false
	end

	local _, center =
		state.movementPrideRockCircle(
			nil,
			0
		)

	if not center then
		return false
	end

	local ax = startPosition.X
	local az = startPosition.Z
	local bx = endPosition.X
	local bz = endPosition.Z

	local dx = bx - ax
	local dz = bz - az
	local lengthSquared =
		dx * dx + dz * dz

	if lengthSquared <= 0.001 then
		return Vector3.new(
			ax - center.X,
			0,
			az - center.Z
		).Magnitude <= radius
	end

	local toCenterX =
		center.X - ax
	local toCenterZ =
		center.Z - az

	local t =
		math.clamp(
			(
				toCenterX * dx
					+ toCenterZ * dz
			) / lengthSquared,
			0,
			1
		)

	local closestX =
		ax + dx * t
	local closestZ =
		az + dz * t

	local gapX =
		closestX - center.X
	local gapZ =
		closestZ - center.Z

	return (
		gapX * gapX
			+ gapZ * gapZ
	) <= radius * radius
end

function state.prideRockChooseClearDirection(
	character,
	root,
	preferredDirection
)
	if not character or not root then
		return nil
	end

	local pride,
		center,
		_,
		safeRadius =
			state.movementPrideRockCircle(
				character,
				2
			)

	if not pride
		or not center
		or not safeRadius then
		return nil
	end

	local cache =
		state.prideRockObstacleCache

	local preferred =
		typeof(preferredDirection)
				== "Vector3"
			and Vector3.new(
				preferredDirection.X,
				0,
				preferredDirection.Z
			)
			or Vector3.new(
				root.CFrame.LookVector.X,
				0,
				root.CFrame.LookVector.Z
			)

	if preferred.Magnitude <= 0.05 then
		preferred =
			Vector3.new(
				1,
				0,
				0
			)
	else
		preferred =
			preferred.Unit
	end

	local radial =
		Vector3.new(
			root.Position.X - center.X,
			0,
			root.Position.Z - center.Z
		)

	if radial.Magnitude <= 0.05 then
		radial =
			-preferred
	end

	local radialUnit =
		radial.Unit
	local distanceFromCenter =
		radial.Magnitude
	local boundaryGap =
		distanceFromCenter
			- safeRadius

	local function directionForSign(sign)
		local tangent =
			sign >= 0
				and Vector3.new(
					-radialUnit.Z,
					0,
					radialUnit.X
				)
				or Vector3.new(
					radialUnit.Z,
					0,
					-radialUnit.X
				)

		-- Never hug the rock wall. Near/inside the forbidden circle, bias
		-- strongly OUTWARD first; farther away, keep a smaller outward component
		-- while travelling tangentially around the circle.
		local outwardWeight =
			math.clamp(
				0.16
					+ math.max(
						0,
						7 - boundaryGap
					) / 14,
				0.16,
				0.82
			)

		local direction =
			tangent * 0.92
				+ radialUnit
					* outwardWeight

		if direction.Magnitude <= 0.05 then
			return tangent
		end

		return direction.Unit
	end

	-- Keep the SAME side once chosen. The world-space direction is recomputed
	-- from the circle tangent every frame, so it naturally curves around the
	-- rock instead of marching in one straight line into another obstacle.
	if cache.commitSign then

		local committed =
			directionForSign(
				cache.commitSign
			)

		cache.commitDirection =
			committed

		return committed
	end

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	local ignored = state.movementObstacleIgnoreList(character, true)
	table.insert(ignored, pride)

	local carcassStorage =
		workspace:FindFirstChild(
			"CarcassesStorageModel"
		)

	if carcassStorage then
		table.insert(
			ignored,
			carcassStorage
		)
	end

	params.FilterDescendantsInstances =
		ignored
	params.IgnoreWater = true

	pcall(function()
		params.RespectCanCollide =
			true
	end)

	local probeHeight =
		math.clamp(
			state.movementProbeHeight(
				character
			) * 0.75,
			2.2,
			6.5
		)

	local footprint =
		state.movementFootprint(
			character
		)

	local laneWidth =
		math.clamp(
			footprint * 0.55 + 1.5,
			3,
			12
		)

	local castLength =
		math.clamp(
			52 + footprint * 2.2,
			58,
			86
		)

	local function sceneClearance(direction)
		local right =
			Vector3.new(
				-direction.Z,
				0,
				direction.X
			)

		local clearance =
			castLength

		for _, lateral in ipairs({
			-laneWidth,
			0,
			laneWidth,
		}) do
			local hit =
				workspace:Raycast(
					root.Position
						+ right * lateral
						+ Vector3.new(
							0,
							probeHeight,
							0
						),
					direction
						* castLength,
					params
				)

			if hit then
				clearance =
					math.min(
						clearance,
						hit.Distance
					)
			end
		end

		return clearance
	end

	local bestSign
	local bestDirection
	local bestScore =
		-math.huge

	for _, sign in ipairs({
		-1,
		1,
	}) do
		local direction =
			directionForSign(
				sign
			)

		local clearance =
			sceneClearance(
				direction
			)

		local headingProgress =
			preferred:Dot(
				direction
			)

		-- Open terrain is more important than shaving a few studs from the path.
		-- This specifically avoids selecting the narrow slot between PrideRock
		-- and a tree/rock when the other side has a genuinely open corridor.
		local score =
			clearance * 1.8
				+ headingProgress * 14

		local forcedSign =
			state.safeMove
			and tonumber(state.safeMove.preferredObstacleSign)
			or nil

		if forcedSign
			and sign == (forcedSign >= 0 and 1 or -1) then
			-- A recovery replan intentionally tries the opposite side after a real
			-- stall. Clearance still dominates; this bias only breaks near-ties.
			score += 22
		end

		if score > bestScore then
			bestScore =
				score
			bestSign =
				sign
			bestDirection =
				direction
		end
	end

	if bestDirection
		and bestSign then

		cache.escapeAt =
			tick()
		cache.escapePosition =
			root.Position
		cache.escapeDirection =
			bestDirection

		cache.commitSign =
			bestSign
		cache.commitDirection =
			bestDirection
		cache.commitStartedAt =
			tick()
		cache.commitUntil =
			tick() + 8.0
	end

	return bestDirection
end


function state.prideRockObstacleProbe(
	character,
	root,
	direction,
	probeDistance
)
	if isDinoLife then
		return state.dinoRocksObstacleProbe(
			character,
			root,
			direction,
			probeDistance
		)
	end

	if not character
		or not root
		or typeof(direction)
			~= "Vector3"
		or direction.Magnitude <= 0.05 then
		return nil
	end

	local pride,
		center,
		_,
		safeRadius =
			state.movementPrideRockCircle(
				character,
				2
			)

	if not pride
		or not center
		or not safeRadius then
		return nil
	end

	local forward =
		Vector3.new(
			direction.X,
			0,
			direction.Z
		)

	if forward.Magnitude <= 0.05 then
		return nil
	end

	forward =
		forward.Unit

	local cache =
		state.prideRockObstacleCache
	local footprint =
		state.movementFootprint(
			character
		)

	local activationDistance =
		math.clamp(
			footprint * 1.15 + 6,
			9,
			18
		)

	-- vPRIDE-ROUTE-GUARD: a long SafeMove route may cross the Pride Rock
	-- forbidden circle even while the animal is still well outside the old
	-- 9-18 stud close-range activation band. Start the circular bypass early
	-- enough to curve around the model instead of reaching the wall at speed.
	-- This distance is still local to Pride Rock; unrelated trees/rocks keep
	-- their short-range object avoidance and are not affected.
	local routeGuardDistance =
		math.clamp(
			math.max(
				activationDistance,
				(tonumber(probeDistance) or 30) * 1.20
					+ footprint * 0.65
			),
			38,
			92
		)

	local rootFlat =
		Vector3.new(
			root.Position.X,
			0,
			root.Position.Z
		)

	local distanceFromCenter =
		(rootFlat - center).Magnitude

	local boundaryGap =
		distanceFromCenter
			- safeRadius

	local target =
		state.safeMove
		and state.safeMove.target

	local routeIntersects =
		false

	if typeof(target)
		== "Vector3" then

		routeIntersects =
			state.prideRockSegmentIntersectsCircle(
				root.Position,
				target,
				safeRadius + 2
			)
	else
		local lookAhead =
			math.max(
				tonumber(
					probeDistance
				) or 30,
				activationDistance + 28
			)

		routeIntersects =
			state.prideRockSegmentIntersectsCircle(
				root.Position,
				root.Position
					+ forward
						* lookAhead,
				safeRadius + 2
			)
	end

	local insideCircle =
		distanceFromCenter
			<= safeRadius

	-- Trusted Pride destinations: a route whose FINAL destination is a known safe
	-- Pride staging/farm point must not be rejected forever by the synthetic model
	-- envelope. v5.0 exempted only slot_switch, which is why the eventual Reset
	-- Point move could escape a spawn-behind-rock case while Growth Food recovery
	-- remained trapped. Keep the exemption narrow: slot staging, or the exact
	-- configured Growth/Pride home used by growth_home/herbivore_food_recovery.
	local routePurpose =
		state.safeMove
		and state.safeMove.reason
		or nil

	local targetInsideCircle =
		typeof(target) == "Vector3"
		and Vector3.new(
			target.X - center.X,
			0,
			target.Z - center.Z
		).Magnitude <= safeRadius + 4

	local targetIsGrowthHome = false
	if typeof(target) == "Vector3"
		and state.growthPride
		and typeof(state.growthPride.home) == "Vector3" then

		targetIsGrowthHome =
			Vector3.new(
				target.X - state.growthPride.home.X,
				0,
				target.Z - state.growthPride.home.Z
			).Magnitude <= 28
	end

	local trustedPrideTargetInsideCircle =
		targetInsideCircle
		and (
			routePurpose == "slot_switch"
				and state.slotSwitchStagingActive == true
			or targetIsGrowthHome
				and (
					routePurpose == "growth_home"
					or routePurpose == "herbivore_food_recovery"
				)
		)

	if trustedPrideTargetInsideCircle then
		cache.commitSign = nil
		cache.commitDirection = nil
		cache.commitStartedAt = 0
		cache.commitUntil = 0
		state.safeMove.prideRockEscapeDirection = nil
		return nil
	end

	-- Once a side is committed, keep curving around the same side only while the
	-- animal is still locally negotiating Pride Rock. The previous version could
	-- keep this commitment indefinitely on the BACK side whenever the distant
	-- destination still geometrically crossed the circle, making an animal arc
	-- around Pride Rock even after it was already far away.
	if cache.commitSign
		and not insideCircle
		and boundaryGap > routeGuardDistance + 8 then

		cache.commitSign = nil
		cache.commitDirection = nil
		cache.commitStartedAt = 0
		cache.commitUntil = 0
		state.safeMove.prideRockEscapeDirection = nil

		-- Do not immediately choose another side in this same frame. Resume the
		-- real route and let the normal guard reacquire only when locally relevant.
		return nil
	end

	-- Anti-oscillation hysteresis while Pride Rock is actually nearby.
	if cache.commitSign then
		local directClear =
			typeof(target) == "Vector3"
				and not state.prideRockSegmentIntersectsCircle(
					root.Position,
					target,
					safeRadius + 4
				)

		if directClear
			and boundaryGap > 6 then

			cache.commitSign =
				nil
			cache.commitDirection =
				nil
			cache.commitUntil =
				0

			state.safeMove.prideRockEscapeDirection =
				nil

			return nil
		end

		local committed =
			state.prideRockChooseClearDirection(
				character,
				root,
				forward
			)

		if committed then
			state.safeMove.prideRockEscapeDirection =
				committed

			local representative =
				pride:IsA("BasePart")
					and pride
					or pride.PrimaryPart
					or pride:FindFirstChildWhichIsA(
						"BasePart",
						true
					)

			if representative then
				return {
					Instance =
						representative,
					Position =
						root.Position
							+ committed * 2,
					Normal =
						Vector3.new(
							-committed.X,
							0,
							-committed.Z
						),
					Distance =
						math.max(
							0,
							boundaryGap
						),
				}
			end
		end
	end

	-- FAR from the circle: do nothing only when the route is also safely clear.
	-- If the real SafeMove segment crosses Pride Rock, keep watching it from a
	-- wider approach band so long routes (Swim/Zone/MoveTo/Food/Water/staging)
	-- begin curving BEFORE the animal reaches the rock face.
	if not insideCircle
		and boundaryGap > routeGuardDistance then

		state.safeMove.prideRockEscapeDirection =
			nil

		return nil
	end

	-- Near Pride Rock but travelling away / on a route that does not cross the
	-- forbidden circle: leave normal movement alone.
	if not insideCircle
		and not routeIntersects then

		state.safeMove.prideRockEscapeDirection =
			nil

		return nil
	end

	local escape =
		state.prideRockChooseClearDirection(
			character,
			root,
			forward
		)

	if not escape then
		return nil
	end

	state.safeMove.prideRockEscapeDirection =
		escape

	local cross =
		forward.X * escape.Z
			- forward.Z * escape.X

	state.safeMove.heavyObstacleSign =
		cross >= 0
			and 1
			or -1

	local representative =
		pride:IsA("BasePart")
			and pride
			or pride.PrimaryPart
			or pride:FindFirstChildWhichIsA(
				"BasePart",
				true
			)

	if not representative then
		return nil
	end

	return {
		Instance =
			representative,
		Position =
			root.Position
				+ escape * 2,
		Normal =
			Vector3.new(
				-escape.X,
				0,
				-escape.Z
			),
		Distance =
			math.max(
				0,
				boundaryGap
			),
	}
end

-- Shared physical obstacle probe for Savannah Life AND Dino Life.
-- Dino no longer has a separate long-range/corridor raycast brain: every land
-- animal uses the same body-envelope scanner below, scaled by its real model size.
function state.heavyObstacleProbe(
	character,
	root,
	direction,
	probeDistance,
	ignoreObstacleInstance
)
	if not character or not root or typeof(direction) ~= "Vector3" or direction.Magnitude <= 0.05 then return nil end
	local forward = Vector3.new(direction.X,0,direction.Z)
	if forward.Magnitude <= 0.05 then return nil end
	forward = forward.Unit
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignored = state.movementObstacleIgnoreList(character, true)
	if typeof(ignoreObstacleInstance) == "Instance" then
		table.insert(ignored, ignoreObstacleInstance)
	end
	local carcassStorage = workspace:FindFirstChild("CarcassesStorageModel")
	if carcassStorage then table.insert(ignored, carcassStorage) end
	params.FilterDescendantsInstances = ignored
	params.IgnoreWater = true
	pcall(function()
		params.RespectCanCollide = true
	end)

	local function castBlocking(origin, ray)
		for _ = 1, 10 do
			params.FilterDescendantsInstances = ignored
			local hit = workspace:Raycast(origin, ray, params)
			if not hit then return nil end
			local instance = hit.Instance
			local carcassModel =
				state.movementCarcassModelForInstance(instance)

			if state.movementIsDinoWaterMossVisual(instance) then
				table.insert(ignored, instance)
			elseif carcassModel then
				table.insert(ignored, carcassModel)
			elseif state.movementIsPrideRockInstance(instance) then
				-- PrideRock is handled only by the phased model-level probe above.
				-- Generic long object rays must not start steering while far away.
				local prideModel = state.movementPrideRockModel()
				if prideModel then
					table.insert(ignored, prideModel)
				else
					table.insert(ignored, instance)
				end
			elseif instance
				and instance:IsA("BasePart")
				and instance.CanCollide == false then
				table.insert(ignored, instance)
			else
				return hit
			end
		end
		return nil
	end

	local prideObstacle =
		state.prideRockObstacleProbe(
			character,
			root,
			forward,
			probeDistance
		)

	local right = Vector3.new(-forward.Z,0,forward.X)
	local tinyObstacleMover =
		state.isTinyObstacleMover(character)

	local halfWidth =
		math.clamp(
			state.movementFootprint(character) * 0.62 + 0.75,
			tinyObstacleMover and 2.2 or 3.2,
			12.5
		)

	local verticalSpread =
		tinyObstacleMover
			and math.clamp(
				state.movementBodySize(character).Y * 0.24,
				0.55,
				1.25
			)
			or math.clamp(
				state.movementBodySize(character).Y * 0.28,
				1.8,
				5.5
			)

	local baseOrigin =
		root.Position
			+ Vector3.new(
				0,
				tinyObstacleMover
					and math.clamp(
						state.movementProbeHeight(character) * 0.60,
						0.45,
						0.95
					)
					or math.clamp(
						state.movementProbeHeight(character) * 0.60,
						1.8,
						5.2
					),
				0
			)

	local nearest

	-- Still 3 x 3 = 9 rays: wider animal envelope, no per-frame ray explosion.
	for _, lateral in ipairs({-halfWidth,0,halfWidth}) do
		for _, vertical in ipairs({-verticalSpread,0,verticalSpread}) do
			local hit = castBlocking(baseOrigin+right*lateral+Vector3.new(0,vertical,0),forward*probeDistance)
			if hit and (not nearest or hit.Distance<nearest.Distance) then nearest=hit end
		end
	end

	if prideObstacle
		and (not nearest or prideObstacle.Distance <= nearest.Distance) then
		nearest = prideObstacle
	end

	if not nearest then
		state.safeMove.heavyObstacleSign=nil
		return nil
	end

	-- PrideRock already selected a wide/open heading from its complete model.
	-- Do not overwrite that result with the ordinary 68-degree side probe.
	if state.movementIsPrideRockInstance(nearest.Instance) then
		return nearest
	end
	local function corridorClearance(sign)
		local a=math.rad(78*sign); local c,s=math.cos(a),math.sin(a)
		local side=Vector3.new(forward.X*c-forward.Z*s,0,forward.X*s+forward.Z*c).Unit
		local length=probeDistance*1.55; local nearestSide=length
		for _, lateral in ipairs({-halfWidth*0.72,0,halfWidth*0.72}) do
			local hit=castBlocking(baseOrigin+right*lateral,side*length)
			if hit then nearestSide=math.min(nearestSide,hit.Distance) end
		end
		return nearestSide
	end
	local leftClear,rightClear=corridorClearance(-1),corridorClearance(1)
	state.safeMove.heavyObstacleSign=leftClear>=rightClear and -1 or 1
	return nearest
end

function state.movementRootClearance(character)
	if not character then return 3 end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return 3 end
	local lowest = math.huge
	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("BasePart") then
			lowest = math.min(lowest, object.Position.Y - object.Size.Y * 0.5)
		end
	end
	if lowest == math.huge then return 3 end
	return math.clamp(root.Position.Y - lowest, 2.2, 10)
end

function state.aquaticWaterStandOffset(character)
	local clearance = state.movementRootClearance(character)
	local key = state.safeMovementAnimalKey(character)
	if key == "hippo" then
		return math.clamp(clearance + 0.35, 2.8, 7.5)
	end
	return math.clamp(clearance + 0.20, 2.5, 8)
end

function state.heavyWalkStop(character)
	local walk = state.heavyWalk
	if not walk then return end

	if walk.walkSpeedConnection then
		pcall(
			walk.walkSpeedConnection.Disconnect,
			walk.walkSpeedConnection
		)
		walk.walkSpeedConnection = nil
	end

	local activeCharacter =
		character or walk.character

	local humanoid =
		activeCharacter
			and activeCharacter:FindFirstChildOfClass("Humanoid")
			or walk.humanoid

	local root =
		activeCharacter
			and activeCharacter:FindFirstChild("HumanoidRootPart")
			or walk.root

	if humanoid then
		if root then
			pcall(
				humanoid.MoveTo,
				humanoid,
				root.Position
			)
		end

		pcall(
			humanoid.Move,
			humanoid,
			Vector3.zero,
			false
		)

		pcall(function()
			if walk.originalWalkSpeed then
				humanoid.WalkSpeed =
					walk.originalWalkSpeed
			end

			if walk.originalHipHeight ~= nil then
				humanoid.HipHeight =
					walk.originalHipHeight
			end

			humanoid.PlatformStand =
				walk.platformStand == true

			humanoid.AutoRotate =
				walk.autoRotate ~= false
		end)
	end

	if activeCharacter
		and activeCharacter.Parent then
		activeCharacter:SetAttribute(
			"MovementDisabled",
			walk.movementDisabled == true
		)
	end

	walk.character = nil
	walk.humanoid = nil
	walk.root = nil
	walk.originalWalkSpeed = nil
	walk.originalHipHeight = nil
	walk.targetWalkSpeed = nil
	walk.movementDisabled = nil
	walk.autoRotate = nil
	walk.platformStand = nil
	walk.owner = nil
	walk.ownerToken = nil
	walk.lastInstructionAt = 0
	walk.lastMoveToAt = 0
	walk.lastMoveToPoint = nil
	walk.lastHeading = nil
end

function state.heavyWalkPrepare(
	character,
	humanoid,
	root,
	targetWalkSpeed,
	owner,
	ownerToken
)
	if not character
		or not humanoid
		or not root
		or (
			owner ~= "autoRun"
				and owner ~= "manual"
				and owner ~= "safeMove"
				and not state.isHeavyGroundMover(
					character
				)
		) then

		return false
	end

	local walk = state.heavyWalk

	owner =
		type(owner) == "string"
			and owner
			or "unknown"

	local ownerChanged =
		walk.character == character
			and walk.owner ~= nil
			and (
				walk.owner ~= owner
				or (
					ownerToken ~= nil
						and walk.ownerToken ~= ownerToken
				)
			)

	if ownerChanged then
		state.heavyWalkStop(
			walk.character
		)
		walk = state.heavyWalk
	end

	if walk.character
		and walk.character ~= character then
		state.heavyWalkStop(
			walk.character
		)
		walk = state.heavyWalk
	end

	local newCharacter =
		walk.character ~= character
			or walk.humanoid ~= humanoid

	if newCharacter then
		if walk.walkSpeedConnection then
			pcall(
				walk.walkSpeedConnection.Disconnect,
				walk.walkSpeedConnection
			)
			walk.walkSpeedConnection = nil
		end

		walk.character = character
		walk.humanoid = humanoid
		walk.root = root

		walk.originalWalkSpeed =
			humanoid.WalkSpeed

		walk.originalHipHeight =
			humanoid.HipHeight

		walk.movementDisabled =
			character:GetAttribute(
				"MovementDisabled"
			)

		walk.autoRotate =
			humanoid.AutoRotate

		walk.platformStand =
			humanoid.PlatformStand

		walk.lastMoveToAt = 0
		walk.lastMoveToPoint = nil
		walk.lastHeading = nil

		-- Same principle as IY loopspeed:
		-- if the game changes WalkSpeed, restore the requested value.
		walk.walkSpeedConnection =
			humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
				if not state.alive
					or state.heavyWalk.character ~= character
					or state.heavyWalk.humanoid ~= humanoid then
					return
				end

				local wanted =
					tonumber(
						state.heavyWalk.targetWalkSpeed
					)

				if wanted
					and wanted > 0
					and math.abs(
						humanoid.WalkSpeed - wanted
					) > 0.05 then

					pcall(function()
						humanoid.WalkSpeed = wanted
					end)
				end
			end)
	end

	walk.owner = owner
	walk.ownerToken = ownerToken
	walk.lastInstructionAt = tick()

	walk.targetWalkSpeed =
		math.max(
			1,
			tonumber(targetWalkSpeed)
				or state.safeMovementSpeed(character)
		)

	pcall(function()
		humanoid.PlatformStand = false

		local worldSteeringOwner =
			owner == "autoRun"
				or owner == "manual"
				or owner == "safeMove"
				or owner == "nudge"

		humanoid.AutoRotate =
			not worldSteeringOwner

		if math.abs(
			humanoid.WalkSpeed
				- walk.targetWalkSpeed
		) > 0.05 then
			humanoid.WalkSpeed =
				walk.targetWalkSpeed
		end

		-- Crocodile and Hippo have long/heavy low rigs that can catch on
		-- Terrain seams and steep beach transitions. Give both the same tiny
		-- temporary ground clearance only while automated land walking is active;
		-- heavyWalkStop() restores the exact original HipHeight afterward.
		if walk.originalHipHeight ~= nil then
			local wantedHipHeight =
				walk.originalHipHeight
				+ (
					state.isCrocOrHippoMovementCharacter(
						character
					)
						and 0.28
						or 0
				)

			if math.abs(
				humanoid.HipHeight
					- wantedHipHeight
			) > 0.03 then
				humanoid.HipHeight =
					wantedHipHeight
			end
		end
	end)

	character:SetAttribute(
		"MovementDisabled",
		false
	)

	return true
end

function state.moveToWorldSteer(
	character,
	root,
	direction
)
	if not character
		or not root
		or typeof(direction) ~= "Vector3" then
		return false
	end

	local flat =
		Vector3.new(
			direction.X,
			0,
			direction.Z
		)

	if flat.Magnitude <= 0.05 then
		return false
	end

	local heading =
		flat.Unit

	-- WORLD-SPACE steering only. Position is preserved exactly.
	pcall(function()
		root.CFrame =
			CFrame.lookAt(
				root.Position,
				root.Position + heading,
				Vector3.yAxis
			)
	end)

	root.AssemblyAngularVelocity =
		Vector3.zero

	return true
end

function state.heavyWalkStep(
	character,
	root,
	humanoid,
	direction,
	walkSpeed,
	remainingDistance,
	finalTarget,
	owner,
	ownerToken
)
	if not character
		or not root
		or not humanoid
		or typeof(direction) ~= "Vector3" then
		return false
	end

	local flat =
		Vector3.new(
			direction.X,
			0,
			direction.Z
		)

	if flat.Magnitude <= 0.05 then
		return true
	end

	if not state.heavyWalkPrepare(
		character,
		humanoid,
		root,
		walkSpeed,
		owner,
		ownerToken
	) then
		return false
	end

	-- v117: exact smooth v115 steering cadence.
	-- Route/avoidance already selected the heading; never dilute it here.
	local heading = flat.Unit
	local remaining =
		tonumber(remainingDistance)

	local leadDistance =
		remaining
			and math.clamp(
				remaining,
				2.5,
				18
			)
			or 18

	local movePoint

	if owner == "autoRun"
		and typeof(finalTarget) == "Vector3" then

		-- v121: AutoRun's circle/bypass point is already a FIXED world-space
		-- target. Send that exact point to Humanoid:MoveTo instead of converting
		-- it back into another moving point in front of the animal.
		movePoint =
			Vector3.new(
				finalTarget.X,
				root.Position.Y,
				finalTarget.Z
			)

	elseif typeof(finalTarget) == "Vector3"
		and remaining
		and remaining <= 18 then

		movePoint =
			Vector3.new(
				finalTarget.X,
				root.Position.Y,
				finalTarget.Z
			)
	else
		movePoint =
			root.Position
				+ heading * leadDistance
	end

	local steerDelta =
		Vector3.new(
			movePoint.X - root.Position.X,
			0,
			movePoint.Z - root.Position.Z
		)

	if steerDelta.Magnitude > 0.05 then
		state.moveToWorldSteer(
			character,
			root,
			steerDelta
		)
	else
		state.moveToWorldSteer(
			character,
			root,
			heading
		)
	end

	local walk =
		state.heavyWalk

	walk.lastInstructionAt =
		tick()

	local pointChanged =
		not walk.lastMoveToPoint
			or (
				walk.lastMoveToPoint
					- movePoint
			).Magnitude >= 1.25

	if pointChanged
		or tick()
			- (
				walk.lastMoveToAt or 0
			) >= 0.10 then

		walk.lastMoveToAt =
			tick()

		walk.lastMoveToPoint =
			movePoint

		pcall(
			humanoid.MoveTo,
			humanoid,
			movePoint
		)
	end

	return true
end

function state.releaseMovementNow(character, zeroHorizontal)
	if state.heavyWalk
		and state.heavyWalk.character then

		pcall(
			state.heavyWalkStop,
			character
				or state.heavyWalk.character
		)
	end

	pcall(function()
		local env = (getgenv and getgenv()) or _G
		local release = env and env.keyrelease
		if type(release) == "function" then release(0x57) end
	end)
	pcall(function()
		game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.W, false, game)
	end)

	-- A KeyUp alone is not enough while Permanent-W is bound: the next
	-- RenderStep would press W again and fight the slot-staging MoveTo.
	if state.questSetLandPermanentW then
		pcall(
			state.questSetLandPermanentW,
			false
		)
	end

	state.questLandKeyDown = false
	state.questLandLastPulseAt = 0
	state.questLandLastRefreshAt = 0
	state.questLandRefreshingW = false
	character = character or player.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if humanoid then
		pcall(humanoid.Move, humanoid, Vector3.zero, false)
		pcall(function()
			humanoid.PlatformStand = false
			humanoid.AutoRotate = true
		end)
	end
	if root and zeroHorizontal ~= false then
		local velocity = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
		root.AssemblyAngularVelocity = Vector3.zero
	end
end

function state.survivalAutomationRequested()
	return state.autoQuests == true
		or state.farmCoins == true
		or state.growExisting == true
		or state.growAllSlots == true
		or state.growNew == true
		or state.growExistingAutomaticAll == true
		or state.questPostGrowAll == true
		or state.questGrowthOwnsCurrent == true
		or (
			state.questGrowthReset
			and (
				state.questGrowthReset.active == true
				or state.questGrowthReset.exclusive == true
				or state.questGrowthReset.busy == true
			)
		)
end

function state.applySurvivalDefaults(forceEnable)
	local automationWantsSurvival =
		forceEnable == true
		or state.survivalAutomationRequested()

	local intent =
		state.MMBAI
		and state.MMBAI.UserIntent

	local desiredEat
	local desiredDrink

	if automationWantsSurvival then
		-- Automation owns the DEFAULT, not the user's explicit OFF choice.
		-- autoEatManualDisabled/autoDrinkManualDisabled distinguish an actual
		-- user opt-out from the normal fresh-session default of false.
		desiredEat = state.autoEatManualDisabled ~= true
		desiredDrink = state.autoDrinkManualDisabled ~= true
	else
		desiredEat = state.autoEat == true
		desiredDrink = state.autoDrink == true

		if intent and type(intent.values) == "table" then
			desiredEat = intent.values.autoEat == true
			desiredDrink = intent.values.autoDrink == true
		end

		desiredEat = desiredEat
			and state.autoEatManualDisabled ~= true

		desiredDrink = desiredDrink
			and state.autoDrinkManualDisabled ~= true
	end

	-- Croc/Hippo underwater Fly is an exclusive movement transaction.
	-- Remember what automation/user intent wants, but keep the effective
	-- toggles OFF until the dedicated water-exit controller acknowledges dry land.
	if state.aquaticRiverEscape
		and state.aquaticRiverEscape.survivalSuspended then

		state.aquaticRiverEscape.resumeAutoEat = desiredEat
		state.aquaticRiverEscape.resumeAutoDrink = desiredDrink
		state.autoEat = false
		state.autoDrink = false
		return false
	end

	state.autoEat = desiredEat == true
	state.autoDrink = desiredDrink == true

	return state.autoEat or state.autoDrink
end

function state.enableSurvivalForAutomation(reason)
	local enabled =
		state.applySurvivalDefaults(true)

	local ai = state.MMBAI
	if ai and ai.Enabled == true then
		if state.autoDrink
			and type(ai.RequestWorker) == "function" then

			pcall(
				ai.RequestWorker,
				ai,
				"AutoDrink",
				(reason or "Automation") .. " survival handoff",
				0.05
			)
		end

		if state.autoEat
			and type(ai.RequestWorker) == "function" then

			pcall(
				ai.RequestWorker,
				ai,
				"AutoEat",
				(reason or "Automation") .. " survival handoff",
				0.05
			)
		end
	end

	if state.aquaticRiverEscape
		and state.aquaticRiverEscape.survivalSuspended then

		runtimeMessage =
			(reason or "Automation")
			.. ": Survival queued until Water Exit finishes"
	end

	return enabled == true
end

function state.isFlyingMovementCharacter(character)
	local key =
		state.safeMovementAnimalKey(character)

	return key ~= ""
		and state.questFlyingAnimals
		and state.questFlyingAnimals[key] == true
end

function state.adjustMovementAcceleration(character, value)
	value = tonumber(value)

	if not value or value <= 0 then
		return nil
	end

	-- Flying animals advertise their flight ceiling, and Crocodile advertises
	-- its fast underwater/swimming ceiling. Neither value is a valid land speed.
	-- For movement automation, both are capped to 50% of live Acceleration.
	if state.isFlyingMovementCharacter(character)
		or CROC.isCharacter(character) then

		return value * 0.50
	end

	return value
end

function state.movementGrowthRatio(character)
	if not character then return 1 end

	local growth =
		tonumber(
			character:GetAttribute(
				"GrowthPercentage"
			)
		)

	if growth == nil then
		-- Giraffe must never receive an adult movement profile just because the
		-- GrowthPercentage attribute has not replicated yet. Start conservatively;
		-- the normal live re-read raises the speed automatically as soon as Growth
		-- becomes available.
		if isGiraffeCharacter(character) then
			return 0.25
		end

		return 1
	end

	if growth > 1 then
		growth /= 100
	end

	return math.clamp(growth, 0, 1)
end

function state.rawMovementAcceleration(character)
	character = character or player.Character

	-- The ACTIVE Character is authoritative. The old code took the minimum
	-- between this value and any same-name Workspace model, which meant a stale
	-- old model could permanently throttle an already-adult animal.
	local liveAcceleration =
		character
		and tonumber(
			character:GetAttribute(
				"Acceleration"
			)
		)

	if liveAcceleration
		and liveAcceleration > 0 then

		return state.adjustMovementAcceleration(
			character,
			liveAcceleration
		)
	end

	-- Fallback only while the real Character attribute has not replicated yet.
	local model =
		workspace:FindFirstChild(
			player.Name
		)

	local fallbackAcceleration =
		model
		and tonumber(
			model:GetAttribute(
				"Acceleration"
			)
		)

	if fallbackAcceleration
		and fallbackAcceleration > 0 then

		return state.adjustMovementAcceleration(
			character or model,
			fallbackAcceleration
		)
	end

	return nil
end

function state.giraffeMovementStageScale(growth)
	growth =
		math.clamp(
			tonumber(growth) or 0.25,
			0,
			1
		)

	-- Smooth progressive movement ceiling:
	--
	--   0%   Growth -> 42% of live Acceleration
	--   25%  Growth -> 56%
	--   50%  Growth -> 70%
	--   75%  Growth -> 84%
	--   100% Growth -> 98%
	--
	-- This intentionally remains just under the game's advertised Acceleration
	-- even when adult. Giraffe never receives the generic mature ground boost.
	return 0.42 + 0.56 * growth
end

function state.dynamicMovementSpeed(character, mode)
	character = character or player.Character

	local acceleration =
		state.rawMovementAcceleration(
			character
		)

	local growth =
		state.movementGrowthRatio(
			character
		)

	local growthScale =
		0.30 + 0.70 * growth

	local modeScale =
		mode == "Swimming"
			and 0.82
			or 1.00

	if acceleration
		and acceleration > 0 then

		if state.isDinoRexMovementCharacter(character) then
			local humanoid =
				character
				and character:FindFirstChildOfClass(
					"Humanoid"
				)

			local originalWalkSpeed =
				state.heavyWalk
				and state.heavyWalk.character == character
				and tonumber(
					state.heavyWalk.originalWalkSpeed
				)

			local dinoBaseSpeed =
				math.max(
					acceleration,
					originalWalkSpeed
						or (humanoid and tonumber(humanoid.WalkSpeed))
						or 0
				)

			-- Dino Life's Rex reports a conservative Acceleration compared with its
			-- actual ground locomotion. Keep the SAME world-space MoveTo engine used
			-- by Savannah, but do not let that low attribute throttle the dinosaur.
			local rexMultiplier =
				growth >= 0.95
					and 1.18
					or 1.08

			return dinoBaseSpeed
				* modeScale
				* rexMultiplier,
				acceleration,
				growth
		end

		local specialMovementCeiling =
			state.isFlyingMovementCharacter(
				character
			)
			or CROC.isCharacter(
				character
			)

		if specialMovementCeiling then
			-- Preserve the existing conservative rule for flyers and Croc. Their
			-- advertised Acceleration represents flight/swimming, not normal land.
			local target =
				acceleration
				* growthScale
				* modeScale
				* 0.90

			return math.min(
				target,
				acceleration * 0.92
			),
				acceleration,
				growth
		end

		if isGiraffeCharacter(character) then
			-- GIRAFFE STAGE ACCELERATION FIX:
			-- The generic terrestrial branch below intentionally ignores
			-- growthScale and gives young animals almost full Acceleration.
			-- That is visibly wrong for Giraffe, especially very young slots.
			local stageScale =
				state.giraffeMovementStageScale(
					growth
				)

			local target =
				acceleration
				* stageScale
				* modeScale

			-- Never exceed the current live Acceleration. The stage scale already
			-- ramps smoothly as GrowthPercentage rises, so SafeMove/Auto Run/food
			-- routes automatically accelerate with the same Giraffe as it grows.
			return math.min(
				target,
				acceleration * 0.98
			),
				acceleration,
				growth
		end

		-- Normal terrestrial animals expose the current live Acceleration.
		-- Adult animals were still feeling artificially slow because we treated
		-- that value as an absolute speed ceiling and stopped below it.
		--
		-- Give ONLY mature normal terrestrial animals modest headroom. Croc and
		-- flyers never enter this branch and keep their conservative land rule.
		local matureGroundBoost =
			growth >= 0.95
				and 1.10
				or 0.985

		local target =
			acceleration
			* modeScale
			* matureGroundBoost

		local ceiling =
			growth >= 0.95
				and acceleration * 1.12
				or acceleration * 0.99

		return math.min(
			target,
			ceiling
		),
			acceleration,
			growth
	end

	-- Conservative fallback while the new slot's attributes replicate.
	local humanoid =
		character
		and character:FindFirstChildOfClass(
			"Humanoid"
		)

	local fallback =
		humanoid
		and tonumber(humanoid.WalkSpeed)
		or (
			state.isFlyingMovementCharacter(character)
				and 12
				or 16
		)

	fallback = math.max(1, fallback)

	return fallback
		* growthScale
		* modeScale
		* 0.90,
		0,
		growth
end

task.spawn(function()
	while state.alive do
		pcall(function()
			local walk =
				state.heavyWalk

			local character =
				walk
				and walk.character

			if not character
				or character ~= player.Character
				or not isGiraffeCharacter(
					character
				)
				or not walk.humanoid
				or not walk.humanoid.Parent then

				return
			end

			local wanted =
				state.dynamicMovementSpeed(
					character,
					"Land"
				)

			if wanted
				and wanted > 0
				and walk.targetWalkSpeed
				and walk.targetWalkSpeed > wanted * 1.04 then

				-- Only clamp DOWN here. Normal route code remains responsible for
				-- raising speed as Growth advances and for applying route speedScale.
				walk.targetWalkSpeed =
					wanted

				if walk.humanoid.WalkSpeed > wanted then
					walk.humanoid.WalkSpeed =
						wanted
				end
			end
		end)

		task.wait(0.30)
	end
end)

function state.safeMovementSpeed(character)
	local speed =
		state.dynamicMovementSpeed(
			character,
			"Land"
		)

	return math.max(1, speed)
end

function state.safeNudgeToward(root, targetPosition, speedScale)
	if not root or typeof(targetPosition) ~= "Vector3" then return false end

	local character = player.Character

	if state.isHeavyGroundMover(character) then
		local humanoid =
			character
			and character:FindFirstChildOfClass("Humanoid")

		local flatMove =
			Vector3.new(
				targetPosition.X - root.Position.X,
				0,
				targetPosition.Z - root.Position.Z
			)

		if flatMove.Magnitude <= 0.15 then
			return true
		end

		if humanoid then
			local requestedSpeed =
				state.safeMovementSpeed(character)
				* math.clamp(
					tonumber(speedScale) or 0.35,
					0.05,
					1
				)

			local moved =
				state.heavyWalkStep(
					character,
					root,
					humanoid,
					flatMove.Unit,
					requestedSpeed,
					flatMove.Magnitude,
					targetPosition,
					"nudge",
					nil
				)

			if moved then
				setSubState("Walking")
				return true
			end
		end
	end

	local flat = Vector3.new(
		targetPosition.X - root.Position.X,
		0,
		targetPosition.Z - root.Position.Z
	)

	if flat.Magnitude <= 0.15 then return true end

	local maximum =
		state.safeMovementSpeed(player.Character)
		* math.clamp(tonumber(speedScale) or 0.35, 0.05, 1)

	local speed = math.min(
		maximum,
		math.max(3, flat.Magnitude * 1.6)
	)

	local velocity = root.AssemblyLinearVelocity
	local direction = flat.Unit

	root.AssemblyLinearVelocity = Vector3.new(
		direction.X * speed,
		velocity.Y,
		direction.Z * speed
	)

	return true
end

