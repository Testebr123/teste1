		self.progressPosition = context.position
		self.progressDistance = distance
		self.progressFood = context.food
		self.progressWater = context.water
		self.progressHealth = context.healthFraction
		self.progressAt = tick()
		return
	end
	local stalled = now - (self.progressAt or now)
	if stalled >= self:ProgressTimeout(self.currentOwner, context)
		and now - (self.lastEscalationAt or 0) >= 1.25 then
		self.lastEscalationAt = now
		self:Escalate(context, stalled)
	end
end

function Authority:Escalate(context, stalledFor)
	local owner = self.currentOwner
	local reason = string.format("%s made no verified progress for %.1fs", tostring(owner), tonumber(stalledFor) or 0)
	ai.Blackboard.lastProblem = reason
	if ai.Telemetry then
		ai.Telemetry:Push("SupervisorAuthority", "escalate", {reason=reason,owner=owner,result="authoritative escalation",debounce=1.5},
			"authority-stall:"..tostring(owner), "Supervisor escalation: "..tostring(owner))
	end

	if owner == "Safety" then
		if not self:SafetyHazard(
			context
		) then

			self:ReleaseStaleSafety(
				context,
				"Safety escalation aborted: no live hazard"
			)

			return
		end

		-- The Supervisor, not a watchdog, decides when a Safety executor has failed.
		-- Tear down the stalled Safety executor before selecting/restarting another.
		self:ForceCancelOwner("Safety", reason)
		self.currentController = "DecisionEngine"
		self.controllerLeaseUntil = 0
		if context.dinoShorelineFoodDeadlock and state.startDinoShorelineFoodRecovery then
			state.startDinoShorelineFoodRecovery("Supervisor Safety escalation")
			return
		end
		if context.dinoRockTrapped and state.startDinoRockTrapRecovery then
			state.startDinoRockTrapRecovery("Supervisor Safety escalation", true)
			return
		end
		ai:RequestWorker("Safety", reason, 0.05)
		return
