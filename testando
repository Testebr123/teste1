-- Hard stale-movement scrub. A previous execution can die while a named
-- RenderStep W controller is still bound. A simple KeyUp is not enough because
-- that orphan callback immediately presses W again on the next rendered frame.
-- Always remove the fixed binding names before this fresh Hub owns movement.
do
	pcall(function()
		RunService:UnbindFromRenderStep("MMB_PermanentWHold")
	end)
	pcall(function()
		RunService:UnbindFromRenderStep("MMB_PermanentWWorldSteer")
	end)

	pcall(function()
		local env = (getgenv and getgenv()) or _G
		local release = env and rawget(env, "keyrelease")
		if type(release) == "function" then
			release(0x57)
		end
	end)

	pcall(function()
		game:GetService("VirtualInputManager"):SendKeyEvent(
			false,
			Enum.KeyCode.W,
			false,
			game
		)
	end)
end

