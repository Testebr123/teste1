function state.coinFarmRequestPreferredSwitch(reason)
	if not state.farmCoins then
		state.coinFarmSwitchPending = false
		state.coinFarmSwitchReason = nil
		return
	end

	local preferred = state.coinFarmPreferredAnimal

	if type(preferred) ~= "string" or preferred == "" then
		state.coinFarmSwitchPending = false
		state.coinFarmSwitchReason = nil

		local character = player.Character
		local currentAnimal = character
			and character:GetAttribute("AnimalName")
			or "current animal"

		questStatusText =
			"AFK Coin Farm: keeping current animal -> "
			.. tostring(currentAnimal)

		runtimeMessage =
			"No AFK Coin animal selected; keeping the animal active when Coin Farm started"
		return
	end

	state.coinFarmSwitchPending = true
	state.coinFarmSwitchReason = reason or "AFK Coin Farm started"
	state.coinFarmRetryAt = 0

	questStatusText =
		"AFK Coin Farm: preferred animal -> "
		.. preferred
end

function state.coinFarmTryPreferredSwitch()
	if not state.farmCoins
		or not state.coinFarmSwitchPending
		or state.coinFarmSwitching
		or tick() < (state.coinFarmRetryAt or 0) then
		return
	end

	local preferred = state.coinFarmPreferredAnimal
	if type(preferred) ~= "string" or preferred == "" then
		state.coinFarmSwitchPending = false
		return
	end

	local character = player.Character
	local currentAnimal = character
		and character:GetAttribute("AnimalName")

	if type(currentAnimal) == "string"
		and state.questAnimalKey(currentAnimal)
			== state.questAnimalKey(preferred) then

		state.coinFarmSwitchPending = false
		state.coinFarmSwitchReason = nil

		questStatusText =
			"AFK Coin Farm: "
			.. preferred
			.. " selected"

		runtimeMessage =
			"AFK Coin preferred animal already active: "
			.. preferred
		return
	end

	-- Never fight Eat/Drink, damage recovery, Growth reset, a quest switch,
	-- or another ragdoll teleport. The preferred species remains pending.
	if growthBusy
		or state.busy
		or questSwitchingAnimal
		or criticalRecoveryActive
		or DAMAGE.active
		or state.questGrowthReset.exclusive
		or state.questGrowthReset.busy
		or drinkingToFull
		or eatingToFull
		or carcassEatBusy
		or BABOON.busy
		or GIRAFFE.busy
		or CROC.approachBusy
		or forcingPostDrinkTeleport then
		return
	end

	local target = state.coinFarmFindPreferredSlot(
		savedCharacters(),
		preferred
	)

	-- The selector only lists existing species, but a slot can be removed after
	-- selection. Fail safely: clear the stale preference and keep current animal.
	if not target then
		state.coinFarmPreferredAnimal = nil
		state.coinFarmSwitchPending = false
		state.coinFarmSwitchReason = nil

		runtimeMessage =
			"Selected AFK Coin animal no longer has a saved slot; keeping current animal"
		questStatusText =
			"AFK Coin Farm: Current animal (saved selection unavailable)"

		state.coinFarmRenderPreferred()
		return
	end

	state.coinFarmSwitching = true
	state.coinFarmSwitchPending = false

	local requestedAnimal = preferred
	local previousAutoEat = state.autoEat
	local previousAutoDrink = state.autoDrink

	-- Prevent survival loops from trying to operate on the disappearing
	-- character during the short Reset -> Spawn transition.
	state.autoEat = false
	state.autoDrink = false
	blockClientSubState = false
	state.questSetW(false)
	DAMAGE.cooldownUntil = math.max(
		DAMAGE.cooldownUntil or 0,
		tick() + 20
	)

	runtimeMessage =
		"AFK Coin Farm: switching to preferred animal "
		.. requestedAnimal

	questStatusText =
		"AFK Coin Farm: switching -> "
		.. requestedAnimal

	task.spawn(function()
		if ResetRemote then
			pcall(ResetRemote.InvokeServer, ResetRemote)
			task.wait(1.35)
		end

		-- Even if Coin Farm/selection changed while the menu was open, always
		-- finish spawning something so the player is never left slotless.
		local spawned = spawnSlot(target)

		state.coinFarmSwitching = false

		if state.farmCoins then
			state.autoEat = true
			state.autoDrink = true
		else
			state.autoEat = previousAutoEat
			state.autoDrink = previousAutoDrink
		end

		if renders then
			if renders.autoEat then renders.autoEat() end
			if renders.autoDrink then renders.autoDrink() end
		end

		if spawned then
			if state.farmCoins
				and type(state.coinFarmPreferredAnimal) == "string"
				and state.questAnimalKey(state.coinFarmPreferredAnimal)
					~= state.questAnimalKey(requestedAnimal) then

				-- User changed the dropdown during the switch. Complete this
				-- spawn first, then honor the NEW choice on the next pass.
				state.coinFarmSwitchPending = true
				state.coinFarmRetryAt = tick() + 1
				runtimeMessage =
					"AFK Coin animal selection changed; applying new preference"
			else
				state.coinFarmSwitchPending = false
				questStatusText =
					"AFK Coin Farm: "
					.. requestedAnimal
				runtimeMessage =
					"AFK Coin preferred animal active: "
					.. requestedAnimal
			end
		elseif state.farmCoins then
			state.coinFarmSwitchPending = true
			state.coinFarmRetryAt = tick() + 10
			runtimeMessage =
				"AFK Coin preferred animal spawn was not confirmed; retrying later"
		end
	end)
end


local preSwitchTopUpActive = false -- true enquanto estamos no meio de encher comida/água antes de trocar
local preSwitchTopUpStartedAt = nil
local PRE_SWITCH_TOP_UP_TIMEOUT = 90 -- segundos: desiste de esperar 100% (ex: sem carcaça por perto) e troca mesmo assim
local MAX_SLOTS = 40

local function findNamedSpawnPart(name)
	local spawns = workspace:FindFirstChild("Spawns")
	if not spawns then return nil end
	return spawns:FindFirstChild(name, true)
end

local function teleportBeforeSlotChange()
	-- Teleporta pro ponto de troca certo de cada jogo e só considera pronto
	-- quando CONFIRMAR que o personagem está em terra firme (sem água, sem
	-- void). Isso já desliga comer/beber durante toda a tentativa.
	-- Savannah/Jungle usam PrideRockSpawn1; Dino Life usa NestRock3
	-- (nomes diferentes por jogo — usar o nome errado faz cair no fallback
	-- errado e o personagem nunca confirma terra firme).
	local spawnName = isDinoLife and "NestRock3" or "PrideRockSpawn1"
	local namedSpawn = findNamedSpawnPart(spawnName)
	local target = namedSpawn and namedSpawn.Position or (selectedCompletionSpawn and selectedCompletionSpawn.Parent and selectedCompletionSpawn.Position) or getSafeFarmPosition()
	local label = namedSpawn and spawnName or "ponto de troca"
	return ensureOnSolidGround(target, label)
end

local function growthStep()
	if state.questGrowthReset.exclusive then return end
	if state.farmCoins
		or growthBusy
		or state.busy
		or not (
			state.growExisting
			or state.growAllSlots
			or state.growNew
		) then
		return
	end
	-- Se uma rotina crítica (saída de água/void) estiver no controle do
	-- personagem, o growthStep NÃO pode religar autoEat/autoDrink nem fazer
	-- nada — senão as duas rotinas brigam pra teleportar o personagem pra
	-- lugares diferentes ao mesmo tempo (isso já matou um Rex no Dino Life).
	if criticalRecoveryActive then return end
	state.autoEat, state.autoDrink = true, true
	if renders then
		if renders.autoEat then renders.autoEat() end
		if renders.autoDrink then renders.autoDrink() end
	end
	local character = player.Character
	if not character then return end
	local growth = character:GetAttribute("GrowthPercentage")
	if type(growth) ~= "number" or not isGrowthComplete(growth) then return end

	-- Antes de trocar de slot: comida e água precisam estar com boa margem.
	-- Só dispara o "encher" se algum dos dois cair abaixo de 85% (histerese
	-- — não fica reativando à toa). Quando dispara, enche os dois até perto
	-- de 100% (15% de margem), NA ORDEM: primeiro toda a comida, só depois
	-- a água — beber nunca interrompe o comer no meio. Depois de encher os
	-- dois, para e não tenta de novo até algum cair abaixo de 85% de novo.
	local food = character:GetAttribute("Food") or 100
	local water = character:GetAttribute("Water") or 100

	if not preSwitchTopUpActive and (food < 85 or water < 85) then
		preSwitchTopUpActive = true
		preSwitchTopUpStartedAt = tick()
	end

	if preSwitchTopUpActive then
		local waitedTooLong = preSwitchTopUpStartedAt and (tick() - preSwitchTopUpStartedAt) >= PRE_SWITCH_TOP_UP_TIMEOUT

		if waitedTooLong and food >= 50 and water >= 50 then
			-- Desiste de esperar 100% (ex: carnívoro sem carcaça disponível
			-- por perto — foi isso que travou o Rex pra sempre no Dino Life)
			-- e troca de slot mesmo assim, já que está num nível seguro.
			runtimeMessage = string.format("Não consegui encher 100%% a tempo (Food %d%%  Water %d%%); trocando mesmo assim", math.floor(food), math.floor(water))
			preSwitchFoodTarget = nil
			preSwitchWaterTarget = nil
			preSwitchTopUpActive = false
			preSwitchTopUpStartedAt = nil
		elseif food < 99 then
			preSwitchFoodTarget = 100
			drinkingToFull = false -- beber não pode interromper o comer agora
			runtimeMessage = string.format("Filling up before slot switch (Food %d%%  Water %d%%)", math.floor(food), math.floor(water))
			return
		elseif water < 99 then
			preSwitchFoodTarget = nil
			preSwitchWaterTarget = 100
			drinkingToFull = true
			runtimeMessage = string.format("Filling up before slot switch (Food %d%%  Water %d%%)", math.floor(food), math.floor(water))
			return
		else
			preSwitchFoodTarget = nil
			preSwitchWaterTarget = nil
			preSwitchTopUpActive = false
			preSwitchTopUpStartedAt = nil
		end
	end

	local completedName = character:GetAttribute("CharacterName")
	local completedAnimal = character:GetAttribute("AnimalName")
	local previousEntry
	for _, candidate in ipairs(savedCharacters()) do
		if candidate.CharacterName == completedName then
			previousEntry = candidate
			break
		end
	end
	if type(completedName) == "string" and completedName ~= "" then
		sessionCompletedSlots[completedName] = true
	end
	growthBusy = true
	preSwitchTopUpActive = false
	preSwitchTopUpStartedAt = nil
	preSwitchFoodTarget = nil
	preSwitchWaterTarget = nil

	-- 1+2+3: para de comer/beber e teleporta pro PrideRockSpawn1 ANTES de
	-- qualquer troca de slot, seja crescendo existentes ou criando novos.
	-- Se não conseguir CONFIRMAR terra firme (sem void, sem água), aborta
	-- essa tentativa e deixa o próximo ciclo do growthStep tentar de novo
	-- — nunca troca de slot estando dentro do void ou da água.
	local landedSafely = teleportBeforeSlotChange()
	if not landedSafely then
		runtimeMessage = "Não confirmei terra firme; adiando troca de slot"
		state.autoEat, state.autoDrink = true, true
		if renders then
			if renders.autoEat then renders.autoEat() end
			if renders.autoDrink then renders.autoDrink() end
		end
		growthBusy = false
		return
	end
	task.wait(0.5)

	local entry
	if state.growExisting or state.growAllSlots then
		local automaticAll = state.growExistingAutomaticAll == true
		local manualAll = state.growAllSlots == true
		local allAnimals = automaticAll or manualAll

		if automaticAll then
			runtimeMessage =
				"AUTO Grow Existing: scanning ALL animal species for slots below 100%"
		elseif manualAll then
			runtimeMessage =
				"Grow All Slots: scanning ALL animal species for slots below 100%"
		else
			runtimeMessage =
				"Abrindo lista de " .. tostring(completedAnimal or "animais")
		end

		if ResetRemote then pcall(ResetRemote.InvokeServer, ResetRemote) end
		task.wait(2.5)

		local refreshed = savedCharacters()

		entry = allAnimals
			and nextExistingSlot(nil, refreshed, true)
			or nextExistingSlot(completedAnimal, refreshed, false)
		if not previousEntry then
			for _, candidate in ipairs(refreshed) do
				if candidate.CharacterName == completedName then
					previousEntry = candidate
					break
				end
			end
		end
	end
	if entry then
		if state.growExistingAutomaticAll then
			questStatusText = string.format(
				"AUTO Grow All: %s · %s%%",
				tostring(entry.AnimalName or "Animal"),
				tostring(entry.GrowthPercentage or "?")
			)
			runtimeMessage =
				"Automatic Grow Existing switched species to continue every saved slot below 100%"

		elseif state.growAllSlots then
			questStatusText = string.format(
				"Grow All Slots: %s · %s%%",
				tostring(entry.AnimalName or "Animal"),
				tostring(entry.GrowthPercentage or "?")
			)
			runtimeMessage =
				"Grow All Slots switched species to continue every saved slot below 100%"
		end

		spawnSlot(entry)

	elseif state.growNew then
		local totalSlots = #savedCharacters()
		if totalSlots >= MAX_SLOTS then
			runtimeMessage = "Limite de " .. MAX_SLOTS .. " slots atingido; ativando Farm Coins"
			state.growExisting, state.growNew = false, false
			state.growExistingAutomaticAll = false
			state.growAllSlots = false
			state.farmCoins = true
			if previousEntry then spawnSlot(previousEntry) end
		else
			runtimeMessage = "Criando novo slot"
			createNextSlot()
		end
	elseif state.growExisting or state.growAllSlots then
		if state.growExistingAutomaticAll then
			runtimeMessage =
				"AUTO Grow Existing complete: ALL animal slots are 100%; activating AFK Coin Farm"
			questStatusText =
				"AUTO Grow All complete -> AFK Coin Farm"
			state.growExistingAutomaticAll = false
			state.questPostGrowAll = false

		elseif state.growAllSlots then
			runtimeMessage =
				"Grow All Slots complete: ALL animal slots are 100%; activating AFK Coin Farm"
			questStatusText =
				"Grow All Slots complete -> AFK Coin Farm"

		elseif state.questPostGrowAll then
			runtimeMessage =
				"Todos os slots existentes estão 100%; ativando Farm Coins"
			state.questPostGrowAll = false

		else
			runtimeMessage =
				"Sem " .. tostring(completedAnimal or "animal")
				.. " incompleto; ativando Farm Coins"
		end

		if previousEntry then
			spawnSlot(previousEntry)
		end

		state.growExisting = false
		state.growAllSlots = false
		state.growNew = false
		state.growExistingAutomaticAll = false
		state.farmCoins = true
	end
	state.autoEat, state.autoDrink = true, true
	if renders then
		for _, key in ipairs({
			"growExisting", "growAllSlots", "growNew",
			"farmCoins", "autoEat", "autoDrink"
		}) do
			if renders[key] then renders[key]() end
		end
	end
	growthBusy = false
end

