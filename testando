renders = {}
local function toggle(parent, label, key, order)
	local row = Instance.new("TextButton")
	row.Size = UDim2.new(1, 0, 0, UserInputService.TouchEnabled and 46 or 40)
	row.LayoutOrder = order or 0
	row.BackgroundColor3 = COLOR_CARD
	row.BorderSizePixel = 0
	row.ClipsDescendants = true
	row.Text = ""
	row.AutoButtonColor = false
	row.Parent = parent
	corner(row, 999) -- Roblox limita automaticamente à metade da altura -> pílula completa nas duas pontas
	local rowStroke = stroke(row, Color3.fromRGB(48, 24, 42), 1)

	local labelText = Instance.new("TextLabel")
	labelText.Size = UDim2.new(1, -58, 1, 0)
	labelText.Position = UDim2.fromOffset(14, 0)
	labelText.BackgroundTransparency = 1
	labelText.Font = FONT_BUTTON
	labelText.Text = label
	labelText.TextSize = 12
	labelText.TextColor3 = COLOR_TEXT
	labelText.TextXAlignment = Enum.TextXAlignment.Left
	labelText.Parent = row

	-- Switch de verdade (trilho + bolinha), em vez de um botão que só muda
	-- de cor — a bolinha desliza e fecha redonda nas duas pontas.
	local track = Instance.new("Frame")
	track.Size = UDim2.fromOffset(38, 20)
	track.AnchorPoint = Vector2.new(1, 0.5)
	track.Position = UDim2.new(1, -14, 0.5, 0)
	track.BackgroundColor3 = Color3.fromRGB(50, 27, 44)
	track.BorderSizePixel = 0
	track.Parent = row
	corner(track, 10)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(16, 16)
	knob.Position = UDim2.fromOffset(2, 2)
	knob.BackgroundColor3 = Color3.fromRGB(220, 224, 230)
	knob.BorderSizePixel = 0
	knob.Parent = track
	corner(knob, 8)

	local hovering = false
	local function applyVisual()
		local on = state[key]
		if on then
			row.BackgroundColor3 = COLOR_CARD_ON
			rowStroke.Color = COLOR_ACCENT
		elseif hovering then
			row.BackgroundColor3 = Color3.fromRGB(38, 20, 34)
			rowStroke.Color = Color3.fromRGB(70, 34, 58)
		else
			row.BackgroundColor3 = COLOR_CARD
			rowStroke.Color = Color3.fromRGB(48, 24, 42)
		end
	end
	local function render()
		local on = state[key]

		if key == "growExisting" then
			labelText.Text =
				on and state.growExistingAutomaticAll
				and "Grow Existing Slots  [AUTO: ALL ANIMALS]"
				or label
			labelText.TextSize =
				on and state.growExistingAutomaticAll
				and 10
				or 12
		end

		labelText.TextColor3 = on and COLOR_ACCENT or COLOR_TEXT
		TweenService:Create(track, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
			BackgroundColor3 = on and COLOR_ACCENT or Color3.fromRGB(50, 27, 44),
		}):Play()
		TweenService:Create(knob, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
			Position = on and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2),
		}):Play()
		applyVisual()
	end
	renders[key] = render
	row.MouseEnter:Connect(function() hovering = true; applyVisual() end)
	row.MouseLeave:Connect(function() hovering = false; applyVisual() end)
	row.Activated:Connect(function()
		state[key] = not state[key]

		-- User interaction always means a MANUAL Growth mode.
		if key == "growExisting" then
			state.growExistingAutomaticAll = false
			if state[key] then
				state.growAllSlots = false
			end

		elseif key == "growAllSlots" and state[key] then
			state.growExistingAutomaticAll = false
			state.growExisting = false
			state.growNew = false
			questStatusText = "Grow All Slots: ALL animal species"
			runtimeMessage =
				"Grow All Slots active: growing every existing slot below 100% across all animals"

		elseif key == "growNew" and state[key] then
			state.growAllSlots = false
		end

		if key == "farmCoins" and state[key] then
			state.questPostGrowAll = false
			state.growExistingAutomaticAll = false
			state.growAllSlots = false
			state.growExisting, state.growNew, state.autoQuests = false, false, false
			state.autoEat, state.autoDrink = true, true
			runtimeMessage = state.coinFarmPreferredAnimal
				and (
					"AFK Coin Farm active; preferred animal queued: "
					.. state.coinFarmPreferredAnimal
				)
				or "AFK Coin Farm active; current animal will be kept"
		elseif (
			key == "growExisting"
			or key == "growAllSlots"
			or key == "growNew"
		) and state[key] then
			state.questPostGrowAll = false
			state.growExistingAutomaticAll = false
			state.farmCoins, state.autoQuests = false, false
		elseif key == "autoQuests" and state[key] then
			state.questPostGrowAll = false
			state.growExistingAutomaticAll = false
			state.growAllSlots = false
			state.questSeenAny = false
			state.questEmptyScans = 0
			state.questGroup.difficultySince = nil
			state.farmCoins, state.growExisting, state.growNew = false, false, false
			state.autoEat, state.autoDrink = true, true
			questStatusText = "Scanning Daily + Weekly quests"
			runtimeMessage = "Auto Quests active"
		elseif key == "autoQuests" and not state[key] then
			state.questClearReturnZone()
			questTravelWanted = false
			state.questTravelActive = false
			state.questLandInputActive = false
			state.questSetW(false)
			state.questLandWWatchReset()
			state.questSwimActive = false
			state.questSwimReady = false
			questTargetZoneName = nil
			questStatusText = "Ready"
		elseif key == "autoClaimQuests" then
			questStatusText = state[key] and "Auto Claim active" or "Ready"
		end
		for _, changedKey in ipairs({
			key, "farmCoins", "growExisting", "growAllSlots", "growNew",
			"autoQuests", "autoClaimQuests", "autoEat", "autoDrink"
		}) do
			if renders[changedKey] then renders[changedKey]() end
		end
	end)
	render()
	return row
end

