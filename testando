		end

		if mode == "underground"
			and state.isCrocOrHippoMovementCharacter(player.Character) then
			-- Current aquatic animal cannot use Underground, but do not erase a
			-- previously saved Underground preference for future normal animals.
			state.autoDrinkMode = "surface"
			runtimeMessage = "Underground Drink is unavailable for Crocodile/Hippo"
			state.renderAutoDrinkModeButtons()
			return
		end

		local overrideActive =
			state.questZoneDrinkOverride
				and state.questZoneDrinkOverride.active

		-- Always remember what the PLAYER wants.
		state.autoDrinkPreferredMode = mode
		state.drinkTest.retryAfter = 0
		state.drinkTest.forceSurfaceUntil = 0

		if overrideActive then
			state.autoDrinkMode = "underground"

			if mode == "surface" then
				runtimeMessage =
					"Surface Water preference saved; Survive in Zone still forces Underground Drink"
			else
				runtimeMessage =
					"Underground Drink preference saved"
			end

			state.renderAutoDrinkModeButtons()
			return
		end

		if state.autoDrinkMode == mode then
			state.renderAutoDrinkModeButtons()
			return
		end

		state.autoDrinkMode = mode

		-- v4.1 MODE-SWITCH TRANSACTION:
		-- Surface search, water approach and an active Drinking sub-state all belong
		-- to the OLD backend.  Cancel them before the new backend can acquire Water.
		-- If Underground is currently active, only request its controlled surface
		-- exit; never clear its safety state while the character is still buried.
		if state.safeMove
			and state.safeMove.active
			and (
				state.safeMove.reason == "water"
				or state.safeMove.reason == "water_search"
			) then
			state.safeMove.cancelToken += 1
			state.safeMove.active = false
			state.safeMove.target = nil
			state.safeMove.reason = nil
			state.safeMove.manualLabel = nil
			state.busy = false
		end

		if state.drinkSearch then
			state.drinkSearch.surfaceTransitActive = false
			state.drinkSearch.surfaceTransitFoundSpot = nil
			state.drinkSearch.currentWaterPoint = nil
			state.drinkSearch.failedCount = 0
			state.drinkSearch.retryAfter = 0
		end

		if mode == "surface" then
			if state.drinkTest.active then
				state.drinkTest.cancelRequested = true
				runtimeMessage =
					"Surface Water selected; controlled Underground exit in progress"
			else
				if (drinkingToFull or drinkingSourcePosition) and state.forceStopActiveDrink then
					pcall(state.forceStopActiveDrink, player.Character, "Auto Drink backend changed to Surface")
				end
				state.drinkClearUndergroundMode()
				state.drinkProgressReset()
				runtimeMessage =
					"Auto Drink mode: puddles and rivers"
			end
		else
			if not state.drinkTest.active
				and (drinkingToFull or drinkingSourcePosition)
				and state.forceStopActiveDrink then
				pcall(state.forceStopActiveDrink, player.Character, "Auto Drink backend changed to Underground")
			end
			state.drinkProgressReset()
			state.drinkClearUndergroundMode()
			runtimeMessage =
				"Auto Drink mode: below Terrain"
		end

		if state.survivalArbiter and state.survivalArbiter.owner == "water" then
			state.survivalArbiterComplete("water")
		end
		state.questForceFastRecheckUntil = tick() + 8

		state.renderAutoDrinkModeButtons()
	end)

	return button
end

