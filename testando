state.carcassController =
	state.carcassController
	or {
		token = 0,
		cancelRequested = false,
	}

function state.requestSafeMoveCancellation(reason)
	local safeMove = state.safeMove
	if not safeMove or not safeMove.active then return false end

	local manager = state.MMBAI and state.MMBAI.MovementManager
	if manager and type(manager.CancelOwner) == "function" then
		local owner = manager:OwnerForPurpose(safeMove.reason)
		manager:CancelOwner(owner, reason or "legacy controller handoff")
		return true
	end

	safeMove.cancelToken += 1
	return false
end

function state.requestAllMovementCancellation(reason, exemptOwner)
	local manager = state.MMBAI and state.MMBAI.MovementManager
	if not manager or type(manager.CancelOwner) ~= "function" then
		return state.requestSafeMoveCancellation(reason)
	end

	local requested = false
	local seen = {}

	local function requestOwner(owner)
		if owner and owner ~= exemptOwner and not seen[owner] then
			seen[owner] = true
			manager:CancelOwner(owner, reason or "exclusive movement handoff")
			requested = true
		end
	end

	if type(manager.ActualOwners) == "function" then
		local ok, owners = pcall(manager.ActualOwners, manager, state.MMBAI.Blackboard)
		if ok and type(owners) == "table" then
			for _, entry in ipairs(owners) do
				requestOwner(entry.owner)
			end
		end
	end

	if manager.lease then requestOwner(manager.lease.owner) end
	if state.safeMove and state.safeMove.active then
		requestOwner(manager:OwnerForPurpose(state.safeMove.reason))
	end

	return requested
end

function state.hasCompetingMovementOwner(exemptOwner)
	local manager = state.MMBAI and state.MMBAI.MovementManager
	if manager and type(manager.ActualOwners) == "function" then
		local ok, owners = pcall(manager.ActualOwners, manager, state.MMBAI.Blackboard)
		if ok and type(owners) == "table" then
			for _, entry in ipairs(owners) do
				if entry.owner and entry.owner ~= exemptOwner then
					return true
				end
			end
		end
		if manager.lease and manager.lease.owner ~= exemptOwner then
			return true
		end
	end

	if state.safeMove and state.safeMove.active then
		if not manager then return true end
		return manager:OwnerForPurpose(state.safeMove.reason) ~= exemptOwner
	end

	return false
end

