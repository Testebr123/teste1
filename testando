local function baboonApproachFood(targetPart, distance)
	local character, root = characterParts()
	if not character or not root or not targetPart or not targetPart.Parent then
		return false
	end

	local flat = Vector3.new(
		root.Position.X - targetPart.Position.X,
		0,
		root.Position.Z - targetPart.Position.Z
	)

	if flat.Magnitude < 0.5 then
		flat = Vector3.new(
			-root.CFrame.LookVector.X,
			0,
			-root.CFrame.LookVector.Z
		)
	end

	if flat.Magnitude < 0.1 then
		flat = Vector3.new(1, 0, 0)
	else
		flat = flat.Unit
	end

	local desired = targetPart.Position + flat * (distance or 4)

	-- Always land on real Terrain next to the AntHill. The old code preserved
	-- the AntHill mesh Y, which could put the Baboon on top of/inside the model.
	local castY = math.max(
		targetPart.Position.Y + 120,
		root.Position.Y + 120,
		250
	)

	local hit = workspace:Raycast(
		Vector3.new(desired.X, castY, desired.Z),
		Vector3.new(0, -500, 0),
		terrainOnlyRayParams
	)

	if not hit or hit.Material == Enum.Material.Water then
		return false
	end

	return ragdollTeleport(
		hit.Position,
		1,
		targetPart.Position
	)
end

local function baboonEatLockedTarget(selected)
	if BABOON.busy
		or state.questGrowthReset.exclusive
		or type(selected) ~= "table"
		or not selected.object
		or not selected.part then
		return
	end

	local myToken = BABOON.cancelToken
	BABOON.busy = true
	BABOON.targetKind = selected.kind
	BABOON.targetObject = selected.object
	BABOON.targetPart = selected.part
	BABOON.targetStartedAt = tick()

	local function cancelled()
		local liveCharacter = player.Character
		local liveWater = liveCharacter
			and (liveCharacter:GetAttribute("Water") or 100)
			or 100

		return myToken ~= BABOON.cancelToken
			or state.questGrowthReset.exclusive
			or not state.autoEat
			or drinkingToFull
			or liveWater <= 75
			or criticalRecoveryActive
	end

	local character, root = characterParts()
	if not character or not root or cancelled() then
		BABOON.busy = false
		BABOON.clearTarget()
		return
	end

	-- ========================================================
	-- CARCASS
	-- ========================================================
	if selected.kind == "Carcass" then
		runtimeMessage = string.format(
			"Baboon: locked nearest food -> carcass (%.0f studs)",
			selected.distance or 0
		)

		-- Keep the Baboon lock around the existing, battle-tested carcass
		-- routine. It cannot switch to an AntHill mid-attempt.
		eatCarcass(selected.object, selected.part)

		local liveCharacter = player.Character
		local foodAfter = liveCharacter and (liveCharacter:GetAttribute("Food") or 0) or 0
		local targetFood = (
			state.autoQuests
			and state.questBaboonFeeding
			and not preSwitchFoodTarget
		) and 100 or (preSwitchFoodTarget or 92)

		if foodAfter >= targetFood then
			BABOON.clearTarget()
		elseif not selected.object.Parent or carcassIsIgnored(selected.object) then
			BABOON.clearTarget()
		else
			-- If carcass routine returned without finishing but did not mark it
			-- bad, keep the SAME source locked for the next pass.
			BABOON.targetObject = selected.object
			BABOON.targetPart = selected.part
			BABOON.targetKind = "Carcass"
		end

		BABOON.busy = false
		return
	end

	-- ========================================================
	-- ANT HILL
	-- ========================================================
	if selected.kind ~= "AntHill"
		or not selected.object.Parent
		or not selected.part.Parent then

		BABOON.busy = false
		BABOON.clearTarget()
		return
	end

	runtimeMessage = string.format(
		"Baboon: locked nearest food -> AntHill (%.0f studs)",
		selected.distance or 0
	)

	-- ONE positioning action only.
	-- If already close, do not teleport at all.
	if (root.Position - selected.part.Position).Magnitude > 9 then
		local approached = baboonApproachFood(selected.part, 4)

		if not approached then
			baboonIgnoreAntHill(selected.object, 60)
			BABOON.busy = false
			BABOON.clearTarget()
			runtimeMessage = "Baboon: could not find safe ground beside AntHill"
			return
		end

		task.wait(0.35)
	end

	character, root = characterParts()
	if not character or not root or cancelled() then
		BABOON.busy = false
		BABOON.clearTarget()
		return
	end

	-- IMPORTANT:
	-- AntHill is a special Baboon food source. The generic
	-- DetectMeatGrassWater helper is not authoritative for it, so do not reject
	-- a valid AntHill just because that helper does not return "Eat".
	--
	-- Start the interaction exactly ONCE. The order matches normal player use:
	-- press E once, then reinforce the Eating substate once.
	local startFood = character:GetAttribute("Food") or 0
	local lastFood = startFood
	local lastProgressAt = tick()
	local foodEverRose = false

	BABOON.lastFood = startFood
	BABOON.lastProgressAt = lastProgressAt

	baboonTapEatKey()
	task.wait(0.08)

	if cancelled() then
		BABOON.busy = false
		BABOON.clearTarget()
		return
	end

	setSubState("Eating")

	runtimeMessage = string.format(
		"Baboon eating AntHill - Food %d%%",
		math.floor(startFood)
	)

	-- From this point onward there are NO more E presses and NO teleports.
	-- We only observe Food and the safety state.
	while state.alive do
		if cancelled() then break end
		if not selected.object.Parent or not selected.part.Parent then break end

		character, root = characterParts()
		if not character or not root then break end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then break end

		if humanoid:GetState() == Enum.HumanoidStateType.Swimming
			or isPositionUnderwater(root.Position) then

			baboonIgnoreAntHill(selected.object, 120)
			runtimeMessage = "Baboon: AntHill became unsafe near water; target blacklisted"
			break
		end

		local currentFood = character:GetAttribute("Food") or 0
		local targetFood = (
			state.autoQuests
			and state.questBaboonFeeding
			and not preSwitchFoodTarget
		) and 100 or (preSwitchFoodTarget or 92)

		if currentFood >= targetFood then
			break
		end

		if currentFood > lastFood + 0.01 then
			lastFood = currentFood
			lastProgressAt = tick()
			foodEverRose = true
			BABOON.lastFood = currentFood
			BABOON.lastProgressAt = lastProgressAt

			runtimeMessage = string.format(
				"Baboon eating AntHill - Food %d%%",
				math.floor(currentFood)
			)
		end

		-- If the Baboon gets displaced away from the AntHill, do NOT teleport
		-- it back on top. End this attempt cleanly and reacquire later.
		if (root.Position - selected.part.Position).Magnitude > 13 then
			runtimeMessage = "Baboon moved away from AntHill; ending feed attempt without teleporting"
			break
		end

		-- One E press should start the entire feeding session. If Food never
		-- moves, this AntHill is simply not usable from this position.
		if tick() - lastProgressAt >= 7 then
			baboonIgnoreAntHill(selected.object, 90)
			runtimeMessage = foodEverRose
				and "Baboon: AntHill stopped giving Food for 7s; switching source"
				or "Baboon: AntHill gave no Food after one Eat press; switching source"
			break
		end

		task.wait(0.20)
	end

	character, root = characterParts()

	local foodAfter = character
		and (character:GetAttribute("Food") or 0)
		or 0

	local targetFood = (
		state.autoQuests
		and state.questBaboonFeeding
		and not preSwitchFoodTarget
	) and 100 or (preSwitchFoodTarget or 92)

	if foodAfter >= targetFood then
		runtimeMessage = "Baboon finished feeding from AntHill"
		BABOON.clearTarget()

	elseif not selected.object.Parent
		or baboonAntHillIsIgnored(selected.object)
		or not foodEverRose then

		if not foodEverRose and selected.object.Parent then
			baboonIgnoreAntHill(selected.object, 90)
		end

		BABOON.clearTarget()

	else
		-- It was a valid source and Food increased. Keep the same AntHill locked
		-- if the attempt ended for an external reason; do not compare distances
		-- again and do not teleport while already eating.
		BABOON.targetKind = "AntHill"
		BABOON.targetObject = selected.object
		BABOON.targetPart = selected.part
	end

	BABOON.busy = false

	if not state.questGrowthReset.exclusive
		and not drinkingToFull then
		blockClientSubState = false
	end
end


local function virtualEatKick()
	if state.questGrowthReset.exclusive then return end
	local character, root = characterParts()
	if not character or not root then return end

	local animal = character:GetAttribute("AnimalName") or ""

	if isGiraffeCharacter(character) then
		if GIRAFFE.busy then return end

		local selected = nearestGiraffeTree(root)
		if selected then
			runtimeMessage = "Giraffe: Eat stalled; retrying locked tree leaves"
			task.spawn(giraffeEatLockedTree, selected)
		else
			runtimeMessage = "Giraffe: no non-depleted tree leaves found"
		end

		eatingStuckSince = nil
		return
	end

	if isBaboonCharacter(character) then
		-- Water has absolute priority for Baboon.
		if (character:GetAttribute("Water") or 100) <= 75 then
			state.questBaboonFeeding = false
			eatingToFull = false
			BABOON.cancel()
			eatingStuckSince = nil
			return
		end

		-- The dedicated Baboon routine owns AntHill interaction. Never use the
		-- generic watchdog to spam E or reposition while that routine is active.
		if BABOON.busy then
			eatingStuckSince = nil
			return
		end

		local selected = chooseBaboonFood(root)
		if selected then
			runtimeMessage = "Baboon: feed attempt ended; reacquiring locked food source"
			task.spawn(baboonEatLockedTarget, selected)
		else
			runtimeMessage = "Baboon: no carcass or AntHill available"
		end

		eatingStuckSince = nil
		return
	end

	if isCarnivoreCharacter(character) then
		runtimeMessage = "Comer sumiu (carnivoro); refazendo teleporte na carcaça"
		activeCarcass = nil -- força procurar carcaça de novo, pode ter sido consumida/sumido
		local carcass, carcassRoot = nearestCarcass(root)
		if carcass and carcassRoot and not carcassEatBusy then
			task.spawn(eatCarcass, carcass, carcassRoot)
		elseif not carcass then
			runtimeMessage = "Comer sumiu (carnivoro); nenhuma carcaça encontrada por perto"
		end

		eatingStuckSince = nil
		return
	end

	runtimeMessage = "Comer sumiu; forcando na grama com tecla E"

	local grass = findNearestGrass(root.Position) or findDistantGrass(root.Position)
	if grass then moveToGrass(grass) end
	task.wait(0.2)

	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
		task.wait(0.05)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
	end)
	task.wait(0.2)

	state.autoEat = false
	if renders and renders.autoEat then renders.autoEat() end
	task.wait(0.3)
	state.autoEat = true
	if renders and renders.autoEat then renders.autoEat() end

	setSubState("Eating")
	eatingStuckSince = nil
end

local function autoEatStep()
	if state.questGrowthReset.exclusive then return end
	if state.questSwimActive then return end
	if not state.autoEat or state.busy or drinkingToFull or criticalRecoveryActive then return end
	local character, root = characterParts()
	if not character or not root then return end
	if carcassEatBusy or BABOON.busy or GIRAFFE.busy then return end

	local food = character:GetAttribute("Food") or 100
	local water = character:GetAttribute("Water") or 100
	local giraffe = isGiraffeCharacter(character)
	local baboon = not giraffe and isBaboonCharacter(character)
	local carnivore = not giraffe and not baboon and isCarnivoreCharacter(character)
	local questCarnivore = state.autoQuests and carnivore and not preSwitchFoodTarget
	local questBaboon = state.autoQuests and baboon and not preSwitchFoodTarget
	local questGiraffe = state.autoQuests and giraffe and not preSwitchFoodTarget

	-- Baboon never competes with Auto Drink. If Water needs service, drop all
	-- Baboon food ownership immediately and let autoDrinkStep take over.
	if baboon and water <= 75 then
		state.questBaboonFeeding = false
		eatingToFull = false
		BABOON.cancel()
		eatingStuckSince = nil
		lastEatWatchdogFood = food
		return
	end

	-- Giraffe eats ONLY tree Leaves from workspace.MapAssets.MainAssets.
	-- During Auto Quests it pauses the route at <=70% and feeds to 100%.
	if questGiraffe then
		if not state.questGiraffeFeeding and food <= 70 then
			state.questRememberZoneBeforeFeeding("Giraffe feeding")
			state.questGiraffeFeeding = true
			eatingToFull = true
			runtimeMessage = "Giraffe: Food <= 70%; pausing quests to eat tree leaves"
		end

		if state.questGiraffeFeeding then
			if food >= 100 then
				state.questGiraffeFeeding = false
				eatingToFull = false
				resetEatingSearch(food)
				GIRAFFE.cancel()
				eatingStuckSince = nil
				runtimeMessage = "Giraffe full; returning to quests"
				return
			end
		else
			return
		end
	elseif state.questGiraffeFeeding then
		state.questGiraffeFeeding = false
		GIRAFFE.cancel()
	end

	-- Baboon is an omnivore with an EXCLUSIVE dual-food controller:
	-- nearest Carcass OR workspace.MapAssets.AntHills. Once selected, that
	-- source remains locked until it feeds successfully or is proven bad.
	if questBaboon then
		if not state.questBaboonFeeding and food <= 70 then
			state.questRememberZoneBeforeFeeding("Baboon feeding")
			state.questBaboonFeeding = true
			eatingToFull = true
			runtimeMessage = "Baboon: Food <= 70%; pausing quests to feed"
		end

		if state.questBaboonFeeding then
			if food >= 100 then
				state.questBaboonFeeding = false
				eatingToFull = false
				resetEatingSearch(food)
				BABOON.cancel()
				eatingStuckSince = nil
				runtimeMessage = "Baboon full; returning to quests"
				return
			end
		else
			-- Above 70%, do not abandon Auto Run/Zone just to feed.
			return
		end
	elseif state.questBaboonFeeding then
		state.questBaboonFeeding = false
		BABOON.cancel()
	end

	-- Carnívoro durante Auto Quests:
	-- só interrompe as quests quando Food chegar a 70% ou menos.
	-- Depois que começa, continua procurando/comendo carcaça até 100%.
	if questCarnivore then
		if not state.questCarnivoreFeeding and food <= 70 then
			state.questRememberZoneBeforeFeeding("Carnivore feeding")
			state.questCarnivoreFeeding = true
			eatingToFull = true
			runtimeMessage = "Carnivore: Food <= 70%; pausing quests to eat"
		end

		if state.questCarnivoreFeeding then
			if food >= 100 then
				state.questCarnivoreFeeding = false
				eatingToFull = false
				resetEatingSearch(food)
				activeCarcass = nil
				eatingStuckSince = nil
				runtimeMessage = "Carnivore full; returning to quests"
				return
			end
		else
			-- Acima de 70% o carnívoro não abandona Auto Run/Zone para caçar.
			return
		end
	elseif state.questCarnivoreFeeding then
		state.questCarnivoreFeeding = false
	end

	local foodCap = (questCarnivore or questBaboon or questGiraffe)
		and 100
		or (preSwitchFoodTarget or 92)
	if food >= foodCap then
		eatingToFull = false
		resetEatingSearch(food)
		activeCarcass = nil
		eatingStuckSince = nil
		return
	end

	local availableFood = detectAvailableFood(character)

	-- Herbívoro durante Auto Quests:
	-- o modo especial "Eat enquanto corre" só existe se ainda houver uma
	-- Travel/Land Distance incompleta. Sem missão de corrida, volta ao Auto Eat
	-- padrão: procura a grama e vai até ela normalmente.
	if state.autoQuests and state.questTravelActive
		and not preSwitchFoodTarget
		and not carnivore
		and not baboon
		and not giraffe then
		if availableFood == "Eat" then
			eatingToFull = false
			eatingSourcePosition = nil
			eatingTargetReachedAt = nil
			eatingStuckSince = nil
			runtimeMessage = "Eating while running"

			if tick() - (state.questLastEatTapAt or 0) >= 0.8 then
				state.questLastEatTapAt = tick()
				pcall(function()
					VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
					task.wait(0.04)
					VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
				end)
				setSubState("Eating")
			end
			return
		end

		if not eatingToFull and food > 68 then
			return
		end
	end

	if not eatingToFull then
		state.questRememberZoneBeforeFeeding("feeding")
	end
	eatingToFull = true

	if lastEatWatchdogFood == nil or food > lastEatWatchdogFood then
		lastEatWatchdogFood = food
		eatingStuckSince = tick()
	elseif not eatingStuckSince then
		eatingStuckSince = tick()
	end
	if eatingStuckSince and tick() - eatingStuckSince >= 15 then
		lastEatWatchdogFood = food
		eatingStuckSince = tick()
		virtualEatKick()
		return
	end

	if giraffe then
		if GIRAFFE.busy then return end

		local selected = nearestGiraffeTree(root)
		if selected then
			runtimeMessage = string.format(
				"Giraffe: using %s tree leaves (%.0f studs)",
				selected.locked and "locked" or "nearest available",
				selected.distance or 0
			)
			task.spawn(giraffeEatLockedTree, selected)
		else
			runtimeMessage = "Giraffe: no tree with visible Leaves meshes found"
		end
		return
	end

	if baboon then
		if BABOON.busy then return end

		local selected = chooseBaboonFood(root)
		if selected then
			runtimeMessage = string.format(
				"Baboon: nearest food is %s (%.0f studs); target locked",
				selected.kind,
				selected.distance or 0
			)
			task.spawn(baboonEatLockedTarget, selected)
		else
			runtimeMessage = "Baboon: no carcass or AntHill currently available"
		end
		return
	end

	if carnivore then
		if carcassEatBusy then return end

		local carcass = activeCarcass
		local carcassRoot = carcass and (
			carcass:FindFirstChild("HumanoidRootPart")
			or carcass:FindFirstChildWhichIsA("BasePart", true)
		)

		if not carcassRoot then
			carcass, carcassRoot = nearestCarcass(root)
		end

		if carcass and carcassRoot then
			runtimeMessage = questCarnivore
				and string.format("Carnivore feeding to 100%% (Food %d%%)", math.floor(food))
				or "Indo comer carcaça"
			task.spawn(eatCarcass, carcass, carcassRoot)
		else
			runtimeMessage = questCarnivore
				and string.format("Carnivore feeding: searching carcass (Food %d%%)", math.floor(food))
				or "Carnivoro sem carcaça por perto"

			if isSavannahLife then
				exploreSavannahCarcassSpawns()
			elseif tick() >= nextCarnivoreExploreCheck then
				nextCarnivoreExploreCheck = tick() + 20
				local spot = findSafeTerrainSpot(root.Position, 20, 60)
				if spot then
					runtimeMessage = "Procurando carcaça em outra area (terreno seguro)"
					ragdollTeleport(spot)
				end
			end
		end
		return
	end

	if food <= 55 and tick() >= nextEmergencyGrassCheck then
		nextEmergencyGrassCheck = tick() + 120
		local distantGrass = findDistantGrass(root.Position)
		if distantGrass then
			runtimeMessage = "Fome critica; teleportando para outra area com grama"
			resetEatingSearch(food)
			ragdollTeleport(distantGrass)
			task.wait(0.4)
			return
		else
			runtimeMessage = "Fome critica; nenhuma area distante encontrada"
		end
	end

	if availableFood == "Eat" then
		eatingSourcePosition = root.Position
		eatingTargetReachedAt = tick()
		runtimeMessage = "Comendo a grama proxima"
		setSubState("Eating")
		return
	end

	if eatingSourcePosition and eatingTargetReachedAt
		and (root.Position - eatingSourcePosition).Magnitude <= 10
		and tick() - eatingTargetReachedAt < 5 then
		runtimeMessage = "Tentando comer na grama atual"
		setSubState("Eating")
		return
	end

	local grass = findNearestGrass(root.Position)
	if not grass then
		runtimeMessage = "Nenhuma grama detectada por perto"
		return
	end

	runtimeMessage = "Indo para uma grama proxima"
	moveToGrass(grass)
	task.wait(0.2)
	eatingSourcePosition = grass
	eatingTargetReachedAt = tick()

	local detectedAfterMove = detectAvailableFood(character)
	if detectedAfterMove == "Eat" or not GameUtils or not AnimalConfig then
		setSubState("Eating")
	end
end

local function isPositionInWaterTerrain(position, radiusXZ, radiusY)
	radiusXZ = radiusXZ or 5
	radiusY = radiusY or 7

	local ok, materials, occupancies = pcall(function()
		local half = Vector3.new(radiusXZ, radiusY, radiusXZ)
		local region = Region3.new(position - half, position + half):ExpandToGrid(4)
		return workspace.Terrain:ReadVoxels(region, 4)
	end)
	if not ok or type(materials) ~= "table" then return false end

	-- ReadVoxels returns a 3D matrix. The old check only inspected [1][1][1],
	-- so it could report false even with the animal visibly inside water.
	for x = 1, #materials do
		local ys = materials[x]
		if type(ys) == "table" then
			for y = 1, #ys do
				local zs = ys[y]
				if type(zs) == "table" then
					for z = 1, #zs do
						if zs[z] == Enum.Material.Water then
							local occupancy = occupancies
								and occupancies[x]
								and occupancies[x][y]
								and occupancies[x][y][z]
							if occupancy == nil or occupancy > 0.05 then
								return true
							end
						end
					end
				end
			end
		end
	end

	return false
end

local function isStandingInWater(root)
	if not root then return false end

	local _, _, humanoid = characterParts()
	if humanoid and humanoid:GetState() == Enum.HumanoidStateType.Swimming then
		return true
	end

	if isPositionInWaterTerrain(root.Position, 6, 9) then
		return true
	end

	-- Probe several points around the body instead of one tiny 3-stud ray.
	local offsets = {
		Vector3.new(0, 5, 0),
		Vector3.new(0, 2, 0),
		Vector3.new(3, 3, 0),
		Vector3.new(-3, 3, 0),
		Vector3.new(0, 3, 3),
		Vector3.new(0, 3, -3),
	}
	for _, offset in ipairs(offsets) do
		local hit = workspace:Raycast(
			root.Position + offset,
			Vector3.new(0, -14, 0),
			terrainParams
		)
		if hit and hit.Material == Enum.Material.Water then
			return true
		end
	end

	return false
end

local function isValidSwimQuestWater(root)
	if not root then return false end

	if isStandingInWater(root) then
		return true
	end

	-- Wider scan used only for the known Swim farm location. Large animals can
	-- have their HRP above/below the water voxel even while the body is swimming.
	if isPositionInWaterTerrain(root.Position, 12, 16) then
		return true
	end

	-- The supplied farm point is known to be inside the swim area. If we are
	-- very close to it, force Swimming once and accept the area after physics
	-- has had a moment to update instead of teleporting forever.
	local target = state.questSwimPosition
	if target and (root.Position - target).Magnitude <= 28 then
		local _, _, humanoid = characterParts()
		if humanoid then
			pcall(humanoid.ChangeState, humanoid, Enum.HumanoidStateType.Swimming)
		end
		setSubState("Swimming")
		return true
	end

	return false
end


function state.drinkIsUpsideDown(root)
	if not root then return false end
	return root.CFrame.UpVector.Y < 0.35
end

function state.drinkUprightCharacter(character, root, faceTowards)
	if not character or not root or not root.Parent then return false end

	local forward
	if faceTowards then
		local flatTarget = Vector3.new(
			faceTowards.X - root.Position.X,
			0,
			faceTowards.Z - root.Position.Z
		)
		if flatTarget.Magnitude > 0.5 then
			forward = flatTarget.Unit
		end
	end

	if not forward then
		local look = root.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		if flatLook.Magnitude > 0.25 then
			forward = flatLook.Unit
		else
			local right = root.CFrame.RightVector
			local flatRight = Vector3.new(right.X, 0, right.Z)
			forward = flatRight.Magnitude > 0.25
				and flatRight.Unit
				or Vector3.new(0, 0, -1)
		end
	end

	local ok = pcall(function()
		character:PivotTo(
			CFrame.lookAt(
				root.Position,
				root.Position + forward,
				Vector3.yAxis
			)
		)

		root.AssemblyAngularVelocity = Vector3.zero
		local velocity = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(
			velocity.X * 0.25,
			math.clamp(velocity.Y, -1.5, 2),
			velocity.Z * 0.25
		)
		character:SetAttribute("MovementDisabled", false)
	end)

	if ok then
		state.drinkSearch.upsideDownSince = nil
		state.drinkSearch.lastUprightAt = tick()
	end

	return ok
end

function state.drinkPostureWatch(character, root, humanoid)
	if not drinkingToFull
		or state.questSwimActive
		or not character
		or not root
		or not humanoid then

		state.drinkSearch.upsideDownSince = nil
		state.drinkSearch.waterHealth = nil
		return false
	end

	local now = tick()
	local inWater = isStandingInWater(root)
		or state.drinkSearch.undergroundMode
	local upsideDown = state.drinkIsUpsideDown(root)

	if upsideDown then
		if not state.drinkSearch.upsideDownSince then
			state.drinkSearch.upsideDownSince = now
		end

		local invertedFor = now - state.drinkSearch.upsideDownSince

		-- Pequeno flip durante o ragdoll é normal. Preso invertido não é.
		if invertedFor >= 0.65
			and now - (state.drinkSearch.lastUprightAt or 0) >= 0.75 then

			state.drinkUprightCharacter(
				character,
				root,
				state.drinkSearch.currentWaterPoint
			)
			runtimeMessage = "Agua: animal virou; corrigindo postura"
		end

		local maxInverted = state.drinkSearch.undergroundMode and 1.5 or 2.5
		if inWater and invertedFor >= maxInverted then
			state.drinkEmergencyEscape(
				character,
				root,
				"Watchdog agua: animal preso de ponta-cabeca; saindo da fonte"
			)
			return true
		end
	else
		state.drinkSearch.upsideDownSince = nil
	end

	-- Dano enquanto parado na água para beber é tratado como risco de afogamento.
	if inWater then
		local health = humanoid.Health
		local maxHealth = math.max(humanoid.MaxHealth, 1)

		if state.drinkSearch.waterHealth == nil then
			state.drinkSearch.waterHealth = health
			state.drinkSearch.waterHealthAt = now
		elseif health > state.drinkSearch.waterHealth then
			state.drinkSearch.waterHealth = health
			state.drinkSearch.waterHealthAt = now
		else
			local lost = state.drinkSearch.waterHealth - health
			local elapsed = now - (state.drinkSearch.waterHealthAt or now)

			local damageLimit = state.drinkSearch.undergroundMode and 0.03 or 0.05
			if elapsed <= 5 and lost >= maxHealth * damageLimit then
				state.drinkEmergencyEscape(
					character,
					root,
					"Watchdog agua: tomando dano enquanto bebia; abortando antes de afogar"
				)
				return true
			elseif elapsed > 5 then
				state.drinkSearch.waterHealth = health
				state.drinkSearch.waterHealthAt = now
			end
		end
	else
		state.drinkSearch.waterHealth = nil
		state.drinkSearch.waterHealthAt = 0
	end

	return false
end

local forcingPostDrinkTeleport = false

local function ensureOnSolidGround(targetPosition, label)
	label = label or "solo seguro"
	criticalRecoveryActive = true

	-- Desliga comer/beber durante TODA a tentativa de sair do void/água —
	-- essas rotinas ficam mexendo na posição e brigam com o teleporte,
	-- fazendo o personagem cair de novo.
	state.autoEat, state.autoDrink = false, false
	if renders then
		if renders.autoEat then renders.autoEat() end
		if renders.autoDrink then renders.autoDrink() end
	end

	local totalAttempts = 14
	for attempt = 1, totalAttempts do
		ragdollTeleport(targetPosition, 8)
		task.wait(0.3)

		local character, root = characterParts()
		if character and root then
			local inVoid = root.Position.Y < config.dangerY
			local inWater = isStandingInWater(root)
			local buried = not isDinoLife
				and state.drinkIsBuriedUnderTerrain(root)

			if not inVoid and not inWater and not buried then
				runtimeMessage = "Confirmado ACIMA do Terrain em " .. label

				-- forcePostDrinkTeleport still owns the character. Do not release
				-- other automation between candidate checks.
				if not forcingPostDrinkTeleport then
					criticalRecoveryActive = false
				end
				return true
			end

			runtimeMessage = string.format(
				"Ainda preso (void:%s agua:%s terrain:%s); tentativa %d/%d",
				tostring(inVoid),
				tostring(inWater),
				tostring(buried),
				attempt,
				totalAttempts
			)
		end
		task.wait(0.2)
	end

	runtimeMessage = "Não consegui confirmar saída do void/água/Terrain após várias tentativas"
	if not forcingPostDrinkTeleport then
		criticalRecoveryActive = false
	end
	return false
end

-- No Dino Life os AquaticNestRock1/2 ficam na água e são só uma PASSAGEM
-- pra sair do void — não são o destino final. Fluxo correto: 1) teleporta
-- pro Aquatic mais próximo e CONFIRMA que saiu do void, 2) só então
-- teleporta pro NestRock1 (destino final, em terra firme de verdade).
local function escapeDinoToSafety(label)
	label = label or "solo seguro"

	-- REGRA ABSOLUTA: o AquaticNestRock é EXCLUSIVO do watchdog de void.
	-- Se o personagem não estiver abaixo do dangerY, essa função não faz nada.
	local _, root = characterParts()
	if not root or root.Position.Y >= config.dangerY then
		return false
	end

	runtimeMessage = "VOID detectado; usando rota AquaticNestRock"

	local aquatic = findAquaticNestRock()
	if aquatic then
		ensureOnSolidGround(aquatic.Position, "AquaticNestRock (saindo do void)")
	end

	local nestRock1 = findNestRock1()
	if nestRock1 then
		return ensureOnSolidGround(nestRock1.Position, "NestRock1")
	end

	if not aquatic then
		runtimeMessage = "Void: nem AquaticNestRock nem NestRock1 encontrados"
	end
	return aquatic ~= nil
end


function DAMAGE.modeName()
	if state.growExisting then return "Grow Existing Slots" end
	if state.growNew then return "Grow New Slots" end
	if state.farmCoins then return "AFK Coin Farm" end
	return "modo atual"
end

function DAMAGE.isSafeSpawn(part)
	if not part or not part:IsA("BasePart") or not part.Parent then return false end

	local name = part.Name:lower()
	if name:find("aquatic", 1, true)
		or name:find("water", 1, true)
		or name:find("ocean", 1, true)
		or name:find("river", 1, true) then
		return false
	end

	return true
end

function DAMAGE.getNearestSafeSpawns(root)
	refreshCompletionSpawns()

	local candidates = {}
	for _, part in ipairs(completionSpawnParts) do
		if DAMAGE.isSafeSpawn(part) then
			table.insert(candidates, part)
		end
	end

	table.sort(candidates, function(a, b)
		return (a.Position - root.Position).Magnitude < (b.Position - root.Position).Magnitude
	end)

	return candidates
end

function DAMAGE.teleportToSafety()
	local character, root = characterParts()
	if not character or not root then return false, nil end

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	if waterPart and waterPart:IsA("BasePart") then
		waterPart.CanCollide = false
	end

	local candidates = DAMAGE.getNearestSafeSpawns(root)
	for _, spawnPart in ipairs(candidates) do
		runtimeMessage = "Watchdog: fugindo para " .. spawnPart.Name

		local ok = ragdollTeleport(spawnPart.Position, 5)
		task.wait(0.25)

		local _, newRoot = characterParts()
		if ok and newRoot and not isStandingInWater(newRoot) then
			return true, spawnPart
		end
	end

	local fallback = getSafeFarmPosition()
	if fallback then
		runtimeMessage = "Watchdog: usando ponto seguro alternativo"
		local ok = ragdollTeleport(fallback, 5)
		task.wait(0.25)

		local _, newRoot = characterParts()
		if ok and newRoot and not isStandingInWater(newRoot) then
			return true, nil
		end
	end

	return false, nil
end

function DAMAGE.recover(character, humanoid, healthBefore, healthAfter, reason, forceMinimumWait)
	if state.questGrowthReset.exclusive then return end
	if DAMAGE.active or tick() < DAMAGE.cooldownUntil then return end
	if character ~= player.Character or not humanoid.Parent or humanoid.Health <= 0 then return end

	DAMAGE.active = true

	local previousCriticalRecovery = criticalRecoveryActive
	local previousAutoEat = state.autoEat
	local previousAutoDrink = state.autoDrink
	local previousMode = DAMAGE.modeName()

	criticalRecoveryActive = true
	state.autoEat = false
	state.autoDrink = false
	removeSwimBarrier()
	drinkingToFull = false
	eatingToFull = false
	activeCarcass = nil
	state.questBaboonFeeding = false
	state.questGiraffeFeeding = false
	BABOON.cancel()
	GIRAFFE.cancel()
	drinkingSourcePosition = nil

	if renders then
		if renders.autoEat then renders.autoEat() end
		if renders.autoDrink then renders.autoDrink() end
	end

	local maxHealth = math.max(humanoid.MaxHealth, 1)
	local lostPercent = math.max(0, math.floor(((healthBefore - healthAfter) / maxHealth) * 100 + 0.5))

	if reason == "critical" then
		runtimeMessage = string.format(
			"Watchdog CRITICO: vida em %d%%; fugindo agora",
			math.floor((healthAfter / maxHealth) * 100)
		)
	elseif reason == "slow" then
		runtimeMessage = string.format(
			"Watchdog: vida caindo sem controle (-%d%%); fugindo",
			lostPercent
		)
	else
		runtimeMessage = string.format("Watchdog: dano alto (-%d%%); fugindo", lostPercent)
	end

	-- Espera brevemente uma ação anterior liberar state.busy.
	local busyDeadline = tick() + 2
	while state.busy and tick() < busyDeadline and state.alive do
		task.wait(0.05)
	end

	-- Emergência tem prioridade.
	if state.busy then
		state.busy = false
	end

	local escaped, safeSpawn = DAMAGE.teleportToSafety()

	character = player.Character
	humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if escaped and character and humanoid and humanoid.Health > 0 then
		local food = character:GetAttribute("Food") or 0
		local water = character:GetAttribute("Water") or 0
		local waitStartedAt = tick()
		local minimumWaitUntil = waitStartedAt + DAMAGE.criticalMinWait

		while state.alive
			and character == player.Character
			and humanoid.Parent
			and humanoid.Health > 0
			and tick() < minimumWaitUntil do

			food = character:GetAttribute("Food") or 0
			water = character:GetAttribute("Water") or 0

			-- Não mata um slot de fome/sede só para cumprir o timer.
			-- Se um recurso ficar realmente baixo, libera o survival mais cedo.
			if food <= 45 or water <= 45 then
				runtimeMessage = string.format(
					"Watchdog: seguro, mas Food %d%% Water %d%%; liberando survival",
					math.floor(food),
					math.floor(water)
				)
				break
			end

			runtimeMessage = string.format(
				"Watchdog: protegido em %s (%ds) | HP %d%%",
				safeSpawn and safeSpawn.Name or "local seguro",
				math.max(0, math.ceil(minimumWaitUntil - tick())),
				math.floor((humanoid.Health / math.max(humanoid.MaxHealth, 1)) * 100)
			)
			task.wait(0.5)
		end

		food = character:GetAttribute("Food") or 0
		water = character:GetAttribute("Water") or 0

		if food >= DAMAGE.safeFoodWater and water >= DAMAGE.safeFoodWater then
			local startHealth = humanoid.Health
			local targetHealth = math.min(
				humanoid.MaxHealth,
				startHealth + humanoid.MaxHealth * DAMAGE.targetHealFraction
			)
			local deadline = tick() + DAMAGE.maxRecoveryWait

			while state.alive
				and character == player.Character
				and humanoid.Parent
				and humanoid.Health > 0
				and tick() < deadline
				and humanoid.Health < targetHealth do

				food = character:GetAttribute("Food") or 0
				water = character:GetAttribute("Water") or 0

				if food < DAMAGE.safeFoodWater or water < DAMAGE.safeFoodWater then
					break
				end

				runtimeMessage = string.format(
					"Watchdog: recuperando vida em %s (%ds)",
					safeSpawn and safeSpawn.Name or "local seguro",
					math.max(0, math.ceil(deadline - tick()))
				)
				task.wait(0.5)
			end
		elseif not forceMinimumWait then
			runtimeMessage = string.format(
				"Watchdog: Food %d%% Water %d%%; retomando para repor",
				math.floor(food),
				math.floor(water)
			)
			task.wait(1)
		end
	elseif not escaped then
		runtimeMessage = "Watchdog: nenhum spawn seguro confirmado"
		task.wait(0.5)
	end

	state.autoEat = previousAutoEat
	state.autoDrink = previousAutoDrink

	if state.farmCoins
		or state.growExisting
		or state.growAllSlots
		or state.growNew then
		state.autoEat = true
		state.autoDrink = true
	end

	if renders then
		if renders.autoEat then renders.autoEat() end
		if renders.autoDrink then renders.autoDrink() end
	end

	criticalRecoveryActive = previousCriticalRecovery
	DAMAGE.active = false
	DAMAGE.cooldownUntil = tick() + 2
	runtimeMessage = "Watchdog: seguro; retomando " .. previousMode
end

function DAMAGE.bind(character)
	if DAMAGE.connection then
		DAMAGE.connection:Disconnect()
		DAMAGE.connection = nil
	end

	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
		or character:WaitForChild("Humanoid", 10)
	if not humanoid then return end

	local lastHealth = humanoid.Health
	local windowStartHealth = nil
	local windowStartedAt = nil

	-- Maior vida observada na janela lenta.
	local slowPeakHealth = humanoid.Health
	local slowPeakAt = tick()

	DAMAGE.connection = humanoid.HealthChanged:Connect(function(newHealth)
		if not state.alive or character ~= player.Character then return end

		if state.questGrowthReset.exclusive then
			lastHealth = newHealth
			windowStartHealth = nil
			windowStartedAt = nil
			slowPeakHealth = newHealth
			slowPeakAt = tick()
			return
		end

		if newHealth <= 0 then
			lastHealth = newHealth
			return
		end

		local now = tick()
		local maxHealth = math.max(humanoid.MaxHealth, 1)

		-- Emergência ignora cooldown. O cooldown só bloqueia duplicatas normais.
		if not DAMAGE.active
			and newHealth <= maxHealth * DAMAGE.criticalHealthFraction then
			local before = math.max(lastHealth, slowPeakHealth, newHealth)
			lastHealth = newHealth
			windowStartHealth = nil
			windowStartedAt = nil
			slowPeakHealth = newHealth
			slowPeakAt = now
			task.spawn(DAMAGE.recover, character, humanoid, before, newHealth, "critical", true)
			return
		end

		if DAMAGE.active or now < DAMAGE.cooldownUntil then
			lastHealth = newHealth
			windowStartHealth = nil
			windowStartedAt = nil
			slowPeakHealth = math.max(slowPeakHealth, newHealth)
			return
		end

		-- Atualiza/reinicia a referência de vida alta da janela lenta.
		if newHealth > slowPeakHealth then
			slowPeakHealth = newHealth
			slowPeakAt = now
		elseif now - slowPeakAt > DAMAGE.slowWindowSeconds then
			-- A cada janela, carrega a vida atual como nova referência.
			-- Assim detecta uma queda prolongada em "degraus" sem depender de hit grande.
			slowPeakHealth = math.max(newHealth, lastHealth)
			slowPeakAt = now
		end

		-- Dano rápido: mantém a lógica anterior de 35% em até 4 segundos.
		if newHealth < lastHealth then
			if not windowStartedAt or now - windowStartedAt > DAMAGE.windowSeconds then
				windowStartedAt = now
				windowStartHealth = lastHealth
			end

			local baseline = windowStartHealth or lastHealth
			local loss = baseline - newHealth
			local fastThreshold = maxHealth * DAMAGE.dropFraction

			if loss >= fastThreshold then
				windowStartHealth = nil
				windowStartedAt = nil
				lastHealth = newHealth
				task.spawn(DAMAGE.recover, character, humanoid, baseline, newHealth, "fast", true)
				return
			end

			-- Dano lento/descontrolado: a vida pode ir caindo pouco a pouco.
			local slowLoss = slowPeakHealth - newHealth
			local slowThreshold = maxHealth * DAMAGE.slowDropFraction

			if slowLoss >= slowThreshold then
				local before = slowPeakHealth
				windowStartHealth = nil
				windowStartedAt = nil
				lastHealth = newHealth
				slowPeakHealth = newHealth
				slowPeakAt = now
				task.spawn(DAMAGE.recover, character, humanoid, before, newHealth, "slow", true)
				return
			end
		elseif newHealth > lastHealth then
			-- Regenerou: zera a janela rápida. A lenta conserva o novo pico.
			windowStartHealth = nil
			windowStartedAt = nil
			if newHealth >= slowPeakHealth then
				slowPeakHealth = newHealth
				slowPeakAt = now
			end
		end

		lastHealth = newHealth
	end)
end

DAMAGE.bind(player.Character)

task.spawn(function()
	local trackedCharacter
	local trackedHumanoid
	local peakHealth
	local peakAt

	while state.alive do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		if character ~= trackedCharacter or humanoid ~= trackedHumanoid then
			trackedCharacter = character
			trackedHumanoid = humanoid
			peakHealth = humanoid and humanoid.Health or nil
			peakAt = tick()
		elseif humanoid
			and humanoid.Parent
			and humanoid.Health > 0
			and not state.questGrowthReset.exclusive then
			local now = tick()
			local maxHealth = math.max(humanoid.MaxHealth, 1)
			local currentHealth = humanoid.Health

			if not peakHealth or currentHealth > peakHealth then
				peakHealth = currentHealth
				peakAt = now
			elseif now - (peakAt or now) > DAMAGE.pollWindow then
				-- Carry current HP forward so repeated small drops continue
				-- being detectable instead of keeping a stale lifetime peak.
				peakHealth = math.max(currentHealth, peakHealth - maxHealth * 0.05)
				peakAt = now
			end

			if not DAMAGE.active then
				-- Layer 1: current HP alone is enough to trigger safety.
				if currentHealth <= maxHealth * DAMAGE.criticalHealthFraction then
					task.spawn(
						DAMAGE.recover,
						character,
						humanoid,
						math.max(peakHealth or currentHealth, currentHealth),
						currentHealth,
						"critical",
						true
					)
				else
					-- Layer 2: continuous small loss in the polling window.
					local pollLoss = (peakHealth or currentHealth) - currentHealth
					if pollLoss >= maxHealth * DAMAGE.pollDropFraction
						and now - (peakAt or now) <= DAMAGE.pollWindow then

						local before = peakHealth or currentHealth
						peakHealth = currentHealth
						peakAt = now

						task.spawn(
							DAMAGE.recover,
							character,
							humanoid,
							before,
							currentHealth,
							"slow",
							true
						)
					end
				end
			end
		end

		task.wait(DAMAGE.pollInterval)
	end
end)

