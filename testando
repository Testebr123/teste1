-- Executor-safe scheduling compatibility. Some executors expose task.spawn/task.wait
-- but not task.defer/task.delay. Never call an optional scheduler function directly.
local function mmbTaskDefer(callback, ...)
	if type(callback) ~= "function" then
		return nil
	end

	local args = { ... }
	local argCount = select("#", ...)

	return task.spawn(function()
		task.wait()
		if argCount == 0 then
			callback()
		elseif argCount == 1 then
			callback(args[1])
		elseif argCount == 2 then
			callback(args[1], args[2])
		else
			callback(table.unpack(args, 1, argCount))
		end
	end)
end

local function mmbTaskDelay(seconds, callback, ...)
	if type(callback) ~= "function" then
		return nil
	end

	local args = { ... }
	local argCount = select("#", ...)
	seconds = tonumber(seconds) or 0

	return task.spawn(function()
		task.wait(math.max(seconds, 0))
		if argCount == 0 then
			callback()
		elseif argCount == 1 then
			callback(args[1])
		elseif argCount == 2 then
			callback(args[1], args[2])
		else
			callback(table.unpack(args, 1, argCount))
		end
	end)
end

