	while state.alive do
		-- AFK Coin is also the idle watcher. If a fresh Daily/Weekly appears
		-- while we are coin farming, switch back to Auto Quests automatically.
		if state.farmCoins and not state.autoQuests then
			local coinQuests = getAllQuests()
			local hasPending = state.questHasActionablePending(
				coinQuests,
				savedCharacters()
			)

			if hasPending then
				state.farmCoins = false
				state.growExisting = false
				state.growExistingAutomaticAll = false
				state.growAllSlots = false
				state.growNew = false
				state.questPostGrowAll = false
				state.questSeenAny = true
				state.questEmptyScans = 0
				state.autoQuests = true
				state.autoEat, state.autoDrink = true, true
				questStatusText = "Actionable quest opportunity found -> Auto Quests"
				runtimeMessage =
					"AFK Coins: a previously impossible/new quest is now actually workable"

				if renders then
					for _, key in ipairs({
						"farmCoins", "growExisting", "growAllSlots", "growNew",
						"autoQuests", "autoEat", "autoDrink"
					}) do
						if renders[key] then renders[key]() end
					end
				end
			end
		end

		if state.questGrowthReset.exclusive then
			questTravelWanted = false
			state.questTravelActive = false
			state.questLandInputActive = false
			state.questSetW(false)
			questStatusText = "Growth reset in progress - quests temporarily isolated"

		elseif state.autoQuests or state.autoClaimQuests then
			local quests = getAllQuests()
			if tick() - lastClaimCheck >= 10 then
				lastClaimCheck = tick()
				claimQuestRewards(quests)
			end
			if state.autoQuests then
				updateQuestAutomation()
			elseif state.autoClaimQuests then
				questStatusText = "Auto Claim: checking Daily + Weekly"
			end
		else
			questTravelWanted = false
			state.questTravelActive = false
		end

		if questStatusLabel and questStatusLabel.Parent then
			local displayText, displayLines =
				state.questBuildActiveStatus(getAllQuests())

			questStatusLabel.Text = displayText

			-- Keep enough room for the title + every quest line. v47 was
			-- shrinking this card back to 52px and clipping the actual mission.
			local cardHeight = math.max(96, 48 + (displayLines * 24))
			questStatusCard.Size = UDim2.new(1, 0, 0, cardHeight)
		end
		local fastQuestCheck = state.questSwimActive
			or tick() < (state.questForceFastRecheckUntil or 0)
