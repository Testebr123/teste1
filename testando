function state.questMovementOpportunisticInteract(
	character,
	root
)
	local data =
		state.questMoveInteract

	if not data
		or not character
		or not root
		or not state.autoQuests
		or not state.questMotionMoving
		or state.questMotionMode ~= "Land"
		or state.questGrowthReset.exclusive
		or state.busy
		or criticalRecoveryActive
		or DAMAGE.active
		or eatingToFull
		or drinkingToFull
		or carcassEatBusy
		or BABOON.busy
		or GIRAFFE.busy then

		return nil
	end

	if data.character ~= character then
		data.character = character
		data.lastCheckAt = 0
		data.lastEatRemoteAt = 0
		data.lastDrinkRemoteAt = 0
		data.grassGraceUntil = 0
		data.drinkGraceUntil = 0
		data.lastFood = nil
		data.lastWater = nil
	end

	local velocity =
		root.AssemblyLinearVelocity

	local planarSpeed =
		Vector3.new(
			velocity.X,
			0,
			velocity.Z
		).Magnitude

	if planarSpeed < 2 then
		return nil
	end

	local now = tick()

	if now - (data.lastCheckAt or 0) < 0.08 then
		if now < (data.grassGraceUntil or 0) then
			return "eat_grace"
		end

		if now < (data.drinkGraceUntil or 0) then
			return "drink_grace"
		end

		return nil
	end

	data.lastCheckAt = now

	local food =
		tonumber(
			character:GetAttribute("Food")
		) or 100

	local water =
		tonumber(
			character:GetAttribute("Water")
		) or 100

	if type(data.lastFood) == "number"
		and food > data.lastFood + 0.01 then

		data.grassGraceUntil =
			math.max(
				data.grassGraceUntil or 0,
				now + 1.25
			)
	end

	if type(data.lastWater) == "number"
		and water > data.lastWater + 0.01 then

		data.drinkGraceUntil =
			math.max(
				data.drinkGraceUntil or 0,
				now + 1.35
			)
	end

	data.lastFood = food
	data.lastWater = water

	local detected =
		detectAvailableFood(
			character
		)

	local class =
		getAnimalClass(
			character
		)

	local classLower =
		type(class) == "string"
			and class:lower()
			or ""

	local herbivore =
		classLower:find(
			"herb",
			1,
			true
		) ~= nil

	local carnivore =
		classLower:find(
			"carn",
			1,
			true
		) ~= nil

	if classLower == "" then
		carnivore =
			isCarnivoreCharacter(
				character
			)

		herbivore =
			not carnivore
				and not isBaboonCharacter(
					character
				)
	end

	-- Grass is opportunistic only: never search, steer, rotate or stop for it.
	if detected == "Eat"
		and herbivore
		and not isGiraffeCharacter(character)
		and state.autoEat
		and food < 99 then

		data.grassGraceUntil =
			now + 1.35

		-- E is only cosmetic. Consumption is started through the same
		-- AskServerToSetSubState remote used by normal Auto Eat.
		if now
			- (data.lastEatRemoteAt or 0)
			>= 0.55 then

			data.lastEatRemoteAt = now
			setSubState("Eating")

			runtimeMessage =
				"Auto Run: eating grass by remote while moving"
		end

		return "eat"
	end

	-- Water works the same way for herbivores/carnivores: use only water that
	-- is already under/next to the running animal. Never create a water route.
	if detected == "Drink"
		and (herbivore or carnivore)
		and state.autoDrink
		and water < 99 then

		data.drinkGraceUntil =
			now + 1.50

		-- E is only cosmetic here too. Keep the physical Auto Run untouched and
		-- request Drinking directly from the server while water is underfoot.
		if now
			- (data.lastDrinkRemoteAt or 0)
			>= 0.55 then

			data.lastDrinkRemoteAt = now
			setSubState("Drinking")

			runtimeMessage =
				"Auto Run: drinking by remote while moving"
		end

		return "drink"
	end

	if now < (data.grassGraceUntil or 0) then
		return "eat_grace"
	end

	if now < (data.drinkGraceUntil or 0) then
		return "drink_grace"
	end

	return nil
end

