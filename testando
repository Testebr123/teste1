			state.questSeenAny = false
			state.questEmptyScans = 0
			state.questForceFastRecheckUntil = tick() + 20
			return "quest references scheduled for refresh"
		elseif level == 2 then
			ai:RequestWorker("AutoQuests", reason)
			return "quest scan requested"
		elseif level == 3 then
			if stalled and stalled.type == "Run" then
				pcall(state.questHardRefreshW, "AI quest progress recovery", true)
			elseif stalled and stalled.type == "Swim" then
				state.questSwimReady = false
				removeSwimBarrier()
			elseif stalled and stalled.type == "Zone" then
				state.questZoneLastMoveAt = 0
				state.questZoneLastTarget = nil
			elseif stalled and stalled.type == "Group" then
				state.questGroup.handler = nil
				ai:RequestWorker("AutoGroup", reason)
			elseif stalled and stalled.type == "Growth" then
				ai:RequestWorker("GrowSlots", reason)
				ai:RequestWorker("Slots", reason)
			elseif state.questLandInputActive or state.questSwimActive then
				pcall(state.questHardRefreshW, "AI quest progress recovery", true)
			end
			ai:RequestWorker("AutoQuests", reason, 0.2)
			return "quest action/destination recalculated"
		elseif level == 4 then
			cancelSafePurpose("quest", "autoRun")
			state.questMotionMoving = false
			state.questMotionMode = nil
			state.autoRunMoveOwnsInput = false
			state.questSetW(false)
			ai:RequestWorker("AutoQuests", reason, 0.3)
			return "only Quest controller rebuilt"
		elseif level == 5 then
			local worker = context.water < context.food and "AutoDrink" or "AutoEat"
			ai:RequestWorker(worker, "Quest yielded to survival")
			return "Quest temporarily yielded to survival"
		elseif level == 6 then
			state.questLandWWatchReset()
			state.questSwimReady = false
			state.questZoneLastMoveAt = 0
			state.questZoneLastTarget = nil
			state.questForceFastRecheckUntil = tick() + 20
			ai:RequestWorker("AutoQuests", reason, 0.2)
			return "stalled quest substate reset"
		elseif level == 7 then
			state.questSeenAny = false
			state.questEmptyScans = 0
			state.questActionablePending = true
			state.questForceFastRecheckUntil = tick() + 30
			ai:RequestWorker("AutoQuests", "quest pipeline reconstruction", 0.2)
			return "quest pipeline reconstructed with original objective"
		end
		-- L8 is a conservative game-adapter fallback: stop unsupported locomotion,
		-- refresh the same quest list, and never invent a replacement quest.
		state.questSetW(false)
		state.questSwimActive = false
		state.questLandInputActive = false
		ai.Capabilities:Refresh()
		state.questForceFastRecheckUntil = tick() + 25
		ai:RequestWorker("AutoQuests", "game-adapter quest fallback", 0.2)
		return "game-adapter fallback queued; quest kept for re-evaluation"
	end,
	resume = function()
		if state.autoQuests then
			state.questForceFastRecheckUntil = tick() + 20
			ai:RequestWorker("AutoQuests", "resume Auto Quests")
		end
	end,
})

ai:RegisterModule("AFKCoins", {
	owner = "AFKCoins",
	priority = 38,
	dependencies = { "Character", "Safety", "Slots" },
	enabled = function()
		return state.farmCoins == true and ai.Capabilities.Current.coinFarm == true
	end,
	expectedProgress = function(context)
		if not context.characterAlive
			or state.coinFarmMenuRecovering
			or state.coinFarmSwitching then
			return "AFK slot recovery"
		end
		return readCoinValue() ~= nil and "coin balance" or false
	end,
	currentProgress = function(context)
		local coins = readCoinValue()
		if coins ~= nil then return coins end
		return nil
	end,
	healthCheck = function(context, runtime)
		if not context.characterAlive then
			local missingFor = state.coinFarmCharacterMissingSince
				and tick() - state.coinFarmCharacterMissingSince
				or 0
			if missingFor >= 8 and not state.coinFarmMenuRecovering then
				return { healthy = false, reason = "AFK Coin lost active character" }
			end
			return { healthy = true, waiting = true, reason = "menu grace/recovery" }
		end
		if state.coinFarmSwitching and tick() - (state.coinFarmRetryAt or tick()) > 45 then
			return { healthy = false, reason = "AFK Coin slot switch stalled" }
		end
		local preferred = state.coinFarmPreferredAnimal
		if type(preferred) == "string" and preferred ~= ""
			and state.questAnimalKey(preferred) ~= state.questAnimalKey(context.animal)
			and not state.coinFarmSwitchPending
			and not state.questGroup.coop.helperActive then
			runtime.afkMismatchSince = runtime.afkMismatchSince or tick()
			if tick() - runtime.afkMismatchSince >= 10 then
				return { healthy = false, reason = "AFK preferred animal is not active" }
			end
			return { healthy = true, waiting = true, reason = "preferred AFK slot handoff" }
		end
		runtime.afkMismatchSince = nil
		local remembered = state.coinFarmLastSlot
		if type(remembered) == "table" and remembered.CharacterName
			and context.slot ~= "Unknown"
			and context.slot ~= tostring(remembered.CharacterName)
			and not state.questGroup.coop.helperActive then
			runtime.afkSlotMismatchSince = runtime.afkSlotMismatchSince or tick()
			if tick() - runtime.afkSlotMismatchSince >= 12 then
				return { healthy = false, reason = "AFK remembered slot was not restored" }
			end
		else
			runtime.afkSlotMismatchSince = nil
		end
		local positionExempt = state.questGroup.coop.helperActive
			or state.questGroup.coop.helperSwitching
			or state.coinFarmSwitching
			or state.coinFarmMenuRecovering
			or state.slotParkingAudit.active
		if not positionExempt and not state.safeMove.active then
			local positionOk, atReset = pcall(state.atSlotSwitchPoint)
			if positionOk and not atReset then
				runtime.afkPositionMismatchSince =
					runtime.afkPositionMismatchSince or tick()
				if tick() - runtime.afkPositionMismatchSince >= 12 then
					return {
						healthy = false,
						reason = "AFK animal left the verified Reset Point",
					}
				end
				return {
					healthy = true,
					waiting = true,
					reason = "verifying AFK return position",
				}
			elseif positionOk and atReset then
				runtime.afkPositionMismatchSince = nil
			end
		else
			runtime.afkPositionMismatchSince = nil
		end
		local lease = ai.MovementManager.lease
		if lease and lease.owner ~= "AFKCoins" and lease.owner ~= "Slots"
			and lease.owner ~= "Safety" and not state.questGroup.coop.helperActive then
			return { healthy = false, reason = "AFK pipeline displaced by " .. tostring(lease.owner) }
		end
		return { healthy = true }
	end,
	timeout = 180,
	recover = function(level, reason, context, runtime)
		if not state.farmCoins then return "disabled by user" end
		if runtime.afkPositionMismatchSince then
			if not state.slotParkingAudit.active then
				state.slotParkingAuditStart("AFK position recovery", true)
			end
			return "AFK position drift routed through verified parking"
		end
		if level == 1 then
			state.coinFarmRememberCurrentSlot()
			return "AFK slot identity revalidated"
		elseif level == 2 then
			pcall(state.coinFarmMenuRecoveryStep)
			ai:RequestWorker("AFKCoins", reason)
			return "AFK menu state rechecked"
		elseif level == 3 then
			state.coinFarmSwitchPending = true
			state.coinFarmRetryAt = 0
			ai:RequestWorker("AFKCoins", reason)
			return "AFK preferred slot reacquisition requested"
		elseif level == 4 then
			cancelSafePurpose("slot_switch", "spawn")
			state.coinFarmSwitchPending = true
			state.coinFarmRetryAt = 0
			ai:RequestWorker("AFKCoins", reason, 0.3)
			return "AFK slot controller rebuilt"
		elseif level == 5 then
			ai:RequestWorker("AutoDrink", "AFK survival check")
			ai:RequestWorker("AutoEat", "AFK survival check")
			return "AFK yielded to survival"
		elseif level == 6 then
			state.coinFarmMenuRecovering = false
			state.coinFarmMenuRetryAt = 0
			state.coinFarmRetryAt = 0
			state.coinFarmSwitchPending = true
			return "AFK substate surgically reset"
		elseif level == 7 then
			state.coinFarmRememberCurrentSlot()
			state.coinFarmRequestPreferredSwitch("AI AFK pipeline reconstruction")
			ai:RequestWorker("AFKCoins", reason, 0.2)
			return "AFK pipeline reconstructed with user preference"
		end
		state.coinFarmSwitchPending = false
		state.coinFarmMenuRecovering = false
		state.coinFarmRememberCurrentSlot()
		ai:RequestWorker("AFKCoins", "safe game-adapter fallback", 0.2)
		return "AFK safe fallback kept the current verified slot"
	end,
	resume = function()
		if state.farmCoins then ai:RequestWorker("AFKCoins", "resume AFK Coin Farm") end
	end,
})

ai:RegisterModule("AutoGroup", {
	owner = "Quest",
	priority = 54,
	circuitPersistsWhenIdle = true,
	cancelMovementOnCircuit = false,
	dependencies = { "AutoQuests" },
	enabled = function()
		return ai.Capabilities.Current.groups == true
			and (
				state.questGroup.localHasActiveGroupTime()
				or state.questGroup.coop.helperActive
				or state.questGroup.createInFlight
			)
	end,
	expectedProgress = function()
		return state.questGroup.localHasActiveGroupTime() and "real group membership" or false
	end,
	currentProgress = function()
		local latestQuestProgress = 0
		for _, quest in ipairs(ai.QuestTracker.active) do
			if quest.type == "Group" then
				latestQuestProgress = math.max(
					latestQuestProgress,
					tonumber(quest.lastProgressAt) or 0
				)
			end
		end
		return latestQuestProgress + (tonumber(groupMemberCount()) or 0) * 0.001
	end,
	healthCheck = function()
		if state.questGroup.ignoredUntilPossibility then
			return { healthy = true, waiting = true, reason = "no verified group possibility" }
		end
		if state.questGroup.createInFlight
			and tick() - (state.questGroup.lastCreateAttemptAt or 0) > 30 then
			return { healthy = false, reason = "Group create transaction stalled" }
		end
		return { healthy = true }
	end,
	timeout = 150,
	recover = function(level, reason)
		if level == 1 then
			state.questGroup.handler = nil
			return "Group handler revalidated"
		elseif level == 2 then
			ai:RequestWorker("AutoGroup", reason)
			return "Group lifecycle requested"
		elseif level == 3 then
			state.questGroup.createInFlight = false
			state.questGroup.lastActionAt = 0
			state.questGroup.createFailures = (state.questGroup.createFailures or 0) + 1
			ai:RequestWorker("AutoGroup", reason, 0.2)
			return "stalled Group creation transaction released"
		elseif level == 4 then
			state.questGroup.handler = nil
			state.questGroup.lastActionAt = 0
			state.questGroup.passiveWatchAt = 0
			ai:RequestWorker("AutoGroup", "Group controller rebuild", 0.2)
			return "only Group controller rebuilt"
		elseif level == 5 then
			state.questGroup.lastServerAnalysisAt = 0
			state.questGroup.lastPossibilityAt = 0
			ai:RequestWorker("AutoGroup", "reanalyze verified group possibilities", 0.2)
			return "server group possibilities reanalyzed"
		elseif level == 6 then
			state.questGroup.difficultySince = nil
			state.questGroup.impossibleSince = nil
			state.questGroup.lastActionAt = 0
			ai:RequestWorker("AutoGroup", "Group deadlock release", 0.2)
			return "Group deadlock timers surgically released"
		elseif level == 7 then
			state.questGroup.handler = nil
			state.questGroup.pendingPackAnimal = nil
			state.questGroup.createInFlight = false
			state.questGroup.passiveWatchAt = 0
			ai:RequestWorker("AutoGroup", "Group pipeline reconstruction", 0.2)
			return "Group pipeline reconstructed"
		end
		ai.Capabilities:Refresh()
		state.questGroup.ignoredUntilPossibility = true
		ai.Memory:MarkFailure("module", "AutoGroup", reason, 60)
		return "Group adapter circuit opened until a new verified possibility"
	end,
})

ai:RegisterModule("Slots", {
	owner = "Slots",
	priority = 76,
	circuitPersistsWhenIdle = true,
	dependencies = { "Character" },
	enabled = function()
		-- v5.0: this flag is set BEFORE SafeMove asks MovementManager for the
		-- Reset Point lease. Omitting it made IsOwnerEnabled("Slots") return false
		-- even while Authority correctly elected Slots as the exclusive owner.
		return state.slotSwitchStagingActive == true
			or state.questSlots.busy
			or questSwitchingAnimal
			or state.coinFarmSwitching
			or state.coinFarmMenuRecovering
			or state.slotParkingAudit.active
			or state.questGrowthReset.exclusive
			or state.slotGuardian.recovering
	end,
	expectedProgress = function()
		return state.questExpectedSlot and "exact expected slot confirmation"
			or state.safeMove.active
				and (state.safeMove.reason == "slot_switch" or state.safeMove.reason == "spawn")
				and "verified Reset/slot destination"
			or state.slotGuardian.recovering and "same-slot respawn confirmation"
			or "slot transaction completion"
	end,
	currentProgress = function()
		return ai.SlotVerification.sequence
			+ ai.SlotVerification.positionSequence * 0.001
	end,
	healthCheck = function(context, runtime)
		local expected = state.questExpectedSlot
		if type(expected) == "table" and context.characterAlive then
			local nameMatches = expected.characterName
				and tostring(context.slot) == tostring(expected.characterName)
			local animalMatches = expected.animalName
				and state.questAnimalKey(context.animal)
					== state.questAnimalKey(expected.animalName)
			local identityMismatch = expected.characterName and not nameMatches
				or expected.animalName and not animalMatches
			if identityMismatch then
				if tick() - (expected.requestedAt or tick()) >= 18 then
					return { healthy = false, reason = "requested slot did not appear" }
				end
				return { healthy = true, waiting = true, reason = "waiting for exact slot replication" }
			end
		end
		if state.questGrowthReset.exclusive
			and tick() - (state.questGrowthReset.exclusiveSince or tick()) > 75 then
			return { healthy = false, reason = "Growth reset transaction exceeded safety ceiling" }
		end
		local destinationRequired = state.slotSwitchStagingActive == true
			or state.slotParkingAudit.active
			or state.questGrowthReset.exclusive
		if destinationRequired and context.characterAlive and not state.safeMove.active then
			local positionOk, atDestination = pcall(state.atSlotSwitchPoint)
			if positionOk and not atDestination then
				runtime.destinationMismatchSince = runtime.destinationMismatchSince or tick()
				if tick() - runtime.destinationMismatchSince >= 18 then
					return { healthy = false, reason = "Reset/slot destination was not verified" }
				end
				return { healthy = true, waiting = true, reason = "waiting for verified Reset destination" }
			elseif positionOk and atDestination then
				runtime.destinationMismatchSince = nil
			end
		else
			runtime.destinationMismatchSince = nil
		end
		if not context.characterAlive and state.slotGuardian.recovering then
			return { healthy = true, waiting = true, reason = "Slot Guardian respawn" }
		end
		if tick() - runtime.activeSince > 120
			and not state.safeMove.active
			and not state.slotParkingAudit.active
			and tick() - (ai.SlotVerification.lastConfirmedAt or 0) > 120 then
			return { healthy = false, reason = "slot transaction made no verified change" }
		end
		return { healthy = true }
	end,
	timeout = 100,
	recover = function(level, reason)
		if level == 1 then
			pcall(state.questSlotsNormalizeControl, player.Character)
			return "slot references normalized"
		elseif level == 2 then
			ai:RequestWorker("Slots", reason)
			return "Slot Guardian requested"
		elseif level == 3 then
			if type(state.questExpectedSlot) == "table" then
				state.questExpectedSlot.recoveryRequestedAt = tick()
			end
			ai:RequestWorker("Slots", reason, 0.2)
			return "exact slot target preserved and revalidated"
		elseif level == 4 then
			cancelSafePurpose("slot_switch", "spawn")
			ai:RequestWorker("Slots", reason, 0.3)
			return "slot movement rebuilt"
		elseif level == 5 then
			ai:RequestWorker("AutoDrink", "slot pipeline survival")
			ai:RequestWorker("AutoEat", "slot pipeline survival")
			return "slot pipeline yielded to survival"
		elseif level == 6 then
			if not state.safeMove.active then
				state.questSlots.busy = false
				questSwitchingAnimal = false
			end
			ai:RequestWorker("Slots", reason, 0.2)
			return "orphan slot flags released after owner check"
		elseif level == 7 then
			state.slotParkingAudit.retryAt = 0
			ai:RequestWorker("Slots", "slot pipeline reconstruction", 0.2)
			return "slot pipeline reconstructed with expected identity"
		end
		pcall(state.questSlotsNormalizeControl, player.Character)
		ai:RequestWorker("Slots", "safe slot fallback", 0.2)
		return "safe adapter fallback queued without changing user mode"
	end,
})

local function shallowSnapshot(value)
	if type(value) ~= "table" then return value end
	local copy = {}
	for key, item in pairs(value) do copy[key] = item end
	return copy
end

ai.DeathRecovery = {
	lastSnapshot = nil,
	humanoidConnection = nil,
	pending = false,
	resuming = false,
	bindGeneration = 0,
	resumeGeneration = 0,
}

function ai.DeathRecovery:Capture(reason)
	local context = ai.Context:Update(false)
	local position = context.position
	local enabledModules = {}
	for _, moduleName in ipairs(ai.ModuleRegistry.order) do
		local module = ai.ModuleRegistry:Get(moduleName)
		if module and ai.ModuleRegistry:Enabled(module, context) then
			table.insert(enabledModules, moduleName)
		end
	end
	self.lastSnapshot = {
		at = tick(),
		reason = reason or "Died",
		game = context.game,
		animal = context.animal,
		slot = context.slot,
		food = context.food,
		water = context.water,
		health = context.health,
		growth = context.growth,
		position = position,
		goal = context.primaryGoal,
		module = context.primaryModule or ai.GoalManager.currentModule,
		subGoal = context.subGoal,
		owner = context.currentOwner,
		action = context.currentAction,
		movementTarget = context.movementTarget,
		movementReason = context.movementReason,
		watchdog = context.activeWatchdog,
		intentVersion = ai.UserIntent.version,
		intent = shallowSnapshot(ai.UserIntent.values),
		enabledModules = enabledModules,
		expectedSlot = shallowSnapshot(state.questExpectedSlot),
	}
	self.pending = true
	ai.Telemetry:Push("DeathRecovery", "death", {
		reason = reason,
		owner = context.currentOwner,
		target = position,
		result = context.primaryGoal,
	}, "death:" .. tostring(context.slot), "Death recorded - preserving enabled objective")
	return self.lastSnapshot
end

function ai.DeathRecovery:Bind(character)
	self.bindGeneration += 1
	local generation = self.bindGeneration
	if self.humanoidConnection then
		pcall(self.humanoidConnection.Disconnect, self.humanoidConnection)
		self.humanoidConnection = nil
	end
	if not character then return false end
	task.spawn(function()
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			pcall(character.WaitForChild, character, "Humanoid", 10)
			humanoid = character:FindFirstChildOfClass("Humanoid")
		end
		if generation ~= self.bindGeneration
			or not ai.Enabled
			or not humanoid
			or not humanoid.Parent then
			return
		end
		self.humanoidConnection = humanoid.Died:Connect(function()
			if generation == self.bindGeneration then
				self:Capture("Humanoid.Died")
			end
		end)
	end)
	return true
end

function ai.DeathRecovery:Resume(character)
	if not self.pending or not self.lastSnapshot then return false end
	if self.resuming then return false end
	local snapshot = self.lastSnapshot
	self.resuming = true
	self.resumeGeneration += 1
	local generation = self.resumeGeneration
	task.spawn(function()
		local deadline = tick() + 60
		local verifiedCharacter
		while state.alive and ai.Enabled
			and generation == self.resumeGeneration
			and tick() < deadline do
			local candidate = player.Character
			local humanoid = candidate and candidate:FindFirstChildOfClass("Humanoid")
			local root = candidate and candidate:FindFirstChild("HumanoidRootPart")
			if candidate and candidate.Parent and humanoid and root
				and humanoid.Health > 0
				and candidate:IsDescendantOf(workspace) then
				verifiedCharacter = candidate
				break
			end
			task.wait(0.25)
		end

		if not verifiedCharacter then
			self.resuming = false
			ai.Telemetry:Push("DeathRecovery", "waiting", {
				reason = "respawn did not become playable within 60s",
				result = snapshot.goal,
			}, "death-resume-wait:" .. tostring(snapshot.slot),
				"Respawn incomplete - keeping exact pipeline pending")
			task.delay(2, function()
				if state.alive and ai.Enabled and self.pending and not self.resuming then
					self:Resume(player.Character)
				end
			end)
			return
		end

		local guardianDeadline = tick() + 20
		while state.alive and state.slotGuardian.recovering
			and tick() < guardianDeadline do
			task.wait(0.25)
		end
		if generation ~= self.resumeGeneration or not ai.Enabled then
			self.resuming = false
			return
		end

		local context = ai.Context:Update(true)
		context.aiState = "RESUME"
		context.primaryGoal = snapshot.goal or context.primaryGoal
		context.subGoal = snapshot.subGoal or "verified respawn"
		context.currentAction = "Resuming preserved pipeline"

		if snapshot.intentVersion == ai.UserIntent.version
			and type(snapshot.expectedSlot) == "table"
			and state.questExpectedSlot == nil
			and ai.Capabilities:Has("slots") then
			state.questExpectedSlot = shallowSnapshot(snapshot.expectedSlot)
			state.questExpectedSlot.requestedAt = tick()
			ai:RequestWorker("Slots", "restore expected respawn slot")
		end

		local moduleName = snapshot.module
			or ai.GoalManager:ModuleForGoal(snapshot.goal)
		local module = moduleName and ai.ModuleRegistry:Get(moduleName)
		if module and ai.ModuleRegistry:Enabled(module, context)
			and type(module.resume) == "function" then
			ai:SafeCall("death resume:" .. moduleName, module.resume, context, snapshot)
		end

		local exactWorker = {
			AutoDrink = "AutoDrink",
			AutoEat = "AutoEat",
			AutoQuests = "AutoQuests",
			GrowSlots = "GrowSlots",
			AFKCoins = "AFKCoins",
			AutoGroup = "AutoGroup",
			Slots = "Slots",
		}
		if exactWorker[moduleName] then
			ai:RequestWorker(exactWorker[moduleName], "resume exact pre-death module")
		end
		if state.farmCoins and ai.Capabilities:Has("coinFarm") then
			ai:RequestWorker("AFKCoins", "respawn recovery")
		end
		if state.growthModeActive() and ai.Capabilities:Has("growth") then
			ai:RequestWorker("GrowSlots", "respawn recovery")
		end
		if state.autoQuests and ai.Capabilities:Has("quests") then
			ai:RequestWorker("AutoQuests", "respawn recovery")
		end
		if state.autoDrink and ai.Capabilities:Has("surfaceDrink") then
			ai:RequestWorker("AutoDrink", "respawn recovery")
		end
		if state.autoEat and ai.Capabilities:Has("food") then
			ai:RequestWorker("AutoEat", "respawn recovery")
		end

		self.pending = false
		self.resuming = false
		ai.Telemetry:Push("DeathRecovery", "resume", {
			reason = "new character verified",
			owner = snapshot.owner,
			result = tostring(snapshot.goal) .. " / " .. tostring(moduleName),
		}, "death-resume:" .. tostring(snapshot.slot),
			"Respawn verified - resuming " .. tostring(snapshot.goal))
	end)
	return true
end

ai.DeathRecovery:Bind(player.Character)
table.insert(connections, player.CharacterAdded:Connect(function(character)
	ai.DeathRecovery:Bind(character)
	ai.DeathRecovery:Resume(character)
end))

function ai:CriticalObserve()
	local character, root, humanoid = characterParts()
	if not character or not root or not humanoid or humanoid.Health <= 0 then return end
	local board = self.Blackboard
	board.character = character
	board.root = root
	board.humanoid = humanoid
	board.characterAlive = true
	board.health = humanoid.Health
	board.maxHealth = math.max(1, humanoid.MaxHealth)
	board.healthFraction = board.health / board.maxHealth
	board.food = tonumber(character:GetAttribute("Food")) or board.food or 100
	board.water = tonumber(character:GetAttribute("Water")) or board.water or 100
	board.position =
		root.Position

	board.inVoid =
		root.Position.Y < config.dangerY

	-- CriticalObserve runs more often than the full environment sampler. Never
	-- reuse a stale pre-transaction buried=true while Underground Drink is active.
	if state.drinkTest
		and state.drinkTest.active == true
		and state.drinkTest.character == character then
		board.buried = false
	end

	board.drinkingProtected =
		state.drinkTransactionProtected
		and state.drinkTransactionProtected(
			character
		)
		or false

	board.drinking =
		drinkingToFull
		or state.drinkTest.active
		or state.drinkProgress.confirmed
		or board.drinkingProtected

	local liveIntentionalWaterTransit =
		state.intentionalWaterTransitActive(
			character,
			root
		)

	board.intentionalWaterTransit =
		liveIntentionalWaterTransit

	board.dangerousWater =
		not board.drinkingProtected
		and not board.drinking
		and not liveIntentionalWaterTransit
		and not state.questSwimActive
		and state.supervisorDangerousWaterHazard(
			character,
			root
		)
		or false

	board.dinoShorelineFoodDeadlock =
		not board.drinkingProtected
		and not board.intentionalWaterTransit
		and state.dinoShorelineSafetyHazardLive(
			character,
			root
		)
		or false

	board.dinoRockTrapped =
		state.dinoRockSafetyHazardLive()
	local undergroundDrinkProtected =
		state.undergroundDrinkTerrainProtected
		and state.undergroundDrinkTerrainProtected(character)
		or false

	local severe =
		board.inVoid
		or (
			not undergroundDrinkProtected
			and (
				board.buried
				or (board.dangerousWater and not board.intentionalWaterTransit)
			)
		)
		or board.healthFraction <= 0.35
		or board.dinoRockTrapped
		or board.dinoShorelineFoodDeadlock
		or forcingPostDrinkMove
		or (state.dinoPostDrinkExit and state.dinoPostDrinkExit.active)

	if severe then
		if self.Authority then
			self.Authority:Tick(board)
		end

		if self.MovementManager:IsOwnerEnabled("Safety", board) then
			self.SurvivalManager:Act({ owner = "Safety", name = "Survival: Safety" }, board)
		end
	elseif self.Authority
		and self.Authority.currentOwner == "Safety" then
		-- Fast Safety release is still allowed, but ordinary Food/Water/Quest
		-- elections are NOT rerun five times per second.
		self.Authority:ReleaseStaleSafety(
			board,
			"critical observer cleared Safety"
		)
	end
end

function ai:CoordinationStep()
	self.Phase = "OBSERVE"
	local context = self.Context:Update(true)
	self.Phase = "UNDERSTAND"
	self.WatchdogManager:Refresh(context)
	if self.Authority then self.Authority:Tick(context) end
	self.Phase = "PRIORITIZE"
	local choice = self.GoalManager:Update(context)
	self.Phase = "ACT"
	local safetyRequested = self:ConsumeWorkerRequest("Safety")
	local autoDrinkRequested = self:ConsumeWorkerRequest("AutoDrink")
	local autoEatRequested = self:ConsumeWorkerRequest("AutoEat")

	if autoDrinkRequested
		and self.Authority
		and self.Authority.currentOwner == "Water" then
		mmbTaskDefer(function()
			pcall(autoDrinkStep)
		end)
	end

	if autoEatRequested
		and self.Authority
		and self.Authority.currentOwner == "Food" then
		mmbTaskDefer(function()
			pcall(autoEatStep)
		end)
	end

	local undergroundDrinkProtected =
		state.undergroundDrinkTerrainProtected
		and state.undergroundDrinkTerrainProtected(context.character)
		or false

	local verifiedSafetyNeed = not undergroundDrinkProtected and (
		context.inVoid
		or context.buried
		or (
			context.dangerousWater
				and not context.intentionalWaterTransit
				and not context.drinkingProtected
		)
		or context.dinoRockTrapped
		or context.dinoShorelineFoodDeadlock
		or forcingPostDrinkMove
		or (state.dinoPostDrinkExit and state.dinoPostDrinkExit.active)
		or context.healthFraction <= 0.35
		or context.healthRate < -0.8
	)
	if safetyRequested
		and verifiedSafetyNeed
		and self.MovementManager:IsOwnerEnabled("Safety", context) then
		self.SurvivalManager:Act(
			{ owner = "Safety", name = "Survival: Safety" },
			context
		)
	else
		self.SurvivalManager:Act(choice, context)
	end
	if self.Authority then self.Authority:Enforce(context) end
	self.MovementManager:Reconcile(context)
	self.Phase = "VERIFY"
	context.cyclePhase = self.Phase
	if self.RecoveryManager.activeModule then
		context.aiState = "RECOVER"
	elseif #self.GoalManager.suspended > 0 then
		context.aiState = "SUSPEND"
	elseif choice and choice.name ~= "Idle" then
		context.aiState = "ACT"
	else
		context.aiState = "VERIFY"
	end
	return context
end

function ai:AuditStep()
	self.Capabilities:Refresh()
	local context = self.Context:Update(true)
	self.QuestTracker:Update()
	context = self.Context:Update(false)
	self.ProgressMonitor:Sweep(context)
	self.SanityAudit:Run(context)
	self.Memory:SyncLegacyFailures()
	if context.waterRate > 0.05 and state.drinkSearch.currentWaterPoint then
		self.Memory:Remember(
			"found_water",
			state.drinkSearch.currentWaterPoint,
			"Water attribute increased",
			900
		)
	end
	if context.foodRate > 0.05 then
		local foodSource = activeCarcass or eatingSourcePosition
		if foodSource then
			self.Memory:Remember("found_food", foodSource, "Food attribute increased", 900)
		end
	end
	self.Memory:Prune()

	local now = tick()
	if now - (self.Health.criticalAt or 0) > 1.5 then
		self.Telemetry:Push("Supervisor", "error", {
			reason = "critical monitor heartbeat late",
			result = string.format("%.1fs", now - self.Health.criticalAt),
		}, "ai-critical-late", "Supervisor critical monitor recovered")
	end
	if now - (self.Health.coordinationAt or 0) > 4 then
		self.Telemetry:Push("Supervisor", "error", {
			reason = "coordination heartbeat late",
			result = string.format("%.1fs", now - self.Health.coordinationAt),
		}, "ai-coordinate-late", "Supervisor coordination monitor recovered")
	end
	self.Health.auditAt = now
	return context
end

function ai:Shutdown()
	self.Enabled = false
	self.DeathRecovery.bindGeneration += 1
	self.DeathRecovery.resumeGeneration += 1
	self.DeathRecovery.resuming = false
	if self.DeathRecovery.humanoidConnection then
		pcall(
			self.DeathRecovery.humanoidConnection.Disconnect,
			self.DeathRecovery.humanoidConnection
		)
		self.DeathRecovery.humanoidConnection = nil
	end
	self.MovementManager.lease = nil
	self.Telemetry:Push("Supervisor", "shutdown", { reason = "Hub cleanup" })
end

