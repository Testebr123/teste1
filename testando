function CROC.getAnimalName(character)
	local model = workspace:FindFirstChild(player.Name)
	local target = (model and model:IsA("Model") and model) or character or player.Character
	if not target then return nil end

	local animal = target:GetAttribute("AnimalName")
	if type(animal) == "string" and animal ~= "" then return animal end

	local valueObject = target:FindFirstChild("AnimalName")
	if valueObject and valueObject:IsA("StringValue") and valueObject.Value ~= "" then
		return valueObject.Value
	end
	return nil
end

local function isGiraffeCharacter(character)
	local animal = CROC.getAnimalName(character)
	return type(animal) == "string"
		and animal:lower() == "giraffe"
end


local function isBaboonCharacter(character)
	local animal = CROC.getAnimalName(character)
	return type(animal) == "string"
		and animal:lower() == "baboon"
end


function CROC.isCharacter(character)
	local animal = CROC.getAnimalName(character)
	return type(animal) == "string" and animal:lower():find("croc", 1, true) ~= nil
end

local function isAquaticCharacter(character)
	local animal =
		CROC.getAnimalName(
			character
		)

	if type(animal) ~= "string" then
		return false
	end

	local key =
		animal:lower()

	-- Savannah currently exposes Crocodile as "Croc" on the live workspace
	-- character in some versions/slots. Treat every Croc naming variant as
	-- aquatic instead of depending on one exact display name.
	return AQUATIC_ANIMALS[key] == true
		or key:find(
			"croc",
			1,
			true
		) ~= nil
end

function state.getCharacterMovementState(character)
	if not character then
		return nil
	end

	local value =
		character:GetAttribute(
			"MovementState"
		)

	if type(value) == "string"
		and value ~= "" then
		return value
	end

	local stateValue =
		character:FindFirstChild(
			"MovementState"
		)

	if stateValue
		and stateValue:IsA(
			"StringValue"
		) then

		return stateValue.Value
	end

	return nil
end

function state.isCharacterSwimmingState(character)
	local movementState =
		state.getCharacterMovementState(
			character
		)

	return type(movementState)
			== "string"
		and movementState:lower()
			== "swimming"
end

function state.gameTerrainWaterHeightAt(position)
	if typeof(position) ~= "Vector3" then
		return nil
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	params.IgnoreWater = false

	local globalWater =
		workspace:GetAttribute(
			"GlobalWaterLevelHeight"
		)

	local castY =
		math.max(
			position.Y + 180,
			type(globalWater) == "number"
				and globalWater + 180
				or position.Y + 180
		)

	local hit =
		workspace:Raycast(
			Vector3.new(
				position.X,
				castY,
				position.Z
			),
			Vector3.new(
				0,
				-500,
				0
			),
			params
		)

	if hit
		and hit.Material
			== Enum.Material.Water then
		return hit.Position.Y
	end

	return nil
end

function state.gameWaterSurfaceHeightAt(position)
	if typeof(position) ~= "Vector3" then
		return nil
	end

	-- Savannah's normal river path is Terrain Water. Match the game's order:
	-- Terrain water height first; global ocean height only as fallback.
	local terrainWater =
		state.gameTerrainWaterHeightAt(
			position
		)

	if type(terrainWater) == "number" then
		return terrainWater,
			"Terrain"
	end

	local globalWater =
		workspace:GetAttribute(
			"GlobalWaterLevelHeight"
		)

	if type(globalWater) == "number" then
		return globalWater,
			"Global"
	end

	return nil,
		nil
end

function state.gameSwimPointY(character, root)
	if not character then
		return root
			and root.Position.Y
			or nil
	end

	local attachment =
		character:FindFirstChild(
			"SwimHeightAttachment",
			true
		)

	if attachment
		and attachment:IsA(
			"Attachment"
		) then

		return attachment.WorldPosition.Y
	end

	return root
		and root.Position.Y
		or nil
end

function state.gameSwimmingGeometry(
	character,
	root,
	waterHeight
)
	if not character or not root then
		return false
	end

	local surfaceY =
		type(waterHeight) == "number"
			and waterHeight
			or state.gameWaterSurfaceHeightAt(
				root.Position
			)

	if type(surfaceY) ~= "number" then
		return state.isCharacterSwimmingState(
			character
		)
	end

	local swimY =
		state.gameSwimPointY(
			character,
			root
		)

	if type(swimY) ~= "number" then
		return false
	end

	-- We do not know the private controllerExtraOffset value for every animal.
	-- Use the game's visible swim point directly, with a tiny 0.05 tolerance
	-- only to prevent floating-point flicker at the exact surface.
	return swimY <= surfaceY + 0.05
end

function state.gameSwimmingExitConfirmed(
	character,
	root,
	waterHeight
)
	if not character or not root then
		return false
	end

	local surfaceY =
		type(waterHeight) == "number"
			and waterHeight
			or state.gameWaterSurfaceHeightAt(
				root.Position
			)

	if type(surfaceY) ~= "number" then
		return false
	end

	local swimY =
		state.gameSwimPointY(
			character,
			root
		)

	if type(swimY) ~= "number" then
		return false
	end

	-- Mirror the game's ExitSwimming geometry:
	-- swim point above surface AND root at least ~0.25 stud above that surface.
	-- MovementState is deliberately NOT required here because PlatformStand
	-- used by IY Fly can temporarily make Savannah report Idle.
	return swimY > surfaceY
		and root.Position.Y
			>= surfaceY + 0.25
end

local function setAquaticWaterCollision(character, enabled)
	if not character then
		return
	end

	-- Dino Life uses the water volume only as a visual/interaction surface.
	-- Keep MainWaterPart non-collidable so large dinosaurs (especially Rex) are
	-- not snagged by the invisible water plane while Auto Drink/Auto Grow moves.
	if isDinoLife then
		local dinoWater = workspace:FindFirstChild("MainWaterPart")
		if dinoWater and dinoWater:IsA("BasePart") then
			dinoWater.CanCollide = false
		end
		return
	end

	local aquatic =
		isAquaticCharacter(
			character
		)

	local crocHippo =
		state.isCrocOrHippoMovementCharacter
		and state.isCrocOrHippoMovementCharacter(
			character
		)

	if not aquatic
		and not crocHippo then
		return
	end

	local waterPart =
		workspace:FindFirstChild(
			"MainWaterPart"
		)

	if waterPart
		and waterPart:IsA(
			"BasePart"
		) then

		if crocHippo then
			-- Croc/Hippo normally REQUIRE the solid water surface.
			-- Collision is disabled ONLY while the dedicated underwater-exit
			-- transaction owns the animal.
			local exitActive =
				state.aquaticRiverEscape
				and (
					state.aquaticRiverEscape.busy
						or state.aquaticRiverEscape.survivalSuspended
				)

			waterPart.CanCollide =
				not exitActive
		else
			waterPart.CanCollide =
				enabled == true
		end
	end
end

-- Lê o AnimalClass direto do model do jogador na workspace (acha pelo nome
-- do jogador, sempre na hora — nunca cacheia, então funciona certinho
-- mesmo depois de trocar de animal). É a fonte mais confiável de dieta:
-- "Herbivore" come grama, "Carnivore" come carcaça.
local function getAnimalClass(character)
	local model = workspace:FindFirstChild(player.Name)
	local target = (model and model:IsA("Model") and model) or character
	if not target then return nil end
	local class = target:GetAttribute("AnimalClass")
	if type(class) == "string" and class ~= "" then return class end
	return nil
end

function state.questCurrentZoneName()
	local zone = player:GetAttribute("ZoneName")
	if type(zone) == "string" and zone ~= "" then return zone end

	local value = player:FindFirstChild("ZoneName")
	if value and value:IsA("StringValue") and value.Value ~= "" then
		return value.Value
	end

	local character = player.Character or workspace:FindFirstChild(player.Name)
	if character then
		zone = character:GetAttribute("ZoneName")
		if type(zone) == "string" and zone ~= "" then return zone end

		value = character:FindFirstChild("ZoneName")
		if value and value:IsA("StringValue") and value.Value ~= "" then
			return value.Value
		end
	end
end

function state.questRememberZoneBeforeFeeding(reason)
	if not state.autoQuests
		or state.questReturnZone.name
		or (
			state.questGrowthConcurrentActive
			and state.questGrowthConcurrentActive()
		) then
		return
	end

	local zone = state.questCurrentZoneName()
	if type(zone) ~= "string" or zone == "" then return end

	state.questReturnZone.name = zone
	state.questReturnZone.reason = reason or "feeding"
	state.questReturnZone.capturedAt = tick()
	state.questReturnZone.lastMoveAt = 0
end

function state.questClearReturnZone()
	state.questReturnZone.name = nil
	state.questReturnZone.reason = nil
	state.questReturnZone.capturedAt = 0
	state.questReturnZone.lastMoveAt = 0
end


local function isCarnivoreCharacter(character)
	if not character then return false end
	local class = getAnimalClass(character)
	if class then return class:lower():find("carn", 1, true) ~= nil end

	-- Fallback (só se o AnimalClass não existir por algum motivo): nome
	-- conhecido ou o antigo atributo AnimalType.
	local animal = character:GetAttribute("AnimalName")
	if type(animal) == "string" and CARNIVORE_NAMES_LOWER[animal:lower()] then return true end
	local animalType = character:GetAttribute("AnimalType")
	if type(animalType) == "string" and animalType:lower():find("carn", 1, true) then return true end
	return false
end
function state.autoGrowModeActive()
	return state.growExisting
		or state.growAllSlots
		or state.growNew
		or state.growExistingAutomaticAll
end

function state.questGrowthConcurrentActive()
	return state.autoQuests == true
		and state.autoGrowModeActive()
end

function state.autoGrowCurrentSlotComplete(character)
	if not state.questGrowthConcurrentActive() then
		return false
	end

	character = character or player.Character
	if not character then return false end

	local growth = tonumber(character:GetAttribute("GrowthPercentage"))
	return growth ~= nil and growth >= 99.999
end

function state.growthModeActive()
	-- Growth can be owned either by the manual Growth tab or temporarily by
	-- Auto Quests while it finishes/resets a growing slot. Pride Rock must
	-- remain enforced in both cases.
	return state.growExisting
		or state.growAllSlots
		or state.growNew
		or state.growExistingAutomaticAll
		or state.questPostGrowAll
		or state.questGrowthOwnsCurrent
		or (
			state.questGrowthReset
			and state.questGrowthReset.active ~= nil
		)
end

function state.isGrowthHerbivore(character)
	if not character then return false end

	local class = getAnimalClass(character)

	if type(class) == "string" and class ~= "" then
		return class:lower():find(
			"herb",
			1,
			true
		) ~= nil
	end

	-- Fallback only if AnimalClass has not replicated yet.
	local animal =
		character:GetAttribute("AnimalName")

	if type(animal) == "string" then
		local key = animal:lower()

		-- Baboon is omnivore; never apply the herbivore Pride leash.
		if key == "baboon" then
			return false
		end

		if CARNIVORE_NAMES_LOWER[key] then
			return false
		end
	end

	return true
end

function state.questZonePriorityActive()
	local zoneState = state.questZonePriority

	return state.autoQuests
		and zoneState
		and zoneState.resolved == true
		and zoneState.active == true
		and type(zoneState.zone) == "string"
		and zoneState.zone ~= ""
end

function state.positionInsideMapZone(position, zoneName)
	if typeof(position) ~= "Vector3"
		or type(zoneName) ~= "string"
		or zoneName == "" then
		return nil
	end

	local mapZones =
		workspace:FindFirstChild(
			"MapZones"
		)

	local zoneModel =
		mapZones
		and mapZones:FindFirstChild(
			zoneName
		)

	if not zoneModel then
		return nil
	end

	local foundVolume = false
	local zoneParts = {}

	if zoneModel:IsA("BasePart") then
		table.insert(zoneParts, zoneModel)
	end

	for _, object in ipairs(
		zoneModel:GetDescendants()
	) do
		if object:IsA("BasePart") then
			table.insert(zoneParts, object)
		end
	end

	for _, object in ipairs(zoneParts) do
		foundVolume = true

		local localPoint =
			object.CFrame:PointToObjectSpace(
				position
			)

		if math.abs(localPoint.X)
			<= object.Size.X * 0.5 + 3
			and math.abs(localPoint.Z)
				<= object.Size.Z * 0.5 + 3 then
			return true
		end
	end

	if foundVolume then
		return false
	end

	return nil
end

function state.questZoneFoodPositionAllowed(position)
	if not state.questZonePriorityActive() then
		return true
	end

	-- When a hand-picked ZoneTime farm point is active, food routing must remain
	-- near that point instead of roaming anywhere inside the broad MapZones volume.
	-- Opportunistic grass remains free because it never changes the movement route.
	if typeof(state.questZoneFarmTarget) == "Vector3"
		and typeof(position) == "Vector3" then

		return Vector3.new(
			position.X - state.questZoneFarmTarget.X,
			0,
			position.Z - state.questZoneFarmTarget.Z
		).Magnitude <= 55
	end

	local inside =
		state.positionInsideMapZone(
			position,
			state.questZonePriority.zone
		)

	-- Unknown/new zones without a configured farm point keep the old live-volume
	-- fallback so food safety is not accidentally disabled.
	if inside == nil then
		return true
	end

	return inside
end

function state.growthPrideRestrictionActive(character)
	-- Once the CURRENT slot reaches 100%, Pride Rock stops owning locomotion.
	-- Slot-switch Food/Water safety + Reset Point staging take priority.
	--
	-- This is especially important for Giraffe: there may be no reachable Leaves
	-- inside the local Pride food radius. Keeping the Pride leash alive at 100%
	-- creates a deadlock: Growth asks for Food, Auto Eat tries to find a tree,
	-- and growth_home immediately drags the animal back again.
	if character then
		local liveGrowth =
			tonumber(
				character:GetAttribute(
					"GrowthPercentage"
				)
			)

		if liveGrowth ~= nil then
			local complete =
				liveGrowth <= 1
					and liveGrowth >= 0.999
					or liveGrowth > 1
						and liveGrowth >= 99.9

			if complete then
				return false
			end
		end
	end

	-- Auto Quests-only Growth is PASSIVE and must never leash the quest runner to
	-- Pride Rock. The quest scheduler may briefly clear questGrowthOwnsCurrent
	-- while rescanning/switching; keying this rule off that transient flag caused
	-- growth_home to steal Auto Run between scans. Pride Rock is a Growth-tab rule.
	if state.autoQuests
		and not state.autoGrowModeActive() then
		return false
	end

	-- ZoneTime and Swim own locomotion while they run in parallel with Auto Grow.
	if not state.growthPrideEnabled
		or (
			state.autoQuests
			and state.questZonePriority
			and state.questZonePriority.resolved == false
		)
		or state.questZonePriorityActive()
		or (
			state.questGrowthConcurrentActive()
			and state.questSwimActive
		) then
		return false
	end

	return isSavannahLife
		and state.growthModeActive()
		and state.isGrowthHerbivore(character)
end

function state.growthPrideHorizontalDistance(position)
	if typeof(position) ~= "Vector3" then
		return math.huge
	end

	local center = state.growthPride.center

	return Vector3.new(
		position.X - center.X,
		0,
		position.Z - center.Z
	).Magnitude
end

function state.growthPridePositionInsideZone(position)
	if typeof(position) ~= "Vector3" then
		return nil
	end

	local mapZones = workspace:FindFirstChild("MapZones")
	local prideZone = mapZones and mapZones:FindFirstChild("Pride Rock")
	if not prideZone then
		return nil
	end

	local foundVolume = false

	for _, object in ipairs(prideZone:GetDescendants()) do
		if object:IsA("BasePart") then
			foundVolume = true

			local localPoint =
				object.CFrame:PointToObjectSpace(
					position
				)

			-- Zone parts are trigger volumes. X/Z is what matters for keeping
			-- the animal and grass target inside the actual Pride Rock territory.
			if math.abs(localPoint.X)
				<= object.Size.X * 0.5 + 3
				and math.abs(localPoint.Z)
					<= object.Size.Z * 0.5 + 3 then

				return true
			end
		end
	end

	if foundVolume then
		return false
	end

	return nil
end

function state.growthPrideInside(character, root)
	if not state.growthPrideRestrictionActive(character)
		or not root then
		return true
	end

	local home = state.growthPride.home
	local homeDistance = Vector3.new(
		root.Position.X - home.X,
		0,
		root.Position.Z - home.Z
	).Magnitude

	-- Being somewhere inside the enormous Pride Rock Zone is NOT enough. The
	-- Growth farm is the selected safe home around PrideRockSpawn1. This catches
	-- animals born at PrideRockSpawn3 and prevents them crossing the river.
	if homeDistance > (state.growthPride.radius or 220) then
		return false
	end

	local zone = state.questCurrentZoneName()
	if type(zone) == "string" and zone ~= "" then
		return zone:lower() == "pride rock"
	end

	local geometricInside =
		state.growthPridePositionInsideZone(root.Position)

	if geometricInside ~= nil then
		return geometricInside
	end

	-- Replication fallback is deliberately local to HOME.
	return true
end

function state.growthPrideFoodPositionAllowed(position)
	local character = player.Character

	if not state.growthPrideRestrictionActive(character) then
		return true
	end

	if typeof(position) ~= "Vector3" then
		return false
	end

	local home = state.growthPride.home
	local homeDistance = Vector3.new(
		position.X - home.X,
		0,
		position.Z - home.Z
	).Magnitude

	-- Food must remain in the LOCAL Pride farm, not merely somewhere in the
	-- Pride Rock zone. This is what prevents a herbivore from crossing the river
	-- to a grass patch on the opposite bank.
	if homeDistance > (state.growthPride.foodRadius or 170) then
		return false
	end

	local geometricInside =
		state.growthPridePositionInsideZone(position)

	if geometricInside ~= nil then
		return geometricInside
	end

	return true
end

function state.autoFoodPositionAllowed(position)
	local character =
		player.Character

	-- v4.2 QUEST/SURVIVAL ARBITRATION:
	-- Auto Quests may restrict herbivore food to the current Zone/Growth farm.
	-- A Giraffe with an explicit Food transaction must be allowed to leave that
	-- objective temporarily if no reachable local tree exists.  Turning Auto
	-- Quests OFF used to "fix" the Giraffe only because it removed this veto.
	if character
		and isGiraffeCharacter(character)
		and state.autoQuests
		and (
			state.questGiraffeFeeding
			or (
				state.questTravelFullRefill
				and state.questTravelFullRefill.active
				and state.questTravelFullRefill.owner == "food"
			)
		)
		and (tonumber(character:GetAttribute("Food")) or 100) < 100 then

		return true
	end

	-- CENTRAL HERBIVORE FOOD RECOVERY:
	-- once the normal grass controller has demonstrably failed, survival wins.
	-- Near Pride Rock, stale Zone/Growth restrictions may not veto food.
	if character
		and state.isGrowthHerbivore(
			character
		)
		and not isGiraffeCharacter(
			character
		)
		and not isBaboonCharacter(
			character
		)
		and state.herbivoreFoodRecoveryPrideFoodAllowed
		and state.herbivoreFoodRecoveryPrideFoodAllowed(
			position
		) then

		return true
	end

	-- Zone-local food restriction applies only to herbivores (including
	-- Giraffe). Carnivores/Baboon may still leave briefly for their valid food
	-- source; quest movement remains paused until feeding finishes.
	if state.questZonePriorityActive()
		and state.isGrowthHerbivore(
			character
		) then

		return state.questZoneFoodPositionAllowed(
			position
		)
	end

	return state.growthPrideFoodPositionAllowed(
		position
	)
end

