	local function rotatePlanar(direction, degrees)
		local angleRad = math.rad(degrees)
		local c = math.cos(angleRad)
		local s = math.sin(angleRad)

		return Vector3.new(
			direction.X * c - direction.Z * s,
			0,
			direction.X * s + direction.Z * c
		).Unit
	end

	local function autoTerrainHeightAt(position, referenceY)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { workspace.Terrain }
		params.IgnoreWater = false

		local topY = math.max(
			(referenceY or position.Y) + 300,
			position.Y + 300
		)

		local hit = workspace:Raycast(
			Vector3.new(position.X, topY, position.Z),
			Vector3.new(0, -650, 0),
			params
		)

		if not hit or hit.Material == Enum.Material.Water then
			return nil
		end

		return hit.Position.Y
	end

	local function autoRunTerrainSurfaceAt(
		position,
		referenceY
	)
		local topY =
			math.max(
				(referenceY or position.Y)
					+ 260,
				position.Y + 260
			)

		return workspace:Raycast(
			Vector3.new(
				position.X,
				topY,
				position.Z
			),
			Vector3.new(
				0,
				-620,
				0
			),
			autoWaterTerrainParams
		)
	end

	local function autoRunWaterAt(
		position,
		referenceY
