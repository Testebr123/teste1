local function giraffeEatLockedTree(selected)
	if GIRAFFE.busy
		or state.questGrowthReset.exclusive
		or type(selected) ~= "table"
		or not selected.tree
		or not selected.leafPart then
		return
	end

	local myToken = GIRAFFE.cancelToken
	GIRAFFE.busy = true
	GIRAFFE.targetTree = selected.tree
	GIRAFFE.targetLeaves = selected.leaves
	GIRAFFE.targetLeafPart = selected.leafPart
	GIRAFFE.targetStartedAt = GIRAFFE.targetStartedAt > 0
		and GIRAFFE.targetStartedAt
		or tick()

	local function cancelled()
		return myToken ~= GIRAFFE.cancelToken
			or state.questGrowthReset.exclusive
			or not state.autoEat
			or drinkingToFull
			or criticalRecoveryActive
	end

	local character, root = characterParts()
	if not character or not root or cancelled() then
		GIRAFFE.busy = false
		return
	end

	-- Re-check depletion BEFORE moving. A different player may have finished
	-- this tree after we selected it.
	local leafPart, info, initialApproach = giraffeBestReachableLeaf(
		selected.tree,
		character,
		root
	)
	if not info or info.depleted then
		runtimeMessage = "Giraffe: tree leaves are depleted; selecting another tree"
		GIRAFFE.clearTarget()
		GIRAFFE.busy = false
		return
	end

	if not leafPart then
		giraffeIgnoreTree(selected.tree, 75)
		runtimeMessage = "Giraffe: tree still has leaves, but they are above reach"
		GIRAFFE.clearTarget()
		GIRAFFE.busy = false
		return
	end

	selected.leafPart = leafPart
	selected.approach = initialApproach
	GIRAFFE.targetLeafPart = leafPart

	runtimeMessage = string.format(
		"Giraffe: locked tree with available leaves (%.0f studs)",
		selected.distance or 0
	)

	if (root.Position - giraffeTreeAnchorPart(selected.tree, leafPart).Position).Magnitude > 12 then
		giraffeApproachLockedTree(selected, GIRAFFE.repositionAttempts)
		task.wait(0.30)
	end

	character, root = characterParts()
	if not character or not root or cancelled() then
		GIRAFFE.busy = false
		return
	end

	local holdPosition = root.Position
	local lastFood = character:GetAttribute("Food") or 0
	local lastProgressAt = tick()
	local startedAt = tick()
	local nextStateAt = 0
	local nextKeyAt = 0
	local sawEatPrompt = false
	local progressEver = false

	GIRAFFE.lastFood = lastFood
	GIRAFFE.lastProgressAt = lastProgressAt

	while state.alive and tick() - startedAt < 35 do
		if cancelled() then break end

		character, root = characterParts()
		if not character or not root then break end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then break end

		-- Water always wins over feeding.
		if humanoid:GetState() == Enum.HumanoidStateType.Swimming
			or isPositionUnderwater(root.Position) then
			runtimeMessage = "Giraffe: tree position entered water; aborting leaf feed"
			break
		end

		-- CRITICAL tree depletion check:
		-- switch ONLY when every BasePart under this tree's Leaves is transparent.
		local currentLeaf, currentInfo, currentApproach = giraffeBestReachableLeaf(
			selected.tree,
			character,
			root
		)

		if not currentInfo then
			runtimeMessage = "Giraffe: tree lost its Leaves model; selecting another tree"
			GIRAFFE.clearTarget()
			break
		end

		if currentInfo.depleted then
			runtimeMessage = "Giraffe: all Leaves meshes reached Transparency 1; switching tree"
			GIRAFFE.clearTarget()
			break
		end

		if not currentLeaf then
			giraffeIgnoreTree(selected.tree, 75)
			runtimeMessage = "Giraffe: visible leaves remain, but none are within reach; switching tree"
			GIRAFFE.clearTarget()
			break
		end

		-- Individual leaf meshes disappear while the tree is consumed.
		-- Update the target INSIDE the same tree instead of switching trees.
		if currentLeaf and currentLeaf ~= GIRAFFE.targetLeafPart then
			GIRAFFE.targetLeafPart = currentLeaf
			selected.leafPart = currentLeaf
			selected.approach = currentApproach
		end

		local currentFood = character:GetAttribute("Food") or 0
		local targetFood = (
			state.autoQuests
			and state.questGiraffeFeeding
			and not preSwitchFoodTarget
		) and 100 or (preSwitchFoodTarget or 92)

		if currentFood >= targetFood then
			runtimeMessage = "Giraffe finished feeding from tree leaves"
			break
		end

		if currentFood > lastFood + 0.01 then
			lastFood = currentFood
			lastProgressAt = tick()
			progressEver = true
			GIRAFFE.lastFood = currentFood
			GIRAFFE.lastProgressAt = lastProgressAt
			GIRAFFE.repositionAttempts = 0
		end

		local available = detectAvailableFood(character)
		if available == "Eat" then
			sawEatPrompt = true
		end

		-- Hold near THIS tree. Never chase a different tree just because the
		-- current leaf mesh disappeared; currentLeaf above keeps us on the tree.
		root.AssemblyLinearVelocity = Vector3.new(
			0,
			root.AssemblyLinearVelocity.Y,
			0
		)

		if (root.Position - holdPosition).Magnitude > 6 then
			root.CFrame = CFrame.lookAt(
				holdPosition,
				Vector3.new(
					GIRAFFE.targetLeafPart.Position.X,
					holdPosition.Y,
					GIRAFFE.targetLeafPart.Position.Z
				),
				Vector3.yAxis
			)
		end

		if RAGDOLL_STATES[humanoid:GetState()] then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end

		if tick() >= nextStateAt then
			nextStateAt = tick() + 0.45
			setSubState("Eating")
		end

		-- Press E only when the game explicitly offers Eat. This avoids
		-- accidentally toggling Eating OFF while "Click E to stop eating" is up.
		if available == "Eat" and tick() >= nextKeyAt then
			nextKeyAt = tick() + 1.0
			giraffeTapEatKey()
		end

		-- No Food progress does NOT immediately switch trees.
		-- First verify the Leaves meshes, then reposition around the SAME tree.
		if tick() - lastProgressAt >= 6.5 then
			local verifyLeaf, verifyInfo, verifyApproach = giraffeBestReachableLeaf(
				selected.tree,
				character,
				root,
				GIRAFFE.repositionAttempts + 1
			)

			if verifyInfo and verifyInfo.depleted then
				runtimeMessage = "Giraffe: verified all Leaves depleted; switching tree"
				GIRAFFE.clearTarget()
				break
			end

			if verifyInfo and not verifyInfo.depleted and not verifyLeaf then
				giraffeIgnoreTree(selected.tree, 75)
				runtimeMessage = "Giraffe: remaining leaves are too high; switching tree"
				GIRAFFE.clearTarget()
				break
			end

			GIRAFFE.repositionAttempts += 1

			if GIRAFFE.repositionAttempts <= 3
				and verifyLeaf then

				selected.leafPart = verifyLeaf
				selected.approach = verifyApproach
				GIRAFFE.targetLeafPart = verifyLeaf

				runtimeMessage = string.format(
					"Giraffe: leaves remain; repositioning on same tree (%d/3)",
					GIRAFFE.repositionAttempts
				)

				giraffeApproachLockedTree(
					selected,
					GIRAFFE.repositionAttempts
				)
				task.wait(0.35)

				character, root = characterParts()
				if not character or not root then break end

				holdPosition = root.Position
				lastProgressAt = tick()
				nextStateAt = 0
				nextKeyAt = 0
			else
				-- Leaves are still visible, so this tree is NOT considered
				-- depleted. Temporarily skip only after several failed angles.
				giraffeIgnoreTree(selected.tree, 45)
				runtimeMessage = "Giraffe: leaves still visible but interaction stalled; temporarily skipping this tree"
				GIRAFFE.clearTarget()
				break
			end
		end

		runtimeMessage = string.format(
			"Giraffe eating tree leaves - Food %d%%",
			math.floor(currentFood)
		)

		task.wait(0.20)
	end

	character, root = characterParts()
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	local foodAfter = character and (character:GetAttribute("Food") or 0) or 0
	local targetFood = (
		state.autoQuests
		and state.questGiraffeFeeding
		and not preSwitchFoodTarget
	) and 100 or (preSwitchFoodTarget or 92)

	if foodAfter >= targetFood then
		GIRAFFE.clearTarget()
	elseif GIRAFFE.targetTree and GIRAFFE.targetTree.Parent then
		local finalLeaf, finalInfo = giraffeBestReachableLeaf(
			GIRAFFE.targetTree,
			character,
			root
		)

		if finalInfo and finalInfo.depleted then
			runtimeMessage = "Giraffe: current tree exhausted; next feed will use another tree"
			GIRAFFE.clearTarget()
		elseif finalInfo and not finalInfo.depleted and not finalLeaf then
			giraffeIgnoreTree(GIRAFFE.targetTree, 75)
			runtimeMessage = "Giraffe: remaining tree leaves are outside reach; selecting another tree"
			GIRAFFE.clearTarget()
		elseif not finalInfo then
			GIRAFFE.clearTarget()
		elseif progressEver then
			-- Keep the same tree locked if it did feed and still has leaves.
			-- The next pass continues here instead of choosing a closer tree.
			GIRAFFE.targetStartedAt = GIRAFFE.targetStartedAt > 0
				and GIRAFFE.targetStartedAt
				or tick()
		elseif not sawEatPrompt and GIRAFFE.repositionAttempts >= 3 then
			giraffeIgnoreTree(GIRAFFE.targetTree, 45)
			GIRAFFE.clearTarget()
		end
	end

	GIRAFFE.busy = false
end


