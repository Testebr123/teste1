local function updateSwimBarrier(root, resetAnchor)
	if not swimBarrier then
		swimBarrier = Instance.new("Folder")
		swimBarrier.Name = "FarmLocalSwimBarrier"
		swimBarrier.Parent = workspace
		for index = 1, 4 do
			local wall = Instance.new("Part")
			wall.Name = "Wall" .. index
			wall.Anchored = true
			wall.CanCollide = true
			wall.CanTouch = false
			wall.CanQuery = false
			wall.Transparency = 1
			wall.Parent = swimBarrier
		end
	end
	if resetAnchor or not swimAnchorPosition then swimAnchorPosition = root.Position end
	local center = Vector3.new(swimAnchorPosition.X, root.Position.Y, swimAnchorPosition.Z)
	local walls = swimBarrier:GetChildren()
	if #walls >= 4 then
		walls[1].Size, walls[1].CFrame = Vector3.new(16,18,2), CFrame.new(center + Vector3.new(0,0,7))
		walls[2].Size, walls[2].CFrame = Vector3.new(16,18,2), CFrame.new(center + Vector3.new(0,0,-7))
		walls[3].Size, walls[3].CFrame = Vector3.new(2,18,16), CFrame.new(center + Vector3.new(7,0,0))
		walls[4].Size, walls[4].CFrame = Vector3.new(2,18,16), CFrame.new(center + Vector3.new(-7,0,0))
	end
end

-- Crocodile: rota exclusiva de bebida pela margem.
-- MainWaterPart cobre uma area enorme e continua por baixo do Terrain.
-- Por isso NAO procuramos "onde existe agua" no X/Z: ela existe praticamente
-- em todo lugar. A margem e encontrada comparando o topo do Terrain SOLIDO
-- com a altura da superficie da MainWaterPart. Enquanto o Terrain estiver
-- acima da agua, ela esta enterrada e e ignorada. Quando o Terrain desce para
-- baixo do nivel da agua, aquela agua passa a estar exposta.
CROC.solidTerrainParams = RaycastParams.new()
CROC.solidTerrainParams.FilterType = Enum.RaycastFilterType.Include
CROC.solidTerrainParams.FilterDescendantsInstances = { workspace.Terrain }
CROC.solidTerrainParams.IgnoreWater = true
CROC.lastShoreDirection = nil
CROC.lastShorePosition = nil

function CROC.findPrideRockSpawn1()
	local spawns = workspace:FindFirstChild("Spawns")
	if not spawns then return nil end
	local part = spawns:FindFirstChild("PrideRockSpawn1", true)
	if part and part:IsA("BasePart") then return part end
	return nil
end

function CROC.getWaterSurfaceY()
	local waterPart = workspace:FindFirstChild("MainWaterPart")
	if not waterPart or not waterPart:IsA("BasePart") then return nil, nil end
	return waterPart.Position.Y + waterPart.Size.Y / 2, waterPart
end

function CROC.solidTerrainHitAt(position, castY)
	return workspace:Raycast(
		Vector3.new(position.X, castY, position.Z),
		Vector3.new(0, -1200, 0),
		CROC.solidTerrainParams
	)
end

function CROC.findVisibleShoreFrom(origin)
	local waterY = CROC.getWaterSurfaceY()
	if not waterY then return nil end

	local castY = math.max(origin.Y, waterY) + 350
	local maxRadius = 900
	local step = 5
	local directions = 72
	local exposureDepth = 0.75
	local bestPosition, bestDirection, bestDistance

	local function waterIsExposedAt(position)
		local hit = CROC.solidTerrainHitAt(position, castY)
		-- Sem Terrain solido acima/na superficie = agua visivel.
		if not hit then return true, nil end
		return hit.Position.Y <= waterY - exposureDepth, hit
	end

	for index = 0, directions - 1 do
		local angle = index / directions * math.pi * 2
		local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local lastDryDistance = nil
		local lastDryHit = nil

		for distance = 0, maxRadius, step do
			local probe = origin + direction * distance
			local exposed, hit = waterIsExposedAt(probe)

			if exposed then
				if lastDryDistance and lastDryHit then
					-- Refina a transicao terra -> agua para achar a margem real.
					local low = lastDryDistance
					local high = distance
					for _ = 1, 8 do
						local mid = (low + high) / 2
						local midExposed = waterIsExposedAt(origin + direction * mid)
						if midExposed then
							high = mid
						else
							low = mid
						end
					end

					-- Fica um pouco ANTES do inicio da agua. Assim o corpo permanece
					-- no Terrain, mas a cabeca fica perto o bastante para beber.
					local shoreDistance = math.max(0, low - 1.25)
					local shoreProbe = origin + direction * shoreDistance
					local shoreHit = CROC.solidTerrainHitAt(shoreProbe, castY) or lastDryHit

					if shoreHit and (not bestDistance or shoreDistance < bestDistance) then
						bestDistance = shoreDistance
						bestPosition = shoreHit.Position
						bestDirection = direction
					end
				end
				break
			end

			lastDryDistance = distance
			lastDryHit = hit
		end
	end

	return bestPosition, bestDirection, bestDistance
end

function CROC.teleportToPrideRock(prideRock)
	if state.busy then return false end
	state.busy = true
	local character, root, humanoid = characterParts()
	if not character or not root or not humanoid then state.busy = false return false end

	local target = prideRock.Position + Vector3.new(0, math.max(humanoid.HipHeight, 2) + 2, 0)
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	for _ = 1, 45 do
		if not character.Parent or not root.Parent then break end
		character:PivotTo(CFrame.new(target) * prideRock.CFrame.Rotation)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		RunService.Heartbeat:Wait()
	end
	if humanoid.Parent then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
	for _ = 1, 4 do
		if not character.Parent then break end
		character:SetAttribute("MovementDisabled", false)
		task.wait(0.08)
	end
	state.busy = false
	return root.Parent and (root.Position - target).Magnitude <= 18
end

function CROC.approachDrink()
	if state.questGrowthReset.exclusive then return false end
	if CROC.approachBusy or criticalRecoveryActive then return false end
	local character = player.Character
	if not character or not CROC.isCharacter(character) then return false end

	CROC.approachBusy = true
	removeSwimBarrier()
	drinkingSourcePosition = nil
	CROC.lastShoreDirection = nil
	CROC.lastShorePosition = nil

	-- Para o Croco a agua fica colidivel. A diferenca agora e que ele NAO e
	-- teleportado para ela: sai do PrideRock e chega fisicamente ate a margem.
	local _, waterPart = CROC.getWaterSurfaceY()
	if waterPart then waterPart.CanCollide = true end

	local prideRock = CROC.findPrideRockSpawn1()
	if not prideRock then
		runtimeMessage = "Croco: PrideRockSpawn1 nao encontrado"
		CROC.approachBusy = false
		return false
	end

	local _, currentRoot = characterParts()
	local prideDistance = currentRoot and (currentRoot.Position - prideRock.Position).Magnitude or math.huge
	if prideDistance > 28 then
		runtimeMessage = "Croco: TP -> PrideRockSpawn1"
		if not CROC.teleportToPrideRock(prideRock) then
			runtimeMessage = "Croco: falhou TP PrideRockSpawn1"
			CROC.approachBusy = false
			return false
		end
	else
		runtimeMessage = "Croco: ja esta no PrideRockSpawn1"
	end

	task.wait(0.2)
	character, root = characterParts()
	if not character or not root or not CROC.isCharacter(character) then
		CROC.approachBusy = false
		return false
	end

	runtimeMessage = "Croco: procurando onde a agua sai do Terrain"
	local shorePosition, shoreDirection, shoreDistance = CROC.findVisibleShoreFrom(root.Position)
	if not shorePosition then
		runtimeMessage = "Croco: nao achei transicao Terrain -> agua"
		CROC.approachBusy = false
		return false
	end

	CROC.lastShoreDirection = shoreDirection
	CROC.lastShorePosition = shorePosition
	runtimeMessage = string.format("Croco: margem a %d studs; indo ate ela", math.floor(shoreDistance or 0))

	-- Croco anda com metade da velocidade normal para evitar o limitador do jogo.
	local moved = moveToGrass(shorePosition, 27.5)
	task.wait(0.25)
	character, root = characterParts()
	if character and root and CROC.isCharacter(character) then
		drinkingSourcePosition = root.Position
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		runtimeMessage = "Croco: na margem; bebendo"
		for _ = 1, 5 do
			setSubState("Drinking")
			task.wait(0.2)
		end
	end

	CROC.approachBusy = false
	return moved
end

