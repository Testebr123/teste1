local function forcePostDrinkMove(wasUnderground)
	if forcingPostDrinkMove then return end

	forcingPostDrinkMove = true
	criticalRecoveryActive = true

	-- Hard lock before the drinking state is released.
	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil
	if state.questSetW then
		state.questSetW(false)
	end

	state.releaseMovementNow(
		player.Character,
		true
	)

	runtimeMessage = wasUnderground
		and "Agua cheia; SAINDO de baixo do Terrain antes de liberar Auto Run"
		or "Agua cheia; saindo da agua antes de liberar quests"

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	local aquaticExit = isAquaticCharacter(player.Character)
	if waterPart and waterPart:IsA("BasePart") then
		waterPart.CanCollide = aquaticExit == true
	end

	local function confirmedOutside()
		local character, root = characterParts()
		if not character or not root then return false end

		if state.isBodyActuallyInWater(
			character,
			root
		) then
			return false
		end

		return state.normalizeDryLandState(
			character,
			root
		)
	end

	-- If the animal already reached dry ground through normal physics,
	-- stop the water-exit controller immediately.
	if confirmedOutside() then
		state.drinkClearUndergroundMode()
		resetEatingSearch(nil)
		drinkingSourcePosition = nil

		local dryCharacter =
			player.Character

		if dryCharacter
			and isAquaticCharacter(
				dryCharacter
			) then

			setAquaticWaterCollision(
				dryCharacter,
				false
			)
		end

		state.releaseMovementNow(
			dryCharacter,
			true
		)

		criticalRecoveryActive = false
		forcingPostDrinkMove = false
		state.questForceFastRecheckUntil =
			tick() + 25

		runtimeMessage =
			"Dry Terrain + body outside water confirmed; quests resumed"
		return
	end

	local escaped = false

	if isDinoLife then
		local _, root = characterParts()

		if root and root.Position.Y < config.dangerY then
			escaped = escapeDinoToSafety("void depois de beber")
		else
			local nestRock1 = findNestRock1()

			if nestRock1 then
				escaped = ensureOnSolidGround(
					nestRock1.Position,
					"NestRock1 (saindo da agua)"
				)
			elseif root then
				for _, spawnPart in ipairs(DAMAGE.getNearestSafeSpawns(root)) do
					if ensureOnSolidGround(
						spawnPart.Position,
						spawnPart.Name .. " (saindo da agua)"
					) then
						escaped = true
						break
					end
				end
			end
		end
	else
		local aquaticCharacter, aquaticRoot = characterParts()
		if aquaticCharacter and aquaticRoot and isAquaticCharacter(aquaticCharacter) then
			runtimeMessage = "Aquatic exit: finding verified dry Terrain"
			escaped = state.moveAquaticToDryTerrain(aquaticCharacter, aquaticRoot)
		end

		if not escaped then refreshCompletionSpawns() end

		local candidates = {}
		local _, root = characterParts()

		-- Nearest dry bank first. Do not march to a distant spawn when the
		-- shoreline is physically reachable right beside the animal.
		if root then
			local localExit =
				state.findNearestDryWaterExit(root)

			if localExit then
				table.insert(
					candidates,
					localExit
				)
			end
		end

		-- Never inherit a manual Move To destination during automatic safety exit.

		if root then
			for _, part in ipairs(
				DAMAGE.getNearestSafeSpawns(
					root,
					DAMAGE.maxEmergencySpawnDistance
				)
			) do
				table.insert(candidates, part.Position)
			end
		end

		for _, position in ipairs(candidates) do
			if escaped then break end
			if ensureOnSolidGround(
				position,
				wasUnderground
					and "terra firme ACIMA do Terrain"
					or "ponto de saida da agua"
			) then
				escaped = true
				break
			end
		end
	end

	resetEatingSearch(nil)
	drinkingSourcePosition = nil

	-- Final independent proof. Reaching a target is not enough.
	if escaped and confirmedOutside() then
		state.drinkClearUndergroundMode()
		local dryCharacter = player.Character
		if dryCharacter and isAquaticCharacter(dryCharacter) then setAquaticWaterCollision(dryCharacter, false) end
		state.releaseMovementNow(dryCharacter, true)

		criticalRecoveryActive = false
		forcingPostDrinkMove = false
		state.questForceFastRecheckUntil = tick() + 25

		runtimeMessage = wasUnderground
			and "Saiu do Terrain CONFIRMADO; Auto Run liberado"
			or "Saiu da agua; quests liberadas"
		return
	end

	-- One last strict dry-ground proof before escalating.
	if confirmedOutside() then
		state.drinkClearUndergroundMode()
		local dryCharacter = player.Character
		if dryCharacter and isAquaticCharacter(dryCharacter) then setAquaticWaterCollision(dryCharacter, false) end
		state.releaseMovementNow(dryCharacter, true)
		criticalRecoveryActive = false
		forcingPostDrinkMove = false
		state.questForceFastRecheckUntil =
			tick() + 25

		runtimeMessage =
			"Body outside water + dry Terrain confirmed; quests resumed"
		return
	end

	forcingPostDrinkMove = false

	local liveCharacter, liveRoot = characterParts()
	state.releaseMovementNow(liveCharacter, true)
	if liveCharacter and isAquaticCharacter(liveCharacter) then
		setAquaticWaterCollision(liveCharacter, true)
	end

	if liveCharacter and liveRoot then
		state.drinkEmergencyEscape(
			liveCharacter,
			liveRoot,
			"Post-drink still unsafe after strict ground check"
		)
	else
		criticalRecoveryActive = false
	end
end

function state.noIdleWaterSafetyStep()
	if not state.alive
		or state.questGrowthReset.exclusive
		or state.questSwimActive
		or drinkingToFull
		or forcingPostDrinkMove
		or criticalRecoveryActive
		or state.busy
		or DAMAGE.active then
		return
	end

	local character, root, humanoid =
		characterParts()

	if not character
		or not root
		or not humanoid
		or humanoid.Health <= 0 then
		return
	end

	-- Crocodile AND Hippo use the same verified dry-Terrain extraction used
	-- after drinking. Other aquatic animals may remain in water normally.
	if isAquaticCharacter(character)
		and not state.isCrocOrHippoMovementCharacter(
			character
		) then

		return
	end

	if not state.isBodyActuallyInWater(
		character,
		root
	) then
		return
	end

	state.noIdleWaterLastAt =
		state.noIdleWaterLastAt or 0

	if tick() - state.noIdleWaterLastAt < 2.0 then
		return
	end

	state.noIdleWaterLastAt = tick()

	-- Immediately clear any idle/feeding ownership that could keep the animal
	-- stationary in the puddle.
	eatingToFull = false
	eatingSourcePosition = nil
	eatingTargetReachedAt = nil
	activeCarcass = nil
	state.questCarnivoreFeeding = false
	state.questBaboonFeeding = false
	state.questGiraffeFeeding = false
	BABOON.cancel()
	GIRAFFE.cancel()

	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil

	if state.questSetW then
		state.questSetW(false)
	end

	runtimeMessage =
		CROC.isCharacter(character)
			and "Croc water safety: forcing verified dry Terrain exit"
			or (
				state.safeMovementAnimalKey(character) == "hippo"
					and "Hippo water safety: forcing verified dry Terrain exit"
					or "Water safety: animal is still inside water; moving to dry bank"
			)

	task.spawn(
		forcePostDrinkMove,
		false
	)
end

task.spawn(function()
	while state.alive do
		pcall(
			state.noIdleWaterSafetyStep
		)
		task.wait(0.40)
	end
end)

local drinkingStuckSince
-- Segura a posição com alta frequência enquanto bebe no Dino Life. O
-- autoDrinkStep só roda 1x/segundo — frequência baixa demais pra evitar o
-- jitter físico de ficar em pé numa água com CanCollide=true (que estava
-- causando dano de queda). Essa rotina corrige a cada 0.25s até encher.
local dinoDrinkHoldBusy = false
local function holdDinoDrinkPosition(targetPosition)
	if dinoDrinkHoldBusy then return end
	dinoDrinkHoldBusy = true

	local promptMissingSince = nil
	local anchorXZ = nil

	while drinkingToFull and state.autoDrink and not criticalRecoveryActive do
		local character, root, humanoid = characterParts()
		if not character or not root or not humanoid then break end

		local water = character:GetAttribute("Water") or 100
		if water >= (preSwitchWaterTarget or 98) then break end

		local detected = detectAvailableFood(character)

		if detected == "Drink" then
			-- Posição válida não significa orientação segura.
			-- Corrige ragdoll invertido antes de segurar a posição.
			promptMissingSince = nil

			if state.drinkIsUpsideDown(root) then
				state.drinkUprightCharacter(character, root, nil)
			end

			if not anchorXZ then
				anchorXZ = Vector3.new(root.Position.X, 0, root.Position.Z)
			end
			drinkingSourcePosition = root.Position
			runtimeMessage = "Dino: prompt detectado; bebendo"

			local velocity = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(0, math.clamp(velocity.Y, -2, 2), 0)
			root.AssemblyAngularVelocity = Vector3.zero

			-- Só segura X/Z se escorregar bastante. O Y atual é SEMPRE preservado,
			-- eliminando o efeito de ficar flickando para cima/baixo.
			if anchorXZ then
				local horizontalOffset = Vector3.new(
					root.Position.X - anchorXZ.X,
					0,
					root.Position.Z - anchorXZ.Z
				)
				if horizontalOffset.Magnitude > 3.5 then
					state.safeNudgeToward(
						root,
						Vector3.new(
							anchorXZ.X,
							root.Position.Y,
							anchorXZ.Z
						),
						0.22
					)
				end
			end

			character:SetAttribute("MovementDisabled", false)
			setSubState("Drinking")
		else
			-- O prompt pode piscar por alguns frames. Não move imediatamente.
			if not promptMissingSince then promptMissingSince = tick() end
			if tick() - promptMissingSince >= 1.5 then
				break
			end

			local velocity = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(0, math.clamp(velocity.Y, -2, 2), 0)
			root.AssemblyAngularVelocity = Vector3.zero
			setSubState("Drinking")
		end

		task.wait(0.15)
	end

	dinoDrinkHoldBusy = false
end

local lastDrinkWatchdogWater
local drinkPromptSustainBusy = false
local drinkPromptLastKickAt = 0

local function sustainDrinkAtCurrentPrompt()
	if drinkPromptSustainBusy then return end
	drinkPromptSustainBusy = true

	local lastWater
	local lastProgressAt = tick()
	local promptMissingSince

	while state.alive
		and state.autoDrink
		and drinkingToFull
		and not criticalRecoveryActive
		and not state.questGrowthReset.exclusive do

		local character, root, humanoid =
			characterParts()

		if not character
			or not root
			or not humanoid then
			break
		end

		local water =
			tonumber(
				character:GetAttribute("Water")
			) or 100

		local targetWater =
			preSwitchWaterTarget or 98

		if water >= targetWater then
			break
		end

		if lastWater == nil then
			lastWater = water
			lastProgressAt = tick()

		elseif water > lastWater + 0.01 then
			lastWater = water
			lastProgressAt = tick()
			drinkingStuckSince = tick()
			lastDrinkWatchdogWater = water

			state.drinkProgressConfirm(
				water
			)
		end

		local detected =
			detectAvailableFood(character)

		local visualDetected =
			state.drinkVisualPromptVisible
			and state.drinkVisualPromptVisible()

		local progressConfirmed =
			state.drinkProgress
			and state.drinkProgress.confirmed

		if detected == "Drink"
			or visualDetected
			or progressConfirmed then

			if visualDetected then
				state.drinkLatchVisualPrompt()
			end

			promptMissingSince = nil
			drinkingSourcePosition =
				drinkingSourcePosition
				or root.Position

			-- Once Water has increased, do not reposition/rotate/search.
			local velocity =
				root.AssemblyLinearVelocity

			root.AssemblyLinearVelocity =
				Vector3.new(
					0,
					math.clamp(
						velocity.Y,
						-3,
						3
					),
					0
				)

			if progressConfirmed then
				root.AssemblyAngularVelocity =
					Vector3.zero
			else
				root.AssemblyAngularVelocity =
					root.AssemblyAngularVelocity
					* 0.15
			end

			if state.questSetW then
				state.questSetW(false)
			end

			if not progressConfirmed
				and state.drinkIsUpsideDown(
					root
				) then

				state.drinkUprightCharacter(
					character,
					root,
					state.drinkSearch.currentWaterPoint
				)
			end

			if isAquaticCharacter(character) then
				setAquaticWaterCollision(
					character,
					true
				)
			end

			blockClientSubState = false
			setSubState("Drinking")
			blockClientSubState = false

			local stalledFor =
				tick() - lastProgressAt

			if progressConfirmed then
				stalledFor =
					tick()
					- (
						state.drinkProgress.lastProgressAt
						or lastProgressAt
					)
			end

			-- The server sub-state remote is sufficient. Never press E here:
			-- repeated visual toggles can cancel a valid drinking session.

			if progressConfirmed
				and stalledFor >= 5.0 then

				runtimeMessage =
					"Confirmed drink stopped for 5s; releasing source"

				state.drinkProgressReset()
				break
			end

			runtimeMessage =
				progressConfirmed
					and string.format(
						"Drinking confirmed (%d%% -> %d%%)",
						math.floor(water),
						math.floor(targetWater)
					)
					or string.format(
						"Starting drink (%d%% -> %d%%)",
						math.floor(water),
						math.floor(targetWater)
					)

		else
			if not promptMissingSince then
				promptMissingSince = tick()
			end

			-- Before Water has ever increased, the bank may really be invalid.
			if tick() - promptMissingSince >= 1.8 then
				break
			end

			setSubState("Drinking")
		end

		task.wait(0.16)
	end

	local liveCharacter = player.Character

	if liveCharacter
		and isAquaticCharacter(liveCharacter) then
		-- Do not create a one-frame sink window between drinking and dry exit.
		setAquaticWaterCollision(liveCharacter, true)
	end

	drinkPromptSustainBusy = false
end

function state.drinkEmergencyEscape(character, root, reason)
	state.drinkProgressReset()

	if not character or not root then return false end

	local badPoint = state.drinkSearch.currentWaterPoint
		or drinkingSourcePosition
		or root.Position

	state.drinkMarkFailed(badPoint, 300)

	-- These are now the REAL locals, not accidental globals.
	criticalRecoveryActive = true
	drinkingToFull = false
	drinkingSourcePosition = nil
	drinkingStuckSince = nil
	lastDrinkWatchdogWater = nil

	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil
	if state.questSetW then state.questSetW(false) end

	state.drinkSearch.currentWaterPoint = nil
	state.drinkSearch.failedCount = 0
	state.drinkSearch.retryAfter = tick() + 8
	state.drinkSearch.upsideDownSince = nil
	state.drinkSearch.waterHealth = nil
	state.drinkSearch.waterHealthAt = 0

	removeSwimBarrier()

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	if waterPart and waterPart:IsA("BasePart") then
		waterPart.CanCollide = isAquaticCharacter(character)
	end

	runtimeMessage = reason or "ANTI-AFOGAMENTO: escapando para cima do Terrain"

	if isAquaticCharacter(
		character
	) and state.moveAquaticToDryTerrain then

		local aquaticEscaped =
			state.moveAquaticToDryTerrain(
				character,
				root
			)

		if aquaticEscaped then
			setAquaticWaterCollision(
				character,
				false
			)

			state.releaseMovementNow(
				character,
				true
			)

			state.drinkClearUndergroundMode()
			criticalRecoveryActive = false
			state.questForceFastRecheckUntil =
				tick() + 25

			runtimeMessage =
				"Aquatic safety: verified dry Terrain confirmed"

			return true
		end

		setAquaticWaterCollision(
			character,
			true
		)
	end

	local function confirmedAboveTerrain()
		local _, liveRoot = characterParts()
		if not liveRoot then return false end
		if liveRoot.Position.Y < config.dangerY then return false end
		if isStandingInWater(liveRoot) then return false end
		if not isDinoLife and state.drinkIsBuriedUnderTerrain(liveRoot) then
			return false
		end
		return true
	end

	refreshCompletionSpawns()

	local candidates = {}
	local _, liveRoot = characterParts()

	-- Emergency escape never inherits a manual Move To selection.

	if liveRoot then
		local localExit =
			state.findNearestDryWaterExit
			and state.findNearestDryWaterExit(liveRoot)

		if localExit then
			local localDistance = Vector3.new(
				localExit.X - liveRoot.Position.X,
				0,
				localExit.Z - liveRoot.Position.Z
			).Magnitude

			if localDistance <= (DAMAGE.localEscapeRadius or 170) then
				table.insert(candidates, localExit)
			end
		end

		for _, part in ipairs(
			DAMAGE.getNearestSafeSpawns(
				liveRoot,
				DAMAGE.maxEmergencySpawnDistance
			)
		) do
			table.insert(candidates, part.Position)
		end
	end

	if #candidates == 0 then
		local localCharacter, localRoot = characterParts()
		if localCharacter and localRoot
			and DAMAGE.tryLocalDryEscape(
				localCharacter,
				localRoot,
				"ANTI-AFOGAMENTO: procurando Terrain seco local"
			) then
			state.drinkClearUndergroundMode()
			criticalRecoveryActive = false
			state.questForceFastRecheckUntil = tick() + 25
			return true
		end
	end

	for round = 1, 3 do
		for _, position in ipairs(candidates) do
			runtimeMessage = string.format(
				"ANTI-AFOGAMENTO: tentando sair do Terrain (%d/3)",
				round
			)

			local _, escapeRoot = characterParts()
			local needsVertical =
				escapeRoot
				and (
					escapeRoot.Position.Y < config.dangerY
					or (
						not isDinoLife
						and state.drinkIsBuriedUnderTerrain(escapeRoot)
					)
				)
				or false

			safeMoveToPosition(
				position,
				7,
				nil,
				{
					purpose = "safety",
					tolerance = 20,
					vertical = needsVertical,
					forceMoveToLand = not needsVertical,
					constantSpeed = not needsVertical,
					maxDuration = 300,
				}
			)
			task.wait(0.35)

			if confirmedAboveTerrain() then
				state.drinkClearUndergroundMode()

				local safeCharacter =
					player.Character

				if safeCharacter
					and isAquaticCharacter(
						safeCharacter
					) then
					setAquaticWaterCollision(
						safeCharacter,
						false
					)
				end

				state.releaseMovementNow(
					safeCharacter,
					true
				)

				criticalRecoveryActive = false
				state.questForceFastRecheckUntil = tick() + 25
				runtimeMessage = "ANTI-AFOGAMENTO: ACIMA do Terrain confirmado"
				return true
			end
		end

		if DAMAGE and type(DAMAGE.moveToSafety) == "function" then
			pcall(DAMAGE.moveToSafety)
			task.wait(0.45)

			if confirmedAboveTerrain() then
				state.drinkClearUndergroundMode()

				local safeCharacter =
					player.Character

				if safeCharacter
					and isAquaticCharacter(
						safeCharacter
					) then
					setAquaticWaterCollision(
						safeCharacter,
						false
					)
				end

				state.releaseMovementNow(
					safeCharacter,
					true
				)

				criticalRecoveryActive = false
				state.questForceFastRecheckUntil = tick() + 25
				runtimeMessage = "ANTI-AFOGAMENTO: spawn seguro confirmado"
				return true
			end
		end
	end

	-- Keep the lock and retry. Do NOT resume movement under Terrain.
	runtimeMessage = "CRITICO: ainda sob Terrain; Auto Run BLOQUEADO; repetindo escape"

	mmbTaskDelay(1.0, function()
		if not state.alive then return end

		local liveCharacter, retryRoot = characterParts()
		if liveCharacter and retryRoot then
			state.drinkEmergencyEscape(
				liveCharacter,
				retryRoot,
				"Repetindo escape anti-afogamento"
			)
		else
			criticalRecoveryActive = false
		end
	end)

	return false
end


function state.drinkTestRestoreEnvironment()
	local test = state.drinkTest

	local character =
		test.character

	if character and character.Parent then
		local humanoid =
			character:FindFirstChildOfClass(
				"Humanoid"
			)

		if humanoid then
			state.drinkTestSetTransitPhysics(
				character,
				humanoid,
				false
			)
		end

		state.drinkTestGhostCharacter(
			character,
			false
		)
	else
		test.collisionSnapshot = nil
		test.humanoidSnapshot = nil
	end

	local waterPart =
		test.waterPart

	if waterPart
		and waterPart.Parent
		and test.waterPartCanCollide ~= nil then

		pcall(function()
			waterPart.CanCollide =
				test.waterPartCanCollide == true
		end)
	end

	if DAMAGE
		and test.savedDamageCooldown ~= nil then

		DAMAGE.cooldownUntil =
			math.max(
				tonumber(
					test.savedDamageCooldown
				) or 0,
				tick() + 2
			)
	end

	state.drinkClearUndergroundMode()
	state.drinkProgressReset()

	state.drinkSearch.currentWaterPoint = nil
	state.drinkSearch.waterHealth = nil
	state.drinkSearch.waterHealthAt = 0
	state.drinkSearch.undergroundLastWater = nil
	state.drinkSearch.undergroundLastProgressAt = 0

	test.character = nil
	test.entryPosition = nil
	test.entryZone = nil
	test.undergroundSpot = nil
	test.surfaceExit = nil
	test.surfaceY = nil
	test.startHealth = nil
	test.startWater = nil
	test.waterPart = nil
	test.waterPartCanCollide = nil
	test.savedDamageCooldown = nil
	test.emergencyFallback = false
	test.hardExitBusy = false

	state.drinkTestDisableSelfDamageGuard()

	-- Never leave the normal Savannah sub-state remote blocked after a drink
	-- transaction. A stale block can prevent later Eat/Drink sessions.
	blockClientSubState = false
end

-- Absolute anti-drowning fallback for the underground route.
-- This is intentionally stronger than normal navigation: if the controlled
-- vertical exit ever fails, preserving the slot has priority over route style.
function state.drinkTestHardEject(reason)
	local test = state.drinkTest

	if test.hardExitBusy then
		return state.drinkTestAboveTerrainConfirmed()
	end

	test.hardExitBusy = true
	criticalRecoveryActive = true

	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil

	if state.questSetW then
		pcall(state.questSetW, false)
	end

	if state.safeMove and state.safeMove.active then
		state.safeMove.cancelToken += 1
	end

	local character, root, humanoid =
		characterParts()

	if not character
		or not root
		or not humanoid
		or humanoid.Health <= 0 then
		test.hardExitBusy = false
		return false
	end

	-- If the old transaction belongs to a character that has already been
	-- replaced, there is nothing useful to rescue in that transaction.
	if test.character
		and character ~= test.character then
		test.hardExitBusy = false
		return false
	end

	test.character = character

	state.drinkTestSetPhase(
		"hard_exit",
		"ANTI-DROWNING: forcing immediate exit above Terrain"
			.. (
				reason
					and (" (" .. tostring(reason) .. ")")
					or ""
			)
	)

	-- Keep every character part non-collidable while crossing Terrain.
	state.drinkTestGhostCharacter(
		character,
		true
	)

	if test.waterPart
		and test.waterPart.Parent then
		pcall(function()
			test.waterPart.CanCollide = false
		end)
	end

	character:SetAttribute(
		"MovementDisabled",
		true
	)

	state.drinkTestSetTransitPhysics(
		character,
		humanoid,
		true
	)

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	local rotation =
		root.CFrame.Rotation

	local function placeAndHold(position, frames)
		if typeof(position) ~= "Vector3" then
			return false
		end

		for _ = 1, (frames or 8) do
			character, root, humanoid =
				characterParts()

			if not character
				or not root
				or not humanoid
				or humanoid.Health <= 0 then
				return false
			end

			state.drinkTestGhostCharacter(
				character,
				true
			)

			state.drinkTestMaintainTransit(
				character,
				root,
				humanoid
			)

			root.CFrame =
				CFrame.new(position)
				* rotation

			root.AssemblyLinearVelocity =
				Vector3.zero

			root.AssemblyAngularVelocity =
				Vector3.zero

			RunService.Heartbeat:Wait()
		end

		return true
	end

	-- First choice is ALWAYS a straight vertical ejection at the same X/Z.
	local surfaceExit =
		test.surfaceExit

	local surfaceY =
		tonumber(test.surfaceY)

	local current =
		root.Position

	local exitX =
		typeof(surfaceExit) == "Vector3"
			and surfaceExit.X
			or current.X

	local exitZ =
		typeof(surfaceExit) == "Vector3"
			and surfaceExit.Z
			or current.Z

	local standClearance =
		math.clamp(
			state.movementRootClearance(character) + 1.25,
			3.5,
			11
		)

	local surfaceBaseY =
		surfaceY
			or (
				typeof(surfaceExit) == "Vector3"
					and (surfaceExit.Y - standClearance - 2)
					or nil
			)

	-- Restore normal physics only when the HRP is already at a real standing
	-- height. The old +28 exit created its own fall after every underground drink.
	local verticalY =
		typeof(surfaceBaseY) == "number"
			and (surfaceBaseY + standClearance)
			or (current.Y + standClearance + 8)

	placeAndHold(
		Vector3.new(
			exitX,
			verticalY,
			exitZ
		),
		10
	)

	local confirmed =
		state.drinkTestAboveTerrainConfirmed()

	-- If Roblox/server correction defeated the vertical ejection, return to
	-- the exact pre-descent position. This is a safety-only last resort.
	if not confirmed
		and typeof(test.entryPosition) == "Vector3" then

		local entryTarget =
			test.entryPosition
				+ Vector3.new(
					0,
					0.75,
					0
				)

		placeAndHold(
			entryTarget,
			12
		)

		confirmed =
			root.Position.Y >= config.dangerY
			and not state.drinkIsBuriedUnderTerrain(
				root
			)
	end

	-- Final failsafe for Savannah: the configured farm point is known dry land.
	-- This should almost never execute, but prevents a slot being sacrificed to
	-- a bad Terrain replication state.
	if not confirmed and isSavannahLife then
		local safe =
			getSafeFarmPosition()

		if typeof(safe) == "Vector3" then
			placeAndHold(
				safe
					+ Vector3.new(
						0,
						math.max(1.5, standClearance * 0.35),
						0
					),
				14
			)

			confirmed =
				root.Position.Y >= config.dangerY
				and not state.drinkIsBuriedUnderTerrain(
					root
				)
		end
	end

	if confirmed then
		-- Restore collision while Physics still owns the Humanoid, then give the
		-- game a few frames at zero velocity before re-enabling Freefall. This
		-- prevents the surface transition itself from registering as a landing.
		state.drinkTestGhostCharacter(
			character,
			false
		)

		for _ = 1, 4 do
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			RunService.Heartbeat:Wait()
		end

		state.drinkTestSetTransitPhysics(
			character,
			humanoid,
			false
		)

		character:SetAttribute(
			"MovementDisabled",
			false
		)

		root.AssemblyLinearVelocity =
			Vector3.zero

		root.AssemblyAngularVelocity =
			Vector3.zero

		blockClientSubState = false
	else
		-- Keep collision disabled and push upward instead of freezing the animal
		-- below Terrain. The caller will retry the emergency recovery.
		state.drinkTestGhostCharacter(
			character,
			true
		)

		root.AssemblyLinearVelocity =
			Vector3.new(
				0,
				math.max(
					35,
					state.safeMovementSpeed(character)
						* 0.75
				),
				0
			)
	end

	test.hardExitBusy = false
	return confirmed
end


function state.drinkTestEmergencySurfaceExit(reason)
	local test = state.drinkTest

	state.drinkTestSetPhase(
		"exit",
		reason
			and (
				"Underground Drink: immediate surface exit - "
				.. tostring(reason)
			)
			or "Underground Drink: immediate surface exit"
	)

	-- Do not spend extra time pathing while buried. The old controlled exit
	-- could retry several long smooth moves and leave the slot drowning below
	-- Terrain. Crossing upward is now an immediate anti-drowning transaction.
	return state.drinkTestHardEject(
		reason or "surface exit"
	)
end


function state.runUndergroundDrinkTest()
	local test = state.drinkTest

	if test.active then
		return
	end

	if forcingPostDrinkMove
		or state.questGrowthReset.exclusive
		or state.questGrowthReset.busy
		or DAMAGE.active then

		runtimeMessage =
			"Underground Drink unavailable: another safety/reset controller is active"

		return
	end

	local character, root, humanoid =
		characterParts()

	if not character
		or not root
		or not humanoid
		or humanoid.Health <= 0 then

		runtimeMessage =
			"Underground Drink: no valid character"

		return
	end

	test.active = true
	test.cancelRequested = false
	test.hardExitBusy = false
	test.phase = "prepare"
	test.startedAt = tick()
	test.character = character
	test.entryPosition = root.Position
	test.entryZone =
		state.questCurrentZoneName
			and state.questCurrentZoneName()
			or nil
	test.startHealth = humanoid.Health
	test.startWater =
		tonumber(
			character:GetAttribute("Water")
		) or 100
	test.lastError = nil
	test.lastResult = nil

	if DAMAGE then
		test.savedDamageCooldown =
			DAMAGE.cooldownUntil

		-- Test has a stricter internal health watchdog; prevent another safety
		-- controller from fighting the same movement.
		DAMAGE.cooldownUntil =
			math.max(
				DAMAGE.cooldownUntil or 0,
				tick() + 90
			)
	end

	-- Take ownership from any existing survival route.
	drinkingToFull = false
	drinkingSourcePosition = nil
	drinkingStuckSince = nil
	lastDrinkWatchdogWater = nil
	state.drinkProgressReset()

	if state.safeMove
		and state.safeMove.active then
		state.safeMove.cancelToken += 1
	end

	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil

	if state.questSetW then
		pcall(state.questSetW, false)
	end

	criticalRecoveryActive = true
	blockClientSubState = false

	-- Start every underground transaction with a full oxygen reserve. The global
	-- Oxygen Guard keeps it at 100 while the animal remains submerged.
	state.oxygenGuardApply(character)

	-- Enable before the first Y displacement so FallDamageHandler never records
	-- the scripted Terrain crossing as a real fall. The same scoped guard also
	-- prevents Oxygen self-damage while intentionally below Terrain.
	state.drinkTestEnableSelfDamageGuard(
		character
	)

	state.drinkTestRender()

	local ok, failure =
		xpcall(
			function()
				state.drinkTestSetPhase(
					"scan",
					"Underground Drink: finding local buried water"
				)

				local spot =
					state.drinkTestFindLocalSpot(
						root.Position,
						character
					)

				if not spot then
					error(
						"no local buried MainWaterPart found within 160 studs"
					)
				end

				test.undergroundSpot = spot
				test.surfaceExit = spot.exit
				test.surfaceY =
					spot.surfaceHit.Y
				test.waterPart =
					spot.waterPart
				test.waterPartCanCollide =
					spot.waterPart.CanCollide

				state.drinkSearch.currentWaterPoint =
					spot.water

				state.drinkSearch.undergroundMode =
					true

				state.drinkSearch.undergroundSince =
					tick()

				state.drinkSearch.undergroundLastProgressAt =
					tick()

				state.drinkSearch.undergroundLastWater =
					test.startWater

				state.drinkSearch.waterHealth =
					humanoid.Health

				state.drinkSearch.waterHealthAt =
					tick()

				state.drinkTestSetPhase(
					"descend",
					string.format(
						"Underground Drink: descending to hidden water (cover %.1f, targetY %.1f)",
						spot.coverDepth,
						spot.stand.Y
					)
				)

				-- Hidden water must not act as a physical wall during transit.
				spot.waterPart.CanCollide = false

				if not state.drinkTestGhostCharacter(
					character,
					true
				) then
					error(
						"could not disable character collision"
					)
				end

				-- Underground crossing uses fast PivotTo translation while fully UNANCHORED.
				-- No SafeMove, Freefall, Physics state or ragdoll is used.
				local descended, descentMoveReason =
					state.drinkTestSmoothMove(
						spot.stand,
						"descent",
						false,
						14
					)

				if not descended
					and descentMoveReason ~= "cancel" then

					error(
						"descent move failed: "
						.. tostring(
							descentMoveReason
						)
					)
				end

				character, root, humanoid =
					characterParts()

				if not character
					or character ~= test.character
					or not root
					or not humanoid then
					error(
						"character changed during descent"
					)
				end

				local descentError =
					state.drinkTestTransitAbortReason(
						character,
						root,
						humanoid
					)

				if descentError
					and descentError ~= "cancel" then
					error(
						"descent safety: "
						.. descentError
					)
				end

				if test.cancelRequested then
					return
				end

				local targetDistance =
					(
						root.Position
						- spot.stand
					).Magnitude

				if not descended
					or targetDistance > 4 then

					error(
						string.format(
							"underground target not reached (distance %.1f)",
							targetDistance
						)
					)
				end

				if not state.drinkIsBuriedUnderTerrain(
					root
				) then

					local actualCover =
						test.surfaceY
						and (
							test.surfaceY
							- root.Position.Y
						)
						or -999

					error(
						string.format(
							"Terrain cover not confirmed after strict descent (rootY %.1f, surfaceY %.1f, cover %.1f, targetDistance %.1f)",
							root.Position.Y,
							tonumber(
								test.surfaceY
							) or -999,
							actualCover,
							targetDistance
						)
					)
				end

				state.drinkTestMaintainTransit(
					character,
					root,
					humanoid
				)

				-- Lock one exact underground pose for the whole drinking transaction.
				-- The remote does not require physical animation, so there is no reason
				-- to let the animal tumble, slide or rotate below Terrain.
				local flatLook = Vector3.new(
					root.CFrame.LookVector.X,
					0,
					root.CFrame.LookVector.Z
				)

				if flatLook.Magnitude < 0.05 then
					flatLook = Vector3.new(0, 0, -1)
				else
					flatLook = flatLook.Unit
				end

				local rigidRootCFrame = CFrame.lookAt(
					spot.stand,
					spot.stand + flatLook,
					Vector3.yAxis
				)

				local rigidRootToPivot
				pcall(function()
					rigidRootToPivot = root.CFrame:ToObjectSpace(
						character:GetPivot()
					)
				end)

				if rigidRootToPivot then
					pcall(function()
						character:PivotTo(
							rigidRootCFrame * rigidRootToPivot
						)
					end)
				else
					pcall(function()
						root.CFrame = rigidRootCFrame
					end)
				end

				root.Anchored = false
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero

				local rigidPivotCFrame
				pcall(function()
					rigidPivotCFrame = character:GetPivot()
				end)

				-- Underground transit/drinking always stays non-collidable. Do not
				-- re-enable MainWaterPart collision while the animal is below Terrain.
				spot.waterPart.CanCollide = false

				state.drinkTestSetPhase(
					"drink",
					"Underground Drink: underground position confirmed; testing Drink"
				)

				local drinkStartedAt =
					tick()

				local lastWater =
					tonumber(
						character:GetAttribute(
							"Water"
						)
					) or 100

				local lastProgressAt =
					tick()

				local lastRemoteAt = 0
				local progressConfirmed = false

				local initialProgressGrace =
					state.isHeavyGroundMover(
						character
					)
						and 12
						or 8

				-- Keep a safety reserve for surfacing. The animal is never allowed
				-- to spend the full 90-second ceiling waiting below Terrain.
				local hardSafetyDeadline =
					tick() + 80

				-- Underground mode is a full refill. Leaving at 98% could start a
				-- new drink transaction almost immediately and increased exposure.
				local targetWater = 100

				while state.alive
					and character
						== player.Character
					and humanoid.Parent
					and humanoid.Health > 0 do

					local now = tick()
					local water =
						tonumber(
							character:GetAttribute(
								"Water"
							)
						) or 100

					-- Reassert clipping on every frame while buried. This is the
					-- Terrain-crossing safety mechanism for both automatic and
					-- manually selected Underground Drink.
					for _, object in ipairs(
						character:GetDescendants()
					) do
						if object:IsA("BasePart")
							and object.CanCollide then
							object.CanCollide = false
						end
					end

					if spot.waterPart
						and spot.waterPart.Parent
						and spot.waterPart.CanCollide then
						spot.waterPart.CanCollide = false
					end

					character:SetAttribute(
						"MovementDisabled",
						true
					)

					state.drinkTestMaintainTransit(
						character,
						root,
						humanoid
					)

					root.AssemblyLinearVelocity =
						Vector3.zero

					root.AssemblyAngularVelocity =
						Vector3.zero

					pcall(
						humanoid.Move,
						humanoid,
						Vector3.zero,
						false
					)

					if state.questSetW then
						state.questSetW(false)
					end

					if test.cancelRequested then
						break
					end

					-- Water 100% is an unconditional EXIT condition.
					if water >= targetWater then
						test.lastResult =
							"water_full"
						break
					end

					if root.Position.Y
						< config.dangerY + 4 then
						error(
							"void threshold reached underground"
						)
					end

					local maxHealth =
						math.max(
							humanoid.MaxHealth,
							1
						)

					if test.startHealth
						- humanoid.Health
						>= maxHealth * 0.025 then

						error(
							"health loss >=2.5% underground"
						)
					end

					-- Unanchored hard pin: keep exactly one pose while the server still sees
					-- a normal live character. Reapply every Heartbeat; no ragdoll/impulses.
					root.Anchored = false
					if rigidPivotCFrame then
						pcall(function()
							character:PivotTo(rigidPivotCFrame)
						end)
					elseif rigidRootCFrame then
						pcall(function()
							root.CFrame = rigidRootCFrame
						end)
					end

					root.AssemblyLinearVelocity = Vector3.zero
					root.AssemblyAngularVelocity = Vector3.zero

					if water
						> lastWater + 0.01 then

						lastWater = water
						lastProgressAt = now
						progressConfirmed = true

						state.drinkSearch.undergroundLastWater =
							water

						state.drinkSearch.undergroundLastProgressAt =
							now

						state.drinkTestSetPhase(
							"drink",
							string.format(
								"Underground Drink: remote active (%d%% -> 100%%)",
								math.floor(water)
							)
						)
					end

					-- E/prompt is visual only. The server sub-state remote is what
					-- actually starts/maintains drinking, so underground mode calls
					-- it directly instead of waiting for a prompt that may never
					-- replicate below Terrain.
					if now - lastRemoteAt >= 0.30 then
						lastRemoteAt = now
						blockClientSubState = false
						setSubState(
							"Drinking"
						)
						blockClientSubState = false
					end

					if not progressConfirmed
						and now - drinkStartedAt
							>= initialProgressGrace then

						error(
							string.format(
								"underground Drink produced no Water progress within %.0fs",
								initialProgressGrace
							)
						)
					end

					if progressConfirmed
						and now - lastProgressAt
							>= 5.0 then

						error(
							"underground Water stopped progressing for 5s"
						)
					end

					if now >= hardSafetyDeadline then
						error(
							"80s underground safety ceiling; reserving time for exit"
						)
					end

					-- Pin every physics frame without Anchored. This is the old fixed-position
					-- behavior, but with the complete rig kept upright and non-collidable.
					RunService.Heartbeat:Wait()
				end
			end,
			function(err)
				return tostring(err)
			end
		)

	if not ok then
		test.lastError =
			tostring(failure)

		test.lastResult = "failed"
	end

	-- Every outcome performs a controlled surface exit.
	local exitReason

	if test.cancelRequested then
		exitReason =
			"cancel requested"
	elseif not ok then
		exitReason =
			test.lastError
	elseif test.lastResult == "water_full" then
		exitReason =
			"water full"
	else
		exitReason =
			"test complete"
	end

	local safeExit =
		state.drinkTestEmergencySurfaceExit(
			exitReason
		)

	-- One final immediate attempt before any state can remain locked. With a
	-- live Savannah character this also has a dry-farm last resort.
	if not safeExit then
		safeExit =
			state.drinkTestHardEject(
				"final anti-drowning retry"
			)
	end

	if safeExit then
		state.drinkTestRestoreEnvironment()

		test.active = false
		test.cancelRequested = false
		test.phase = "idle"

		criticalRecoveryActive = false

		drinkingToFull = false
		drinkingSourcePosition = nil
		drinkingStuckSince = nil
		lastDrinkWatchdogWater = nil
		state.drinkProgressReset()
		state.drinkClearUndergroundMode()

		state.questForceFastRecheckUntil =
			tick() + 20

		if test.lastResult == "failed"
			or not ok then
			test.retryAfter =
				tick() + 20
		else
			test.retryAfter = 0
		end

		runtimeMessage =
			ok
				and "Underground Drink complete: surface exit confirmed"
				or (
					"Underground Drink aborted safely: "
					.. tostring(
						test.lastError
						or exitReason
					)
				)
	else
		-- Reaching this branch normally means the character disappeared/died while
		-- the transaction was being rescued. Never preserve a stale global safety
		-- lock, because that would permanently disable Auto Eat/Drink afterwards.
		test.lastError =
			test.lastError
			or "surface exit could not be confirmed because character changed"

		state.drinkTestRestoreEnvironment()

		test.active = false
		test.cancelRequested = false
		test.phase = "idle"
		test.retryAfter = tick() + 20

		criticalRecoveryActive = false
		drinkingToFull = false
		drinkingSourcePosition = nil
		drinkingStuckSince = nil
		lastDrinkWatchdogWater = nil
		blockClientSubState = false

		runtimeMessage =
			"Underground Drink recovery transaction ended; survival controller unlocked"
	end

	state.drinkTestRender()
end


local function virtualDrinkKick()
	local character, root = characterParts()
	if not character or not root then return end

	local detected = detectAvailableFood(character)
	local dinoPromptAlreadyVisible = isDinoLife and detected == "Drink"

	if dinoPromptAlreadyVisible then
		runtimeMessage = "Dino: beber travou, mas prompt esta ativo; reativando no lugar"
		drinkingSourcePosition = root.Position
	else
		runtimeMessage = "Drink stalled; reasserting server Drinking state"

		if isDinoLife then
			local landing = DINO_DRINK_POSITION + Vector3.new(0, surfaceStandOffset(character), 0)
			safeMoveToPosition(
			landing,
			8,
			nil,
			{
				purpose = "water",
				tolerance = 12,
				vertical = true,
			}
		)
			local _, newRoot = characterParts()
			if newRoot then drinkingSourcePosition = newRoot.Position end
			CROC.dinoLastMoveAt = tick()
		elseif CROC.isCharacter(character) then
			drinkingSourcePosition = nil
			removeSwimBarrier()
			local _, waterPart = CROC.getWaterSurfaceY()
			if waterPart then waterPart.CanCollide = true end
			CROC.approachDrink()
		elseif drinkingSourcePosition then
			state.drinkAbandonCurrent("Watchdog: fonte sem progresso; trocando de agua")
			return
		end

		task.wait(0.2)
	end

	-- E and Auto Drink off/on toggles are unnecessary. Reassert the server
	-- state directly so a watchdog recovery cannot accidentally disable survival.
	blockClientSubState = false
	setSubState("Drinking")
	blockClientSubState = false
	if isDinoLife then
		task.spawn(holdDinoDrinkPosition, drinkingSourcePosition or root.Position)
	end
	drinkingStuckSince = nil
end

local function autoDrinkStep()
	if state.questGrowthReset.exclusive then return end
	if not state.autoDrink or criticalRecoveryActive then return end

	local character, root, humanoid = characterParts()
	if not character or not root or not humanoid then return end

	local earlyWater =
		tonumber(
			character:GetAttribute("Water")
		) or 100

	local earlyFood =
		tonumber(
			character:GetAttribute("Food")
		) or 100

	state.survivalArbiterNoteProgress("water", earlyWater)
	state.survivalArbiterNoteProgress("food", earlyFood)

	local survivalOwner = state.survivalArbiter.owner
	if survivalOwner == "food" and earlyWater > 45 then
		-- Food has a committed route. Normal thirst must wait instead of making
		-- the animal abandon grass, walk to water, abandon water, and repeat.
		return
	end

	if earlyWater <= 75 or drinkingToFull then
		if not state.survivalArbiterAcquire(
			"water",
			earlyFood,
			earlyWater,
			earlyWater <= 45 and "critical thirst preemption" or "Auto Drink committed"
		) then
			return
		end
	end

	local movementInteraction
	if state.questMovementOpportunisticInteract then
		movementInteraction =
			state.questMovementOpportunisticInteract(
				character,
				root
			)
	end

	local movingDrinkGrace =
		state.questMoveInteract
			and state.questMotionMoving
			and state.questMotionMode == "Land"
			and tick()
				< (
					state.questMoveInteract.drinkGraceUntil
						or 0
				)

	-- Water encountered naturally on the running path gets first chance.
	-- Keep the route moving; only if that contact stops helping does the normal
	-- Auto Drink search take ownership.
	if movementInteraction == "drink"
		or movementInteraction == "drink_grace"
		or movingDrinkGrace then

		return
	end

	-- Hippo/Croc need solid MainWaterPart BEFORE the approach. Enabling it
	-- after arrival is too late for their large body physics.
	if isAquaticCharacter(character)
		and (earlyWater <= 75 or drinkingToFull) then
		setAquaticWaterCollision(character, true)
	end

	-- Crocodile can NEVER use Underground Drink. Its low body/physics make the
	-- hidden-water transit unsafe; Surface Water is mandatory.
	if state.autoDrinkMode == "underground"
		and CROC.isCharacter(character) then
		state.autoDrinkMode = "surface"
		state.autoDrinkPreferredMode = "surface"
		state.drinkClearUndergroundMode()
		runtimeMessage = "Underground Drink is disabled for Crocodile; Surface Water forced"
		if state.renderAutoDrinkModeButtons then pcall(state.renderAutoDrinkModeButtons) end
	end

	-- v103 permanent underground Auto Drink mode.
	if state.autoDrinkMode == "underground"
		and isSavannahLife
		and not CROC.isCharacter(character)
		and tick() >= (state.drinkTest.forceSurfaceUntil or 0)
		and (
			earlyWater <= 75
			or (
				drinkingToFull
				and earlyWater
					< (
						preSwitchWaterTarget
						or 98
					)
			)
		) then

		if state.drinkTest.active then
			return
		end

		if tick()
			< (
				state.drinkTest.retryAfter
				or 0
			) then

			runtimeMessage =
				"Underground Drink: safety cooldown before retry"

			return
		end

		-- Underground mode owns the survival movement from this point.
		drinkingToFull = true
		eatingToFull = false
		eatingSourcePosition = nil
		activeCarcass = nil

		state.questBaboonFeeding = false
		state.questGiraffeFeeding = false

		BABOON.cancel()
		GIRAFFE.cancel()

		if state.safeMove
			and state.safeMove.active then
			state.safeMove.cancelToken += 1
		end

		if state.questSetW then
			pcall(
				state.questSetW,
				false
			)
		end

		runtimeMessage =
			"Underground Drink: preparing protected descent"

		task.spawn(function()
			state.runUndergroundDrinkTest()

			-- Avoid a rapid fail -> retry -> fail loop if the current locality
			-- cannot provide a usable hidden-water point.
			if state.drinkTest.lastResult
				== "failed" then

				state.drinkTest.retryAfter =
					tick() + 20
				state.drinkTest.forceSurfaceUntil =
					tick() + 8
			else
				state.drinkTest.retryAfter = 0
				state.drinkTest.forceSurfaceUntil = 0
			end
		end)

		return
	end

	if state.autoDrinkMode == "underground"
		and isSavannahLife
		and tick() < (state.drinkTest.forceSurfaceUntil or 0) then
		runtimeMessage =
			"Underground recovery: trying exposed surface water during cooldown"
	end

	-- If this mode is selected in another game, keep existing surface behavior
	-- rather than leaving Auto Drink dead.
	if state.autoDrinkMode == "underground"
		and not isSavannahLife
		and earlyWater <= 75 then

		runtimeMessage =
			"Underground Drink is unavailable here; using surface water search"
	end

	-- Baboon food must NEVER block thirst handling. Cancel its logical ownership
	-- before checking state.busy; if a one-shot AntHill TP is still settling,
	-- Auto Drink will take over on the next scan instead of restarting food.
	if isBaboonCharacter(character) and earlyWater <= 75 then
		state.questBaboonFeeding = false
		eatingToFull = false
		eatingSourcePosition = nil
		activeCarcass = nil
		BABOON.cancel()
		eatingStuckSince = nil
		blockClientSubState = false
	end

	if state.busy then return end

	if state.drinkPostureWatch(character, root, humanoid) then
		return
	end

	local currentAnimalName = CROC.getAnimalName(character)
	if not isGiraffeCharacter(character)
		and (GIRAFFE.busy or GIRAFFE.targetTree) then
		state.questGiraffeFeeding = false
		GIRAFFE.cancel()
	end

	if not isBaboonCharacter(character) and (BABOON.busy or BABOON.targetObject) then
		state.questBaboonFeeding = false
		BABOON.cancel()
	end

	if currentAnimalName ~= CROC.lastDrinkAnimalName then
		-- Never leave MainWaterPart solid after switching away from Hippo/Croc.
		local waterPart = workspace:FindFirstChild("MainWaterPart")
		if waterPart and waterPart:IsA("BasePart") then
			waterPart.CanCollide = false
		end

		drinkingToFull = false
		drinkingSourcePosition = nil
		drinkingStuckSince = nil
		lastDrinkWatchdogWater = nil
		state.drinkProgressReset()
		state.drinkSearch.currentWaterPoint = nil
		state.drinkSearch.failedCount = 0
		state.drinkSearch.retryAfter = 0
		state.drinkSearch.upsideDownSince = nil
		state.drinkSearch.waterHealth = nil
		state.drinkSearch.waterHealthAt = 0
		state.drinkClearUndergroundMode()
		removeSwimBarrier()
		CROC.lastDrinkAnimalName = currentAnimalName
		CROC.dinoLastMoveAt = nil
	end

	local water = earlyWater

	if state.drinkProgress
		and state.drinkProgress.confirmed
		and drinkingToFull then

		local sinceProgress =
			tick()
			- (
				state.drinkProgress.lastProgressAt
				or 0
			)

		if sinceProgress < 5.0 then
			runtimeMessage =
				"Drinking confirmed; holding current position"

			task.spawn(
				sustainDrinkAtCurrentPrompt
			)

			return
		else
			state.drinkProgressReset()
		end
	end

	if not state.questSwimActive
		and tick() < (state.drinkSearch.retryAfter or 0) then
		-- Comfortable Water can honor the normal cooldown. At dangerous Water,
		-- keep ownership latched so SurvivalBrain can clear/retry the source rather
		-- than leaving the animal idle and allowing quests to steal control.
		if water > 60 then
			drinkingToFull = false
		end
		return
	end

	-- Swim quest + thirst:
	-- Water <=75 now latches a FULL drink cycle. Swim movement pauses until
	-- Water reaches the normal target (~98), then resumes in the same water.
	-- This fixes the old 58 -> 59 single-sip behavior.
	if state.questSwimActive then
		removeSwimBarrier()

		if water <= 75 then
			drinkingToFull = true
		end

		if not drinkingToFull then
			lastDrinkWatchdogWater = water
			return
		end

		state.questSwimLastDrinkAt = tick()
		state.questMotionMoving = false
		state.questMotionMode = nil
		if state.questSetW then state.questSetW(false) end

		local detected =
			detectAvailableFood(character)

		local visualDetected =
			state.drinkVisualPromptVisible
			and state.drinkVisualPromptVisible()

		if detected == "Drink"
			or visualDetected then

			if visualDetected then
				state.drinkLatchVisualPrompt()
			end

			drinkingSourcePosition = root.Position
			runtimeMessage = string.format(
				"Swim paused: drinking to full (%d%%)",
				math.floor(water)
			)
			task.spawn(sustainDrinkAtCurrentPrompt)
		else
			runtimeMessage = string.format(
				"Swim paused: finding drinkable water (%d%%)",
				math.floor(water)
			)
		end

		-- Do not return here. The normal drinking state machine below handles
		-- prompt/search/watchdog/completion while Swim movement remains paused.
	end

	if water <= 75 then
		-- Reaching this block means the arbiter granted Water ownership. Only now
		-- may Drink clear Food state (normal Water <=75 by itself cannot do it).
		drinkingToFull = true
		eatingToFull = false
		eatingSourcePosition = nil
		activeCarcass = nil
		state.questBaboonFeeding = false
		state.questGiraffeFeeding = false
		BABOON.cancel()
		GIRAFFE.cancel()
		blockClientSubState = false
		runtimeMessage = isBaboonCharacter(character)
			and "Baboon: Water <= 75%; drinking has priority"
			or "Indo beber agua"
	end
	if drinkingToFull and water >= (preSwitchWaterTarget or 98) then
		local wasUnderground = state.drinkSearch.undergroundMode

		state.questTravelActive = false
		state.questLandInputActive = false
		state.questMotionMoving = false
		state.questMotionMode = nil
		if state.questSetW then state.questSetW(false) end

		drinkingToFull = false
		drinkingSourcePosition = nil
		drinkingStuckSince = nil
		lastDrinkWatchdogWater = water
		state.drinkProgressReset()
		state.survivalArbiterNoteProgress("water", water)
		state.survivalArbiterComplete("water")

		if state.autoQuests then
			state.questForceFastRecheckUntil = tick() + 12
		end
		state.drinkSearch.currentWaterPoint = nil
		state.drinkSearch.failedCount = 0
		state.drinkSearch.retryAfter = 0
		state.drinkSearch.upsideDownSince = nil
		state.drinkSearch.waterHealth = nil
		state.drinkSearch.waterHealthAt = 0
		state.drinkTest.emergencyFallback = false

		removeSwimBarrier()

		if isAquaticCharacter(character) then
			-- Keep solid water until dry Terrain is confirmed by the exit routine.
			setAquaticWaterCollision(character, true)
		end

		if state.questSwimActive and not wasUnderground then
			criticalRecoveryActive = false

			-- Drinking can happen at ANY valid water source. Completing that drink
			-- does not mean this puddle is the Swim mission area.
			state.questSwimReady =
				isNearSavedSwimLocation(root, 68)
				and isValidSwimQuestWater(root)

			if state.questSwimReady then
				setSubState("Swimming")
				runtimeMessage =
					"Water full; already at saved Swim location"
			else
				runtimeMessage =
					"Water full; survival check before moving to Swim location"
			end

			state.questForceFastRecheckUntil = tick() + 12
			return
		end

		-- Outside Swim, retain the existing safe post-drink move.
		criticalRecoveryActive = true
		task.spawn(forcePostDrinkMove, wasUnderground)
		return
	end
	if not drinkingToFull then return end

	if state.drinkSearch.undergroundMode then
		if state.drinkUndergroundSafety(character, root, humanoid, water) then
			return
		end
	end

	-- Buried water is invalid unless we deliberately entered the protected
	-- Savannah drought fallback mode.
	-- Do this before prompt/watchdog logic so we react on the very next scan.
	if not isDinoLife
		and not state.drinkSearch.undergroundMode
		and state.drinkIsBuriedUnderTerrain(root) then
		state.drinkEmergencyEscape(
			character,
			root,
			"Watchdog agua: Terrain acima do personagem; abortando fonte"
		)
		return
	end

	if not isAquaticCharacter(character)
		and state.drinkSearch.currentWaterPoint
		and root.Position.Y < state.drinkSearch.currentWaterPoint.Y - 7 then

		state.drinkEmergencyEscape(
			character,
			root,
			"Watchdog agua: personagem afundou demais; abortando fonte"
		)
		return
	end

	if lastDrinkWatchdogWater == nil or water > lastDrinkWatchdogWater then
		lastDrinkWatchdogWater = water
		drinkingStuckSince = tick()
		state.drinkSearch.failedCount = 0

		if state.drinkSearch.undergroundMode then
			state.drinkSearch.undergroundLastProgressAt = tick()
			state.drinkSearch.undergroundLastWater = water
		end
	elseif not drinkingStuckSince then
		drinkingStuckSince = tick()
	end
	if drinkingStuckSince and tick() - drinkingStuckSince >= 6 then
		lastDrinkWatchdogWater = water
		drinkingStuckSince = tick()

		if not isDinoLife
			and not CROC.isCharacter(character)
			and detectAvailableFood(character) ~= "Drink"
			and not (
				state.drinkVisualPromptVisible
				and state.drinkVisualPromptVisible()
			) then
			state.drinkAbandonCurrent("Agua sem prompt/progresso; descartando ponto e procurando outro")
			return
		end

		virtualDrinkKick()
		return
	end

	-- Se o prompt já está disponível, não reposiciona nem deixa outra rotina
	-- assumir o personagem: simplesmente mantém a posição e bebe.
	local drinkDetectedNow =
		detectAvailableFood(character)

	local visualDrinkNow =
		state.drinkVisualPromptVisible
		and state.drinkVisualPromptVisible()

	if drinkDetectedNow == "Drink"
		or visualDrinkNow then

		if visualDrinkNow then
			state.drinkLatchVisualPrompt()
		end

		drinkingSourcePosition = root.Position

		-- Não congele o ragdoll se ele chegou de ponta-cabeça.
		if state.drinkIsUpsideDown(root) then
			state.drinkUprightCharacter(
				character,
				root,
				state.drinkSearch.currentWaterPoint
			)
		else
			root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
			root.AssemblyAngularVelocity = Vector3.zero
		end

		runtimeMessage = "Prompt de agua detectado; bebendo"
		setSubState("Drinking")
		if isDinoLife then
			task.spawn(holdDinoDrinkPosition, root.Position)
		else
			task.spawn(sustainDrinkAtCurrentPrompt)
		end
		return
	end

	if isDinoLife then
		local waterPart = workspace:FindFirstChild("MainWaterPart")
		if waterPart and waterPart:IsA("BasePart") then waterPart.CanCollide = true end

		-- REGRA PRINCIPAL: se o prompt já aparece, a posição atual é válida.
		-- Não move de novo e não tenta empurrar o personagem para outra altura.
		local detected = detectAvailableFood(character)
		if detected == "Drink" then
			drinkingSourcePosition = root.Position
			CROC.dinoLastMoveAt = nil
			runtimeMessage = "Dino: prompt de beber detectado; mantendo posicao"
			setSubState("Drinking")
			task.spawn(holdDinoDrinkPosition, root.Position)
			return
		end

		-- Depois de um TP, dá alguns segundos para o prompt aparecer/estabilizar.
		-- Antes o autoDrinkStep rodava de novo 1s depois e moveva no MESMO
		-- ponto repetidamente, mesmo quando o animal ainda estava assentando.
		if drinkingSourcePosition and (root.Position - drinkingSourcePosition).Magnitude <= 20 then
			local elapsed = tick() - (CROC.dinoLastMoveAt or tick())
			if elapsed < 4 then
				runtimeMessage = string.format(
					"Dino: aguardando prompt estabilizar (%.1fs)",
					math.max(0, 4 - elapsed)
				)
				setSubState("Drinking")
				return
			end
		end

		local dinoLandingPosition = DINO_DRINK_POSITION + Vector3.new(0, surfaceStandOffset(character), 0)
		runtimeMessage = "Dino: posicionando na agua"
		safeMoveToPosition(
			dinoLandingPosition,
			8,
			nil,
			{
				purpose = "water",
				tolerance = 12,
				vertical = true,
			}
		)

		-- Usa a posição REAL depois do pouso como referência, não o alvo teórico.
		local _, landedRoot = characterParts()
		drinkingSourcePosition = landedRoot and landedRoot.Position or dinoLandingPosition
		CROC.dinoLastMoveAt = tick()

		task.wait(0.25)
		for _ = 1, 3 do
			setSubState("Drinking")
			task.wait(0.15)
		end
		return
	end


	local isCroc = CROC.isCharacter(character)

	if isCroc then
		-- Croc uses the normal exposed-water scanner and keeps MainWaterPart
		-- collidable so it can drink at the lip without entering the water.
		setAquaticWaterCollision(character, true)
	end

	local isAquatic = isAquaticCharacter(character)

	if drinkingSourcePosition and (root.Position - drinkingSourcePosition).Magnitude <= 16 then
		if not state.drinkSearch.undergroundMode
			and state.drinkIsBuriedUnderTerrain(root) then
			state.drinkEmergencyEscape(
				character,
				root,
				"Fonte lembrada ficou sob Terrain; saindo"
			)
			return
		end

		local detectedHere =
			detectAvailableFood(character)

		local visualHere =
			state.drinkVisualPromptVisible
			and state.drinkVisualPromptVisible()

		if detectedHere == "Drink"
			or visualHere then

			if visualHere then
				state.drinkLatchVisualPrompt()
			end

			runtimeMessage = "Bebendo ate encher"

			if isAquatic then
				setAquaticWaterCollision(character, true)
			end

			if state.drinkIsUpsideDown(root) then
				state.drinkUprightCharacter(
					character,
					root,
					state.drinkSearch.currentWaterPoint
				)
			end

			setSubState("Drinking")
			task.spawn(sustainDrinkAtCurrentPrompt)
			return
		end

		-- We reached the selected water but the game itself says Drink is not
		-- available. Give physics/prompt a short grace period, then blacklist it.
		if drinkingStuckSince and tick() - drinkingStuckSince >= 3.5 then
			state.drinkAbandonCurrent("Poca/agua nao utilizavel; mudando para outra fonte")
			return
		end
	end

	-- Mode 1: prefer exposed/above-Terrain water whenever it exists.
	local spot = state.drinkFindAccessibleSpot(root.Position, character)

	-- Movement-only mode cannot safely cross solid Terrain to the hidden
	-- MainWaterPart. During drought, only exposed/physically reachable water
	-- is accepted.
	if not spot and isSavannahLife then
		state.drinkClearUndergroundMode()
		runtimeMessage =
			"Drought: no exposed water found; underground clipping disabled"
	end

	if not spot then
		-- v107 EMERGENCY RULE:
		-- If Surface Water cannot find a usable puddle/river and Water is
		-- already below 70%, temporarily use the protected underground backend.
		-- This does NOT change autoDrinkMode or the player's saved preference.
		local emergencyUnderground =
			isSavannahLife
				and water < 70
				and state.autoDrinkMode == "surface"
				and not CROC.isCharacter(character)

		if emergencyUnderground then
			state.drinkSearch.failedCount = 0
			state.drinkSearch.retryAfter = 0

			drinkingToFull = true
			eatingToFull = false
			eatingSourcePosition = nil
			activeCarcass = nil

			state.questBaboonFeeding = false
			state.questGiraffeFeeding = false
			state.questTravelActive = false
			state.questLandInputActive = false
			state.questMotionMoving = false
			state.questMotionMode = nil

			BABOON.cancel()
			GIRAFFE.cancel()

			if state.questSetW then
				pcall(
					state.questSetW,
					false
				)
			end

			if state.safeMove
				and state.safeMove.active then
				state.safeMove.cancelToken += 1
			end

			if state.drinkTest.active
				or state.drinkTest.emergencyFallback then

				runtimeMessage =
					string.format(
						"Emergency Underground Drink active (Water %d%%)",
						math.floor(water)
					)

				return
			end

			if tick()
				< (
					state.drinkTest.retryAfter or 0
				) then

				runtimeMessage =
					string.format(
						"Emergency Underground Drink cooling down (Water %d%%)",
						math.floor(water)
					)

				return
			end

			state.drinkTest.emergencyFallback = true

			runtimeMessage =
				string.format(
					"No safe surface water found at %d%%; emergency Underground Drink",
					math.floor(water)
				)

			task.spawn(function()
				local ok, err =
					pcall(
						state.runUndergroundDrinkTest
					)

				state.drinkTest.emergencyFallback = false
				state.drinkSearch.failedCount = 0
				state.drinkSearch.retryAfter = 0

				if not ok then
					state.drinkTest.lastResult = "failed"
					state.drinkTest.lastError =
						tostring(err)
					state.drinkTest.retryAfter =
						tick() + 4

					runtimeMessage =
						"Emergency Underground Drink error; retrying safely"

					return
				end

				if state.drinkTest.lastResult == "failed" then
					state.drinkTest.retryAfter =
						tick() + 4
				else
					state.drinkTest.retryAfter = 0
				end
			end)

			return
		end

		-- Above the emergency threshold, keep the normal surface retry behavior.
		state.drinkSearch.failedCount =
			(state.drinkSearch.failedCount or 0) + 1

		runtimeMessage =
			"No exposed water reachable with safe movement"

		if state.drinkSearch.failedCount >= 2 then
			state.drinkSearch.failedCount = 0
			state.drinkSearch.retryAfter = tick() + 10
			drinkingToFull = false
			runtimeMessage =
				"Water search failed; Auto Run released for 10s"
		end

		return
	end

	-- Final pre-TP validation only for normal exposed drinking. Underground
	-- fallback is intentionally underneath Terrain and has its own watchdog.
	if not spot.underground
		and not isAquatic
		and state.drinkLandingCovered(spot.stand) then
		state.drinkMarkFailed(spot.water, 300)
		state.drinkSearch.currentWaterPoint = nil
		runtimeMessage = "Fonte rejeitada: ponto de bebida esta sob Terrain"
		return
	end

	state.drinkSearch.currentWaterPoint = spot.water
	state.drinkSearch.promptStopAt = nil
	state.drinkSearch.promptStopTime = nil

	if spot.underground then
		state.drinkSearch.undergroundMode = true
		state.drinkSearch.undergroundSince = tick()
		state.drinkSearch.undergroundLastProgressAt = tick()
		state.drinkSearch.undergroundLastWater = water
		state.drinkSearch.waterHealth = humanoid.Health
		state.drinkSearch.waterHealthAt = tick()
		runtimeMessage = "Descendo para MainWaterPart subterranea com watchdog anti-afogamento"
	else
		state.drinkClearUndergroundMode()

		local routeDistance =
			Vector3.new(
				spot.stand.X - root.Position.X,
				0,
				spot.stand.Z - root.Position.Z
			).Magnitude

		runtimeMessage =
			string.format(
				"Indo para agua exposta (%s, %.0f studs)",
				tostring(
					spot.source
				),
				routeDistance
			)
	end

	local landed

	if isCroc then
		-- Croc: stay on Terrain at the selected bank with collision enabled.
		setAquaticWaterCollision(character, true)

		landed = safeMoveToPosition(
			spot.stand,
			9,
			spot.water,
			{
				purpose = "water",
				tolerance =
					spot.source == "MainWaterPart"
						and math.clamp(state.movementFootprint(character) * 0.22, 2.0, 3.8)
						or 3.0,
				speedScale = 0.72,
				constantSpeed = true,
				riverApproach =
					spot.source
						== "MainWaterPart",
				riverApproachRadius = 36,
				maxDuration = 300,
			}
		)
	elseif isAquatic then
		setAquaticWaterCollision(character, true)

		landed = safeMoveToPosition(
			spot.stand,
			10,
			spot.water,
			{
				purpose = "water",
				tolerance = math.clamp(state.movementFootprint(character) * 0.48, 4.5, 8),
				speedScale = 0.72,
				maxDuration = 300,
			}
		)
	else
		-- Land animals must reach the selected bank precisely. The old 9-stud
		-- tolerance could stop on the dry strip between adjacent puddles.
		landed = safeMoveToPosition(
			spot.stand,
			8,
			spot.water,
			{
				purpose = "water",
				tolerance =
					spot.source
						== "MainWaterPart"
						and 1.15
						or 2.75,
				speedScale = 1,
				riverApproach =
					spot.source
						== "MainWaterPart",
				riverApproachRadius = 36,
				maxDuration = 240,
			}
		)
	end

	if not landed then
		state.drinkAbandonCurrent("Falhou ao chegar na fonte; procurando outra")
		return
	end

	task.wait(0.45)

	local _, newRoot = characterParts()
	if not newRoot then
		state.drinkAbandonCurrent("Personagem sumiu ao chegar na agua; procurando outra")
		return
	end

	if not spot.underground and state.drinkIsBuriedUnderTerrain(newRoot) then
		state.drinkEmergencyEscape(
			character,
			newRoot,
			"BUG DE AGUA: personagem caiu sob Terrain; escapando imediatamente"
		)
		return
	end

	-- Land animals should remain around the bank/water surface. If the HRP
	-- somehow sank deeply below the selected water, treat it as the same bug.
	if not spot.underground
		and not isAquatic
		and state.drinkSearch.currentWaterPoint
		and newRoot.Position.Y < state.drinkSearch.currentWaterPoint.Y - 7 then

		state.drinkEmergencyEscape(
			character,
			newRoot,
			"BUG DE AGUA: animal afundou abaixo da fonte; escapando"
		)
		return
	end

	-- v125: exposed-water arrival handshake for the MoveTo engine.
	-- Once navigation succeeded, interaction gets a stationary transaction.
	if not spot.underground then
		local acquired,
			heldRoot =
				state.drinkAcquirePromptAfterMove(
					spot,
					character,
					newRoot,
					humanoid,
					water
				)

		newRoot =
			heldRoot or newRoot

		if not acquired then
			state.drinkAbandonCurrent(
				"Chegou na agua, mas Drink nao confirmou apos parada controlada"
			)

			return
		end

		drinkingSourcePosition =
			newRoot.Position

		drinkingStuckSince =
			tick()

		lastDrinkWatchdogWater =
			water

		state.drinkSearch.failedCount =
			0

		if isAquatic then
			setAquaticWaterCollision(
				character,
				true
			)
		end

		runtimeMessage =
			"Fonte confirmada; iniciando bebida sem sair da margem"

		setSubState(
			"Drinking"
		)

		task.spawn(
			sustainDrinkAtCurrentPrompt
		)

		return
	end

	local detectedAfterArrival =
		detectAvailableFood(character)

	local visualAfterArrival =
		state.drinkVisualPromptVisible
		and state.drinkVisualPromptVisible()

	if visualAfterArrival then
		state.drinkLatchVisualPrompt()
		detectedAfterArrival = "Drink"
	end

	if detectedAfterArrival ~= "Drink" then
		local flat = Vector3.new(
			spot.water.X - newRoot.Position.X,
			0,
			spot.water.Z - newRoot.Position.Z
		)
		if flat.Magnitude > 0.5 then
			pcall(function()
				newRoot.CFrame = CFrame.lookAt(
					newRoot.Position,
					newRoot.Position + flat.Unit,
					Vector3.yAxis
				)
			end)
		end

		if spot.underground then
			local promptDeadline = tick() + 4.0

			repeat
				if state.drinkUndergroundSafety(
					character,
					newRoot,
					humanoid,
					water
				) then
					return
				end

				setSubState("Drinking")
				task.wait(0.25)
				detectedAfterArrival = detectAvailableFood(character)
			until detectedAfterArrival == "Drink" or tick() >= promptDeadline
		else
			task.wait(0.35)
			detectedAfterArrival = detectAvailableFood(character)
		end
	end

	-- v92: NO second movement/refinement at the shoreline.
	-- Once safeMoveToPosition reached spot.stand, the animal stays there.
	-- We only re-check the prompt once after a short stationary grace period.
	if detectedAfterArrival ~= "Drink"
		and not spot.underground then

		newRoot.AssemblyLinearVelocity =
			Vector3.new(
				0,
				newRoot.AssemblyLinearVelocity.Y,
				0
			)

		newRoot.AssemblyAngularVelocity =
			Vector3.zero

		if state.questSetW then
			pcall(state.questSetW, false)
		end

		task.wait(0.30)

		character, newRoot = characterParts()

		if character and newRoot then
			detectedAfterArrival =
				detectAvailableFood(character)

			local visualAfterStationary =
				state.drinkVisualPromptVisible
				and state.drinkVisualPromptVisible()

			if visualAfterStationary then
				state.drinkLatchVisualPrompt()
				detectedAfterArrival = "Drink"
			end
		end
	end

	if detectedAfterArrival ~= "Drink" then
		if spot.underground then
			state.drinkEmergencyEscape(
				character,
				newRoot,
				"Agua subterranea sem prompt Drink; saindo imediatamente"
			)
		else
			state.drinkAbandonCurrent(
				"Selected bank had no Drink prompt; trying another water source"
			)
		end
		return
	end

	drinkingSourcePosition = newRoot.Position
	drinkingStuckSince = tick()
	lastDrinkWatchdogWater = water
	state.drinkSearch.failedCount = 0

	if spot.underground then
		state.drinkSearch.undergroundSince = tick()
		state.drinkSearch.undergroundLastProgressAt = tick()
		state.drinkSearch.undergroundLastWater = water
	end

	if state.drinkIsUpsideDown(newRoot) then
		state.drinkUprightCharacter(character, newRoot, spot.water)
	end

	-- Barrier only after the game confirms the source is actually drinkable.
	-- We never freeze the animal beside an invalid puddle anymore.
	if isAquatic then
		updateSwimBarrier(newRoot, true)
	end

	runtimeMessage = spot.underground
		and "Agua subterranea valida; bebendo com watchdog ativo"
		or "Fonte exposta valida confirmada; bebendo"
	setSubState("Drinking")

	if not isDinoLife then
		task.spawn(sustainDrinkAtCurrentPrompt)
	end
end

function state.drinkRefineSelectedBankPrompt(spot, character, root)
	-- v92 compatibility stub:
	-- Refinement movement was removed. This function NEVER moves, turns,
	-- nudges, jumps, or starts SafeMove. It only reports whether Drink is
	-- already available at the current position.
	if not spot
		or not character
		or not root
		or spot.underground then
		return false
	end

	if detectAvailableFood(character) == "Drink" then
		return true
	end

	if state.drinkVisualPromptVisible
		and state.drinkVisualPromptVisible() then
		state.drinkLatchVisualPrompt()
		return true
	end

	return false
end


local function isInsideTerrain(character, root)
	if not character or not root then return false end
	local region = Region3.new(root.Position - Vector3.new(2,2,2), root.Position + Vector3.new(2,2,2)):ExpandToGrid(4)
	local ok, _, occupancy = pcall(function()
		local materials, values = workspace.Terrain:ReadVoxels(region, 4)
		return materials, values
	end)
	return ok and occupancy and occupancy[1][1][1] > 0.55
end

local function resolveReplication()
	if shared._playerDataReplication and type(shared._playerDataReplication.GetKeyData) == "function" then
		return shared._playerDataReplication
	end
	for _, root in ipairs({ ReplicatedStorage, player:FindFirstChild("PlayerScripts"), player:FindFirstChild("PlayerGui") }) do
		local module = root and root:FindFirstChild("PlayerDataReplication", true)
		if module and module:IsA("ModuleScript") then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" and type(result.GetKeyData) == "function" then
				shared._playerDataReplication = result
				return result
			end
		end
	end
end

local function savedCharacters()
	local replication = resolveReplication()
	if not replication then runtimeMessage = "Dados de slots nao encontrados"; return {} end
	local ok, records = pcall(replication.GetKeyData, "SavedCharacters")
	if (not ok or type(records) ~= "table") and type(replication.GetData) == "function" then
		local dataOk, data = pcall(replication.GetData)
		if dataOk and type(data) == "table" then
			records = data.SavedCharacters
			ok = type(records) == "table"
		end
	end
	if not ok or type(records) ~= "table" then
		runtimeMessage = "Falha ao ler SavedCharacters"
		return {}
	end

	local normalized = {}
	for key, entry in pairs(records) do
		if type(entry) == "table" then
			if not entry.CharacterName and type(key) == "string" then
				entry.CharacterName = key
			end
			table.insert(normalized, entry)
		end
	end
	table.sort(normalized, function(a, b)
		return tostring(a.CharacterName or "") < tostring(b.CharacterName or "")
	end)
	return normalized
end

local function motherNameFor(entry)
	if type(entry) ~= "table" or (entry.GrowthPercentage or 1) > 0.01 then return nil end
	local remote = ReplicatedStorage:FindFirstChild("BabySpawnsRequestMotherNamesRemoteFunction")
	if not remote then return nil end
	local ok, result = pcall(remote.InvokeServer, remote, entry.AnimalName)
	if not ok then return nil end
	if type(result) == "string" then return result end
	if type(result) == "table" then
		for _, value in pairs(result) do
			if type(value) == "string" then return value end
			if type(value) == "table" then return value.PlayerName or value.Name or value.Username end
		end
	end
end

local function spawnSlot(
	entry,
	skipSafeMove,
	strictExpected
)
	local uniqueName = type(entry) == "table"
		and (entry.UniqueCharacterName or entry.CharacterName)
	if not SpawnRemote or not uniqueName then return false end

	local expectedName = entry.CharacterName
	local expectedAnimal = entry.AnimalName

	state.questExpectedSlot = {
		uniqueName = entry.UniqueCharacterName or entry.CharacterName,
		characterName = expectedName,
		animalName = expectedAnimal,
		requestedAt = tick(),
	}

	runtimeMessage = "Trocando para " .. tostring(expectedName)

	local mother = motherNameFor(entry)
	local oldCharacter = player.Character
	local ok = pcall(function()
		if mother then
			SpawnRemote:InvokeServer(uniqueName, mother)
		else
			SpawnRemote:InvokeServer(uniqueName)
		end
	end)

	if not ok then
		state.questExpectedSlot = nil
		runtimeMessage = "Spawn falhou: " .. tostring(expectedName)
		return false
	end

	local deadline = tick() + 16
	local changedSince
	local matched

	repeat
		task.wait(0.25)

		local candidate = player.Character
		local root = candidate and candidate:FindFirstChild("HumanoidRootPart")

		if candidate and root then
			if candidate ~= oldCharacter then
				changedSince = changedSince or tick()
			end

			local charName = candidate:GetAttribute("CharacterName")
			local animalName = candidate:GetAttribute("AnimalName")

			local nameMatches = charName == expectedName
			local animalMatches = type(expectedAnimal) == "string"
				and state.questAnimalKey(animalName) == state.questAnimalKey(expectedAnimal)

			if nameMatches or animalMatches then
				matched = candidate
				break
			end

			-- New Character but attributes are still loading.
			-- For a quest-only slot transaction we KNOW the exact requested
			-- CharacterName + AnimalName, so never accept a different spawned
			-- character merely because two seconds elapsed.
			if not strictExpected
				and candidate ~= oldCharacter
				and changedSince
				and tick() - changedSince >= 2 then

				matched = candidate
				break
			end
		end
	until tick() >= deadline

	if not matched then
		state.questExpectedSlot = nil
		runtimeMessage = "Spawn nao confirmou o slot " .. tostring(expectedName)
		return false
	end

	task.wait(1)
	state.questExpectedSlot = nil

	if not skipSafeMove then
		local postSpawnTarget =
			state.growthPrideRestrictionActive(
				matched
			)
			and state.growthPride.home
			or getSafeFarmPosition()

		local prideGrowthSpawn =
			state.growthPrideRestrictionActive(
				matched
			)

		safeMoveToPosition(
			postSpawnTarget,
			8,
			nil,
			{
				purpose = "spawn",
				-- Small herbivores must use the same reliable world-space MoveTo
				-- motor as Move To Locations when being staged into Pride Rock.
				forceMoveToLand = prideGrowthSpawn,
				tolerance = prideGrowthSpawn and 55 or 18,
				maxDuration = 300,
			}
		)
	end

	runtimeMessage = "Slot ativo: " .. tostring(expectedName)
	return true
end

function state.questSlotsNormalizeControl(character)
	character =
		character
		or player.Character

	if not character then
		return false
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not root or not humanoid then
		return false
	end

	-- A quest slot must never inherit a movement lock from SafeMove,
	-- underground transit, a reset transaction, or a previous execution.
	character:SetAttribute(
		"MovementDisabled",
		false
	)

	pcall(function()
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true

		if humanoid:GetState()
			== Enum.HumanoidStateType.Physics then

			humanoid:ChangeState(
				Enum.HumanoidStateType.GettingUp
			)
		end

		humanoid:Move(
			Vector3.zero,
			false
		)
	end)

	local velocity =
		root.AssemblyLinearVelocity

	root.AssemblyLinearVelocity =
		Vector3.new(
			0,
			velocity.Y,
			0
		)

	root.AssemblyAngularVelocity =
		Vector3.zero

	blockClientSubState = false

	if state.questSetW then
		pcall(
			state.questSetW,
			false
		)
	end

	return true
end

function state.questSlotsCurrentPositionSafe()
	local character, root =
		characterParts()

	if not character or not root then
		return false
	end

	if root.Position.Y
		<= config.dangerY + 8 then
		return false
	end

	if state.drinkIsBuriedUnderTerrain
		and state.drinkIsBuriedUnderTerrain(
			root
		) then
		return false
	end

	if state.isBodyActuallyInWater
		and state.isBodyActuallyInWater(
			character,
			root
		) then
		return false
	end

	return state.normalizeDryLandState
		and state.normalizeDryLandState(
			character,
			root
		)
end

function state.questSlotsPrepareForCreate()
	local character =
		player.Character

	if not character then
		return false
	end

	state.questSlotsNormalizeControl(
		character
	)

	-- Slot-switch point belongs to the OUTGOING animal. Never reset first and
	-- let the replacement animal perform the staging walk afterward.
	runtimeMessage =
		"Quest slot: staging current animal before switch"

	if state.moveBeforeSlotChange then
		return state.moveBeforeSlotChange()
	end

	return false
end

function state.questSlotsFinishTransaction(
	message,
	forceRecheck
)
	state.questSlots.busy = false
	questSwitchingAnimal = false

	state.questSlotsNormalizeControl(
		player.Character
	)

	if forceRecheck ~= false then
		state.questForceFastRecheckUntil =
			tick() + 25
	end

	if message then
		runtimeMessage = message
	end
end

local slotIndex = 0
local sessionCompletedSlots = {}
local function isGrowthComplete(value)
	value = tonumber(value)
	if value == nil then return false end
	if value <= 1 then return value >= 0.999 end
	return value >= 99.9
end

local function nextExistingSlot(animalName, records, includeAllAnimals)
	records = records or savedCharacters()
	if #records == 0 then return nil end

	local currentCharacter = player.Character
	local currentName = currentCharacter
		and currentCharacter:GetAttribute("CharacterName")

	for _ = 1, #records do
		slotIndex = slotIndex % #records + 1
		local entry = records[slotIndex]
		local name = type(entry) == "table"
			and entry.CharacterName

		local animalAllowed =
			includeAllAnimals == true
			or (
				type(entry) == "table"
				and not state.questIsFlyingAnimalName(entry.AnimalName)
				and (
					not animalName
					or entry.AnimalName == animalName
				)
			)

		if type(name) == "string"
			and name ~= ""
			and name ~= currentName
			and not sessionCompletedSlots[name]
			and animalAllowed
			and not isGrowthComplete(entry.GrowthPercentage) then

			runtimeMessage = includeAllAnimals
				and string.format(
					"AUTO Grow All: next %s slot -> %s (%s%%)",
					tostring(entry.AnimalName or "animal"),
					name,
					tostring(entry.GrowthPercentage or "?")
				)
				or string.format(
					"Testando slot: %s (salvo: %s)",
					name,
					tostring(entry.GrowthPercentage or "?")
				)

			return entry
		end
	end
end


