local function rebuildResetSpawnOptions()
	refreshCompletionSpawns()
	clearResetSpawnOptions()

	addResetSpawnOption(
		"Default ("
			.. defaultResetSpawnName()
			.. ")",
		nil,
		1
	)

	for index, part in ipairs(
		completionSpawnParts
	) do
		addResetSpawnOption(
			state.spawnLocationLabel(
				part
			),
			part,
			index + 1
		)
	end

	local count =
		#completionSpawnParts + 1

	local rowHeight =
		UserInputService.TouchEnabled
			and 38
			or 34

	local contentHeight =
		count * rowHeight
			+ math.max(
				0,
				count - 1
			) * 5
			+ 12

	local visibleHeight =
		math.min(
			contentHeight,
			UserInputService.TouchEnabled
				and 220
				or 200
		)

	resetSpawnOptions.CanvasSize =
		UDim2.fromOffset(
			0,
			contentHeight
		)

	resetSpawnOptions.Size =
		UDim2.new(
			1,
			0,
			0,
			visibleHeight
		)

	resetSpawnWrap.Size =
		UDim2.new(
			1,
			0,
			0,
			82 + visibleHeight
		)
end

