-- Physical movement input can emit a real KeyUp/Move command that overrides the
-- virtual held W. Reassert ONLY when the player actually interacts with movement
-- controls; there is no continuous W spam.
local function questLandInputShouldStayHeld()
	return state.alive
		and state.autoQuests
		and not state.questGrowthReset.exclusive
		and (state.questLandInputActive or state.questSwimActive)
		and not questSwitchingAnimal
		and not state.busy
		and not criticalRecoveryActive
		and not DAMAGE.active
		and not drinkingToFull
		and not eatingToFull
end

local function reassertQuestWAfterPlayerInput()
	if not questLandInputShouldStayHeld() then return end

	task.defer(function()
		-- Let the physical KeyUp/joystick movement fully reach Roblox first.
		task.wait(0.08)

		if questLandInputShouldStayHeld() then
			state.questHardRefreshW(nil, true)
		end
	end)
end

