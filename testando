		and activeCarcassCommitted
		and activeCarcassStillExists()
		and state.slotSwitchStagingActive ~= true then
		-- A committed carcass remains the objective even when Food is already 100%.
		-- The local carcass controller repairs contact on this SAME Instance; generic
		-- no-progress logic must not convert it into a search for another carcass.
		progressed = true
