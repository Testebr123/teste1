	end

	local remaining = (runtime.circuitOpenUntil or 0) - now
	if remaining > 0 then
		return true, remaining, runtime.circuitReason
	end

	if (runtime.circuitOpenUntil or 0) > 0 then
		runtime.circuitOpenUntil = 0
		runtime.circuitHalfOpen = true
		runtime.circuitProbeBaselinePending = true
		runtime.circuitProbeStartedAt = now
		runtime.active = false
		runtime.lastValue = nil
		runtime.lastExpected = nil
		runtime.lastProgressAt = now
		runtime.recoveryLevel = 0
		runtime.consecutiveFailures = 0
		runtime.levelZeroAt = nil
		runtime.verificationDeadline = 0
		runtime.watchdogFailure = nil
		runtime.watchdogFailureAt = nil
		runtime.status = "revalidating"
		if ai.RecoveryManager
			and ai.RecoveryManager.activeModule == module.name then
			ai.RecoveryManager.activeModule = nil
		end
		ai.Telemetry:Push("CircuitBreaker", "half-open", {
			reason = runtime.circuitReason or "cooldown completed",
			owner = module.owner,
			result = module.name,
		}, "module-half-open:" .. module.name,
			module.name .. " circuit half-open; verifying one fresh attempt")
		if type(ai.RequestWorker) == "function" then
			ai:RequestWorker(module.name, "circuit half-open verification", 0.1)
		end
		if ai.WatchdogManager
			and type(ai.WatchdogManager.ResetModuleProbe) == "function" then
			ai.WatchdogManager:ResetModuleProbe(module.name, now)
		end
	end
	return false, 0
end

function ai.ModuleRegistry:Enabled(module, context)
	if not self:Desired(module, context) then return false end
	local blocked = self:CircuitBlocked(module)
	return not blocked
end

function ai.ModuleRegistry:IsOperational(name, context)
	local module = type(name) == "table" and name or self.modules[name]
	if not module then return true end

	local authorityBypass = ai.Authority
		and ai.Authority.exclusive
		and module.vital
		and module.owner == ai.Authority.currentOwner

	if authorityBypass then return true end

	if module.circuitPersistsWhenIdle then
		local blocked = self:CircuitBlocked(module)
		return not blocked
	end
	return self:Enabled(module, context)
end

function ai.ModuleRegistry:PermitsWorker(name, context)
	local module = type(name) == "table" and name or self.modules[name]
	if not module then return true end
	local blocked = self:CircuitBlocked(module)
	local authorityBypass = ai.Authority
		and ai.Authority.exclusive
		and module.vital
		and module.owner == ai.Authority.currentOwner
	if blocked and not authorityBypass then return false end
	if ai.Authority and not ai.Authority:PermitsWorker(module, context or ai.Blackboard) then
		return false
	end
	return true
end

function ai.ModuleRegistry:DependenciesReady(module, context)
	context = context or ai.Blackboard
	for _, dependency in ipairs(module.dependencies or {}) do
		if dependency == "Character" and not context.characterAlive then
			return false, "waiting for Character"
		end
		local registered = self.modules[dependency]
		if registered and tick() < (registered.runtime.circuitOpenUntil or 0) then
			-- v4.7: Vital survival must not wait behind a Movement diagnostic
			-- cooldown. If Food/Water has reached its normal intervention threshold,
			-- let that module run and prove movement again. This closes the old
			-- "nothing happens until Supervisor forces it much later" deadlock.
			local vitalMovementBypass = dependency == "Movement"
				and module.vital == true
				and (
					module.owner == "Safety"
					or (
						module.owner == "Water"
						and state.autoDrink == true
						and (
							drinkingToFull
							or state.drinkTest.active
							or (tonumber(context.water) or 100) <= 75
						)
					)
					or (
						module.owner == "Food"
						and state.autoEat == true
						and (
							eatingToFull
							or carcassEatBusy
							or (tonumber(context.food) or 100) <= 70
						)
					)
				)

			if not vitalMovementBypass then
				return false, dependency .. " circuit is open"
			end
		end
	end
	return true
end

function ai.ModuleRegistry:ConflictsWith(first, second)
	if not first or not second then return false end
	for _, name in ipairs(first.conflicts or {}) do
		if name == second.name then return true end
	end
	for _, name in ipairs(second.conflicts or {}) do
		if name == first.name then return true end
	end
	return false
end

function ai.ModuleRegistry:ResetRuntime(name, reason)
	local module = self.modules[name]
	if not module then return end
	local runtime = module.runtime
	runtime.active = false
	runtime.activeSince = 0
	runtime.lastProgressAt = tick()
	runtime.lastValue = nil
	runtime.lastExpected = nil
	runtime.status = "idle"
	runtime.failureReason = reason
	runtime.recoveryLevel = 0
	runtime.consecutiveFailures = 0
	runtime.lastRecoveryAt = 0
	runtime.verificationDeadline = 0
	runtime.levelZeroAt = nil
	runtime.circuitOpenUntil = 0
	runtime.circuitHalfOpen = false
	runtime.circuitProbeBaselinePending = false
	runtime.circuitProbeStartedAt = 0
	runtime.circuitReason = nil
	runtime.circuitTrips = 0
	runtime.vitalFallbackUntil = 0
end

ai.MovementManager = {
	lease = nil,
	nextToken = 0,
	pendingCancellation = nil,
	conflict = nil,
	lastConflictAt = 0,
	lastReleaseAt = 0,
	ownerHistory = {},
}

function ai.MovementManager:OwnerForPurpose(purpose)
	purpose = tostring(purpose or "movement")
	local owners = {
		water = "Water",
		water_search = "Water",
		food = "Food",
		herbivore_food_recovery = "Food",
		giraffe_recovery = "Food",
		safety = "Safety",
		quest = "Quest",
		autoRun = "Quest",
		growth_home = "Growth",
		slot_switch = "Slots",
		spawn = "Slots",
		manual = "Manual",
	}
	return owners[purpose] or "Movement"
end

function ai.MovementManager:IsOwnerEnabled(owner, context)
	context = context or ai.Blackboard
	local moduleForOwner = {
		Safety = "Safety",
		Water = "AutoDrink",
		Food = "AutoEat",
		Quest = "AutoQuests",
		Growth = "GrowSlots",
		AFKCoins = "AFKCoins",
		Slots = "Slots",
		Group = "AutoGroup",
	}
	local moduleName = moduleForOwner[owner]
	local ownerModule = moduleName and ai.ModuleRegistry:Get(moduleName) or nil

	-- v4.7: A module circuit is diagnostic/recovery state, NOT user intent.
	-- Using IsOperational() here made an AutoQuests circuit instantly declare the
	-- live Quest movement lease "disabled". Movement then tripped its own circuit,
	-- which in turn delayed AutoEat/AutoDrink because both depend on Movement.
	-- Only the module's desired/toggle state may semantically disable an owner.
	if ownerModule
		and not ai.ModuleRegistry:Desired(ownerModule, context) then
		return false
	end
	if owner == "Safety" then
		local supervisorSafety = ai.Authority
			and ai.Authority.exclusive
			and ai.Authority.currentOwner == "Safety"
		local undergroundWaterOwnsMovement = state.drinkTest.active
		if state.drinkTest.active and not DAMAGE.active then
			-- Stale Supervisor Safety authority may not resurrect a second mover while
			-- the dedicated Underground transaction owns clipping/exit.
			return false
		end
		if undergroundWaterOwnsMovement and not DAMAGE.active and not supervisorSafety then
			return false
		end
		return state.alive == true and (
			supervisorSafety
			or (state.dinoPostDrinkExit and state.dinoPostDrinkExit.active)
			or
			DAMAGE.active
			or criticalRecoveryActive
			or state.aquaticRiverEscape
				and state.aquaticRiverEscape.survivalSuspended
			or state.escapeTerrain
			or state.autoEat
			or state.autoDrink
			or state.autoQuests
			or state.farmCoins
			or state.growthModeActive()
		)
	elseif owner == "Water" then
		local activeWaterRecovery = drinkingToFull
			or state.drinkTest.active
			or ai.Authority
				and ai.Authority.exclusive
				and ai.Authority.currentOwner == "Water"
		return (state.autoDrink == true or activeWaterRecovery)
			and (
				state.autoDrinkMode == "underground"
					and ai.Capabilities.Current.undergroundDrink == true
				or state.autoDrinkMode ~= "underground"
					and ai.Capabilities.Current.surfaceDrink == true
			)
	elseif owner == "Food" then
		local activeFoodRecovery = eatingToFull
			or carcassEatBusy
			or state.herbivoreFoodRecovery and state.herbivoreFoodRecovery.active
			or GIRAFFE and GIRAFFE.exclusiveRecovery and GIRAFFE.exclusiveRecovery.active
			or ai.Authority
				and ai.Authority.exclusive
				and ai.Authority.currentOwner == "Food"
		return (state.autoEat == true or activeFoodRecovery)
			and ai.Capabilities.Current.food == true
	elseif owner == "Quest" then
		return state.autoQuests == true
			and ai.Capabilities.Current.quests == true
	elseif owner == "Growth" then
		return ai.Capabilities.Current.growth == true
			and state.growthModeActive
			and state.growthModeActive() == true
	elseif owner == "AFKCoins" then
		return state.farmCoins == true
			and ai.Capabilities.Current.coinFarm == true
	elseif owner == "Slots" then
		return ai.Capabilities.Current.slots == true
			and (
				state.slotSwitchStagingActive == true
				or state.questSlots.busy
				or questSwitchingAnimal
				or state.coinFarmSwitching
				or state.coinFarmMenuRecovering
				or state.slotParkingAudit.active
				or state.questGrowthReset.exclusive
				or state.slotGuardian.recovering
				or state.autoGrowModeActive()
				or state.autoQuests
				or state.farmCoins
			)
	elseif owner == "Manual" then
		return state.alive == true
	end
	for _, moduleName in ipairs(ai.ModuleRegistry.order) do
		local module = ai.ModuleRegistry.modules[moduleName]
		if module and module.owner == owner
			and ai.ModuleRegistry:Desired(module, context) then
			return true
		end
	end
	return false
end

function ai.MovementManager:DistanceToTarget(context, target)
	context = context or ai.Blackboard
	target = target or (self.lease and self.lease.target)
	if typeof(target) ~= "Vector3" or typeof(context.position) ~= "Vector3" then
		return nil
	end
	return Vector3.new(
		target.X - context.position.X,
		0,
		target.Z - context.position.Z
	).Magnitude
end

function ai.MovementManager:ScoreOwner(owner, context, target)
	context = context or ai.Blackboard
	local food = tonumber(context.food) or 100
	local water = tonumber(context.water) or 100
	local healthFraction = tonumber(context.healthFraction) or 1
	local foodRate = tonumber(context.foodRate) or 0
	local waterRate = tonumber(context.waterRate) or 0
	local healthRate = tonumber(context.healthRate) or 0
	local score = -1000

	if not self:IsOwnerEnabled(owner, context) then
		return score
	end

	if owner == "Safety" then
		score = 150

		if context.inVoid
			or context.buried
			or (
				context.dangerousWater
				and not context.intentionalWaterTransit
			) then

			score += 80
		end
		if healthFraction <= 0.35 then score += (0.35 - healthFraction) * 260 end
		if healthRate < 0 then score += math.min(70, -healthRate * 18) end
		if DAMAGE.active or criticalRecoveryActive then score += 45 end
		if forcingPostDrinkMove or (state.dinoPostDrinkExit and state.dinoPostDrinkExit.active) then score += 120 end
	elseif owner == "Water" then
		score = 65 + (100 - water) * 0.82
		if water <= 60 then score += 32 end
		if water <= 45 then score += 55 end
		if waterRate < 0 then score += math.min(40, -waterRate * 15) end
		if tonumber(context.waterETA) and context.waterETA < 90 then
			score += math.max(0, (90 - context.waterETA) * 0.35)
		end
		if drinkingToFull or state.survivalArbiter.owner == "water" then score += 12 end
	elseif owner == "Food" then
		score = 61 + (100 - food) * 0.86
		if food <= 55 then score += 32 end
		if food <= 35 then score += 48 end
		if foodRate < 0 then score += math.min(35, -foodRate * 13) end
		if tonumber(context.foodETA) and context.foodETA < 90 then
			score += math.max(0, (90 - context.foodETA) * 0.30)
		end
		if eatingToFull or state.survivalArbiter.owner == "food" then score += 10 end
	elseif owner == "Slots" then
		score = state.questGrowthReset.exclusive and 104 or 74
		if state.slotGuardian.recovering then score += 20 end
	elseif owner == "Manual" then
		score = 118
	elseif owner == "Quest" then
		score = 56
		if state.questMovementPriorityPending then score += 12 end
		if state.questSwimActive or state.questLandInputActive then score += 8 end
	elseif owner == "Growth" then
		score = 52
		if state.growExisting or state.growAllSlots or state.growNew then score += 7 end
	elseif owner == "AFKCoins" then
		score = 34
	end

	local distance = self:DistanceToTarget(context, target)
	if distance then
		local speed = math.max(1, tonumber(context.speedLimit) or 12)
		score -= math.min(22, (distance / speed) * 0.12)
	end
	return score
end

function ai.MovementManager:StrongestUrgentOwner(context)
	context = context or ai.Blackboard
	if ai.Authority then
		local owner, score, exclusive = ai.Authority:Elect(context)
		if exclusive and owner ~= "None" then return owner, score end
	end

	-- Non-exclusive behavior remains compatible with the existing Hub.
	local candidates = {}
	local manualOwns = self.lease and self.lease.owner == "Manual"
	local waterNeed = state.autoDrink and (
		(tonumber(context.water) or 100) <= (manualOwns and 42 or 75)
		or drinkingToFull
		or (not manualOwns and (tonumber(context.water) or 100) <= 82 and (tonumber(context.waterRate) or 0) < -0.12)
	)
	local foodNeed = state.autoEat and (
		(tonumber(context.food) or 100) <= (manualOwns and 32 or 70)
		or eatingToFull
		or (not manualOwns and (tonumber(context.food) or 100) <= 88 and (tonumber(context.foodRate) or 0) < -0.15)
	)
	if waterNeed then table.insert(candidates, "Water") end
	if foodNeed then table.insert(candidates, "Food") end
	local bestOwner, bestScore = nil, -math.huge
	for _, owner in ipairs(candidates) do
		local score = self:ScoreOwner(owner, context)
		if score > bestScore then bestOwner, bestScore = owner, score end
	end
	return bestOwner, bestScore
end
function ai.MovementManager:Acquire(owner, reason, target, requestedPriority, options)
	options = type(options) == "table" and options or {}
	local context = ai.Blackboard

	if ai.Authority then
		local permitted, authorityReason = ai.Authority:PermitMovement(owner, reason, target, options)
		if not permitted then return false, nil, authorityReason end
	end
	local supervisorMovementBypass = ai.Authority
		and ai.Authority.exclusive
		and ai.Authority.currentOwner == owner

	-- v4.7: Movement circuit breaker may diagnose a route, but it may never
	-- postpone Survival until critical vitals. The old thresholds here were 55/45,
	-- contradicting aiMovementOperational()'s normal 75/70 fail-open and causing
	-- exactly the long idle period seen after a Quest movement circuit tripped.
	local vitalMovementBypass = supervisorMovementBypass
		or owner == "Safety" or owner == "Manual"
		or owner == "Slots" and state.slotSwitchStagingActive == true
		or owner == "Growth"
			and state.autoGrowModeActive
			and state.autoGrowModeActive()
		or owner == "Water" and state.autoDrink == true and (
			drinkingToFull
			or state.drinkTest.active
			or (tonumber(context.water) or 100) <= 75
		)
		or owner == "Food" and state.autoEat == true and (
			eatingToFull
			or carcassEatBusy
			or (tonumber(context.food) or 100) <= 70
		)
	if not vitalMovementBypass
		and not ai.ModuleRegistry:IsOperational("Movement", context) then
		return false, nil, "Movement circuit is cooling down"
	end
	if owner == "Safety"
		and options.controllerKind == "SafeMove"
		and state.aquaticRiverEscape
		and state.aquaticRiverEscape.survivalSuspended then
		return false, nil, "aquatic UNFLY owns Safety movement"
	end
	if not self.lease and state.safeMove.active then
		local observedOwner = self:OwnerForPurpose(state.safeMove.reason)
		return false, nil, "SafeMove still owned by " .. tostring(observedOwner)
	end
	if typeof(target) ~= "Vector3" then
		return false, nil, "missing target"
	end
	if not self:IsOwnerEnabled(owner, context) then
		return false, nil, "owner disabled"
	end
	if not self.lease then
		for _, activeController in ipairs(self:ActualOwners(context)) do
			if activeController.owner ~= owner then
				self:CancelOwner(
					activeController.owner,
					"physical controller handoff requested by " .. tostring(owner)
				)
				return false, nil,
					"awaiting physical controller: " .. tostring(activeController.owner)
			end
		end
	end

	local blocked, remaining = ai.Memory:IsBlocked("route", target)
	local criticalWater = owner == "Water" and (tonumber(context.water) or 100) <= 45
	local criticalFood = owner == "Food" and (tonumber(context.food) or 100) <= 45
	if blocked and owner ~= "Safety" and owner ~= "Manual"
		and not (owner == "Slots" and state.slotSwitchStagingActive == true)
		and not criticalWater and not criticalFood then
		return false, nil, string.format("route circuit open %.0fs", remaining)
	end

	local priority = tonumber(requestedPriority)
		or self:ScoreOwner(owner, context, target)
	local urgentOwner, urgentPriority = self:StrongestUrgentOwner(context)
	if urgentOwner and urgentOwner ~= owner and urgentPriority > priority + 1 then
		return false, nil, "higher priority: " .. urgentOwner
	end

	local now = tick()
	local current = self.lease
	if current and current.owner ~= owner then
		local currentScore = self:ScoreOwner(current.owner, context, current.target)
		local stale = now - (current.lastPulseAt or current.startedAt or now) > 2.5
		if not stale and priority <= currentScore + 0.5 then
			return false, nil, "movement owned by " .. tostring(current.owner)
		end
		local awaitingRelease = self:CancelOwner(current.owner, "preempted by " .. owner)
		if awaitingRelease or self.lease then
			return false, nil, "preemption requested; awaiting owner release"
		end
	end

	if self.lease and self.lease.owner == owner then
		if self.lease.cancelRequestedAt then
			return false, nil, "owner is releasing movement"
		end
		if options.controllerKind == "SafeMove"
			and self.lease.controllerKind == "direct" then
			-- Semantic owner is unchanged; hand its direct observation to the
			-- concrete SafeMove generation instead of sharing one completion token.
			self.lease = nil
		else
			self.lease.reason = reason or self.lease.reason
			self.lease.target = target
			self.lease.priority = priority
			self.lease.lastPulseAt = now
			return true, self.lease.token
		end
	end

	self.nextToken += 1
	self.lease = {
		owner = owner,
		reason = tostring(reason or "movement"),
		priority = priority,
		target = target,
		startedAt = now,
		lastProgressAt = now,
		lastPulseAt = now,
		lastDistance = self:DistanceToTarget(context, target) or math.huge,
		cancelToken = state.safeMove.cancelToken,
		controllerKind = options.controllerKind or "direct",
		token = self.nextToken,
	}
	table.insert(self.ownerHistory, 1, {
		owner = owner,
		reason = reason,
		at = now,
	})
	while #self.ownerHistory > 24 do table.remove(self.ownerHistory) end
	ai.Memory:Remember("owners", owner, reason, 300)
	ai.Telemetry:Push("MovementManager", "acquire", {
		owner = owner,
		reason = reason,
		target = target,
	})
	return true, self.lease.token
end

function ai.MovementManager:AcquireFromSafeMove(purpose, target, options)
	local owner = self:OwnerForPurpose(purpose)
	local priority = self:ScoreOwner(owner, ai.Blackboard, target)
	if purpose == "water_search" then
		ai.Memory:Remember("spawns", target, "water search transit", 600)
	end
	local requestOptions = {}
	for key, value in pairs(type(options) == "table" and options or {}) do
		requestOptions[key] = value
	end
	requestOptions.controllerKind = "SafeMove"
	return self:Acquire(owner, purpose, target, priority, requestOptions)
end

function ai.MovementManager:Pulse(owner, reason, target, requestedPriority)
	if self.lease and self.lease.owner == owner then
		if self.lease.cancelRequestedAt then
			return false, nil, "owner is releasing movement"
		end
		local urgentOwner, urgentPriority = self:StrongestUrgentOwner(ai.Blackboard)
		local ownerPriority = self:ScoreOwner(owner, ai.Blackboard, target)
		if urgentOwner and urgentOwner ~= owner
			and urgentPriority > ownerPriority + 1 then
			return false, nil, "higher priority: " .. urgentOwner
		end
		self.lease.lastPulseAt = tick()
		if typeof(target) == "Vector3" then self.lease.target = target end
		return true, self.lease.token
	end
	return self:Acquire(owner, reason, target, requestedPriority)
end

function ai.MovementManager:Complete(token, success, reason)
	local lease = self.lease
	if not lease or lease.token ~= token then return false end

	local cancelled = type(reason) == "string"
		and (
			reason:lower():find("cancel", 1, true)
			or reason:lower():find("preempt", 1, true)
			or reason:lower():find("disabled", 1, true)
			or reason:lower():find("priority", 1, true)
		)

	if success then
		ai.Memory:MarkSuccess("route", lease.target)
		local movementModule = ai.ModuleRegistry:Get("Movement")
		if movementModule and (
			movementModule.runtime.circuitHalfOpen
			or tick() < (movementModule.runtime.circuitOpenUntil or 0)
		) then
			-- A completed physical route is stronger evidence than the old diagnostic
			-- cooldown. Clear it immediately so Quest can resume after Survival.
			ai.RecoveryManager:Reset(
				movementModule,
				"verified movement route completed"
			)
		end
		if lease.owner == "Slots" and ai.SlotVerification then
			ai.SlotVerification.positionSequence += 1
			ai.SlotVerification.lastPosition = lease.target
			ai.SlotVerification.lastPositionAt = tick()
		end
		ai.Telemetry:Push("MovementManager", "complete", {
			owner = lease.owner,
			reason = reason or lease.reason,
			target = lease.target,
			result = "success",
		})
	elseif cancelled then
		ai.Telemetry:Push("MovementManager", "cancel", {
			owner = lease.owner,
			reason = reason or lease.reason,
			target = lease.target,
			result = "cancelled",
		})
	else
		ai.Memory:MarkFailure("route", lease.target, reason or lease.reason, 35)
		ai.Telemetry:Push("MovementManager", "failure", {
			owner = lease.owner,
			reason = reason or lease.reason,
			target = lease.target,
			result = "failed",
		})
	end

	self.lease = nil
	self.pendingCancellation = nil
	self.lastReleaseAt = tick()
	return true
end

function ai.MovementManager:CancelOwner(owner, reason, force)
	force = force == true
	local ownedLease = self.lease and self.lease.owner == owner
	local safeOwner = state.safeMove.active
		and self:OwnerForPurpose(state.safeMove.reason)
		or nil

	local undergroundReleasePending = owner == "Water"
		and state.drinkTest
		and state.drinkTest.active
	local trapReleasePending = state.confirmedTrapFly
		and state.confirmedTrapFly.busy
		and state.confirmedTrapFly.owner == owner
	local carcassReleasePending = owner == "Food"
		and carcassEatBusy
	local protectedAquatic = not force
		and owner == "Safety"
		and state.aquaticRiverEscape
		and state.aquaticRiverEscape.survivalSuspended
	local awaitingRelease = safeOwner == owner
		or undergroundReleasePending
		or trapReleasePending
		or carcassReleasePending
		or protectedAquatic
	if awaitingRelease then
		local lease = self.lease
		if safeOwner == owner and (not lease or not lease.cancelRequestedAt) then
			state.safeMove.cancelToken += 1
		end
		if lease and lease.owner == owner and not protectedAquatic then
			lease.cancelRequestedAt = tick()
			lease.cancelReason = reason
		end
		self.pendingCancellation = {
			owner = owner,
			reason = reason,
			at = tick(),
		}
	end
	if trapReleasePending then
		state.confirmedTrapFly.cancelRequested = true
	end
	if carcassReleasePending then
		state.carcassController.cancelRequested = true
		state.carcassController.token += 1
	end

	if force and owner == "Food" then
		eatingToFull = false
		eatingSourcePosition = nil
		eatingTargetReachedAt = nil
		eatingStuckSince = nil
		carcassEatBusy = false
		if state.carcassController then
			state.carcassController.cancelRequested = true
			state.carcassController.token += 1
		end
		if activeCarcass then clearActiveCarcass(true) end

		if state.herbivoreFoodRecovery and state.herbivoreFoodRecovery.active
			and state.herbivoreFoodRecoveryFinish then
			pcall(
				state.herbivoreFoodRecoveryFinish,
				state.herbivoreFoodRecovery.token,
				false,
				"Supervisor suspended subordinate herbivore watchdog"
			)
		end
		if GIRAFFE and GIRAFFE.exclusiveRecovery and GIRAFFE.exclusiveRecovery.active
			and state.giraffeExclusiveRecoveryFinish then
			pcall(
				state.giraffeExclusiveRecoveryFinish,
				GIRAFFE.exclusiveRecovery.token,
				false,
				"Supervisor suspended subordinate Giraffe watchdog"
			)
		end
	end

	if force and owner == "Water" then
		local liveCharacter = player.Character

		local actualDrinkContact =
			state.drinkProgress
			and state.drinkProgress.confirmed
			or drinkingSourcePosition ~= nil
			or (
				liveCharacter
				and state.drinkGamePromptAvailable
				and state.drinkGamePromptAvailable(
					liveCharacter
				)
			)
			or (
				state.drinkVisualPromptVisible
				and state.drinkVisualPromptVisible()
			)

		if actualDrinkContact
			and state.forceStopActiveDrink then

			pcall(
				state.forceStopActiveDrink,
				liveCharacter,
				"Supervisor survival handoff"
			)
		else
			drinkingToFull = false
			drinkingSourcePosition = nil
			drinkingStuckSince = nil
		end

		-- forcingPostDrinkMove belongs to Safety. A Water handoff/cancel must never
		-- terminate the dry-bank extractor; doing so stranded Dino/Savannah animals
		-- half inside the river with Food selected but no physical controller.

		if state.drinkTest
			and state.drinkTest.active then

			state.drinkTest.cancelRequested = true
		end
	end

	if force and owner == "Safety" then
		if DAMAGE.active then
			DAMAGE.cancelToken += 1
			DAMAGE.active = false
			DAMAGE.cooldownUntil = 0
			criticalRecoveryActive = false
		end

		if state.aquaticRiverEscape then
			state.aquaticRiverEscape.busy = false
			state.aquaticRiverEscape.retryAt = 0
			if state.aquaticRiverEscape.survivalSuspended
				and state.aquaticSurvivalResume then
				pcall(state.aquaticSurvivalResume, player.Character)
			end
		end

		if state.dinoShorelineRecovery and state.dinoShorelineRecovery.active then
			state.dinoShorelineRecovery.token += 1
			state.dinoShorelineRecovery.active = false
			state.dinoShorelineRecovery.character = nil
			state.dinoShorelineRecovery.target = nil
		end

		if state.dinoRockEmergency and state.dinoRockEmergency.supervisorActive then
			state.dinoRockEmergency.supervisorToken += 1
			state.dinoRockEmergency.supervisorActive = false
			state.dinoRockEmergency.supervisorCharacter = nil
			state.dinoRockEmergency.supervisorTarget = nil
		end
	end
	if force then
		awaitingRelease = false
		self.pendingCancellation = nil
	end

	if protectedAquatic then
		ai.Telemetry:Push("MovementManager", "protected-handoff", {
			owner = "Safety",
			reason = reason,
			result = "aquatic UNFLY must acknowledge first",
		}, "protected-aquatic-handoff",
			"Aquatic safety controller retained until dry-bank acknowledgement")
	end

	if owner == "Quest" then
		state.questMotionMoving = false
		state.questMotionMode = nil
		state.autoRunMoveOwnsInput = false
		if state.questSetW then pcall(state.questSetW, false) end
		if state.questSetLandPermanentW then pcall(state.questSetLandPermanentW, false) end
		if state.heavyWalk and state.heavyWalk.owner == "autoRun" then
			pcall(state.heavyWalkStop, player.Character)
		end
	elseif owner == "Manual" and state.safeMove.reason == "manual"
		and not awaitingRelease then
		state.safeMove.cancelToken += 1
	elseif owner == "Growth"
		and state.safeMove.reason == "growth_home"
		and not awaitingRelease then
		state.safeMove.cancelToken += 1
	elseif owner == "Food" then
		if state.safeMove.reason == "food" and not awaitingRelease then
			state.safeMove.cancelToken += 1
		end
		BABOON.cancel()
		GIRAFFE.cancel()
	elseif owner == "Water" then
		if state.safeMove.reason == "water"
			or state.safeMove.reason == "water_search" then
			if not awaitingRelease then
			state.safeMove.cancelToken += 1
			end
		end
		if state.drinkTest and state.drinkTest.active then
			state.drinkTest.cancelRequested = true
		end
	end
	if ownedLease and state.heavyWalk and state.heavyWalk.owner == "nudge" then
		pcall(state.heavyWalkStop, player.Character)
	end

	if self.lease and self.lease.owner == owner then
		ai.Telemetry:Push("MovementManager", "cancel", {
			owner = owner,
			reason = reason,
			target = self.lease.target,
		})
		if not awaitingRelease then
			self.lease = nil
			self.pendingCancellation = nil
			self.lastReleaseAt = tick()
		end
	end
	return awaitingRelease
end

function ai.MovementManager:ActualOwners(context)
	local result = {}
	local seen = {}
	local function add(owner, source)
		if owner and not seen[owner] then
			seen[owner] = true
			table.insert(result, { owner = owner, source = source })
		end
	end

	if DAMAGE.active then
		add("Safety", "recovery")
	end
	if state.dinoShorelineRecovery and state.dinoShorelineRecovery.active then
		add("Safety", "Dino shoreline recovery")
	end
	if state.dinoRockEmergency and state.dinoRockEmergency.supervisorActive then
		add("Safety", "Dino rock recovery")
	end
	if state.aquaticRiverEscape
		and state.aquaticRiverEscape.survivalSuspended then
		add("Safety", "aquatic position controller")
	end
	if state.herbivoreFoodRecovery
		and state.herbivoreFoodRecovery.active then
		add("Food", "central herbivore food recovery")
	end
	if GIRAFFE
		and GIRAFFE.exclusiveRecovery
		and GIRAFFE.exclusiveRecovery.active then
		add("Food", "Giraffe exclusive Pride recovery")
	end
	if state.drinkTest.hardExitBusy and not state.drinkTest.active then
		add("Safety", "Terrain hard-eject controller")
	end
	if state.drinkTest.active then
		add("Water", "underground drink transaction")
	end
	if forcingPostDrinkMove
		or (state.dinoPostDrinkExit and state.dinoPostDrinkExit.active) then
		-- Post-drink movement is an extraction to verified dry Terrain. It is
		-- Safety-owned, not Water-owned. Classifying it as Water made Authority
		-- cancel its own exit controller whenever Safety became exclusive.
		add("Safety", "post-drink dry-bank controller")
	end
	if CROC.approachBusy then add("Water", "Croc drink approach") end
	if BABOON.busy or GIRAFFE.busy or carcassEatBusy then
		add("Food", "special food controller")
	end
	if state.confirmedTrapFly and state.confirmedTrapFly.busy then
		add(state.confirmedTrapFly.owner, "confirmed-trap position controller")
	end
	if state.safeMove.active then
		add(self:OwnerForPurpose(state.safeMove.reason), "SafeMove")
	end
	if state.questMotionMoving
		or state.autoRunMoveOwnsInput
		or state.questLandKeyDown then
		add("Quest", "quest locomotion")
	end
	if state.heavyWalk and state.heavyWalk.owner then
		if state.heavyWalk.owner == "autoRun" then add("Quest", "heavyWalk") end
		if state.heavyWalk.owner == "manual" then add("Manual", "heavyWalk") end
		if state.heavyWalk.owner == "safeMove" and state.safeMove.active then
			add(self:OwnerForPurpose(state.safeMove.reason), "heavyWalk")
		end
		if state.heavyWalk.owner == "nudge" and self.lease then
			add(self.lease.owner, "precision nudge")
		end
	end
	return result
end

function ai.MovementManager:Reconcile(context)
	context = context or ai.Blackboard
	if ai.Authority then ai.Authority:Enforce(context) end
	local owners = self:ActualOwners(context)
	local permittedOwners = {}
	for _, entry in ipairs(owners) do
		if state.aiMovementOperational(entry.owner) then
			table.insert(permittedOwners, entry)
		else
			self:CancelOwner(entry.owner, "Movement circuit cooldown")
		end
	end
	owners = permittedOwners
	if #owners > 1 then
		local winner
		local winnerScore = -math.huge
		if ai.Authority and ai.Authority.exclusive then
			for _, entry in ipairs(owners) do
				if entry.owner == ai.Authority.currentOwner then
					winner = entry.owner
					winnerScore = math.huge
					break
				end
			end
		end
		if not winner then
			for _, entry in ipairs(owners) do
				local score = self:ScoreOwner(entry.owner, context, self.lease and self.lease.target)
				if score > winnerScore then winner, winnerScore = entry.owner, score end
			end
		end
		local labels = {}
		for _, entry in ipairs(owners) do
			table.insert(labels, entry.owner)
			if entry.owner ~= winner then
				self:CancelOwner(entry.owner, "movement conflict; " .. winner .. " won")
			end
		end
		self.conflict = table.concat(labels, " vs ") .. " -> " .. tostring(winner)
		self.lastConflictAt = tick()
		ai.Blackboard.lastProblem = self.conflict
		ai.Telemetry:Push("MovementManager", "conflict", {
			reason = self.conflict,
			owner = winner,
		}, "movement-conflict:" .. self.conflict,
			"Movement conflict resolved: " .. tostring(winner) .. " > " .. table.concat(labels, "/"))
	elseif tick() - (self.lastConflictAt or 0) > 4 then
		self.conflict = nil
	end

	if self.lease then
		local leaseOwnerPresent = false
		for _, entry in ipairs(owners) do
			if entry.owner == self.lease.owner then
				leaseOwnerPresent = true
				break
			end
		end
		if not leaseOwnerPresent and (
			self.lease.controllerKind == "direct"
			or self.lease.cancelRequestedAt ~= nil
			or tick() - (self.lease.lastPulseAt or 0) > 2.5
		) then
			self.lease = nil
			self.pendingCancellation = nil
			self.lastReleaseAt = tick()
		end
	end

	local actual = owners[1] and owners[1].owner or nil
	if #owners > 1 then
		local actualScore = -math.huge
		actual = nil
		for _, entry in ipairs(owners) do
			local score = self:ScoreOwner(
				entry.owner,
				context,
				self.lease and self.lease.target
			)
			if score > actualScore then
				actual = entry.owner
				actualScore = score
			end
		end
	end
	if self.lease and self.lease.cancelRequestedAt then
		local releasingOwnerPresent = false
		for _, entry in ipairs(owners) do
			if entry.owner == self.lease.owner then
				releasingOwnerPresent = true
				break
			end
		end
		if not releasingOwnerPresent then
			local releasedOwner = self.lease.owner
			self.lease = nil
			self.pendingCancellation = nil
			self.lastReleaseAt = tick()
			actual = nil
			local actualScore = -math.huge
			for _, entry in ipairs(owners) do
				if entry.owner ~= releasedOwner then
					local score = self:ScoreOwner(entry.owner, context)
					if score > actualScore then
						actual = entry.owner
						actualScore = score
					end
				end
			end
		elseif tick() - self.lease.cancelRequestedAt > 8
			and not self.lease.releaseOverdueAt then
			self.lease.releaseOverdueAt = tick()
			ai.Telemetry:Push("MovementManager", "release-overdue", {
				owner = self.lease.owner,
				reason = self.lease.cancelReason or "owner release not acknowledged",
				result = "lease retained until physical controller exits",
			}, "movement-release-overdue:" .. tostring(self.lease.owner),
				"Movement owner release overdue; waiting for physical acknowledgement")
		end
	end

	if self.lease then
		local distance = self:DistanceToTarget(context, self.lease.target)
		if distance and distance + 1.25 < (self.lease.lastDistance or math.huge) then
			self.lease.lastDistance = distance
			self.lease.lastProgressAt = tick()
			ai.Blackboard.lastProgressAt = tick()
		end
		if not actual and tick() - (self.lease.lastPulseAt or 0) > 2.5 then
			self.lease = nil
		elseif actual and self.lease.owner ~= actual then
			local score = self:ScoreOwner(actual, context)
			if score >= self.lease.priority then
				self.nextToken += 1
				self.lease = {
					owner = actual,
					reason = "observed direct controller",
					priority = score,
					target = state.safeMove.target,
					startedAt = tick(),
					lastProgressAt = tick(),
					lastPulseAt = tick(),
					lastDistance = math.huge,
					controllerKind = "direct",
					token = self.nextToken,
				}
			end
		end
	elseif actual then
		local target = state.safeMove.target
		if typeof(target) ~= "Vector3" and typeof(context.position) == "Vector3" then
			target = context.position
		end
		if typeof(target) == "Vector3" then
			self.nextToken += 1
			self.lease = {
				owner = actual,
				reason = "observed direct controller",
				priority = self:ScoreOwner(actual, context, target),
				target = target,
				startedAt = tick(),
				lastProgressAt = tick(),
				lastPulseAt = tick(),
				lastDistance = self:DistanceToTarget(context, target) or math.huge,
				controllerKind = "direct",
				token = self.nextToken,
			}
		end
	end

	context.currentOwner = self.lease and self.lease.owner or "None"
	context.movementOwner = context.currentOwner
	context.movementTarget = self.lease and self.lease.target or state.safeMove.target
	context.movementReason = self.lease and self.lease.reason or state.safeMove.reason
	context.movementConflict = self.conflict
	return context.currentOwner
end

ai.Context = {
	vitalSamples = {},
	lastSampleAt = 0,
	lastCharacter = nil,
	lastPosition = nil,
	lastPositionAt = 0,
	lastMotionAt = tick(),
	travelDistance = 0,
	environmentCharacter = nil,
	lastEnvironmentProbeAt = 0,
	cachedBuried = false,
	cachedDangerousWater = false,
}

function ai.Context:Rate(field, seconds)
	local samples = self.vitalSamples
	if #samples < 2 then return 0 end
	local newest = samples[#samples]
	local cutoff = newest.at - (tonumber(seconds) or 30)
	local oldest = samples[1]
	for index = #samples - 1, 1, -1 do
		if samples[index].at <= cutoff then
			oldest = samples[index]
			break
		end
		oldest = samples[index]
	end
	local duration = newest.at - oldest.at
	if duration < 1 then return 0 end
	return ((tonumber(newest[field]) or 0) - (tonumber(oldest[field]) or 0)) / duration
end

function ai.Context:ETA(value, rate, critical)
	value = tonumber(value)
	rate = tonumber(rate)
	critical = tonumber(critical)
	if not value or not rate or not critical or rate >= -0.001 then
		return math.huge
	end
	return math.max(0, (value - critical) / -rate)
end

function ai.Context:Update(sampleVitals)
	local board = ai.Blackboard
	local now = tick()
	local character, root, humanoid = characterParts()

	board.timestamp = now
	board.game = ai.Capabilities.Game
	board.capabilities = ai.Capabilities.Current
	board.character = character
	board.root = root
	board.humanoid = humanoid
	board.characterAlive = character ~= nil
		and humanoid ~= nil
		and humanoid.Health > 0

	if character then
		board.animal = tostring(character:GetAttribute("AnimalName") or character.Name or "Unknown")
		board.slot = tostring(character:GetAttribute("CharacterName") or "Unknown")
		board.food = tonumber(character:GetAttribute("Food")) or 100
		board.water = tonumber(character:GetAttribute("Water")) or 100
		local rawGrowth = tonumber(character:GetAttribute("GrowthPercentage")) or 0
		board.growthRaw = rawGrowth
		board.growth = rawGrowth <= 1.001 and rawGrowth * 100 or rawGrowth
	else
		board.animal = "None"
		board.slot = "None"
		board.food = 0
		board.water = 0
		board.growthRaw = 0
		board.growth = 0
	end

	if humanoid then
		board.health = tonumber(humanoid.Health) or 0
		board.maxHealth = math.max(1, tonumber(humanoid.MaxHealth) or 1)
		board.healthFraction = board.health / board.maxHealth
		local ok, humanoidState = pcall(humanoid.GetState, humanoid)
		board.humanoidState = ok and humanoidState.Name or "Unknown"
	else
		board.health = 0
		board.maxHealth = 1
		board.healthFraction = 0
		board.humanoidState = "Missing"
	end

	if root then
		board.position = root.Position
		board.velocity = root.AssemblyLinearVelocity
		board.speed = Vector3.new(board.velocity.X, 0, board.velocity.Z).Magnitude
		board.speedLimit = character and state.safeMovementSpeed(character) or 12
		if self.lastCharacter ~= character then
			self.lastCharacter = character
			self.lastPosition = root.Position
			self.lastPositionAt = now
			self.lastMotionAt = now
			self.travelDistance = 0
		elseif not self.lastPosition
			or Vector3.new(
				root.Position.X - self.lastPosition.X,
				0,
				root.Position.Z - self.lastPosition.Z
			).Magnitude >= 1.25 then
			local motionDistance = Vector3.new(
				root.Position.X - self.lastPosition.X,
				0,
				root.Position.Z - self.lastPosition.Z
			).Magnitude
			self.travelDistance += motionDistance
			board.lastPosition = self.lastPosition
			self.lastPosition = root.Position
			self.lastPositionAt = now
			self.lastMotionAt = now
		end
	else
		board.position = nil
		board.velocity = Vector3.zero
		board.speed = 0
		board.speedLimit = 12
	end
	board.lastMotionAt = self.lastMotionAt
	board.noMotionFor = now - (self.lastMotionAt or now)
	board.travelDistance = self.travelDistance

	if sampleVitals ~= false and now - self.lastSampleAt >= 0.45 and character then
		self.lastSampleAt = now
		table.insert(self.vitalSamples, {
			at = now,
			food = board.food,
			water = board.water,
			health = board.healthFraction * 100,
			growth = board.growth,
		})
		while #self.vitalSamples > 120 do table.remove(self.vitalSamples, 1) end
	end

	board.foodRate = self:Rate("food", 30)
	board.waterRate = self:Rate("water", 30)
	board.healthRate = self:Rate("health", 12)
	board.growthRate = self:Rate("growth", 45)
	board.foodETA = self:ETA(board.food, board.foodRate, 35)
	board.waterETA = self:ETA(board.water, board.waterRate, 35)
	board.healthETA = self:ETA(board.healthFraction * 100, board.healthRate, 20)

	board.safeMoveActive = state.safeMove.active == true
	board.safeMoveTarget = state.safeMove.target
	board.safeMoveReason = state.safeMove.reason
	board.goingToFood = state.safeMove.active and state.safeMove.reason == "food"
	board.goingToWater = state.safeMove.active
		and (state.safeMove.reason == "water" or state.safeMove.reason == "water_search")
	board.eating = eatingToFull
		or carcassEatBusy
		or BABOON.busy
		or GIRAFFE.busy
	board.drinkingProtected =
		character
		and state.drinkTransactionProtected
		and state.drinkTransactionProtected(
			character
		)
		or false

	board.drinking =
		drinkingToFull
		or state.drinkTest.active
		or state.drinkProgress.confirmed
		or board.drinkingProtected

	board.questing = state.autoQuests == true
	board.growing = state.growthModeActive() == true
	board.farmingCoins = state.farmCoins == true
	board.grouping = state.questGroup.createInFlight
		or state.questGroup.coop.helperActive
	board.resettingSpawn = state.questGrowthReset.exclusive
		or state.slotParkingAudit.active
	board.switchingSlot = questSwitchingAnimal
		or state.questSlots.busy
		or state.coinFarmSwitching
	board.recoveringDamage = DAMAGE.active == true
	board.criticalRecovery = criticalRecoveryActive == true
	board.activeCarcass = activeCarcass
	board.carcassBusy = carcassEatBusy
	local carcassBlocked, carcassCooldown = false, 0
	if activeCarcass then
		carcassBlocked, carcassCooldown = ai.Memory:IsBlocked("carcass", activeCarcass)
	end
	board.carcassBlocked = carcassBlocked
	board.carcassCooldown = carcassCooldown
	board.questStatus = questStatusText
	board.questExpectedSlot = state.questExpectedSlot
	local stalledQuest = ai.QuestTracker:StalledQuest(now)
	board.questAwaitingProgress = stalledQuest and stalledQuest.id or nil
	board.userIntentVersion = ai.UserIntent and ai.UserIntent.version or 0
	board.cooldowns = {
		drinkRetry = math.max(0, (state.drinkSearch.retryAfter or 0) - now),
		drinkBackend = math.max(0, (state.drinkTest.retryAfter or 0) - now),
		coinRetry = math.max(0, (state.coinFarmRetryAt or 0) - now),
		growthReset = math.max(0, (state.questGrowthReset.failedUntil or 0) - now),
	}

	board.inVoid = root ~= nil and root.Position.Y < config.dangerY
	local environmentChanged = self.environmentCharacter ~= character
	local urgentEnvironment = board.inVoid
		or DAMAGE.active
		or criticalRecoveryActive
		or board.drinking
	local environmentInterval = urgentEnvironment and 0.45 or 2.0
	if root and (
		environmentChanged
		or now - (self.lastEnvironmentProbeAt or 0) >= environmentInterval
	) then
		self.environmentCharacter = character
		self.lastEnvironmentProbeAt = now
		self.cachedBuried = not isDinoLife
			and state.drinkIsBuriedUnderTerrain(root)
			or false
		local intentionalWaterTransit =
			state.intentionalWaterTransitActive
			and state.intentionalWaterTransitActive(
				character,
				root
			)
			or false

		self.cachedDangerousWater =
			not intentionalWaterTransit
			and state.supervisorDangerousWaterHazard(
				character,
				root
			)
			or false

		board.intentionalWaterTransit =
			intentionalWaterTransit
	elseif not root then
		self.environmentCharacter = character
		self.cachedBuried = false
		self.cachedDangerousWater = false
	end
	local undergroundDrinkTerrainProtected =
		state.undergroundDrinkTerrainProtected
		and state.undergroundDrinkTerrainProtected(character)
		or false

	if undergroundDrinkTerrainProtected then
		self.cachedBuried = false
	end

	board.buried = self.cachedBuried == true
		and not undergroundDrinkTerrainProtected
	board.intentionalWaterTransit =
		state.intentionalWaterTransitActive
		and root
		and state.intentionalWaterTransitActive(
			character,
			root
		)
		or false

	board.dangerousWater =
		self.cachedDangerousWater == true
		and not board.intentionalWaterTransit
		and not board.drinking
		and not board.drinkingProtected
		and not state.questSwimActive

	board.dinoShorelineFoodDeadlock =
		not board.drinkingProtected
		and not board.intentionalWaterTransit
		and state.dinoShorelineSafetyHazardLive(
			character,
			root
		)
		or false

	board.dinoRockTrapped =
		state.dinoRockSafetyHazardLive()
		and not (
			state.dinoRockEmergency
				and state.dinoRockEmergency.supervisorActive
		)
		or false
	board.dinoRockNearby = state.dinoRockEmergency and state.dinoRockEmergency.moralNearby or 0
	board.dinoRockOpenCorridors = state.dinoRockEmergency and state.dinoRockEmergency.moralOpenCorridors or 16

	ai.MovementManager:Reconcile(board)
	return board
end

ai.GoalManager = {
	current = "Idle",
	previous = nil,
	currentSince = tick(),
	suspended = {},
	lastChoice = nil,
	lastScore = 0,
}

-- Public decision facade: external modules can register goals without editing
-- the coordinator's fixed survival candidates.
ai.DecisionEngine = ai.GoalManager

function ai.GoalManager:Candidates(context)
	local candidates = {}
	local function operational(moduleName)
		return ai.ModuleRegistry:IsOperational(moduleName, context)
	end
	local representedModules = {
		Safety = true, Movement = true, AutoDrink = true, AutoEat = true,
		Slots = true, AutoQuests = true, GrowSlots = true, AFKCoins = true,
	}
	local function add(name, owner, reason, target, moduleName, scoreOverride)
		local score = ai.MovementManager:ScoreOwner(owner, context, target)
		if type(scoreOverride) == "number" then score = scoreOverride end
		if moduleName then representedModules[moduleName] = true end
		table.insert(candidates, {
			name = name,
			owner = owner,
			reason = reason,
			target = target,
			score = score,
			moduleName = moduleName,
		})
	end

	local protectedController = state.hasProtectedMovementController()
	local undergroundDrinkTerrainProtected =
		state.undergroundDrinkTerrainProtected
		and state.undergroundDrinkTerrainProtected(context.character)
		or false
	local healthRisk = (
		context.inVoid
		or (context.buried and not undergroundDrinkTerrainProtected)
		or (
			context.dangerousWater
				and not context.intentionalWaterTransit
		)
		or context.dinoRockTrapped
		or context.dinoShorelineFoodDeadlock
		or forcingPostDrinkMove
		or (state.dinoPostDrinkExit and state.dinoPostDrinkExit.active)
		or context.healthFraction <= 0.35
		or context.healthRate < -0.8
	)
	if (healthRisk or DAMAGE.active) and operational("Safety") then
		add(
			"Survival: Safety",
			"Safety",
			protectedController and "Supervisor monitoring subordinate recovery" or "health/environment risk",
			context.position,
			"Safety"
		)
	end

	local waterNeed = state.autoDrink and (
		context.water <= 75
		or drinkingToFull
		or (context.water <= 82 and context.waterRate < -0.12)
		or context.waterETA < 80
	)
	local foodEnabled =
		state.autoEat
		or (
			state.herbivoreFoodRecoveryEatWanted
			and state.herbivoreFoodRecoveryEatWanted()
		)
	local foodNeed = foodEnabled and (
		context.food <= 70
		or eatingToFull
		or (context.food <= 88 and context.foodRate < -0.15)
		or context.foodETA < 75
	)
	if waterNeed and operational("AutoDrink") then
		add("Survival: Water", "Water", "thirst trend/commitment", state.drinkSearch.currentWaterPoint, "AutoDrink")
	end
	if foodNeed and operational("AutoEat") then
		add("Survival: Food", "Food", "hunger trend/commitment", eatingSourcePosition, "AutoEat")
	end
	if state.slotSwitchStagingActive == true
		or state.questGrowthReset.exclusive
		or state.slotParkingAudit.active
		or state.questSlots.busy
		or state.coinFarmSwitching
		or state.slotGuardian.recovering then
		if operational("Slots") then
			add("Slot Pipeline", "Slots", "slot/reset transaction", state.safeMove.target, "Slots")
		end
	end
	if state.safeMove.active
		and state.safeMove.reason == "manual" then

		add(
			"Manual Move",
			"Manual",
			"player requested movement",
			state.safeMove.target
		)

	elseif state.safeMove.manualRequestPending
		and typeof(
			state.safeMove.manualPendingTarget
		) == "Vector3" then

		add(
			"Manual Move",
			"Manual",
			"player requested movement is queued",
			state.safeMove.manualPendingTarget
		)
	end
	if state.autoQuests and ai.Capabilities.Current.quests
		and operational("AutoQuests") then
		add("Auto Quests", "Quest", questStatusText, state.questZoneFarmTarget or state.safeMove.target, "AutoQuests")
	end
	if state.growthModeActive() and ai.Capabilities.Current.growth
		and operational("GrowSlots") then
		add("Grow Slots", "Growth", "active Growth pipeline", state.growthPride.home, "GrowSlots")
	end
	if state.farmCoins and ai.Capabilities.Current.coinFarm
		and operational("AFKCoins") then
		add("AFK Coin Farm", "AFKCoins", "passive farm requested", nil, "AFKCoins")
	end

	-- Registered modules participate automatically; adding one does not require
	-- another hard-coded branch in the decision engine.
	for _, moduleName in ipairs(ai.ModuleRegistry.order) do
		local module = ai.ModuleRegistry.modules[moduleName]
		if module and not representedModules[moduleName]
			and ai.ModuleRegistry:Enabled(module, context) then
			local dependenciesReady, dependencyReason =
				ai.ModuleRegistry:DependenciesReady(module, context)
			if dependenciesReady then
				local reason = type(module.objective) == "function"
					and select(2, ai:SafeCall(
						"module.objective:" .. moduleName,
						module.objective,
						context,
						module.runtime
					))
					or tostring(module.objective or moduleName)
				local target
				if type(module.target) == "function" then
					local ok, value = ai:SafeCall(
						"module.target:" .. moduleName,
						module.target,
						context,
						module.runtime
					)
					if ok then target = value end
				end
				local score = tonumber(module.priority) or 0
				if module.needsMovement then
					local movementScore = ai.MovementManager:ScoreOwner(module.owner, context, target)
					if movementScore > -900 then score = math.max(score, movementScore) end
				end
				add(moduleName, module.owner, reason, target, moduleName, score)
			else
				module.runtime.status = "waiting"
				module.runtime.failureReason = dependencyReason
			end
		end
	end

	if #candidates == 0 then
		table.insert(candidates, {
			name = "Idle",
			owner = "None",
			reason = "no enabled automation needs control",
			score = 0,
		})
	end
	table.sort(candidates, function(a, b) return a.score > b.score end)
	return candidates
end

function ai.GoalManager:SnapshotGoal(context)
	return {
		goal = self.current,
		owner = context.currentOwner,
		target =
			state.safeMove
			and (
				state.safeMove.reason == "manual"
					and state.safeMove.target
				or (
					state.safeMove.manualRequestPending
						and state.safeMove.manualPendingTarget
				)
			)
			or nil,

		manualLabel =
			state.safeMove
			and (
				state.safeMove.reason == "manual"
					and state.safeMove.manualLabel
				or (
					state.safeMove.manualRequestPending
						and state.safeMove.manualPendingLabel
				)
			)
			or nil,
		manualCancelledAt = state.safeMove
			and state.safeMove.manualCancelledAt or 0,
		animal = context.animal,
		slot = context.slot,
		questStatus = questStatusText,
		at = tick(),
	}
end

function ai.GoalManager:ModuleForGoal(goal)
	if ai.ModuleRegistry:Get(goal) then return goal end
	if goal == "Auto Quests" then return "AutoQuests" end
	if goal == "Grow Slots" then return "GrowSlots" end
	if goal == "AFK Coin Farm" then return "AFKCoins" end
	if goal == "Survival: Water" then return "AutoDrink" end
	if goal == "Survival: Food" then return "AutoEat" end
	if goal == "Survival: Safety" then return "Safety" end
	if goal == "Slot Pipeline" then return "Slots" end
	return nil
end

function ai.GoalManager:CanResume(snapshot, context)
	if type(snapshot) ~= "table" then return false end
	if snapshot.goal == "Manual Move" then
		local cancelledAt = state.safeMove
			and tonumber(state.safeMove.manualCancelledAt) or 0
		return state.alive == true
			and typeof(snapshot.target) == "Vector3"
			and cancelledAt <= math.max(
				tonumber(snapshot.manualCancelledAt) or 0,
				tonumber(snapshot.at) or 0
			)
	end
	local moduleName = self:ModuleForGoal(snapshot.goal)
	local module = moduleName and ai.ModuleRegistry:Get(moduleName)
	return module ~= nil and ai.ModuleRegistry:Enabled(module, context)
end

function ai.GoalManager:Resume(context, reason)
	for index = #self.suspended, 1, -1 do
		local snapshot = self.suspended[index]
		local waitingForCircuit = snapshot.goal == "Manual Move"
			and not state.aiMovementOperational("Manual")
		local snapshotModuleName = self:ModuleForGoal(snapshot.goal)
		local snapshotModule = snapshotModuleName
			and ai.ModuleRegistry:Get(snapshotModuleName)
		if snapshotModule
			and ai.ModuleRegistry:Desired(snapshotModule, context) then
			local blocked = ai.ModuleRegistry:CircuitBlocked(snapshotModule)
			waitingForCircuit = waitingForCircuit or blocked
		end
		if waitingForCircuit then continue end
		table.remove(self.suspended, index)
		if self:CanResume(snapshot, context) then
			if snapshot.goal == "Manual Move" then
				task.spawn(function()
					if state.safeMove and state.safeMove.active
						and state.safeMove.reason == "manual" then
						return
					end
					local requestGeneration = state.beginManualMoveRequest(
						snapshot.target,
						snapshot.manualLabel or "resumed destination"
					)
					while state.manualMoveRequestIsCurrent(requestGeneration) do
						local manager = ai.MovementManager
						local urgentOwner = manager:StrongestUrgentOwner(ai.Blackboard)
						local manualPermitted = not ai.Authority
							or not ai.Authority.exclusive
							or ai.Authority.currentOwner == "Manual"
						if manualPermitted
							and (urgentOwner == nil or urgentOwner == "Manual") then
							state.requestAllMovementCancellation(
								"resuming user Manual Move",
								"Manual"
							)
							local deadline = tick() + 5
							while state.hasCompetingMovementOwner("Manual")
								and state.manualMoveRequestIsCurrent(requestGeneration)
								and (not ai.Authority or not ai.Authority.exclusive or ai.Authority.currentOwner == "Manual")
								and tick() < deadline do
								task.wait(0.05)
							end
							if state.manualMoveRequestIsCurrent(requestGeneration)
								and (not ai.Authority or not ai.Authority.exclusive or ai.Authority.currentOwner == "Manual")
								and not state.hasCompetingMovementOwner("Manual") then
								local moved = safeMoveToPosition(
									snapshot.target,
									10,
									nil,
									{
										purpose = "manual",
										manualLabel = snapshot.manualLabel or "resumed destination",
										allowWaterTransit = (isSavannahLife or isDinoLife),
										tolerance = 8,
										maxDuration = 420,
									}
								)
								if not state.manualMoveRequestIsCurrent(requestGeneration) then return end
								if moved then
									state.finishManualMoveRequest(requestGeneration)
									return
								end
							end
						end
						runtimeMessage = "Manual Move suspended; destination remains queued"
						task.wait(0.15)
					end
				end)
				ai.Telemetry:Push("GoalManager", "resume", {
					reason = reason,
					owner = "Manual",
					result = snapshot.manualLabel or "Manual Move",
				}, "resume:Manual Move",
					"Survival complete; resuming the user's Manual Move")
				return snapshot
			end
			local moduleName = self:ModuleForGoal(snapshot.goal)
			local module = ai.ModuleRegistry:Get(moduleName)
			if module and type(module.resume) == "function" then
				ai:SafeCall("module.resume:" .. moduleName, module.resume, context, snapshot)
			end
			ai.Telemetry:Push("GoalManager", "resume", {
				reason = reason,
				owner = snapshot.owner,
				result = snapshot.goal,
			}, "resume:" .. snapshot.goal,
				"Recovered; resuming " .. snapshot.goal .. " from slot " .. tostring(snapshot.slot))
			return snapshot
		end
	end
	return nil
end

function ai.GoalManager:Update(context)
	local candidates = self:Candidates(context)
	local best = candidates[1]
	local second = candidates[2]
	local previous = self.current
	local enteringSurvival = best.name:match("^Survival:") ~= nil
	local previousSurvival = previous:match("^Survival:") ~= nil

	if enteringSurvival and not previousSurvival and previous ~= "Idle" then
		table.insert(self.suspended, self:SnapshotGoal(context))
		while #self.suspended > 8 do table.remove(self.suspended, 1) end
	end

	if best.name ~= previous then
		self.previous = previous
		self.current = best.name
		self.currentSince = tick()
		local difference = best.score - (second and second.score or 0)
		context.confidence = math.clamp(0.55 + difference / 140, 0.55, 0.99)
		context.primaryGoal = best.name
		context.subGoal = best.reason
		context.currentAction = best.reason
		context.aiState = enteringSurvival and "PRIORITIZE" or "ACT"
		ai.Telemetry:Push("DecisionEngine", "decision", {
			reason = best.reason,
			owner = best.owner,
			result = best.name,
			debounce = 4,
		}, "goal:" .. best.name,
			best.name == "Survival: Water" and "Water priority - pausing lower-priority movement"
			or best.name == "Survival: Food" and "Food priority - preserving enabled objective"
			or best.name == "Survival: Safety" and "Immediate safety priority"
			or (previousSurvival and ("Survival complete - resuming " .. best.name))
			or ("Primary goal: " .. best.name))
	else
		context.primaryGoal = best.name
		context.subGoal = best.reason
		context.confidence = math.clamp(
			0.55 + (best.score - (second and second.score or 0)) / 140,
			0.55,
			0.99
		)
	end

	self.lastChoice = best
	self.lastScore = best.score
	self.currentModule = best.moduleName or self:ModuleForGoal(best.name)
	context.primaryModule = self.currentModule
	if previousSurvival and not enteringSurvival then
		self:Resume(context, "survival objective completed")
	elseif not enteringSurvival and #self.suspended > 0 then
		self:Resume(context, "suspended dependency became available")
	end
	return best, candidates
end

ai.SurvivalManager = {
	lastActionAt = 0,
	lastSafetyAt = 0,
	preparedWaterAt = 0,
	preparedFoodAt = 0,
}

function ai.SurvivalManager:Act(choice, context)
	if not choice or not context.characterAlive then return false end
	local now = tick()
	if now - self.lastActionAt < 0.65 then return false end

	if choice.owner == "Safety" then
		-- Legacy recovery/watchdog presence never makes the Supervisor stand down.

		-- An explicit Dino Manual Move owns a legal river crossing.
		if context.intentionalWaterTransit then
			return false
		end

		local rockTrapHazard = context.dinoRockTrapped == true
		local shorelineFoodHazard = context.dinoShorelineFoodDeadlock == true

		local damageOrTerrainHazard =
			context.inVoid
			or context.buried
			or context.healthFraction <= 0.35
			or context.healthRate < -0.8

		local waterOnlyHazard =
			context.dangerousWater
			and not damageOrTerrainHazard

		local verifiedHazard =
			damageOrTerrainHazard
			or waterOnlyHazard
			or rockTrapHazard
			or shorelineFoodHazard

		if not verifiedHazard
			or not ai.MovementManager:IsOwnerEnabled(
				"Safety",
				context
			) then

			return false
		end

		if DAMAGE.active then
			return false
		end

		if state.questGrowthReset.exclusive
			and not state.aiSupervisorSafetyOverride() then
			return false
		end

		if now - self.lastSafetyAt < 4 then
			return false
		end

		self.lastSafetyAt = now
		self.lastActionAt = now

		if shorelineFoodHazard then
			task.spawn(function()
				ai:SafeCall(
					"Dino shoreline Food safety recovery",
					state.startDinoShorelineFoodRecovery,
					"MMB AI verified Food-owned shoreline deadlock"
				)
			end)
			return true
		end

		if rockTrapHazard then
			task.spawn(function()
				ai:SafeCall(
					"Dino rock-trap safety recovery",
					state.startDinoRockTrapRecovery,
					"MMB AI verified moral rock trap"
				)
			end)
			return true
		end

		if waterOnlyHazard then
			-- Do NOT call DAMAGE.recover for water alone. That function has a
			-- deliberate post-damage protection wait and was the source of the
			-- "Watchdog: protegido em local seguro (25s)" false lock at HP 100%.
			task.spawn(function()
				ai:SafeCall(
					"water-only safety recovery",
					state.noIdleWaterSafetyStep
				)
			end)

			return true
		end

		local humanoid = context.humanoid
		local before = math.max(
			context.health,
			context.health - math.min(
				1,
				context.healthRate
			)
		)

		task.spawn(function()
			ai:SafeCall(
				"survival damage/terrain recovery",
				DAMAGE.recover,
				context.character,
				humanoid,
				before,
				context.health,
				context.healthFraction <= 0.35
					and "critical"
					or "verified drop",
				true
			)
		end)

		return true
	elseif choice.owner == "Water"
		and ai.MovementManager:IsOwnerEnabled("Water", context) then
		self.lastActionAt = now
		if context.water > 75 and context.water <= 82
			and (context.waterRate < -0.12 or context.waterETA < 80) then
			-- Trend prediction is advisory only. Do NOT turn a safe 76-82% Water
			-- reading into a committed Drink transaction: drinkingToFull is a hard
			-- movement lock and previously prevented Growth/PlayTime pairing from even
			-- reaching the quest scheduler. The real Drink threshold remains <=75%.
			if now - self.preparedWaterAt >= 20 then
				self.preparedWaterAt = now
				ai.Telemetry:Push("SurvivalManager", "decision", {
					reason = string.format("Water trend %.2f/s", context.waterRate),
					owner = "Water",
					debounce = 10,
				}, "water-trend", "Water falling quickly - preparing early drink")
			end
		end

		local current = ai.MovementManager.lease
		if current and current.owner ~= "Water" and current.owner ~= "Safety" then
			local waterScore = ai.MovementManager:ScoreOwner("Water", context)
			local currentScore = ai.MovementManager:ScoreOwner(current.owner, context, current.target)
			if waterScore > currentScore + 1 then
				ai.MovementManager:CancelOwner(current.owner, "Water priority")
			end
		end
		if context.water <= 55
			or context.noMotionFor >= 4 and context.water <= 70 then
			state.survivalBrainTakeover("water", "MMB AI Water priority")
		else
			ai:RequestWorker("AutoDrink", "Water trend preparation")
		end
		return true
	elseif choice.owner == "Food"
		and ai.MovementManager:IsOwnerEnabled("Food", context) then
		self.lastActionAt = now
		if context.food > 70 and context.food <= 88
			and (context.foodRate < -0.15 or context.foodETA < 75) then
			-- Same rule as Water: trend prediction may pre-warm the worker, but it
			-- cannot create a hard Eat commitment above the real quest-survival
			-- threshold. This keeps passive Growth/PlayTime concurrency runnable.
			self.preparedFoodAt = now
		end

		local current = ai.MovementManager.lease
		if current and current.owner ~= "Food" and current.owner ~= "Safety" then
			local foodScore = ai.MovementManager:ScoreOwner("Food", context)
			local currentScore = ai.MovementManager:ScoreOwner(current.owner, context, current.target)
			if foodScore > currentScore + 1 then
				ai.MovementManager:CancelOwner(current.owner, "Food priority")
			end
		end
		if context.food <= 45
			or context.noMotionFor >= 4 and context.food <= 65 then
			state.survivalBrainTakeover("food", "MMB AI Food priority")
		else
			ai:RequestWorker("AutoEat", "Food trend preparation")
		end
		return true
	end

	return false
end

function ai:RegisterModule(name, specification)
	return self.ModuleRegistry:Register(name, specification)
end

function ai:RequestMovement(owner, reason, target, priority, options)
	return self.MovementManager:Acquire(owner, reason, target, priority, options)
end

function ai:ReleaseMovement(token, success, reason)
	return self.MovementManager:Complete(token, success, reason)
end
end)()

