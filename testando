		self:Vitals(context)

	local movementLease =
		ai.MovementManager
		and ai.MovementManager.lease

	local physicalOwner =
		movementLease
		and movementLease.owner
		or (
			state.safeMove
			and state.safeMove.active
			and ai.MovementManager
			and ai.MovementManager:OwnerForPurpose(
				state.safeMove.reason
			)
		)
		or nil

	local waterTransaction =
		state.autoDrink == true
		and (
			drinkingToFull
			or physicalOwner == "Water"
			or (
				state.safeMove
				and state.safeMove.active
				and (
					state.safeMove.reason == "water"
					or state.safeMove.reason == "water_search"
