	local continuousPrideTransit =
		purpose == "herbivore_food_recovery"
	local pridePhysicalAnchor = root.Position
	local pridePhysicalProgressAt = tick()
	local prideTargetProgressAt = tick()
	local prideBestTargetDistance = math.huge

	-- High-hill avoidance state. Lock one side briefly so the animal does not
	-- oscillate left/right while skirting a mountain.
	local hillAvoidUntil = 0
	local hillAvoidSign = obstacleSign
	local lastHillCheckAt = 0

	local lastMoveWReassertAt = 0

	local waterBridgeDone = false

	local dinoWaterObstacleAt = 0
	local dinoWaterObstacleDirection = nil
	local dinoWaterObstacleResult = nil

	local function exposedTerrainWaterAt(
		worldPosition
	)
		if typeof(worldPosition)
			~= "Vector3" then
			return false,
				nil
		end

		local params =
			RaycastParams.new()

		params.FilterType =
			Enum.RaycastFilterType.Include

		params.FilterDescendantsInstances = {
			workspace.Terrain,
		}

		params.IgnoreWater = false

		local hit =
			workspace:Raycast(
				worldPosition
					+ Vector3.new(
						0,
						100,
						0
					),
				Vector3.new(
					0,
					-220,
					0
				),
				params
			)

		return hit
				and hit.Material
					== Enum.Material.Water,
			hit
	end

	local function exposedWaterBridgeAhead(
		fromPosition,
		toPosition
	)
		if not aquaticBankClimber
			or purpose == "water"
			or purpose == "safety"
			or swimApproach
			or forceVertical
			or rawVerticalTransit then

			return nil
		end

		local waterPart =
			workspace:FindFirstChild(
				"MainWaterPart"
			)

		if not waterPart
			or not waterPart:IsA(
				"BasePart"
			) then

			return nil
		end

		local flat =
			Vector3.new(
				toPosition.X
					- fromPosition.X,
				0,
				toPosition.Z
					- fromPosition.Z
			)

		local totalDistance =
			flat.Magnitude

		if totalDistance < 8 then
			return nil
		end

		local direction =
			flat.Unit

		-- This scanner runs ONLY after the normal look-ahead has already found
		-- exposed Terrain water. It looks for the first dry bank after that
		-- water, instead of using MainWaterPart's enormous underground footprint.
		local scanLimit =
			math.min(
				totalDistance,
				240
			)

		local step =
			8

		local enteredWater =
			false

		local entryWorld
		local exitWorld
		local dryAfterWater =
			0

		local distance =
			4

		while distance
			<= scanLimit do

			local probe =
				fromPosition
					+ direction
						* distance

			local isWater, hit =
				exposedTerrainWaterAt(
					probe
				)

			if isWater then
				if not enteredWater then
					enteredWater = true
					entryWorld =
						hit
						and hit.Position
						or probe
				end

				dryAfterWater =
					0

			elseif enteredWater
				and hit
				and hit.Material
					~= Enum.Material.Water then

				dryAfterWater += 1

				-- Require two dry samples so a tiny Terrain island/noise does
				-- not terminate the bridge in the middle of the river.
				if dryAfterWater >= 2 then
					exitWorld =
						hit.Position

					break
				end
			end

			distance += step
		end

		if not enteredWater
			or not entryWorld
			or not exitWorld then

			return nil
		end

		local entryLocal =
			waterPart.CFrame:PointToObjectSpace(
				entryWorld
			)

		local exitLocal =
			waterPart.CFrame:PointToObjectSpace(
				exitWorld
			)

		local entryDistance =
			Vector2.new(
				entryWorld.X
					- fromPosition.X,
				entryWorld.Z
					- fromPosition.Z
			).Magnitude

		return {
			part = waterPart,
			entryLocal = entryLocal,
			exitLocal = exitLocal,
			entryDistance = entryDistance,
		}
	end

	local function runMainWaterElevatedBridge(
		bridge,
		maximumSpeed
	)
		if not bridge
			or not bridge.part
			or not bridge.part.Parent then

			return false
		end

		local waterPart =
			bridge.part

		-- This is a normal ABOVE-water traversal, not an underwater exit.
		-- Keep the physical water surface solid for Croc/Hippo.
		if state.isCrocOrHippoMovementCharacter(
			character
		) then
			waterPart.CanCollide =
				true
		end

		state.heavyWalkStop(
			character
		)

		local oldAutoRotate =
			humanoid.AutoRotate

		local oldMovementDisabled =
			character:GetAttribute(
				"MovementDisabled"
			)

		local BG =
			Instance.new(
				"BodyGyro"
			)

		local BP =
			Instance.new(
				"BodyPosition"
			)

		BG.Name =
			"MMB_MainWaterBridgeGyro"

		BP.Name =
			"MMB_MainWaterBridgePosition"

		BG.P = 9e4
		BG.MaxTorque =
			Vector3.new(
				9e9,
				9e9,
				9e9
			)

		BP.P = 26000
		BP.D = 3200
		BP.MaxForce =
			Vector3.new(
				9e8,
				9e8,
				9e8
			)

		BG.CFrame =
			root.CFrame

		BP.Position =
			root.Position

		BG.Parent =
			root

		BP.Parent =
			root

		pcall(function()
			humanoid.PlatformStand = true
			humanoid.AutoRotate = false
		end)

		-- EXACTLY the same ownership policy for Croc and Hippo.
		-- Their SwimmingControllers cannot pull the rig below the surface while
		-- this elevated land-route bridge owns the root position.
		character:SetAttribute(
			"MovementDisabled",
			true
		)

		local currentLocal =
			waterPart.CFrame:PointToObjectSpace(
				root.Position
			)

		local halfY =
			waterPart.Size.Y * 0.5

		local surfaceStandOffset =
			state.aquaticWaterStandOffset(
				character
			)

		local cruiseLocalY =
			math.max(
				currentLocal.Y,
				halfY
					+ surfaceStandOffset
					+ 2.0
			)

		local routeDirection =
			Vector3.new(
				bridge.exitLocal.X
					- bridge.entryLocal.X,
				0,
				bridge.exitLocal.Z
					- bridge.entryLocal.Z
			)

		if routeDirection.Magnitude <= 0.01 then
			routeDirection =
				Vector3.new(
					1,
					0,
					0
				)
		else
			routeDirection =
				routeDirection.Unit
		end

		local outsideMargin =
			math.clamp(
				state.movementFootprint(
					character
				) * 0.22,
				3,
				5
			)

		local exitLocal =
			bridge.exitLocal
			+ routeDirection
				* outsideMargin

		local liftTarget =
			waterPart.CFrame:PointToWorldSpace(
				Vector3.new(
					currentLocal.X,
					cruiseLocalY,
					currentLocal.Z
				)
			)

		local exitTarget =
			waterPart.CFrame:PointToWorldSpace(
				Vector3.new(
					exitLocal.X,
					cruiseLocalY,
					exitLocal.Z
				)
			)

		local bridgeSpeed =
			math.clamp(
				tonumber(maximumSpeed)
					or 36,
				24,
				50
			)

		local commandedPosition =
			root.Position

		local lastHeartbeatAt =
			tick()

		local function bridgeFlyTo(
			goal,
			timeout
		)
			local deadline =
				tick()
				+ timeout

			while state.alive
				and character.Parent
				and root.Parent
				and humanoid.Parent
				and humanoid.Health > 0
				and token
					== state.safeMove.cancelToken
				and tick() < deadline do

				local delta =
					goal - root.Position

				if delta.Magnitude <= 1.5 then
					commandedPosition =
						goal

					BP.Position =
						goal

					return true
				end

				local now =
					tick()

				local dt =
					math.clamp(
						now
							- lastHeartbeatAt,
						1 / 120,
						1 / 20
					)

				lastHeartbeatAt =
					now

				local commandDelta =
					goal
						- commandedPosition

				if commandDelta.Magnitude > 0.05 then
					local commandSpeed =
						math.clamp(
							commandDelta.Magnitude
								* 1.8,
							12,
							bridgeSpeed
						)

					local step =
						math.min(
							commandDelta.Magnitude,
							commandSpeed * dt
						)

					commandedPosition =
						commandedPosition
						+ commandDelta.Unit
							* step
				else
					commandedPosition =
						goal
				end

				BP.Position =
					commandedPosition

				local flat =
					Vector3.new(
						goal.X
							- root.Position.X,
						0,
						goal.Z
							- root.Position.Z
					)

				if flat.Magnitude > 0.25 then
					BG.CFrame =
						CFrame.lookAt(
							root.Position,
							root.Position
								+ flat.Unit,
							Vector3.yAxis
						)
				end

				-- Kill swimming/downward momentum. BodyPosition owns Y as well
				-- as X/Z, so Hippo cannot sag below the water plane.
				root.AssemblyLinearVelocity =
					root.AssemblyLinearVelocity
						* 0.15

				root.AssemblyAngularVelocity =
					Vector3.zero

				runtimeMessage =
					CROC.isCharacter(
						character
					)
						and "Croc MoveTo: position-control above water"
						or "Hippo MoveTo: position-control above water"

				RunService.Heartbeat:Wait()
			end

			return false
		end

		local liftDistance =
			(liftTarget - root.Position).Magnitude

		local lifted =
			bridgeFlyTo(
				liftTarget,
				math.clamp(
					liftDistance
						/ bridgeSpeed
						+ 1.5,
					1.5,
					5
				)
			)

		local crossed =
			false

		if lifted then
			local crossDistance =
				(exitTarget - root.Position).Magnitude

			crossed =
				bridgeFlyTo(
					exitTarget,
					math.clamp(
						crossDistance
							/ bridgeSpeed
							+ 2.0,
						2.0,
						12
					)
				)
		end

		pcall(function()
			if BP and BP.Parent then
				BP:Destroy()
			end
		end)

		pcall(function()
			if BG and BG.Parent then
				BG:Destroy()
			end
		end)

		if root and root.Parent then
			root.AssemblyLinearVelocity =
				Vector3.zero

			root.AssemblyAngularVelocity =
				Vector3.zero
		end

		pcall(function()
			humanoid.PlatformStand = false
			humanoid.AutoRotate =
				oldAutoRotate ~= false

			humanoid:ChangeState(
				Enum.HumanoidStateType.GettingUp
			)
		end)

		if oldMovementDisabled == nil then
			character:SetAttribute(
				"MovementDisabled",
				false
			)
		else
			character:SetAttribute(
				"MovementDisabled",
				oldMovementDisabled
			)
		end

		if state.isCrocOrHippoMovementCharacter(
			character
		)
			and waterPart
			and waterPart.Parent then

			waterPart.CanCollide =
				true
		end

		if crossed then
			runtimeMessage =
				CROC.isCharacter(
					character
				)
					and "Croc MoveTo: crossed water above surface"
					or "Hippo MoveTo: crossed water above surface"
		end

		return crossed
	end

	local function terrainHeightAt(worldPosition, referenceY)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { workspace.Terrain }
		params.IgnoreWater = false

		local castTop = math.max(
			referenceY + 320,
			worldPosition.Y + 320
		)

		local hit = workspace:Raycast(
			Vector3.new(
				worldPosition.X,
				castTop,
				worldPosition.Z
			),
			Vector3.new(0, -700, 0),
			params
		)

		if not hit or hit.Material == Enum.Material.Water then
			return nil
		end

		return hit.Position.Y
	end


	local function chooseHillAvoidSide(rootPosition, forward, currentGroundY)
		local hill =
			state.safeMove.hill

		-- If the currently committed side is still making recent progress,
		-- KEEP IT. Do not reevaluate every couple seconds and oscillate.
		if hill
			and hill.sign
			and tick() - (hill.progressAt or 0) < 2.6 then

			return hill.sign
		end

		local function rotateHeading(sign, degrees)
			local angle =
				math.rad(degrees * sign)

			local c = math.cos(angle)
			local s = math.sin(angle)

			return Vector3.new(
				forward.X * c - forward.Z * s,
				0,
				forward.X * s + forward.Z * c
			).Unit
		end

		local function sideScore(sign)
			local heading =
				rotateHeading(sign, 58)

			local score = 0
			local lastY = currentGroundY
			local maxRise = 0

			-- Look down the actual escape corridor, not just one shoulder point.
			for _, distance in ipairs({
				14,
				24,
				38,
				54,
				72,
				92,
			}) do
				local point =
					rootPosition
					+ heading * distance

				local y =
					terrainHeightAt(
						point,
						rootPosition.Y
					)

				if y then
					local rise =
						y - currentGroundY

					local stepRise =
						y - lastY

					maxRise =
						math.max(
							maxRise,
							rise
						)

					-- Rising Terrain is increasingly expensive.
					if rise > 0 then
						score += rise * 1.15
					end

					if rise > 18 then
						score +=
							(rise - 18) * 3.2
					end

					if rise > 32 then
						score +=
							(rise - 32) * 4.5
					end

					-- A sudden wall between samples is a very bad corridor.
					if stepRise > 9 then
						score +=
							stepRise * 3.0
					end

					-- Avoid selecting a huge cliff/drop as the "easy" side.
					if rise < -38 then
						score += 70
					end

					lastY = y
				else
					-- Missing/non-solid Terrain is uncertain, so don't treat it
					-- as a magically perfect path.
					score += 18
				end
			end

			-- Also inspect a wider shoulder that represents actually going
			-- AROUND the mountain rather than merely touching its edge.
			local sideVector =
				Vector3.new(
					-forward.Z,
					0,
					forward.X
				) * sign

			for _, probe in ipairs({
				{ 28, 36 },
				{ 48, 58 },
				{ 64, 78 },
			}) do
				local point =
					rootPosition
					+ forward * probe[1]
					+ sideVector * probe[2]

				local y =
					terrainHeightAt(
						point,
						rootPosition.Y
					)

				if y then
					local rise =
						y - currentGroundY

					if rise > 15 then
						score +=
							(rise - 15) * 2.4
					end
				else
					score += 12
				end
			end

			-- Physical wall/tree/rock check in the selected escape heading.
			local params = RaycastParams.new()
			params.FilterType =
				Enum.RaycastFilterType.Exclude

			params.FilterDescendantsInstances =
				state.movementObstacleIgnoreList(character, false)

			params.IgnoreWater = true

			local obstacle =
				workspace:Raycast(
					rootPosition
						+ Vector3.new(
							0,
							2.5,
							0
						),
					heading * 32,
					params
				)

			if obstacle
				and state.movementIsDinoWaterMossVisual(obstacle.Instance) then
				obstacle = nil
			end

			if obstacle
				and math.abs(
					obstacle.Normal.Y
				) < 0.72 then

				score +=
					obstacle.Instance
						== workspace.Terrain
						and 130
						or 65
			end

			-- Remember a side that ALREADY FAILED near this same mountain.
			local failedUntil =
				sign < 0
					and (
						state.safeMove.hillFailureLeftUntil
						or 0
					)
					or (
						state.safeMove.hillFailureRightUntil
						or 0
					)

			local failedPosition =
				sign < 0
					and state.safeMove.hillFailureLeftPosition
					or state.safeMove.hillFailureRightPosition

			if tick() < failedUntil
				and typeof(failedPosition)
					== "Vector3"
				and (
					failedPosition
					- rootPosition
				).Magnitude <= 95 then

				score += 500
			end

			return score, maxRise
		end

		local leftScore =
			sideScore(-1)

		local rightScore =
			sideScore(1)

		if hill then
			hill.leftScore = leftScore
			hill.rightScore = rightScore
		end

		local preferred =
			hill
				and hill.sign
				or hillAvoidSign

		-- Hysteresis: if scores are close, keep the previous side.
		if preferred
			and math.abs(
				leftScore - rightScore
			) < 26 then

			return preferred
		end

		return leftScore < rightScore
			and -1
			or 1
	end

	local function rotateStuckHeading(
		forward,
		degrees
	)
		local angle =
			math.rad(
				degrees
			)

		local c =
			math.cos(
				angle
			)

		local s =
			math.sin(
				angle
			)

		return Vector3.new(
			forward.X * c
				- forward.Z * s,
			0,
			forward.X * s
				+ forward.Z * c
		).Unit
	end

	local function stuckCorridorScore(
		origin,
		direction,
		distance
	)
		if typeof(origin) ~= "Vector3"
			or typeof(direction) ~= "Vector3"
			or direction.Magnitude <= 0.05 then

			return -math.huge
		end

		direction =
			Vector3.new(
				direction.X,
				0,
				direction.Z
			)

		if direction.Magnitude <= 0.05 then
			return -math.huge
		end

		direction =
			direction.Unit

		local right =
			Vector3.new(
				-direction.Z,
				0,
				direction.X
			)

		local halfWidth =
			math.clamp(
				state.movementFootprint(
					character
				) * 0.62,
				3,
				12
			)

		local params =
			RaycastParams.new()

		params.FilterType =
			Enum.RaycastFilterType.Exclude

		params.FilterDescendantsInstances =
			state.movementObstacleIgnoreList(character, true)

		params.IgnoreWater =
			true

		pcall(function()
			params.RespectCanCollide =
				true
		end)

		local nearest =
			distance

		local blocked =
			0

		local probeHeight =
			math.clamp(
				state.movementProbeHeight(
					character
				),
				2.2,
				6
			)

		-- This richer scan runs ONLY after a confirmed stall, not every frame.
		for _, lateral in ipairs({
			-halfWidth,
			0,
			halfWidth,
		}) do
			for _, heightScale in ipairs({
				0.55,
				1.25,
			}) do
				local hit =
					workspace:Raycast(
						origin
							+ right * lateral
							+ Vector3.new(
								0,
								probeHeight
									* heightScale,
								0
							),
						direction
							* distance,
						params
					)

				if hit
					and not state.movementIsDinoWaterMossVisual(hit.Instance) then
					blocked += 1

					nearest =
						math.min(
							nearest,
							hit.Distance
						)
				end
			end
		end

		local endpoint =
			origin
				+ direction
					* distance

		if purpose ~= "water"
			and not allowIntentionalWaterTransit then
			local waterAtEnd =
				exposedTerrainWaterAt(
					endpoint
				)

			if waterAtEnd then
				return -10000
			end
		end

		local currentGround =
			terrainHeightAt(
				origin,
				origin.Y
			)

		local endGround =
			terrainHeightAt(
				endpoint,
				origin.Y
			)

		if not endGround then
			return -5000
		end

		local terrainPenalty =
			0

		if currentGround then
			local deltaY =
				endGround
					- currentGround

			if deltaY > 18 then
				terrainPenalty +=
					(deltaY - 18)
						* 5
			elseif deltaY < -32 then
				terrainPenalty +=
					math.abs(
						deltaY + 32
					) * 4
			end
		end

		return nearest
			- blocked * 9
			- terrainPenalty
	end

	local function clearObjectBypass()
		objectBypass.instance = nil
		objectBypass.point = nil
		objectBypass.sign = nil
		objectBypass.untilAt = 0
		objectBypass.startedAt = 0
		objectBypass.radius = 0
	end

	local function buildObjectBypass(
		obstacle,
		routeForward,
		wider,
		preferredSign
	)
		local instance = obstacle and obstacle.Instance

		if typeof(instance) ~= "Instance"
			or not instance:IsA("BasePart")
			or typeof(routeForward) ~= "Vector3" then

			return false
		end

		routeForward = Vector3.new(
			routeForward.X,
			0,
			routeForward.Z
		)

		if routeForward.Magnitude <= 0.05 then
			return false
		end

		routeForward = routeForward.Unit

		local footprint = math.max(
			3,
			state.movementFootprint(character)
		)

		local halfObject = math.max(
			instance.Size.X,
			instance.Size.Z
		) * 0.5

		local baseRadius = math.clamp(
			halfObject + footprint * 0.82 + 6,
			10,
			58
		)

		if wider then
			baseRadius = math.clamp(
				baseRadius * 1.42 + 5,
				14,
				76
			)
		end

		local center = Vector3.new(
			instance.Position.X,
			root.Position.Y,
			instance.Position.Z
		)

		local side = Vector3.new(
			-routeForward.Z,
			0,
			routeForward.X
		)

		local bestPoint
		local bestSign
		local bestScore = -math.huge

		for _, sign in ipairs({ -1, 1 }) do
			for _, scale in ipairs({ 1.0, 1.28 }) do
				local radius = baseRadius * scale
				local candidate = center
					+ side * sign * radius
					+ routeForward * math.clamp(radius * 0.52, 5, 28)

				local waterAtCandidate = false
				if purpose ~= "water"
					and purpose ~= "water_search"
					and not allowIntentionalWaterTransit then
					waterAtCandidate = exposedTerrainWaterAt(candidate) == true
				end

				if not waterAtCandidate then
					local delta = Vector3.new(
						candidate.X - root.Position.X,
						0,
						candidate.Z - root.Position.Z
					)

					if delta.Magnitude > 1 then
						local score = stuckCorridorScore(
							root.Position,
							delta.Unit,
							math.min(delta.Magnitude, math.max(20, radius * 1.20))
						)

						if sign == (preferredSign or obstacleSign) then
							score += 7
						end

						if score > bestScore then
							bestScore = score
							bestPoint = candidate
							bestSign = sign
						end
					end
				end
			end
		end

		if not bestPoint then
			return false
		end

		objectBypass.instance = instance
		objectBypass.point = bestPoint
		objectBypass.sign = bestSign
		objectBypass.startedAt = tick()
		objectBypass.untilAt = tick() + (wider and 8.0 or 6.0)
		objectBypass.radius = baseRadius
		obstacleSign = bestSign

		return true
	end

	local function moveStuckSegment(
		goal,
		maximumSpeed,
		moveToMotor,
		timeout
	)
		if typeof(goal) ~= "Vector3" then
			return false
		end

		local startPosition =
			root.Position

		local deadline =
			tick()
				+ (
					tonumber(timeout)
						or 2
				)

		local escapeSpeed =
			math.clamp(
				maximumSpeed * 0.72,
				10,
				math.max(
					10,
					maximumSpeed
				)
			)

		while state.alive
			and character.Parent
			and root.Parent
			and humanoid.Parent
			and humanoid.Health > 0
			and token
				== state.safeMove.cancelToken
			and tick() < deadline do

			-- Hard-stuck recovery is still part of the SAME route. Keep route
			-- monitors alive here so a carcass/quest/water condition cannot be
			-- skipped during the watchdog's multi-second back/side/rejoin motion.
			if state.safeMoveRunRouteCheck(
				options,
				character,
				root,
				humanoid,
				position
			) then
				return false
			end

			if (
				state.questGrowthReset.exclusive
				and options.allowDuringGrowthReset ~= true
			)
				or (
					criticalRecoveryActive
					and options.allowDuringGrowthReset ~= true
				)
				or DAMAGE.active then

				return false
			end

			local delta =
				Vector3.new(
					goal.X
						- root.Position.X,
					0,
					goal.Z
						- root.Position.Z
				)

			local remaining =
				delta.Magnitude

			if remaining
				<= math.max(
					3.5,
					state.movementFootprint(
						character
					) * 0.38
				) then

				return true
			end

			local direction =
				delta.Unit

			if moveToMotor then
				state.heavyWalkStep(
					character,
					root,
					humanoid,
					direction,
					escapeSpeed,
					remaining,
					goal,
					"safeMove",
					token
				)
			else
				pcall(
					humanoid.Move,
					humanoid,
					direction,
					false
				)

				local velocity =
					root.AssemblyLinearVelocity

				root.AssemblyLinearVelocity =
					Vector3.new(
						direction.X
							* escapeSpeed,
						velocity.Y,
						direction.Z
							* escapeSpeed
					)
			end

			setSubState(
				"Running"
			)

			RunService.Heartbeat:Wait()
		end

		local moved =
			Vector3.new(
				root.Position.X
					- startPosition.X,
				0,
				root.Position.Z
					- startPosition.Z
			).Magnitude

		return moved >= 4.5
	end

	local function runHardStuckEscape(
		forward,
		maximumSpeed,
		moveToMotor
	)
		if typeof(forward) ~= "Vector3"
			or forward.Magnitude <= 0.05 then

			return false
		end

		forward =
			Vector3.new(
				forward.X,
				0,
				forward.Z
			)

		if forward.Magnitude <= 0.05 then
			return false
		end

		forward =
			forward.Unit

		state.heavyWalkStop(
			character
		)

		if state.questSetW then
			pcall(
				state.questSetW,
				false
			)
		end

		local footprint =
			state.movementFootprint(
				character
			)

		local backDistance =
			math.clamp(
				footprint * 1.55
					+ 6,
				12,
				28
			)

		local sideDistance =
			math.clamp(
				footprint * 3.10
					+ 18,
				32,
				64
			)

		-- STEP 1: MOVE BACK. If straight reverse is blocked, pick a rear diagonal.
		local rearDirection
		local rearScore =
			-math.huge

		for _, degrees in ipairs({
			180,
			145,
			-145,
		}) do
			local candidate =
				rotateStuckHeading(
					forward,
					degrees
				)

			local score =
				stuckCorridorScore(
					root.Position,
					candidate,
					backDistance
				)

			if score > rearScore then
				rearScore =
					score

				rearDirection =
					candidate
			end
		end

		if not rearDirection
			or rearScore < -1000 then

			return false
		end

		runtimeMessage =
			"Stuck watchdog: backing out of object trap"

		local backed =
			moveStuckSegment(
				root.Position
					+ rearDirection
						* backDistance,
				maximumSpeed,
				moveToMotor,
				2.2
			)

		if not backed then
			return false
		end

		-- STEP 2: choose a MUCH wider side route around the object/cave.
		local sideDirection
		local sideScore =
			-math.huge

		local sideSign =
			obstacleSign

		for _, item in ipairs({
			{ -88, -1 },
			{ 88, 1 },
			{ -112, -1 },
			{ 112, 1 },
		}) do
			local candidate =
				rotateStuckHeading(
					forward,
					item[1]
				)

			local score =
				stuckCorridorScore(
					root.Position,
					candidate,
					sideDistance
				)

			if score > sideScore then
				sideScore =
					score

				sideDirection =
					candidate

				sideSign =
					item[2]
			end
		end

		if sideDirection
			and sideScore > -1000 then

			obstacleSign =
				sideSign

			runtimeMessage =
				sideSign < 0
					and "Stuck watchdog: wide LEFT detour"
					or "Stuck watchdog: wide RIGHT detour"

			moveStuckSegment(
				root.Position
					+ sideDirection
						* sideDistance,
				maximumSpeed,
				moveToMotor,
				3.4
			)
		end

		-- STEP 3: once offset, move forward again to actually clear the object.
		local rejoinDistance =
			math.clamp(
				sideDistance * 0.55,
				18,
				36
			)

		local rejoinScore =
			stuckCorridorScore(
				root.Position,
				forward,
				rejoinDistance
			)

		if rejoinScore > 5 then
			runtimeMessage =
				"Stuck watchdog: rejoining original route"

			moveStuckSegment(
				root.Position
					+ forward
						* rejoinDistance,
				maximumSpeed,
				moveToMotor,
				2.4
			)
		end

		return true
	end

	local function cleanup()
		if state.safeMove.workerToken ~= token then
			return
		end

		local manager = state.MMBAI and state.MMBAI.MovementManager
		local releasePhysical = not movementLeaseToken
			or not manager
			or not manager.lease
			or manager.lease.token == movementLeaseToken

		releasePhysical = releasePhysical
			and character == player.Character
			and character.Parent ~= nil

		if releasePhysical then
			state.heavyWalkStop(character)

			local liveRoot = character:FindFirstChild("HumanoidRootPart")
			local liveHumanoid = character:FindFirstChildOfClass("Humanoid")

			if liveHumanoid then
				pcall(liveHumanoid.Move, liveHumanoid, Vector3.zero, false)
			end

			if liveRoot then
				local velocity = liveRoot.AssemblyLinearVelocity
				liveRoot.AssemblyLinearVelocity = Vector3.new(
					0,
					velocity.Y,
					0
				)
				liveRoot.AssemblyAngularVelocity =
					liveRoot.AssemblyAngularVelocity * 0.2
			end

			state.releaseMovementNow(character, true)
		end

		state.safeMove.landQuestW = false
		state.safeMove.nativeW = false
		state.safeMove.active = false
		state.safeMove.target = nil
		state.safeMove.reason = nil
		state.safeMove.owner = nil
		state.safeMove.priority = 0
		state.safeMove.aiLeaseToken = nil
		state.safeMove.workerToken = nil
		state.safeMove.allowWaterTransit = false
		state.safeMove.waterTransitKind = nil
		state.safeMove.preferredObstacleSign = nil
		state.safeMove.manualLabel = nil
		state.busy = false
		lastSafeMoveAt = tick()

		if state.renderMoveToCancelButton then
			pcall(state.renderMoveToCancelButton)
		end
	end

	local callOk, result = pcall(function()
		local acceleration = state.safeMovementSpeed(character)
		local initialFlat = Vector3.new(
			position.X - root.Position.X,
			0,
			position.Z - root.Position.Z
		).Magnitude

		local maximumSpeed = math.max(
			4,
			acceleration * speedScale
		)

		if speedCap and speedCap > 0 then
			maximumSpeed = math.min(maximumSpeed, speedCap)
		end

		local maximumDuration =
			tonumber(options.maxDuration)
			or math.clamp(
				(initialFlat / math.max(maximumSpeed, 1)) * 3 + 24,
				20,
				420
			)

		local deadline = tick() + maximumDuration

		while state.alive
			and character.Parent
			and root.Parent
			and humanoid.Parent
			and humanoid.Health > 0
			and token == state.safeMove.cancelToken
			and tick() < deadline do

			-- v77: Acceleration can change after Swimming / landing.
			-- Re-read it continuously instead of keeping the initial value.
			local liveAcceleration =
				state.safeMovementSpeed(character)

			maximumSpeed = math.max(
				4,
				liveAcceleration * speedScale
			)

			if speedCap and speedCap > 0 then
				maximumSpeed =
					math.min(maximumSpeed, speedCap)
			end

			-- Water-exit routes finish the instant dry Terrain is confirmed.
			if stopOnDryGround
				and state.normalizeDryLandState
				and state.normalizeDryLandState(
					character,
					root
				) then
				return true
			end

			local food = tonumber(character:GetAttribute("Food")) or 100
			local water = tonumber(character:GetAttribute("Water")) or 100

			-- v96 optional continuous-route monitor.
			-- Used by carcass spawn search so it can scan while walking WITHOUT
			-- splitting the route into many SafeMove transactions.
			if state.safeMoveRunRouteCheck(
				options,
				character,
				root,
				humanoid,
				position
			) then
				return false
			end

			-- v84 HARD STOP:
			-- Keep the full v81 navigation UNTIL Savannah itself shows the
			-- real Drink prompt. At that exact frame, stop where we are.
			local waterGamePrompt =
				purpose == "water"
					and state.drinkGamePromptAvailable
					and state.drinkGamePromptAvailable(
						character
					)

			local waterVisualPrompt =
				purpose == "water"
					and state.drinkVisualPromptVisible
					and state.drinkVisualPromptVisible()

			if purpose == "water"
				and (
					waterGamePrompt
						or waterVisualPrompt
				) then

				if waterVisualPrompt then
					state.drinkLatchVisualPrompt()
				end

				state.drinkSearch.promptStopAt =
					root.Position

				state.drinkSearch.promptStopTime =
					tick()

				local velocity =
					root.AssemblyLinearVelocity

				root.AssemblyLinearVelocity =
					Vector3.new(
						0,
						velocity.Y,
						0
					)

				root.AssemblyAngularVelocity =
					Vector3.zero

				if state.questSetW then
					pcall(
						state.questSetW,
						false
					)
				end

				if faceTowards then
					local face = Vector3.new(
						faceTowards.X - root.Position.X,
						0,
						faceTowards.Z - root.Position.Z
					)

					if face.Magnitude > 0.25 then
						pcall(function()
							root.CFrame =
								CFrame.lookAt(
									root.Position,
									root.Position
										+ face.Unit,
									Vector3.yAxis
								)
						end)
					end
				end

				runtimeMessage =
					"Drink prompt visible; stopping at current edge"

				return true
			end

			-- Turning Auto Eat OFF cancels an already-running food route too.
			if purpose == "food"
				and not state.autoEat then
				runtimeMessage =
					"Auto Eat disabled; food movement cancelled"
				return false
			end

			-- Long walks yield to survival before the animal becomes unsafe.
			if purpose == "food"
				and state.waterShouldPreemptFood(character, 72) then
				runtimeMessage =
					"Movement paused: Water priority took control"
				return false
			elseif purpose == "quest"
				and (food <= 66 or water <= 72) then
				runtimeMessage =
					"Quest movement paused for Food/Water"
				return false
			elseif purpose == "manual"
				and (
					(state.autoDrink and water <= 62)
					or (state.autoEat and food <= 52)
				) then
				runtimeMessage =
					"Move To paused for survival"
				return false
			end

			if DAMAGE.active and purpose ~= "safety" then
				return false
			end

			if criticalRecoveryActive
				and purpose ~= "safety"
				and purpose ~= "water"
				and purpose ~= "herbivore_food_recovery"
				and options.allowDuringGrowthReset ~= true then
				return false
			end

			local current = root.Position

			local flatDelta = Vector3.new(
				position.X - current.X,
				0,
				position.Z - current.Z
			)

			local flatDistance =
				flatDelta.Magnitude

			if purpose == "manual"
				and tick()
					- (
						state.safeMove.manualStatusAt
							or 0
					) >= 0.75 then

				state.safeMove.manualStatusAt =
					tick()

				runtimeMessage =
					string.format(
						"Move To WORLD: %s · %.0f studs · target %.0f, %.0f",
						tostring(
							state.safeMove.manualLabel
								or "location"
						),
						flatDistance,
						position.X,
						position.Z
					)
			end

			-- High-hill progress is NOT the same as "distance to destination".
			-- Going around a mountain may temporarily move sideways or even a
			-- little farther from the destination. Measure advancement along the
			-- committed escape heading too.
			if tick() < hillAvoidUntil
				and state.safeMove.hill
				and state.safeMove.hill.sign
				and state.safeMove.hill.anchor
				and state.safeMove.hill.escapeDirection then

				local escapeDelta =
					Vector3.new(
						current.X
							- state.safeMove.hill.anchor.X,
						0,
						current.Z
							- state.safeMove.hill.anchor.Z
					)

				local projection =
					escapeDelta:Dot(
						state.safeMove.hill.escapeDirection
					)

				local madeEscapeProgress =
					projection
						> (
							state.safeMove.hill.bestProjection
							or 0
						) + 2.25

				local madeTargetProgress =
					flatDistance
						< (
							state.safeMove.hill.bestTargetDistance
							or math.huge
						) - 2.5

				if madeEscapeProgress then
					state.safeMove.hill.bestProjection =
						projection
				end

				if madeTargetProgress then
					state.safeMove.hill.bestTargetDistance =
						flatDistance
				end

				if madeEscapeProgress
					or madeTargetProgress then

					state.safeMove.hill.progressAt =
						tick()

					-- Prevent generic stall logic from firing merely because
					-- we're moving laterally around the mountain.
					lastProgressAt = tick()
				end
			end

			local calmRiverApproach =
				riverApproach
				and purpose == "water"
				and not aquaticBankClimber
				and flatDistance
					<= riverApproachRadius

			local animalKey =
				state.safeMovementAnimalKey(character)

			local flying =
				state.questFlyingAnimals
				and state.questFlyingAnimals[animalKey] == true

			local activeSwimApproach =
				swimApproach
				and flatDistance <= swimActivationDistance

			local verticalMovement =
				forceVertical or activeSwimApproach or flying

			-- Manual Move To and selected automatic routes use the same reliable
			-- WalkSpeed + Humanoid:MoveTo motor on EVERY terrestrial animal.
			-- forceMoveToLand is opt-in so unrelated food/water controllers keep
			-- their existing behavior. ZoneTime uses it to match Move To Locations.
			-- vMOVETO: Food/Water terrestrial routes use the exact same
			-- WalkSpeed + Humanoid:MoveTo motor as Move To Locations.
			-- IMPORTANT: this does NOT alter the TravelDistance Permanent-W system.
			local moveToDrivenLand =
				not verticalMovement
					and (
						state.safeMove.heavy
							or purpose == "manual"
							or purpose == "food"
							or purpose == "water"
							or options.forceMoveToLand == true
					)

			-- Terrestrial TravelDistance forces W as a movement signal while
			-- the planner remains the world-space steering authority.
			local landQuestTap =
				state.autoQuests
					and state.questLandInputActive
					and not activeSwimApproach
					and not flying
					and purpose ~= "safety"
					and purpose ~= "spawn"
					and purpose ~= "manual"
					and not calmRiverApproach
					and flatDistance > math.max(tolerance * 2.5, 8)

			state.safeMove.landQuestW =
				landQuestTap == true

			state.safeMove.nativeW = false

			-- Held W is reserved for the separate Swimming path.
			if state.questSetW then
				state.questSetW(false)
			end

			if state.questSetLandPermanentW then
				state.questSetLandPermanentW(
					landQuestTap == true
				)
			end

			if landQuestTap then
				state.questMotionMoving = true
				state.questMotionMode = "Land"
			end

			local verticalGoal = position.Y

			if flying and not activeSwimApproach then
				verticalGoal = flatDistance > 30
					and math.max(position.Y + 18, current.Y)
					or position.Y + 5
			end

			local yError = verticalGoal - current.Y

			local reached =
				flatDistance <= tolerance
				and (
					not verticalMovement
					or math.abs(yError)
						<= (
							strictVerticalTolerance
								and math.max(
									0.5,
									strictVerticalTolerance
								)
								or math.max(
									tolerance,
									16
								)
						)
				)

			if reached then
				if faceTowards and root.Parent then
					local face = Vector3.new(
						faceTowards.X - root.Position.X,
						0,
						faceTowards.Z - root.Position.Z
					)

					if face.Magnitude > 0.5 then
						pcall(function()
							root.CFrame = CFrame.lookAt(
								root.Position,
								root.Position + face.Unit,
								Vector3.yAxis
							)
						end)
					end
				end

				return true
			end

			local progressDistance = verticalMovement
				and (position - current).Magnitude
				or flatDistance

			local now = tick()

			-- v5.2 CONTINUOUS PRIDE TRANSIT:
			-- moving sideways around a tree/rock is legitimate route progress even when
			-- the straight-line distance to Pride temporarily stays flat or increases.
			-- Keep this intentionally narrow to the central herbivore recovery so normal
			-- precision Food/Water/Quest routes retain their existing stall sensitivity.
			if continuousPrideTransit then
				local physicalDelta = Vector3.new(
					current.X - pridePhysicalAnchor.X,
					0,
					current.Z - pridePhysicalAnchor.Z
				).Magnitude

				if physicalDelta >= 0.70 then
					pridePhysicalAnchor = current
					pridePhysicalProgressAt = now
				end

				if progressDistance < prideBestTargetDistance - 1.10 then
					prideBestTargetDistance = progressDistance
					prideTargetProgressAt = now
				elseif prideBestTargetDistance == math.huge then
					prideBestTargetDistance = progressDistance
					prideTargetProgressAt = now
				end
			end

			if progressDistance < lastDistance - 1.25 then
				lastDistance = progressDistance
				lastProgressAt = now
				if continuousPrideTransit then
					prideBestTargetDistance = math.min(
						prideBestTargetDistance,
						progressDistance
					)
					prideTargetProgressAt = now
				end
				stallCount = math.max(
					0,
					stallCount - 1
				)

			elseif continuousPrideTransit
				and now - pridePhysicalProgressAt <= 1.10
				and now - prideTargetProgressAt <= 5.0 then

				-- Do not pulse Stop/Walking/replan while the body is genuinely travelling.
				-- Five seconds of lateral-only movement is enough to clear a large rock;
				-- after that, if Pride distance still never improves, normal stall recovery
				-- is allowed to take over so we cannot orbit an obstacle forever.
				lastProgressAt = now
				state.safeMove.lastProgressAt = now
				stallCount = math.max(0, stallCount - 1)

			elseif rawVerticalTransit then
				-- Terrain crossing must not trigger side-steering or Space.
				if tick() - lastProgressAt >= 3.5 then
					runtimeMessage =
						"Underground Drink vertical transit made no progress"
					return false
				end

			elseif calmRiverApproach then
				-- The river bank itself must never trigger oscillation or jump.
				if tick() - lastProgressAt >= 3.2 then
					runtimeMessage =
						"River bank approach blocked; trying another exposed bank"
					return false
				end

			elseif tick() - lastProgressAt >= 1.35 then
				if tick() < hillAvoidUntil
					and state.safeMove.hill
					and state.safeMove.hill.sign then

					local hill =
						state.safeMove.hill

					-- Do NOTHING while the committed side is still producing
					-- real escape progress. No left/right flipping, no Space.
					if tick()
						- (hill.progressAt or 0)
						>= 3.4 then

						local failedSign =
							hill.sign

						if failedSign < 0 then
							state.safeMove.hillFailureLeftUntil =
								tick() + 18

							state.safeMove.hillFailureLeftPosition =
								root.Position
						else
							state.safeMove.hillFailureRightUntil =
								tick() + 18

							state.safeMove.hillFailureRightPosition =
								root.Position
						end

						hill.switchCount =
							(hill.switchCount or 0) + 1

						local forward =
							flatDistance > 0.1
								and flatDelta.Unit
								or Vector3.new(
									root.CFrame.LookVector.X,
									0,
									root.CFrame.LookVector.Z
								).Unit

						if hill.switchCount >= 3 then
							if state.runLowTerrainSlopeAssist({
								character = character,
								root = root,
								humanoid = humanoid,
								forward = forward,
								routeMaximumSpeed = maximumSpeed,
								purpose = purpose,
								calmRiverApproach = calmRiverApproach,
								verticalMovement = verticalMovement,
								token = token,
								options = options,
								position = position,
							}) then
								hill.sign = nil
								hill.escapeDirection = nil
								hill.switchCount = 0
								hillAvoidUntil = 0
								stallCount = 0
								hardStuckEscapeCount = 0
								lastDistance = math.huge
								lastProgressAt = tick()
								lastBlockingInstance = nil
								blockingSince = 0
								RunService.Heartbeat:Wait()
								continue
							end

							runtimeMessage =
								"Hill route trapped: both sides failed and low assist unavailable; restarting route"

							return false
						end

						local currentGroundY =
							terrainHeightAt(
								root.Position,
								root.Position.Y
							)
							or root.Position.Y

						-- The failed side receives a huge temporary penalty,
						-- so chooser strongly prefers the other real corridor.
						hill.sign = nil

						hillAvoidSign =
							chooseHillAvoidSide(
								root.Position,
								forward,
								currentGroundY
							)

						hill.sign =
							hillAvoidSign

						obstacleSign =
							hillAvoidSign

						hillAvoidUntil =
							tick() + 6.5

						hill.startedAt =
							tick()

						hill.progressAt =
							tick()

						hill.anchor =
							root.Position

						local escapeAngle =
							math.rad(
								(
									62
									+ math.min(
										18,
										hill.switchCount * 8
									)
								)
								* hillAvoidSign
							)

						local c =
							math.cos(
								escapeAngle
							)

						local s =
							math.sin(
								escapeAngle
							)

						hill.escapeDirection =
							Vector3.new(
								forward.X * c
									- forward.Z * s,
								0,
								forward.X * s
									+ forward.Z * c
							).Unit

						hill.bestProjection = 0
						hill.bestTargetDistance =
							flatDistance

						stallCount = 0
						lastProgressAt = tick()

						runtimeMessage =
							"High hill: "
							.. (
								failedSign < 0
									and "LEFT"
									or "RIGHT"
							)
							.. " failed; committing "
							.. (
								hillAvoidSign < 0
									and "LEFT"
									or "RIGHT"
							)
					end
				else
					lastProgressAt = tick()
					stallCount += 1

					local prideRockStall =
						state.safeMove.prideRockEscapeDirection ~= nil
						and state.movementPrideRockNearby(
							root.Position,
							28
						)

					if prideRockStall then
						-- Keep the committed side. Re-scoring here was one of the
						-- causes of left/right oscillation around PrideRock.
						runtimeMessage =
							"Pride Rock: stalled; keeping committed bypass side"
					else
						obstacleSign *= -1
					end

					local persistentObjectTrap =
						prideRockStall
						or (
							lastBlockingInstance ~= nil
							and blockingSince > 0
							and tick()
								- blockingSince
								>= 1.0
						)

					local dinoWaterSearchWithoutRealObstacle =
						isDinoLife
						and purpose == "water_search"
						and not persistentObjectTrap

					local shouldHardEscape =
						not verticalMovement
						and not calmRiverApproach
						and not dinoWaterSearchWithoutRealObstacle
						and (
							stallCount >= 2
								or persistentObjectTrap
						)
						and tick()
							- lastHardStuckEscapeAt
							>= 3.8

					if dinoWaterSearchWithoutRealObstacle
						and stallCount >= 2 then
						-- Open-ground Dino search stall: restart the SAME forward movement
						-- transaction. Never invent a back/side obstacle escape when no
						-- obstacle was actually detected.
						pcall(state.heavyWalkStop, character)
						lastBlockingInstance = nil
						blockingSince = 0
						obstacleSign = 1
						stallCount = 0
						lastDistance = math.huge
						lastProgressAt = tick()
						runtimeMessage =
							"Dino water watchdog: restarting forward search movement"
						RunService.Heartbeat:Wait()
						continue
					end

					if shouldHardEscape then
						-- Same blocker still pins us: widen the remembered route and flip
						-- side before invoking the heavier generic back/side watchdog.
						if objectBypass.instance
							and objectBypass.instance.Parent
							and objectBypass.failures < 2
							and flatDistance > 0.1 then

							objectBypass.failures += 1
							local blocker = objectBypass.instance
							local opposite = -(objectBypass.sign or obstacleSign)
							local failures = objectBypass.failures
							clearObjectBypass()
							objectBypass.failures = failures

							if buildObjectBypass(
								{ Instance = blocker },
								flatDelta.Unit,
								true,
								opposite
							) then

								stallCount = 0
								lastDistance = math.huge
								lastProgressAt = tick()
								lastBlockingInstance = nil
								blockingSince = 0
								runtimeMessage =
									"Obstacle still blocking: widening committed detour"
								RunService.Heartbeat:Wait()
								continue
							end
						end

						lastHardStuckEscapeAt =
							tick()

						hardStuckEscapeCount += 1

						if isDinoLife
							and purpose == "food"
							and state.dinoRockPressureMetrics
							and select(
								1,
								state.dinoRockPressureMetrics(
									character,
									root.Position
								)
							) then

							state.dinoRockEmergency.objectiveStalled =
								true

							state.dinoRockEmergency.foodRouteFailures =
								math.max(
									1,
									state.dinoRockEmergency.foodRouteFailures
										or 0
								)

							runtimeMessage =
								"DINO ROCK WATCHDOG: Food SafeMove stalled beside rocks -> Safety handoff"

							mmbTaskDefer(function()
								task.wait(0.02)

								state.startDinoRockTrapRecovery(
									"Food SafeMove hard-stalled under rock pressure",
									true
								)
							end)

							return false
						end

						local escapeForward

						if prideRockStall
							and state.safeMove.prideRockEscapeDirection
							and state.safeMove.prideRockEscapeDirection.Magnitude > 0.05 then

							escapeForward =
								state.safeMove.prideRockEscapeDirection.Unit
						else
							escapeForward =
								flatDistance > 0.1
									and flatDelta.Unit
									or Vector3.new(
										root.CFrame.LookVector.X,
										0,
										root.CFrame.LookVector.Z
									).Unit
						end

						-- Last resort only after the watchdog has independently reached this
						-- hard-stuck branch multiple times. Croc/Hippo get it after two
						-- verified failures because their rigs cannot jump out of pits; other
						-- grounded animals require three. Pride Rock keeps its dedicated bypass.
						if not prideRockStall
							and state.confirmedTrapShouldFly(
								character,
								root,
								hardStuckEscapeCount
							)
							and state.runConfirmedTrapFlyEscape({
								character = character,
								root = root,
								humanoid = humanoid,
								forward = escapeForward,
								routeMaximumSpeed = maximumSpeed,
								purpose = purpose,
								calmRiverApproach = calmRiverApproach,
								verticalMovement = verticalMovement,
								token = token,
								options = options,
								position = position,
							}) then

							stallCount = 0
							hardStuckEscapeCount = 0
							lastDistance = math.huge
							lastProgressAt = tick()
							lastBlockingInstance = nil
							blockingSince = 0
							hillAvoidUntil = 0
							if state.safeMove.hill then
								state.safeMove.hill.sign = nil
								state.safeMove.hill.escapeDirection = nil
								state.safeMove.hill.switchCount = 0
							end
							RunService.Heartbeat:Wait()
							continue
						end

						if state.safeMove.routeInterruptReason then
							return false
						end

						local escaped =
							runHardStuckEscape(
								escapeForward,
								maximumSpeed,
								moveToDrivenLand
							)

						-- A routeCheck can fire from inside moveStuckSegment now. Do not
						-- resume the old destination for even one frame after that interrupt.
						if state.safeMove.routeInterruptReason then
							return false
						end

						if escaped then
							stallCount =
								0

							lastDistance =
								math.huge

							lastProgressAt =
								tick()

							lastBlockingInstance =
								nil

							blockingSince =
								0

							if prideRockStall then
								state.prideRockObstacleCache.escapeAt = 0
								state.prideRockObstacleCache.commitDirection = nil
								state.prideRockObstacleCache.commitSign = nil
								state.prideRockObstacleCache.commitUntil = 0
								state.safeMove.prideRockEscapeDirection = nil
							end

							runtimeMessage =
								prideRockStall
									and "Pride Rock: wide exit completed; route resumed"
									or "Stuck watchdog: object trap escaped; route resumed"

							RunService.Heartbeat:Wait()
							continue
						end

						if not prideRockStall then
							if state.runLowTerrainSlopeAssist({
								character = character,
								root = root,
								humanoid = humanoid,
								forward = escapeForward,
								routeMaximumSpeed = maximumSpeed,
								purpose = purpose,
								calmRiverApproach = calmRiverApproach,
								verticalMovement = verticalMovement,
								token = token,
								options = options,
								position = position,
							}) then
								stallCount = 0
								hardStuckEscapeCount = 0
								lastDistance = math.huge
								lastProgressAt = tick()
								lastBlockingInstance = nil
								blockingSince = 0
								hillAvoidUntil = 0
								if state.safeMove.hill then
									state.safeMove.hill.sign = nil
									state.safeMove.hill.escapeDirection = nil
									state.safeMove.hill.switchCount = 0
								end
								RunService.Heartbeat:Wait()
								continue
							end
						end
					end

					-- PrideRock specifically never jumps into its own cave meshes.
					if not prideRockStall
						and not moveToDrivenLand
						and not state.safeMove.heavy
						and tick() - lastJumpAt >= 1.6 then
						lastJumpAt = tick()
						state.virtualJump(character, humanoid, "safe_move_stall", 1.5)
					end

					local effectiveStallBudget =
						prideRockStall
							and stallBudget * 3
							or stallBudget

					local effectiveEscapeLimit =
						prideRockStall
							and 5
							or 3

					if stallCount >= effectiveStallBudget
						or hardStuckEscapeCount >= effectiveEscapeLimit then

						runtimeMessage =
							prideRockStall
								and "Pride Rock exit still blocked; route will retry from a new plan"
								or "Movement blocked after wide escape attempts; route will retry later"

						return false
					end
				end
			end

			state.safeMove.lastDistance = progressDistance
			state.safeMove.lastProgressAt = lastProgressAt

			local desired

			if verticalMovement then
				local three = Vector3.new(
					flatDelta.X,
					yError,
					flatDelta.Z
				)

				if three.Magnitude > 0.1 then
					desired = three.Unit
				end
			elseif flatDistance > 0.1 then
				desired = flatDelta.Unit
			end

			if not desired then
				RunService.Heartbeat:Wait()
				continue
			end

			-- COMMITTED OBJECT BYPASS: once a real rock/tree blocks the body, steer
			-- to one remembered side waypoint until the animal physically clears it.
			if objectBypass.instance
				and objectBypass.instance.Parent
				and typeof(objectBypass.point) == "Vector3"
				and tick() < (objectBypass.untilAt or 0) then

				local bypassDelta = Vector3.new(
					objectBypass.point.X - root.Position.X,
					0,
					objectBypass.point.Z - root.Position.Z
				)

				local clearRadius = math.clamp(
					state.movementFootprint(character) * 0.42,
					4.5,
					10
				)

				if bypassDelta.Magnitude <= clearRadius then
					clearObjectBypass()
				else
					desired = bypassDelta.Unit
					obstacleSign = objectBypass.sign or obstacleSign
				end
			elseif objectBypass.instance then
				clearObjectBypass()
			end

			-- Land animals avoid entering water while travelling across the map.
			-- Water routes are allowed to approach the shoreline only near the
			-- selected drinking destination. Aquatic animals are not restricted.
			if not allowIntentionalWaterTransit
				and not calmRiverApproach
				and not verticalMovement
				and flatDistance > tolerance * 1.5
				and (
					not isAquaticCharacter(
						character
					)
					or aquaticBankClimber
				) then

				local aheadDistance =
					math.clamp(
						maximumSpeed * 0.28,
						10,
						34
					)

				local ahead =
					root.Position
					+ desired
						* aheadDistance

				local waterAhead = false

				if aquaticBankClimber then
					-- IMPORTANT: MainWaterPart is enormous and exists underneath
					-- dry Terrain. Its X/Z footprint is NOT a valid "water ahead"
					-- test. Only visible/exposed Terrain Water may alter a land route.
					waterAhead =
						exposedTerrainWaterAt(
							ahead
						)
				else
					local terrainProbe =
						RaycastParams.new()

					terrainProbe.FilterType =
						Enum.RaycastFilterType.Include

					terrainProbe.FilterDescendantsInstances = {
						workspace.Terrain,
					}

					terrainProbe.IgnoreWater = false

					local groundAhead =
						workspace:Raycast(
							ahead
								+ Vector3.new(
									0,
									90,
									0
								),
							Vector3.new(
								0,
								-180,
								0
							),
							terrainProbe
						)

					waterAhead =
						groundAhead
						and groundAhead.Material
							== Enum.Material.Water
				end

				local mayApproachWater =
					purpose == "water"
					and not aquaticBankClimber
					and flatDistance <= 48

				if waterAhead and not mayApproachWater then
					if aquaticBankClimber
						and not waterBridgeDone then

						local bridge =
							exposedWaterBridgeAhead(
								root.Position,
								position
							)

						if bridge then
							local crossed =
								runMainWaterElevatedBridge(
									bridge,
									maximumSpeed
								)

							if crossed then
								waterBridgeDone = true
								lastProgressAt = tick()
								lastDistance = math.huge

								-- Recalculate the world-space target vector next
								-- frame from the new position on the far bank.
								RunService.Heartbeat:Wait()
								continue
							end
						end
					end

					-- No confirmed far bank: steer around the actually exposed
					-- water. This branch can no longer fire just because an
					-- underground MainWaterPart exists under dry land.
					local angle =
						math.rad(
							68 * obstacleSign
						)

					local c =
						math.cos(
							angle
						)

					local s =
						math.sin(
							angle
						)

					desired =
						Vector3.new(
							desired.X * c
								- desired.Z * s,
							0,
							desired.X * s
								+ desired.Z * c
						).Unit
				end
			end

			-- ------------------------------------------------------------
			-- HIGH HILL / MOUNTAIN AVOIDANCE
			-- Regular slopes are allowed. We only divert when the terrain
			-- directly ahead rises sharply into a high peak, which is where the
			-- old straight-line Swim route tended to get stuck climbing.
			-- ------------------------------------------------------------
			if not calmRiverApproach
				and not verticalMovement
				and not (
					aquaticBankClimber
					and purpose == "safety"
				)
				and not (
					carcassInteractionRoute
					and flatDistance <= carcassTerminalRadius
				)
				and flatDistance
					> math.max(
						tolerance * 2,
						28
					) then

				local dinoWaterRoute =
					isDinoLife
					and (
						purpose == "water"
						or purpose == "water_search"
					)

				local hillCheckInterval =
					dinoWaterRoute
					and 1.10
					or 0.28

				if tick() >= hillAvoidUntil
					and tick() - lastHillCheckAt
						>= hillCheckInterval then

					lastHillCheckAt = tick()

					local currentGroundY =
						terrainHeightAt(root.Position, root.Position.Y)
						or root.Position.Y

					local peakRise = 0
					local peakSlope = 0

					for _, sampleDistance in ipairs({ 18, 30, 46, 64, 82 }) do
						local samplePoint =
							root.Position + desired * sampleDistance

						local sampleY =
							terrainHeightAt(
								samplePoint,
								root.Position.Y
							)

						if sampleY then
							local rise =
								sampleY - currentGroundY

							if rise > peakRise then
								peakRise = rise
							end

							local slope =
								rise / math.max(sampleDistance, 1)

							if slope > peakSlope then
								peakSlope = slope
							end
						end
					end

					-- Intentionally conservative: do not dodge ordinary hills.
					-- Trigger only on a tall rise plus a steep approach.
					-- Food routes are allowed to climb substantial grassy slopes.
					-- Only a genuinely mountain-like wall should divert them.
					local foodRoute = purpose == "food"

					local highPeak
					local extremePeak

					if aquaticBankClimber then
						-- Croc/Hippo routinely climb steep river banks. The normal
						-- high-hill thresholds mistake a beach/ramp for a mountain
						-- and send them sideways along the shore. Only divert these
						-- two animals for a genuinely large terrain wall.
						highPeak =
							peakRise >= 46
							and peakSlope >= 0.68

						extremePeak =
							peakRise >= 62
					else
						highPeak = foodRoute
							and (
								peakRise >= 48
								and peakSlope >= 0.66
							)
							or (
								not foodRoute
								and peakRise >= 28
								and peakSlope >= 0.48
							)

						extremePeak = foodRoute
							and peakRise >= 66
							or (
								not foodRoute
								and peakRise >= 42
							)
					end

					if highPeak or extremePeak then
						local detectedHill = state.safeMove.hill
						if detectedHill then
							detectedHill.lastPeakRise = peakRise
							detectedHill.lastPeakSlope = peakSlope
							detectedHill.lastDetectedAt = tick()
						end

						hillAvoidSign =
							chooseHillAvoidSide(
								root.Position,
								desired,
								currentGroundY
							)

						-- Synchronize generic obstacle steering with the committed
						-- mountain side instead of letting two controllers fight.
						obstacleSign =
							hillAvoidSign

						hillAvoidUntil =
							tick() + 6.0

						local hill =
							state.safeMove.hill

						hill.sign =
							hillAvoidSign

						hill.startedAt =
							tick()

						hill.progressAt =
							tick()

						hill.anchor =
							root.Position

						hill.bestProjection = 0
						hill.bestTargetDistance =
							flatDistance

						local escapeAngle =
							math.rad(
								(
									62
									+ math.min(
										18,
										(hill.switchCount or 0) * 8
									)
								)
								* hillAvoidSign
							)

						local c =
							math.cos(
								escapeAngle
							)

						local s =
							math.sin(
								escapeAngle
							)

						hill.escapeDirection =
							Vector3.new(
								desired.X * c
									- desired.Z * s,
								0,
								desired.X * s
									+ desired.Z * c
							).Unit

						runtimeMessage =
							string.format(
								"High hill: committing %s (L %.0f / R %.0f, rise +%.0f)",
								hillAvoidSign < 0
									and "LEFT"
									or "RIGHT",
								tonumber(hill.leftScore)
									or -1,
								tonumber(hill.rightScore)
									or -1,
								peakRise
							)
					end
				end

				if tick() < hillAvoidUntil then
					local hillAngle =
						math.rad(
							(
								62
								+ math.min(
									18,
									(
										state.safeMove.hill
										and state.safeMove.hill.switchCount
										or 0
									) * 8
								)
							)
							* hillAvoidSign
						)

					local c = math.cos(hillAngle)
					local s = math.sin(hillAngle)

					desired = Vector3.new(
						desired.X * c - desired.Z * s,
						0,
						desired.X * s + desired.Z * c
					).Unit
				end
			end

			local terrainClimbAssist = 0

			-- Physical obstacle avoidance. It changes direction, never position.
			-- Terrain slopes are NOT treated like trees/rocks. Normal hills are
			-- climbed directly; only the high-hill detector above diverts them.
			if not verticalMovement
				and flatDistance > tolerance * 1.5
				and not (
					suspendObstacleAvoidanceNearTarget
						and obstacleSuspendDistance > 0
						and flatDistance <= obstacleSuspendDistance
				) then

				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				params.FilterDescendantsInstances =
					typeof(options.ignoreObstacleInstance) == "Instance"
						and { character, options.ignoreObstacleInstance }
						or { character }
				params.IgnoreWater = true

				local probeDistance =
					math.clamp(
						maximumSpeed * 0.28,
						9,
						28
					)

				local carcassTerminalApproach =
					carcassInteractionRoute
						and flatDistance <= carcassTerminalRadius

				local dinoWaterTerminalApproach =
					isDinoLife
						and purpose == "water"
						and flatDistance <= math.clamp(
							state.movementFootprint(character) * 1.55 + 8,
							18,
							34
						)

				-- Never let interaction obstacle rays inspect geometry BEHIND the target.
				-- The Dino 5x3 probe could see a rock/tree past a nearby carcass and
				-- steer the Rex sideways even though the bite destination was already clear.
				local remainingProbe =
					math.max(
						tolerance * 1.15,
						flatDistance - tolerance * 0.35
					)

				local rayProbeDistance = probeDistance
				local longProbeDistance =
					math.max(
						probeDistance,
						math.clamp(
							maximumSpeed * 0.62
								+ state.movementFootprint(character) * 1.20,
							22,
							72
						)
					)

				if carcassInteractionRoute then
					rayProbeDistance = math.min(
						probeDistance,
						remainingProbe
					)
					longProbeDistance = math.min(
						longProbeDistance,
						remainingProbe
					)
				end

				-- Keep the full body-aware Dino scanner on the route, but switch to one
				-- short center lane during the final bite approach. Side rocks no longer
				-- make the animal orbit the carcass; immediate collision protection stays.
				local volumeObjectProbe =
					not carcassTerminalApproach
					and not dinoWaterTerminalApproach
					and (
						moveToDrivenLand
						or state.movementPrideRockNearby(
							root.Position,
							36
						)
					)

				local dinoWaterRoute =
					isDinoLife
					and (
						purpose == "water"
						or purpose == "water_search"
					)

				local obstacle

				if dinoWaterRoute
					and state.dinoWaterLightObstacleProbe then

					local now = tick()
					local sameHeading =
						dinoWaterObstacleDirection
						and dinoWaterObstacleDirection:Dot(desired) >= 0.94

					if sameHeading
						and now - dinoWaterObstacleAt <= 0.30 then
						obstacle = dinoWaterObstacleResult
					else
						obstacle =
							state.dinoWaterLightObstacleProbe(
								character,
								root,
								desired,
								math.min(longProbeDistance, 24),
								options.ignoreObstacleInstance
							)

						dinoWaterObstacleAt = now
						dinoWaterObstacleDirection = desired
						dinoWaterObstacleResult = obstacle
					end
				else
					-- Generic Dino/navigation routes keep the full individual-rock protector.
					local protectedRockObstacle =
						state.prideRockObstacleProbe(
							character,
							root,
							desired,
							longProbeDistance
						)

					obstacle =
						protectedRockObstacle
						or (
							volumeObjectProbe
								and state.heavyObstacleProbe(
									character,
									root,
									desired,
									longProbeDistance,
									options.ignoreObstacleInstance
								)
								or state.movementRaycastIgnoringCarcasses(
								root.Position
									+ Vector3.new(
										0,
										state.safeMove.probeHeight
											or 2.5,
										0
									),
								desired * rayProbeDistance,
								params
							)
						)
				end

				if carcassTerminalApproach or dinoWaterTerminalApproach then
					state.safeMove.heavyObstacleSign = nil

					local immediateDistance =
						math.clamp(
							state.movementFootprint(character) * 0.22,
							1.8,
							4.2
						)

					local protectedRockHit =
						obstacle
						and state.movementIsPrideRockInstance(
							obstacle.Instance
						)

					if obstacle
						and not protectedRockHit
						and tonumber(obstacle.Distance)
						and obstacle.Distance > immediateDistance then
						obstacle = nil
					end
				end

				if not dinoWaterRoute
					and volumeObjectProbe
					and state.safeMove.heavyObstacleSign then
					obstacleSign =
						state.safeMove.heavyObstacleSign
				end

				if obstacle
					and (
						volumeObjectProbe
							or math.abs(
								obstacle.Normal.Y
							) < 0.72
					) then

					if obstacle.Instance ~= lastBlockingInstance then
						lastBlockingInstance = obstacle.Instance
						blockingSince = tick()
					elseif blockingSince <= 0 then
						blockingSince = tick()
					end

					local terrainHit =
						obstacle.Instance == workspace.Terrain

					local prideRockHit =
						state.movementIsPrideRockInstance(
							obstacle.Instance
						)

					if terrainHit
						and calmRiverApproach then

						-- River Terrain lip is destination geometry, not an obstacle.
						lastBlockingInstance = nil
						blockingSince = 0

					elseif terrainHit
						and tick() < hillAvoidUntil then

						-- High-hill controller already owns this Terrain.
						-- DO NOT reinterpret the mountain as a tree/rock,
						-- DO NOT apply obstacleSign again, and DO NOT jump.
						lastBlockingInstance = nil
						blockingSince = 0

					elseif terrainHit
						and tick()
							>= hillAvoidUntil then

						local currentGroundY =
							terrainHeightAt(
								root.Position,
								root.Position.Y
							)
							or root.Position.Y

						local aheadGroundY =
							terrainHeightAt(
								root.Position
									+ desired
										* math.min(
											probeDistance,
											12
										),
								root.Position.Y
							)

						local rise =
							aheadGroundY
								and (
									aheadGroundY
									- currentGroundY
								)
								or 0

						if rise > 1 and rise < 28 and not state.safeMove.heavy then
							local assistScale =
								purpose == "food"
									and 0.55
									or 0.35

							local assistCap =
								purpose == "food"
									and math.min(
										maximumSpeed * 0.45,
										16
									)
									or math.min(
										maximumSpeed * 0.30,
										11
									)

							terrainClimbAssist =
								math.min(
									assistCap,
									math.max(
										4,
										rise
											* assistScale
									)
								)
						end

						if not moveToDrivenLand
							and tick() - blockingSince >= 0.45
							and tick() - lastJumpAt >= 0.9 then

							lastJumpAt = tick()

							state.virtualJump(
								character,
								humanoid,
								"terrain_slope",
								0.85
							)
						end

					else
						-- PrideRock / Dino rock basins keep their dedicated model bypass.
						-- Ordinary objects receive a body-sized committed waypoint.
						local prideEscape =
							prideRockHit
							and state.safeMove.prideRockEscapeDirection

						if prideEscape
							and prideEscape.Magnitude > 0.05 then
							desired = prideEscape.Unit
							runtimeMessage =
								isDinoLife
									and (
										state.safeMove.dinoBasinBypassActive
											and "Dino restricted basin: going around rock pit"
											or "Dino Rocks: following individual rock bypass"
									)
									or "Pride Rock: following committed circular bypass"
						else
							local blocker = obstacle.Instance
							local routeForward =
								flatDistance > 0.1
									and flatDelta.Unit
									or desired

							if objectBypass.instance ~= blocker
								or not objectBypass.point
								or tick() >= (objectBypass.untilAt or 0) then

								objectBypass.failures = 0
								buildObjectBypass(
									obstacle,
									routeForward,
									false,
									obstacleSign
								)
							end

							if objectBypass.point then
								local bypassDelta = Vector3.new(
									objectBypass.point.X - root.Position.X,
									0,
									objectBypass.point.Z - root.Position.Z
								)

								if bypassDelta.Magnitude > 0.5 then
									desired = bypassDelta.Unit
									obstacleSign = objectBypass.sign or obstacleSign
									runtimeMessage =
										objectBypass.sign == -1
											and "Obstacle: committed LEFT bypass around rock/tree"
											or "Obstacle: committed RIGHT bypass around rock/tree"
								end
							else
								local angle = math.rad(58 * obstacleSign)
								local c = math.cos(angle)
								local s = math.sin(angle)
								desired = Vector3.new(
									desired.X * c - desired.Z * s,
									0,
									desired.X * s + desired.Z * c
								).Unit
							end
						end

						if not prideRockHit
							and not moveToDrivenLand
							and not calmRiverApproach
							and tick() >= hillAvoidUntil
							and (
								tick() - blockingSince
									>= 0.70
								or stallCount > 0
							)
							and tick() - lastJumpAt
								>= 0.9 then

							lastJumpAt = tick()

							state.virtualJump(
								character,
								humanoid,
								"object_after_avoid",
								0.85
							)
						end
					end
				else
					lastBlockingInstance = nil
					blockingSince = 0
				end
			end

			if stallCount > 0
				and not state.safeMove.prideRockEscapeDirection
				and not calmRiverApproach
				and not verticalMovement
				and not (
					suspendObstacleAvoidanceNearTarget
						and obstacleSuspendDistance > 0
						and flatDistance <= obstacleSuspendDistance
				)
				and tick() >= hillAvoidUntil then
				local angle =
					math.rad(
						math.min(65, 24 + stallCount * 8)
						* obstacleSign
					)

				local c = math.cos(angle)
				local s = math.sin(angle)

				desired = Vector3.new(
					desired.X * c - desired.Z * s,
					0,
					desired.X * s + desired.Z * c
				).Unit
			end

			if rawVerticalTransit then
				pcall(function()
					humanoid.PlatformStand = true
					humanoid.AutoRotate = false
					humanoid:ChangeState(
						Enum.HumanoidStateType.Physics
					)
				end)

				character:SetAttribute(
					"MovementDisabled",
					true
				)

				root.AssemblyAngularVelocity =
					Vector3.zero
			end

			if not moveToDrivenLand then
				pcall(function()
					local face =
						Vector3.new(
							desired.X,
							0,
							desired.Z
						)

					if face.Magnitude > 0.1 then
						root.CFrame =
							CFrame.lookAt(
								root.Position,
								root.Position
									+ face.Unit,
								Vector3.yAxis
							)
					end
				end)
			end

			if landQuestTap
				and state.questLandPermanentWSetSteer then

				state.questLandPermanentWSetSteer(
					character,
					desired,
					position
				)
			end

			if not rawVerticalTransit then
				pcall(
					humanoid.Move,
					humanoid,
					moveToDrivenLand
						and Vector3.zero
						or Vector3.new(
							desired.X,
							0,
							desired.Z
						),
					false
				)
			else
				pcall(
					humanoid.Move,
					humanoid,
					Vector3.zero,
					false
				)
			end

			if activeSwimApproach then
				setSubState("Swimming")
			elseif flying then
				setSubState("Flying")
			elseif state.safeMove.heavy and flatDistance <= math.max(tolerance * 3, 24) then
				setSubState("Walking")
			else
				setSubState("Running")
			end

			-- Normal routes slow down near the target for precise positioning.
			-- Some interactions (notably grass eating) work better if the animal
			-- keeps its normal Acceleration speed until it reaches the target.
			local remainingScale = constantSpeed
				and 1
				or math.clamp(progressDistance / 24, 0.18, 1)

			local speed = math.min(
				maximumSpeed,
				math.max(4, maximumSpeed * remainingScale)
			)

			local velocity = root.AssemblyLinearVelocity

			if verticalMovement then
				root.AssemblyLinearVelocity = Vector3.new(
					desired.X * speed,
					math.clamp(desired.Y * speed, -maximumSpeed, maximumSpeed),
					desired.Z * speed
				)
			elseif moveToDrivenLand then
				-- v127 manual Move To and heavy land routes use the same reliable
				-- WalkSpeed + Humanoid:MoveTo execution engine.
				local moveOwner =
					purpose == "manual"
						and "manual"
						or "safeMove"

				local walked =
					state.heavyWalkStep(
						character,
						root,
						humanoid,
						desired,
						speed,
						progressDistance,
						position,
						moveOwner,
						token
					)

				if not walked then
					pcall(
						humanoid.MoveTo,
						humanoid,
						root.Position
					)
				end
			else
				root.AssemblyLinearVelocity = Vector3.new(
					desired.X * speed,
					terrainClimbAssist > 0 and math.max(velocity.Y, terrainClimbAssist) or velocity.Y,
					desired.Z * speed
				)
			end

			character:SetAttribute(
				"MovementDisabled",
				rawVerticalTransit
			)

			RunService.Heartbeat:Wait()
		end

		return false
	end)

	local cancelledByUser =
		purpose == "manual"
		and token ~= state.safeMove.cancelToken
		and state.safeMove.manualCancelledAt > 0
		and tick() - state.safeMove.manualCancelledAt <= 2

	cleanup()

	if movementLeaseToken
		and state.MMBAI
		and state.MMBAI.MovementManager then

		local completionReason =
			not callOk
				and tostring(result)
				or (
					token ~= state.safeMove.cancelToken
						and "cancelled or preempted"
						or (
							result == true
								and "target verified"
								or "route returned false"
						)
				)

		state.MMBAI.MovementManager:Complete(
			movementLeaseToken,
			callOk and result == true,
			completionReason
		)
	end

	if cancelledByUser then
		runtimeMessage = "Move To cancelled"
		return false
	end

	if not callOk then
		runtimeMessage =
			"Movement controller error: "
			.. tostring(result)
		return false
	end

	return result == true
end

-- Folga vertical baseada no tamanho do animal para evitar colocar o pivot
-- dentro da superfície da água.

function state.dinoWaterLightObstacleProbe(
	character,
	root,
	direction,
	probeDistance,
	ignoreObstacleInstance
)
	if not isDinoLife
		or not character
		or not root
		or typeof(direction) ~= "Vector3"
		or direction.Magnitude <= 0.05 then
		return nil
	end

	local forward =
		Vector3.new(
			direction.X,
			0,
			direction.Z
		)

	if forward.Magnitude <= 0.05 then
		return nil
	end

	forward = forward.Unit

	-- Water/search routes do NOT run the Dino OBB/basin planner. That planner is
	-- useful for generic navigation, but on rock-heavy islands it was being called
	-- repeatedly and could collapse the client to ~1 FPS. Three short physical
	-- rays are enough to avoid the rock/tree actually in front of the dinosaur.
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude

	local ignored = {
		character,
		workspace.Terrain,
	}

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	if waterPart then
		ignored[#ignored + 1] = waterPart
	end

	if state.movementDinoWaterMossVisual then
		local moss = state.movementDinoWaterMossVisual()
		if moss then
			ignored[#ignored + 1] = moss
		end
	end

	if typeof(ignoreObstacleInstance) == "Instance" then
		ignored[#ignored + 1] = ignoreObstacleInstance
	end

	params.FilterDescendantsInstances = ignored
	params.IgnoreWater = true
	pcall(function()
		params.RespectCanCollide = true
	end)

	local footprint = math.max(4, state.movementFootprint(character))
	local rayDistance =
		math.clamp(
			math.min(tonumber(probeDistance) or 20, 24),
			10,
			24
		)

	local lane =
		math.clamp(
			footprint * 0.24,
			1.8,
			6.5
		)

	local right = Vector3.new(-forward.Z, 0, forward.X)
	local height =
		math.clamp(
			state.movementProbeHeight(character) * 0.58,
			1.8,
			5.5
		)

	local best

	for _, lateral in ipairs({ 0, -lane, lane }) do
		local hit =
			state.movementRaycastIgnoringCarcasses(
				root.Position
					+ right * lateral
					+ Vector3.new(0, height, 0),
				forward * rayDistance,
				params
			)

		if hit
			and (
				not best
				or hit.Distance < best.Distance
			) then
			best = hit
		end
	end

	return best
end

function state.surfaceDrinkLegacySafeMoveToPosition(position, maxAttempts, faceTowards, options)
	if typeof(position) ~= "Vector3" then return false end

	options = type(options) == "table" and options or {}

	-- v97 Underground Drink owns movement while the animal can be under Terrain.
	-- Cancel requests a controlled surface exit; it never releases automation
	-- immediately while still buried.
	if state.drinkTest
		and state.drinkTest.active
		and options.purpose ~= "safety" then
		return false
	end

	-- v80: while a Savannah HERBIVORE is in a Growth mode, automatic food
	-- movement is never allowed to leave Pride Rock. Water routes remain exempt.
	if options.purpose == "food"
		and state.growthPrideRestrictionActive(
			player.Character
		)
		and not state.autoFoodPositionAllowed(
			position
		) then

		runtimeMessage =
			"Growth herbivore: outside-Pride food target rejected"

		return false
	end

	if state.questGrowthReset
		and state.questGrowthReset.exclusive
		and options.allowDuringGrowthReset ~= true then
		return false
	end

	if state.busy then return false end

	local character, root, humanoid = characterParts()
	if not character or not root or not humanoid then return false end

	local requestedPurpose =
		options.purpose or "movement"

	local aquaticLandPreflight =
		state.isCrocOrHippoMovementCharacter(
			character
		)
		and requestedPurpose ~= "water"
		and requestedPurpose ~= "safety"
		and options.swimming ~= true
		and options.vertical ~= true
		and options.rawVerticalTransit ~= true
		and type(
			state.moveAquaticToDryTerrain
		) == "function"
		and type(
			state.isUnderMainWaterPart
		) == "function"
		and state.isUnderMainWaterPart(
			root
		)

	if aquaticLandPreflight then
		runtimeMessage =
			CROC.isCharacter(character)
				and "Croc river exit: reaching dry bank before land movement"
				or "Hippo river exit: reaching dry bank before land movement"

		local escaped =
			state.moveAquaticToDryTerrain(
				character,
				root,
				position
			)

		if not escaped then
			runtimeMessage =
				CROC.isCharacter(character)
					and "Croc river exit failed; land route postponed"
					or "Hippo river exit failed; land route postponed"
			return false
		end

		character, root, humanoid =
			characterParts()

		if not character
			or not root
			or not humanoid then
			return false
		end
	end

	local movementLeaseToken
	if state.MMBAI and state.MMBAI.Enabled and state.MMBAI.MovementManager then
		local granted, leaseToken = state.MMBAI.MovementManager:AcquireFromSafeMove(
			requestedPurpose,
			position,
			options
		)
		if not granted then return false end
		movementLeaseToken = leaseToken
	end

	state.busy = true
	state.safeMove.active = true
	state.safeMove.target = position
	state.safeMove.reason = options.purpose or "movement"
	state.safeMove.owner = state.MMBAI
		and state.MMBAI.MovementManager
		and state.MMBAI.MovementManager:OwnerForPurpose(requestedPurpose)
		or requestedPurpose
	state.safeMove.priority = state.MMBAI
		and state.MMBAI.MovementManager
		and state.MMBAI.MovementManager:ScoreOwner(
			state.safeMove.owner,
			state.MMBAI.Blackboard,
			position
		)
		or 0
	state.safeMove.aiLeaseToken = movementLeaseToken
	state.safeMove.allowWaterTransit =
		options.allowWaterTransit == true
			or (
				(isSavannahLife or isDinoLife)
				and requestedPurpose == "manual"
			)
	state.safeMove.waterTransitKind =
		state.safeMove.allowWaterTransit
			and tostring(
				options.waterTransitKind
					or requestedPurpose
			)
			or nil
	state.safeMove.startedAt = tick()
	state.safeMove.lastProgressAt = tick()
	state.safeMove.lastDistance = math.huge
	state.safeMove.routeCheckAt = 0
	state.safeMove.routeCheckError = nil
	state.safeMove.routeInterruptReason = nil
	state.safeMove.preferredObstacleSign = nil

	state.safeMove.heavy = state.isHeavyGroundMover(character)
	state.safeMove.probeHeight = state.movementProbeHeight(character)
	state.safeMove.nativeW = false

	state.safeMove.hill = {
		sign = nil,
		startedAt = 0,
		progressAt = 0,
		anchor = nil,
		escapeDirection = nil,
		bestProjection = 0,
		bestTargetDistance = math.huge,
		switchCount = 0,
		leftScore = nil,
		rightScore = nil,
	}

	if state.safeMove.reason == "manual" then
		state.safeMove.manualLabel =
			options.manualLabel
			or state.safeMove.manualLabel
	else
		state.safeMove.manualLabel = nil
	end

	state.safeMove.cancelToken += 1

	if state.renderMoveToCancelButton then
		pcall(state.renderMoveToCancelButton)
	end

	local token = state.safeMove.cancelToken
	state.safeMove.workerToken = token
	local stallBudget = math.max(2, tonumber(maxAttempts) or 8)
	local purpose = options.purpose or "generic"
	local aquaticBankClimber =
		state.isCrocOrHippoMovementCharacter(
			character
		)
	local tolerance = tonumber(options.tolerance) or MOVE_TOLERANCE
	local speedScale =
		math.clamp(tonumber(options.speedScale) or 1, 0.05, 1)
	local speedCap = tonumber(options.maxSpeed)
	local constantSpeed = options.constantSpeed == true
	local stopOnDryGround = options.stopOnDryGround == true
	local forceVertical = options.vertical == true
	local swimApproach = options.swimming == true

	-- v98: optional precise vertical completion.
	-- Routes that do not set this keep the old SafeMove behavior.
	local strictVerticalTolerance =
		tonumber(
			options.verticalTolerance
		)

	-- v99: only the underground Underground Drink opts into this.
	-- SafeMove still changes position only through velocity.
	local rawVerticalTransit =
		options.rawVerticalTransit == true

	local riverApproach =
		options.riverApproach == true
	local riverApproachRadius =
		tonumber(
			options.riverApproachRadius
		) or 36

	-- A Swim destination should NOT disable land obstacle avoidance across the
	-- whole map. Only the final approach near the saved water point becomes 3D
	-- Swimming movement.
	local swimActivationDistance =
		tonumber(options.swimActivationDistance) or 58

	local obstacleSign = ((player.UserId % 2) == 0) and 1 or -1
	local stallCount = 0
	local lastDistance = math.huge
	local lastProgressAt = tick()
	local lastJumpAt = 0

	-- Track the SAME blocking object/terrain across frames. We steer first;
	-- Space is virtualized only if the obstacle persists or movement stalls.
	local lastBlockingInstance = nil
	local blockingSince = 0

	local lastHardStuckEscapeAt = 0
	local hardStuckEscapeCount = 0

	-- High-hill avoidance state. Lock one side briefly so the animal does not
	-- oscillate left/right while skirting a mountain.
	local hillAvoidUntil = 0
	local hillAvoidSign = obstacleSign
	local lastHillCheckAt = 0

	local lastMoveWReassertAt = 0

	local waterBridgeDone = false

	-- Dedicated low-lag Dino Water probe cache for this legacy Surface Drink
	-- route. These were previously implicit globals.
	local dinoWaterObstacleAt = 0
	local dinoWaterObstacleDirection = nil
	local dinoWaterObstacleResult = nil

	local function exposedTerrainWaterAt(
		worldPosition
	)
		if typeof(worldPosition)
			~= "Vector3" then
			return false,
				nil
		end

		local params =
			RaycastParams.new()

		params.FilterType =
			Enum.RaycastFilterType.Include

		params.FilterDescendantsInstances = {
			workspace.Terrain,
		}

		params.IgnoreWater = false

		local hit =
			workspace:Raycast(
				worldPosition
					+ Vector3.new(
						0,
						100,
						0
					),
				Vector3.new(
					0,
					-220,
					0
				),
				params
			)

		return hit
				and hit.Material
					== Enum.Material.Water,
			hit
	end

	local function exposedWaterBridgeAhead(
		fromPosition,
		toPosition
	)
		if not aquaticBankClimber
			or purpose == "water"
			or purpose == "safety"
			or swimApproach
			or forceVertical
			or rawVerticalTransit then

			return nil
		end

		local waterPart =
			workspace:FindFirstChild(
				"MainWaterPart"
			)

		if not waterPart
			or not waterPart:IsA(
				"BasePart"
			) then

			return nil
		end

		local flat =
			Vector3.new(
				toPosition.X
					- fromPosition.X,
				0,
				toPosition.Z
					- fromPosition.Z
			)

		local totalDistance =
			flat.Magnitude

		if totalDistance < 8 then
			return nil
		end

		local direction =
			flat.Unit

		-- This scanner runs ONLY after the normal look-ahead has already found
		-- exposed Terrain water. It looks for the first dry bank after that
		-- water, instead of using MainWaterPart's enormous underground footprint.
		local scanLimit =
			math.min(
				totalDistance,
				240
			)

		local step =
			8

		local enteredWater =
			false

		local entryWorld
		local exitWorld
		local dryAfterWater =
			0

		local distance =
			4

		while distance
			<= scanLimit do

			local probe =
				fromPosition
					+ direction
						* distance

			local isWater, hit =
				exposedTerrainWaterAt(
					probe
				)

			if isWater then
				if not enteredWater then
					enteredWater = true
					entryWorld =
						hit
						and hit.Position
						or probe
				end

				dryAfterWater =
					0

			elseif enteredWater
				and hit
				and hit.Material
					~= Enum.Material.Water then

				dryAfterWater += 1

				-- Require two dry samples so a tiny Terrain island/noise does
				-- not terminate the bridge in the middle of the river.
				if dryAfterWater >= 2 then
					exitWorld =
						hit.Position

					break
				end
			end

			distance += step
		end

		if not enteredWater
			or not entryWorld
			or not exitWorld then

			return nil
		end

		local entryLocal =
			waterPart.CFrame:PointToObjectSpace(
				entryWorld
			)

		local exitLocal =
			waterPart.CFrame:PointToObjectSpace(
				exitWorld
			)

		local entryDistance =
			Vector2.new(
				entryWorld.X
					- fromPosition.X,
				entryWorld.Z
					- fromPosition.Z
			).Magnitude

		return {
			part = waterPart,
			entryLocal = entryLocal,
			exitLocal = exitLocal,
			entryDistance = entryDistance,
		}
	end

	local function runMainWaterElevatedBridge(
		bridge,
		maximumSpeed
	)
		if not bridge
			or not bridge.part
			or not bridge.part.Parent then

			return false
		end

		local waterPart =
			bridge.part

		-- This is a normal ABOVE-water traversal, not an underwater exit.
		-- Keep the physical water surface solid for Croc/Hippo.
		if state.isCrocOrHippoMovementCharacter(
			character
		) then
			waterPart.CanCollide =
				true
		end

		state.heavyWalkStop(
			character
		)

		local oldAutoRotate =
			humanoid.AutoRotate

		local oldMovementDisabled =
			character:GetAttribute(
				"MovementDisabled"
			)

		local BG =
			Instance.new(
				"BodyGyro"
			)

		local BP =
			Instance.new(
				"BodyPosition"
			)

		BG.Name =
			"MMB_MainWaterBridgeGyro"

		BP.Name =
			"MMB_MainWaterBridgePosition"

		BG.P = 9e4
		BG.MaxTorque =
			Vector3.new(
				9e9,
				9e9,
				9e9
			)

		BP.P = 26000
		BP.D = 3200
		BP.MaxForce =
			Vector3.new(
				9e8,
				9e8,
				9e8
			)

		BG.CFrame =
			root.CFrame

		BP.Position =
			root.Position

		BG.Parent =
			root

		BP.Parent =
			root

		pcall(function()
			humanoid.PlatformStand = true
			humanoid.AutoRotate = false
		end)

		-- EXACTLY the same ownership policy for Croc and Hippo.
		-- Their SwimmingControllers cannot pull the rig below the surface while
		-- this elevated land-route bridge owns the root position.
		character:SetAttribute(
			"MovementDisabled",
			true
		)

		local currentLocal =
			waterPart.CFrame:PointToObjectSpace(
				root.Position
			)

		local halfY =
			waterPart.Size.Y * 0.5

		local surfaceStandOffset =
			state.aquaticWaterStandOffset(
				character
			)

		local cruiseLocalY =
			math.max(
				currentLocal.Y,
				halfY
					+ surfaceStandOffset
					+ 2.0
			)

		local routeDirection =
			Vector3.new(
				bridge.exitLocal.X
					- bridge.entryLocal.X,
				0,
				bridge.exitLocal.Z
					- bridge.entryLocal.Z
			)

		if routeDirection.Magnitude <= 0.01 then
			routeDirection =
				Vector3.new(
					1,
					0,
					0
				)
		else
			routeDirection =
				routeDirection.Unit
		end

		local outsideMargin =
			math.clamp(
				state.movementFootprint(
					character
				) * 0.22,
				3,
				5
			)

		local exitLocal =
			bridge.exitLocal
			+ routeDirection
				* outsideMargin

		local liftTarget =
			waterPart.CFrame:PointToWorldSpace(
				Vector3.new(
					currentLocal.X,
					cruiseLocalY,
					currentLocal.Z
				)
			)

		local exitTarget =
			waterPart.CFrame:PointToWorldSpace(
				Vector3.new(
					exitLocal.X,
					cruiseLocalY,
					exitLocal.Z
				)
			)

		local bridgeSpeed =
			math.clamp(
				tonumber(maximumSpeed)
					or 36,
				24,
				50
			)

		local commandedPosition =
			root.Position

		local lastHeartbeatAt =
			tick()

		local function bridgeFlyTo(
			goal,
			timeout
		)
			local deadline =
				tick()
				+ timeout

			while state.alive
				and character.Parent
				and root.Parent
				and humanoid.Parent
				and humanoid.Health > 0
				and token
					== state.safeMove.cancelToken
				and tick() < deadline do

				local delta =
					goal - root.Position

				if delta.Magnitude <= 1.5 then
					commandedPosition =
						goal

					BP.Position =
						goal

					return true
				end

				local now =
					tick()

				local dt =
					math.clamp(
						now
							- lastHeartbeatAt,
						1 / 120,
						1 / 20
					)

				lastHeartbeatAt =
					now

				local commandDelta =
					goal
						- commandedPosition

				if commandDelta.Magnitude > 0.05 then
					local commandSpeed =
						math.clamp(
							commandDelta.Magnitude
								* 1.8,
							12,
							bridgeSpeed
						)

					local step =
						math.min(
							commandDelta.Magnitude,
							commandSpeed * dt
						)

					commandedPosition =
						commandedPosition
						+ commandDelta.Unit
							* step
				else
					commandedPosition =
						goal
				end

				BP.Position =
					commandedPosition

				local flat =
					Vector3.new(
						goal.X
							- root.Position.X,
						0,
						goal.Z
							- root.Position.Z
					)

				if flat.Magnitude > 0.25 then
					BG.CFrame =
						CFrame.lookAt(
							root.Position,
							root.Position
								+ flat.Unit,
							Vector3.yAxis
						)
				end

				-- Kill swimming/downward momentum. BodyPosition owns Y as well
				-- as X/Z, so Hippo cannot sag below the water plane.
				root.AssemblyLinearVelocity =
					root.AssemblyLinearVelocity
						* 0.15

				root.AssemblyAngularVelocity =
					Vector3.zero

				runtimeMessage =
					CROC.isCharacter(
						character
					)
						and "Croc MoveTo: position-control above water"
						or "Hippo MoveTo: position-control above water"

				RunService.Heartbeat:Wait()
			end

			return false
		end

		local liftDistance =
			(liftTarget - root.Position).Magnitude

		local lifted =
			bridgeFlyTo(
				liftTarget,
				math.clamp(
					liftDistance
						/ bridgeSpeed
						+ 1.5,
					1.5,
					5
				)
			)

		local crossed =
			false

		if lifted then
			local crossDistance =
				(exitTarget - root.Position).Magnitude

			crossed =
				bridgeFlyTo(
					exitTarget,
					math.clamp(
						crossDistance
							/ bridgeSpeed
							+ 2.0,
						2.0,
						12
					)
				)
		end

		pcall(function()
			if BP and BP.Parent then
				BP:Destroy()
			end
		end)

		pcall(function()
			if BG and BG.Parent then
				BG:Destroy()
			end
		end)

		if root and root.Parent then
			root.AssemblyLinearVelocity =
				Vector3.zero

			root.AssemblyAngularVelocity =
				Vector3.zero
		end

		pcall(function()
			humanoid.PlatformStand = false
			humanoid.AutoRotate =
				oldAutoRotate ~= false

			humanoid:ChangeState(
				Enum.HumanoidStateType.GettingUp
			)
		end)

		if oldMovementDisabled == nil then
			character:SetAttribute(
				"MovementDisabled",
				false
			)
		else
			character:SetAttribute(
				"MovementDisabled",
				oldMovementDisabled
			)
		end

		if state.isCrocOrHippoMovementCharacter(
			character
		)
			and waterPart
			and waterPart.Parent then

			waterPart.CanCollide =
				true
		end

		if crossed then
			runtimeMessage =
				CROC.isCharacter(
					character
				)
					and "Croc MoveTo: crossed water above surface"
					or "Hippo MoveTo: crossed water above surface"
		end

		return crossed
	end

	local function terrainHeightAt(worldPosition, referenceY)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { workspace.Terrain }
		params.IgnoreWater = false

		local castTop = math.max(
			referenceY + 320,
			worldPosition.Y + 320
		)

		local hit = workspace:Raycast(
			Vector3.new(
				worldPosition.X,
				castTop,
				worldPosition.Z
			),
			Vector3.new(0, -700, 0),
			params
		)

		if not hit or hit.Material == Enum.Material.Water then
			return nil
		end

		return hit.Position.Y
	end

	local function chooseHillAvoidSide(rootPosition, forward, currentGroundY)
		local hill =
			state.safeMove.hill

		-- If the currently committed side is still making recent progress,
		-- KEEP IT. Do not reevaluate every couple seconds and oscillate.
		if hill
			and hill.sign
			and tick() - (hill.progressAt or 0) < 2.6 then

			return hill.sign
		end

		local function rotateHeading(sign, degrees)
			local angle =
				math.rad(degrees * sign)

			local c = math.cos(angle)
			local s = math.sin(angle)

			return Vector3.new(
				forward.X * c - forward.Z * s,
				0,
				forward.X * s + forward.Z * c
			).Unit
		end

		local function sideScore(sign)
			local heading =
				rotateHeading(sign, 58)

			local score = 0
			local lastY = currentGroundY
			local maxRise = 0

			-- Look down the actual escape corridor, not just one shoulder point.
			for _, distance in ipairs({
				14,
				24,
				38,
				54,
				72,
				92,
			}) do
				local point =
					rootPosition
					+ heading * distance

				local y =
					terrainHeightAt(
						point,
						rootPosition.Y
					)

				if y then
					local rise =
						y - currentGroundY

					local stepRise =
						y - lastY

					maxRise =
						math.max(
							maxRise,
							rise
						)

					-- Rising Terrain is increasingly expensive.
					if rise > 0 then
						score += rise * 1.15
					end

					if rise > 18 then
						score +=
							(rise - 18) * 3.2
					end

					if rise > 32 then
						score +=
							(rise - 32) * 4.5
					end

					-- A sudden wall between samples is a very bad corridor.
					if stepRise > 9 then
						score +=
							stepRise * 3.0
					end

					-- Avoid selecting a huge cliff/drop as the "easy" side.
					if rise < -38 then
						score += 70
					end

					lastY = y
				else
					-- Missing/non-solid Terrain is uncertain, so don't treat it
					-- as a magically perfect path.
					score += 18
				end
			end

			-- Also inspect a wider shoulder that represents actually going
			-- AROUND the mountain rather than merely touching its edge.
			local sideVector =
				Vector3.new(
					-forward.Z,
					0,
					forward.X
				) * sign

			for _, probe in ipairs({
				{ 28, 36 },
				{ 48, 58 },
				{ 64, 78 },
			}) do
				local point =
					rootPosition
					+ forward * probe[1]
					+ sideVector * probe[2]

				local y =
					terrainHeightAt(
						point,
						rootPosition.Y
					)

				if y then
					local rise =
						y - currentGroundY

					if rise > 15 then
						score +=
							(rise - 15) * 2.4
					end
				else
					score += 12
				end
			end

			-- Physical wall/tree/rock check in the selected escape heading.
			local params = RaycastParams.new()
			params.FilterType =
				Enum.RaycastFilterType.Exclude

			params.FilterDescendantsInstances =
				state.movementObstacleIgnoreList(character, false)

			params.IgnoreWater = true

			local obstacle =
				workspace:Raycast(
					rootPosition
						+ Vector3.new(
							0,
							2.5,
							0
						),
					heading * 32,
					params
				)

			if obstacle
				and state.movementIsDinoWaterMossVisual(obstacle.Instance) then
				obstacle = nil
			end

			if obstacle
				and math.abs(
					obstacle.Normal.Y
				) < 0.72 then

				score +=
					obstacle.Instance
						== workspace.Terrain
						and 130
						or 65
			end

			-- Remember a side that ALREADY FAILED near this same mountain.
			local failedUntil =
				sign < 0
					and (
						state.safeMove.hillFailureLeftUntil
						or 0
					)
					or (
						state.safeMove.hillFailureRightUntil
						or 0
					)

			local failedPosition =
				sign < 0
					and state.safeMove.hillFailureLeftPosition
					or state.safeMove.hillFailureRightPosition

			if tick() < failedUntil
				and typeof(failedPosition)
					== "Vector3"
				and (
					failedPosition
					- rootPosition
				).Magnitude <= 95 then

				score += 500
			end

			return score, maxRise
		end

		local leftScore =
			sideScore(-1)

		local rightScore =
			sideScore(1)

		if hill then
			hill.leftScore = leftScore
			hill.rightScore = rightScore
		end

		local preferred =
			hill
				and hill.sign
				or hillAvoidSign

		-- Hysteresis: if scores are close, keep the previous side.
		if preferred
			and math.abs(
				leftScore - rightScore
			) < 26 then

			return preferred
		end

		return leftScore < rightScore
			and -1
			or 1
	end

	local function rotateStuckHeading(
		forward,
		degrees
	)
		local angle =
			math.rad(
				degrees
			)

		local c =
			math.cos(
				angle
			)

		local s =
			math.sin(
				angle
			)

		return Vector3.new(
			forward.X * c
				- forward.Z * s,
			0,
			forward.X * s
				+ forward.Z * c
		).Unit
	end

	local function stuckCorridorScore(
		origin,
		direction,
		distance
	)
		if typeof(origin) ~= "Vector3"
			or typeof(direction) ~= "Vector3"
			or direction.Magnitude <= 0.05 then

			return -math.huge
		end

		direction =
			Vector3.new(
				direction.X,
				0,
				direction.Z
			)

		if direction.Magnitude <= 0.05 then
			return -math.huge
		end

		direction =
			direction.Unit

		local right =
			Vector3.new(
				-direction.Z,
				0,
				direction.X
			)

		local halfWidth =
			math.clamp(
				state.movementFootprint(
					character
				) * 0.62,
				3,
				12
			)

		local params =
			RaycastParams.new()

		params.FilterType =
			Enum.RaycastFilterType.Exclude

		params.FilterDescendantsInstances =
			state.movementObstacleIgnoreList(character, true)

		params.IgnoreWater =
			true

		pcall(function()
			params.RespectCanCollide =
				true
		end)

		local nearest =
			distance

		local blocked =
			0

		local probeHeight =
			math.clamp(
				state.movementProbeHeight(
					character
				),
				2.2,
				6
			)

		-- This richer scan runs ONLY after a confirmed stall, not every frame.
		for _, lateral in ipairs({
			-halfWidth,
			0,
			halfWidth,
		}) do
			for _, heightScale in ipairs({
				0.55,
				1.25,
			}) do
				local hit =
					workspace:Raycast(
						origin
							+ right * lateral
							+ Vector3.new(
								0,
								probeHeight
									* heightScale,
								0
							),
						direction
							* distance,
						params
					)

				if hit
					and not state.movementIsDinoWaterMossVisual(hit.Instance) then
					blocked += 1

					nearest =
						math.min(
							nearest,
							hit.Distance
						)
				end
			end
		end

		local endpoint =
			origin
				+ direction
					* distance

		if purpose ~= "water"
			and not allowIntentionalWaterTransit then
			local waterAtEnd =
				exposedTerrainWaterAt(
					endpoint
				)

			if waterAtEnd then
				return -10000
			end
		end

		local currentGround =
			terrainHeightAt(
				origin,
				origin.Y
			)

		local endGround =
			terrainHeightAt(
				endpoint,
				origin.Y
			)

		if not endGround then
			return -5000
		end

		local terrainPenalty =
			0

		if currentGround then
			local deltaY =
				endGround
					- currentGround

			if deltaY > 18 then
				terrainPenalty +=
					(deltaY - 18)
						* 5
			elseif deltaY < -32 then
				terrainPenalty +=
					math.abs(
						deltaY + 32
					) * 4
			end
		end

		return nearest
			- blocked * 9
			- terrainPenalty
	end

	local function moveStuckSegment(
		goal,
		maximumSpeed,
		moveToMotor,
		timeout
	)
		if typeof(goal) ~= "Vector3" then
			return false
		end

		local startPosition =
			root.Position

		local deadline =
			tick()
				+ (
					tonumber(timeout)
						or 2
				)

		local escapeSpeed =
			math.clamp(
				maximumSpeed * 0.72,
				10,
				math.max(
					10,
					maximumSpeed
				)
			)

		while state.alive
			and character.Parent
			and root.Parent
			and humanoid.Parent
			and humanoid.Health > 0
			and token
				== state.safeMove.cancelToken
			and tick() < deadline do

			if state.questGrowthReset.exclusive
				or criticalRecoveryActive
				or DAMAGE.active then

				return false
			end

			local delta =
				Vector3.new(
					goal.X
						- root.Position.X,
					0,
					goal.Z
						- root.Position.Z
				)

			local remaining =
				delta.Magnitude

			if remaining
				<= math.max(
					3.5,
					state.movementFootprint(
						character
					) * 0.38
				) then

				return true
			end

			local direction =
				delta.Unit

			if moveToMotor then
				state.heavyWalkStep(
					character,
					root,
					humanoid,
					direction,
					escapeSpeed,
					remaining,
					goal,
					"safeMove",
					token
				)
			else
				pcall(
					humanoid.Move,
					humanoid,
					direction,
					false
				)

				local velocity =
					root.AssemblyLinearVelocity

				root.AssemblyLinearVelocity =
					Vector3.new(
						direction.X
							* escapeSpeed,
						velocity.Y,
						direction.Z
							* escapeSpeed
					)
			end

			setSubState(
				"Running"
			)

			RunService.Heartbeat:Wait()
		end

		local moved =
			Vector3.new(
				root.Position.X
					- startPosition.X,
				0,
				root.Position.Z
					- startPosition.Z
			).Magnitude

		return moved >= 4.5
	end

	local function runHardStuckEscape(
		forward,
		maximumSpeed,
		moveToMotor
	)
		if typeof(forward) ~= "Vector3"
			or forward.Magnitude <= 0.05 then

			return false
		end

		forward =
			Vector3.new(
				forward.X,
				0,
				forward.Z
			)

		if forward.Magnitude <= 0.05 then
			return false
		end

		forward =
			forward.Unit

		state.heavyWalkStop(
			character
		)

		if state.questSetW then
			pcall(
				state.questSetW,
				false
			)
		end

		local footprint =
			state.movementFootprint(
				character
			)

		local backDistance =
			math.clamp(
				footprint * 1.55
					+ 6,
				12,
				28
			)

		local sideDistance =
			math.clamp(
				footprint * 3.10
					+ 18,
				32,
				64
			)

		-- STEP 1: MOVE BACK. If straight reverse is blocked, pick a rear diagonal.
		local rearDirection
		local rearScore =
			-math.huge

		for _, degrees in ipairs({
			180,
			145,
			-145,
		}) do
			local candidate =
				rotateStuckHeading(
					forward,
					degrees
				)

			local score =
				stuckCorridorScore(
					root.Position,
					candidate,
					backDistance
				)

			if score > rearScore then
				rearScore =
					score

				rearDirection =
					candidate
			end
		end

		if not rearDirection
			or rearScore < -1000 then

			return false
		end

		runtimeMessage =
			"Stuck watchdog: backing out of object trap"

		local backed =
			moveStuckSegment(
				root.Position
					+ rearDirection
						* backDistance,
				maximumSpeed,
				moveToMotor,
				2.2
			)

		if not backed then
			return false
		end

		-- STEP 2: choose a MUCH wider side route around the object/cave.
		local sideDirection
		local sideScore =
			-math.huge

		local sideSign =
			obstacleSign

		for _, item in ipairs({
			{ -88, -1 },
			{ 88, 1 },
			{ -112, -1 },
			{ 112, 1 },
		}) do
			local candidate =
				rotateStuckHeading(
					forward,
					item[1]
				)

			local score =
				stuckCorridorScore(
					root.Position,
					candidate,
					sideDistance
				)

			if score > sideScore then
				sideScore =
					score

				sideDirection =
					candidate

				sideSign =
					item[2]
			end
		end

		if sideDirection
			and sideScore > -1000 then

			obstacleSign =
				sideSign

			runtimeMessage =
				sideSign < 0
					and "Stuck watchdog: wide LEFT detour"
					or "Stuck watchdog: wide RIGHT detour"

			moveStuckSegment(
				root.Position
					+ sideDirection
						* sideDistance,
				maximumSpeed,
				moveToMotor,
				3.4
			)
		end

		-- STEP 3: once offset, move forward again to actually clear the object.
		local rejoinDistance =
			math.clamp(
				sideDistance * 0.55,
				18,
				36
			)

		local rejoinScore =
			stuckCorridorScore(
				root.Position,
				forward,
				rejoinDistance
			)

		if rejoinScore > 5 then
			runtimeMessage =
				"Stuck watchdog: rejoining original route"

			moveStuckSegment(
				root.Position
					+ forward
						* rejoinDistance,
				maximumSpeed,
				moveToMotor,
				2.4
			)
		end

		return true
	end

	local function cleanup()
		if state.safeMove.workerToken ~= token then
			return
		end

		local manager = state.MMBAI and state.MMBAI.MovementManager
		local releasePhysical = not movementLeaseToken
			or not manager
			or not manager.lease
			or manager.lease.token == movementLeaseToken

		releasePhysical = releasePhysical
			and character == player.Character
			and character.Parent ~= nil

		if releasePhysical then
			state.heavyWalkStop(character)
			local liveRoot = character:FindFirstChild("HumanoidRootPart")
			local liveHumanoid = character:FindFirstChildOfClass("Humanoid")

			if liveHumanoid then
				pcall(liveHumanoid.Move, liveHumanoid, Vector3.zero, false)
			end

			if liveRoot then
				local velocity = liveRoot.AssemblyLinearVelocity
				liveRoot.AssemblyLinearVelocity = Vector3.new(
					0,
					velocity.Y,
					0
				)
				liveRoot.AssemblyAngularVelocity =
					liveRoot.AssemblyAngularVelocity * 0.2
			end

			state.releaseMovementNow(character, true)
		end

		state.safeMove.landQuestW = false
		state.safeMove.nativeW = false
		state.safeMove.active = false
		state.safeMove.target = nil
		state.safeMove.reason = nil
		state.safeMove.owner = nil
		state.safeMove.priority = 0
		state.safeMove.aiLeaseToken = nil
		state.safeMove.workerToken = nil
		state.safeMove.allowWaterTransit = false
		state.safeMove.waterTransitKind = nil
		state.safeMove.preferredObstacleSign = nil
		state.safeMove.manualLabel = nil
		state.busy = false
		lastSafeMoveAt = tick()

		if state.renderMoveToCancelButton then
			pcall(state.renderMoveToCancelButton)
		end
	end

	local callOk, result = pcall(function()
		local acceleration = state.safeMovementSpeed(character)
		local initialFlat = Vector3.new(
			position.X - root.Position.X,
			0,
			position.Z - root.Position.Z
		).Magnitude

		local maximumSpeed = math.max(
			4,
			acceleration * speedScale
		)

		if speedCap and speedCap > 0 then
			maximumSpeed = math.min(maximumSpeed, speedCap)
		end

		local maximumDuration =
			tonumber(options.maxDuration)
			or math.clamp(
				(initialFlat / math.max(maximumSpeed, 1)) * 3 + 24,
				20,
				420
			)

		local deadline = tick() + maximumDuration

		while state.alive
			and character.Parent
			and root.Parent
			and humanoid.Parent
			and humanoid.Health > 0
			and token == state.safeMove.cancelToken
			and tick() < deadline do

			-- v77: Acceleration can change after Swimming / landing.
			-- Re-read it continuously instead of keeping the initial value.
			local liveAcceleration =
				state.safeMovementSpeed(character)

			maximumSpeed = math.max(
				4,
				liveAcceleration * speedScale
			)

			if speedCap and speedCap > 0 then
				maximumSpeed =
					math.min(maximumSpeed, speedCap)
			end

			-- Water-exit routes finish the instant dry Terrain is confirmed.
			if stopOnDryGround
				and state.normalizeDryLandState
				and state.normalizeDryLandState(
					character,
					root
				) then
				return true
			end

			local food = tonumber(character:GetAttribute("Food")) or 100
			local water = tonumber(character:GetAttribute("Water")) or 100

			-- v96 optional continuous-route monitor.
			-- Used by carcass spawn search so it can scan while walking WITHOUT
			-- splitting the route into many SafeMove transactions.
			if state.safeMoveRunRouteCheck(
				options,
				character,
				root,
				humanoid,
				position
			) then
				return false
			end

			-- v84 HARD STOP:
			-- Keep the full v81 navigation UNTIL Savannah itself shows the
			-- real Drink prompt. At that exact frame, stop where we are.
			local waterGamePrompt =
				purpose == "water"
					and state.drinkGamePromptAvailable
					and state.drinkGamePromptAvailable(
						character
					)

			local waterVisualPrompt =
				purpose == "water"
					and state.drinkVisualPromptVisible
					and state.drinkVisualPromptVisible()

			if purpose == "water"
				and (
					waterGamePrompt
						or waterVisualPrompt
				) then

				if waterVisualPrompt then
					state.drinkLatchVisualPrompt()
				end

				state.drinkSearch.promptStopAt =
					root.Position

				state.drinkSearch.promptStopTime =
					tick()

				local velocity =
					root.AssemblyLinearVelocity

				root.AssemblyLinearVelocity =
					Vector3.new(
						0,
						velocity.Y,
						0
					)

				root.AssemblyAngularVelocity =
					Vector3.zero

				if state.questSetW then
					pcall(
						state.questSetW,
						false
					)
				end

				if faceTowards then
					local face = Vector3.new(
						faceTowards.X - root.Position.X,
						0,
						faceTowards.Z - root.Position.Z
					)

					if face.Magnitude > 0.25 then
						pcall(function()
							root.CFrame =
								CFrame.lookAt(
									root.Position,
									root.Position
										+ face.Unit,
									Vector3.yAxis
								)
						end)
					end
				end

				runtimeMessage =
					"Drink prompt visible; stopping at current edge"

				return true
			end

			-- Turning Auto Eat OFF cancels an already-running food route too.
			if purpose == "food"
				and not state.autoEat then
				runtimeMessage =
					"Auto Eat disabled; food movement cancelled"
				return false
			end

			-- Long walks yield to survival before the animal becomes unsafe.
			if purpose == "food"
				and state.waterShouldPreemptFood(character, 72) then
				runtimeMessage =
					"Movement paused: Water priority took control"
				return false
			elseif purpose == "quest"
				and (food <= 66 or water <= 72) then
				runtimeMessage =
					"Quest movement paused for Food/Water"
				return false
			elseif purpose == "manual"
				and (
					(state.autoDrink and water <= 62)
					or (state.autoEat and food <= 52)
				) then
				runtimeMessage =
					"Move To paused for survival"
				return false
			end

			if DAMAGE.active and purpose ~= "safety" then
				return false
			end

			if criticalRecoveryActive
				and purpose ~= "safety"
				and purpose ~= "water" then
				return false
			end

			local current = root.Position

			local flatDelta = Vector3.new(
				position.X - current.X,
				0,
				position.Z - current.Z
			)

			local flatDistance =
				flatDelta.Magnitude

			if purpose == "manual"
				and tick()
					- (
						state.safeMove.manualStatusAt
							or 0
					) >= 0.75 then

				state.safeMove.manualStatusAt =
					tick()

				runtimeMessage =
					string.format(
						"Move To WORLD: %s · %.0f studs · target %.0f, %.0f",
						tostring(
							state.safeMove.manualLabel
								or "location"
						),
						flatDistance,
						position.X,
						position.Z
					)
			end

			-- High-hill progress is NOT the same as "distance to destination".
			-- Going around a mountain may temporarily move sideways or even a
			-- little farther from the destination. Measure advancement along the
			-- committed escape heading too.
			if tick() < hillAvoidUntil
				and state.safeMove.hill
				and state.safeMove.hill.sign
				and state.safeMove.hill.anchor
				and state.safeMove.hill.escapeDirection then

				local escapeDelta =
					Vector3.new(
						current.X
							- state.safeMove.hill.anchor.X,
						0,
						current.Z
							- state.safeMove.hill.anchor.Z
					)

				local projection =
					escapeDelta:Dot(
						state.safeMove.hill.escapeDirection
					)

				local madeEscapeProgress =
					projection
						> (
							state.safeMove.hill.bestProjection
							or 0
						) + 2.25

				local madeTargetProgress =
					flatDistance
						< (
							state.safeMove.hill.bestTargetDistance
							or math.huge
						) - 2.5

				if madeEscapeProgress then
					state.safeMove.hill.bestProjection =
						projection
				end

				if madeTargetProgress then
					state.safeMove.hill.bestTargetDistance =
						flatDistance
				end

				if madeEscapeProgress
					or madeTargetProgress then

					state.safeMove.hill.progressAt =
						tick()

					-- Prevent generic stall logic from firing merely because
					-- we're moving laterally around the mountain.
					lastProgressAt = tick()
				end
			end

			local calmRiverApproach =
				riverApproach
				and purpose == "water"
				and flatDistance
					<= riverApproachRadius

			local animalKey =
				state.safeMovementAnimalKey(character)

			local flying =
				state.questFlyingAnimals
				and state.questFlyingAnimals[animalKey] == true

			local activeSwimApproach =
				swimApproach
				and flatDistance <= swimActivationDistance

			local verticalMovement =
				forceVertical or activeSwimApproach or flying

			-- Manual Move To and selected automatic routes use the same reliable
			-- WalkSpeed + Humanoid:MoveTo motor on EVERY terrestrial animal.
			-- forceMoveToLand is opt-in so unrelated food/water controllers keep
			-- their existing behavior. ZoneTime uses it to match Move To Locations.
			local moveToDrivenLand =
				not verticalMovement
					and (
						state.safeMove.heavy
							or purpose == "manual"
							or options.forceMoveToLand == true
					)

			-- Terrestrial TravelDistance forces W as a movement signal while
			-- the planner remains the world-space steering authority.
			local landQuestTap =
				state.autoQuests
					and state.questLandInputActive
					and not activeSwimApproach
					and not flying
					and purpose ~= "safety"
					and purpose ~= "spawn"
					and purpose ~= "manual"
					and not calmRiverApproach
					and flatDistance > math.max(tolerance * 2.5, 8)

			state.safeMove.landQuestW =
				landQuestTap == true

			state.safeMove.nativeW = false

			-- Held W is reserved for the separate Swimming path.
			if state.questSetW then
				state.questSetW(false)
			end

			if state.questSetLandPermanentW then
				state.questSetLandPermanentW(
					landQuestTap == true
				)
			end

			if landQuestTap then
				state.questMotionMoving = true
				state.questMotionMode = "Land"
			end

			local verticalGoal = position.Y

			if flying and not activeSwimApproach then
				verticalGoal = flatDistance > 30
					and math.max(position.Y + 18, current.Y)
					or position.Y + 5
			end

			local yError = verticalGoal - current.Y

			local reached =
				flatDistance <= tolerance
				and (
					not verticalMovement
					or math.abs(yError)
						<= (
							strictVerticalTolerance
								and math.max(
									0.5,
									strictVerticalTolerance
								)
								or math.max(
									tolerance,
									16
								)
						)
				)

			if reached then
				if faceTowards and root.Parent then
					local face = Vector3.new(
						faceTowards.X - root.Position.X,
						0,
						faceTowards.Z - root.Position.Z
					)

					if face.Magnitude > 0.5 then
						pcall(function()
							root.CFrame = CFrame.lookAt(
								root.Position,
								root.Position + face.Unit,
								Vector3.yAxis
							)
						end)
					end
				end

				return true
			end

			local progressDistance = verticalMovement
				and (position - current).Magnitude
				or flatDistance

			if progressDistance < lastDistance - 1.25 then
				local progressNow = tick()
				lastDistance = progressDistance
				lastProgressAt = progressNow
				state.safeMove.lastProgressAt = progressNow
				state.safeMove.lastDistance = progressDistance

				local manager = state.MMBAI and state.MMBAI.MovementManager
				local lease = manager and manager.lease
				if lease
					and lease.owner == state.safeMove.owner
					and (not movementLeaseToken or lease.token == movementLeaseToken) then
					lease.lastProgressAt = progressNow
					lease.lastPulseAt = progressNow
					lease.lastDistance = progressDistance
				end

				stallCount = math.max(
					0,
					stallCount - 1
				)

			elseif rawVerticalTransit then
				-- Terrain crossing must not trigger side-steering or Space.
				if tick() - lastProgressAt >= 3.5 then
					runtimeMessage =
						"Underground Drink vertical transit made no progress"
					return false
				end

			elseif calmRiverApproach then
				-- The river bank itself must never trigger oscillation or jump.
				if tick() - lastProgressAt >= 3.2 then
					runtimeMessage =
						"River bank approach blocked; trying another exposed bank"
					return false
				end

			elseif tick() - lastProgressAt >= 1.35 then
				if tick() < hillAvoidUntil
					and state.safeMove.hill
					and state.safeMove.hill.sign then

					local hill =
						state.safeMove.hill

					-- Do NOTHING while the committed side is still producing
					-- real escape progress. No left/right flipping, no Space.
					if tick()
						- (hill.progressAt or 0)
						>= 3.4 then

						local failedSign =
							hill.sign

						if failedSign < 0 then
							state.safeMove.hillFailureLeftUntil =
								tick() + 18

							state.safeMove.hillFailureLeftPosition =
								root.Position
						else
							state.safeMove.hillFailureRightUntil =
								tick() + 18

							state.safeMove.hillFailureRightPosition =
								root.Position
						end

						hill.switchCount =
							(hill.switchCount or 0) + 1

						if hill.switchCount >= 3 then
							runtimeMessage =
								"Hill route trapped: both sides failed; restarting route"

							return false
						end

						local forward =
							flatDistance > 0.1
								and flatDelta.Unit
								or Vector3.new(
									root.CFrame.LookVector.X,
									0,
									root.CFrame.LookVector.Z
								).Unit

						local currentGroundY =
							terrainHeightAt(
								root.Position,
								root.Position.Y
							)
							or root.Position.Y

						-- The failed side receives a huge temporary penalty,
						-- so chooser strongly prefers the other real corridor.
						hill.sign = nil

						hillAvoidSign =
							chooseHillAvoidSide(
								root.Position,
								forward,
								currentGroundY
							)

						hill.sign =
							hillAvoidSign

						obstacleSign =
							hillAvoidSign

						hillAvoidUntil =
							tick() + 6.5

						hill.startedAt =
							tick()

						hill.progressAt =
							tick()

						hill.anchor =
							root.Position

						local escapeAngle =
							math.rad(
								(
									62
									+ math.min(
										18,
										hill.switchCount * 8
									)
								)
								* hillAvoidSign
							)

						local c =
							math.cos(
								escapeAngle
							)

						local s =
							math.sin(
								escapeAngle
							)

						hill.escapeDirection =
							Vector3.new(
								forward.X * c
									- forward.Z * s,
								0,
								forward.X * s
									+ forward.Z * c
							).Unit

						hill.bestProjection = 0
						hill.bestTargetDistance =
							flatDistance

						stallCount = 0
						lastProgressAt = tick()

						runtimeMessage =
							"High hill: "
							.. (
								failedSign < 0
									and "LEFT"
									or "RIGHT"
							)
							.. " failed; committing "
							.. (
								hillAvoidSign < 0
									and "LEFT"
									or "RIGHT"
							)
					end
				else
					lastProgressAt = tick()
					stallCount += 1

					local prideRockStall =
						state.safeMove.prideRockEscapeDirection ~= nil
						and state.movementPrideRockNearby(
							root.Position,
							28
						)

					if prideRockStall then
						-- Keep the committed side. Re-scoring here was one of the
						-- causes of left/right oscillation around PrideRock.
						runtimeMessage =
							"Pride Rock: stalled; keeping committed bypass side"
					else
						obstacleSign *= -1
					end

					local persistentObjectTrap =
						prideRockStall
						or (
							lastBlockingInstance ~= nil
							and blockingSince > 0
							and tick()
								- blockingSince
								>= 1.0
						)

					local dinoWaterSearchWithoutRealObstacle =
						isDinoLife
						and purpose == "water_search"
						and not persistentObjectTrap

					local shouldHardEscape =
						not verticalMovement
						and not calmRiverApproach
						and not dinoWaterSearchWithoutRealObstacle
						and (
							stallCount >= 2
								or persistentObjectTrap
						)
						and tick()
							- lastHardStuckEscapeAt
							>= 3.8

					if dinoWaterSearchWithoutRealObstacle
						and stallCount >= 2 then
						-- Open-ground Dino search stall: restart the SAME forward movement
						-- transaction. Never invent a back/side obstacle escape when no
						-- obstacle was actually detected.
						pcall(state.heavyWalkStop, character)
						lastBlockingInstance = nil
						blockingSince = 0
						obstacleSign = 1
						stallCount = 0
						lastDistance = math.huge
						lastProgressAt = tick()
						runtimeMessage =
							"Dino water watchdog: restarting forward search movement"
						RunService.Heartbeat:Wait()
						continue
					end

					if shouldHardEscape then
						lastHardStuckEscapeAt =
							tick()

						hardStuckEscapeCount += 1

						if isDinoLife
							and purpose == "food"
							and state.dinoRockPressureMetrics
							and select(
								1,
								state.dinoRockPressureMetrics(
									character,
									root.Position
								)
							) then

							state.dinoRockEmergency.objectiveStalled =
								true

							state.dinoRockEmergency.foodRouteFailures =
								math.max(
									1,
									state.dinoRockEmergency.foodRouteFailures
										or 0
								)

							runtimeMessage =
								"DINO ROCK WATCHDOG: Food SafeMove stalled beside rocks -> Safety handoff"

							mmbTaskDefer(function()
								task.wait(0.02)

								state.startDinoRockTrapRecovery(
									"Food SafeMove hard-stalled under rock pressure",
									true
								)
							end)

							return false
						end

						local escapeForward

						if prideRockStall
							and state.safeMove.prideRockEscapeDirection
							and state.safeMove.prideRockEscapeDirection.Magnitude > 0.05 then

							escapeForward =
								state.safeMove.prideRockEscapeDirection.Unit
						else
							escapeForward =
								flatDistance > 0.1
									and flatDelta.Unit
									or Vector3.new(
										root.CFrame.LookVector.X,
										0,
										root.CFrame.LookVector.Z
									).Unit
						end

						-- Last resort only after the watchdog has independently reached this
						-- hard-stuck branch multiple times. Croc/Hippo get it after two
						-- verified failures because their rigs cannot jump out of pits; other
						-- grounded animals require three. Pride Rock keeps its dedicated bypass.
						if not prideRockStall
							and state.confirmedTrapShouldFly(
								character,
								root,
								hardStuckEscapeCount
							)
							and state.runConfirmedTrapFlyEscape({
								character = character,
								root = root,
								humanoid = humanoid,
								forward = escapeForward,
								routeMaximumSpeed = maximumSpeed,
								purpose = purpose,
								calmRiverApproach = calmRiverApproach,
								verticalMovement = verticalMovement,
								token = token,
								options = options,
								position = position,
							}) then

							stallCount = 0
							hardStuckEscapeCount = 0
							lastDistance = math.huge
							lastProgressAt = tick()
							lastBlockingInstance = nil
							blockingSince = 0
							hillAvoidUntil = 0
							if state.safeMove.hill then
								state.safeMove.hill.sign = nil
								state.safeMove.hill.escapeDirection = nil
								state.safeMove.hill.switchCount = 0
							end
							RunService.Heartbeat:Wait()
							continue
						end

						if state.safeMove.routeInterruptReason then
							return false
						end

						local escaped =
							runHardStuckEscape(
								escapeForward,
								maximumSpeed,
								moveToDrivenLand
							)

						if escaped then
							stallCount =
								0

							lastDistance =
								math.huge

							lastProgressAt =
								tick()

							lastBlockingInstance =
								nil

							blockingSince =
								0

							if prideRockStall then
								state.prideRockObstacleCache.escapeAt = 0
								state.prideRockObstacleCache.commitDirection = nil
								state.prideRockObstacleCache.commitSign = nil
								state.prideRockObstacleCache.commitUntil = 0
								state.safeMove.prideRockEscapeDirection = nil
							end

							runtimeMessage =
								prideRockStall
									and "Pride Rock: wide exit completed; route resumed"
									or "Stuck watchdog: object trap escaped; route resumed"

							RunService.Heartbeat:Wait()
							continue
						end
					end

					-- PrideRock specifically never jumps into its own cave meshes.
					if not prideRockStall
						and not moveToDrivenLand
						and not state.safeMove.heavy
						and tick() - lastJumpAt >= 1.6 then
						lastJumpAt = tick()
						state.virtualJump(character, humanoid, "safe_move_stall", 1.5)
					end

					local effectiveStallBudget =
						prideRockStall
							and stallBudget * 3
							or stallBudget

					local effectiveEscapeLimit =
						prideRockStall
							and 5
							or 3

					if stallCount >= effectiveStallBudget
						or hardStuckEscapeCount >= effectiveEscapeLimit then

						runtimeMessage =
							prideRockStall
								and "Pride Rock exit still blocked; route will retry from a new plan"
								or "Movement blocked after wide escape attempts; route will retry later"

						return false
					end
				end
			end

			state.safeMove.lastDistance = progressDistance
			state.safeMove.lastProgressAt = lastProgressAt

			local desired

			if verticalMovement then
				local three = Vector3.new(
					flatDelta.X,
					yError,
					flatDelta.Z
				)

				if three.Magnitude > 0.1 then
					desired = three.Unit
				end
			elseif flatDistance > 0.1 then
				desired = flatDelta.Unit
			end

			if not desired then
				RunService.Heartbeat:Wait()
				continue
			end

			-- Land animals avoid entering water while travelling across the map.
			-- Water routes are allowed to approach the shoreline only near the
			-- selected drinking destination. Aquatic animals are not restricted.
			if not allowIntentionalWaterTransit
				and not calmRiverApproach
				and not (
					purpose == "water"
						and riverApproach
				)
				and not verticalMovement
				and flatDistance > tolerance * 1.5
				and (
					not isAquaticCharacter(
						character
					)
					or aquaticBankClimber
				) then

				local aheadDistance =
					math.clamp(
						maximumSpeed * 0.28,
						10,
						34
					)

				local ahead =
					root.Position
					+ desired
						* aheadDistance

				local waterAhead = false

				if aquaticBankClimber then
					-- IMPORTANT: MainWaterPart is enormous and exists underneath
					-- dry Terrain. Its X/Z footprint is NOT a valid "water ahead"
					-- test. Only visible/exposed Terrain Water may alter a land route.
					waterAhead =
						exposedTerrainWaterAt(
							ahead
						)
				else
					local terrainProbe =
						RaycastParams.new()

					terrainProbe.FilterType =
						Enum.RaycastFilterType.Include

					terrainProbe.FilterDescendantsInstances = {
						workspace.Terrain,
					}

					terrainProbe.IgnoreWater = false

					local groundAhead =
						workspace:Raycast(
							ahead
								+ Vector3.new(
									0,
									90,
									0
								),
							Vector3.new(
								0,
								-180,
								0
							),
							terrainProbe
						)

					waterAhead =
						groundAhead
						and groundAhead.Material
							== Enum.Material.Water
				end

				local mayApproachWater =
					purpose == "water"
					and flatDistance <= 48

				if waterAhead and not mayApproachWater then
					if aquaticBankClimber
						and not waterBridgeDone then

						local bridge =
							exposedWaterBridgeAhead(
								root.Position,
								position
							)

						if bridge then
							local crossed =
								runMainWaterElevatedBridge(
									bridge,
									maximumSpeed
								)

							if crossed then
								waterBridgeDone = true
								lastProgressAt = tick()
								lastDistance = math.huge

								-- Recalculate the world-space target vector next
								-- frame from the new position on the far bank.
								RunService.Heartbeat:Wait()
								continue
							end
						end
					end

					-- No confirmed far bank: steer around the actually exposed
					-- water. This branch can no longer fire just because an
					-- underground MainWaterPart exists under dry land.
					local angle =
						math.rad(
							68 * obstacleSign
						)

					local c =
						math.cos(
							angle
						)

					local s =
						math.sin(
							angle
						)

					desired =
						Vector3.new(
							desired.X * c
								- desired.Z * s,
							0,
							desired.X * s
								+ desired.Z * c
						).Unit
				end
			end

			-- ------------------------------------------------------------
			-- HIGH HILL / MOUNTAIN AVOIDANCE
			-- Regular slopes are allowed. We only divert when the terrain
			-- directly ahead rises sharply into a high peak, which is where the
			-- old straight-line Swim route tended to get stuck climbing.
			-- ------------------------------------------------------------
			if not (
				isDinoLife
				and purpose == "water"
			)
				and not calmRiverApproach
				and not verticalMovement
				and not (
					aquaticBankClimber
					and purpose == "safety"
				)
				and flatDistance
					> math.max(
						tolerance * 2,
						28
					) then

				if tick() >= hillAvoidUntil
					and tick() - lastHillCheckAt >= 0.28 then

					lastHillCheckAt = tick()

					local currentGroundY =
						terrainHeightAt(root.Position, root.Position.Y)
						or root.Position.Y

					local peakRise = 0
					local peakSlope = 0

					for _, sampleDistance in ipairs({ 18, 30, 46, 64, 82 }) do
						local samplePoint =
							root.Position + desired * sampleDistance

						local sampleY =
							terrainHeightAt(
								samplePoint,
								root.Position.Y
							)

						if sampleY then
							local rise =
								sampleY - currentGroundY

							if rise > peakRise then
								peakRise = rise
							end

							local slope =
								rise / math.max(sampleDistance, 1)

							if slope > peakSlope then
								peakSlope = slope
							end
						end
					end

					-- Intentionally conservative: do not dodge ordinary hills.
					-- Trigger only on a tall rise plus a steep approach.
					-- Food routes are allowed to climb substantial grassy slopes.
					-- Only a genuinely mountain-like wall should divert them.
					local foodRoute = purpose == "food"

					local highPeak
					local extremePeak

					if aquaticBankClimber then
						-- Croc/Hippo routinely climb steep river banks. The normal
						-- high-hill thresholds mistake a beach/ramp for a mountain
						-- and send them sideways along the shore. Only divert these
						-- two animals for a genuinely large terrain wall.
						highPeak =
							peakRise >= 46
							and peakSlope >= 0.68

						extremePeak =
							peakRise >= 62
					else
						highPeak = foodRoute
							and (
								peakRise >= 48
								and peakSlope >= 0.66
							)
							or (
								not foodRoute
								and peakRise >= 28
								and peakSlope >= 0.48
							)

						extremePeak = foodRoute
							and peakRise >= 66
							or (
								not foodRoute
								and peakRise >= 42
							)
					end

					if highPeak or extremePeak then
						hillAvoidSign =
							chooseHillAvoidSide(
								root.Position,
								desired,
								currentGroundY
							)

						-- Synchronize generic obstacle steering with the committed
						-- mountain side instead of letting two controllers fight.
						obstacleSign =
							hillAvoidSign

						hillAvoidUntil =
							tick() + 6.0

						local hill =
							state.safeMove.hill

						hill.sign =
							hillAvoidSign

						hill.startedAt =
							tick()

						hill.progressAt =
							tick()

						hill.anchor =
							root.Position

						hill.bestProjection = 0
						hill.bestTargetDistance =
							flatDistance

						local escapeAngle =
							math.rad(
								(
									62
									+ math.min(
										18,
										(hill.switchCount or 0) * 8
									)
								)
								* hillAvoidSign
							)

						local c =
							math.cos(
								escapeAngle
							)

						local s =
							math.sin(
								escapeAngle
							)

						hill.escapeDirection =
							Vector3.new(
								desired.X * c
									- desired.Z * s,
								0,
								desired.X * s
									+ desired.Z * c
							).Unit

						runtimeMessage =
							string.format(
								"High hill: committing %s (L %.0f / R %.0f, rise +%.0f)",
								hillAvoidSign < 0
									and "LEFT"
									or "RIGHT",
								tonumber(hill.leftScore)
									or -1,
								tonumber(hill.rightScore)
									or -1,
								peakRise
							)
					end
				end

				if tick() < hillAvoidUntil then
					local hillAngle =
						math.rad(
							(
								62
								+ math.min(
									18,
									(
										state.safeMove.hill
										and state.safeMove.hill.switchCount
										or 0
									) * 8
								)
							)
							* hillAvoidSign
						)

					local c = math.cos(hillAngle)
					local s = math.sin(hillAngle)

					desired = Vector3.new(
						desired.X * c - desired.Z * s,
						0,
						desired.X * s + desired.Z * c
					).Unit
				end
			end

			local terrainClimbAssist = 0

			-- Physical obstacle avoidance. It changes direction, never position.
			-- Terrain slopes are NOT treated like trees/rocks. Normal hills are
			-- climbed directly; only the high-hill detector above diverts them.
			if not verticalMovement
				and flatDistance > tolerance * 1.5
				and not (
					suspendObstacleAvoidanceNearTarget
						and obstacleSuspendDistance > 0
						and flatDistance <= obstacleSuspendDistance
				) then

				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				params.FilterDescendantsInstances =
					typeof(options.ignoreObstacleInstance) == "Instance"
						and { character, options.ignoreObstacleInstance }
						or { character }
				params.IgnoreWater = true

				local probeDistance =
					math.clamp(
						maximumSpeed * 0.28,
						9,
						28
					)

				-- PrideRock avoidance is universal. Slot staging, Elephant, quests,
				-- Growth and every other land route use the exact same rock envelope.
				local volumeObjectProbe =
					moveToDrivenLand
					or state.movementPrideRockNearby(
						root.Position,
						36
					)

				local obstacle

				if isDinoLife
					and (
						purpose == "water"
							or purpose == "water_search"
					)
					and volumeObjectProbe then

					local now = tick()
					local sameHeading =
						dinoWaterObstacleDirection
							and dinoWaterObstacleDirection:Dot(desired) >= 0.94

					if sameHeading
						and now - dinoWaterObstacleAt <= 0.32 then
						obstacle = dinoWaterObstacleResult
					else
						obstacle = state.dinoWaterLightObstacleProbe(
							character,
							root,
							desired,
							math.max(probeDistance, 22),
							options.ignoreObstacleInstance
						)
						dinoWaterObstacleAt = now
						dinoWaterObstacleDirection = desired
						dinoWaterObstacleResult = obstacle
					end
				else
					obstacle =
						volumeObjectProbe
							and state.heavyObstacleProbe(
								character,
								root,
								desired,
								math.max(
									probeDistance,
									math.clamp(
										maximumSpeed * 0.62
											+ state.movementFootprint(
												character
											) * 1.20,
										22,
										72
									)
								),
								options.ignoreObstacleInstance
							)
							or state.movementRaycastIgnoringCarcasses(
								root.Position
									+ Vector3.new(
										0,
										state.safeMove.probeHeight
											or 2.5,
										0
									),
								desired * probeDistance,
								params
							)
				end

				if volumeObjectProbe
					and state.safeMove.heavyObstacleSign then
					obstacleSign =
						state.safeMove.heavyObstacleSign
				end

				if obstacle
					and (
						volumeObjectProbe
							or math.abs(
								obstacle.Normal.Y
							) < 0.72
					) then

					if obstacle.Instance ~= lastBlockingInstance then
						lastBlockingInstance = obstacle.Instance
						blockingSince = tick()
					elseif blockingSince <= 0 then
						blockingSince = tick()
					end

					local terrainHit =
						obstacle.Instance == workspace.Terrain

					local prideRockHit =
						state.movementIsPrideRockInstance(
							obstacle.Instance
						)

					if terrainHit
						and calmRiverApproach then

						-- River Terrain lip is destination geometry, not an obstacle.
						lastBlockingInstance = nil
						blockingSince = 0

					elseif terrainHit
						and tick() < hillAvoidUntil then

						-- High-hill controller already owns this Terrain.
						-- DO NOT reinterpret the mountain as a tree/rock,
						-- DO NOT apply obstacleSign again, and DO NOT jump.
						lastBlockingInstance = nil
						blockingSince = 0

					elseif terrainHit
						and tick()
							>= hillAvoidUntil then

						local currentGroundY =
							terrainHeightAt(
								root.Position,
								root.Position.Y
							)
							or root.Position.Y

						local aheadGroundY =
							terrainHeightAt(
								root.Position
									+ desired
										* math.min(
											probeDistance,
											12
										),
								root.Position.Y
							)

						local rise =
							aheadGroundY
								and (
									aheadGroundY
									- currentGroundY
								)
								or 0

						if rise > 1 and rise < 28 and not state.safeMove.heavy then
							local assistScale =
								purpose == "food"
									and 0.55
									or 0.35

							local assistCap =
								purpose == "food"
									and math.min(
										maximumSpeed * 0.45,
										16
									)
									or math.min(
										maximumSpeed * 0.30,
										11
									)

							terrainClimbAssist =
								math.min(
									assistCap,
									math.max(
										4,
										rise
											* assistScale
									)
								)
						end

						if not moveToDrivenLand
							and tick() - blockingSince >= 0.45
							and tick() - lastJumpAt >= 0.9 then

							lastJumpAt = tick()

							state.virtualJump(
								character,
								humanoid,
								"terrain_slope",
								0.85
							)
						end

					else
						-- PrideRock is a cave-like multi-mesh obstacle. When it is hit,
						-- use the wide model-level opening scan instead of a small 48° bend.
						local prideEscape =
							prideRockHit
							and state.safeMove.prideRockEscapeDirection

						if prideEscape
							and prideEscape.Magnitude > 0.05 then
							desired = prideEscape.Unit
							runtimeMessage =
								isDinoLife
									and (
										state.safeMove.dinoBasinBypassActive
											and "Dino restricted basin: going around rock pit"
											or "Dino Rocks: following individual rock bypass"
									)
									or "Pride Rock: following committed circular bypass"
						else
							-- Ordinary tree/rock/building steering.
							local angle =
								math.rad(
									48
									* obstacleSign
								)

							local c = math.cos(angle)
							local s = math.sin(angle)

							desired =
								Vector3.new(
									desired.X * c
										- desired.Z * s,
									0,
									desired.X * s
										+ desired.Z * c
								).Unit
						end

						if not prideRockHit
							and not moveToDrivenLand
							and not calmRiverApproach
							and tick() >= hillAvoidUntil
							and (
								tick() - blockingSince
									>= 0.70
								or stallCount > 0
							)
							and tick() - lastJumpAt
								>= 0.9 then

							lastJumpAt = tick()

							state.virtualJump(
								character,
								humanoid,
								"object_after_avoid",
								0.85
							)
						end
					end
				else
					lastBlockingInstance = nil
					blockingSince = 0
				end
			end

			if stallCount > 0
				and not state.safeMove.prideRockEscapeDirection
				and not calmRiverApproach
				and not verticalMovement
				and not (
					suspendObstacleAvoidanceNearTarget
						and obstacleSuspendDistance > 0
						and flatDistance <= obstacleSuspendDistance
				)
				and tick() >= hillAvoidUntil then
				local angle =
					math.rad(
						math.min(65, 24 + stallCount * 8)
						* obstacleSign
					)

				local c = math.cos(angle)
				local s = math.sin(angle)

				desired = Vector3.new(
					desired.X * c - desired.Z * s,
					0,
					desired.X * s + desired.Z * c
				).Unit
			end

			if rawVerticalTransit then
				pcall(function()
					humanoid.PlatformStand = true
					humanoid.AutoRotate = false
					humanoid:ChangeState(
						Enum.HumanoidStateType.Physics
					)
				end)

				character:SetAttribute(
					"MovementDisabled",
					true
				)

				root.AssemblyAngularVelocity =
					Vector3.zero
			end

			if not moveToDrivenLand then
				pcall(function()
					local face =
						Vector3.new(
							desired.X,
							0,
							desired.Z
						)

					if face.Magnitude > 0.1 then
						root.CFrame =
							CFrame.lookAt(
								root.Position,
								root.Position
									+ face.Unit,
								Vector3.yAxis
							)
					end
				end)
			end

			if landQuestTap
				and state.questLandPermanentWSetSteer then

				state.questLandPermanentWSetSteer(
					character,
					desired,
					position
				)
			end

			if not rawVerticalTransit then
				pcall(
					humanoid.Move,
					humanoid,
					moveToDrivenLand
						and Vector3.zero
						or Vector3.new(
							desired.X,
							0,
							desired.Z
						),
					false
				)
			else
				pcall(
					humanoid.Move,
					humanoid,
					Vector3.zero,
					false
				)
			end

			if activeSwimApproach then
				setSubState("Swimming")
			elseif flying then
				setSubState("Flying")
			elseif state.safeMove.heavy and flatDistance <= math.max(tolerance * 3, 24) then
				setSubState("Walking")
			else
				setSubState("Running")
			end

			-- Normal routes slow down near the target for precise positioning.
			-- Some interactions (notably grass eating) work better if the animal
			-- keeps its normal Acceleration speed until it reaches the target.
			local remainingScale = constantSpeed
				and 1
				or math.clamp(progressDistance / 24, 0.18, 1)

			local speed = math.min(
				maximumSpeed,
				math.max(4, maximumSpeed * remainingScale)
			)

			local velocity = root.AssemblyLinearVelocity

			if verticalMovement then
				root.AssemblyLinearVelocity = Vector3.new(
					desired.X * speed,
					math.clamp(desired.Y * speed, -maximumSpeed, maximumSpeed),
					desired.Z * speed
				)
			elseif moveToDrivenLand then
				-- v127 manual Move To and heavy land routes use the same reliable
				-- WalkSpeed + Humanoid:MoveTo execution engine.
				local moveOwner =
					purpose == "manual"
						and "manual"
						or "safeMove"

				local walked =
					state.heavyWalkStep(
						character,
						root,
						humanoid,
						desired,
						speed,
						progressDistance,
						position,
						moveOwner,
						token
					)

				if not walked then
					pcall(
						humanoid.MoveTo,
						humanoid,
						root.Position
					)
				end
			else
				root.AssemblyLinearVelocity = Vector3.new(
					desired.X * speed,
					terrainClimbAssist > 0 and math.max(velocity.Y, terrainClimbAssist) or velocity.Y,
					desired.Z * speed
				)
			end

			character:SetAttribute(
				"MovementDisabled",
				rawVerticalTransit
			)

			RunService.Heartbeat:Wait()
		end

		return false
	end)

	local cancelledByUser =
		purpose == "manual"
		and token ~= state.safeMove.cancelToken
		and state.safeMove.manualCancelledAt > 0
		and tick() - state.safeMove.manualCancelledAt <= 2

	cleanup()

	if movementLeaseToken
		and state.MMBAI
		and state.MMBAI.MovementManager then

		local completionReason =
			not callOk
				and tostring(result)
				or (
					token ~= state.safeMove.cancelToken
						and "cancelled or preempted"
						or (
							result == true
								and "target verified"
								or "route returned false"
						)
				)

		state.MMBAI.MovementManager:Complete(
			movementLeaseToken,
			callOk and result == true,
			completionReason
		)
	end

	if cancelledByUser then
		runtimeMessage = "Move To cancelled"
		return false
	end

	if not callOk then
		runtimeMessage =
			"Movement controller error: "
			.. tostring(result)
		return false
	end

	return result == true
end

-- Folga vertical baseada no tamanho do animal para evitar colocar o pivot
-- dentro da superfície da água.

-- Dedicated adapter: Surface Drink uses the proven 2.4a movement engine.
-- Underground/protected routes keep the current engine. This intentionally
-- does NOT modify the shared safeMoveToPosition used by Auto Run.
function state.surfaceDrinkRouteMove(position, maxAttempts, faceTowards, options)
	-- Exact 2.4a movement engine. The shared SafeMove later gained Food/Water
	-- MoveTo behavior; exposed drinking deliberately keeps the older proven route.
	return state.surfaceDrinkLegacySafeMoveToPosition(
		position,
		maxAttempts,
		faceTowards,
		options or {}
	)
end

local function surfaceStandOffset(character)
	local ok, extents = pcall(function() return character:GetExtentsSize() end)
	if ok and extents then
		return math.clamp(extents.Y / 2, 3, 10)
	end
	return 4
end

local terrainParams = RaycastParams.new()
terrainParams.FilterType = Enum.RaycastFilterType.Include
terrainParams.FilterDescendantsInstances = { workspace.Terrain }
terrainParams.IgnoreWater = false
local failedGrassAreas = {}

local function rememberFailedGrass(position)
	if not position then return end
	for _, area in ipairs(failedGrassAreas) do
		if (area.position - position).Magnitude <= 50 then
			area.expiresAt = tick() + 300
			return
		end
	end
	table.insert(failedGrassAreas, { position = position, expiresAt = tick() + 300 })
end

local function grassAreaRecentlyFailed(position)
	local now = tick()
	for index = #failedGrassAreas, 1, -1 do
		local area = failedGrassAreas[index]
		if now >= area.expiresAt then
			table.remove(failedGrassAreas, index)
		elseif (area.position - position).Magnitude <= 50 then
			return true
		end
	end
	return false
end

local function findMaterial(origin, material, maximumRadius)
	for radius = 8, maximumRadius, 8 do
		for index = 0, 15 do
			local angle = index / 16 * math.pi * 2
			local probe = origin + Vector3.new(math.cos(angle) * radius, 90, math.sin(angle) * radius)
			local hit = workspace:Raycast(probe, Vector3.new(0, -190, 0), terrainParams)
			if hit and hit.Material == material then return hit.Position end
		end
	end
end

function state.drinkForgetExpiredFailures()
	local now = tick()
	for index = #state.drinkSearch.failedAreas, 1, -1 do
		if now >= state.drinkSearch.failedAreas[index].expiresAt then
			table.remove(state.drinkSearch.failedAreas, index)
		end
	end
end

function state.drinkAreaFailed(position)
	if not position then return false end
	state.drinkForgetExpiredFailures()

	for _, area in ipairs(state.drinkSearch.failedAreas) do
		local delta = Vector3.new(
			position.X - area.position.X,
			0,
			position.Z - area.position.Z
		)
		if delta.Magnitude <= 18 then
			return true
		end
	end
	return false
end

function state.drinkMarkFailed(position, seconds)
	if not position then return end
	state.drinkForgetExpiredFailures()

	for _, area in ipairs(state.drinkSearch.failedAreas) do
		local delta = Vector3.new(
			position.X - area.position.X,
			0,
			position.Z - area.position.Z
		)
		if delta.Magnitude <= 18 then
			area.expiresAt = tick() + (seconds or 150)
			return
		end
	end

	table.insert(state.drinkSearch.failedAreas, {
		position = position,
		expiresAt = tick() + (seconds or 150),
	})
end

function state.drinkMainWaterContainsXZ(part, x, z)
	if not part or not part:IsA("BasePart") then return false end

	local localPoint = part.CFrame:PointToObjectSpace(
		Vector3.new(x, part.Position.Y, z)
	)

	return math.abs(localPoint.X) <= part.Size.X * 0.5
		and math.abs(localPoint.Z) <= part.Size.Z * 0.5
end

function state.drinkMainWaterSurface(part, x, z)
	if not state.drinkMainWaterContainsXZ(part, x, z) then return nil end

	local top = part.Position.Y + part.Size.Y * 0.5
	local candidate = Vector3.new(x, top, z)

	-- MainWaterPart exists underneath huge portions of Savannah terrain.
	-- IMPORTANT: cast from FAR ABOVE the map. The old +55 ray could begin
	-- inside a hill and miss the covering terrain, accepting buried water.
	local castY = math.max(top + 1200, 1400)
	local terrainHit = workspace:Raycast(
		Vector3.new(x, castY, z),
		Vector3.new(0, -(castY - top + 1400), 0),
		terrainParams
	)

	if terrainHit then
		-- The first visible Terrain surface is water -> genuinely exposed.
		if terrainHit.Material == Enum.Material.Water then
			return terrainHit.Position
		end

		-- First visible surface is solid terrain above MainWaterPart.
		-- The water is buried and must NEVER be used.
		if terrainHit.Position.Y > top + 1.5 then
			return nil
		end
	end

	-- No covering Terrain was found above the MainWaterPart surface.
	return candidate
end

function state.drinkIsBuriedUnderTerrain(root)
	if not root then return false end

	-- Cast from far above so we see the actual top surface of Terrain.
	local x, z = root.Position.X, root.Position.Z
	local castY = math.max(root.Position.Y + 700, 1200)

	local hit = workspace:Raycast(
		Vector3.new(x, castY, z),
		Vector3.new(0, -(castY - root.Position.Y + 900), 0),
		terrainParams
	)

	if not hit or hit.Material == Enum.Material.Water then
		return false
	end

	-- If solid Terrain is materially ABOVE the HRP, the animal is under the map.
	return hit.Position.Y >= root.Position.Y + 4
end

function state.drinkLandingCovered(position)
	if not position then return true end

	local castY = math.max(position.Y + 700, 1200)
	local hit = workspace:Raycast(
		Vector3.new(position.X, castY, position.Z),
		Vector3.new(0, -(castY - position.Y + 900), 0),
		terrainParams
	)

	if not hit then
		return false
	end

	if hit.Material == Enum.Material.Water then
		return false
	end

	return hit.Position.Y > position.Y + 7
end

function state.drinkClearUndergroundMode()
	state.drinkSearch.undergroundMode = false
	state.drinkSearch.undergroundSince = 0
	state.drinkSearch.undergroundLastProgressAt = 0
	state.drinkSearch.undergroundLastWater = nil
end

function state.drinkFindUndergroundSpot(origin, character)
	if not isSavannahLife or not origin then return nil end

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	if not waterPart or not waterPart:IsA("BasePart") then return nil end

	local waterY = waterPart.Position.Y + waterPart.Size.Y * 0.5
	local angleOffset = (player.UserId % 360) * math.pi / 180

	local best
	local bestCover = math.huge

	-- Prefer the SHALLOWEST buried point near the player. We intentionally
	-- use buried MainWaterPart only when exposed water could not be found.
	for radius = 0, 520, 20 do
		local samples = radius == 0 and 1 or 16

		for index = 0, samples - 1 do
			local angle = angleOffset + index / samples * math.pi * 2
			local x = origin.X + math.cos(angle) * radius
			local z = origin.Z + math.sin(angle) * radius

			if state.drinkMainWaterContainsXZ(waterPart, x, z) then
				local waterPoint = Vector3.new(x, waterY, z)

				if not state.drinkAreaFailed(waterPoint) then
					local hit = workspace:Raycast(
						Vector3.new(x, math.max(origin.Y + 700, 1200), z),
						Vector3.new(0, -2200, 0),
						terrainParams
					)

					if hit and hit.Material ~= Enum.Material.Water then
						local cover = hit.Position.Y - waterY

						-- Must really be underground, but avoid extremely deep
						-- points when a shallower buried point is available.
						if cover >= 2 and cover < bestCover then
							bestCover = cover
							best = waterPoint
						end
					end
				end
			end
		end

		-- A shallow underground point is preferable to searching far away.
		if best and bestCover <= 18 then
			break
		end
	end

	if not best then return nil end

	local _, _, humanoid = characterParts()
	local lift = humanoid and math.max(humanoid.HipHeight, 1.5) or 2.5

	return {
		water = best,
		stand = best + Vector3.new(0, lift, 0),
		source = "UndergroundMainWaterPart",
		underground = true,
		coverDepth = bestCover,
	}
end

function state.drinkUndergroundSafety(character, root, humanoid, water)
	if not state.drinkSearch.undergroundMode then return false end
	if not character or not root or not humanoid then return true end

	local now = tick()
	local since = state.drinkSearch.undergroundSince or now
	local lastProgress = state.drinkSearch.undergroundLastProgressAt or since
	local previousWater = state.drinkSearch.undergroundLastWater

	-- Water gain proves that the hidden source is actually working.
	if type(water) == "number"
		and (previousWater == nil or water > previousWater + 0.05) then

		state.drinkSearch.undergroundLastWater = water
		state.drinkSearch.undergroundLastProgressAt = now
		lastProgress = now
	end

	-- Correct a bad ragdoll very quickly underground. It is okay to flip during
	-- descent, but never stay upside-down under Terrain.
	if state.drinkIsUpsideDown(root) then
		state.drinkUprightCharacter(
			character,
			root,
			state.drinkSearch.currentWaterPoint
		)

		task.wait(0.08)

		if state.drinkIsUpsideDown(root)
			and now - since >= 1.5 then

			state.drinkEmergencyEscape(
				character,
				root,
				"Agua subterranea: animal preso invertido; saindo antes de afogar"
			)
			return true
		end
	end

	-- If the hidden source doesn't increase Water, don't sit underground.
	if now - lastProgress >= 5.0 then
		state.drinkEmergencyEscape(
			character,
			root,
			"Agua subterranea sem progresso por 5s; abortando"
		)
		return true
	end

	-- Independent health failsafe: underground drinking should never consume a
	-- meaningful amount of HP.
	local maxHealth = math.max(humanoid.MaxHealth, 1)
	if state.drinkSearch.waterHealth == nil then
		state.drinkSearch.waterHealth = humanoid.Health
		state.drinkSearch.waterHealthAt = now
	else
		local lost = state.drinkSearch.waterHealth - humanoid.Health
		if lost >= maxHealth * 0.03 then
			state.drinkEmergencyEscape(
				character,
				root,
				"Agua subterranea: perdeu vida; escape anti-afogamento"
			)
			return true
		end
	end

	-- Hard ceiling even if something strange keeps changing Water.
	-- Normal drinking should finish well before this; if not, leave and retry.
	if now - since >= 22 then
		state.drinkEmergencyEscape(
			character,
			root,
			"Agua subterranea: limite de seguranca de 22s atingido"
		)
		return true
	end

	return false
end

function state.dinoDrinkBankRejected(bankPosition, waterPosition)
	if not isDinoLife then
		return false
	end

	if typeof(bankPosition) ~= "Vector3"
		or typeof(waterPosition) ~= "Vector3" then
		return true
	end

	local character = player.Character
	if not character then
		return true
	end

	-- Dino Life: geometry is NOT authoritative for Drink. The old 2.0/2.4-stud
	-- gate plus a wall ray rejected perfectly usable river banks and made Rex keep
	-- selecting small puddles instead. Only reject an absurd vertical mismatch;
	-- the game's real Drink detector/HUD remains the final authority after arrival.
	local maxRise = state.isDinoRexMovementCharacter(character) and 7.5 or 6.0
	local rise = bankPosition.Y - waterPosition.Y

	if rise < -2.5 or rise > maxRise then
		return true
	end

	return false
end

-- Terrain-only rays are insufficient in Dino Life because many shoreline
-- boulders are MeshParts/BaseParts. Return the REAL collidable support directly
-- under the animal while explicitly ignoring the non-collidable water plane and
-- WaterMoss visual decoration.
function state.dinoDrinkPhysicalSupport(character, root)
	if not isDinoLife or not character or not root then
		return nil
	end

	local ignored = { character }
	local waterPart = workspace:FindFirstChild("MainWaterPart")
	if waterPart then
		ignored[#ignored + 1] = waterPart
	end

	if state.movementDinoWaterMossVisual then
		local moss = state.movementDinoWaterMossVisual()
		if moss then
			ignored[#ignored + 1] = moss
		end
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignored
	params.IgnoreWater = true
	pcall(function()
		params.RespectCanCollide = true
	end)

	return workspace:Raycast(
		root.Position + Vector3.new(0, 14, 0),
		Vector3.new(0, -120, 0),
		params
	)
end

-- Dino Life shoreline validation.
-- IMPORTANT: do NOT raycast arbitrary BaseParts above the bank here.
-- MapAssets.Rocks already has its own per-rock movement blockers, and using a
-- vertical "first collidable support must be Terrain" test was rejecting valid
-- water that was visibly a few studs in front of the dinosaur.
function state.dinoDrinkBankCandidateClear(character, bankPosition, waterPosition)
	if not isDinoLife then
		return true
	end

	if not character
		or typeof(bankPosition) ~= "Vector3"
		or typeof(waterPosition) ~= "Vector3" then
		return false
	end

	-- Height is still validated by dinoDrinkBankRejected at the call sites.
	-- This function intentionally performs NO BasePart/rock-over-bank veto.
	return true
end

function state.dinoDrinkArrivalRejected(character, root, waterPosition)
	if not isDinoLife then
		return false
	end

	if not character
		or not root
		or typeof(waterPosition) ~= "Vector3" then
		return true
	end

	-- Dino Life itself is authoritative. If Drink is available, always accept.
	local promptHere =
		state.drinkGamePromptAvailable
		and state.drinkGamePromptAvailable(character)
	local visualHere =
		state.drinkVisualPromptVisible
		and state.drinkVisualPromptVisible()
	if promptHere or visualHere then
		return false
	end

	-- Do not reject arrival because a vertical support ray touched a rock/MeshPart.
	-- The selected shoreline Terrain already passed the water-height test and the
	-- Dino per-rock route blocker handles actual rock collisions during movement.
	return false
end

-- ============================================================
-- Dino Life water safety / river preference.
-- Water inside a dense MapAssets.Rocks cluster is a bad survival target even if
-- the water itself is technically reachable. Prefer broad/open water and reject
-- banks that would put a large dinosaur inside a rock pocket.
-- ============================================================
state.carcassController =
	state.carcassController
	or {
		token = 0,
		cancelRequested = false,
	}

state.dinoRockEmergency = state.dinoRockEmergency or {
	active = false,
	lastPosition = nil,
	lastProgressAt = 0,
	lastEscapeAt = 0,

	-- General Dino rock-trap supervisor. This is NOT tied to Water.
	supervisorActive = false,
	supervisorToken = 0,
	supervisorCharacter = nil,
	supervisorStartedAt = 0,
	supervisorLastPosition = nil,
	supervisorLastProgressAt = 0,
	supervisorLastFood = nil,
	supervisorLastWater = nil,
	supervisorLastTriggerAt = 0,
	supervisorFailureCount = 0,
	supervisorPreviousCritical = false,

	-- Once Safety picks an exit, it must NOT keep choosing left/right again.
	-- This is the anti-"formiga tonta" lock for emergency extraction.
	supervisorTarget = nil,
	supervisorTargetChosenAt = 0,
	supervisorStartPosition = nil,

	-- Cached lightweight geometry result for the MMB AI Blackboard.
	moralTrapped = false,
	moralNearby = 0,
	moralInside = 0,
	moralOpenCorridors = 16,
	moralProbeAt = 0,

	objectiveStalled = false,
	foodRouteFailures = 0,
	foodRouteFailureAt = 0,
	rockPressureNearby = 0,
	rockPressureNearestGap = math.huge,
}

function state.dinoWaterCandidateRockDanger(character, bankPosition, waterPosition)
	if not isDinoLife or not character then
		return false, 0
	end

	local function registerRestrictedBasin()
		local anchorPosition =
			typeof(waterPosition) == "Vector3"
				and waterPosition
				or bankPosition

		if typeof(anchorPosition) ~= "Vector3"
			or not state.dinoRestrictedBasinRegister then
			return nil
		end

		local ok, zone =
			pcall(
				state.dinoRestrictedBasinRegister,
				anchorPosition,
				character
			)

		return ok and zone or nil
	end

	local footprint = state.movementFootprint(character)
	local nearDistance =
		math.clamp(
			footprint * 0.22 + 3.5,
			4.5,
			10
		)
	local nearbyCount = 0

	local queryCenter =
		typeof(bankPosition) == "Vector3"
		and typeof(waterPosition) == "Vector3"
		and (bankPosition + waterPosition) * 0.5
		or bankPosition
		or waterPosition

	local bankWaterDistance =
		typeof(bankPosition) == "Vector3"
		and typeof(waterPosition) == "Vector3"
		and Vector3.new(
			waterPosition.X - bankPosition.X,
			0,
			waterPosition.Z - bankPosition.Z
		).Magnitude
		or 0

	for _, entry in ipairs(
		state.movementDinoRockNearbyEntries(
			queryCenter,
			nearDistance + 34 + bankWaterDistance * 0.5
		)
	) do
		local part =
			entry
			and entry.part

		if part
			and part.Parent then

			-- Cheap broad phase. Most MapAssets.Rocks are nowhere near this
			-- candidate and must not pay the OBB projection cost.
			local broad =
				math.max(
					part.Size.X,
					part.Size.Z
				) * 0.60
				+ nearDistance
				+ 12

			local nearCandidate =
				false

			if typeof(
				bankPosition
			) == "Vector3" then

				local dx =
					bankPosition.X
						- part.Position.X

				local dz =
					bankPosition.Z
						- part.Position.Z

				nearCandidate =
					dx * dx + dz * dz
						<= broad * broad
			end

			if not nearCandidate
				and typeof(
					waterPosition
				) == "Vector3" then

				local dx =
					waterPosition.X
						- part.Position.X

				local dz =
					waterPosition.Z
						- part.Position.Z

				nearCandidate =
					dx * dx + dz * dz
						<= broad * broad
			end

			if not nearCandidate then
				continue
			end

			local frame =
				state.movementDinoRockFrame(
					entry,
					character,
					2
				)

			if frame then
				local rockNear =
					false

				if typeof(
					bankPosition
				) == "Vector3" then

					local _,
						_,
						insideBank,
						bankGap =
							state.movementDinoRockLocalData(
								bankPosition,
								frame
							)

					if insideBank then
						registerRestrictedBasin()
						return true,
							math.huge
					end

					if bankGap
						and bankGap
							<= nearDistance then

						rockNear =
							true
					end
				end

				if typeof(
					waterPosition
				) == "Vector3" then

					local _,
						_,
						insideWater,
						waterGap =
							state.movementDinoRockLocalData(
								waterPosition,
								frame
							)

					if insideWater then
						registerRestrictedBasin()
						return true,
							math.huge
					end

					if waterGap
						and waterGap
							<= nearDistance
								* 0.85 then

						rockNear =
							true
					end
				end

				if rockNear then
					nearbyCount += 1

					-- Nearby rocks by themselves are NOT a reason to reject drinkable water.
					-- A river bank with two ordinary rocks must remain usable. Only a real
					-- dense basin (the register function requires a local rock cluster) is
					-- promoted to a combined restricted area.
					if nearbyCount >= 4 then
						local basin =
							registerRestrictedBasin()

						if basin then
							return true, nearbyCount
						end
					end
				end
			end
		end
	end

	return false,
		nearbyCount
end

function state.dinoWaterOpenScore(position, waterPart)
	if not isDinoLife or typeof(position) ~= "Vector3" then
		return 0
	end

	local offsets = {
		Vector3.new(0, 0, 0),
		Vector3.new(24, 0, 0), Vector3.new(-24, 0, 0),
		Vector3.new(0, 0, 24), Vector3.new(0, 0, -24),
		Vector3.new(48, 0, 0), Vector3.new(-48, 0, 0),
		Vector3.new(0, 0, 48), Vector3.new(0, 0, -48),
		Vector3.new(28, 0, 28), Vector3.new(-28, 0, 28),
		Vector3.new(28, 0, -28), Vector3.new(-28, 0, -28),
	}

	local wet = 0
	local castY = math.max(position.Y + 260, 700)

	for _, offset in ipairs(offsets) do
		local sample = position + offset
		local hit = workspace:Raycast(
			Vector3.new(sample.X, castY, sample.Z),
			Vector3.new(0, -(castY + 500), 0),
			terrainParams
		)

		local isWet = hit and hit.Material == Enum.Material.Water

		if not isWet
			and waterPart
			and waterPart:IsA("BasePart") then
			isWet = state.drinkMainWaterSurface(
				waterPart,
				sample.X,
				sample.Z
			) ~= nil
		end

		if isWet then
			wet += 1
		end
	end

	return wet
end

function state.dinoRockTrapMetrics(character, position)
	if not isDinoLife
		or not character
		or typeof(position) ~= "Vector3" then
		return false, 0, 0
	end

	local footprint = state.movementFootprint(character)
	local nearDistance = math.clamp(footprint * 0.42 + 7, 9, 18)
	local nearby = 0
	local inside = 0

	for _, entry in ipairs(
		state.movementDinoRockNearbyEntries(
			position,
			nearDistance + 38
		)
	) do
		local frame = state.movementDinoRockFrame(entry, character, 2)
		if frame then
			local _, _, isInside, gap =
				state.movementDinoRockLocalData(position, frame)

			if isInside then
				inside += 1
				nearby += 1
			elseif gap and gap <= nearDistance then
				nearby += 1
			end
		end
	end

	local inRestrictedBasin =
		state.dinoRestrictedBasinPointForbidden
		and state.dinoRestrictedBasinPointForbidden(
			position,
			character,
			0
		)
		or false

	return inside > 0
		or (
			inRestrictedBasin
			and nearby >= 3
		),
		nearby,
		inside
end

function state.dinoRockMoralTrapMetrics(
	character,
	position
)
	if not isDinoLife
		or not character
		or typeof(position) ~= "Vector3" then
		return false, 0, 0, 16
	end

	local physicallyTrapped,
		nearby,
		inside =
			state.dinoRockTrapMetrics(
				character,
				position
			)

	if physicallyTrapped then
		return true, nearby, inside, 0
	end

	if nearby < 2 then
		return false, nearby, inside, 16
	end

	local footprint =
		math.max(
			4,
			state.movementFootprint(
				character
			)
		)

	local distances = {
		math.clamp(
			footprint * 0.70 + 7,
			11,
			19
		),
		math.clamp(
			footprint * 1.30 + 12,
			19,
			32
		),
		math.clamp(
			footprint * 2.00 + 18,
			29,
			48
		),
	}

	-- IMPORTANT PERFORMANCE RULE:
	-- build the relevant nearby OBB list ONCE. Do not rescan every MapAssets.Rocks
	-- part for every sample direction.
	local maximumProbe =
		distances[#distances]
			+ footprint
			+ 18

	local localFrames = {}

	for _, entry in ipairs(
		state.movementDinoRockNearbyEntries(
			position,
			maximumProbe
		)
	) do
		local part = entry.part

		if part and part.Parent then
			local delta =
				Vector3.new(
					part.Position.X - position.X,
					0,
					part.Position.Z - position.Z
				)

			local partReach =
				math.max(
					part.Size.X,
					part.Size.Z
				) * 0.65

			if delta.Magnitude
				<= maximumProbe + partReach then

				local frame =
					state.movementDinoRockFrame(
						entry,
						character,
						0.35
					)

				if frame then
					localFrames[#localFrames + 1] =
						frame
				end
			end
		end
	end

	local openCorridors = 0
	local samples = 16

	for index = 0, samples - 1 do
		local angle =
			index / samples
				* math.pi
				* 2

		local direction =
			Vector3.new(
				math.cos(angle),
				0,
				math.sin(angle)
			)

		local previous =
			position

		local blocked =
			false

		for _, distance in ipairs(
			distances
		) do
			local sample =
				position
					+ direction
						* distance

			local basinBlocked =
				state.dinoRestrictedBasinPointForbidden
				and state.dinoRestrictedBasinPointForbidden(
					sample,
					character,
					0.35
				)
				or false

			if basinBlocked then
				blocked = true
				break
			end

			for _, frame in ipairs(
				localFrames
			) do
				local _, _, insidePoint =
					state.movementDinoRockLocalData(
						sample,
						frame
					)

				if insidePoint
					or state.movementDinoRockSegmentIntersects(
						previous,
						sample,
						frame
					) then

					blocked = true
					break
				end
			end

			if blocked then
				break
			end

			previous =
				sample
		end

		if not blocked then
			openCorridors += 1
		end
	end

	local constrained =
		nearby >= 4
			and openCorridors <= 2
		or nearby >= 3
			and openCorridors <= 1
		or nearby >= 2
			and openCorridors == 0

	return constrained,
		nearby,
		inside,
		openCorridors
end

function state.dinoRockPressureMetrics(character, position)
	if not isDinoLife
		or not character
		or typeof(position) ~= "Vector3" then
		return false, 0, math.huge
	end

	local footprint = math.max(4, state.movementFootprint(character))
	local pressureDistance = math.clamp(
		footprint * 0.70 + 10,
		16,
		30
	)

	local nearby = 0
	local nearestGap = math.huge

	for _, entry in ipairs(
		state.movementDinoRockNearbyEntries(
			position,
			pressureDistance + 38
		)
	) do
		local frame = state.movementDinoRockFrame(entry, character, 0.5)

		if frame then
			local _, _, inside, gap =
				state.movementDinoRockLocalData(position, frame)

			if inside then
				nearby += 1
				nearestGap = 0
			elseif gap then
				nearestGap = math.min(nearestGap, gap)

				if gap <= pressureDistance then
					nearby += 1
				end
			end
		end
	end

	return nearby >= 1, nearby, nearestGap
end

function state.dinoRockResetFoodRouteEvidence()
	local emergency = state.dinoRockEmergency
	emergency.objectiveStalled = false
	emergency.foodRouteFailures = 0
	emergency.foodRouteFailureAt = 0
end

function state.dinoRockEmergencyFindSafePoint(character, root, humanoid)
	if not isDinoLife or not character or not root then
		return nil
	end

	local origin = root.Position
	local footprint = math.max(
		4,
		state.movementFootprint(character)
	)

	local lift =
		humanoid
			and math.max(humanoid.HipHeight, 2.5)
			or 3

	-- Build a repulsion vector from EACH nearby rock. This is awareness only;
	-- we do not merge them into one obstacle.
	local away = Vector3.zero

	for _, entry in ipairs(
		state.movementDinoRockNearbyEntries(
			origin,
			145
		)
	) do
		local part = entry.part

		if part and part.Parent then
			local delta = Vector3.new(
				origin.X - part.Position.X,
				0,
				origin.Z - part.Position.Z
			)

			local distance = delta.Magnitude

			if distance > 0.1 and distance <= 125 then
				local sizeWeight =
					math.clamp(
						math.max(part.Size.X, part.Size.Z) / 18,
						0.75,
						2.6
					)

				away += delta.Unit
					* sizeWeight
					* (
						1 / math.max(distance, 7)
					)
			end
		end
	end

	local awayUnit =
		away.Magnitude > 0.04
			and away.Unit
			or nil

	local look =
		Vector3.new(
			root.CFrame.LookVector.X,
			0,
			root.CFrame.LookVector.Z
		)

	if look.Magnitude > 0.05 then
		look = look.Unit
	else
		look = nil
	end

	-- Score MANY candidates and then commit to one. The old function returned the
	-- first acceptable point, which made the chosen side depend on loop ordering.
	local best
	local bestScore = -math.huge

	local radii = {
		48,
		64,
		82,
		104,
		128,
		156,
		190,
	}

	local samples = 24
	local castY = math.max(origin.Y + 260, 700)

	for _, radius in ipairs(radii) do
		for index = 0, samples - 1 do
			local angle =
				index / samples
					* math.pi
					* 2

			local direction =
				Vector3.new(
					math.cos(angle),
					0,
					math.sin(angle)
				)

			local probe =
				origin
					+ direction * radius

			local hit =
				workspace:Raycast(
					Vector3.new(
						probe.X,
						castY,
						probe.Z
					),
					Vector3.new(
						0,
						-(castY + 500),
						0
					),
					terrainParams
				)

			if hit
				and hit.Material ~= Enum.Material.Water
				and hit.Normal.Y >= 0.32 then

				local candidate =
					hit.Position
						+ Vector3.new(
							0,
							lift,
							0
						)

				local forbidden =
					state.movementDinoRockPointForbidden(
						candidate,
						character,
						7
					)

				if not forbidden then
					local trapped,
						nearby,
						inside,
						openCorridors =
							state.dinoRockMoralTrapMetrics(
								character,
								candidate
							)

					local pressure,
						pressureNearby,
						nearestGap =
							state.dinoRockPressureMetrics(
								character,
								candidate
							)

					local wet =
						state.confirmedTrapFlyPointWet
						and state.confirmedTrapFlyPointWet(
							candidate
						)
						or false

					local landingClear =
						state.landSlopeLandingColumnClear(
							character,
							hit.Position
						)

					if not trapped
						and inside <= 0
						and not wet
						and landingClear then

						local awayAlignment =
							awayUnit
								and awayUnit:Dot(direction)
								or 0

						local lookAlignment =
							look
								and look:Dot(direction)
								or 0

						local clearanceScore =
							nearestGap == math.huge
								and 55
								or math.clamp(
									nearestGap,
									0,
									55
								)

						-- Strongly prefer:
						--  * farther away from the local rock pressure,
						--  * zero/low nearby rocks at the destination,
						--  * several open corridors at the destination,
						--  * the repulsion direction calculated from current rocks.
						--
						-- Slightly penalize extreme travel distance so it doesn't
						-- choose the opposite side of the entire map.
						local score =
							awayAlignment * 34
							+ lookAlignment * 2
							+ clearanceScore * 2.2
							+ openCorridors * 5.5
							- pressureNearby * 22
							- nearby * 10
							- (
								pressure
									and 18
									or 0
							)
							- radius * 0.035

						if score > bestScore then
							bestScore = score
							best = candidate
						end
					end
				end
			end
		end
	end

	if best then
		return best
	end

	-- Last resort: pick a normal spawn that is itself clear of individual rock
	-- envelopes and dry. We still score instead of returning the first one.
	refreshCompletionSpawns()

	for _, part in ipairs(completionSpawnParts) do
		if part
			and part.Parent
			and part:IsA("BasePart") then

			local candidate =
				part.Position
					+ Vector3.new(
						0,
						lift,
						0
					)

			local forbidden =
				state.movementDinoRockPointForbidden(
					candidate,
					character,
					7
				)

			local trapped,
				nearby,
				inside,
				openCorridors =
					state.dinoRockMoralTrapMetrics(
						character,
						candidate
					)

			local wet =
				state.confirmedTrapFlyPointWet
				and state.confirmedTrapFlyPointWet(
					candidate
				)
				or false

			if not forbidden
				and not trapped
				and inside <= 0
				and nearby <= 1
				and openCorridors >= 4
				and not wet then

				local distance =
					Vector3.new(
						candidate.X - origin.X,
						0,
						candidate.Z - origin.Z
					).Magnitude

				local score =
					openCorridors * 5
						- nearby * 12
						- distance * 0.02

				if score > bestScore then
					bestScore = score
					best = candidate
				end
			end
		end
	end

	return best
end

function state.dinoRockEmergencyCruiseY(
	character,
	startPosition,
	targetPosition
)
	if not character
		or typeof(startPosition) ~= "Vector3"
		or typeof(targetPosition) ~= "Vector3" then

		return math.max(
			startPosition and startPosition.Y or 0,
			targetPosition and targetPosition.Y or 0
		) + 24
	end

	local bodyHeight =
		math.max(
			6,
			state.movementBodySize(character).Y
		)

	local clearance =
		math.clamp(
			bodyHeight * 0.70 + 10,
			18,
			42
		)

	local highest =
		math.max(
			startPosition.Y,
			targetPosition.Y
		)

	-- Only rocks near the actual start->target corridor can raise cruise height.
	local segmentMid =
		(startPosition + targetPosition) * 0.5

	local segmentRadius =
		Vector3.new(
			targetPosition.X - startPosition.X,
			0,
			targetPosition.Z - startPosition.Z
		).Magnitude * 0.5 + 72

	for _, entry in ipairs(
		state.movementDinoRockNearbyEntries(
			segmentMid,
			segmentRadius
		)
	) do
		local part = entry.part

		if part
			and part.Parent
			and part:IsA("BasePart") then

			local frame =
				state.movementDinoRockFrame(
					entry,
					character,
					2
				)

			if frame
				and state.movementDinoRockSegmentIntersects(
					startPosition,
					targetPosition,
					frame
				) then

				local cf = part.CFrame
				local half = part.Size * 0.5

				local verticalExtent =
					math.abs(cf.RightVector.Y) * half.X
					+ math.abs(cf.UpVector.Y) * half.Y
					+ math.abs(cf.LookVector.Y) * half.Z

				highest =
					math.max(
						highest,
						part.Position.Y
							+ verticalExtent
					)
			end
		end
	end

	return highest + clearance
end


function state.dinoRockEmergencyNoclipEscape(
	character,
	root,
	humanoid,
	resumePurpose,
	forcedTarget
)
	if not isDinoLife or not character or not root or not humanoid then
		return false
	end

	local emergency = state.dinoRockEmergency
	if emergency.active then
		return true
	end

	local target =
		typeof(forcedTarget) == "Vector3"
			and forcedTarget
			or state.dinoRockEmergencyFindSafePoint(
				character,
				root,
				humanoid
			)

	if not target then
		return false
	end

	emergency.active = true
	emergency.lastEscapeAt = tick()

	if state.safeMove and state.safeMove.active then
		state.safeMove.cancelToken += 1
		state.safeMove.active = false
		state.safeMove.reason = nil
	end

	if resumePurpose == "water" then
		local failedPoint = state.drinkSearch.currentWaterPoint
		if failedPoint then state.drinkMarkFailed(failedPoint, 240) end
		state.drinkSearch.currentWaterPoint = nil
		state.drinkSearch.retryAfter = 0
		state.drinkSearch.failedCount = 0
	end

	-- Kill ONLY our own movement movers before direct emergency extraction.
	-- This prevents the low confirmed-trap Fly, aquatic Fly or another MMB
	-- BodyPosition from dragging the Rex back toward the old point.
	if state.confirmedTrapFly then
		state.confirmedTrapFly.busy = false

		if state.confirmedTrapFly.bodyPosition
			and state.confirmedTrapFly.bodyPosition.Parent then

			pcall(
				state.confirmedTrapFly.bodyPosition.Destroy,
				state.confirmedTrapFly.bodyPosition
			)
		end

		if state.confirmedTrapFly.bodyGyro
			and state.confirmedTrapFly.bodyGyro.Parent then

			pcall(
				state.confirmedTrapFly.bodyGyro.Destroy,
				state.confirmedTrapFly.bodyGyro
			)
		end

		state.confirmedTrapFly.bodyPosition = nil
		state.confirmedTrapFly.bodyGyro = nil
		state.confirmedTrapFly.retryAt = tick() + 3
	end

	if state.aquaticRiverEscape then
		for _, mover in ipairs({
			state.aquaticRiverEscape.bodyPosition,
			state.aquaticRiverEscape.bodyVelocity,
			state.aquaticRiverEscape.bodyGyro,
		}) do
			if mover and mover.Parent then
				pcall(
					mover.Destroy,
					mover
				)
			end
		end

		state.aquaticRiverEscape.bodyPosition = nil
		state.aquaticRiverEscape.bodyVelocity = nil
		state.aquaticRiverEscape.bodyGyro = nil
		state.aquaticRiverEscape.busy = false
	end

	for _, mover in ipairs(root:GetChildren()) do
		if (
			mover:IsA("BodyPosition")
				or mover:IsA("BodyVelocity")
				or mover:IsA("BodyGyro")
				or mover:IsA("LinearVelocity")
				or mover:IsA("AlignPosition")
				or mover:IsA("VectorForce")
		)
			and string.sub(
				mover.Name,
				1,
				4
			) == "MMB_" then

			pcall(
				mover.Destroy,
				mover
			)
		end
	end

	local oldAutoRotate =
		humanoid.AutoRotate

	local oldPlatformStand =
		humanoid.PlatformStand

	local oldMovementDisabled =
		character:GetAttribute(
			"MovementDisabled"
		)

	pcall(function()
		humanoid.AutoRotate = false
		humanoid.PlatformStand = true
	end)

	character:SetAttribute(
		"MovementDisabled",
		true
	)

	local collisionSnapshot = {}
	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("BasePart") then
			collisionSnapshot[#collisionSnapshot + 1] = {
				part = object,
				canCollide = object.CanCollide,
			}
			object.CanCollide = false
		end
	end

	local previousCritical = criticalRecoveryActive
	criticalRecoveryActive = true
	state.busy = true
	runtimeMessage = "Dino rock trap: emergency noclip escape to safe ground"

	local start = root.Position
	local planar = Vector3.new(target.X - start.X, 0, target.Z - start.Z)
	local facing = planar.Magnitude > 0.05 and planar.Unit or Vector3.new(0, 0, -1)
	local footprint =
		state.movementFootprint(
			character
		)

	local cruiseY =
		state.dinoRockEmergencyCruiseY(
			character,
			start,
			target
		)

	local function movePhase(fromPosition, toPosition, duration)
		local started = tick()
		duration = math.max(0.08, duration)
		while state.alive
			and character == player.Character
			and root.Parent
			and tick() - started < duration do
			local alpha = math.clamp((tick() - started) / duration, 0, 1)
			alpha = alpha * alpha * (3 - 2 * alpha)
			local position =
				fromPosition:Lerp(
					toPosition,
					alpha
				)

			pcall(function()
				for _, record in ipairs(
					collisionSnapshot
				) do
					if record.part
						and record.part.Parent then

						record.part.CanCollide =
							false
					end
				end

				character:PivotTo(
					CFrame.lookAt(
						position,
						position + facing
					)
				)

				root.AssemblyLinearVelocity =
					Vector3.zero

				root.AssemblyAngularVelocity =
					Vector3.zero
			end)
			RunService.Heartbeat:Wait()
		end
		pcall(function()
			character:PivotTo(CFrame.lookAt(toPosition, toPosition + facing))
		end)
	end

	local risePoint = Vector3.new(start.X, cruiseY, start.Z)
	local crossPoint = Vector3.new(target.X, cruiseY, target.Z)
	movePhase(
		start,
		risePoint,
		0.22
	)

	movePhase(
		risePoint,
		crossPoint,
		math.clamp(
			planar.Magnitude / 105,
			0.28,
			1.10
		)
	)

	movePhase(
		crossPoint,
		target,
		0.28
	)

	for _, record in ipairs(collisionSnapshot) do
		if record.part and record.part.Parent then
			pcall(function()
				record.part.CanCollide = record.canCollide == true
			end)
		end
	end

	pcall(function()
		root.AssemblyLinearVelocity =
			Vector3.zero

		root.AssemblyAngularVelocity =
			Vector3.zero

		humanoid.PlatformStand =
			oldPlatformStand == true

		humanoid.AutoRotate =
			oldAutoRotate ~= false

		humanoid.Sit =
			false

		if not humanoid.PlatformStand then
			humanoid:ChangeState(
				Enum.HumanoidStateType.GettingUp
			)
		end
	end)

	if oldMovementDisabled == nil then
		character:SetAttribute(
			"MovementDisabled",
			false
		)
	else
		character:SetAttribute(
			"MovementDisabled",
			oldMovementDisabled
		)
	end

	local finalDisplacement =
		Vector3.new(
			root.Position.X - start.X,
			0,
			root.Position.Z - start.Z
		).Magnitude

	local finalTrapped,
		finalNearby,
		finalInside,
		finalOpen =
			state.dinoRockMoralTrapMetrics(
				character,
				root.Position
			)

	local finalPressure =
		state.dinoRockPressureMetrics(
			character,
			root.Position
		)

	local extractionValid =
		finalDisplacement >= 28
			and not finalTrapped
			and finalInside <= 0
			and finalOpen >= 3
			and not finalPressure

	state.busy = false
	criticalRecoveryActive = previousCritical
	emergency.active = false
	emergency.lastPosition = root.Position
	emergency.lastProgressAt = tick()
	eatingToFull = false
	eatingSourcePosition = nil
	blockClientSubState = false

	if resumePurpose == "water" then
		drinkingToFull = true
		if state.survivalForceWaterHandoff then
			pcall(state.survivalForceWaterHandoff, character, "Dino rock trap escaped; resuming water search")
		end
		runtimeMessage = "Dino rock trap escaped; searching safe open water"
	else
		drinkingToFull = false
		drinkingSourcePosition = nil
		if state.survivalArbiterReset then
			state.survivalArbiterReset("Dino rock trap escaped")
		end
		runtimeMessage = "Dino rock trap escaped to open ground; normal objective selection resumed"
	end
	return extractionValid == true
end

function state.dinoWaterRockEscapeWatch(character, root, humanoid, water)
	if not isDinoLife
		or not character
		or not root
		or not humanoid
		or (tonumber(water) or 100) > 75 then
		return false
	end

	local emergency = state.dinoRockEmergency
	if emergency.active then
		return true
	end

	-- Healthy Water movement already has local obstacle avoidance.
	-- Do not run a second full trap detector in parallel.
	if state.safeMove
		and state.safeMove.active
		and (
			state.safeMove.reason == "water"
				or state.safeMove.reason == "water_search"
		) then

		local now = tick()
		local lastProgress =
			state.safeMove.lastProgressAt
				or state.safeMove.startedAt
				or now

		if now - lastProgress < 2.25 then
			emergency.lastPosition = root.Position
			emergency.lastProgressAt = now
			return false
		end
	end

	local trapped, nearby, inside = state.dinoRockTrapMetrics(character, root.Position)
	local now = tick()

	if not trapped then
		emergency.lastPosition = root.Position
		emergency.lastProgressAt = now
		return false
	end

	if not emergency.lastPosition then
		emergency.lastPosition = root.Position
		emergency.lastProgressAt = now
		return false
	end

	local moved = Vector3.new(
		root.Position.X - emergency.lastPosition.X,
		0,
		root.Position.Z - emergency.lastPosition.Z
	).Magnitude

	if moved >= 2.0 then
		emergency.lastPosition = root.Position
		emergency.lastProgressAt = now
		return false
	end

	local stalledFor = now - (emergency.lastProgressAt or now)
	local shouldEscape =
		(inside > 0 and stalledFor >= 1.0)
		or (nearby >= 3 and stalledFor >= 2.5)

	if shouldEscape and now - (emergency.lastEscapeAt or 0) >= 5 then
		task.spawn(function()
			pcall(
				state.dinoRockEmergencyNoclipEscape,
				character,
				root,
				humanoid,
				"water"
			)
		end)
		return true
	end

	return false
end

function state.drinkFindBank(waterPosition)
	if not waterPosition then return nil end

	for radius = 4, 64, 4 do
		for index = 0, 15 do
			local angle = index / 16 * math.pi * 2
			local x = waterPosition.X + math.cos(angle) * radius
			local z = waterPosition.Z + math.sin(angle) * radius

			local hit = workspace:Raycast(
				Vector3.new(x, waterPosition.Y + 120, z),
				Vector3.new(0, -240, 0),
				terrainParams
			)

			if hit
				and hit.Material ~= Enum.Material.Water
				and math.abs(hit.Position.Y - waterPosition.Y) <= 11
				and (
					not isDinoLife
					or state.dinoDrinkBankCandidateClear(
						player.Character,
						hit.Position,
						waterPosition
					)
				)
				and not state.dinoDrinkBankRejected(
					hit.Position,
					waterPosition
				) then
				return hit.Position
			end
		end
	end
end

function state.drinkSolidTerrainHit(x, z, castY)
	if not state.drinkSolidTerrainParams then
		state.drinkSolidTerrainParams =
			RaycastParams.new()

		state.drinkSolidTerrainParams.FilterType =
			Enum.RaycastFilterType.Include

		state.drinkSolidTerrainParams.FilterDescendantsInstances = {
			workspace.Terrain,
		}

		state.drinkSolidTerrainParams.IgnoreWater = true
	end

	return workspace:Raycast(
		Vector3.new(x, castY, z),
		Vector3.new(0, -1800, 0),
		state.drinkSolidTerrainParams
	)
end

function state.drinkMainWaterExposedAt(waterPart, x, z, castY)
	if not waterPart
		or not waterPart:IsA("BasePart")
		or not state.drinkMainWaterContainsXZ(
			waterPart,
			x,
			z
		) then
		return false, nil
	end

	local waterY =
		waterPart.Position.Y
		+ waterPart.Size.Y * 0.5

	local hit =
		state.drinkSolidTerrainHit(
			x,
			z,
			castY
		)

	-- Do not interpret missing Terrain as a safe river.
	if not hit then
		return false, nil
	end

	-- MainWaterPart is visible here only when the solid Terrain floor is
	-- meaningfully BELOW the water surface. Terrain above/at the surface means
	-- MainWaterPart is buried and is rejected.
	return hit.Position.Y <= waterY - 0.35,
		hit
end

function state.drinkFindMainWaterBank(
	waterPosition,
	origin,
	waterPart,
	character
)
	if typeof(waterPosition) ~= "Vector3"
		or typeof(origin) ~= "Vector3"
		or not waterPart
		or not waterPart:IsA("BasePart") then
		return nil
	end

	local waterY =
		waterPart.Position.Y
		+ waterPart.Size.Y * 0.5

	local flat =
		Vector3.new(
			waterPosition.X - origin.X,
			0,
			waterPosition.Z - origin.Z
		)

	local distance = flat.Magnitude
	if distance <= 1 then
		return nil
	end

	local direction = flat.Unit
	local castY =
		math.max(
			origin.Y,
			waterY
		) + 420

	-- Candidate itself must be truly exposed MainWaterPart.
	local candidateExposed =
		state.drinkMainWaterExposedAt(
			waterPart,
			waterPosition.X,
			waterPosition.Z,
			castY
		)

	if not candidateExposed then
		return nil
	end

	local originExposed, originHit =
		state.drinkMainWaterExposedAt(
			waterPart,
			origin.X,
			origin.Z,
			castY
		)

	-- Large bodies can have HRP X/Z slightly over MainWaterPart while standing
	-- on the lip. In that case, use the nearest dry Terrain bank locally.
	if originExposed or not originHit then
		local localBank =
			state.drinkFindBank(
				waterPosition
			)

		if localBank then
			local localDistance =
				Vector3.new(
					localBank.X - origin.X,
					0,
					localBank.Z - origin.Z
				).Magnitude

			if localDistance <= 72 then
				return localBank,
					Vector3.new(
						waterPosition.X,
						waterY,
						waterPosition.Z
					)
			end
		end

		return nil
	end

	local step =
		math.clamp(
			distance / 80,
			3,
			9
		)

	local lastDryT = 0
	local lastDryHit = originHit
	local firstWetT
	local firstWetHit

	local t = step

	while t <= distance + 0.001 do
		local point =
			origin + direction * t

		local exposed, hit =
			state.drinkMainWaterExposedAt(
				waterPart,
				point.X,
				point.Z,
				castY
			)

		if exposed then
			firstWetT = t
			firstWetHit = hit
			break
		elseif hit then
			lastDryT = t
			lastDryHit = hit
		end

		t += step
	end

	-- Exact sampled point is already validated exposed.
	if not firstWetT then
		firstWetT = distance
	end

	if not lastDryHit then
		return nil
	end

	-- Resolve the FIRST dry -> exposed-water boundary on THIS side of the river.
	local low = math.max(0, lastDryT)
	local high = firstWetT
	local lowHit = lastDryHit

	for _ = 1, 9 do
		local mid =
			(low + high) * 0.5

		local point =
			origin + direction * mid

		local exposed, hit =
			state.drinkMainWaterExposedAt(
				waterPart,
				point.X,
				point.Z,
				castY
			)

		if exposed then
			high = mid
		elseif hit then
			low = mid
			lowHit = hit
		else
			-- Missing Terrain is not accepted as water.
			low = mid
		end
	end

	if not lowHit then
		return nil
	end

	-- One precomputed bank point. No movement refinement after arrival.
	local bankBackoff
	if state.isCrocOrHippoMovementCharacter(character) then
		bankBackoff = math.clamp(
			state.movementFootprint(character) * 0.38,
			4.5,
			8.0
		)
	elseif isDinoLife and not isAquaticCharacter(character) then
		-- Land dinos must approach the true water-level lip. A large backoff can
		-- leave Rex on the upper shelf even though X/Z is only ~1 stud from water.
		bankBackoff = 0.18
	else
		bankBackoff = 0.80
	end

	local standDistance = math.max(0, low - bankBackoff)

	local standXZ =
		origin
		+ direction * standDistance

	local standHit =
		state.drinkSolidTerrainHit(
			standXZ.X,
			standXZ.Z,
			castY
		)
		or lowHit

	if not standHit
		or standHit.Position.Y
			<= waterY - 0.20 then
		return nil
	end

	-- Face a point just INSIDE the water on the same near-side boundary.
	local waterDistance =
		math.min(
			distance,
			high + 0.85
		)

	local waterXZ =
		origin
		+ direction * waterDistance

	local exposedAtEdge =
		state.drinkMainWaterExposedAt(
			waterPart,
			waterXZ.X,
			waterXZ.Z,
			castY
		)

	if not exposedAtEdge then
		waterXZ =
			origin
			+ direction * high
	end

	local resolvedWater = Vector3.new(
		waterXZ.X,
		waterY,
		waterXZ.Z
	)

	-- MainWaterPart used to bypass the Dino cliff guard entirely. Validate both
	-- HEIGHT and the REAL collidable destination column. If a rock/mesh sits over
	-- the Terrain bank, reject this sample and let the scanner find a lower shore.
	if isDinoLife
		and not isAquaticCharacter(character) then
		if not state.dinoDrinkBankCandidateClear(
			character,
			standHit.Position,
			resolvedWater
		) then
			return nil
		end

		if state.dinoDrinkBankRejected(
			standHit.Position,
			resolvedWater
		) then
			return nil
		end
	end

	return standHit.Position,
		resolvedWater
end

state.dinoDrinkFastScan =
	state.dinoDrinkFastScan
	or {
		busy = false,
		character = nil,
		cacheSpot = nil,
		cacheOrigin = nil,
		cacheAt = 0,
		lastError = nil,
		lastErrorAt = 0,
		lastMissAt = 0,
		lastMissOrigin = nil,

		-- A selected Dino water source is a transaction, not a suggestion.
		-- Once selected, keep it until it succeeds, explicitly fails, or times out.
		lockedCharacter = nil,
		lockedSpot = nil,
		lockedAt = 0,
		lockedUntil = 0,
	}

function state.dinoDrinkFastSpotStillUsable(
	spot,
	origin,
	character
)
	if not spot
		or typeof(
			spot.water
		) ~= "Vector3"
		or typeof(
			spot.stand
		) ~= "Vector3"
		or not character
		or not origin then

		return false
	end

	if state.drinkAreaFailed(
		spot.water
	) then

		return false
	end

	local distance =
		Vector3.new(
			spot.water.X - origin.X,
			0,
			spot.water.Z - origin.Z
		).Magnitude

	return distance <= 460
end

function state.dinoDrinkFastSurfaceScan(
	origin,
	character,
	waterPart,
	considerWaterPoint,
	options
)
	if not isDinoLife
		or typeof(origin) ~= "Vector3"
		or not character then

		return nil
	end

	options =
		type(options) == "table"
			and options
			or {}

	local scan =
		state.dinoDrinkFastScan

	local now =
		tick()

	-- If the game already exposes Drink here, geometry has nothing left to prove.
	if state.drinkGamePromptAvailable(character)
		or state.drinkVisualPromptVisible() then

		return {
			water = origin,
			stand = origin,
			source = "CurrentDrinkContact",
			promptContact = true,
		}
	end

	-- Stable source lock. This is what prevents:
	-- river -> puddle -> spawn -> river -> puddle controller thrashing.
	if scan.lockedCharacter == character
		and now <= (scan.lockedUntil or 0)
		and state.dinoDrinkFastSpotStillUsable(
			scan.lockedSpot,
			origin,
			character
		) then

		return scan.lockedSpot
	end

	if scan.lockedCharacter ~= character
		or now > (scan.lockedUntil or 0)
		or not state.dinoDrinkFastSpotStillUsable(
			scan.lockedSpot,
			origin,
			character
		) then

		scan.lockedCharacter = nil
		scan.lockedSpot = nil
		scan.lockedAt = 0
		scan.lockedUntil = 0
	end

	if scan.character == character
		and now - (scan.cacheAt or 0) <= 2.0
		and typeof(scan.cacheOrigin) == "Vector3"
		and Vector3.new(
			origin.X - scan.cacheOrigin.X,
			0,
			origin.Z - scan.cacheOrigin.Z
		).Magnitude <= 30
		and state.dinoDrinkFastSpotStillUsable(
			scan.cacheSpot,
			origin,
			character
		) then

		return scan.cacheSpot
	end

	-- Failed local scans get a real cooldown. Do not burn the same 60-80 rays
	-- again every scheduler tick while Rex has not meaningfully moved.
	if scan.character == character
		and scan.lastMissAt
		and now - scan.lastMissAt <= 1.15
		and typeof(scan.lastMissOrigin) == "Vector3"
		and Vector3.new(
			origin.X - scan.lastMissOrigin.X,
			0,
			origin.Z - scan.lastMissOrigin.Z
		).Magnitude <= 12 then

		return nil
	end

	if scan.busy then
		return nil
	end

	scan.busy = true

	local ok,
		result =
			pcall(function()
				local root =
					character:FindFirstChild(
						"HumanoidRootPart"
					)

				if not root then
					return nil
				end

				local quick =
					options.dinoQuick == true
					or options.dinoTransitScan == true

				local params =
					RaycastParams.new()

				params.FilterType =
					Enum.RaycastFilterType.Include

				params.FilterDescendantsInstances = {
					workspace.Terrain,
				}

				params.IgnoreWater = false

				local waterTop =
					waterPart
					and waterPart:IsA("BasePart")
					and (
						waterPart.Position.Y
							+ waterPart.Size.Y * 0.5
					)
					or nil

				local castY =
					math.max(
						origin.Y + 180,
						waterTop
							and waterTop + 180
							or origin.Y + 180
					)

				local function sample(x, z)
					local hit =
						workspace:Raycast(
							Vector3.new(
								x,
								castY,
								z
							),
							Vector3.new(
								0,
								-520,
								0
							),
							params
						)

					if hit
						and hit.Material
							== Enum.Material.Water then

						return true,
							hit.Position,
							"Terrain",
							hit
					end

					-- MainWaterPart in Dino can be non-queryable. Infer exposed
					-- MainWater from the solid Terrain floor beneath its water top.
					if waterTop
						and state.drinkMainWaterContainsXZ(
							waterPart,
							x,
							z
						)
						and (
							not hit
							or hit.Position.Y
								<= waterTop - 0.35
						) then

						return true,
							Vector3.new(
								x,
								waterTop,
								z
							),
							"MainWaterPart",
							hit
					end

					return false,
						nil,
						nil,
						hit
				end

				local startWet,
					startWater,
					startSource =
						sample(
							origin.X,
							origin.Z
						)

				if startWet then
					return {
						water = startWater or origin,
						stand = origin,
						source = startSource or "CurrentWater",
						dinoDirectShore = true,
					}
				end

				local candidates = {}
				local candidateKeys = {}

				local function addCandidate(
					waterPoint,
					source
				)
					if typeof(waterPoint) ~= "Vector3" then
						return
					end

					if state.drinkAreaFailed(
						waterPoint
					) then
						return
					end

					local flatDistance =
						Vector3.new(
							waterPoint.X - origin.X,
							0,
							waterPoint.Z - origin.Z
						).Magnitude

					-- Candidate de-duplication on an 8-stud cell.
					local key =
						tostring(
							math.floor(
								waterPoint.X / 8
							)
						)
						.. ":"
						.. tostring(
							math.floor(
								waterPoint.Z / 8
							)
						)

					local previous =
						candidateKeys[key]

					if previous
						and previous.distance
							<= flatDistance then
						return
					end

					local candidate = {
						water = waterPoint,
						source = source or "Terrain",
						distance = flatDistance,
						open = 0,
						score = flatDistance,
					}

					candidateKeys[key] =
						candidate

					candidates[#candidates + 1] =
						candidate
				end

				-- ORIENTATION-INDEPENDENT LOCAL GRID.
				-- This is intentionally not tied to Rex's LookVector. A river on the
				-- left/right/back cannot hide between radial rays anymore.
				local coordinates =
					quick
						and {
							-36, -18, 0, 18, 36,
						}
						or {
							-54, -36, -18, 0, 18, 36, 54,
						}

				for _, dx in ipairs(coordinates) do
					for _, dz in ipairs(coordinates) do
						if dx ~= 0 or dz ~= 0 then
							local wet,
								waterPoint,
								source =
									sample(
										origin.X + dx,
										origin.Z + dz
									)

							if wet then
								addCandidate(
									waterPoint,
									source
								)
							end
						end
					end
				end

				-- One light outer ring extends the local detector without turning
				-- it back into a map-wide scanner.
				local outerRadius =
					quick and 58 or 78

				local outerSamples =
					quick and 8 or 12

				for index = 0, outerSamples - 1 do
					local angle =
						index
						/ outerSamples
						* math.pi
						* 2

					local wet,
						waterPoint,
						source =
							sample(
								origin.X
									+ math.cos(angle)
										* outerRadius,
								origin.Z
									+ math.sin(angle)
										* outerRadius
							)

					if wet then
						addCandidate(
							waterPoint,
							source
						)
					end
				end


				-- Savannah succeeds because it looks for exposed water around the animal
				-- before wandering to a spawn. Dino used to stop at ~78 studs, so an
				-- island shore/river 100-400 studs away was invisible and Rex walked to a
				-- distant Spawn Location instead. Add sparse expanding rings: bounded,
				-- orientation-independent and still dramatically cheaper than Savannah's
				-- dense 900-stud synchronous scanner.
				if #candidates == 0 then
					local extendedRadii =
						quick
						and { 110, 170, 240, 320, 400 }
						or { 105, 150, 205, 270, 340, 420 }

					local extendedSamples =
						quick and 12 or 16

					for _, radius in ipairs(extendedRadii) do
						for index = 0, extendedSamples - 1 do
							local angle =
								index / extendedSamples
								* math.pi * 2

							local wet, waterPoint, source =
								sample(
									origin.X + math.cos(angle) * radius,
									origin.Z + math.sin(angle) * radius
								)

							if wet then
								addCandidate(waterPoint, source)
							end
						end
					end
				end

				if #candidates == 0 then
					return nil
				end

				-- Nearest candidates first before doing any extra water-body test.
				table.sort(
					candidates,
					function(a, b)
						-- Strict nearest-first policy, matching Savannah's behavior.
						-- Source type and water-body size never outrank distance.
						return a.distance < b.distance
					end
				)

				-- Do not spend extra rays scoring "big river" versus "small puddle". The
				-- user-visible rule is simpler and more reliable: use the nearest exposed
				-- drinkable water. Water-body size is not a movement priority.

				local humanoid =
					character:FindFirstChildOfClass(
						"Humanoid"
					)

				local lift =
					humanoid
						and math.max(
							humanoid.HipHeight,
							1.5
						)
						or 2.5

				-- Validate only the best few candidates. Expensive rock geometry
				-- is NEVER evaluated for every wet grid point.
				for index = 1, math.min(
					#candidates,
					5
				) do
					local candidate =
						candidates[index]

					local flat =
						Vector3.new(
							candidate.water.X - origin.X,
							0,
							candidate.water.Z - origin.Z
						)

					if flat.Magnitude <= 0.5 then
						return {
							water = candidate.water,
							stand = origin,
							source = candidate.source,
							dinoDirectShore = true,
							dinoOpenWater = candidate.open,
						}
					end

					local direction =
						flat.Unit

					-- Find the FIRST dry -> wet transition from Rex toward this
					-- candidate. This prevents a sparse grid point from leaving Rex
					-- 10-20 studs back from the actual shoreline.
					local firstWetDistance
					local firstWetPoint
					local firstWetSource
					local lastDryDistance = 0
					local lastDryHit

					local marchStep =
						6

					local distance =
						marchStep

					while distance
						<= flat.Magnitude + 0.001 do

						local point =
							origin
								+ direction
									* math.min(
										distance,
										flat.Magnitude
									)

						local wet,
							waterPoint,
							source,
							hit =
								sample(
									point.X,
									point.Z
								)

						if wet then
							firstWetDistance =
								math.min(
									distance,
									flat.Magnitude
								)

							firstWetPoint =
								waterPoint

							firstWetSource =
								source

							break
						elseif hit
							and hit.Material
								~= Enum.Material.Water then

							lastDryDistance =
								math.min(
									distance,
									flat.Magnitude
								)

							lastDryHit =
								hit
						end

						distance +=
							marchStep
					end

					if not firstWetDistance then
						firstWetDistance =
							flat.Magnitude

						firstWetPoint =
							candidate.water

						firstWetSource =
							candidate.source
					end

					if not lastDryHit then
						local dryHit =
							workspace:Raycast(
								origin
									+ Vector3.new(
										0,
										80,
										0
									),
								Vector3.new(
									0,
									-180,
									0
								),
								params
							)

						if dryHit
							and dryHit.Material
								~= Enum.Material.Water then

							lastDryHit =
								dryHit
						end
					end

					if lastDryHit then
						local low =
							lastDryDistance

						local high =
							firstWetDistance

						local lowHit =
							lastDryHit

						local highWater =
							firstWetPoint
								or candidate.water

						local highSource =
							firstWetSource
								or candidate.source

						-- Only the selected candidate receives a precise shoreline
						-- refinement. Five rays are enough for sub-stud accuracy.
						for _ = 1, 5 do
							local mid =
								(low + high)
									* 0.5

							local point =
								origin
									+ direction
										* mid

							local wet,
								waterPoint,
								source,
								hit =
									sample(
										point.X,
										point.Z
									)

							if wet then
								high =
									mid

								highWater =
									waterPoint
										or highWater

								highSource =
									source
										or highSource

							elseif hit
								and hit.Material
									~= Enum.Material.Water then

								low =
									mid

								lowHit =
									hit
							else
								low =
									mid
							end
						end

						local bank =
							lowHit.Position

						local waterPoint =
							highWater
								or candidate.water

						local rise =
							bank.Y
								- waterPoint.Y

						local maxRise =
							state.isDinoRexMovementCharacter(
								character
							)
								and 8.5
								or 6.5

						if rise >= -2.5
							and rise <= maxRise then

							-- Savannah does not reject nearby water because a broad rock-cluster
							-- heuristic dislikes the shoreline. Dino now follows the same rule:
							-- acquire the nearest valid bank first; the cheap physical route rays
							-- handle only the obstacle actually in front of the animal.
							return {
								water = waterPoint,
								stand = bank + Vector3.new(0, lift, 0),
								source = highSource or candidate.source,
								dinoDirectShore = true,
							}
						end
					end
				end

				return nil
			end)

	scan.busy =
		false

	if not ok then
		scan.lastError =
			tostring(result)

		scan.lastErrorAt =
			tick()

		return nil
	end

	scan.character =
		character

	if result then
		scan.cacheSpot =
			result

		scan.cacheOrigin =
			origin

		scan.cacheAt =
			tick()

		scan.lastMissAt =
			0

		scan.lastMissOrigin =
			nil

		-- Lock only genuine selected water, not an incidental current prompt.
		if not result.promptContact then
			scan.lockedCharacter =
				character

			scan.lockedSpot =
				result

			scan.lockedAt =
				tick()

			scan.lockedUntil =
				tick() + 24
		end
	else
		scan.cacheSpot =
			nil

		scan.cacheAt =
			0

		scan.lastMissAt =
			tick()

		scan.lastMissOrigin =
			origin
	end

	return result
end

function state.drinkFindAccessibleSpot(origin, character, options)
	if not origin then return nil end

	state.drinkForgetExpiredFailures()

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	local isAquatic = isAquaticCharacter(character)
	local isCrocHippo =
		state.isCrocOrHippoMovementCharacter(
			character
		)
	local isCroc = CROC.isCharacter(character)
	local angleOffset = (player.UserId % 360) * math.pi / 180

	local function considerWaterPoint(waterPoint, source)
		if not waterPoint or state.drinkAreaFailed(waterPoint) then return nil end

		-- Crocodile AND Hippo stay on REAL Terrain at the bank for drinking.
		-- Only other aquatic animals keep the old water-surface behavior.
		if isAquatic and not isCrocHippo then
			return {
				water = waterPoint,
				stand = waterPoint + Vector3.new(0, state.aquaticWaterStandOffset(character), 0),
				source = source,
			}
		end

		local bank
		local finalWater = waterPoint

		if source == "MainWaterPart"
			and waterPart
			and waterPart:IsA("BasePart") then

			bank, finalWater =
				state.drinkFindMainWaterBank(
					waterPoint,
					origin,
					waterPart,
					character
				)
		else
			-- Puddles/Terrain Water keep the v92 behavior unchanged.
			bank =
				state.drinkFindBank(
					waterPoint
				)
		end

		if not bank then
			return nil
		end

		-- Never choose a Dino drinking lip buried in / surrounded by the individual
		-- MapAssets.Rocks envelopes. A nearby open river is always safer than a small
		-- puddle inside a rock pocket.
		if isDinoLife then
			local rockDanger = state.dinoWaterCandidateRockDanger(
				character,
				bank,
				finalWater or waterPoint
			)
			if rockDanger then
				return nil
			end
		end

		local _, _, humanoid = characterParts()
		local lift =
			humanoid
				and math.max(
					humanoid.HipHeight,
					1.5
				)
				or 2.5

		return {
			water = finalWater or waterPoint,
			stand = bank
				+ Vector3.new(
					0,
					lift,
					0
				),
			source = source,
		}
	end

	-- DINO LIFE FAST PATH:
	-- Surface Drink no longer executes Savannah's three giant synchronous ring
	-- scanners. The Dino sensor above uses the same exposed-water/bank validation
	-- but with nearest-first, one-ray probes and a hard work budget.
	if isDinoLife then
		return state.dinoDrinkFastSurfaceScan(
			origin,
			character,
			waterPart,
			considerWaterPoint,
			options
		)
	end


	-- Savannah nearby RIVER pass.
	-- MainWaterPart is used only as a sampling hint. Each candidate must pass
	-- solid-Terrain exposure validation AND near-side shoreline calculation.
	-- Dino uses this exact Savannah acquisition path; only considerWaterPoint()
	-- adds Rex/MapAssets.Rocks safety on top.
	if (isSavannahLife or isDinoLife)
		and waterPart
		and waterPart:IsA("BasePart") then

		for radius = 0, 300, 10 do
			local samples =
				radius == 0
					and 1
					or 24

			for index = 0, samples - 1 do
				local angle =
					angleOffset
					+ index / samples
						* math.pi * 2

				local x =
					origin.X
					+ math.cos(angle)
						* radius

				local z =
					origin.Z
					+ math.sin(angle)
						* radius

				local mainPoint =
					state.drinkMainWaterSurface(
						waterPart,
						x,
						z
					)

				if mainPoint then
					local found =
						considerWaterPoint(
							mainPoint,
							"MainWaterPart"
						)

					if found then
						return found
					end
				end
			end
		end
	end


	-- Savannah dense LOCAL exposed-water pass.
	-- Both games use the same proven 420-stud acquisition radius. Dino explores
	-- farther by MOVING between Spawn Locations instead of freezing to scan the map.
	local denseLocalWaterRadius = 420
	for radius = 0, denseLocalWaterRadius, 12 do
		local samples =
			radius == 0
				and 1
				or 32

		for index = 0, samples - 1 do
			local angle =
				angleOffset
					+ index / samples
						* math.pi * 2

			local x =
				origin.X
					+ math.cos(angle)
						* radius

			local z =
				origin.Z
					+ math.sin(angle)
						* radius

			local castY =
				math.max(
					origin.Y + 500,
					900
				)

			local terrainHit =
				workspace:Raycast(
					Vector3.new(
						x,
						castY,
						z
					),
					Vector3.new(
						0,
						-(castY + 350),
						0
					),
					terrainParams
				)

			if terrainHit
				and terrainHit.Material
					== Enum.Material.Water then

				local found =
					considerWaterPoint(
						terrainHit.Position,
						"Terrain"
					)

				if found then
					return found
				end
			end

			if waterPart
				and waterPart:IsA(
					"BasePart"
				) then

				local mainPoint =
					state.drinkMainWaterSurface(
						waterPart,
						x,
						z
					)

				if mainPoint then
					local found =
						considerWaterPoint(
							mainPoint,
							"MainWaterPart"
						)

					if found then
						return found
					end
				end
			end
		end
	end

	-- Savannah regular exposed-water scan.
	-- A terrain ray must hit Water as the FIRST terrain surface, so buried
	-- MainWaterPart is still rejected.
	local regularWaterRadius = 900
	local regularWaterStep = 30
	for radius = 0, regularWaterRadius, regularWaterStep do
		local samples = radius == 0 and 1 or (radius <= 360 and 16 or 20)

		for index = 0, samples - 1 do
			local angle = angleOffset + index / samples * math.pi * 2
			local x = origin.X + math.cos(angle) * radius
			local z = origin.Z + math.sin(angle) * radius

			local castY = math.max(origin.Y + 700, 1200)
			local terrainHit = workspace:Raycast(
				Vector3.new(x, castY, z),
				Vector3.new(0, -(castY + 500), 0),
				terrainParams
			)

			if terrainHit and terrainHit.Material == Enum.Material.Water then
				local found = considerWaterPoint(terrainHit.Position, "Terrain")
				if found then return found end
			end

			-- MainWaterPart fallback, but ONLY after checking that this X/Z
			-- actually belongs to the part and that Terrain is not covering it.
			if waterPart and waterPart:IsA("BasePart") then
				local mainPoint = state.drinkMainWaterSurface(waterPart, x, z)
				if mainPoint then
					local found = considerWaterPoint(mainPoint, "MainWaterPart")
					if found then return found end
				end
			end
		end
	end

	-- v125: far search is emergency-only for normal land animals.
	local currentWater =
		character
			and tonumber(
				character:GetAttribute(
					"Water"
				)
			)
			or 100

	local allowFarSurfaceSearch =
		isCroc
			or currentWater <= 45

	if allowFarSurfaceSearch then
		local farStart = 960
		local farFinish = 1500
		local farStep = 60
		for radius = farStart, farFinish, farStep do
			for index = 0, 15 do
				local angle =
					angleOffset
						+ index / 16
							* math.pi * 2

				local x =
					origin.X
						+ math.cos(angle)
							* radius

				local z =
					origin.Z
						+ math.sin(angle)
							* radius

				local castY =
					math.max(
						origin.Y + 700,
						1200
					)

				local terrainHit =
					workspace:Raycast(
						Vector3.new(
							x,
							castY,
							z
						),
						Vector3.new(
							0,
							-(castY + 500),
							0
						),
						terrainParams
					)

				if terrainHit
					and terrainHit.Material
						== Enum.Material.Water then

					local found =
						considerWaterPoint(
							terrainHit.Position,
							"Terrain"
						)

					if found then
						return found
					end
				end

				if waterPart
					and waterPart:IsA(
						"BasePart"
					) then

					local mainPoint =
						state.drinkMainWaterSurface(
							waterPart,
							x,
							z
						)

					if mainPoint then
						local found =
							considerWaterPoint(
								mainPoint,
								"MainWaterPart"
							)

						if found then
							return found
						end
					end
				end
			end
		end
	end
	-- Savannah fallback: use the known Swim water region if local scanning
	-- cannot find a usable source.
	if isSavannahLife
		and state.questSwimPosition
		and (
			state.questSwimActive
				or currentWater <= 35
		) then

		local center = state.questSwimPosition

		for radius = 0, 520, 20 do
			local samples = radius == 0 and 1 or 20
			for index = 0, samples - 1 do
				local angle = angleOffset + index / samples * math.pi * 2
				local x = center.X + math.cos(angle) * radius
				local z = center.Z + math.sin(angle) * radius

				local hit = workspace:Raycast(
					Vector3.new(x, 1200, z),
					Vector3.new(0, -2200, 0),
					terrainParams
				)

				if hit and hit.Material == Enum.Material.Water then
					local found = considerWaterPoint(hit.Position, "SavannahSafeWater")
					if found then return found end
				end
			end
		end
	end

end

function state.drinkAbandonCurrent(reason)
	state.drinkProgressReset()

	if isDinoLife
		and state.dinoDrinkFastScan then

		state.dinoDrinkFastScan.lockedCharacter = nil
		state.dinoDrinkFastScan.lockedSpot = nil
		state.dinoDrinkFastScan.lockedAt = 0
		state.dinoDrinkFastScan.lockedUntil = 0
		state.dinoDrinkFastScan.cacheSpot = nil
		state.dinoDrinkFastScan.cacheAt = 0
	end

	local point =
		state.drinkSearch.currentWaterPoint
		or drinkingSourcePosition
	if point then
		state.drinkMarkFailed(point, 150)
	end

	state.drinkSearch.currentWaterPoint = nil
	state.drinkSearch.promptStopAt = nil
	state.drinkSearch.promptStopTime = nil
	state.drinkSearch.failedCount = (state.drinkSearch.failedCount or 0) + 1
	state.drinkClearUndergroundMode()
	drinkingSourcePosition = nil
	drinkingStuckSince = nil
	lastDrinkWatchdogWater = nil
	removeSwimBarrier()

	runtimeMessage = reason or "Agua invalida; procurando outro local"

	-- After several failed sources, stop monopolizing the survival controller.
	-- This lets Auto Eat work while Auto Drink cools down, then water search
	-- resumes automatically a few seconds later.
	if state.drinkSearch.failedCount >= 3 then
		state.drinkSearch.failedCount = 0
		state.drinkSearch.retryAfter = tick() + 7
		drinkingToFull = false

		-- Actually release Water ownership. Previously the message said Food was
		-- released, but survivalArbiter.owner could remain "water" forever, so
		-- Auto Eat stayed blocked throughout (and after) the retry cooldown.
		if state.survivalArbiter
			and state.survivalArbiter.owner == "water" then
			state.survivalArbiterComplete("water")
		end

		runtimeMessage = "3 pontos de agua falharam; liberando comida e tentando agua de novo em 7s"
	end
end

local function grassIsAwayFromOtherPlayers(position, minimumDistance)
	minimumDistance = minimumDistance or 35
	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player then
			local otherCharacter = otherPlayer.Character
			local otherRoot = otherCharacter and otherCharacter:FindFirstChild("HumanoidRootPart")
			local otherHumanoid = otherCharacter and otherCharacter:FindFirstChildOfClass("Humanoid")
			if otherRoot and (not otherHumanoid or otherHumanoid.Health > 0) then
				local horizontalDistance = (Vector3.new(position.X, 0, position.Z)
					- Vector3.new(otherRoot.Position.X, 0, otherRoot.Position.Z)).Magnitude
				if horizontalDistance < minimumDistance then return false end
			end
		end
	end
	return true
end

local grassRetryIgnorePosition
local grassRetryIgnoreUntil = 0
local grassRetryIgnoreRadius = 7

local function grassCandidateTemporarilyIgnored(position)
	return grassRetryIgnorePosition ~= nil
		and tick() < grassRetryIgnoreUntil
		and (
			Vector3.new(
				position.X - grassRetryIgnorePosition.X,
				0,
				position.Z - grassRetryIgnorePosition.Z
			).Magnitude
				<= (
					grassRetryIgnoreRadius
						or 7
				)
		)
end

local function temporarilyIgnoreGrass(
	position,
	seconds,
	radius
)
	grassRetryIgnorePosition =
		position

	grassRetryIgnoreUntil =
		tick() + (seconds or 3)

	grassRetryIgnoreRadius =
		math.max(
			4,
			tonumber(radius) or 7
		)
end

function state.grassTerrainHitAt(
	position,
	castHeight
)
	if typeof(position) ~= "Vector3" then
		return nil
	end

	local height =
		tonumber(castHeight) or 70

	local hit =
		workspace:Raycast(
			Vector3.new(
				position.X,
				math.max(
					position.Y + height,
					height
				),
				position.Z
			),
			Vector3.new(
				0,
				-(height * 2.4),
				0
			),
			terrainParams
		)

	if hit
		and hit.Material
			== Enum.Material.Grass
		and hit.Normal.Y >= 0.42 then

		return hit
	end

	return nil
end

function state.grassCandidateVerified(
	origin,
	position
)
	if typeof(origin) ~= "Vector3"
		or typeof(position) ~= "Vector3" then

		return false,
			nil,
			0
	end

	if grassCandidateTemporarilyIgnored(
		position
	) then
		return false,
			nil,
			0
	end

	-- PrideRock is a MOVEMENT exclusion, never a reason to give up feeding.
	-- A grass point inside the model-wide forbidden circle is rejected here so
	-- the search automatically continues to another patch farther away.
	if state.movementPrideRockPointForbidden(
		position,
		player.Character,
		3
	) then
		return false,
			nil,
			0
	end

	if not state.autoFoodPositionAllowed(
		position
	) then
		return false,
			nil,
			0
	end

	local centerHit =
		state.grassTerrainHitAt(
			position,
			80
		)

	if not centerHit then
		return false,
			nil,
			0
	end

	-- Validate the PATCH around the point. One Grass voxel on the dirt/grass
	-- border is not enough to justify a route.
	local offsets = {
		Vector3.new(0, 0, 0),
		Vector3.new(3.5, 0, 0),
		Vector3.new(-3.5, 0, 0),
		Vector3.new(0, 0, 3.5),
		Vector3.new(0, 0, -3.5),
		Vector3.new(5.5, 0, 0),
		Vector3.new(-5.5, 0, 0),
		Vector3.new(0, 0, 5.5),
		Vector3.new(0, 0, -5.5),
	}

	local grassSamples = 0
	local accumulated =
		Vector3.zero

	for _, offset in ipairs(
		offsets
	) do
		local sampleHit =
			state.grassTerrainHitAt(
				centerHit.Position
					+ offset,
				70
			)

		if sampleHit then
			grassSamples += 1
			accumulated +=
				sampleHit.Position
		end
	end

	-- A real local feeding patch needs at least 5/9 Grass samples.
	if grassSamples < 5 then
		return false,
			nil,
			grassSamples
	end

	local verifiedCenter =
		accumulated
			/ grassSamples

	return true,
		verifiedCenter,
		grassSamples
end

local function findNearestGrass(origin)
	local rings = {
		{ 4, 20 },
		{ 7, 24 },
		{ 10, 24 },
		{ 14, 28 },
		{ 20, 28 },
		{ 28, 28 },
		{ 40, 32 },
		{ 56, 32 },
		{ 76, 32 },
		{ 96, 36 },
		{ 118, 36 },
	}

	local angleOffset =
		((player.UserId % 31) / 31)
			* (
				math.pi * 2 / 36
			)

	-- Rings are distance ordered. Within the first ring that contains usable
	-- grass, select the strongest patch instead of the first random ray hit.
	for _, ring in ipairs(rings) do
		local radius = ring[1]
		local samples = ring[2]

		local bestPoint
		local bestSamples = -1
		local bestDistance =
			math.huge

		for index = 0, samples - 1 do
			local angle =
				angleOffset
					+ index / samples
						* math.pi * 2

			local probe =
				origin
					+ Vector3.new(
						math.cos(angle)
							* radius,
						0,
						math.sin(angle)
							* radius
					)

			local valid,
				verifiedPoint,
				patchSamples =
					state.grassCandidateVerified(
						origin,
						probe
					)

			if valid and verifiedPoint then
				local distance =
					Vector3.new(
						verifiedPoint.X
							- origin.X,
						0,
						verifiedPoint.Z
							- origin.Z
					).Magnitude

				if patchSamples > bestSamples
					or (
						patchSamples == bestSamples
						and distance < bestDistance
					) then

					bestPoint =
						verifiedPoint

					bestSamples =
						patchSamples

					bestDistance =
						distance
				end
			end
		end

		if bestPoint then
			return bestPoint,
				bestDistance,
				bestSamples
		end
	end

	return nil
end

local function findDistantGrass(origin)
	local angleOffset =
		(player.UserId % 360)
			* math.pi / 180

	for _, radius in ipairs({
		150,
		190,
		240,
		300,
		370,
		450,
		540,
		650,
		780,
		900,
	}) do
		local bestPoint
		local bestSamples = -1
		local samples = radius <= 540 and 24 or 28

		for index = 0, samples - 1 do
			local angle =
				angleOffset
					+ index / samples
						* math.pi * 2

			local probe =
				origin
					+ Vector3.new(
						math.cos(angle)
							* radius,
						0,
						math.sin(angle)
							* radius
					)

			local valid,
				verifiedPoint,
				patchSamples =
					state.grassCandidateVerified(
						origin,
						probe
					)

			if valid
				and verifiedPoint
				and patchSamples > bestSamples then

				bestPoint =
					verifiedPoint

				bestSamples =
					patchSamples
			end
		end

		if bestPoint then
			return bestPoint
		end
	end

	return nil
end

local function moveToGrass(
	grassPosition,
	speedOverride
)
	local character,
		root =
		characterParts()

	if not character or not root then
		return false,
			"no_character"
	end

	local valid,
		verifiedPoint =
			state.grassCandidateVerified(
				root.Position,
				grassPosition
			)

	if not valid
		or not verifiedPoint then

		return false,
			"invalid_grass"
	end

	grassPosition =
		verifiedPoint

	local routeStart =
		root.Position

	local startDistance =
		Vector3.new(
			grassPosition.X
				- routeStart.X,
			0,
			grassPosition.Z
				- routeStart.Z
		).Magnitude

	-- A distant grass route is valid whenever the animal is genuinely hungry.
	-- PrideRock may invalidate all nearby patches, so limiting long routes to
	-- <=35% Food could literally leave a 40-50% herbivore standing still.
	local emergencyRoute =
		startDistance > 125

	if emergencyRoute
		and (
			tonumber(
				character:GetAttribute(
					"Food"
				)
			) or 100
		) >= 92 then

		return false,
			"too_far_not_hungry"
	end

	local lastTerrainCheckAt = 0

	local options = {
		purpose = "food",
		tolerance = 3.0,
		speedScale = 1,
		constantSpeed = true,

		maxDuration =
			math.clamp(
				startDistance
					/ math.max(
						state.safeMovementSpeed(
							character
						),
						8
					)
					* 3
					+ 7,
				8,
				emergencyRoute
					and 72
					or 28
			),

		routeCheckInterval = 0.07,

		routeCheck = function(
			liveCharacter,
			liveRoot
		)
			if not liveCharacter
				or not liveRoot then

				return true,
					"grass_character_lost"
			end

			-- Savannah itself is the final authority.
			if state.grassEatAvailable(
				liveCharacter
			) then
				return true,
					"grass_prompt"
			end

			local now =
				tick()

			if now - lastTerrainCheckAt
				>= 0.30 then

				lastTerrainCheckAt =
					now

				local stillValid =
					state.grassCandidateVerified(
						liveRoot.Position,
						grassPosition
					)

				if not stillValid then
					return true,
						"grass_invalid"
				end
			end

			local currentToTarget =
				Vector3.new(
					grassPosition.X
						- liveRoot.Position.X,
					0,
					grassPosition.Z
						- liveRoot.Position.Z
				).Magnitude

			local movedFromStart =
				Vector3.new(
					liveRoot.Position.X
						- routeStart.X,
					0,
					liveRoot.Position.Z
						- routeStart.Z
				).Magnitude

			-- Hard anti-tour guard. A 20-stud grass target may require a small
			-- obstacle detour; it may NOT turn into a 300-stud sightseeing trip.
			local maximumDetour =
				startDistance
					+ math.max(
						28,
						startDistance * 0.45
					)

			local maximumTravel =
				math.max(
					55,
					startDistance * 1.75
						+ 25
				)

			if currentToTarget
					> maximumDetour
				or movedFromStart
					> maximumTravel then

				return true,
					"grass_detour"
			end

			return false
		end,
	}

	if tonumber(speedOverride)
		and speedOverride > 0 then

		options.maxSpeed =
			speedOverride
	end

	local moved =
		safeMoveToPosition(
			grassPosition,
			8,
			grassPosition,
			options
		)

	local reason =
		state.safeMove.routeInterruptReason

	if reason == "grass_prompt" then
		return true,
			"prompt"
	end

	if reason == "grass_invalid"
		or reason == "grass_detour" then

		return false,
			reason
	end

	return moved,
		moved
			and "position"
			or (
				reason
					or "blocked"
			)
end

-- Savannah grass-search fallback. If a herbivore is standing on a large sand/rock
-- region with no verified Grass around it, do not leave it idle. Travel toward the
-- known Pride Rock farming area and keep scanning along the route. Any verified
-- Grass patch immediately interrupts the transit and becomes the new food target.
state.herbivoreFoodRecovery =
	state.herbivoreFoodRecovery
	or {
		active = false,
		token = 0,
		character = nil,
		reason = nil,
		startedAt = 0,
		attempt = 0,
		ownsCriticalLock = false,

		requested = false,
		requestReason = nil,

		lastCharacter = nil,
		lastFood = nil,
		lastPosition = nil,
		lastProgressAt = 0,
		stuckSince = 0,

		-- v5.1: a Pride transit is still the SAME Food transaction even when its
		-- current path must be rebuilt. Never let Supervisor convert one blocked
		-- route into generic AutoEat outside Pride. Alternate the preferred bypass
		-- side on each physical replan instead.
		replanCount = 0,
		replanSign = nil,
		lastReplanAt = 0,
		lastReplanReason = nil,

		-- After reaching Pride, temporarily allow nearby Pride food even if a
		-- stale Zone/Growth restriction has not finished releasing yet.
		foodOverrideUntil = 0,
	}

function state.herbivoreFoodRecoveryEatWanted()
	if state.autoEat then
		return true
	end

	-- Croc/Hippo water Fly temporarily turns the EFFECTIVE toggle off.
	-- That must never be interpreted as the user/automation disabling survival.
	if state.aquaticRiverEscape
		and state.aquaticRiverEscape.survivalSuspended
		and state.autoEatManualDisabled ~= true then

		return true
	end

	-- Once this watchdog owns recovery, keep it alive even if another temporary
	-- controller changes an effective Survival toggle.
	if state.herbivoreFoodRecovery
		and state.herbivoreFoodRecovery.active then

		return true
	end

	return false
end

function state.requestHerbivoreFoodRecovery(reason)
	local recovery =
		state.herbivoreFoodRecovery

	if not recovery then
		return
	end

	recovery.requested = true
	recovery.requestReason =
		reason or "food_search_failed"
end

function state.herbivoreFoodRecoveryTarget()
	if not isSavannahLife then
		return nil
	end

	-- Same physical Pride home already used by Growth / reset staging.
	if state.growthPride
		and typeof(
			state.growthPride.home
		) == "Vector3" then

		return state.growthPride.home
	end

	local spawns =
		workspace:FindFirstChild(
			"Spawns"
		)

	local pride =
		spawns
			and spawns:FindFirstChild(
				"PrideRockSpawn1",
				true
			)

	if pride
		and pride:IsA(
			"BasePart"
		) then

		return pride.Position
	end

	return nil
end

function state.herbivoreFoodRecoveryOwns(character)
	local recovery =
		state.herbivoreFoodRecovery

	return recovery
		and recovery.active == true
		and recovery.character == character
end

function state.herbivoreFoodRecoveryPrideFoodAllowed(position)
	local recovery =
		state.herbivoreFoodRecovery

	if not recovery
		or typeof(position) ~= "Vector3" then

		return false
	end

	if not recovery.active
		and tick()
			>= (
				recovery.foodOverrideUntil
					or 0
			) then

		return false
	end

	local pride =
		state.herbivoreFoodRecoveryTarget()

	if typeof(pride) ~= "Vector3" then
		return false
	end

	-- Only override stale food restrictions around the known Pride feeding area.
	return Vector3.new(
		position.X - pride.X,
		0,
		position.Z - pride.Z
	).Magnitude <= 260
end

state.grassPrideSearch = state.grassPrideSearch or {
	active = false,
	found = nil,
	prompt = false,
	lastNearScanAt = 0,
	lastFarScanAt = 0,
	retryAt = 0,
}

function state.grassSearchTowardPride(foodTarget)
	if not isSavannahLife or not state.autoEat then
		return false, "unsupported"
	end

	local character, root = characterParts()
	if not character or not root then
		return false, "no_character"
	end

	if isCarnivoreCharacter(character) then
		return false, "not_grass_eater"
	end

	local search = state.grassPrideSearch
	if search.active then
		return false, "already_searching"
	end

	if tick() < (search.retryAt or 0) then
		return false, "cooldown"
	end

	local destination =
		state.growthPride
		and state.growthPride.home
		or nil

	if typeof(destination) ~= "Vector3" then
		local spawns = workspace:FindFirstChild("Spawns")
		local prideSpawn = spawns and spawns:FindFirstChild("PrideRockSpawn1", true)
		if prideSpawn and prideSpawn:IsA("BasePart") then
			destination = prideSpawn.Position
		end
	end

	if typeof(destination) ~= "Vector3" then
		search.retryAt = tick() + 4
		return false, "no_pride_target"
	end

	-- ZoneTime/local feeding restrictions still win. This fallback is not allowed
	-- to drag an animal out of a quest-owned feeding area.
	if state.autoFoodPositionAllowed
		and not state.autoFoodPositionAllowed(destination) then

		local liveFood =
			tonumber(
				character:GetAttribute(
					"Food"
				)
			) or 100

		-- This is exactly the deadlock reported with Hippo:
		-- "no grass in allowed area" can never be allowed to leave a starving
		-- herbivore parked in water/terrain. Ask the central watchdog to override
		-- stale movement policy and take the animal to Pride Rock.
		if liveFood <= 82
			and state.requestHerbivoreFoodRecovery then

			state.requestHerbivoreFoodRecovery(
				"grass_search_blocked_by_food_area"
			)
		end

		search.retryAt = tick() + 1
		return false, "food_area_restricted"
	end

	local targetFood = tonumber(foodTarget) or 92
	local foundGrass = nil
	local promptFound = false

	search.active = true
	search.found = nil
	search.prompt = false
	search.lastNearScanAt = 0
	search.lastFarScanAt = 0

	runtimeMessage =
		"Sem grama valida por perto; procurando em direcao ao Pride Rock"

	local moved = safeMoveToPosition(
		destination,
		8,
		nil,
		{
			purpose = "food",
			tolerance = 22,
			speedScale = 1,
			constantSpeed = true,
			maxDuration = 360,
			routeCheckInterval = 0.25,
			routeCheck = function(liveCharacter, liveRoot)
				if not state.autoEat
					or not liveCharacter
					or not liveRoot
					or isCarnivoreCharacter(liveCharacter)
					or state.questGrowthReset.exclusive
					or criticalRecoveryActive then
					return true, "grass_search_interrupted"
				end

				local liveFood =
					tonumber(liveCharacter:GetAttribute("Food")) or 100

				if liveFood >= targetFood then
					return true, "fed"
				end

				if state.autoDrink
					and state.survivalArbiter
					and state.survivalArbiter.owner == "water" then
					return true, "water_priority"
				end

				-- The game's own Eat availability is authoritative. If the route crosses
				-- usable grass, stop immediately instead of continuing toward Pride Rock.
				if state.grassEatAvailable(liveCharacter) then
					foundGrass = liveRoot.Position
					promptFound = true
					return true, "grass_prompt"
				end

				local now = tick()

				-- Frequent local scan while moving. Sand is cheap here because invalid
				-- probes fail on the first Terrain ray before patch validation.
				if now - (search.lastNearScanAt or 0) >= 0.85 then
					search.lastNearScanAt = now
					local nearGrass = findNearestGrass(liveRoot.Position)
					if nearGrass then
						foundGrass = nearGrass
						return true, "grass_found"
					end
				end

				-- Wider scan is deliberately slower; it now reaches 900 studs and is
				-- only used periodically so the watchdog does not become a lag source.
				if now - (search.lastFarScanAt or 0) >= 3.5 then
					search.lastFarScanAt = now
					local farGrass = findDistantGrass(liveRoot.Position)
					if farGrass then
						foundGrass = farGrass
						return true, "grass_found"
					end
				end

				return false
			end,
		}
	)

	local reason = state.safeMove.routeInterruptReason
	search.active = false
	search.found = foundGrass
	search.prompt = promptFound

	character, root = characterParts()
	if not character or not root then
		search.retryAt = tick() + 2
		return false, "no_character"
	end

	if reason == "fed" then
		search.retryAt = 0
		return true, "fed", foundGrass
	end

	if reason == "water_priority" then
		search.retryAt = tick() + 1
		return false, "water_priority"
	end

	if promptFound and state.grassEatAvailable(character) then
		search.retryAt = 0
		runtimeMessage =
			"Grama encontrada durante a busca; parando rota para comer"
		return true, "prompt", foundGrass or root.Position
	end

	if foundGrass then
		runtimeMessage =
			"Grama encontrada durante a rota; desviando para comer"

		local grassMoved, grassReason =
			moveToGrass(foundGrass)

		if grassMoved then
			search.retryAt = 0
			return true, grassReason or "grass_found", foundGrass
		end

		search.retryAt = tick() + 1.5
		return false, grassReason or "grass_move_failed"
	end

	-- If the Pride route itself completed, scan once more from the new position.
	-- Usually this immediately sees the known grass-rich farming area.
	if moved then
		local finalGrass =
			findNearestGrass(root.Position)
			or findDistantGrass(root.Position)

		if finalGrass then
			local grassMoved, grassReason =
				moveToGrass(finalGrass)

			if grassMoved then
				search.retryAt = 0
				return true, grassReason or "grass_at_pride", finalGrass
			end
		end
	end

	search.retryAt = tick() + 3
	return false, reason or (moved and "pride_reached_no_grass" or "route_failed")
end

local ignoredCarcasses = {} -- [carcaça] = tick() em que o bloqueio expira

local function ignoreCarcass(carcass, seconds)
	if not carcass then return end
	ignoredCarcasses[carcass] = tick() + (seconds or 120)
end

local function carcassIsIgnored(carcass)
	local expiresAt = ignoredCarcasses[carcass]
	if not expiresAt then return false end
	if tick() >= expiresAt then
		ignoredCarcasses[carcass] = nil
		return false
	end
	return true
end

-- Carcasses on/inside Pride Rock are intentionally unreachable for normal
-- ground carnivore routing. Treat them as invalid BEFORE selecting or locking
-- them so a hungry animal never runs back and forth around the protected rock.
function state.carcassPrideRockForbidden(carcass, carcassPart, character)
	-- Savannah: PrideRock. Dino Life: every individual collidable rock under
	-- workspace.MapAssets.Rocks. The same movement exclusion used by routing is
	-- reused here so a carcass can never lure a carnivore into any protected rock.
	if not (isSavannahLife or isDinoLife) then return false end

	character = character or player.Character

	-- This exclusion is specifically for carnivore carcass routing. Baboon keeps
	-- its independent food policy unchanged.
	if character and not isCarnivoreCharacter(character) then
		return false
	end

	local part = carcassPart
	if (not part or not part.Parent) and carcass and carcass.Parent then
		part = carcass:FindFirstChild("HumanoidRootPart")
			or carcass:FindFirstChildWhichIsA("BasePart", true)
	end

	if not part then return false end

	-- Use the same protection circle as movement, with a small extra margin so
	-- large carcasses sitting on the rim cannot lure the animal into the rock.
	if state.movementPrideRockPointForbidden(
		part.Position,
		character,
		6
	) then
		return true
	end

	-- A large Elephant/Hippo carcass can have its interaction root just outside
	-- while most of the body is still over Pride Rock. Check the model center too.
	if carcass and carcass:IsA("Model") then
		local ok, cf = pcall(carcass.GetBoundingBox, carcass)
		if ok and cf and state.movementPrideRockPointForbidden(
			cf.Position,
			character,
			6
		) then
			return true
		end
	end

	return false
end

local function isPositionUnderwater(position)
	-- Raycasta de cima pra baixo no ponto exato E em 4 pontos ao redor
	-- (pega carcaça na beiradinha da água, não só afundada).
	local offsets = {
		Vector3.new(0, 0, 0),
		Vector3.new(6, 0, 0), Vector3.new(-6, 0, 0),
		Vector3.new(0, 0, 6), Vector3.new(0, 0, -6),
	}
	for _, offset in ipairs(offsets) do
		local hit = workspace:Raycast(position + offset + Vector3.new(0, 12, 0), Vector3.new(0, -24, 0), terrainParams)
		if hit and hit.Material == Enum.Material.Water then return true end
	end
	return false
end

-- A carcass is not classified from HumanoidRootPart alone. Large/ragdolled
-- carcasses can leave that root on the bank/above the surface while the visible
-- body and actual Eat area are floating in Terrain water. Sample the carcass
-- footprint instead. A shoreline carcass remains valid when enough of its body
-- is supported by dry Terrain; a body whose sampled footprint is predominantly
-- water is never a valid carnivore target.
function state.carcassCanonicalTarget(carcass, fallbackPart)
	if not carcass then return nil, fallbackPart end

	local candidate = fallbackPart or carcass
	local canonical = carcass

	if state.movementCarcassModelForInstance then
		local ok, resolved = pcall(
			state.movementCarcassModelForInstance,
			candidate
		)
		if ok and resolved and resolved.Parent then
			local storage = workspace:FindFirstChild("CarcassesStorageModel")
			if resolved ~= storage then
				canonical = resolved
			end
		end
	end

	local part = fallbackPart
	if canonical and canonical.Parent then
		if canonical:IsA("BasePart") then
			part = canonical
		elseif canonical:IsA("Model") then
			part = canonical:FindFirstChild("HumanoidRootPart", true)
				or canonical.PrimaryPart
				or canonical:FindFirstChildWhichIsA("BasePart", true)
		end
	end

	return canonical, part
end

function state.carcassCandidateHasPhysicalBody(
	carcass,
	fallbackPart
)
	if not carcass
		or not carcass.Parent then

		return false
	end

	carcass, fallbackPart =
		state.carcassCanonicalTarget(
			carcass,
			fallbackPart
		)

	if not carcass
		or not carcass.Parent then

		return false
	end

	local visibleParts = 0
	local meaningfulVolume = 0

	local function inspect(part)
		if not part
			or not part:IsA("BasePart")
			or not part.Parent
			or part.Transparency >= 0.98 then

			return
		end

		local size =
			part.Size

		local volume =
			math.max(
				0,
				size.X
					* size.Y
					* size.Z
			)

		if volume < 0.08 then
			return
		end

		visibleParts += 1
		meaningfulVolume += volume
	end

	if carcass:IsA("BasePart") then
		inspect(carcass)
	elseif carcass:IsA("Model") then
		for _, object in ipairs(
			carcass:GetDescendants()
		) do
			if object:IsA("BasePart") then
				inspect(object)

				if visibleParts >= 3
					and meaningfulVolume >= 0.35 then

					break
				end
			end
		end
	end

	-- Fallback/root alone is not enough if it is fully invisible. This is the
	-- important protection against storage/template/dummy models.
	if visibleParts == 0
		and fallbackPart
		and fallbackPart.Parent then

		inspect(fallbackPart)
	end

	return visibleParts >= 1
		and meaningfulVolume >= 0.08
end

function state.carcassCandidateUsable(
	carcass,
	fallbackPart,
	character
)
	carcass, fallbackPart =
		state.carcassCanonicalTarget(
			carcass,
			fallbackPart
		)

	if not carcass
		or not fallbackPart
		or not carcass.Parent
		or not fallbackPart.Parent then

		return false
	end

	if not state.carcassCandidateHasPhysicalBody(
		carcass,
		fallbackPart
	) then

		return false
	end

	if state.carcassPrideRockForbidden(
		carcass,
		fallbackPart,
		character
	) then

		return false
	end

	if state.carcassWaterUnsafe(
		carcass,
		fallbackPart
	) then

		return false
	end

	return true
end

-- Authoritative submerged-carcass test.
-- IMPORTANT: normalize nested rigs (Female/body/etc.) to the real top-level
-- carcass first. Then inspect actual visible body parts against the real water
-- surface. This catches a fully submerged Elephant even when a nested HRP or a
-- bounding-box corner happens to project onto dry Terrain.
function state.carcassWaterUnsafe(carcass, fallbackPart)
	if not carcass or not carcass.Parent then return false end

	carcass, fallbackPart = state.carcassCanonicalTarget(
		carcass,
		fallbackPart
	)
	if not carcass or not carcass.Parent then return false end

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	local waterColumns = 0
	local dryColumns = 0
	local centerBelow = 0
	local fullyBelow = 0
	local sampledParts = 0
	local aboveWaterParts = 0

	local function waterSurfaceAt(position, castTopY)
		if typeof(position) ~= "Vector3" then return nil end

		local topY = math.max(
			tonumber(castTopY) or (position.Y + 24),
			position.Y + 24
		)

		-- Terrain Water is the primary/authoritative Savannah river test.
		local hit = workspace:Raycast(
			Vector3.new(position.X, topY, position.Z),
			Vector3.new(0, -math.max(120, topY - position.Y + 90), 0),
			terrainParams
		)

		if hit and hit.Material == Enum.Material.Water then
			return hit.Position.Y
		end

		-- Some exposed-water layouts rely on MainWaterPart. Only accept it when
		-- the existing exposed-water verifier proves solid Terrain is below it;
		-- never use the giant buried X/Z footprint by itself.
		if waterPart
			and waterPart:IsA("BasePart")
			and state.drinkMainWaterExposedAt then
			local ok, exposed = pcall(
				state.drinkMainWaterExposedAt,
				waterPart,
				position.X,
				position.Z,
				topY
			)
			if ok and exposed then
				return waterPart.Position.Y + waterPart.Size.Y * 0.5
			end
		end

		return nil
	end

	local function inspectPart(part)
		if not part
			or not part:IsA("BasePart")
			or not part.Parent
			or part.Transparency >= 0.98 then
			return
		end

		local size = part.Size
		local volume = math.max(0.01, size.X * size.Y * size.Z)
		if volume < 0.08 then return end

		local center = part.Position
		local approximateHalfHeight = math.max(0.35, size.Y * 0.5)
		local topOfBody = center.Y + approximateHalfHeight
		local waterY = waterSurfaceAt(center, topOfBody + 35)

		sampledParts += 1
		if type(waterY) == "number" then
			waterColumns += 1

			if center.Y <= waterY + 0.15 then
				centerBelow += 1
			else
				aboveWaterParts += 1
			end

			if topOfBody <= waterY + 0.45 then
				fullyBelow += 1
			end
		else
			dryColumns += 1
			aboveWaterParts += 1
		end
	end

	-- Inspect the largest visible body pieces first. This avoids tiny rig helpers,
	-- attachments and decorative hitboxes dominating the decision.
	local parts = {}
	if carcass:IsA("BasePart") then
		parts[1] = carcass
	elseif carcass:IsA("Model") then
		for _, object in ipairs(carcass:GetDescendants()) do
			if object:IsA("BasePart") and object.Transparency < 0.98 then
				parts[#parts + 1] = object
			end
		end

		table.sort(parts, function(a, b)
			local as = a.Size
			local bs = b.Size
			return as.X * as.Y * as.Z > bs.X * bs.Y * bs.Z
		end)
	end

	for index = 1, math.min(#parts, 32) do
		inspectPart(parts[index])
	end

	-- Always inspect the interaction/root part too, even if it was not one of the
	-- 32 largest pieces.
	if fallbackPart and fallbackPart.Parent then
		inspectPart(fallbackPart)
	end

	-- Model-level proof: if the TOP of the entire carcass is still below exposed
	-- water at several footprint points, the whole body is unquestionably submerged.
	local bboxWater = 0
	local bboxDry = 0
	if carcass:IsA("Model") then
		local ok, cf, size = pcall(carcass.GetBoundingBox, carcass)
		if ok and typeof(cf) == "CFrame" and typeof(size) == "Vector3" then
			local sx = math.max(1.5, size.X * 0.30)
			local sz = math.max(1.5, size.Z * 0.30)
			local bodyTopY = cf.Position.Y + size.Y * 0.5

			for _, offset in ipairs({
				Vector3.new(0, 0, 0),
				Vector3.new(sx, 0, 0),
				Vector3.new(-sx, 0, 0),
				Vector3.new(0, 0, sz),
				Vector3.new(0, 0, -sz),
			}) do
				local world = cf:PointToWorldSpace(offset)
				local waterY = waterSurfaceAt(world, bodyTopY + 40)
				if type(waterY) == "number" then
					if bodyTopY <= waterY + 0.65 then
						bboxWater += 1
					else
						bboxDry += 1
					end
				else
					bboxDry += 1
				end
			end
		end
	end

	-- Strong whole-model proof.
	if bboxWater >= 3 and bboxWater > bboxDry then
		return true
	end

	-- Strong body-part proof. A carcass with most major pieces centered below the
	-- surface is not a shoreline carcass; it is a submerged carcass.
	if sampledParts >= 3 then
		if fullyBelow >= 2
			and fullyBelow >= math.max(2, math.floor(sampledParts * 0.35)) then
			return true
		end

		if centerBelow >= 3
			and centerBelow > aboveWaterParts then
			return true
		end
	end

	-- Final fallback for small/unusual carcasses.
	if sampledParts <= 2 and fallbackPart and fallbackPart.Parent then
		local waterY = waterSurfaceAt(
			fallbackPart.Position,
			fallbackPart.Position.Y + 35
		)
		if type(waterY) == "number"
			and fallbackPart.Position.Y <= waterY + 0.15 then
			return true
		end
	end

	return false
end

local function detectAvailableFood(character)
	if not GameUtils or not AnimalConfig or not character:FindFirstChild("Head") then return nil end
	local animalType = character:GetAttribute("AnimalType")
	local animalName = character:GetAttribute("AnimalName")
	local configForAnimal = animalType and animalName and AnimalConfig[animalType] and AnimalConfig[animalType][animalName]
	if not configForAnimal then return nil end
	local ok, result = pcall(GameUtils.CanEatDrink.DetectMeatGrassWater, character, configForAnimal)
	return ok and result or nil
end

function state.drinkAcquirePromptAfterMove(
	spot,
	character,
	root,
	humanoid,
	waterBefore,
	timeoutSeconds
)
	if not spot
		or not character
		or not root
		or not humanoid then

		return false,
			root
	end

	local previousBusy =
		state.busy

	state.busy = true

	-- Navigation has already delivered us to the shoreline candidate. From this
	-- point the GAME'S real Drink detector is the finish line, not an arbitrary
	-- root-to-bank distance. Cancel the old route and own one smooth final approach.
	state.releaseMovementNow(
		character,
		true
	)

	if state.questSetW then
		pcall(
			state.questSetW,
			false
		)
	end

	local isCroc = CROC.isCharacter(character)
	local isAquatic = isAquaticCharacter(character)
	local landContactApproach =
		not isCroc
		and not isAquatic
		and typeof(spot.water) == "Vector3"

	local baseDirection

	if spot.water then
		local face =
			Vector3.new(
				spot.water.X
					- root.Position.X,
				0,
				spot.water.Z
					- root.Position.Z
			)

		if face.Magnitude > 0.20 then
			baseDirection = face.Unit
		end
	end

	if not baseDirection then
		local look = root.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		if flatLook.Magnitude > 0.05 then
			baseDirection = flatLook.Unit
		end
	end

	local sweepAngles = isCroc
		and { 0, 6, -6, 12, -12, 18, -18, 25, -25, 32, -32 }
		or { 0 }
	local sweepIndex = 1

	local function applyFacing(angle)
		if not root or not root.Parent or not baseDirection then
			return
		end

		local rotated =
			CFrame.Angles(
				0,
				math.rad(angle or 0),
				0
			):VectorToWorldSpace(
				baseDirection
			)

		local flat = Vector3.new(rotated.X, 0, rotated.Z)
		if flat.Magnitude <= 0.05 then return end

		pcall(function()
			root.CFrame =
				CFrame.lookAt(
					root.Position,
					root.Position + flat.Unit,
					Vector3.yAxis
				)
		end)

		root.AssemblyAngularVelocity = Vector3.zero
	end

	applyFacing(0)

	local promptLatched =
		state.drinkSearch.promptStopAt
			and state.drinkSearch.promptStopTime
			and tick()
				- state.drinkSearch.promptStopTime
					<= 1.0
			and (
				Vector3.new(
					root.Position.X
						- state.drinkSearch.promptStopAt.X,
					0,
					root.Position.Z
						- state.drinkSearch.promptStopAt.Z
				).Magnitude <= 8
			)

	-- vDRINK-CONTACT: land animals do not stop and stare at the water anymore.
	-- Large rigs (Rex/Giraffe/Elephant/etc.) can have the HRP at the bank while the
	-- actual mouth/head is still outside the interaction volume. Continue FORWARD,
	-- smoothly, until the game itself says Drink or Water starts increasing.
	local approachStart = root.Position
	local footprint = math.max(1, state.movementFootprint(character))
	local bodySize = state.movementBodySize(character)
	local bodyHeight = bodySize and bodySize.Y or 6
	local head = character:FindFirstChild("Head")
	local headAboveWater = 0

	if head
		and head:IsA("BasePart")
		and typeof(spot.water) == "Vector3" then
		headAboveWater = math.max(0, head.Position.Y - spot.water.Y)
	end

	local waterGap = 0
	if typeof(spot.water) == "Vector3" then
		waterGap = Vector3.new(
			spot.water.X - root.Position.X,
			0,
			spot.water.Z - root.Position.Z
		).Magnitude
	end

	local ingressDepth = math.clamp(
		footprint * (isDinoLife and 0.50 or 0.38)
			+ bodyHeight * 0.08
			+ headAboveWater * 0.22
			+ 1.5,
		isDinoLife and 4.0 or 3.0,
		isDinoLife and 14.0 or 10.0
	)

	local maxCreepDistance = math.clamp(
		waterGap + ingressDepth + 2.5,
		isDinoLife and 8.0 or 6.0,
		isDinoLife and 24.0 or 18.0
	)

	local terminalTarget
	if landContactApproach and baseDirection then
		terminalTarget = Vector3.new(
			spot.water.X + baseDirection.X * ingressDepth,
			root.Position.Y,
			spot.water.Z + baseDirection.Z * ingressDepth
		)
	end

	local creepSpeed = math.clamp(
		state.safeMovementSpeed(character) * 0.22,
		5.5,
		isDinoLife and 12.0 or 10.0
	)

	local minimumHandshake = isCroc and 2.8 or 2.4
	local contactWindow = landContactApproach
		and math.clamp(maxCreepDistance / math.max(creepSpeed, 1) * 2.4 + 1.0, 3.5, 8.0)
		or minimumHandshake
	local deadline = tick() + math.max(tonumber(timeoutSeconds) or 0, contactWindow)

	local acquired = false
	local lastProgressPosition = root.Position
	local lastMotionAt = tick()
	local terminalOwnerToken = state.safeMove and state.safeMove.cancelToken or tick()

	if landContactApproach then
		runtimeMessage = isDinoLife
			and "Dino Drink: smooth final approach until Drink starts"
			or "Drink: smooth final approach until interaction starts"
	end

	repeat
		character,
			root,
			humanoid =
				characterParts()

		if not character
			or not root
			or not humanoid then

			break
		end

		local currentWater =
			tonumber(
				character:GetAttribute(
					"Water"
				)
			) or waterBefore or 0

		if currentWater
			> (
				tonumber(
					waterBefore
				) or currentWater
			) + 0.01 then

			state.drinkProgressConfirm(
				currentWater
			)

			acquired = true
			break
		end

		local gamePrompt =
			detectAvailableFood(
				character
			) == "Drink"
				or (
					state.drinkGamePromptAvailable
						and state.drinkGamePromptAvailable(
							character
						)
				)

		local visualPrompt =
			state.drinkVisualPromptVisible
			and state.drinkVisualPromptVisible()

		if gamePrompt
			or visualPrompt
			or promptLatched then

			if visualPrompt then
				state.drinkLatchVisualPrompt()
			end

			drinkingSourcePosition =
				root.Position

			blockClientSubState = false
			setSubState(
				"Drinking"
			)
			blockClientSubState = false

			acquired = true
			break
		end

		if landContactApproach and terminalTarget and baseDirection then
			-- Do not creep into one of the protected Dino rock envelopes. If the next
			-- couple studs are blocked, abandon this source immediately; the normal
			-- water selector will choose another bank and the rock-trap watchdog remains
			-- available if the dinosaur is already inside a pocket.
			local remainingVector = Vector3.new(
				terminalTarget.X - root.Position.X,
				0,
				terminalTarget.Z - root.Position.Z
			)
			local remaining = remainingVector.Magnitude

			local travelled = Vector3.new(
				root.Position.X - approachStart.X,
				0,
				root.Position.Z - approachStart.Z
			).Magnitude

			if isDinoLife then
				local trapped = state.dinoRockTrapMetrics(character, root.Position)
				if trapped then
					pcall(
						state.dinoWaterRockEscapeWatch,
						character,
						root,
						humanoid,
						currentWater
					)
					break
				end

				if remaining > 0.30 then
					local stepDistance = math.min(remaining, math.max(2.0, footprint * 0.20))
					local probePoint = root.Position + remainingVector.Unit * stepDistance
					local forbidden = state.movementDinoRockPointForbidden(
						probePoint,
						character,
						0.5
					)
					if forbidden then
						break
					end
				end
			end

			if travelled >= maxCreepDistance
				or remaining <= 0.55 then
				break
			end

			local direction = remainingVector.Unit
			baseDirection = direction

			state.heavyWalkStep(
				character,
				root,
				humanoid,
				direction,
				creepSpeed,
				remaining,
				terminalTarget,
				"safeMove",
				terminalOwnerToken
			)

			local movedSinceCheck = Vector3.new(
				root.Position.X - lastProgressPosition.X,
				0,
				root.Position.Z - lastProgressPosition.Z
			).Magnitude

			if movedSinceCheck >= 0.65 then
				lastProgressPosition = root.Position
				lastMotionAt = tick()
			elseif tick() - lastMotionAt >= 1.25 then
				-- No stationary 2-3 second wait: if the final contact move itself is
				-- physically stuck, fail fast and let water selection/recovery replan.
				if isDinoLife then
					pcall(
						state.dinoWaterRockEscapeWatch,
						character,
						root,
						humanoid,
						currentWater
					)
				end
				break
			end
		elseif isCroc then
			-- Croc remains position-sensitive; keep the proven angle sweep.
			sweepIndex += 1
			if sweepIndex > #sweepAngles then
				sweepIndex = 2
			end

			applyFacing(
				sweepAngles[sweepIndex]
			)

			blockClientSubState = false
			setSubState("Drinking")
			blockClientSubState = false
		end

		task.wait(isCroc and 0.12 or 0.08)
	until tick() >= deadline

	if state.heavyWalk and state.heavyWalk.character == character then
		pcall(
			state.heavyWalkStop,
			character
		)
	end

	if root and root.Parent then
		local velocity = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
		root.AssemblyAngularVelocity = Vector3.zero
	end

	state.busy =
		previousBusy == true

	return acquired,
		root
end

function state.waitForGrassEatPrompt(
	character,
	timeout
)
	local deadline =
		tick() + (timeout or 0.45)

	while state.alive
		and tick() <= deadline do

		if character ~= player.Character
			or not character
			or not character.Parent then

			return false
		end

		-- Savannah's visible E prompt is authoritative too. Some animals (notably
		-- flyers such as YellowHornbill) can expose a valid Eat prompt while
		-- DetectMeatGrassWater briefly returns nil. Never ignore food already under
		-- the character just because the framework detector missed that frame.
		if state.grassEatAvailable
			and state.grassEatAvailable(character) then

			return true
		end

		task.wait(0.055)
	end

	return false
end

function state.eatVisualPromptVisible()
	local playerGui =
		player:FindFirstChildOfClass(
			"PlayerGui"
		)

	if not playerGui then
		return false
	end

	local camera =
		workspace.CurrentCamera

	local viewport =
		camera
			and camera.ViewportSize
			or Vector2.new(
				1280,
				720
			)

	for _, object in ipairs(
		playerGui:GetDescendants()
	) do
		if (
			object:IsA("TextLabel")
			or object:IsA("TextButton")
			or object:IsA("TextBox")
		)
			and object.Visible
			and object.TextTransparency < 0.95 then

			local lower =
				tostring(
					object.Text or ""
				):lower()

			local eatText =
				lower:find(
					"para comer",
					1,
					true
				)
				or lower:find(
					"to eat",
					1,
					true
				)
				or lower:find(
					"stop eating",
					1,
					true
				)
				or lower:find(
					"parar de comer",
					1,
					true
				)

			if eatText then
				local centerX =
					object.AbsolutePosition.X
					+ object.AbsoluteSize.X
						* 0.5

				local centerY =
					object.AbsolutePosition.Y
					+ object.AbsoluteSize.Y
						* 0.5

				if centerY
						>= viewport.Y * 0.66
					and centerX
						>= viewport.X * 0.18
					and centerX
						<= viewport.X * 0.82 then

					return true
				end
			end
		end
	end

	return false
end

function state.grassEatAvailable(
	character
)
	if not character then
		return false
	end

	return detectAvailableFood(
		character
	) == "Eat"
		or state.eatVisualPromptVisible()
end

local function faceGrassPoint(root, grassPosition)
	if not root
		or typeof(grassPosition) ~= "Vector3" then
		return
	end

	local character =
		player.Character

	if not character
		or not root:IsDescendantOf(character) then
		return
	end

	-- v126:
	-- If Savannah already says Eat is available, the CURRENT facing is already
	-- accepted by the game's interaction detector. Rotating AFTER that detection
	-- can turn the animal away from the grass that produced the prompt.
	local eatAlreadyAvailable =
		detectAvailableFood(character)
			== "Eat"
		or (
			state.eatVisualPromptVisible
				and state.eatVisualPromptVisible()
		)

	if eatAlreadyAvailable then
		root.AssemblyAngularVelocity =
			Vector3.zero

		return
	end

	local flat =
		Vector3.new(
			grassPosition.X
				- root.Position.X,
			0,
			grassPosition.Z
				- root.Position.Z
		)

	if flat.Magnitude <= 0.15 then
		return
	end

	local desired =
		flat.Unit

	local currentForward =
		Vector3.new(
			root.CFrame.LookVector.X,
			0,
			root.CFrame.LookVector.Z
		)

	if currentForward.Magnitude <= 0.05 then
		return
	end

	currentForward =
		currentForward.Unit

	local alignment =
		currentForward:Dot(
			desired
		)

	-- MoveTo/AutoRotate already faced the animal while approaching the patch.
	-- If the stored grass point is now far to the side/behind, it is stale.
	-- Never perform the old 90-180 degree snap toward that stale coordinate.
	if alignment < 0.26 then
		root.AssemblyAngularVelocity =
			Vector3.zero

		return
	end

	-- Only a small final correction is allowed inside the same forward sector.
	local crossY =
		currentForward.X * desired.Z
			- currentForward.Z * desired.X

	local angle =
		math.atan2(
			crossY,
			alignment
		)

	local clampedAngle =
		math.clamp(
			angle,
			-math.rad(28),
			math.rad(28)
		)

	local c =
		math.cos(
			clampedAngle
		)

	local s =
		math.sin(
			clampedAngle
		)

	local corrected =
		Vector3.new(
			currentForward.X * c
				- currentForward.Z * s,
			0,
			currentForward.X * s
				+ currentForward.Z * c
		)

	if corrected.Magnitude <= 0.05 then
		return
	end

	pcall(function()
		root.CFrame =
			CFrame.lookAt(
				root.Position,
				root.Position
					+ corrected.Unit,
				Vector3.yAxis
			)
	end)

	root.AssemblyAngularVelocity =
		Vector3.zero
end

local function startGrassEatingIfAvailable(character, root, grassPosition)
	if not character or not root then return false end

	-- The game's visible Eat prompt is sufficient proof that the CURRENT pose can
	-- eat. Do not force a distant Terrain scan when DetectMeatGrassWater misses it.
	if not state.grassEatAvailable(character) then
		return false
	end

	if grassPosition then
		faceGrassPoint(root, grassPosition)
	end

	-- Stop walking before starting the interaction.
	local velocity = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(
		0,
		velocity.Y,
		0
	)

	-- Prevent residual physics rotation between confirmed Eat and the E press.
	root.AssemblyAngularVelocity =
		Vector3.zero

	-- E is only the visual interaction path. The server sub-state remote is
	-- authoritative for actual eating, so do not risk toggling Eat back off.
	blockClientSubState = false
	setSubState("Eating")
	blockClientSubState = false
	return true
end

state.carcassNamedFallbackCache = state.carcassNamedFallbackCache or {
	initialized = false,
	models = {},
	seen = {},
}

function state.carcassNamedFallbackModels()
	local cache = state.carcassNamedFallbackCache

	local function add(object)
		if not object or not object:IsA("Model") then return end
		local lower = object.Name:lower()
		if not lower:find("carcass", 1, true)
			and not lower:find("carcaca", 1, true) then
			return
		end
		if cache.seen[object] then return end
		cache.seen[object] = true
		cache.models[#cache.models + 1] = object
	end

	if not cache.initialized then
		cache.initialized = true
		for _, object in ipairs(workspace:GetDescendants()) do
			add(object)
		end

		connections[#connections + 1] =
			workspace.DescendantAdded:Connect(function(object)
				add(object)
			end)
	end

	-- Compact dead streamed/despawned carcasses without rescanning Workspace.
	for index = #cache.models, 1, -1 do
		local object = cache.models[index]
		if not object or not object.Parent then
			cache.seen[object] = nil
			table.remove(cache.models, index)
		end
	end

	return cache.models
end

local function nearestCarcass(root)
	local best, bestRoot, distance = nil, nil, math.huge
	local seen = {}

	local function consider(object, part)
		object, part = state.carcassCanonicalTarget(object, part)
		if not object or not part or seen[object] then return end
		seen[object] = true

		if carcassIsIgnored(object) then
			return
		end

		if not state.carcassCandidateUsable(
			object,
			part,
			player.Character
		) then

			ignoreCarcass(
				object,
				45
			)

			return
		end
		local current = (part.Position - root.Position).Magnitude
		if current < distance then best, bestRoot, distance = object, part, current end
	end

	local function scan(container)
		for _, object in ipairs(container:GetDescendants()) do
			if object:IsA("Model") then
				local part = object:FindFirstChild("HumanoidRootPart") or object:FindFirstChildWhichIsA("BasePart", true)
				if part then consider(object, part) end
			end
		end
	end

	local storage = workspace:FindFirstChild("CarcassesStorageModel")
	if storage then scan(storage) end

	-- Fallback: Dino Life (ou qualquer jogo) pode guardar as carcacas em
	-- outro lugar/nome. Só "carcass"/"carcaca" — "dead" sozinho pegava
	-- cenário decorativo tipo "DeadTree"/"DeadLog" e moveva em árvores.
	if not best and (not isDinoLife or not storage) then
		for _, object in ipairs(state.carcassNamedFallbackModels()) do
			if object
				and object.Parent
				and object.Parent ~= storage then
				local part = object:FindFirstChild("HumanoidRootPart")
					or object:FindFirstChildWhichIsA("BasePart", true)
				if part then consider(object, part) end
			end
		end
	end

	return best, bestRoot
end

local function baboonAntHillIsIgnored(antHill)
	local expiresAt = BABOON.failedAntHills[antHill]
	if not expiresAt then return false end

	if tick() >= expiresAt or not antHill or not antHill.Parent then
		BABOON.failedAntHills[antHill] = nil
		return false
	end

	return true
end

local function baboonIgnoreAntHill(antHill, seconds)
	if antHill then
		BABOON.failedAntHills[antHill] = tick() + (seconds or 90)
	end
end

local function baboonAntHillPart(model)
	if not model or not model.Parent then return nil end

	if model:IsA("BasePart") then
		return model
	end

	if model:IsA("Model") then
		return model.PrimaryPart
			or model:FindFirstChild("HumanoidRootPart")
			or model:FindFirstChildWhichIsA("BasePart", true)
	end

	return nil
end

local function nearestBaboonAntHill(root)
	if not root then return nil, nil, math.huge end

	local mapAssets = workspace:FindFirstChild("MapAssets")
	local folder = mapAssets and mapAssets:FindFirstChild("AntHills")
	if not folder then return nil, nil, math.huge end

	local best, bestPart, bestDistance = nil, nil, math.huge
	local seen = {}

	-- The user-provided path contains multiple AntHill models. Scan direct
	-- children first, then descendants as a compatibility fallback.
	local function consider(object)
		if not object or seen[object] then return end
		seen[object] = true

		if baboonAntHillIsIgnored(object) then return end

		local part = baboonAntHillPart(object)
		if not part then return end

		-- Don't intentionally feed from an anthill submerged by water.
		if isPositionUnderwater(part.Position) then
			baboonIgnoreAntHill(object, 120)
			return
		end

		local distance = (part.Position - root.Position).Magnitude
		if distance < bestDistance then
			best = object
			bestPart = part
			bestDistance = distance
		end
	end

	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("Model") or child:IsA("BasePart") then
			consider(child)
		end
	end

	if not best then
		for _, object in ipairs(folder:GetDescendants()) do
			if object:IsA("Model") then
				consider(object)
			end
		end
	end

	return best, bestPart, bestDistance
end

local function chooseBaboonFood(root)
	if not root then return nil end

	-- IMPORTANT: once a target has been selected, do NOT compare distances
	-- again until that target succeeds, disappears, or is explicitly failed.
	-- This prevents Carcass <-> AntHill oscillation.
	if BABOON.targetObject and BABOON.targetPart
		and BABOON.targetObject.Parent
		and BABOON.targetPart.Parent then

		return {
			kind = BABOON.targetKind,
			object = BABOON.targetObject,
			part = BABOON.targetPart,
			distance = (BABOON.targetPart.Position - root.Position).Magnitude,
			locked = true,
		}
	end

	BABOON.clearTarget()

	local carcass, carcassPart = nearestCarcass(root)
	local carcassDistance = carcassPart
		and (carcassPart.Position - root.Position).Magnitude
		or math.huge

	local antHill, antHillPart, antHillDistance = nearestBaboonAntHill(root)

	local selected
	if carcass and carcassPart and carcassDistance <= antHillDistance then
		selected = {
			kind = "Carcass",
			object = carcass,
			part = carcassPart,
			distance = carcassDistance,
		}
	elseif antHill and antHillPart then
		selected = {
			kind = "AntHill",
			object = antHill,
			part = antHillPart,
			distance = antHillDistance,
		}
	end

	if selected then
		BABOON.targetKind = selected.kind
		BABOON.targetObject = selected.object
		BABOON.targetPart = selected.part
		BABOON.targetStartedAt = tick()
	end

	return selected
end


-- Só pousa em cima do Terrain de VERDADE do Roblox (nunca em cima de
-- árvores/rochas/qualquer objeto) e nunca na água — usado quando um
-- carnívoro não acha carcaça por perto e precisa explorar outra área
-- de um jeito seguro, sem risco de mover em cima de cenário.
local terrainOnlyRayParams = RaycastParams.new()
terrainOnlyRayParams.FilterType = Enum.RaycastFilterType.Include
terrainOnlyRayParams.FilterDescendantsInstances = { workspace.Terrain }

local function findSafeTerrainSpot(origin, minRadius, maxRadius)
	for _ = 1, 12 do
		local angle = math.random() * math.pi * 2
		local radius = minRadius + math.random() * (maxRadius - minRadius)
		local probeXZ = origin + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		local hit = workspace:Raycast(probeXZ + Vector3.new(0, 120, 0), Vector3.new(0, -400, 0), terrainOnlyRayParams)
		if hit and hit.Material ~= Enum.Material.Water then
			return hit.Position + Vector3.new(0, 3, 0)
		end
	end
	return nil
end

function state.giraffeApproachPointBlocked(
	tree,
	index,
	character
)
	if not tree
		or index == nil
		or not character then

		return false
	end

	local record =
		GIRAFFE.failedApproachPoints[
			tree
		]

	if type(record) ~= "table" then
		return false
	end

	if record.character ~= character then
		GIRAFFE.failedApproachPoints[
			tree
		] = nil

		return false
	end

	local point =
		record.points
			and record.points[
				index
			]

	if type(point) ~= "table" then
		return false
	end

	if tick()
		>= (
			point.expiresAt
				or 0
		) then

		record.points[
			index
		] = nil

		return false
	end

	return true
end

function state.giraffeRejectApproachPoint(
	tree,
	index,
	character,
	reason,
	seconds
)
	if not tree
		or index == nil
		or not character then

		return
	end

	local record =
		GIRAFFE.failedApproachPoints[
			tree
		]

	if type(record) ~= "table"
		or record.character ~= character then

		record = {
			character = character,
			points = {},
		}

		GIRAFFE.failedApproachPoints[
			tree
		] = record
	end

	record.points[
		index
	] = {
		reason =
			reason
				or "feeding_point_failed",
		expiresAt =
			tick()
			+ math.max(
				30,
				tonumber(seconds)
					or 150
			),
	}
end

function state.giraffeAllApproachPointsBlocked(
	tree,
	character
)
	if not tree
		or not character then

		return false
	end

	local blocked = 0

	for index = 0, 7 do
		if state.giraffeApproachPointBlocked(
			tree,
			index,
			character
		) then

			blocked += 1
		end
	end

	return blocked >= 8
end

local function giraffeTreeIsIgnored(tree)
	if not tree or not tree.Parent then
		GIRAFFE.failedTrees[tree] = nil
		GIRAFFE.sizeRejectedTrees[tree] = nil
		GIRAFFE.interactionRejectedTrees[tree] = nil
		GIRAFFE.failedApproachPoints[tree] = nil
		return false
	end

	local character =
		player.Character

	if character
		and state.giraffeAllApproachPointsBlocked(
			tree,
			character
		) then

		return true
	end

	local interactionRecord =
		GIRAFFE.interactionRejectedTrees[tree]

	if type(interactionRecord) == "table" then
		local character =
			player.Character

		if interactionRecord.character ~= character
			or tick() >= (interactionRecord.expiresAt or 0) then

			GIRAFFE.interactionRejectedTrees[tree] = nil
		else
			return true
		end
	end

	-- Growth/size blacklist:
	-- if THIS Giraffe rejected the tree because it became too small, keep it
	-- ignored as the same animal grows further. A new/smaller slot may use it.
	local sizeRecord =
		GIRAFFE.sizeRejectedTrees[tree]

	if type(sizeRecord) == "table" then
		local character =
			player.Character

		if not character
			or sizeRecord.character ~= character
			or tick() >= (sizeRecord.expiresAt or 0) then

			GIRAFFE.sizeRejectedTrees[tree] = nil
		else
			local growth =
				tonumber(
					character:GetAttribute(
						"GrowthPercentage"
					)
				)

			if growth and growth <= 1 then
				growth *= 100
			end

			local rejectedAt =
				tonumber(
					sizeRecord.growthAtReject
				)

			-- Same animal + same or larger stage => this tree remains too small.
			if not growth
				or not rejectedAt
				or growth >= rejectedAt - 1 then

				return true
			end

			-- Defensive: if the character somehow becomes smaller, re-evaluate.
			GIRAFFE.sizeRejectedTrees[tree] = nil
		end
	end

	local expiresAt = GIRAFFE.failedTrees[tree]
	if not expiresAt then
		return false
	end

	if tick() >= expiresAt then
		GIRAFFE.failedTrees[tree] = nil
		return false
	end

	return true
end

local function giraffeIgnoreTree(tree, seconds)
	if tree then
		GIRAFFE.failedTrees[tree] = tick() + (seconds or 60)
	end
end

local function giraffeSizeRejectTree(
	tree,
	character,
	reason
)
	if not tree
		or not character then
		return
	end

	local growth =
		tonumber(
			character:GetAttribute(
				"GrowthPercentage"
			)
		)

	if growth and growth <= 1 then
		growth *= 100
	end

	GIRAFFE.sizeRejectedTrees[tree] = {
		character = character,
		growthAtReject = growth or 0,
		reason = reason or "too_small_for_current_size",

		-- Long enough to avoid ever oscillating back to the same little shrub
		-- during this Growth slot. Character identity automatically frees it for
		-- the next newly spawned/smaller Giraffe.
		expiresAt = tick() + 1800,
	}

	-- Also give the generic selector a short failure window. The character-aware
	-- size blacklist above is the authoritative long-term protection.
	GIRAFFE.failedTrees[tree] =
		math.max(
			GIRAFFE.failedTrees[tree] or 0,
			tick() + 120
		)
end

local giraffeLeafPartsCache = setmetatable({}, { __mode = "k" })

local function giraffeLeavesParts(leaves)
	if not leaves then return {} end

	local cached = giraffeLeafPartsCache[leaves]
	if cached then
		local valid = true
		for _, part in ipairs(cached) do
			if not part or not part.Parent then
				valid = false
				break
			end
		end
		if valid then
			return cached
		end
	end

	local parts = {}

	if leaves:IsA("BasePart") then
		table.insert(parts, leaves)
	end

	for _, object in ipairs(leaves:GetDescendants()) do
		if object:IsA("BasePart") then
			table.insert(parts, object)
		end
	end

	giraffeLeafPartsCache[leaves] = parts
	return parts
end

local function giraffeTreeLeafState(tree)
	if not tree or not tree.Parent then
		return nil
	end

	local leaves = tree:FindFirstChild("Leaves")
	if not leaves then
		return nil
	end

	local parts = giraffeLeavesParts(leaves)
	if #parts == 0 then
		return nil
	end

	local visible = {}
	local allDepleted = true

	for _, part in ipairs(parts) do
		-- The Savannah tree depletion signal supplied by the user:
		-- every Leaves MeshPart at Transparency == 1 means this tree is empty.
		if part.Transparency < 0.999 then
			allDepleted = false
			table.insert(visible, part)
		end
	end

	return {
		tree = tree,
		leaves = leaves,
		parts = parts,
		visibleParts = visible,
		depleted = allDepleted,
	}
end

local function giraffeBestVisibleLeaf(tree, root)
	local stateInfo = giraffeTreeLeafState(tree)
	if not stateInfo or stateInfo.depleted then
		return nil, stateInfo
	end

	local bestPart
	local bestDistance = math.huge
	local origin = root and root.Position

	for _, part in ipairs(stateInfo.visibleParts) do
		local distance = origin
			and (part.Position - origin).Magnitude
			or 0

		if distance < bestDistance then
			bestPart = part
			bestDistance = distance
		end
	end

	return bestPart, stateInfo
end

local function giraffeTreeAnchorPart(tree, leafPart)
	if not tree then return leafPart end

	local trunk = tree:FindFirstChild("Trunk")
	if trunk then
		if trunk:IsA("BasePart") then
			return trunk
		end

		local trunkPart = trunk:FindFirstChildWhichIsA("BasePart", true)
		if trunkPart then
			return trunkPart
		end
	end

	if tree:IsA("Model") and tree.PrimaryPart then
		return tree.PrimaryPart
	end

	return tree:FindFirstChildWhichIsA("BasePart", true) or leafPart
end

local function giraffeCharacterReachProfile(character, root)
	if not character or not root then return nil end

	local now = tick()
	local cached = GIRAFFE.reachProfile
	if cached
		and GIRAFFE.reachProfileCharacter == character
		and now - (GIRAFFE.reachProfileAt or 0) <= 0.75 then
		return cached
	end

	local highestY = root.Position.Y
	local lowestY = root.Position.Y

	-- This scan is intentionally cached. The old implementation repeated
	-- GetDescendants() once PER leaf candidate, which becomes extremely expensive
	-- when the Giraffe starts searching a dense MainAssets area.
	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("BasePart") then
			local halfY = object.Size.Y * 0.5
			highestY = math.max(
				highestY,
				object.Position.Y + halfY
			)
			lowestY = math.min(
				lowestY,
				object.Position.Y - halfY
			)
		end
	end

	local growthPercent = tonumber(character:GetAttribute("GrowthPercentage"))
	if growthPercent and growthPercent <= 1 then growthPercent *= 100 end

	local profile = {
		topAboveRoot = math.max(highestY - root.Position.Y, 4),
		rootAboveBottom = math.max(root.Position.Y - lowestY, 1.5),
		bodyHeight = math.max(highestY - lowestY, 6),
		footprint = math.max(4, state.movementFootprint(character)),
		growthPercent = growthPercent,
	}

	GIRAFFE.reachProfile = profile
	GIRAFFE.reachProfileCharacter = character
	GIRAFFE.reachProfileAt = now
	return profile
end

-- Minimum usable foliage height for the CURRENT Giraffe model. The previous
-- 34% body-height floor still admitted adult knee/chest-height shrubs. Use a
-- progressive ratio so young Giraffes retain access to lower food while large
-- adults require a genuinely elevated canopy.
local giraffeMouthPartCache =
	setmetatable(
		{},
		{ __mode = "k" }
	)

function state.giraffeRejectInteractionTree(
	tree,
	character,
	reason,
	seconds
)
	if not tree
		or not character then
		return
	end

	GIRAFFE.interactionRejectedTrees[tree] = {
		character = character,
		reason = reason or "no_real_food_progress",
		expiresAt =
			tick()
			+ math.max(
				90,
				tonumber(seconds) or 300
			),
	}

	GIRAFFE.failedTrees[tree] =
		math.max(
			GIRAFFE.failedTrees[tree] or 0,
			tick() + 60
		)

	GIRAFFE.lastRejectedTree = tree
end

function state.giraffePrideResetSpawn()
	if not isSavannahLife then
		return nil
	end

	local spawns =
		workspace:FindFirstChild(
			"Spawns"
		)

	if not spawns then
		return nil
	end

	local pride =
		spawns:FindFirstChild(
			"PrideRockSpawn1",
			true
		)

	if pride
		and pride:IsA("BasePart")
		and pride.Parent then

		return pride
	end

	return nil
end

function state.giraffeDisengageRejectedTree(
	tree,
	character,
	root
)
	if state.giraffeStartExclusivePrideRecovery then
		return state.giraffeStartExclusivePrideRecovery(
			tree,
			"failed_tree_interaction"
		)
	end

	return false
end


local function giraffeMouthPart(character)
	if not character then
		return nil
	end

	local cached =
		giraffeMouthPartCache[
			character
		]

	if cached
		and cached.Parent
		and cached:IsDescendantOf(
			character
		) then

		return cached
	end

	local best
	local bestPriority = math.huge

	for _, object in ipairs(
		character:GetDescendants()
	) do
		if object:IsA("BasePart") then
			local name =
				object.Name:lower()

			local priority

			if name:find(
				"mouth",
				1,
				true
			) then
				priority = 0

			elseif name:find(
				"muzzle",
				1,
				true
			)
				or name:find(
					"snout",
					1,
					true
				) then

				priority = 1

			elseif name:find(
				"jaw",
				1,
				true
			) then
				priority = 2

			elseif name == "head"
				or name:find(
					"head",
					1,
					true
				) then

				priority = 3
			end

			if priority ~= nil
				and priority < bestPriority then

				bestPriority = priority
				best = object
			end
		end
	end

	best =
		best
			or character:FindFirstChild(
				"Head",
				true
			)

	if best and best:IsA("BasePart") then
		giraffeMouthPartCache[
			character
		] = best

		return best
	end

	return nil
end

local function giraffeMinimumLeafHeight(profile)
	if not profile then return 3.0 end
	local bodyHeight = tonumber(profile.bodyHeight) or 6
	local growthPercent = tonumber(profile.growthPercent)
	local ratio = 0.36
	if bodyHeight >= 15 then
		ratio = 0.50
	elseif bodyHeight >= 12 then
		ratio = 0.46
	elseif bodyHeight >= 9 then
		ratio = 0.41
	end

	local minimum = bodyHeight * ratio
	-- Growth is an additional sanity check for the exact screenshot case: a
	-- mature Giraffe must never classify a knee-height bush as edible even if a
	-- simplified/odd rig makes the measured bounding box slightly shorter.
	if growthPercent and growthPercent >= 90 then
		minimum = math.max(minimum, 7.0)
	elseif growthPercent and growthPercent >= 65 then
		minimum = math.max(minimum, 5.5)
	end

	return math.clamp(minimum, 3.0, 10.5)
end

local function giraffeMinimumCanopyTopY(
	character,
	root,
	ground,
	profile
)
	if not character
		or not root
		or not ground
		or not profile then

		return nil, nil, nil
	end

	local projectedRootY =
		ground.Y
			+ profile.rootAboveBottom

	local mouthPart =
		giraffeMouthPart(
			character
		)

	local projectedMouthY

	if mouthPart then
		local mouthOffset =
			mouthPart.Position.Y
				- root.Position.Y

		projectedMouthY =
			projectedRootY
				+ mouthOffset
	else
		-- Fallback for unusual rigs without a discoverable Head/Mouth part.
		projectedMouthY =
			projectedRootY
				+ profile.topAboveRoot * 0.82
	end

	local growthRatio =
		math.clamp(
			(
				tonumber(
					profile.growthPercent
				) or 50
			) / 100,
			0,
			1
		)

	local bodyHeight =
		tonumber(
			profile.bodyHeight
		) or 6

	-- Young Giraffes are allowed to eat much lower foliage. As the neck/body
	-- grows, the usable downward reach becomes proportionally smaller, which
	-- automatically turns tiny shrubs into invalid food sources.
	local downwardReach =
		math.clamp(
			bodyHeight
				* (
					0.40
					- 0.12 * growthRatio
				),
			2.6,
			6.4
		)

	local oldMinimum =
		ground.Y
			+ giraffeMinimumLeafHeight(
				profile
			)

	-- IMPORTANT:
	-- Savannah's Eat interaction does not map exactly to the visual Mouth/Head
	-- position. Using projectedMouthY as a HARD lower bound rejected legitimate
	-- medium/tall trees (the regression shown in testing).
	--
	-- Keep the proven body/growth-derived lower band as the authority. Mouth
	-- height remains diagnostic data only.
	return oldMinimum,
		projectedMouthY,
		downwardReach
end

local function giraffeGroundAtXZ(x, z, referenceY)
	local castY = math.max((referenceY or 0) + 180, 300)

	local hit = workspace:Raycast(
		Vector3.new(x, castY, z),
		Vector3.new(0, -650, 0),
		terrainOnlyRayParams
	)

	if not hit or hit.Material == Enum.Material.Water then
		return nil
	end

	return hit.Position
end

local function giraffeTreeTooSmallForCurrentSize(
	tree,
	character,
	root
)
	if not tree
		or not character
		or not root then

		return false, nil
	end

	local info =
		giraffeTreeLeafState(
			tree
		)

	if not info
		or info.depleted
		or #info.visibleParts == 0 then

		return false, nil
	end

	local profile =
		giraffeCharacterReachProfile(
			character,
			root
		)

	if not profile then
		return false, nil
	end

	local anchor =
		giraffeTreeAnchorPart(
			tree,
			info.visibleParts[1]
		)

	if not anchor then
		return false, nil
	end

	local ground =
		giraffeGroundAtXZ(
			anchor.Position.X,
			anchor.Position.Z,
			anchor.Position.Y
		)

	if not ground then
		return false, nil
	end

	local minimumCanopyY,
		projectedMouthY,
		downwardReach =
			giraffeMinimumCanopyTopY(
				character,
				root,
				ground,
				profile
			)

	if not minimumCanopyY then
		return false, nil
	end

	local highestVisibleY =
		-math.huge

	for _, part in ipairs(
		info.visibleParts
	) do
		if part and part.Parent then
			-- Do not call giraffeLeafHighestY() here. This helper is declared
			-- later in the file, and the previous patch accidentally referenced it
			-- before its local declaration. Compute the same bound directly.
			highestVisibleY =
				math.max(
					highestVisibleY,
					part.Position.Y
						+ part.Size.Y * 0.5
				)
		end
	end

	if highestVisibleY == -math.huge then
		return false, nil
	end

	local tooSmall =
		highestVisibleY
			< minimumCanopyY - 0.20

	return tooSmall, {
		info = info,
		profile = profile,
		ground = ground,
		highestVisibleY = highestVisibleY,
		minimumCanopyY = minimumCanopyY,
		projectedMouthY = projectedMouthY,
		downwardReach = downwardReach,
	}
end

local function giraffeTargetGrowthChanged(
	character,
	root
)
	if not character
		or not root then

		return false, nil
	end

	local profile =
		giraffeCharacterReachProfile(
			character,
			root
		)

	if not profile then
		return false, nil
	end

	local oldGrowth =
		tonumber(
			GIRAFFE.targetGrowthAtLock
		)

	local oldHeight =
		tonumber(
			GIRAFFE.targetBodyHeightAtLock
		)

	local growthDelta =
		oldGrowth
			and (
				(tonumber(profile.growthPercent) or oldGrowth)
					- oldGrowth
			)
			or 0

	local heightDelta =
		oldHeight
			and (
				(tonumber(profile.bodyHeight) or oldHeight)
					- oldHeight
			)
			or 0

	local changed =
		growthDelta >= 1.5
		or (
			oldHeight
			and heightDelta
				>= math.max(
					0.35,
					oldHeight * 0.025
				)
		)

	return changed, profile
end

local function giraffeLeafLowestY(part)
	if not part or not part:IsA("BasePart") then
		return math.huge
	end

	return part.Position.Y - part.Size.Y * 0.5
end

local function giraffeLeafHighestY(part)
	if not part or not part:IsA("BasePart") then
		return -math.huge
	end

	return part.Position.Y + part.Size.Y * 0.5
end

local function giraffeLeafHorizontalRadius(part)
	if not part or not part:IsA("BasePart") then
		return 0
	end

	return math.sqrt(
		(part.Size.X * 0.5) ^ 2
			+ (part.Size.Z * 0.5) ^ 2
	)
end

-- Use the actual oriented Leaves bounding box instead of a circumscribed circle.
-- The old radius approximation could report a huge/irregular leaf mesh as reachable
-- from a point that was visually several studs outside its real X/Z bounds.
local function giraffeLeafHorizontalDistance(part, worldPosition)
	if not part
		or not part:IsA("BasePart")
		or typeof(worldPosition) ~= "Vector3" then
		return math.huge
	end

	local probe = Vector3.new(
		worldPosition.X,
		part.Position.Y,
		worldPosition.Z
	)

	local localPoint = part.CFrame:PointToObjectSpace(probe)
	local dx = math.max(math.abs(localPoint.X) - part.Size.X * 0.5, 0)
	local dz = math.max(math.abs(localPoint.Z) - part.Size.Z * 0.5, 0)

	return math.sqrt(dx * dx + dz * dz)
end

function state.giraffeLeafVerticalFit(
	leafPart,
	projectedMouthY,
	reachableBottomY,
	reachableTopY,
	profile
)
	if not leafPart
		or not leafPart:IsA("BasePart")
		or not reachableBottomY
		or not reachableTopY then

		return false, nil
	end

	local lowestLeafY =
		leafPart.Position.Y
			- leafPart.Size.Y * 0.5

	local highestLeafY =
		leafPart.Position.Y
			+ leafPart.Size.Y * 0.5

	local bodyHeight =
		tonumber(
			profile
				and profile.bodyHeight
		) or 8

	local mouthY =
		tonumber(
			projectedMouthY
		)
		or (
			reachableBottomY
				+ (
					reachableTopY
						- reachableBottomY
				) * 0.62
		)

	-- The head can reach somewhat above its visual center, but not arbitrarily
	-- high into a giant canopy. This is intentionally lenient.
	local upwardAllowance =
		math.clamp(
			bodyHeight * 0.16 + 0.65,
			2.25,
			4.75
		)

	local practicalTopY =
		math.min(
			reachableTopY,
			mouthY + upwardAllowance
		)

	if lowestLeafY > practicalTopY then
		return false, {
			reason = "too_high",
			lowestLeafY = lowestLeafY,
			highestLeafY = highestLeafY,
			practicalTopY = practicalTopY,
			mouthY = mouthY,
		}
	end

	if highestLeafY < reachableBottomY then
		return false, {
			reason = "too_low",
			lowestLeafY = lowestLeafY,
			highestLeafY = highestLeafY,
			practicalTopY = practicalTopY,
			mouthY = mouthY,
		}
	end

	local overlapBottom =
		math.max(
			lowestLeafY,
			reachableBottomY
		)

	local overlapTop =
		math.min(
			highestLeafY,
			practicalTopY
		)

	local overlap =
		overlapTop
			- overlapBottom

	-- Prevent a huge MeshPart from passing because its bounding box only grazes
	-- the feeding band by a few centimeters.
	local minimumOverlap =
		math.clamp(
			leafPart.Size.Y * 0.075,
			0.65,
			1.65
		)

	if overlap < minimumOverlap then
		return false, {
			reason = "insufficient_vertical_overlap",
			lowestLeafY = lowestLeafY,
			highestLeafY = highestLeafY,
			practicalTopY = practicalTopY,
			mouthY = mouthY,
			overlap = overlap,
			minimumOverlap = minimumOverlap,
		}
	end

	local interactionY =
		math.clamp(
			mouthY,
			overlapBottom,
			overlapTop
		)

	return true, {
		reason = "ok",
		lowestLeafY = lowestLeafY,
		highestLeafY = highestLeafY,
		practicalTopY = practicalTopY,
		mouthY = mouthY,
		interactionY = interactionY,
		mouthGap =
			math.abs(
				interactionY - mouthY
			),
		overlap = overlap,
		minimumOverlap = minimumOverlap,
	}
end

local function giraffeReachableApproach(
	tree,
	leafPart,
	character,
	root,
	startIndex
)
	if not tree or not leafPart or not character or not root then
		return nil
	end

	local profile = giraffeCharacterReachProfile(character, root)
	if not profile then return nil end

	local anchor = giraffeTreeAnchorPart(tree, leafPart)
	if not anchor then return nil end

	local base = anchor.Position
	local lowestLeafY = giraffeLeafLowestY(leafPart)
	local highestLeafY = giraffeLeafHighestY(leafPart)

	-- v130 Giraffe movement fix:
	-- Start on the SAME side of the tree the character is already approaching
	-- from. The previous fixed world-space index could pick the opposite side and
	-- make the large Giraffe route through/around the trunk for no reason.
	local fromTree = Vector3.new(
		root.Position.X - base.X,
		0,
		root.Position.Z - base.Z
	)

	local nearestIndex = 0
	if fromTree.Magnitude > 0.25 then
		local angle = math.atan2(fromTree.Z, fromTree.X)
		if angle < 0 then angle += math.pi * 2 end
		nearestIndex = math.floor(angle / (math.pi * 2) * 8 + 0.5) % 8
	end

	-- Reposition attempts rotate away from the current-side candidate instead of
	-- restarting from an unrelated absolute direction.
	local firstIndex = (
		nearestIndex
		+ math.floor(tonumber(startIndex) or 0)
	) % 8

	-- The old 4.5/6.5-stud radius ignored the animal's footprint. A large/adult
	-- Giraffe could therefore receive a destination whose body overlapped the
	-- trunk even though the HumanoidRootPart itself was technically outside it.
	local footprint = profile.footprint
		or math.max(4, state.movementFootprint(character))

	local anchorRadius = 1.5
	if anchor:IsA("BasePart") then
		anchorRadius = math.max(
			anchor.Size.X,
			anchor.Size.Z
		) * 0.5
	end

	-- Keep the Giraffe genuinely within feeding range.  The full model footprint
	-- includes the long neck/head and was pushing adult animals much too far away
	-- from the foliage.  Use only a modest body-clearance contribution here;
	-- low-leaf rejection is handled separately by the vertical reach band.
	local bodyClearance = math.clamp(
		footprint * 0.22,
		1.8,
		3.0
	)

	local nearRadius = math.clamp(
		anchorRadius + bodyClearance + 0.75,
		4.5,
		7.25
	)

	local farRadius = math.clamp(
		nearRadius + 1.35,
		5.75,
		8.5
	)

	-- Prefer the current side, then fan out alternately left/right. This avoids
	-- repeatedly steering into the trunk when one neighboring side is blocked.
	local order = { 0, 1, -1, 2, -2, 3, -3, 4 }

	for _, offset in ipairs(order) do
		local index = (firstIndex + offset) % 8

		if state.giraffeApproachPointBlocked(
			tree,
			index,
			character
		) then

			continue
		end

		local angle = index / 8 * math.pi * 2
		local radius = math.abs(offset) <= 1 and nearRadius or farRadius

		local x = base.X + math.cos(angle) * radius
		local z = base.Z + math.sin(angle) * radius
		local ground = giraffeGroundAtXZ(x, z, base.Y)

		if ground then
			-- Project this exact Giraffe's top/head height onto the candidate
			-- ground. This automatically adapts to different growth percentages.
			local projectedRootY = ground.Y + profile.rootAboveBottom
			local reachableTopY = projectedRootY
				+ profile.topAboveRoot
				+ GIRAFFE.reachVerticalMargin

			-- v132 Giraffe size-aware LOW-leaf rejection:
			-- The old test had only an upper reach limit. Therefore a full-grown
			-- Giraffe considered a knee-height shrub just as valid as an Acacia tree
			-- because "low <= maximum reach" is always true. In-game the adult neck/
			-- eating pose cannot reliably acquire those very low Leaves, so the animal
			-- could stand on the bush forever. Build a lower edge of the usable feeding
			-- band from THIS character's measured body height. Smaller/young Giraffes
			-- keep a lower band; adults automatically reject shrubs that are too low.
			local minimumLeafHeightAboveGround =
				giraffeMinimumLeafHeight(profile)

			local sizeAdjustedBottomY,
				projectedMouthY,
				downwardReach =
					giraffeMinimumCanopyTopY(
						character,
						root,
						ground,
						profile
					)

			local reachableBottomY =
				math.max(
					ground.Y
						+ minimumLeafHeightAboveGround,
					sizeAdjustedBottomY
						or -math.huge
				)

			local verticalOK,
				vertical =
					state.giraffeLeafVerticalFit(
						leafPart,
						projectedMouthY,
						reachableBottomY,
						reachableTopY,
						profile
					)

			if not verticalOK then
				if vertical
					and vertical.reason == "too_high" then

					state.giraffeRejectApproachPoint(
						tree,
						index,
						character,
						"leaves_too_high",
						90
					)
				end

				continue
			end

			-- Measure against the actual oriented Leaves bounds. This avoids both
			-- standing too far away from a large mesh and falsely accepting a point
			-- that only fits the old circular approximation.
			local effectiveHorizontal =
				giraffeLeafHorizontalDistance(
					leafPart,
					ground
				)

			if effectiveHorizontal
				<= GIRAFFE.reachHorizontal then

				return {
					ground = ground,
					reachableTopY = reachableTopY,
					reachableBottomY = reachableBottomY,
					lowestLeafY =
						vertical.lowestLeafY,
					highestLeafY =
						vertical.highestLeafY,
					practicalTopY =
						vertical.practicalTopY,
					interactionY =
						vertical.interactionY,
					verticalOverlap =
						vertical.overlap,
					horizontal = effectiveHorizontal,
					projectedMouthY = projectedMouthY,
					downwardReach = downwardReach,
					approachIndex = index,
				}
			end
		end
	end

	return nil
end

local function giraffeBestReachableLeaf(tree, character, root, startIndex)
	local info = giraffeTreeLeafState(tree)
	if not info or info.depleted then
		return nil, info, nil
	end

	local profile = giraffeCharacterReachProfile(character, root)
	if not profile then
		return nil, info, nil
	end

	-- PERFORMANCE:
	-- The old search called giraffeReachableApproach() for EVERY visible leaf.
	-- That function may perform up to 8 Terrain raycasts, so a tree with many
	-- meshes multiplied the work dramatically. We now test each approach side
	-- once and score every visible leaf against that SAME ground sample.
	local anchor = giraffeTreeAnchorPart(
		tree,
		info.visibleParts[1]
	)
	if not anchor then
		return nil, info, nil
	end

	local base = anchor.Position
	local fromTree = Vector3.new(
		root.Position.X - base.X,
		0,
		root.Position.Z - base.Z
	)

	local nearestIndex = 0
	if fromTree.Magnitude > 0.25 then
		local angle = math.atan2(fromTree.Z, fromTree.X)
		if angle < 0 then angle += math.pi * 2 end
		nearestIndex = math.floor(
			angle / (math.pi * 2) * 8 + 0.5
		) % 8
	end

	local firstIndex = (
		nearestIndex
		+ math.floor(tonumber(startIndex) or 0)
	) % 8

	local footprint = profile.footprint
		or math.max(4, state.movementFootprint(character))

	local anchorRadius = 1.5
	if anchor:IsA("BasePart") then
		anchorRadius = math.max(
			anchor.Size.X,
			anchor.Size.Z
		) * 0.5
	end

	-- Keep the Giraffe genuinely within feeding range.  The full model footprint
	-- includes the long neck/head and was pushing adult animals much too far away
	-- from the foliage.  Use only a modest body-clearance contribution here;
	-- low-leaf rejection is handled separately by the vertical reach band.
	local bodyClearance = math.clamp(
		footprint * 0.22,
		1.8,
		3.0
	)

	local nearRadius = math.clamp(
		anchorRadius + bodyClearance + 0.75,
		4.5,
		7.25
	)

	local farRadius = math.clamp(
		nearRadius + 1.35,
		5.75,
		8.5
	)

	local minimumLeafHeightAboveGround =
		giraffeMinimumLeafHeight(profile)

	local order = { 0, 1, -1, 2, -2, 3, -3, 4 }

	for _, offset in ipairs(order) do
		local index = (firstIndex + offset) % 8

		if state.giraffeApproachPointBlocked(
			tree,
			index,
			character
		) then

			continue
		end

		local angle = index / 8 * math.pi * 2
		local radius =
			math.abs(offset) <= 1
				and nearRadius
				or farRadius

		local x = base.X + math.cos(angle) * radius
		local z = base.Z + math.sin(angle) * radius
		local ground = giraffeGroundAtXZ(x, z, base.Y)

		if ground then
			local projectedRootY =
				ground.Y + profile.rootAboveBottom

			local reachableTopY =
				projectedRootY
				+ profile.topAboveRoot
				+ GIRAFFE.reachVerticalMargin

			local sizeAdjustedBottomY,
				projectedMouthY,
				downwardReach =
					giraffeMinimumCanopyTopY(
						character,
						root,
						ground,
						profile
					)

			local reachableBottomY =
				math.max(
					ground.Y
						+ minimumLeafHeightAboveGround,
					sizeAdjustedBottomY
						or -math.huge
				)

			local bestPart
			local bestScore = math.huge
			local bestHorizontal = nil
			local bestVertical = nil
			local tooHighSeen = false
			local verticalCandidateSeen = false

			for _, part in ipairs(info.visibleParts) do
				if part and part.Parent then
					local verticalOK,
						vertical =
							state.giraffeLeafVerticalFit(
								part,
								projectedMouthY,
								reachableBottomY,
								reachableTopY,
								profile
							)

					if vertical then
						verticalCandidateSeen = true

						if vertical.reason == "too_high" then
							tooHighSeen = true
						end
					end

					if verticalOK then
						local effectiveHorizontal =
							giraffeLeafHorizontalDistance(
								part,
								ground
							)

						if effectiveHorizontal
							<= GIRAFFE.reachHorizontal then

							-- Prefer Leaves close to the actual head/mouth band.
							-- This prevents a huge high canopy from winning over a
							-- normal edible branch just because both bounding boxes
							-- technically overlap the old broad reach interval.
							local score =
								effectiveHorizontal
								+ (
									vertical.mouthGap
										or 0
								) * 0.22
								+ math.max(
									1.25
										- (
											vertical.overlap
												or 0
										),
									0
								) * 0.75
								+ (
									part.Position
										- root.Position
								).Magnitude * 0.015

							if score < bestScore then
								bestScore = score
								bestPart = part
								bestHorizontal =
									effectiveHorizontal
								bestVertical =
									vertical
							end
						end
					end
				end
			end

			if bestPart
				and bestVertical then

				return bestPart, info, {
					ground = ground,
					reachableTopY = reachableTopY,
					reachableBottomY = reachableBottomY,
					lowestLeafY =
						bestVertical.lowestLeafY,
					highestLeafY =
						bestVertical.highestLeafY,
					practicalTopY =
						bestVertical.practicalTopY,
					interactionY =
						bestVertical.interactionY,
					verticalOverlap =
						bestVertical.overlap,
					horizontal = bestHorizontal,
					projectedMouthY = projectedMouthY,
					downwardReach = downwardReach,
					approachIndex = index,
				}
			end

			-- Cache obviously too-high sides briefly. This prevents an enormous
			-- tree from being recomputed every 0.2s while the Giraffe is starving.
			if not bestPart
				and verticalCandidateSeen
				and tooHighSeen then

				state.giraffeRejectApproachPoint(
					tree,
					index,
					character,
					"canopy_too_high_for_current_head",
					90
				)
			end
		end
	end

	return nil, info, nil
end


function state.giraffeTryAlternateFeedingPoint(
	selected,
	character,
	root,
	reason
)
	if type(selected) ~= "table"
		or not selected.tree
		or not character
		or not root then

		return false
	end

	local currentIndex =
		selected.approach
			and selected.approach.approachIndex

	if currentIndex ~= nil then
		state.giraffeRejectApproachPoint(
			selected.tree,
			currentIndex,
			character,
			reason or "no_food_progress",
			180
		)
	end

	local leafPart,
		info,
		approach =
			giraffeBestReachableLeaf(
				selected.tree,
				character,
				root,
				(currentIndex or 0) + 1
			)

	if not info
		or info.depleted
		or not leafPart
		or not approach then

		return false
	end

	selected.leafPart =
		leafPart

	selected.leaves =
		info.leaves

	selected.approach =
		approach

	GIRAFFE.targetLeaves =
		info.leaves

	GIRAFFE.targetLeafPart =
		leafPart

	return true
end

local function giraffeGroundNearTree(tree, leafPart, root, approachIndex)
	if not tree or not leafPart or not root then return nil end

	local anchor = giraffeTreeAnchorPart(tree, leafPart)
	if not anchor then return nil end

	local base = anchor.Position
	local outward = Vector3.new(
		root.Position.X - base.X,
		0,
		root.Position.Z - base.Z
	)

	if outward.Magnitude < 0.5 then
		outward = Vector3.new(1, 0, 0)
	else
		outward = outward.Unit
	end

	-- Reposition attempts stay on the SAME tree and rotate around its trunk.
	-- This fixes a bad interaction angle without prematurely switching trees.
	local turn = ((approachIndex or 0) % 4) * (math.pi / 2)
	local cosA, sinA = math.cos(turn), math.sin(turn)
	local rotated = Vector3.new(
		outward.X * cosA - outward.Z * sinA,
		0,
		outward.X * sinA + outward.Z * cosA
	)

	local desiredXZ = base + rotated * 5
	local hit = workspace:Raycast(
		Vector3.new(desiredXZ.X, math.max(base.Y + 150, 250), desiredXZ.Z),
		Vector3.new(0, -500, 0),
		terrainOnlyRayParams
	)

	if not hit or hit.Material == Enum.Material.Water then
		return nil
	end

	return hit.Position
end

local function nearestGiraffeTree(root)
	if not root then return nil end

	if GIRAFFE.exclusiveRecovery
		and GIRAFFE.exclusiveRecovery.active then
		return nil
	end

	if GIRAFFE.failedEatPrideBusy then
		return nil
	end

	local character = player.Character
	if not character then return nil end

	-- A locked tree stays authoritative while the normal, proven reach solver
	-- can still find at least one usable Leaves mesh. Growth is re-evaluated LIVE.
	if GIRAFFE.targetTree
		and GIRAFFE.targetTree.Parent then

		local leafPart, info, approach =
			giraffeBestReachableLeaf(
				GIRAFFE.targetTree,
				character,
				root
			)

		if info
			and not info.depleted
			and leafPart
			and approach
			and state.autoFoodPositionAllowed(
				approach.ground
			) then

			GIRAFFE.targetLeaves =
				info.leaves

			GIRAFFE.targetLeafPart =
				leafPart

			return {
				tree = GIRAFFE.targetTree,
				leaves = info.leaves,
				leafPart = leafPart,
				approach = approach,
				distance =
					(
						leafPart.Position
						- root.Position
					).Magnitude,
				locked = true,
			}
		end

		if info and info.depleted then
			runtimeMessage =
				"Giraffe: current tree is fully depleted"

		elseif info and not info.depleted then
			local grew =
				giraffeTargetGrowthChanged(
					character,
					root
				)

			if grew then
				giraffeSizeRejectTree(
					GIRAFFE.targetTree,
					character,
					"locked_tree_became_unreachable_after_growth"
				)

				runtimeMessage =
					"Giraffe grew beyond the locked tree; blacklisted for this growth stage"
			else
				-- Geometry/angle failure without proven growth is NOT a size
				-- blacklist. Temporarily skip and allow another tree.
				giraffeIgnoreTree(
					GIRAFFE.targetTree,
					35
				)

				runtimeMessage =
					"Giraffe: locked tree currently unreachable; selecting another tree"
			end
		end

		GIRAFFE.clearTarget()
	end

	local mapAssets = workspace:FindFirstChild("MapAssets")
	local mainAssets = mapAssets and mapAssets:FindFirstChild("MainAssets")
	if not mainAssets then return nil end

	-- PERFORMANCE v133:
	-- Do NOT run the expensive reach solver on every tree in MainAssets.
	-- First build a cheap distance list using only the tree anchor, then test
	-- candidates nearest-first and STOP at the first actually reachable tree.
	-- In normal play this means ~1-3 heavy geometry checks instead of scanning
	-- every Leaves mesh across the whole map.
	local candidates = {}

	for _, tree in ipairs(mainAssets:GetChildren()) do
		if not giraffeTreeIsIgnored(tree) then
			local leaves = tree:FindFirstChild("Leaves")
			if leaves then
				local anchor =
					giraffeTreeAnchorPart(
						tree,
						leaves:IsA("BasePart") and leaves or nil
					)

				if anchor and anchor:IsA("BasePart") then
					candidates[#candidates + 1] = {
						tree = tree,
						distance =
							(anchor.Position - root.Position).Magnitude,
					}
				end
			end
		end
	end

	table.sort(
		candidates,
		function(a, b)
			return a.distance < b.distance
		end
	)

	local function acceptReachableCandidate(candidate)
		local tree =
			candidate.tree

		local leafPart, info, approach =
			giraffeBestReachableLeaf(
				tree,
				character,
				root
			)

		if not (
			info
			and not info.depleted
			and leafPart
			and approach
			and state.autoFoodPositionAllowed(
				approach.ground
			)
		) then
			return nil
		end

		local best = {
			tree = tree,
			leaves = info.leaves,
			leafPart = leafPart,
			approach = approach,
			distance = candidate.distance,
		}

		GIRAFFE.targetTree = best.tree
		GIRAFFE.targetLeaves = best.leaves
		GIRAFFE.targetLeafPart = best.leafPart
		GIRAFFE.targetStartedAt = tick()
		GIRAFFE.repositionAttempts = 0

		local profile =
			giraffeCharacterReachProfile(
				character,
				root
			)

		GIRAFFE.targetGrowthAtLock =
			profile
				and profile.growthPercent
				or nil

		GIRAFFE.targetBodyHeightAtLock =
			profile
				and profile.bodyHeight
				or nil

		return best
	end

	for index, candidate in ipairs(candidates) do
		local best =
			acceptReachableCandidate(
				candidate
			)

		if best then
			return best
		end

		if index % 8 == 0 then
			task.wait()
		end
	end

	-- Fail-safe against a stale generic angle/reposition blacklist. We DO NOT
	-- clear growth-proven sizeRejectedTrees here.
	local clearedGeneric = false

	for tree in pairs(
		GIRAFFE.failedTrees
	) do
		if not GIRAFFE.sizeRejectedTrees[tree] then
			GIRAFFE.failedTrees[tree] = nil
			clearedGeneric = true
		end
	end

	if clearedGeneric then
		local retryCandidates = {}

		for _, tree in ipairs(
			mainAssets:GetChildren()
		) do
			if not giraffeTreeIsIgnored(tree) then
				local leaves =
					tree:FindFirstChild(
						"Leaves"
					)

				if leaves then
					local anchor =
						giraffeTreeAnchorPart(
							tree,
							leaves:IsA("BasePart")
								and leaves
								or nil
						)

					if anchor
						and anchor:IsA("BasePart") then

						retryCandidates[#retryCandidates + 1] = {
							tree = tree,
							distance =
								(
									anchor.Position
									- root.Position
								).Magnitude,
						}
					end
				end
			end
		end

		table.sort(
			retryCandidates,
			function(a, b)
				return a.distance < b.distance
			end
		)

		for index, candidate in ipairs(
			retryCandidates
		) do
			local best =
				acceptReachableCandidate(
					candidate
				)

			if best then
				runtimeMessage =
					"Giraffe: recovered tree search after clearing stale geometry skips"

				return best
			end

			if index % 8 == 0 then
				task.wait()
			end
		end
	end

	return nil
end

local RAGDOLL_STATES = {
	[Enum.HumanoidStateType.Physics] = true,
	[Enum.HumanoidStateType.FallingDown] = true,
	[Enum.HumanoidStateType.Ragdoll] = true,
	[Enum.HumanoidStateType.Freefall] = true,
	[Enum.HumanoidStateType.GettingUp] = true,
}

local activeCarcass
local activeCarcassCommitted = false
local carcassEatBusy = false

-- Savannah carnivores are allowed to intentionally cross rivers to reach a DRY
-- carcass on the opposite bank. The generic no-idle water watchdog must not
-- interpret that transit as an accidental water trap between carcass acquisition
-- attempts. Progress toward the SAME dry carcass is the proof that the swim is
-- intentional; if progress stops, normal water safety is allowed to take over.
state.carcassWaterTransit = state.carcassWaterTransit or {
	active = false,
	character = nil,
	target = nil,
	targetPart = nil,
	lastDistance = math.huge,
	lastProgressAt = 0,
	startedAt = 0,
	armedAt = 0,
}

function state.carcassWaterTransitReset()
	local transit = state.carcassWaterTransit
	if not transit then return end
	transit.active = false
	transit.character = nil
	transit.target = nil
	transit.targetPart = nil
	transit.lastDistance = math.huge
	transit.lastProgressAt = 0
	transit.startedAt = 0
	transit.armedAt = 0
end

function state.carcassWaterTransitArm(character, root, carcass, carcassRoot)
	local transit = state.carcassWaterTransit
	if not transit
		or not (isSavannahLife or isDinoLife)
		or not character
		or not root
		or character ~= player.Character
		or isAquaticCharacter(character)
		or not carcass
		or not carcass.Parent
		or not carcassRoot
		or not carcassRoot.Parent then

		return false
	end

	local distance = Vector3.new(
		carcassRoot.Position.X - root.Position.X,
		0,
		carcassRoot.Position.Z - root.Position.Z
	).Magnitude
	local now = tick()

	-- Re-entering acquisition for the SAME target must NOT refresh the stall clock.
	-- Otherwise a blocked river crossing could re-arm every retry and suppress
	-- Safety forever. Keep the original progress window until real movement occurs.
	if transit.active == true
		and transit.character == character
		and transit.target == carcass then
		transit.targetPart = carcassRoot
		if distance < (transit.lastDistance or math.huge) then
			transit.lastDistance = distance
		end
		return now - (transit.lastProgressAt or 0) <= 6.5
			and now - (transit.startedAt or now) <= 75
	end

	-- Validate the destination ONCE when a NEW Food target is armed. CriticalObserve
	-- runs at 5 Hz, so it must never rescan carcass water geometry every pass.
	if state.carcassWaterUnsafe(carcass, carcassRoot)
		or state.carcassPrideRockForbidden(carcass, carcassRoot, character) then
		state.carcassWaterTransitReset()
		return false
	end

	transit.active = true
	transit.character = character
	transit.target = carcass
	transit.targetPart = carcassRoot
	transit.lastDistance = distance
	transit.lastProgressAt = now
	transit.startedAt = now
	transit.armedAt = now
	return true
end

function state.carcassIntentionalWaterTransitActive(character, root)
	local transit = state.carcassWaterTransit
	if not transit
		or transit.active ~= true
		or not (isSavannahLife or isDinoLife)
		or not character
		or not root
		or character ~= player.Character
		or transit.character ~= character
		or isAquaticCharacter(character)
		or activeCarcassCommitted then

		if transit and transit.active then
			state.carcassWaterTransitReset()
		end
		return false
	end

	local carcass = activeCarcass
	if not carcass
		or carcass ~= transit.target
		or not carcass.Parent then
		state.carcassWaterTransitReset()
		return false
	end

	local carcassRoot = transit.targetPart
	if not carcassRoot
		or not carcassRoot.Parent
		or not carcassRoot:IsDescendantOf(carcass) then
		carcassRoot = carcass:FindFirstChild("HumanoidRootPart")
			or carcass:FindFirstChildWhichIsA("BasePart", true)
		transit.targetPart = carcassRoot
	end

	if not carcassRoot or not carcassRoot.Parent then
		state.carcassWaterTransitReset()
		return false
	end

	-- The transaction only exists while Food genuinely owns/requests the pursuit.
	local foodOwner =
		carcassEatBusy
		or (state.safeMove and state.safeMove.active and state.safeMove.reason == "food")
		or (state.survivalArbiter and state.survivalArbiter.owner == "food")
		or (state.MMBAI and state.MMBAI.Authority
			and state.MMBAI.Authority.currentOwner == "Food")

	if not foodOwner then
		-- Acquisition retries briefly unwind SafeMove/carcassEatBusy. Preserve a
		-- short handoff window so Safety cannot seize the river between retries.
		if tick() - (transit.lastProgressAt or 0) > 1.6 then
			state.carcassWaterTransitReset()
			return false
		end
	end

	local distance = Vector3.new(
		carcassRoot.Position.X - root.Position.X,
		0,
		carcassRoot.Position.Z - root.Position.Z
	).Magnitude
	local now = tick()

	-- Only measurable approach toward the SAME target renews the water exemption.
	if distance < (transit.lastDistance or math.huge) - 0.65 then
		transit.lastDistance = distance
		transit.lastProgressAt = now
	elseif distance < (transit.lastDistance or math.huge) then
		transit.lastDistance = distance
	end

	-- A real crossing can take several seconds for a large Rex. If progress stops,
	-- the exemption expires and the one authoritative Safety recovery may extract.
	return now - (transit.lastProgressAt or 0) <= 6.5
		and now - (transit.startedAt or now) <= 75
end

function state.dinoPostDrinkDryExitRequired(
	character,
	root
)
	if not isDinoLife
		or not character
		or not root
		or isAquaticCharacter(
			character
		) then

		return false
	end

	if state.intentionalWaterTransitActive
		and state.intentionalWaterTransitActive(
			character,
			root
		) then

		return false
	end

	if not state.isBodyActuallyInWater(
		character,
		root
	) then

		return false
	end

	local water =
		tonumber(
			character:GetAttribute(
				"Water"
			)
		) or 100

	-- This is specifically a post-drink/high-water handoff. Lower Water may be
	-- an intentional route toward food and should not be treated as "just drank".
	return water >= 88
		and not drinkingToFull
end

local function activeCarcassStillExists()
	if activeCarcass and activeCarcass.Parent then
		local part =
			activeCarcass:FindFirstChild("HumanoidRootPart")
			or activeCarcass:FindFirstChildWhichIsA("BasePart", true)

		if not state.carcassCandidateHasPhysicalBody(
			activeCarcass,
			part
		) then

			runtimeMessage =
				"Carcass dropped: no physical/visible body remains"

		elseif state.carcassWaterUnsafe(
			activeCarcass,
			part
		) then

			runtimeMessage =
				"Carcass ignored: body is inside water"

		elseif state.carcassPrideRockForbidden(
			activeCarcass,
			part,
			player.Character
		) then

			runtimeMessage =
				"Carcass ignored: inside Pride Rock protection circle"

		else
			return true
		end
	end

	activeCarcass = nil
	activeCarcassCommitted = false
	state.carcassWaterTransitReset()
	return false
end

local function clearActiveCarcass(force)
	if force
		or not activeCarcassCommitted
		or not activeCarcass
		or not activeCarcass.Parent then

		activeCarcass = nil
		activeCarcassCommitted = false
		state.carcassWaterTransitReset()
		return true
	end

	return false
end

function state.dinoRockTrapAutomationActive()
	if not isDinoLife then return false end
	return state.autoEat
		or state.autoDrink
		or state.autoQuests
		or state.farmCoins
		or (state.growthModeActive and state.growthModeActive())
		or (state.safeMove and state.safeMove.active)
		or (state.safeMove and state.safeMove.manualRequestPending)
		or activeCarcass ~= nil
		or carcassEatBusy
end

function state.dinoRockTrapStopCompetingControllers(character, reason)
	state.carcassController =
		state.carcassController
		or {
			token = 0,
			cancelRequested = false,
		}

	state.carcassController.cancelRequested = true
	state.carcassController.token += 1
	carcassEatBusy = false
	clearActiveCarcass(true)

	eatingToFull = false
	eatingSourcePosition = nil
	eatingTargetReachedAt = nil
	eatingStuckSince = nil

	if not (drinkingToFull and state.drinkProgress and state.drinkProgress.confirmed) then
		drinkingToFull = false
		drinkingSourcePosition = nil
	end

	state.questCarnivoreFeeding = false
	state.questBaboonFeeding = false
	state.questGiraffeFeeding = false
	if state.questSetW then pcall(state.questSetW, false) end
	if state.questSetLandPermanentW then pcall(state.questSetLandPermanentW, false) end
	if state.heavyWalkStop then pcall(state.heavyWalkStop, character) end

	if state.requestAllMovementCancellation then
		state.requestAllMovementCancellation(reason or "Dino moral rock trap", "Safety")
	elseif state.safeMove and state.safeMove.active then
		state.safeMove.cancelToken += 1
	end

	if state.survivalArbiterReset then
		state.survivalArbiterReset(reason or "Dino moral rock trap")
	end

	if not (state.safeMove and state.safeMove.active and state.safeMove.owner == "Safety") then
		state.busy = false
	end
end

function state.startDinoRockTrapRecovery(
	reason,
	forceFromObjectiveStall
)
	if not isDinoLife then return false end
	local character, root, humanoid = characterParts()
	if not character or not root or not humanoid or humanoid.Health <= 0
		or isAquaticCharacter(character)
		or state.isFlyingMovementCharacter(character) then
		return false
	end

	local emergency = state.dinoRockEmergency
	if emergency.supervisorActive or emergency.active then return true end

	local constrained, nearby, inside, openCorridors =
		state.dinoRockMoralTrapMetrics(character, root.Position)

	local rockPressure, pressureNearby, nearestGap =
		state.dinoRockPressureMetrics(character, root.Position)

	local bodyInWater =
		state.isBodyActuallyInWater(character, root)

	local objectiveEvidence =
		forceFromObjectiveStall == true
			and (
				emergency.objectiveStalled
					or emergency.foodRouteFailures >= 1
			)

	local verifiedTrap =
		constrained
			or inside > 0
			or (objectiveEvidence and rockPressure)
			or (
				objectiveEvidence
				and bodyInWater
				and pressureNearby >= 1
			)

	if not verifiedTrap then
		return false
	end

	if not state.aiSupervisorPermitController(
		"Safety",
		"DinoRockRecovery",
		reason or "Dino rock trap",
		1000
	) then
		return false
	end

	emergency.rockPressureNearby = pressureNearby
	emergency.rockPressureNearestGap = nearestGap

	emergency.supervisorToken += 1
	local token = emergency.supervisorToken
	emergency.supervisorActive = true
	emergency.supervisorCharacter = character
	emergency.supervisorStartedAt = tick()
	emergency.supervisorFailureCount = 0
	emergency.supervisorPreviousCritical = criticalRecoveryActive == true
	emergency.supervisorStartPosition = root.Position

	emergency.supervisorTarget =
		state.dinoRockEmergencyFindSafePoint(
			character,
			root,
			humanoid
		)

	emergency.supervisorTargetChosenAt =
		tick()

	if typeof(
		emergency.supervisorTarget
	) ~= "Vector3" then

		emergency.supervisorActive = false
		emergency.supervisorCharacter = nil
		return false
	end

	criticalRecoveryActive = true

	state.dinoRockTrapStopCompetingControllers(character, reason or "Dino rock trap recovery")
	runtimeMessage = string.format(
		"DINO ROCK WATCHDOG: exclusive escape (%d rocks, %d open corridors)",
		nearby, openCorridors
	)

	task.spawn(function()
		local completed = false

		local lockedTarget =
			emergency.supervisorTarget

		local liveFood =
			tonumber(
				character:GetAttribute(
					"Food"
				)
			) or 100

		local objectiveTrap =
			forceFromObjectiveStall == true
				or emergency.objectiveStalled
				or emergency.foodRouteFailures >= 1

		local bodyInWater =
			state.isBodyActuallyInWater(
				character,
				root
			)

		local immediateNoclip =
			liveFood <= 30
				or objectiveTrap
				or inside > 0
				or openCorridors <= 1
				or (
					bodyInWater
						and pressureNearby >= 1
				)

		state.dinoRockTrapStopCompetingControllers(
			character,
			"Dino rock watchdog owns movement"
		)

		if immediateNoclip then
			runtimeMessage =
				"DINO ROCK WATCHDOG ONLY: locked escape side -> immediate NOCLIP extraction"

			local liveCharacter,
				liveRoot,
				liveHumanoid =
					characterParts()

			if liveCharacter == character
				and liveRoot
				and liveHumanoid then

				local ok,
					escaped =
						pcall(
							state.dinoRockEmergencyNoclipEscape,
							character,
							liveRoot,
							liveHumanoid,
							"safety",
							lockedTarget
						)

				completed =
					ok
						and escaped == true
			end
		else
			-- Non-critical trap: ONE short attempt toward the SAME locked target.
			-- It may not choose another side afterward.
			local liveCharacter,
				liveRoot,
				liveHumanoid =
					characterParts()

			if liveCharacter == character
				and liveRoot
				and liveHumanoid then

				local before =
					liveRoot.Position

				runtimeMessage =
					"DINO ROCK WATCHDOG ONLY: one locked-side walk attempt"

				safeMoveToPosition(
					lockedTarget,
					3,
					lockedTarget,
					{
						purpose = "safety",
						tolerance = 10,
						speedScale = 0.88,
						constantSpeed = false,
						maxDuration = 3.5,
						routeCheckInterval = 0.15,
						routeCheck = function()
							if not emergency.supervisorActive
								or emergency.supervisorToken
									~= token then

								return true,
									"rock_recovery_cancelled"
							end

							return false
						end,
					}
				)

				liveCharacter,
					liveRoot,
					liveHumanoid =
						characterParts()

				if liveCharacter == character
					and liveRoot
					and liveHumanoid then

					local displacement =
						Vector3.new(
							liveRoot.Position.X - before.X,
							0,
							liveRoot.Position.Z - before.Z
						).Magnitude

					local stillTrapped,
						_,
						newInside,
						newOpen =
							state.dinoRockMoralTrapMetrics(
								character,
								liveRoot.Position
							)

					local stillPressure =
						state.dinoRockPressureMetrics(
							character,
							liveRoot.Position
						)

					completed =
						displacement >= 18
							and not stillTrapped
							and newInside <= 0
							and newOpen >= 3
							and not stillPressure

					if not completed then
						runtimeMessage =
							"DINO ROCK WATCHDOG: locked walk failed -> NOCLIP same escape side"

						local ok,
							escaped =
								pcall(
									state.dinoRockEmergencyNoclipEscape,
									character,
									liveRoot,
									liveHumanoid,
									"safety",
									lockedTarget
								)

						completed =
							ok
								and escaped == true
					end
				end
			end
		end

		if emergency.supervisorToken == token then
			emergency.supervisorActive = false
			emergency.supervisorCharacter = nil
			emergency.supervisorStartedAt = 0
			emergency.supervisorLastPosition = nil
			emergency.supervisorLastProgressAt = tick()
			emergency.supervisorLastFood = nil
			emergency.supervisorLastWater = nil
			emergency.supervisorTarget = nil
			emergency.supervisorTargetChosenAt = 0
			emergency.supervisorStartPosition = nil

			criticalRecoveryActive =
				emergency.supervisorPreviousCritical == true

			emergency.supervisorPreviousCritical =
				false

			state.busy = false

			if state.confirmedTrapResetEvidence then
				pcall(
					state.confirmedTrapResetEvidence,
					character
				)
			end

			if state.survivalArbiterReset then
				state.survivalArbiterReset(
					"Dino rock recovery complete"
				)
			end

			if completed then
				state.dinoRockResetFoodRouteEvidence()
			else
				emergency.objectiveStalled = true
				emergency.foodRouteFailures =
					math.max(
						1,
						emergency.foodRouteFailures or 0
					)
			end

			local ai =
				state.MMBAI

			if completed
				and ai
				and ai.ModuleRegistry
				and type(
					ai.ModuleRegistry.ResetRuntime
				) == "function" then

				pcall(
					ai.ModuleRegistry.ResetRuntime,
					ai.ModuleRegistry,
					"Movement",
					"rock trap topology changed"
				)

				pcall(
					ai.ModuleRegistry.ResetRuntime,
					ai.ModuleRegistry,
					"AutoEat",
					"rock trap topology changed"
				)
			end

			runtimeMessage =
				completed
					and "DINO ROCK WATCHDOG: SAFE GROUND CONFIRMED; Food/Water objectives released"
					or "DINO ROCK WATCHDOG: extraction failed; watchdog will retry immediately"
		end
	end)

	return true
end

function state.carcassNearestSurfacePoint(carcass, fromPosition, fallbackPart)
	if typeof(fromPosition) ~= "Vector3" then
		return fallbackPart and fallbackPart.Position or nil, math.huge
	end

	local bestPoint
	local bestDistance = math.huge

	local function considerPart(part)
		if not part
			or not part:IsA("BasePart")
			or part.Transparency >= 0.98 then
			return
		end

		-- Measure against the actual oriented part volume, not its center. This is
		-- critical for large carcasses (Hippo/Elephant/etc.): the Eat prompt can be
		-- valid at the body edge while HumanoidRootPart is still many studs away.
		local localPoint = part.CFrame:PointToObjectSpace(fromPosition)
		local half = part.Size * 0.5
		local clamped = Vector3.new(
			math.clamp(localPoint.X, -half.X, half.X),
			math.clamp(localPoint.Y, -half.Y, half.Y),
			math.clamp(localPoint.Z, -half.Z, half.Z)
		)
		local worldPoint = part.CFrame:PointToWorldSpace(clamped)
		local distance = (worldPoint - fromPosition).Magnitude

		if distance < bestDistance then
			bestDistance = distance
			bestPoint = worldPoint
		end
	end

	if carcass and carcass.Parent then
		if carcass:IsA("BasePart") then
			considerPart(carcass)
		else
			for _, object in ipairs(carcass:GetDescendants()) do
				if object:IsA("BasePart")
					and object.Name ~= "HumanoidRootPart" then
					considerPart(object)
				end
			end
		end
	end

	-- Compatibility fallback for unusual carcass models whose visible body has
	-- already disappeared but the interaction root is still replicated.
	if not bestPoint and fallbackPart and fallbackPart.Parent then
		bestPoint = fallbackPart.Position
		bestDistance = (bestPoint - fromPosition).Magnitude
	end

	return bestPoint, bestDistance
end

function state.dinoRexCarcassMouthReach(character, root)
	if not state.isDinoRexMovementCharacter(character)
		or not root then
		return nil
	end

	local head =
		character:FindFirstChild("Head", true)

	if head and head:IsA("BasePart") then
		local flatReach =
			Vector3.new(
				head.Position.X - root.Position.X,
				0,
				head.Position.Z - root.Position.Z
			).Magnitude

		if flatReach >= 2 then
			return math.clamp(
				flatReach,
				4.5,
				18
			)
		end
	end

	local size =
		state.movementBodySize(character)

	return math.clamp(
		math.max(size.X, size.Z) * 0.32,
		5,
		16
	)
end

-- Dino Life Rex: eating is mouth-driven, not HRP-driven.  A Rex can have its
-- torso beside/on top of a carcass while the actual jaw is still outside the
-- server interaction volume.  Keep a tiny cached anatomical part and use a
-- carcass-only ray so the chosen bite point is the EXPOSED meat surface seen
-- from the mouth, rather than an arbitrary limb/center inside the model.
state.dinoRexCarcassMouthCache =
	state.dinoRexCarcassMouthCache
	or setmetatable({}, { __mode = "k" })

function state.dinoRexCarcassClosestPointOnPart(part, worldPoint)
	if not part
		or not part:IsA("BasePart")
		or typeof(worldPoint) ~= "Vector3" then
		return nil
	end

	local localPoint =
		part.CFrame:PointToObjectSpace(worldPoint)
	local half = part.Size * 0.5
	local clamped = Vector3.new(
		math.clamp(localPoint.X, -half.X, half.X),
		math.clamp(localPoint.Y, -half.Y, half.Y),
		math.clamp(localPoint.Z, -half.Z, half.Z)
	)

	return part.CFrame:PointToWorldSpace(clamped)
end

function state.dinoRexCarcassMouthPart(character)
	if not state.isDinoRexMovementCharacter(character) then
		return nil
	end

	local cache = state.dinoRexCarcassMouthCache
	local cached = cache and cache[character]

	if cached
		and cached.Parent
		and cached:IsDescendantOf(character) then
		return cached
	end

	local best
	local bestPriority = math.huge

	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("BasePart") then
			local name = object.Name:lower()
			local priority

			if name:find("mouth", 1, true) then
				priority = 0
			elseif name:find("jaw", 1, true) then
				priority = 1
			elseif name:find("snout", 1, true)
				or name:find("muzzle", 1, true) then
				priority = 2
			elseif name == "head"
				or name:find("head", 1, true)
				or name:find("skull", 1, true) then
				priority = 3
			end

			if priority ~= nil
				and priority < bestPriority then
				bestPriority = priority
				best = object
			end
		end
	end

	best = best
		or character:FindFirstChild("Head", true)

	if not (best and best:IsA("BasePart")) then
		return nil
	end

	if cache then
		cache[character] = best
	end

	return best
end

function state.dinoRexCarcassBiteGeometry(
	character,
	root,
	carcassRoot,
	carcass
)
	if not state.isDinoRexMovementCharacter(character)
		or not root
		or not carcassRoot then
		return nil, math.huge, nil, nil, false
	end

	local mouthPart =
		state.dinoRexCarcassMouthPart(character)
		or character:FindFirstChild("Head", true)
		or root

	if not (mouthPart and mouthPart:IsA("BasePart")) then
		mouthPart = root
	end

	local surfacePoint =
		state.carcassNearestSurfacePoint(
			carcass,
			mouthPart.Position,
			carcassRoot
		)
		or carcassRoot.Position

	local mouthPoint =
		state.dinoRexCarcassClosestPointOnPart(
			mouthPart,
			surfacePoint
		)
		or mouthPart.Position

	local confirmedByRay = false

	if carcass and carcass.Parent then
		local rayParams = RaycastParams.new()
		rayParams.FilterType = Enum.RaycastFilterType.Include
		rayParams.FilterDescendantsInstances = { carcass }
		rayParams.IgnoreWater = true

		local function castToward(targetPoint)
			local delta = targetPoint - mouthPoint
			if delta.Magnitude <= 0.05 then
				return nil
			end

			return workspace:Raycast(
				mouthPoint,
				delta.Unit * (delta.Magnitude + 8),
				rayParams
			)
		end

		local hit = castToward(surfacePoint)

		if not hit then
			hit = castToward(carcassRoot.Position)
		end

		if hit
			and hit.Instance
			and (
				hit.Instance == carcass
				or hit.Instance:IsDescendantOf(carcass)
			) then
			surfacePoint = hit.Position
			confirmedByRay = true
		end
	end

	mouthPoint =
		state.dinoRexCarcassClosestPointOnPart(
			mouthPart,
			surfacePoint
		)
		or mouthPart.Position

	return surfacePoint,
		(surfacePoint - mouthPoint).Magnitude,
		mouthPoint,
		mouthPart,
		confirmedByRay
end

function state.dinoRexCarcassRootToMouthReach(
	character,
	root,
	targetPoint
)
	if not state.isDinoRexMovementCharacter(character)
		or not root
		or typeof(targetPoint) ~= "Vector3" then
		return nil
	end

	local mouthPart = state.dinoRexCarcassMouthPart(character)
	if not mouthPart then
		return state.dinoRexCarcassMouthReach(character, root)
	end

	local mouthPoint =
		state.dinoRexCarcassClosestPointOnPart(
			mouthPart,
			targetPoint
		)
		or mouthPart.Position

	local reach = Vector3.new(
		mouthPoint.X - root.Position.X,
		0,
		mouthPoint.Z - root.Position.Z
	).Magnitude

	if reach < 2 then
		return state.dinoRexCarcassMouthReach(character, root)
	end

	return math.clamp(reach, 4.5, 22)
end

state.dinoRexCarcassRecoveryAngles =
	state.dinoRexCarcassRecoveryAngles
	or { 0, 28, -28, 52, -52, 82, -82, 125, -125, 180 }

function state.carcassPhysicalDistance(character, root, carcassRoot, carcass)
	if not character or not root or not carcassRoot then
		return math.huge, math.huge, false, nil
	end

	local rexRayConfirmed = false
	local rexMouthPart
	local headDistance

	if state.isDinoRexMovementCharacter(character) then
		local _, biteDistance, _, mouthPart, rayConfirmed =
			state.dinoRexCarcassBiteGeometry(
				character,
				root,
				carcassRoot,
				carcass
			)

		headDistance = biteDistance
		rexRayConfirmed = rayConfirmed == true
		rexMouthPart = mouthPart
	else
		local head = character:FindFirstChild("Head", true)
		if not (head and head:IsA("BasePart")) then
			head = root
		end

		local headPoint
		headPoint, headDistance =
			state.carcassNearestSurfacePoint(
				carcass,
				head.Position,
				carcassRoot
			)

		if not headPoint then
			headDistance = math.huge
		end
	end

	local rootPoint =
		state.carcassNearestSurfacePoint(
			carcass,
			root.Position,
			carcassRoot
		)

	local horizontalRootDistance = math.huge
	if rootPoint then
		horizontalRootDistance = Vector3.new(
			root.Position.X - rootPoint.X,
			0,
			root.Position.Z - rootPoint.Z
		).Magnitude
	end

	return headDistance,
		horizontalRootDistance,
		rexRayConfirmed,
		rexMouthPart
end

function state.carcassCloseEnough(character, root, carcassRoot, carcass)
	local headDistance,
		horizontalRootDistance,
		rexRayConfirmed,
		rexMouthPart =
		state.carcassPhysicalDistance(
			character,
			root,
			carcassRoot,
			carcass
		)

	-- Savannah animals keep the original body-surface gate. Rex uses the actual
	-- jaw/head surface -> exposed carcass surface gap, confirmed by a carcass-only
	-- ray whenever possible. This prevents a huge torso from falsely counting as
	-- "close enough" while the mouth is several studs away from the meat.
	if state.isDinoRexMovementCharacter(character) then
		local mouthReach =
			state.dinoRexCarcassMouthReach(
				character,
				root
			) or 8

		local mouthSize =
			rexMouthPart
			and rexMouthPart:IsA("BasePart")
			and rexMouthPart.Size.Magnitude
			or 6

		local biteLimit = math.clamp(
			5.25 + mouthSize * 0.12,
			5.5,
			8.25
		)

		if rexRayConfirmed then
			biteLimit = math.min(biteLimit + 1.0, 9.0)
		end

		local rootLimit = math.clamp(
			mouthReach + 12,
			17,
			30
		)

		return headDistance <= biteLimit
			and horizontalRootDistance <= rootLimit
	end

	return headDistance <= 9.5
		and horizontalRootDistance <= 9.5
end

function state.dinoRexCarcassPromptReady(character)
	if not character
		or not state.isDinoRexMovementCharacter(character) then
		return false
	end

	-- Dino Life itself is authoritative here. A Rex wedged beside a carcass can
	-- expose the real Eat prompt even when our mouth/surface geometry is imperfect.
	-- Once that happens, NEVER throw the valid pose away just to satisfy our own
	-- distance estimate.
	return detectAvailableFood(character) == "Eat"
		or (
			state.eatVisualPromptVisible
			and state.eatVisualPromptVisible()
		)
end

function state.carcassEatPromptReady(character)
	if not character then
		return false
	end

	-- The game's own interaction detector / HUD is authoritative for EVERY
	-- carcass eater. Geometry is only a navigation aid; it must never overrule a
	-- real Eat prompt that proves the current pose is accepted by the game.
	return detectAvailableFood(character) == "Eat"
		or (
			state.eatVisualPromptVisible
				and state.eatVisualPromptVisible()
		)
end


task.spawn(function()
	while state.alive do
		pcall(function()
			if not isDinoLife then return end
			local emergency = state.dinoRockEmergency
			if emergency.supervisorActive or emergency.active then return end

			local character, root, humanoid = characterParts()
			if not character or not root or not humanoid or humanoid.Health <= 0
				or isAquaticCharacter(character)
				or state.isFlyingMovementCharacter(character)
				or not state.dinoRockTrapAutomationActive() then
				emergency.supervisorCharacter = character
				emergency.supervisorLastPosition = root and root.Position or nil
				emergency.supervisorLastProgressAt = tick()
				emergency.supervisorLastFood = nil
				emergency.supervisorLastWater = nil
				emergency.moralTrapped = false
				return
			end

			local realCarcassEat =
				state.carcassEatPromptReady
				and state.carcassEatPromptReady(character)
				or false

			if (
				drinkingToFull
				and state.drinkProgress
				and state.drinkProgress.confirmed
			)
				or realCarcassEat then

				if realCarcassEat then
					state.dinoRockResetFoodRouteEvidence()
				end

				emergency.supervisorLastPosition = root.Position
				emergency.supervisorLastProgressAt = tick()
				emergency.supervisorLastFood = tonumber(character:GetAttribute("Food"))
				emergency.supervisorLastWater = tonumber(character:GetAttribute("Water"))
				return
			end

			local constrained, nearby, inside, openCorridors =
				state.dinoRockMoralTrapMetrics(character, root.Position)

			local rockPressure, pressureNearby, nearestGap =
				state.dinoRockPressureMetrics(character, root.Position)

			emergency.moralTrapped = constrained
			emergency.moralNearby = nearby
			emergency.moralInside = inside
			emergency.moralOpenCorridors = openCorridors
			emergency.moralProbeAt = tick()
			emergency.rockPressureNearby = pressureNearby
			emergency.rockPressureNearestGap = nearestGap

			local carcassConflict =
				activeCarcass ~= nil
					or carcassEatBusy

			if not constrained
				and not rockPressure
				and inside <= 0
				and pressureNearby <= 0 then

				-- Once the current position has no rock evidence, stale route
				-- failures are erased immediately. Historical objectiveStalled may
				-- not keep the Supervisor in Safety.
				state.dinoRockResetFoodRouteEvidence()

				emergency.supervisorCharacter =
					character

				emergency.supervisorLastPosition =
					root.Position

				emergency.supervisorLastProgressAt =
					tick()

				emergency.supervisorLastFood =
					tonumber(
						character:GetAttribute(
							"Food"
						)
					)

				emergency.supervisorLastWater =
					tonumber(
						character:GetAttribute(
							"Water"
						)
					)

				return
			end

			local now = tick()
			if emergency.supervisorCharacter ~= character then
				emergency.supervisorCharacter = character
				emergency.supervisorLastPosition = root.Position
				emergency.supervisorLastProgressAt = now
				emergency.supervisorLastFood = tonumber(character:GetAttribute("Food"))
				emergency.supervisorLastWater = tonumber(character:GetAttribute("Water"))
				return
			end

			local lastPosition = emergency.supervisorLastPosition
			if not lastPosition then
				emergency.supervisorLastPosition = root.Position
				emergency.supervisorLastProgressAt = now
				return
			end

			local displacement = Vector3.new(
				root.Position.X - lastPosition.X, 0, root.Position.Z - lastPosition.Z
			).Magnitude
			local food = tonumber(character:GetAttribute("Food")) or 100
			local water = tonumber(character:GetAttribute("Water")) or 100
			local vitalProgress = (emergency.supervisorLastFood and food > emergency.supervisorLastFood + 0.01)
				or (emergency.supervisorLastWater and water > emergency.supervisorLastWater + 0.01)

			if displacement >= 2.25 or vitalProgress then
				emergency.supervisorLastPosition = root.Position
				emergency.supervisorLastProgressAt = now
				emergency.supervisorLastFood = food
				emergency.supervisorLastWater = water
				return
			end

			emergency.supervisorLastFood = food
			emergency.supervisorLastWater = water
			local stalledFor =
				now - (emergency.supervisorLastProgressAt or now)

			local threshold
			if inside > 0 then
				threshold = 1.0
			elseif food <= 25
				and carcassConflict
				and rockPressure then

				threshold = 1.25
			elseif emergency.objectiveStalled
				and rockPressure then

				threshold = 1.5
			elseif constrained
				and carcassConflict then

				threshold = 2.25
			elseif constrained then
				threshold = 3.5
			elseif carcassConflict
				and rockPressure then

				threshold = 3.0
			else
				threshold = 5.0
			end

			if stalledFor >= threshold
				and now - (emergency.supervisorLastTriggerAt or 0) >= 2.5 then
				emergency.supervisorLastTriggerAt = now
				runtimeMessage = string.format(
					"DINO ROCK WATCHDOG: no physical progress (rocks %d / exits %d); overriding carcass/objective",
					nearby, openCorridors
				)
				emergency.objectiveStalled =
					emergency.objectiveStalled
						or carcassConflict

				state.startDinoRockTrapRecovery(
					carcassConflict
						and "carcass lock while rock-pressure stalled"
						or "automation stalled inside rock cluster",
					true
				)
			end
		end)
		task.wait(0.60)
	end
end)


function state.carcassEatAvailable(character, root, carcassRoot, carcass)
	-- Prompt FIRST for all animals, not Rex only. This also fixes Savannah
	-- carnivores whose Head/root geometry estimate is imperfect on a large carcass.
	if state.carcassEatPromptReady(character) then
		return true
	end

	if not state.carcassCloseEnough(
		character,
		root,
		carcassRoot,
		carcass
	) then
		return false
	end

	return false
end

function state.faceCarcass(root, carcassRoot, carcass)
	if not root or not carcassRoot then return end

	local character = player.Character
	local targetPoint

	if character
		and root:IsDescendantOf(character)
		and state.isDinoRexMovementCharacter(character) then

		targetPoint =
			state.dinoRexCarcassBiteGeometry(
				character,
				root,
				carcassRoot,
				carcass
			)
	end

	targetPoint = targetPoint
		or state.carcassNearestSurfacePoint(
			carcass,
			root.Position,
			carcassRoot
		)
		or carcassRoot.Position

	local flat = Vector3.new(
		targetPoint.X - root.Position.X,
		0,
		targetPoint.Z - root.Position.Z
	)

	if flat.Magnitude <= 0.15 then return end

	pcall(function()
		root.CFrame = CFrame.lookAt(
			root.Position,
			root.Position + flat.Unit,
			Vector3.yAxis
		)
	end)
end

local function approachCarcass(
	carcassRoot,
	distance,
	passiveScavenge,
	carcass,
	anchorMode,
	angleDegrees
)
	local character, root = characterParts()
	if not character or not root then return false end

	local dinoRex =
		state.isDinoRexMovementCharacter(
			character
		)

	local surfacePoint

	if dinoRex then
		surfacePoint =
			state.dinoRexCarcassBiteGeometry(
				character,
				root,
				carcassRoot,
				carcass
			)
	end

	surfacePoint = surfacePoint
		or state.carcassNearestSurfacePoint(
			carcass,
			root.Position,
			carcassRoot
		)
		or carcassRoot.Position

	-- Large carcasses do not always expose Eat from the geometrically-nearest
	-- visible limb. The first passes still use the true body surface, but later
	-- acquisition passes may orbit the interaction root/torso instead of repeatedly
	-- driving at the same Elephant/Hippo leg. Rex always uses the mouth-visible
	-- exposed surface returned by the ray/geometry helper above.

	local anchorPoint =
		dinoRex
			and surfacePoint
			or (
				anchorMode == "root"
					and carcassRoot.Position
					or surfacePoint
			)

	local approachDirection = Vector3.new(
		root.Position.X - anchorPoint.X,
		0,
		root.Position.Z - anchorPoint.Z
	)

	if approachDirection.Magnitude < 0.5 then
		approachDirection = Vector3.new(
			root.Position.X - carcassRoot.Position.X,
			0,
			root.Position.Z - carcassRoot.Position.Z
		)
	end

	if approachDirection.Magnitude < 0.5 then
		approachDirection = Vector3.new(
			-root.CFrame.LookVector.X,
			0,
			-root.CFrame.LookVector.Z
		)
	end

	if approachDirection.Magnitude < 0.05 then
		approachDirection = Vector3.new(1, 0, 0)
	else
		approachDirection = approachDirection.Unit
	end

	if type(angleDegrees) == "number"
		and math.abs(angleDegrees) > 0.01 then
		local radians = math.rad(angleDegrees)
		local cosAngle = math.cos(radians)
		local sinAngle = math.sin(radians)
		approachDirection = Vector3.new(
			approachDirection.X * cosAngle
				- approachDirection.Z * sinAngle,
			0,
			approachDirection.X * sinAngle
				+ approachDirection.Z * cosAngle
		)
		if approachDirection.Magnitude > 0.05 then
			approachDirection = approachDirection.Unit
		end
	end

	local standDistance =
		tonumber(distance) or 1.5

	if dinoRex then
		local mouthReach =
			state.dinoRexCarcassRootToMouthReach(
				character,
				root,
				surfacePoint
			)
			or state.dinoRexCarcassMouthReach(
				character,
				root
			)
			or 8

		-- `distance` becomes the desired MOUTH gap for Rex.  Root/torso stand-off
		-- is mouthReach + gap, so the dinosaur stops with the jaw beside the meat
		-- instead of putting the torso on top of a small carcass. Different
		-- acquisition profiles therefore really test different bite depths too.
		local mouthGap = math.clamp(
			tonumber(distance) or 1.5,
			0.65,
			3.8
		)

		standDistance = math.clamp(
			mouthReach + mouthGap,
			5,
			24
		)
	end

	local standTarget = Vector3.new(
		anchorPoint.X + approachDirection.X * standDistance,
		root.Position.Y,
		anchorPoint.Z + approachDirection.Z * standDistance
	)

	local facePoint =
		dinoRex
			and surfacePoint
			or (
				anchorMode == "root"
					and carcassRoot.Position
					or surfacePoint
			)

	-- Arm a single authoritative Food river-transit lease BEFORE SafeMove starts.
	-- This prevents the Safety observer from racing the first frame of a valid
	-- cross-river carcass route in both Dino and Savannah.
	if state.carcassWaterTransitArm then
		state.carcassWaterTransitArm(
			character,
			root,
			carcass,
			carcassRoot
		)
	end

	local moved = safeMoveToPosition(
		standTarget,
		9,
		facePoint,
		{
			purpose = "food",
			interactionTarget = "carcass",
			terminalObstacleRelaxDistance =
				dinoRex
					and math.clamp(
						state.movementFootprint(character) * 1.45 + 8,
						18,
						34
					)
					or 14,
			tolerance =
				dinoRex
					and 1.35
					or (isSavannahLife and 0.35 or 1.10),
			speedScale = 1,
			constantSpeed = false,
			maxDuration = 220,

			-- Stop the instant Savannah confirms Eat. Merely reaching a physical edge
			-- is not considered failure anymore; eatCarcass will pulse the remote and
			-- try another side of the SAME carcass when necessary.
			routeCheckInterval = 0.12,
			routeCheck = function(liveCharacter, liveRoot)
				if passiveScavenge
					and not state.carnivorePassiveScavengeAllowed(
						liveCharacter
					) then
					return true, "priority"
				end

				if liveCharacter
					and liveRoot
					and carcassRoot.Parent
					and (not carcass or carcass.Parent)
					and state.carcassEatAvailable(
						liveCharacter,
						liveRoot,
						carcassRoot,
						carcass
					) then
					return true, "carcass_eat_ready"
				end

				return false
			end,
		}
	)

	local liveCharacter, liveRoot = characterParts()

	if liveCharacter
		and liveRoot
		and carcassRoot.Parent then

		state.faceCarcass(liveRoot, carcassRoot, carcass)

		if dinoRex then
			local eatReady =
				state.carcassEatPromptReady(liveCharacter)

			if moved or eatReady then
				state.dinoRockResetFoodRouteEvidence()
			else
				local emergency = state.dinoRockEmergency
				local rockPressure, pressureNearby, nearestGap =
					state.dinoRockPressureMetrics(
						liveCharacter,
						liveRoot.Position
					)

				local inWater =
					state.isBodyActuallyInWater(
						liveCharacter,
						liveRoot
					)

				if rockPressure
					or (inWater and pressureNearby >= 1) then

					local now = tick()

					if now - (emergency.foodRouteFailureAt or 0) > 7 then
						emergency.foodRouteFailures = 0
					end

					emergency.foodRouteFailureAt = now
					emergency.foodRouteFailures += 1
					emergency.rockPressureNearby = pressureNearby
					emergency.rockPressureNearestGap = nearestGap

					local food =
						tonumber(
							liveCharacter:GetAttribute("Food")
						) or 100

					emergency.objectiveStalled =
						food <= 25
							or emergency.foodRouteFailures >= 2

					if emergency.objectiveStalled then
						runtimeMessage = string.format(
							"DINO ROCK WATCHDOG: carcass route failed beside rocks (%d failures); Safety takes over",
							emergency.foodRouteFailures
						)

						mmbTaskDefer(function()
							task.wait(0.02)

							state.startDinoRockTrapRecovery(
								"Food route failed under local rock pressure",
								true
							)
						end)
					end
				end
			end
		end
	end

	return moved
end

-- Final carcass-contact handshake for Savannah carnivores and Dino Rex. A fixed
-- root stand-off is never considered success by itself: the animal keeps closing
-- the final physical gap until the GAME exposes Eat (detector or visible HUD).
-- Rex uses its measured root->mouth reach, so a large body stops with the JAW at
-- the carcass instead of trying to place the torso at a Savannah-sized distance.
function state.carcassAcquireEatPrompt(
	carcassRoot,
	carcass,
	passiveScavenge
)
	if not carcassRoot
		or not carcassRoot.Parent
		or not carcass
		or not carcass.Parent then
		return false
	end

	local character, root = characterParts()
	if not character
		or not root
		or isAquaticCharacter(character) then
		return false
	end

	local rex =
		isDinoLife
		and state.isDinoRexMovementCharacter(character)

	if not isSavannahLife and not rex then
		return false
	end

	if state.carcassEatPromptReady(character) then
		return true
	end

	if not state.carcassCandidateUsable(
		carcass,
		carcassRoot,
		character
	) then

		return false
	end

	-- Never start a mouth-contact loop from a completely different location.
	-- The old code called this even when approachCarcass() had been cancelled by
	-- Safety, which is exactly how "carcass contact" could appear with no carcass
	-- anywhere near the Rex.
	local initialSurface =
		(rex
			and state.dinoRexCarcassBiteGeometry(
				character,
				root,
				carcassRoot,
				carcass
			))
		or state.carcassNearestSurfacePoint(
			carcass,
			root.Position,
			carcassRoot
		)
		or carcassRoot.Position

	local initialFlatDistance =
		Vector3.new(
			root.Position.X - initialSurface.X,
			0,
			root.Position.Z - initialSurface.Z
		).Magnitude

	local contactStartLimit =
		rex
			and math.clamp(
				state.movementFootprint(
					character
				) * 2.25 + 20,
				34,
				68
			)
			or 30

	if initialFlatDistance > contactStartLimit then
		runtimeMessage =
			string.format(
				"Carcass contact deferred: target still %.0f studs away",
				initialFlatDistance
			)

		return false
	end

	-- A Rex that has just finished drinking must leave the water first. Food is
	-- not allowed to turn the post-drink puddle into a fake carcass contact zone.
	if rex
		and state.dinoPostDrinkDryExitRequired(
			character,
			root
		) then

		runtimeMessage =
			"Rex post-drink safety: leaving water before carcass contact"

		return false
	end

	local deadline = tick() + (rex and 5.4 or 4.2)
	local contactGaps = rex
		and { 1.45, 1.05, 0.72, 0.48, 0.28, 0.12, 0.04 }
		or { 0.95, 0.55, 0.28, 0.10, 0.02 }

	for _, gap in ipairs(contactGaps) do
		character, root = characterParts()
		if not character
			or not root
			or not carcass.Parent
			or not carcassRoot.Parent
			or tick() >= deadline then
			break
		end

		if passiveScavenge
			and not state.carnivorePassiveScavengeAllowed(character) then
			return false
		end

		if state.carcassEatPromptReady(character) then
			return true
		end

		local surfacePoint
		if rex then
			surfacePoint =
				state.dinoRexCarcassBiteGeometry(
					character,
					root,
					carcassRoot,
					carcass
				)
		end

		surfacePoint = surfacePoint
			or state.carcassNearestSurfacePoint(
				carcass,
				root.Position,
				carcassRoot
			)
			or carcassRoot.Position

		local away = Vector3.new(
			root.Position.X - surfacePoint.X,
			0,
			root.Position.Z - surfacePoint.Z
		)

		if away.Magnitude < 0.05 then
			away = Vector3.new(
				-root.CFrame.LookVector.X,
				0,
				-root.CFrame.LookVector.Z
			)
		end

		if away.Magnitude < 0.05 then
			away = Vector3.new(1, 0, 0)
		else
			away = away.Unit
		end

		local standDistance = gap
		if rex then
			local mouthReach =
				state.dinoRexCarcassRootToMouthReach(
					character,
					root,
					surfacePoint
				)
				or state.dinoRexCarcassMouthReach(
					character,
					root
				)
				or math.clamp(
					state.movementFootprint(character) * 0.55,
					5,
					14
				)

			-- Gap is measured from the mouth, not from HumanoidRootPart.
			standDistance = math.clamp(
				mouthReach + gap,
				5,
				26
			)
		end

		local target = Vector3.new(
			surfacePoint.X + away.X * standDistance,
			root.Position.Y,
			surfacePoint.Z + away.Z * standDistance
		)

		runtimeMessage = rex
			and "Rex carcass contact: closing mouth gap until Eat appears"
			or "Carcass contact: closing final gap until Eat appears"

		safeMoveToPosition(
			target,
			5,
			surfacePoint,
			{
				purpose = "food",
				interactionTarget = "carcass",
				terminalObstacleRelaxDistance = rex
					and math.clamp(
						state.movementFootprint(character) * 1.45 + 8,
						18,
						36
					)
					or 14,
				tolerance = rex
					and math.clamp(
						state.movementFootprint(character) * 0.035,
						0.30,
						0.80
					)
					or 0.16,
				speedScale = rex and 0.52 or 0.58,
				constantSpeed = false,
				maxDuration = rex and 6 or 5,
				routeCheckInterval = 0.055,
				routeCheck = function(liveCharacter, liveRoot)
					if not state.autoEat
						or not liveCharacter
						or not liveRoot
						or not carcass.Parent
						or not carcassRoot.Parent then
						return true, "carcass_contact_cancelled"
					end

					if state.carcassEatPromptReady(
						liveCharacter
					) then

						return true,
							"carcass_eat_prompt"
					end

					if rex
						and state.dinoPostDrinkDryExitRequired(
							liveCharacter,
							liveRoot
						) then

						return true,
							"post_drink_water_exit"
					end

					return false
				end,
			}
		)

		character, root = characterParts()
		if not character or not root then
			break
		end

		if state.carcassEatPromptReady(character) then
			-- Preserve the exact pose that produced the real Eat HUD.
			root.AssemblyLinearVelocity = Vector3.new(
				0,
				root.AssemblyLinearVelocity.Y,
				0
			)
			root.AssemblyAngularVelocity = Vector3.zero
			return true
		end

		task.wait(0.07)
	end

	character = player.Character
	return character ~= nil
		and state.carcassEatPromptReady(character)
end

-- Compatibility alias for any old internal call left by a resumed task.
state.savannahCarcassAcquireEatPrompt = state.carcassAcquireEatPrompt

function state.carcassPulseStartEating(
	character,
	root,
	carcassRoot,
	carcass
)
	if not character
		or not root
		or not carcassRoot
		or not carcassRoot.Parent
		or not carcass
		or not carcass.Parent then
		return false
	end

	local promptReady =
		state.carcassEatPromptReady(character)

	if not promptReady
		and not state.carcassCloseEnough(
			character,
			root,
			carcassRoot,
			carcass
		) then
		return false
	end

	if promptReady then
		-- The game already accepted this exact pose. Never rotate or reposition after
		-- Eat appears; Savannah Lion can lose the prompt from only a tiny correction.
		if state.safeMove and state.safeMove.active then
			state.safeMove.cancelToken += 1
		end
		root.AssemblyLinearVelocity = Vector3.new(
			0,
			root.AssemblyLinearVelocity.Y,
			0
		)
		root.AssemblyAngularVelocity = Vector3.zero
	else
		state.faceCarcass(root, carcassRoot, carcass)
	end

	blockClientSubState = false
	setSubState("Eating")
	blockClientSubState = false

	fireCarcassRemote(carcass)

	return true
end

local function eatCarcass(
	carcass,
	carcassRoot,
	passiveScavenge
)
	-- v5.3 HARD PRIORITY: Reset Point staging is allowed to break the otherwise
	-- absolute carcass lock. The completed slot must obey Slots immediately.
	if state.slotSwitchStagingActive == true then
		state.carcassController.cancelRequested = true
		state.carcassController.token += 1
		clearActiveCarcass(true)
		carcassEatBusy = false
		return
	end
	if state.questGrowthReset.exclusive then return end
	if state.autoQuests and state.questSwimActive then return end
	if carcassEatBusy or not carcass or not carcassRoot then return end

	carcass, carcassRoot = state.carcassCanonicalTarget(
		carcass,
		carcassRoot
	)
	if not carcass or not carcassRoot then return end

	-- Once a carcass has actually entered the eating transaction it is EXCLUSIVE.
	-- "Always search" only controls WHEN a carnivore starts hunting; it must never
	-- replace a live carcass that the animal is already eating.
	if activeCarcassCommitted
		and activeCarcassStillExists()
		and activeCarcass ~= carcass then
		return
	end

	local character, root, humanoid = characterParts()
	if not character or not root or not humanoid then return end

	if state.dinoShorelineRecovery and (state.dinoShorelineRecovery.active or state.dinoShorelineRecovery.deadlocked) then
		state.startDinoShorelineFoodRecovery("Food worker blocked by shoreline Safety invariant")
		return
	end

	if state.isDinoRexMovementCharacter(character)
		and state.dinoRockEmergency
		and state.dinoRockEmergency.objectiveStalled then

		state.dinoRockTrapStopCompetingControllers(
			character,
			"Safety preempts stale carcass lock"
		)

		state.startDinoRockTrapRecovery(
			"Safety preempts stale carcass lock",
			true
		)

		return
	end

	if not state.carcassCandidateUsable(
		carcass,
		carcassRoot,
		character
	) then

		ignoreCarcass(
			carcass,
			45
		)

		if activeCarcass == carcass then
			clearActiveCarcass(
				true
			)
		end

		runtimeMessage =
			"Carcass target invalidated before approach"

		return
	end

	if state.isDinoRexMovementCharacter(
		character
	)
		and state.dinoPostDrinkDryExitRequired(
			character,
			root
		) then

		-- Drop even a stale committed target. Once dry, nearestCarcass() may
		-- reacquire it normally if it is real and still usable.
		clearActiveCarcass(
			true
		)

		state.carcassController.cancelRequested =
			true

		state.carcassController.token += 1

		runtimeMessage =
			"Rex post-drink: Food deferred until dry bank is confirmed"

		mmbTaskDefer(function()
			task.wait(0.03)
			local liveCharacter = player.Character
			if state.requestDinoPostDrinkDryExit and liveCharacter then
				pcall(
					state.requestDinoPostDrinkDryExit,
					liveCharacter,
					"Carcass worker yielded to post-drink Safety"
				)
			else
				pcall(state.noIdleWaterSafetyStep)
			end
		end)

		return
	end

	if state.carcassPrideRockForbidden(
		carcass,
		carcassRoot,
		character
	) then
		if activeCarcass == carcass then
			clearActiveCarcass(true)
		end
		runtimeMessage =
			"Carcass skipped: inside Pride Rock protection circle"
		return
	end

	if state.carcassWaterUnsafe(carcass, carcassRoot) then
		ignoreCarcass(carcass, 180)
		if activeCarcass == carcass then
			clearActiveCarcass(true)
		end
		runtimeMessage =
			"Carcass skipped: body is inside water"
		return
	end

	local workerCharacter = character
	state.carcassController.token += 1
	state.carcassController.cancelRequested = false
	local carcassControllerToken = state.carcassController.token
	carcassEatBusy = true

	if activeCarcass ~= carcass then
		activeCarcass = carcass
		activeCarcassCommitted = false
	end

	-- Lock the selected carcass as soon as acquisition starts. A failed first
	-- contact point is NOT permission to switch to another carcass. Elephant/Hippo
	-- bodies can require a different side/torso angle before Savannah exposes Eat.
	local acquisitionFood =
		tonumber(character:GetAttribute("Food")) or 0

	local acquired = false
	local rexAcquisition =
		state.isDinoRexMovementCharacter(character)

	-- Generic Savannah carcass acquisition tries many sides for huge bodies.
	-- Rex instead commits to the exposed mouth-facing surface and uses only tiny
	-- corrections, so it does not circle a perfectly reachable carcass.
	local acquisitionProfiles =
		rexAcquisition
			and {
				{ distance = 1.15, mode = "surface", angle = 0 },
				{ distance = 0.65, mode = "surface", angle = 0 },
				{ distance = 0.75, mode = "surface", angle = 18 },
				{ distance = 0.75, mode = "surface", angle = -18 },
			}
			or {
				{ distance = 3.0, mode = "surface", angle = 0 },
				{ distance = 1.25, mode = "surface", angle = 0 },
				{ distance = 5.0, mode = "root", angle = 0 },
				{ distance = 3.0, mode = "root", angle = 55 },
				{ distance = 3.0, mode = "root", angle = -55 },
				{ distance = 2.5, mode = "root", angle = 115 },
				{ distance = 2.5, mode = "root", angle = -115 },
				{ distance = 1.0, mode = "root", angle = 180 },
			}

	for attempt, profile in ipairs(acquisitionProfiles) do
		character, root, humanoid = characterParts()

		if state.carcassController.cancelRequested
			or state.carcassController.token ~= carcassControllerToken
			or character ~= workerCharacter
			or not character
			or not root
			or not humanoid
			or not carcass.Parent
			or not carcassRoot.Parent then
			break
		end

		if state.carcassPrideRockForbidden(
			carcass,
			carcassRoot,
			character
		) then
			clearActiveCarcass(true)
			carcassEatBusy = false
			runtimeMessage =
				"Carcass dropped: entered Pride Rock protection circle"
			return
		end

		if state.carcassWaterUnsafe(carcass, carcassRoot) then
			ignoreCarcass(carcass, 180)
			clearActiveCarcass(true)
			carcassEatBusy = false
			runtimeMessage =
				"Carcass dropped: body entered water"
			return
		end

		if state.carcassEatAvailable(
			character,
			root,
			carcassRoot,
			carcass
		) then
			acquired = true
			break
		end

		-- If we are already physically beside the meat, try the authoritative
		-- server interaction before moving again. Some large carcasses begin Eating
		-- without ever showing the normal pre-Eat detector for a stable frame.
		if state.carcassPulseStartEating(
			character,
			root,
			carcassRoot,
			carcass
		) then
			task.wait(0.28)
			character, root, humanoid = characterParts()
			if character ~= workerCharacter then break end

			local liveFood = character
				and tonumber(character:GetAttribute("Food"))
				or acquisitionFood

			if liveFood > acquisitionFood + 0.01
				or state.carcassEatAvailable(
					character,
					root,
					carcassRoot,
					carcass
				) then
				acquired = true
				break
			end
		end

		runtimeMessage = string.format(
			"Carcass locked: acquiring SAME target (%d/%d)",
			attempt,
			#acquisitionProfiles
		)

		local approached =
			approachCarcass(
				carcassRoot,
				profile.distance,
				passiveScavenge,
				carcass,
				profile.mode,
				profile.angle
			)

		character, root, humanoid =
			characterParts()

		if character ~= workerCharacter
			or not character
			or not root
			or not humanoid then

			break
		end

		local interactionReady =
			state.carcassEatAvailable(
				character,
				root,
				carcassRoot,
				carcass
			)

		local physicallyClose =
			state.carcassCloseEnough(
				character,
				root,
				carcassRoot,
				carcass
			)

		if not approached
			and not interactionReady
			and not physicallyClose then

			if rexAcquisition
				and state.dinoPostDrinkDryExitRequired(
					character,
					root
				) then

				clearActiveCarcass(
					true
				)

				runtimeMessage =
					"Rex carcass route paused: dry-bank safety owns post-drink exit"

				break
			end

			runtimeMessage =
				"Carcass route interrupted before physical contact; retrying later"

			break
		end

		-- Only after real approach/contact may the final mouth-gap handshake run.
		if (
			isSavannahLife
				or rexAcquisition
		)
			and (
				approached
					or interactionReady
					or physicallyClose
			) then

			state.carcassAcquireEatPrompt(
				carcassRoot,
				carcass,
				passiveScavenge
			)
		end

		character, root, humanoid = characterParts()
		if character ~= workerCharacter
			or not character
			or not root
			or not humanoid
			or not carcass.Parent
			or not carcassRoot.Parent then
			break
		end

		state.carcassPulseStartEating(
			character,
			root,
			carcassRoot,
			carcass
		)

		task.wait(0.32)

		local liveFood =
			tonumber(character:GetAttribute("Food"))
				or acquisitionFood

		if liveFood > acquisitionFood + 0.01
			or state.carcassEatAvailable(
				character,
				root,
				carcassRoot,
				carcass
			) then
			acquired = true
			break
		end

		if passiveScavenge
			and not state.carnivorePassiveScavengeAllowed(
				character
			) then
			break
		end
	end

	character, root, humanoid = characterParts()

	if character ~= workerCharacter then
		if activeCarcass == carcass then
			clearActiveCarcass(true)
		end
		carcassEatBusy = false
		return
	end

	-- A real movement-priority quest may cancel an uncommitted passive approach.
	-- This is the only normal reason to give up ownership while the carcass itself
	-- still exists. Merely missing the prompt is NOT a failure anymore.
	if passiveScavenge
		and (
			not character
				or not state.carnivorePassiveScavengeAllowed(character)
		) then

		if activeCarcass == carcass and not activeCarcassCommitted then
			clearActiveCarcass(true)
		end

		carcassEatBusy = false
		runtimeMessage =
			"Passive carcass approach cancelled: higher-priority movement owns the animal"
		return
	end

	if not character
		or not root
		or not humanoid
		or not carcass.Parent then

		if activeCarcass == carcass then
			clearActiveCarcass(true)
		end
		carcassEatBusy = false
		return
	end

	if not carcassRoot.Parent then
		local refreshedRoot =
			carcass:FindFirstChild("HumanoidRootPart")
			or carcass:FindFirstChildWhichIsA("BasePart", true)

		if refreshedRoot then
			carcassRoot = refreshedRoot
		else
			carcassEatBusy = false
			runtimeMessage =
				"Carcass locked: waiting for interaction part to replicate"
			return
		end
	end

	if not acquired then
		-- NEVER blacklist/switch a living dry carcass just because one acquisition
		-- cycle failed. Keep activeCarcass selected; autoEatStep/watchdog will retry
		-- the SAME object and the next cycle starts from the animal's new side.
		activeCarcass = carcass
		activeCarcassCommitted = false
		carcassEatBusy = false
		runtimeMessage =
			"Carcass locked: Eat not confirmed yet; retrying SAME carcass"
		task.wait(0.45)
		return
	end

	local eatPromptReadyAtCommit =
		state.carcassEatPromptReady(character)

	if eatPromptReadyAtCommit then
		-- Preserve the exact orientation that produced the real Eat prompt.
		root.AssemblyAngularVelocity = Vector3.zero
	else
		state.faceCarcass(root, carcassRoot, carcass)
	end

	-- From this point the carcass is a committed target. Hunger thresholds,
	-- passive patrol, quest scanning and watchdog reacquisition are forbidden
	-- from selecting another carcass until this Instance disappears.
	activeCarcass = carcass
	activeCarcassCommitted = true

	-- Se autoEat foi desligado nesse meio tempo (ex: o script está saindo
	-- da água por causa do autoDrink), aborta e não segura a posição —
	-- senão essa rotina briga com o movimento de saída da água.
	if not state.autoEat then
		carcassEatBusy = false
		return
	end

	-- Se mesmo depois do movimento o animal ficou nadando, a carcaça está
	-- na água (ou embaixo dela) e essa detecção de "underwater" pode ter
	-- falhado antes (ex: correnteza moveu a carcaça). Ignora e desiste.
	if humanoid:GetState() == Enum.HumanoidStateType.Swimming then
		runtimeMessage =
			"Locked carcass retained while water recovery takes priority"
		carcassEatBusy = false
		return
	end

	-- Não ancora (isso pode travar animação/física e conflitar com o servidor).
	-- Em vez disso segura a posição perto da carcaça zerando a velocidade e
	-- corrigindo se o animal escorregar, igual à barreira de natação.
	local holdPosition = root.Position

	setSubState("Eating")

	-- Fire ONLY after the physical-distance gate above passed.
	if CarcassRemote
		and state.carcassEatAvailable(
			character,
			root,
			carcassRoot,
			carcass
		) then
		fireCarcassRemote(carcass)
	end

	runtimeMessage = "Eating carcass at close range"

	local startFood = character:GetAttribute("Food") or 0
	local foodEverRose = false
	local questReleasedAtFull = false
	local rexEating = state.isDinoRexMovementCharacter(character)
	local rexLastFoodProgressAt = tick()
	local carcassLastFoodProgressAt = tick()
	local carcassContactRetryAt = 0

	-- Outside active quest work, the committed carcass is still consumed until
	-- the Instance disappears. With actionable Auto Quests, however, Food 100 is
	-- a hard handoff point: release this carcass and resume missions immediately.
	while carcass.Parent do
		task.wait(0.3)

		if state.slotSwitchStagingActive == true
			or state.carcassController.cancelRequested
			or state.carcassController.token ~= carcassControllerToken then
			if state.slotSwitchStagingActive == true then
				clearActiveCarcass(true)
				runtimeMessage = "Carcass released: Reset Point staging owns the animal"
			end
			break
		end

		character, root, humanoid = characterParts()
		if character ~= workerCharacter
			or not character
			or not root
			or not humanoid then
			break
		end
		if not carcass.Parent then break end

		if state.carcassPrideRockForbidden(
			carcass,
			carcassRoot,
			character
		) then
			clearActiveCarcass(true)
			runtimeMessage =
				"Locked carcass released: inside Pride Rock protection circle"
			break
		end

		if state.carcassWaterUnsafe(carcass, carcassRoot) then
			ignoreCarcass(carcass, 180)
			clearActiveCarcass(true)
			runtimeMessage =
				"Locked carcass released: body entered water"
			break
		end

		-- Hard automation/safety transactions may temporarily suspend Eating, but
		-- they keep the SAME carcass locked so Auto Eat resumes it afterwards.
		if state.questGrowthReset.exclusive
			or not state.autoEat
			or (state.autoQuests and state.questSwimActive)
			or criticalRecoveryActive
			or DAMAGE.active
			or forcingPostDrinkMove then

			runtimeMessage =
				"Locked carcass paused; same carcass will resume after recovery"
			break
		end

		local liveWater = tonumber(character:GetAttribute("Water")) or 100
		if state.autoDrink and liveWater <= 70 then
			state.survivalForceWaterHandoff(
				character,
				"Locked carcass yielded to Water <=70"
			)
			drinkingToFull = true
			eatingToFull = false
			runtimeMessage =
				"Locked carcass paused: Water <=70%; searching for water"
			break
		end

		if humanoid:GetState() == Enum.HumanoidStateType.Swimming
			or detectAvailableFood(character) == "Drink" then
			runtimeMessage =
				"Locked carcass retained while Water takes priority"
			break
		end

		local curFood = character:GetAttribute("Food") or 0
		local now = tick()

		if curFood > startFood + 0.001 then
			startFood = curFood
			foodEverRose = true
			carcassLastFoodProgressAt = now

			if rexEating then
				rexLastFoodProgressAt = now
			end
		end

		if state.autoQuests == true
			and state.savannahHasLiveLocomotionQuest
			and state.savannahHasLiveLocomotionQuest() then

			local questFeedCommitted =
				state.questCarnivoreFeeding == true

			-- If this carcass was inherited from passive scavenging, actionable quests
			-- take it back immediately as soon as Food is above the real <=70 need.
			-- A feeding cycle that ACTUALLY started at the quest hunger threshold keeps
			-- the carcass until 100%, then releases it as before.
			if (not questFeedCommitted and curFood > 70)
				or (questFeedCommitted and curFood >= 100) then

				questReleasedAtFull = true
				runtimeMessage =
					questFeedCommitted
					and "Carnivore full; releasing carcass for Auto Quests"
					or "Auto Quests priority: releasing passive carcass immediately"
				break
			end
		end

		local rexPromptReady =
			rexEating
			and state.dinoRexCarcassPromptReady(character)

		-- If Dino Life is visibly offering Eat, DO NOT reposition. The prompt is
		-- stronger evidence than our geometry. Keep the exact pose and continuously
		-- reassert Eating/remote until Food begins to rise.
		if rexPromptReady then
			root.AssemblyLinearVelocity = Vector3.new(
				0,
				root.AssemblyLinearVelocity.Y,
				0
			)
			root.AssemblyAngularVelocity = Vector3.zero
			setSubState("Eating")
			fireCarcassRemote(carcass)
			runtimeMessage =
				"Rex Eat prompt confirmed; holding position and eating"
		end

		local genericEatPromptReady =
			(not rexEating)
				and state.carcassEatPromptReady(character)

		-- Savannah Lion/WildDog/etc. watchdog: geometry may still call the animal
		-- "close enough" while it is a few centimeters outside the real Eat volume.
		-- Food progress + the actual Eat HUD are the authority. If both are absent,
		-- physically close the remaining gap on the SAME carcass automatically.
		if isSavannahLife
			and not rexEating
			and not isAquaticCharacter(character)
			and not genericEatPromptReady
			and curFood < 99.5
			and now - carcassLastFoodProgressAt >= 1.05
			and now >= carcassContactRetryAt then

			carcassContactRetryAt = now + 0.65
			runtimeMessage =
				"Carcass Eat not active; closing final centimeters"

			state.carcassAcquireEatPrompt(
				carcassRoot,
				carcass,
				passiveScavenge
			)

			character, root, humanoid = characterParts()
			if character ~= workerCharacter
				or not character
				or not root
				or not humanoid
				or not carcass.Parent
				or not carcassRoot.Parent then
				break
			end

			holdPosition = root.Position
			if state.carcassEatPromptReady(character) then
				state.carcassPulseStartEating(
					character,
					root,
					carcassRoot,
					carcass
				)
				carcassLastFoodProgressAt = tick()
			end

			continue
		end

		-- Rex uses the SAME final-contact policy as Savannah. No angle orbit and no
		-- "close enough" assumption: if Food stalls and Eat is gone, move the mouth
		-- a little closer to the SAME carcass until the real Eat HUD returns.
		if rexEating
			and not rexPromptReady
			and curFood < 99.5
			and now - rexLastFoodProgressAt >= 1.25
			and now >= carcassContactRetryAt then

			carcassContactRetryAt = now + 0.65
			runtimeMessage =
				"Rex Eat not active; closing mouth gap on SAME carcass"

			state.carcassAcquireEatPrompt(
				carcassRoot,
				carcass,
				passiveScavenge
			)

			character, root, humanoid = characterParts()
			if character ~= workerCharacter
				or not character
				or not root
				or not humanoid
				or not carcass.Parent
				or not carcassRoot.Parent then
				break
			end

			holdPosition = root.Position
			if state.carcassEatPromptReady(character) then
				state.carcassPulseStartEating(
					character,
					root,
					carcassRoot,
					carcass
				)
			end

			rexLastFoodProgressAt = tick()
			continue
		end

		root.AssemblyLinearVelocity = Vector3.new(
			0,
			root.AssemblyLinearVelocity.Y,
			0
		)
		if (root.Position - holdPosition).Magnitude > 6 then
			state.safeNudgeToward(root, holdPosition, 0.30)
		end

		if RAGDOLL_STATES[humanoid:GetState()] then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end

		-- If either the carcass or animal drifted away, physically close the gap
		-- again BEFORE another remote call. Rex is exempt while the REAL Eat prompt
		-- is visible; moving in that state is exactly the regression fixed here.
		if not rexPromptReady
			and not state.carcassCloseEnough(
				character,
				root,
				carcassRoot,
				carcass
			) then
			runtimeMessage =
				"Carcass moved; re-approaching"

			approachCarcass(
				carcassRoot,
				1.5,
				passiveScavenge,
				carcass
			)
			task.wait(0.15)

			character, root, humanoid = characterParts()

			if character ~= workerCharacter
				or not character
				or not root
				or not humanoid
				or not state.carcassCloseEnough(
					character,
					root,
					carcassRoot,
					carcass
				) then
				break
			end

			holdPosition = root.Position
			state.faceCarcass(root, carcassRoot, carcass)
		end

		if CarcassRemote
			and (
				state.carcassEatAvailable(
					character,
					root,
					carcassRoot,
					carcass
				)
				or (
					rexEating
					and state.carcassCloseEnough(
						character,
						root,
						carcassRoot,
						carcass
					)
				)
			) then
			-- Rex prompt/detector may flicker off after the first bite even though
			-- the mouth is still physically at the same carcass. The committed-target
			-- geometry gate is enough to keep the server Eating remote alive.
			fireCarcassRemote(carcass)
		end

		setSubState("Eating")
	end

	character, root = characterParts()
	if character ~= workerCharacter then
		if activeCarcass == carcass then
			clearActiveCarcass(true)
		end
		carcassEatBusy = false
		return
	end

	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	if questReleasedAtFull then
		clearActiveCarcass(true)
		eatingToFull = false
		state.questCarnivoreFeeding = false
		eatingStuckSince = nil
		state.survivalArbiterComplete("food")
		state.questForceFastRecheckUntil = tick() + 12
		runtimeMessage =
			"Carnivore full; carcass released; Auto Quests resumed"
	elseif not carcass.Parent then
		clearActiveCarcass(true)
		runtimeMessage =
			"Locked carcass consumed; searching may continue"
	elseif activeCarcassCommitted and activeCarcass == carcass then
		-- No actionable quest is asking for the character, so preserve the user's
		-- original exclusive-carcass rule until this Instance disappears.
		runtimeMessage = foodEverRose
			and "Locked carcass still exists; continuing SAME carcass"
			or "Locked carcass still exists; retrying SAME carcass"
	end

	carcassEatBusy = false
end
-- ============================================================
-- v75: CARCASS INTERCEPTION DURING SPAWN SEARCH ROUTES
-- A carnivore must not walk past a usable carcass just because the current
-- search destination is MirageSpawn/another spawn. Long routes are split into
-- short physical legs; between legs we scan and eat any nearby carcass first.
-- ============================================================
function state.carcassOnSearchRoute(root, destination)
	if not root then return nil, nil end

	local routeDirection
	local routeDistance = 0

	if typeof(destination) == "Vector3" then
		local routeDelta = Vector3.new(
			destination.X - root.Position.X,
			0,
			destination.Z - root.Position.Z
		)

		routeDistance = routeDelta.Magnitude
		if routeDistance > 0.1 then
			routeDirection = routeDelta.Unit
		end
	end

	local bestCarcass
	local bestRoot
	local bestScore = math.huge
	local seen = {}

	local function consider(carcass, carcassRoot)
		carcass, carcassRoot = state.carcassCanonicalTarget(
			carcass,
			carcassRoot
		)

		if not carcass
			or not carcassRoot
			or not carcass.Parent
			or not carcassRoot.Parent
			or seen[carcass]
			or carcassIsIgnored(carcass) then
			return
		end

		seen[carcass] = true

		if not state.carcassCandidateUsable(
			carcass,
			carcassRoot,
			player.Character
		) then

			return
		end

		local toCarcass = Vector3.new(
			carcassRoot.Position.X - root.Position.X,
			0,
			carcassRoot.Position.Z - root.Position.Z
		)

		local distance = toCarcass.Magnitude

		-- Transit interception is deliberately local. This is not a new carcass
		-- hunting route; it only prevents walking past food already on/near the path.
		if distance > 150 then
			return
		end

		local lateral = 0
		local projection = distance

		if routeDirection and routeDistance > 25 and distance > 0.1 then
			projection = toCarcass:Dot(routeDirection)
			local projected = routeDirection * projection
			lateral = (toCarcass - projected).Magnitude

			-- Very close food is accepted even if the watchdog temporarily moved us
			-- slightly past it. Otherwise require a forward/side corridor.
			if distance > 42 then
				if projection < -10 then
					return
				end

				local corridor = math.clamp(
					state.movementFootprint(player.Character) * 2.0 + 24,
					38,
					68
				)

				if lateral > corridor then
					return
				end
			end
		end

		-- Prefer genuinely nearby/on-route carcasses. A small lateral penalty
		-- prevents a farther side carcass from beating one directly ahead.
		local score = distance + lateral * 0.55

		if score < bestScore then
			bestScore = score
			bestCarcass = carcass
			bestRoot = carcassRoot
		end
	end

	local function scan(container, namedOnly, storage)
		if not container then return end

		for _, object in ipairs(container:GetDescendants()) do
			if object:IsA("Model") then
				local lower = object.Name:lower()
				local acceptable = not namedOnly
					or lower:find("carcass", 1, true)
					or lower:find("carcaca", 1, true)

				if acceptable and object.Parent ~= storage then
					local part = object:FindFirstChild("HumanoidRootPart")
						or object:FindFirstChildWhichIsA("BasePart", true)

					if part then
						consider(object, part)
					end
				end
			end
		end
	end

	local storage = workspace:FindFirstChild("CarcassesStorageModel")
	if storage then
		-- Everything inside the dedicated carcass storage is a candidate, matching
		-- nearestCarcass(), but unlike the old route code we evaluate ALL of them.
		for _, object in ipairs(storage:GetDescendants()) do
			if object:IsA("Model") then
				local part = object:FindFirstChild("HumanoidRootPart")
					or object:FindFirstChildWhichIsA("BasePart", true)

				if part then
					consider(object, part)
				end
			end
		end
	end

	-- Fallback carcasses are event-cached once instead of rescanning all of
	-- Workspace every 0.25s during a spawn-search route.
	if not bestCarcass and (not isDinoLife or not storage) then
		for _, object in ipairs(state.carcassNamedFallbackModels()) do
			if object
				and object.Parent
				and object.Parent ~= storage then
				local part = object:FindFirstChild("HumanoidRootPart")
					or object:FindFirstChildWhichIsA("BasePart", true)
				if part then consider(object, part) end
			end
		end
	end

	return bestCarcass, bestRoot
end

function state.carnivoreSearchFoodTarget(
	character,
	passiveSearch
)
	if not character then
		return 92
	end

	if passiveSearch
		and state.carnivorePassiveScavengeAllowed
		and state.carnivorePassiveScavengeAllowed(
			character
		) then

		-- Food caps at 100. 100.5 intentionally means "do not stop the patrol
		-- merely because Food is full".
		return 100.5
	end

	if state.autoQuests
		and state.questCarnivoreFeeding
		and not preSwitchFoodTarget then
		return 100
	end

	return preSwitchFoodTarget or 92
end

function state.moveToCarcassSearchSpawn(
	destination,
	passiveSearch,
	forceContinuous
)
	if not destination
		or not destination.Parent
		or typeof(destination.Position) ~= "Vector3" then
		return false, "invalid_destination"
	end

	local finalPosition =
		destination.Position

	local routeStartedAt = tick()
	local routeStartPosition
	local resumeCount = 0
	local maxCarcassInterrupts = 8

	while state.alive
		and state.autoEat
		and not state.questGrowthReset.exclusive
		and not criticalRecoveryActive do

		local character, root =
			characterParts()

		if passiveSearch
			and (
				not state.carnivorePassiveScavengeAllowed
				or not state.carnivorePassiveScavengeAllowed(
					character
				)
			) then

			return false,
				"priority"
		end

		if not character or not root then
			return false, "no_character"
		end

		if not destination.Parent then
			return false, "destination_gone"
		end

		if not routeStartPosition then
			routeStartPosition =
				root.Position
		end

		local water =
			tonumber(
				character:GetAttribute("Water")
			) or 100

		-- Do not reference `drinkingToFull` here: this function is declared
		-- before that local exists in lexical scope.
		if state.waterShouldPreemptFood(
			character,
			72
		) then
			return false, "water_priority"
		end

		local food =
			tonumber(
				character:GetAttribute("Food")
			) or 100

		local targetFood =
			state.carnivoreSearchFoodTarget(
				character,
				passiveSearch
			)

		if food >= targetFood then
			return true, "fed"
		end

		local flat =
			Vector3.new(
				finalPosition.X - root.Position.X,
				0,
				finalPosition.Z - root.Position.Z
			)

		local remaining =
			flat.Magnitude

		if remaining <= 18 then
			return true, "arrived"
		end

		-- Check once immediately before starting/resuming the continuous route.
		local immediateCarcass, immediateRoot =
			state.carcassOnSearchRoute(
				root,
				finalPosition
			)

		if immediateCarcass and immediateRoot then
			runtimeMessage =
				"Carcass found before route; eating"

			eatCarcass(
				immediateCarcass,
				immediateRoot,
				passiveSearch
			)

			task.wait(0.10)

			resumeCount += 1

			if resumeCount >= maxCarcassInterrupts then
				return false, "too_many_carcass_interrupts"
			end

			continue
		end

		-- The callback stores the carcass and asks SafeMove to stop ONLY when
		-- there is genuinely something to eat. Normal route checks never stop it.
		state.carcassRouteInterrupt = nil

		local checkLastPosition =
			root.Position

		local checkLastMovedAt =
			tick()

		local moved =
			safeMoveToPosition(
				finalPosition,
				8,
				nil,
				{
					purpose = "food",
					tolerance = 18,
					speedScale = 1,

					-- v5.4: Spawn-search waypoints (including MirageSpawn) may legitimately
					-- sit across a river. Mark THIS route as intentional Food transit so both
					-- SafeMove's water-ahead steering and the Supervisor's core-body-water
					-- Safety check agree on the same owner instead of fighting each other.
					allowWaterTransit =
						isSavannahLife or isDinoLife,
					waterTransitKind = "carcass_search",

					-- Passive scavenging is transit, not precision interaction.
					-- Keep full speed through the spawn waypoint instead of the
					-- generic SafeMove 24-stud deceleration zone.
					constantSpeed =
						passiveSearch == true,

					maxDuration =
						forceContinuous
							and 90
							or (
								passiveSearch
									and 360
									or 90
							),
					routeCheckInterval =
						forceContinuous
							and 0.25
							or (
								passiveSearch
									and 0.35
									or 0.25
							),

					routeCheck = function(
						liveCharacter,
						liveRoot
					)
						if not destination.Parent then
							return true, "destination_gone"
						end

						if not state.autoEat
							or state.questGrowthReset.exclusive
							or criticalRecoveryActive then

							return true, "interrupted"
						end

						if passiveSearch
							and (
								not state.carnivorePassiveScavengeAllowed
									or not state.carnivorePassiveScavengeAllowed(
										liveCharacter
									)
							) then

							return true,
								"priority"
						end

						local liveWater =
							tonumber(
								liveCharacter:GetAttribute(
									"Water"
								)
							) or 100

						if state.waterShouldPreemptFood(
							liveCharacter,
							72
						) then
							return true, "water_priority"
						end

						local liveFood =
							tonumber(
								liveCharacter:GetAttribute(
									"Food"
								)
							) or 100

						if liveFood >=
							state.carnivoreSearchFoodTarget(
								liveCharacter,
								passiveSearch
							) then

							return true, "fed"
						end

						local movedSinceCheck =
							Vector3.new(
								liveRoot.Position.X
									- checkLastPosition.X,
								0,
								liveRoot.Position.Z
									- checkLastPosition.Z
							).Magnitude

						if movedSinceCheck >= 2 then
							checkLastPosition =
								liveRoot.Position

							checkLastMovedAt =
								tick()
						elseif tick()
							- checkLastMovedAt
							>= (
								forceContinuous
									and 5.5
									or (
										passiveSearch
											and 7.5
											or 5.5
									)
							) then

							state.carcassRouteLastSlowAt =
								tick()

							state.carcassRouteLastSlowPosition =
								liveRoot.Position

							if not passiveSearch
								or forceContinuous then
								-- Active survival AND passive-only quest patrol both require
								-- real movement. Never allow a dead spawn route to sit for minutes.
								return true,
									"food_search_stall"
							end

							checkLastMovedAt =
								tick()
						end

						local carcass, carcassRoot =
							state.carcassOnSearchRoute(
								liveRoot,
								finalPosition
							)

						if carcass and carcassRoot then
							state.carcassRouteInterrupt = {
								carcass = carcass,
								root = carcassRoot,
								detectedAt = tick(),
							}

							return true, "carcass"
						end

						return false
					end,
				}
			)

		local interruptReason =
			state.safeMove.routeInterruptReason

		local interrupt =
			state.carcassRouteInterrupt

		state.carcassRouteInterrupt = nil

		character, root =
			characterParts()

		if not character or not root then
			return false, "no_character"
		end

		-- Continuous SafeMove completed normally.
		if moved then
			local remainingAfter =
				Vector3.new(
					finalPosition.X - root.Position.X,
					0,
					finalPosition.Z - root.Position.Z
				).Magnitude

			if remainingAfter <= 22 then
				return true, "arrived"
			end

			-- Verification: a "successful" move that did not actually reach the
			-- spawn is abnormal. Retry once from the real current position.
			resumeCount += 1

			if resumeCount >= maxCarcassInterrupts then
				return false, "success_without_arrival"
			end

			runtimeMessage =
				"Route verification: destination not reached; continuing"

			task.wait(0.05)
			continue
		end

		if interruptReason == "carcass"
			and interrupt
			and interrupt.carcass
			and interrupt.root
			and interrupt.carcass.Parent
			and interrupt.root.Parent then

			local distance =
				(
					interrupt.root.Position
					- root.Position
				).Magnitude

			runtimeMessage =
				string.format(
					"Carcass intercepted on continuous route (%.0f studs)",
					distance
				)

			eatCarcass(
				interrupt.carcass,
				interrupt.root,
				passiveSearch
			)

			task.wait(0.10)

			-- If Eating was committed and the carcass still exists, the spawn route
			-- is finished for now. Never resume Mirage and walk away from that carcass.
			if activeCarcassCommitted
				and activeCarcassStillExists() then

				runtimeMessage =
					"Spawn patrol paused: finishing locked carcass"
				return true, "locked_carcass"
			end

			resumeCount += 1

			if resumeCount >= maxCarcassInterrupts then
				return false, "too_many_carcass_interrupts"
			end

			-- Carcass disappeared, so the same Mirage/spawn search may continue.
			continue
		end

		if interruptReason == "fed" then
			return true, "fed"
		elseif interruptReason == "water_priority" then
			return false, "water_priority"
		elseif interruptReason == "destination_gone" then
			return false, "destination_gone"
		elseif interruptReason == "priority" then
			return false, "priority"
		elseif interruptReason == "food_search_stall" then
			return false, "food_search_stall"
		elseif interruptReason == "interrupted" then
			return false, "interrupted"
		end

		-- SafeMove itself reported blocked/error/timeout.
		local routeDistance =
			routeStartPosition
			and Vector3.new(
				root.Position.X
					- routeStartPosition.X,
				0,
				root.Position.Z
					- routeStartPosition.Z
			).Magnitude
			or 0

		local totalTime =
			tick() - routeStartedAt

		state.carcassRouteLastFailure = {
			spawn = destination.Name,
			distanceMoved = routeDistance,
			duration = totalTime,
			position = root.Position,
			safeMoveError =
				state.safeMove.routeCheckError,
		}

		runtimeMessage =
			string.format(
				"Spawn route blocked after %.0f studs (%.1fs)",
				routeDistance,
				totalTime
			)

		return false, "blocked"
	end

	return false, "interrupted"
end



local drinkingToFull = false
local eatingToFull = false
-- Quando definidos (por growthStep, antes de trocar de slot), sobrescrevem
-- os tetos normais de "já tá bom" (92% comida / 98% água) para forçar
-- encher de verdade até perto de 100%, dando uma margem de segurança.
local preSwitchFoodTarget = nil
local preSwitchWaterTarget = nil

-- Eating is a server sub-state. Clearing eatingToFull/GIRAFFE.busy alone does not
-- stop the native "Click E to stop eating" state. This helper deliberately bypasses
-- setSubState()'s quest-reset guard so a completed feed can always hand locomotion
-- back to Quest/Growth before a slot move starts.
function state.eatStopPromptVisible()
	local playerGui = player:FindFirstChildOfClass("PlayerGui")
	if not playerGui then return false end

	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)

	for _, object in ipairs(playerGui:GetDescendants()) do
		if (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox"))
			and object.Visible
			and object.TextTransparency < 0.95 then

			local lower = tostring(object.Text or ""):lower()
			local stopText = lower:find("stop eating", 1, true)
				or lower:find("parar de comer", 1, true)

			if stopText then
				local centerX = object.AbsolutePosition.X + object.AbsoluteSize.X * 0.5
				local centerY = object.AbsolutePosition.Y + object.AbsoluteSize.Y * 0.5
				if centerY >= viewport.Y * 0.66
					and centerX >= viewport.X * 0.18
					and centerX <= viewport.X * 0.82 then
					return true
				end
			end
		end
	end

	return false
end

function state.forceStopEatingSubState(character, reason)
	character = character or player.Character
	if not character or character ~= player.Character then return false end

	blockClientSubState = false
	local sent = false

	-- One Walking packet was not enough in the failing Giraffe case: the server
	-- could still be inside its native Eating transaction for another frame. Send
	-- a short idempotent burst before Slots starts locomotion.
	if AskSubState then
		for _ = 1, 3 do
			local ok = pcall(AskSubState.InvokeServer, AskSubState, "Walking")
			sent = sent or ok == true
			task.wait(0.055)
		end
	end

	-- If Savannah explicitly says "stop eating", E is no longer ambiguous: it is
	-- the native STOP action, not the start-Eat action. Use it only under that exact
	-- prompt, then reassert Walking once more.
	if state.eatStopPromptVisible and state.eatStopPromptVisible() then
		pcall(function()
			local vim = game:GetService("VirtualInputManager")
			vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
			task.wait(0.045)
			vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
		end)
		task.wait(0.08)
		if AskSubState then
			local ok = pcall(AskSubState.InvokeServer, AskSubState, "Walking")
			sent = sent or ok == true
		end
	end

	blockClientSubState = false
	return sent
end

