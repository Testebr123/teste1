	for mode, data in pairs(
		state.autoDrinkModeButtons
	) do
		local crocBlocked =
			mode == "underground"
			and (
				isDinoLife
				or state.isCrocOrHippoMovementCharacter(player.Character)
			)

		local selected =
			state.autoDrinkMode == mode and not crocBlocked

		data.button.Active = not crocBlocked
		data.button.BackgroundTransparency = crocBlocked and 0.28 or 0

		data.button.BackgroundColor3 =
			selected
				and COLOR_CARD_ON
				or COLOR_CARD

		data.stroke.Color =
			selected
				and COLOR_ACCENT
				or Color3.fromRGB(
					48,
					24,
					42
				)

		data.title.TextColor3 =
			crocBlocked and COLOR_SUBTEXT
			or (selected and COLOR_ACCENT or COLOR_TEXT)

		data.radio.Text =
			crocBlocked and "×"
			or (selected and "●" or "○")

		data.radio.TextColor3 =
			crocBlocked and COLOR_SUBTEXT
			or (selected and COLOR_ACCENT or COLOR_SUBTEXT)
	end
end

