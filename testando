local function setSubState(name)
	-- Reset Point staging owns the completed animal's body exclusively. Once the
	-- slot-switch transaction starts, no legacy/opportunistic worker may restart
	-- Eating or Drinking behind the Slots controller. forceStopEatingSubState()
	-- talks to the server directly, so it can still send Walking to END Eating.
	if state.slotSwitchStagingActive == true
		and (name == "Eating" or name == "Drinking") then
		return
	end

	if name == "Drinking"
		and not state.aiSupervisorPermitsSubState("Water") then
		return
	end

	if name == "Eating"
		and not state.aiSupervisorPermitsSubState("Food") then
		return
	end

	if state.questGrowthReset and state.questGrowthReset.exclusive then
		return
	end

	if name == "Drinking" then
		local character =
			player.Character

		if state.herbivoreFoodRecovery
			and state.herbivoreFoodRecovery.active
			and state.herbivoreFoodRecovery.character
				== character then

			return
		end

		if character then
			local food =
				tonumber(
					character:GetAttribute(
						"Food"
					)
				) or 100

			local water =
				tonumber(
					character:GetAttribute(
