		or water > topUp.lastWater + 0.01 then

		topUp.lastWater = water
		topUp.lastProgressAt = now
	else
		topUp.lastProgressAt =
			topUp.lastProgressAt > 0
				and topUp.lastProgressAt
				or now
	end

	return true
end

task.spawn(function()
