function state.cancelManualMove()
	if not state.safeMove.active
		or state.safeMove.reason ~= "manual" then

		runtimeMessage =
			"No manual Move To route is active"

		state.renderMoveToCancelButton()
		return false
	end

	-- safeMoveToPosition checks this token every Heartbeat. Incrementing it
	-- invalidates ONLY the currently running movement controller.
	state.safeMove.cancelToken += 1
	state.safeMove.manualCancelledAt = tick()

	-- An accidental spawn selection should not remain as the preferred
	-- post-drink exit destination after the user explicitly cancels it.
	selectedMoveToSpawn = nil

	local _, root, humanoid = characterParts()

	if humanoid then
		pcall(
			humanoid.Move,
			humanoid,
			Vector3.zero,
			false
		)
	end

	if root then
		local velocity = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(
			0,
			velocity.Y,
			0
		)
		root.AssemblyAngularVelocity =
			root.AssemblyAngularVelocity * 0.20
	end

	if state.questSetW then
		pcall(state.questSetW, false)
	end

	runtimeMessage = "Move To cancelled"

	-- Do not forcibly set state.busy=false here. The movement coroutine owns
	-- cleanup and releases it on the next Heartbeat, avoiding controller races.
	state.renderMoveToCancelButton()
	return true
end

function state.safeMoveRunRouteCheck(
	options,
	character,
	root,
	humanoid,
	position
)
	if type(options) ~= "table"
		or type(options.routeCheck) ~= "function" then
		return false
	end

	local now = tick()
	local interval =
		tonumber(
			options.routeCheckInterval
		) or 0.35

	if now
		- (
			state.safeMove.routeCheckAt
			or 0
		) < interval then
		return false
	end

	state.safeMove.routeCheckAt = now

	local ok, shouldInterrupt, reason =
		pcall(
			options.routeCheck,
			character,
			root,
			humanoid,
			position
		)

	if not ok then
		-- A monitoring callback must never kill the actual movement controller.
		state.safeMove.routeCheckError =
			tostring(shouldInterrupt)
		return false
	end

	if shouldInterrupt == true then
		state.safeMove.routeInterruptReason =
			reason or "route_interrupt"
		return true
	end

	return false
end

local function safeMoveToPosition(position, maxAttempts, faceTowards, options)
	if typeof(position) ~= "Vector3" then return false end

	options = type(options) == "table" and options or {}

	-- v97 Underground Drink owns movement while the animal can be under Terrain.
	-- Cancel requests a controlled surface exit; it never releases automation
	-- immediately while still buried.
	if state.drinkTest
		and state.drinkTest.active
		and options.purpose ~= "safety" then
		return false
	end

	-- v80: while a Savannah HERBIVORE is in a Growth mode, automatic food
	-- movement is never allowed to leave Pride Rock. Water routes remain exempt.
	if options.purpose == "food"
		and state.growthPrideRestrictionActive(
			player.Character
		)
		and not state.autoFoodPositionAllowed(
			position
		) then

		runtimeMessage =
			"Growth herbivore: outside-Pride food target rejected"

		return false
	end

	if state.questGrowthReset
		and state.questGrowthReset.exclusive
		and options.allowDuringGrowthReset ~= true then
		return false
	end

	if state.busy then return false end

	local character, root, humanoid = characterParts()
	if not character or not root or not humanoid then return false end

	local requestedPurpose =
		options.purpose or "movement"

	local aquaticLandPreflight =
		state.isCrocOrHippoMovementCharacter(
			character
		)
		and requestedPurpose ~= "water"
		and requestedPurpose ~= "safety"
		and options.swimming ~= true
		and options.vertical ~= true
		and options.rawVerticalTransit ~= true
		and type(
			state.isBodyActuallyInWater
		) == "function"
		and type(
			state.moveAquaticToDryTerrain
		) == "function"
		and state.isBodyActuallyInWater(
			character,
			root
		)

	if aquaticLandPreflight then
		runtimeMessage =
			CROC.isCharacter(character)
				and "Croc river exit: reaching dry bank before land movement"
				or "Hippo river exit: reaching dry bank before land movement"

		local escaped =
			state.moveAquaticToDryTerrain(
				character,
				root,
				position
			)

		if not escaped then
			runtimeMessage =
				CROC.isCharacter(character)
					and "Croc river exit failed; land route postponed"
					or "Hippo river exit failed; land route postponed"
			return false
		end

		character, root, humanoid =
			characterParts()

		if not character
			or not root
			or not humanoid then
			return false
		end
	end

	state.busy = true
	state.safeMove.active = true
	state.safeMove.target = position
	state.safeMove.reason = options.purpose or "movement"
	state.safeMove.startedAt = tick()
	state.safeMove.lastProgressAt = tick()
	state.safeMove.lastDistance = math.huge
	state.safeMove.routeCheckAt = 0
	state.safeMove.routeCheckError = nil
	state.safeMove.routeInterruptReason = nil

	state.safeMove.heavy = state.isHeavyGroundMover(character)
	state.safeMove.probeHeight = state.movementProbeHeight(character)
	state.safeMove.nativeW = false

	state.safeMove.hill = {
		sign = nil,
		startedAt = 0,
		progressAt = 0,
		anchor = nil,
		escapeDirection = nil,
		bestProjection = 0,
		bestTargetDistance = math.huge,
		switchCount = 0,
		leftScore = nil,
		rightScore = nil,
	}

	if state.safeMove.reason == "manual" then
		state.safeMove.manualLabel =
			options.manualLabel
			or state.safeMove.manualLabel
	else
		state.safeMove.manualLabel = nil
	end

	state.safeMove.cancelToken += 1

	if state.renderMoveToCancelButton then
		pcall(state.renderMoveToCancelButton)
	end

	local token = state.safeMove.cancelToken
	local stallBudget = math.max(2, tonumber(maxAttempts) or 8)
	local purpose = options.purpose or "generic"
	local aquaticBankClimber =
		state.isCrocOrHippoMovementCharacter(
			character
		)
	local tolerance = tonumber(options.tolerance) or MOVE_TOLERANCE
	local speedScale =
		math.clamp(tonumber(options.speedScale) or 1, 0.05, 1)
	local speedCap = tonumber(options.maxSpeed)
	local constantSpeed = options.constantSpeed == true
	local stopOnDryGround = options.stopOnDryGround == true
	local forceVertical = options.vertical == true
	local swimApproach = options.swimming == true

	-- v98: optional precise vertical completion.
	-- Routes that do not set this keep the old SafeMove behavior.
	local strictVerticalTolerance =
		tonumber(
			options.verticalTolerance
		)

	-- v99: only the underground Underground Drink opts into this.
	-- SafeMove still changes position only through velocity.
	local rawVerticalTransit =
		options.rawVerticalTransit == true

	local riverApproach =
		options.riverApproach == true
	local riverApproachRadius =
		tonumber(
			options.riverApproachRadius
		) or 36

	-- A Swim destination should NOT disable land obstacle avoidance across the
	-- whole map. Only the final approach near the saved water point becomes 3D
	-- Swimming movement.
	local swimActivationDistance =
		tonumber(options.swimActivationDistance) or 58

	local obstacleSign = ((player.UserId % 2) == 0) and 1 or -1
	local stallCount = 0
	local lastDistance = math.huge
	local lastProgressAt = tick()
	local lastJumpAt = 0

	-- Track the SAME blocking object/terrain across frames. We steer first;
	-- Space is virtualized only if the obstacle persists or movement stalls.
	local lastBlockingInstance = nil
	local blockingSince = 0

	-- High-hill avoidance state. Lock one side briefly so the animal does not
	-- oscillate left/right while skirting a mountain.
	local hillAvoidUntil = 0
	local hillAvoidSign = obstacleSign
	local lastHillCheckAt = 0

	local lastMoveWReassertAt = 0

	local function terrainHeightAt(worldPosition, referenceY)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { workspace.Terrain }
		params.IgnoreWater = false

		local castTop = math.max(
			referenceY + 320,
			worldPosition.Y + 320
		)

		local hit = workspace:Raycast(
			Vector3.new(
				worldPosition.X,
				castTop,
				worldPosition.Z
			),
			Vector3.new(0, -700, 0),
			params
		)

		if not hit or hit.Material == Enum.Material.Water then
			return nil
		end

		return hit.Position.Y
	end

	local function chooseHillAvoidSide(rootPosition, forward, currentGroundY)
		local hill =
			state.safeMove.hill

		-- If the currently committed side is still making recent progress,
		-- KEEP IT. Do not reevaluate every couple seconds and oscillate.
		if hill
			and hill.sign
			and tick() - (hill.progressAt or 0) < 2.6 then

			return hill.sign
		end

		local function rotateHeading(sign, degrees)
			local angle =
				math.rad(degrees * sign)

			local c = math.cos(angle)
			local s = math.sin(angle)

			return Vector3.new(
				forward.X * c - forward.Z * s,
				0,
				forward.X * s + forward.Z * c
			).Unit
		end

		local function sideScore(sign)
			local heading =
				rotateHeading(sign, 58)

			local score = 0
			local lastY = currentGroundY
			local maxRise = 0

			-- Look down the actual escape corridor, not just one shoulder point.
			for _, distance in ipairs({
				14,
				24,
				38,
				54,
				72,
				92,
			}) do
				local point =
					rootPosition
					+ heading * distance

				local y =
					terrainHeightAt(
						point,
						rootPosition.Y
					)

				if y then
					local rise =
						y - currentGroundY

					local stepRise =
						y - lastY

					maxRise =
						math.max(
							maxRise,
							rise
						)

					-- Rising Terrain is increasingly expensive.
					if rise > 0 then
						score += rise * 1.15
					end

					if rise > 18 then
						score +=
							(rise - 18) * 3.2
					end

					if rise > 32 then
						score +=
							(rise - 32) * 4.5
					end

					-- A sudden wall between samples is a very bad corridor.
					if stepRise > 9 then
						score +=
							stepRise * 3.0
					end

					-- Avoid selecting a huge cliff/drop as the "easy" side.
					if rise < -38 then
						score += 70
					end

					lastY = y
				else
					-- Missing/non-solid Terrain is uncertain, so don't treat it
					-- as a magically perfect path.
					score += 18
				end
			end

			-- Also inspect a wider shoulder that represents actually going
			-- AROUND the mountain rather than merely touching its edge.
			local sideVector =
				Vector3.new(
					-forward.Z,
					0,
					forward.X
				) * sign

			for _, probe in ipairs({
				{ 28, 36 },
				{ 48, 58 },
				{ 64, 78 },
			}) do
				local point =
					rootPosition
					+ forward * probe[1]
					+ sideVector * probe[2]

				local y =
					terrainHeightAt(
						point,
						rootPosition.Y
					)

				if y then
					local rise =
						y - currentGroundY

					if rise > 15 then
						score +=
							(rise - 15) * 2.4
					end
				else
					score += 12
				end
			end

			-- Physical wall/tree/rock check in the selected escape heading.
			local params = RaycastParams.new()
			params.FilterType =
				Enum.RaycastFilterType.Exclude

			params.FilterDescendantsInstances = {
				character,
			}

			params.IgnoreWater = true

			local obstacle =
				workspace:Raycast(
					rootPosition
						+ Vector3.new(
							0,
							2.5,
							0
						),
					heading * 32,
					params
				)

			if obstacle
				and math.abs(
					obstacle.Normal.Y
				) < 0.72 then

				score +=
					obstacle.Instance
						== workspace.Terrain
						and 130
						or 65
			end

			-- Remember a side that ALREADY FAILED near this same mountain.
			local failedUntil =
				sign < 0
					and (
						state.safeMove.hillFailureLeftUntil
						or 0
					)
					or (
						state.safeMove.hillFailureRightUntil
						or 0
					)

			local failedPosition =
				sign < 0
					and state.safeMove.hillFailureLeftPosition
					or state.safeMove.hillFailureRightPosition

			if tick() < failedUntil
				and typeof(failedPosition)
					== "Vector3"
				and (
					failedPosition
					- rootPosition
				).Magnitude <= 95 then

				score += 500
			end

			return score, maxRise
		end

		local leftScore =
			sideScore(-1)

		local rightScore =
			sideScore(1)

		if hill then
			hill.leftScore = leftScore
			hill.rightScore = rightScore
		end

		local preferred =
			hill
				and hill.sign
				or hillAvoidSign

		-- Hysteresis: if scores are close, keep the previous side.
		if preferred
			and math.abs(
				leftScore - rightScore
			) < 26 then

			return preferred
		end

		return leftScore < rightScore
			and -1
			or 1
	end

	local function cleanup()
		state.heavyWalkStop(character)
		local _, liveRoot, liveHumanoid = characterParts()

		if liveHumanoid then
			pcall(liveHumanoid.Move, liveHumanoid, Vector3.zero, false)
		end

		if liveRoot then
			local velocity = liveRoot.AssemblyLinearVelocity
			liveRoot.AssemblyLinearVelocity = Vector3.new(
				0,
				velocity.Y,
				0
			)
			liveRoot.AssemblyAngularVelocity =
				liveRoot.AssemblyAngularVelocity * 0.2
		end

		state.releaseMovementNow(player.Character, true)

		state.safeMove.landQuestW = false
		state.safeMove.nativeW = false
		state.safeMove.active = false
		state.safeMove.target = nil
		state.safeMove.reason = nil
		state.safeMove.manualLabel = nil
		state.busy = false
		lastSafeMoveAt = tick()

		if state.renderMoveToCancelButton then
			pcall(state.renderMoveToCancelButton)
		end
	end

	local callOk, result = pcall(function()
		local acceleration = state.safeMovementSpeed(character)
		local initialFlat = Vector3.new(
			position.X - root.Position.X,
			0,
			position.Z - root.Position.Z
		).Magnitude

		local maximumSpeed = math.max(
			4,
			acceleration * speedScale
		)

		if speedCap and speedCap > 0 then
			maximumSpeed = math.min(maximumSpeed, speedCap)
		end

		local maximumDuration =
			tonumber(options.maxDuration)
			or math.clamp(
				(initialFlat / math.max(maximumSpeed, 1)) * 3 + 24,
				20,
				420
			)

		local deadline = tick() + maximumDuration

		while state.alive
			and character.Parent
			and root.Parent
			and humanoid.Parent
			and humanoid.Health > 0
			and token == state.safeMove.cancelToken
			and tick() < deadline do

			-- v77: Acceleration can change after Swimming / landing.
			-- Re-read it continuously instead of keeping the initial value.
			local liveAcceleration =
				state.safeMovementSpeed(character)

			maximumSpeed = math.max(
				4,
				liveAcceleration * speedScale
			)

			if speedCap and speedCap > 0 then
				maximumSpeed =
					math.min(maximumSpeed, speedCap)
			end

			-- Water-exit routes finish the instant dry Terrain is confirmed.
			if stopOnDryGround
				and state.normalizeDryLandState
				and state.normalizeDryLandState(
					character,
					root
				) then
				return true
			end

			local food = tonumber(character:GetAttribute("Food")) or 100
			local water = tonumber(character:GetAttribute("Water")) or 100

			-- v96 optional continuous-route monitor.
			-- Used by carcass spawn search so it can scan while walking WITHOUT
			-- splitting the route into many SafeMove transactions.
			if state.safeMoveRunRouteCheck(
				options,
				character,
				root,
				humanoid,
				position
			) then
				return false
			end

			-- v84 HARD STOP:
			-- Keep the full v81 navigation UNTIL Savannah itself shows the
			-- real Drink prompt. At that exact frame, stop where we are.
			local waterGamePrompt =
				purpose == "water"
					and state.drinkGamePromptAvailable
					and state.drinkGamePromptAvailable(
						character
					)

			local waterVisualPrompt =
				purpose == "water"
					and state.drinkVisualPromptVisible
					and state.drinkVisualPromptVisible()

			if purpose == "water"
				and (
					waterGamePrompt
						or waterVisualPrompt
				) then

				if waterVisualPrompt then
					state.drinkLatchVisualPrompt()
				end

				state.drinkSearch.promptStopAt =
					root.Position

				state.drinkSearch.promptStopTime =
					tick()

				local velocity =
					root.AssemblyLinearVelocity

				root.AssemblyLinearVelocity =
					Vector3.new(
						0,
						velocity.Y,
						0
					)

				root.AssemblyAngularVelocity =
					Vector3.zero

				if state.questSetW then
					pcall(
						state.questSetW,
						false
					)
				end

				if faceTowards then
					local face = Vector3.new(
						faceTowards.X - root.Position.X,
						0,
						faceTowards.Z - root.Position.Z
					)

					if face.Magnitude > 0.25 then
						pcall(function()
							root.CFrame =
								CFrame.lookAt(
									root.Position,
									root.Position
										+ face.Unit,
									Vector3.yAxis
								)
						end)
					end
				end

				runtimeMessage =
					"Drink prompt visible; stopping at current edge"

				return true
			end

			-- Turning Auto Eat OFF cancels an already-running food route too.
			if purpose == "food"
				and not state.autoEat then
				runtimeMessage =
					"Auto Eat disabled; food movement cancelled"
				return false
			end

			-- Long walks yield to survival before the animal becomes unsafe.
			if purpose == "food" and water <= 72 then
				runtimeMessage =
					"Movement paused: Water priority took control"
				return false
			elseif purpose == "quest"
				and (food <= 66 or water <= 72) then
				runtimeMessage =
					"Quest movement paused for Food/Water"
				return false
			elseif purpose == "manual"
				and (
					(state.autoDrink and water <= 62)
					or (state.autoEat and food <= 52)
				) then
				runtimeMessage =
					"Move To paused for survival"
				return false
			end

			if DAMAGE.active and purpose ~= "safety" then
				return false
			end

			if criticalRecoveryActive
				and purpose ~= "safety"
				and purpose ~= "water" then
				return false
			end

			local current = root.Position
			local flatDelta = Vector3.new(
				position.X - current.X,
				0,
				position.Z - current.Z
			)

			local flatDistance =
				flatDelta.Magnitude

			if purpose == "manual"
				and tick()
					- (
						state.safeMove.manualStatusAt
							or 0
					) >= 0.75 then

				state.safeMove.manualStatusAt =
					tick()

				runtimeMessage =
					string.format(
						"Move To WORLD: %s · %.0f studs restantes",
						tostring(
							state.safeMove.manualLabel
								or "location"
						),
						flatDistance
					)
			end

			-- High-hill progress is NOT the same as "distance to destination".
			-- Going around a mountain may temporarily move sideways or even a
			-- little farther from the destination. Measure advancement along the
			-- committed escape heading too.
			if tick() < hillAvoidUntil
				and state.safeMove.hill
				and state.safeMove.hill.sign
				and state.safeMove.hill.anchor
				and state.safeMove.hill.escapeDirection then

				local escapeDelta =
					Vector3.new(
						current.X
							- state.safeMove.hill.anchor.X,
						0,
						current.Z
							- state.safeMove.hill.anchor.Z
					)

				local projection =
					escapeDelta:Dot(
						state.safeMove.hill.escapeDirection
					)

				local madeEscapeProgress =
					projection
						> (
							state.safeMove.hill.bestProjection
							or 0
						) + 2.25

				local madeTargetProgress =
					flatDistance
						< (
							state.safeMove.hill.bestTargetDistance
							or math.huge
						) - 2.5

				if madeEscapeProgress then
					state.safeMove.hill.bestProjection =
						projection
				end

				if madeTargetProgress then
					state.safeMove.hill.bestTargetDistance =
						flatDistance
				end

				if madeEscapeProgress
					or madeTargetProgress then

					state.safeMove.hill.progressAt =
						tick()

					-- Prevent generic stall logic from firing merely because
					-- we're moving laterally around the mountain.
					lastProgressAt = tick()
				end
			end

			local calmRiverApproach =
				riverApproach
				and purpose == "water"
				and flatDistance
					<= riverApproachRadius

			local animalKey =
				state.safeMovementAnimalKey(character)

			local flying =
				state.questFlyingAnimals
				and state.questFlyingAnimals[animalKey] == true

			local activeSwimApproach =
				swimApproach
				and flatDistance <= swimActivationDistance

			local verticalMovement =
				forceVertical or activeSwimApproach or flying

			-- Manual Move To and selected automatic routes use the same reliable
			-- WalkSpeed + Humanoid:MoveTo motor on EVERY terrestrial animal.
			-- forceMoveToLand is opt-in so unrelated food/water controllers keep
			-- their existing behavior. ZoneTime uses it to match Move To Locations.
			local moveToDrivenLand =
				not verticalMovement
					and (
						state.safeMove.heavy
							or purpose == "manual"
							or options.forceMoveToLand == true
					)

			-- If a terrestrial TravelDistance/Run quest is pending, any normal
			-- physical Move across land also holds virtual W. This lets routes to
			-- Food/Water/Zone/Move To contribute distance in the background.
			-- Release W near the destination so precise interaction is not pushed
			-- past the target.
			local landQuestW =
				state.autoQuests
				and state.questLandInputActive
				and not activeSwimApproach
				and not flying
				and purpose ~= "safety"
				and purpose ~= "spawn"
				and purpose ~= "manual"
				and not calmRiverApproach
				and flatDistance > math.max(tolerance * 2.5, 8)

			state.safeMove.landQuestW =
				landQuestW == true

			state.safeMove.nativeW = false

			if state.questSetW then
				if landQuestW then
					state.questMotionMoving = true
					state.questMotionMode = "Land"
					if tick() - lastMoveWReassertAt >= 3.5 then
						lastMoveWReassertAt = tick()
						state.questSetW(true, true)
					else
						state.questSetW(true)
					end
				else
					state.questSetW(false)
				end
			end

			local verticalGoal = position.Y

			if flying and not activeSwimApproach then
				verticalGoal = flatDistance > 30
					and math.max(position.Y + 18, current.Y)
					or position.Y + 5
			end

			local yError = verticalGoal - current.Y

			local reached =
				flatDistance <= tolerance
				and (
					not verticalMovement
					or math.abs(yError)
						<= (
							strictVerticalTolerance
								and math.max(
									0.5,
									strictVerticalTolerance
								)
								or math.max(
									tolerance,
									16
								)
						)
				)

			if reached then
				if faceTowards and root.Parent then
					local face = Vector3.new(
						faceTowards.X - root.Position.X,
						0,
						faceTowards.Z - root.Position.Z
					)

					if face.Magnitude > 0.5 then
						pcall(function()
							root.CFrame = CFrame.lookAt(
								root.Position,
								root.Position + face.Unit,
								Vector3.yAxis
							)
						end)
					end
				end

				return true
			end

			local progressDistance = verticalMovement
				and (position - current).Magnitude
				or flatDistance

			if progressDistance < lastDistance - 1.25 then
				lastDistance = progressDistance
				lastProgressAt = tick()
				stallCount = math.max(
					0,
					stallCount - 1
				)

			elseif rawVerticalTransit then
				-- Terrain crossing must not trigger side-steering or Space.
				if tick() - lastProgressAt >= 3.5 then
					runtimeMessage =
						"Underground Drink vertical transit made no progress"
					return false
				end

			elseif calmRiverApproach then
				-- The river bank itself must never trigger oscillation or jump.
				if tick() - lastProgressAt >= 3.2 then
					runtimeMessage =
						"River bank approach blocked; trying another exposed bank"
					return false
				end

			elseif tick() - lastProgressAt >= 1.35 then
				if tick() < hillAvoidUntil
					and state.safeMove.hill
					and state.safeMove.hill.sign then

					local hill =
						state.safeMove.hill

					-- Do NOTHING while the committed side is still producing
					-- real escape progress. No left/right flipping, no Space.
					if tick()
						- (hill.progressAt or 0)
						>= 3.4 then

						local failedSign =
							hill.sign

						if failedSign < 0 then
							state.safeMove.hillFailureLeftUntil =
								tick() + 18

							state.safeMove.hillFailureLeftPosition =
								root.Position
						else
							state.safeMove.hillFailureRightUntil =
								tick() + 18

							state.safeMove.hillFailureRightPosition =
								root.Position
						end

						hill.switchCount =
							(hill.switchCount or 0) + 1

						if hill.switchCount >= 3 then
							runtimeMessage =
								"Hill route trapped: both sides failed; restarting route"

							return false
						end

						local forward =
							flatDistance > 0.1
								and flatDelta.Unit
								or Vector3.new(
									root.CFrame.LookVector.X,
									0,
									root.CFrame.LookVector.Z
								).Unit

						local currentGroundY =
							terrainHeightAt(
								root.Position,
								root.Position.Y
							)
							or root.Position.Y

						-- The failed side receives a huge temporary penalty,
						-- so chooser strongly prefers the other real corridor.
						hill.sign = nil

						hillAvoidSign =
							chooseHillAvoidSide(
								root.Position,
								forward,
								currentGroundY
							)

						hill.sign =
							hillAvoidSign

						obstacleSign =
							hillAvoidSign

						hillAvoidUntil =
							tick() + 6.5

						hill.startedAt =
							tick()

						hill.progressAt =
							tick()

						hill.anchor =
							root.Position

						local escapeAngle =
							math.rad(
								(
									62
									+ math.min(
										18,
										hill.switchCount * 8
									)
								)
								* hillAvoidSign
							)

						local c =
							math.cos(
								escapeAngle
							)

						local s =
							math.sin(
								escapeAngle
							)

						hill.escapeDirection =
							Vector3.new(
								forward.X * c
									- forward.Z * s,
								0,
								forward.X * s
									+ forward.Z * c
							).Unit

						hill.bestProjection = 0
						hill.bestTargetDistance =
							flatDistance

						stallCount = 0
						lastProgressAt = tick()

						runtimeMessage =
							"High hill: "
							.. (
								failedSign < 0
									and "LEFT"
									or "RIGHT"
							)
							.. " failed; committing "
							.. (
								hillAvoidSign < 0
									and "LEFT"
									or "RIGHT"
							)
					end
				else
					lastProgressAt = tick()
					stallCount += 1
					obstacleSign *= -1

					-- MoveTo-driven routes (Zone/Pride/manual/heavy) recover by
					-- re-routing, never by repeatedly virtualizing Space.
					if not moveToDrivenLand
						and not state.safeMove.heavy
						and tick() - lastJumpAt >= 1.6 then
						lastJumpAt = tick()
						state.virtualJump(character, humanoid, "safe_move_stall", 1.5)
					end

					if stallCount >= stallBudget then
						runtimeMessage =
							"Movement blocked; route will retry later"
						return false
					end
				end
			end

			state.safeMove.lastDistance = progressDistance
			state.safeMove.lastProgressAt = lastProgressAt

			local desired

			if verticalMovement then
				local three = Vector3.new(
					flatDelta.X,
					yError,
					flatDelta.Z
				)

				if three.Magnitude > 0.1 then
					desired = three.Unit
				end
			elseif flatDistance > 0.1 then
				desired = flatDelta.Unit
			end

			if not desired then
				RunService.Heartbeat:Wait()
				continue
			end

			-- Land animals avoid entering water while travelling across the map.
			-- Water routes are allowed to approach the shoreline only near the
			-- selected drinking destination. Aquatic animals are not restricted.
			if not calmRiverApproach
				and not (
					purpose == "water"
						and riverApproach
				)
				and not verticalMovement
				and flatDistance > tolerance * 1.5
				and not isAquaticCharacter(character) then

				local terrainProbe = RaycastParams.new()
				terrainProbe.FilterType = Enum.RaycastFilterType.Include
				terrainProbe.FilterDescendantsInstances = { workspace.Terrain }
				terrainProbe.IgnoreWater = false

				local aheadDistance =
					math.clamp(maximumSpeed * 0.28, 10, 34)

				local ahead = root.Position + desired * aheadDistance
				local groundAhead = workspace:Raycast(
					ahead + Vector3.new(0, 90, 0),
					Vector3.new(0, -180, 0),
					terrainProbe
				)

				local waterAhead =
					groundAhead
					and groundAhead.Material == Enum.Material.Water

				local mayApproachWater =
					purpose == "water"
					and flatDistance <= 48

				if waterAhead and not mayApproachWater then
					local angle = math.rad(68 * obstacleSign)
					local c = math.cos(angle)
					local s = math.sin(angle)

					desired = Vector3.new(
						desired.X * c - desired.Z * s,
						0,
						desired.X * s + desired.Z * c
					).Unit

					-- Water is a routing problem, not a jump target. Keep steering;
					-- the generic stall fallback will virtualize Space only if needed.
				end
			end

			-- ------------------------------------------------------------
			-- HIGH HILL / MOUNTAIN AVOIDANCE
			-- Regular slopes are allowed. We only divert when the terrain
			-- directly ahead rises sharply into a high peak, which is where the
			-- old straight-line Swim route tended to get stuck climbing.
			-- ------------------------------------------------------------
			if not calmRiverApproach
				and not verticalMovement
				and not (
					aquaticBankClimber
					and purpose == "safety"
				)
				and flatDistance
					> math.max(
						tolerance * 2,
						28
					) then

				if tick() >= hillAvoidUntil
					and tick() - lastHillCheckAt >= 0.28 then

					lastHillCheckAt = tick()

					local currentGroundY =
						terrainHeightAt(root.Position, root.Position.Y)
						or root.Position.Y

					local peakRise = 0
					local peakSlope = 0

					for _, sampleDistance in ipairs({ 18, 30, 46, 64, 82 }) do
						local samplePoint =
							root.Position + desired * sampleDistance

						local sampleY =
							terrainHeightAt(
								samplePoint,
								root.Position.Y
							)

						if sampleY then
							local rise =
								sampleY - currentGroundY

							if rise > peakRise then
								peakRise = rise
							end

							local slope =
								rise / math.max(sampleDistance, 1)

							if slope > peakSlope then
								peakSlope = slope
							end
						end
					end

					-- Intentionally conservative: do not dodge ordinary hills.
					-- Trigger only on a tall rise plus a steep approach.
					-- Food routes are allowed to climb substantial grassy slopes.
					-- Only a genuinely mountain-like wall should divert them.
					local foodRoute = purpose == "food"

					local highPeak
					local extremePeak

					if aquaticBankClimber then
						-- Croc/Hippo routinely climb steep river banks. The normal
						-- high-hill thresholds mistake a beach/ramp for a mountain
						-- and send them sideways along the shore. Only divert these
						-- two animals for a genuinely large terrain wall.
						highPeak =
							peakRise >= 46
							and peakSlope >= 0.68

						extremePeak =
							peakRise >= 62
					else
						highPeak = foodRoute
							and (
								peakRise >= 48
								and peakSlope >= 0.66
							)
							or (
								not foodRoute
								and peakRise >= 28
								and peakSlope >= 0.48
							)

						extremePeak = foodRoute
							and peakRise >= 66
							or (
								not foodRoute
								and peakRise >= 42
							)
					end

					if highPeak or extremePeak then
						hillAvoidSign =
							chooseHillAvoidSide(
								root.Position,
								desired,
								currentGroundY
							)

						-- Synchronize generic obstacle steering with the committed
						-- mountain side instead of letting two controllers fight.
						obstacleSign =
							hillAvoidSign

						hillAvoidUntil =
							tick() + 6.0

						local hill =
							state.safeMove.hill

						hill.sign =
							hillAvoidSign

						hill.startedAt =
							tick()

						hill.progressAt =
							tick()

						hill.anchor =
							root.Position

						hill.bestProjection = 0
						hill.bestTargetDistance =
							flatDistance

						local escapeAngle =
							math.rad(
								(
									62
									+ math.min(
										18,
										(hill.switchCount or 0) * 8
									)
								)
								* hillAvoidSign
							)

						local c =
							math.cos(
								escapeAngle
							)

						local s =
							math.sin(
								escapeAngle
							)

						hill.escapeDirection =
							Vector3.new(
								desired.X * c
									- desired.Z * s,
								0,
								desired.X * s
									+ desired.Z * c
							).Unit

						runtimeMessage =
							string.format(
								"High hill: committing %s (L %.0f / R %.0f, rise +%.0f)",
								hillAvoidSign < 0
									and "LEFT"
									or "RIGHT",
								tonumber(hill.leftScore)
									or -1,
								tonumber(hill.rightScore)
									or -1,
								peakRise
							)
					end
				end

				if tick() < hillAvoidUntil then
					local hillAngle =
						math.rad(
							(
								62
								+ math.min(
									18,
									(
										state.safeMove.hill
										and state.safeMove.hill.switchCount
										or 0
									) * 8
								)
							)
							* hillAvoidSign
						)

					local c = math.cos(hillAngle)
					local s = math.sin(hillAngle)

					desired = Vector3.new(
						desired.X * c - desired.Z * s,
						0,
						desired.X * s + desired.Z * c
					).Unit
				end
			end

			local terrainClimbAssist = 0

			-- Physical obstacle avoidance. It changes direction, never position.
			-- Terrain slopes are NOT treated like trees/rocks. Normal hills are
			-- climbed directly; only the high-hill detector above diverts them.
			if not verticalMovement
				and flatDistance > tolerance * 1.5 then

				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Exclude
				params.FilterDescendantsInstances = { character }
				params.IgnoreWater = true

				local probeDistance =
					math.clamp(maximumSpeed * 0.20, 7, 22)

				local volumeObjectProbe =
					moveToDrivenLand

				local obstacle =
					volumeObjectProbe
						and state.heavyObstacleProbe(
							character,
							root,
							desired,
							math.max(
								probeDistance,
								math.clamp(
									maximumSpeed * 0.42
										+ state.movementFootprint(
											character
										) * 0.85,
									16,
									46
								)
							)
						)
						or workspace:Raycast(
							root.Position
								+ Vector3.new(
									0,
									state.safeMove.probeHeight
										or 2.5,
									0
								),
							desired * probeDistance,
							params
						)

				if volumeObjectProbe
					and state.safeMove.heavyObstacleSign then
					obstacleSign =
						state.safeMove.heavyObstacleSign
				end

				if obstacle
					and (
						volumeObjectProbe
							or math.abs(
								obstacle.Normal.Y
							) < 0.72
					) then

					if obstacle.Instance ~= lastBlockingInstance then
						lastBlockingInstance = obstacle.Instance
						blockingSince = tick()
					elseif blockingSince <= 0 then
						blockingSince = tick()
					end

					local terrainHit =
						obstacle.Instance == workspace.Terrain

					if terrainHit
						and calmRiverApproach then

						-- River Terrain lip is destination geometry, not an obstacle.
						lastBlockingInstance = nil
						blockingSince = 0

					elseif terrainHit
						and tick() < hillAvoidUntil then

						-- High-hill controller already owns this Terrain.
						-- DO NOT reinterpret the mountain as a tree/rock,
						-- DO NOT apply obstacleSign again, and DO NOT jump.
						lastBlockingInstance = nil
						blockingSince = 0

					elseif terrainHit
						and tick()
							>= hillAvoidUntil then

						local currentGroundY =
							terrainHeightAt(
								root.Position,
								root.Position.Y
							)
							or root.Position.Y

						local aheadGroundY =
							terrainHeightAt(
								root.Position
									+ desired
										* math.min(
											probeDistance,
											12
										),
								root.Position.Y
							)

						local rise =
							aheadGroundY
								and (
									aheadGroundY
									- currentGroundY
								)
								or 0

						if rise > 1 and rise < 28 and not state.safeMove.heavy then
							local assistScale =
								purpose == "food"
									and 0.55
									or 0.35

							local assistCap =
								purpose == "food"
									and math.min(
										maximumSpeed * 0.45,
										16
									)
									or math.min(
										maximumSpeed * 0.30,
										11
									)

							terrainClimbAssist =
								math.min(
									assistCap,
									math.max(
										4,
										rise
											* assistScale
									)
								)
						end

						if not moveToDrivenLand
							and tick() - blockingSince >= 0.45
							and tick() - lastJumpAt >= 0.9 then

							lastJumpAt = tick()

							state.virtualJump(
								character,
								humanoid,
								"terrain_slope",
								0.85
							)
						end

					else
						-- Real tree/rock/building may still be steered around.
						local angle =
							math.rad(
								48
								* obstacleSign
							)

						local c = math.cos(angle)
						local s = math.sin(angle)

						desired =
							Vector3.new(
								desired.X * c
									- desired.Z * s,
								0,
								desired.X * s
									+ desired.Z * c
							).Unit

						if not moveToDrivenLand
							and not calmRiverApproach
							and tick() >= hillAvoidUntil
							and (
								tick() - blockingSince
									>= 0.70
								or stallCount > 0
							)
							and tick() - lastJumpAt
								>= 0.9 then

							lastJumpAt = tick()

							state.virtualJump(
								character,
								humanoid,
								"object_after_avoid",
								0.85
							)
						end
					end
				else
					lastBlockingInstance = nil
					blockingSince = 0
				end
			end

			if stallCount > 0
				and not calmRiverApproach
				and not verticalMovement
				and tick() >= hillAvoidUntil then
				local angle =
					math.rad(
						math.min(65, 24 + stallCount * 8)
						* obstacleSign
					)

				local c = math.cos(angle)
				local s = math.sin(angle)

				desired = Vector3.new(
					desired.X * c - desired.Z * s,
					0,
					desired.X * s + desired.Z * c
				).Unit
			end

			if rawVerticalTransit then
				pcall(function()
					humanoid.PlatformStand = true
					humanoid.AutoRotate = false
					humanoid:ChangeState(
						Enum.HumanoidStateType.Physics
					)
				end)

				character:SetAttribute(
					"MovementDisabled",
					true
				)

				root.AssemblyAngularVelocity =
					Vector3.zero
			end

			if not moveToDrivenLand then
				pcall(function()
					local face =
						Vector3.new(
							desired.X,
							0,
							desired.Z
						)

					if face.Magnitude > 0.1 then
						root.CFrame =
							CFrame.lookAt(
								root.Position,
								root.Position
									+ face.Unit,
								Vector3.yAxis
							)
					end
				end)
			end

			if not rawVerticalTransit then
				pcall(
					humanoid.Move,
					humanoid,
					moveToDrivenLand
						and Vector3.zero
						or Vector3.new(
							desired.X,
							0,
							desired.Z
						),
					false
				)
			else
				pcall(
					humanoid.Move,
					humanoid,
					Vector3.zero,
					false
				)
			end

			if activeSwimApproach then
				setSubState("Swimming")
			elseif flying then
				setSubState("Flying")
			elseif state.safeMove.heavy and flatDistance <= math.max(tolerance * 3, 24) then
				setSubState("Walking")
			else
				setSubState("Running")
			end

			-- Normal routes slow down near the target for precise positioning.
			-- Some interactions (notably grass eating) work better if the animal
			-- keeps its normal Acceleration speed until it reaches the target.
			local remainingScale = constantSpeed
				and 1
				or math.clamp(progressDistance / 24, 0.18, 1)

			local speed = math.min(
				maximumSpeed,
				math.max(4, maximumSpeed * remainingScale)
			)

			local velocity = root.AssemblyLinearVelocity

			if verticalMovement then
				root.AssemblyLinearVelocity = Vector3.new(
					desired.X * speed,
					math.clamp(desired.Y * speed, -maximumSpeed, maximumSpeed),
					desired.Z * speed
				)
			elseif moveToDrivenLand then
				-- v127 manual Move To and heavy land routes use the same reliable
				-- WalkSpeed + Humanoid:MoveTo execution engine.
				local moveOwner =
					purpose == "manual"
						and "manual"
						or "safeMove"

				local walked =
					state.heavyWalkStep(
						character,
						root,
						humanoid,
						desired,
						speed,
						progressDistance,
						position,
						moveOwner,
						token
					)

				if not walked then
					pcall(
						humanoid.MoveTo,
						humanoid,
						root.Position
					)
				end
			else
				root.AssemblyLinearVelocity = Vector3.new(
					desired.X * speed,
					terrainClimbAssist > 0 and math.max(velocity.Y, terrainClimbAssist) or velocity.Y,
					desired.Z * speed
				)
			end

			character:SetAttribute(
				"MovementDisabled",
				rawVerticalTransit
			)

			RunService.Heartbeat:Wait()
		end

		return false
	end)

	local cancelledByUser =
		purpose == "manual"
		and token ~= state.safeMove.cancelToken
		and state.safeMove.manualCancelledAt > 0
		and tick() - state.safeMove.manualCancelledAt <= 2

	cleanup()

	if cancelledByUser then
		runtimeMessage = "Move To cancelled"
		return false
	end

	if not callOk then
		runtimeMessage =
			"Movement controller error: "
			.. tostring(result)
		return false
	end

	return result == true
end

-- Folga vertical baseada no tamanho do animal para evitar colocar o pivot
-- dentro da superfície da água.
local function surfaceStandOffset(character)
	local ok, extents = pcall(function() return character:GetExtentsSize() end)
	if ok and extents then
		return math.clamp(extents.Y / 2, 3, 10)
	end
	return 4
end

local terrainParams = RaycastParams.new()
terrainParams.FilterType = Enum.RaycastFilterType.Include
terrainParams.FilterDescendantsInstances = { workspace.Terrain }
terrainParams.IgnoreWater = false
local failedGrassAreas = {}

local function rememberFailedGrass(position)
	if not position then return end
	for _, area in ipairs(failedGrassAreas) do
		if (area.position - position).Magnitude <= 50 then
			area.expiresAt = tick() + 300
			return
		end
	end
	table.insert(failedGrassAreas, { position = position, expiresAt = tick() + 300 })
end

local function grassAreaRecentlyFailed(position)
	local now = tick()
	for index = #failedGrassAreas, 1, -1 do
		local area = failedGrassAreas[index]
		if now >= area.expiresAt then
			table.remove(failedGrassAreas, index)
		elseif (area.position - position).Magnitude <= 50 then
			return true
		end
	end
	return false
end

local function findMaterial(origin, material, maximumRadius)
	for radius = 8, maximumRadius, 8 do
		for index = 0, 15 do
			local angle = index / 16 * math.pi * 2
			local probe = origin + Vector3.new(math.cos(angle) * radius, 90, math.sin(angle) * radius)
			local hit = workspace:Raycast(probe, Vector3.new(0, -190, 0), terrainParams)
			if hit and hit.Material == material then return hit.Position end
		end
	end
end

function state.drinkForgetExpiredFailures()
	local now = tick()
	for index = #state.drinkSearch.failedAreas, 1, -1 do
		if now >= state.drinkSearch.failedAreas[index].expiresAt then
			table.remove(state.drinkSearch.failedAreas, index)
		end
	end
end

function state.drinkAreaFailed(position)
	if not position then return false end
	state.drinkForgetExpiredFailures()

	for _, area in ipairs(state.drinkSearch.failedAreas) do
		local delta = Vector3.new(
			position.X - area.position.X,
			0,
			position.Z - area.position.Z
		)
		if delta.Magnitude <= 18 then
			return true
		end
	end
	return false
end

function state.drinkMarkFailed(position, seconds)
	if not position then return end
	state.drinkForgetExpiredFailures()

	for _, area in ipairs(state.drinkSearch.failedAreas) do
		local delta = Vector3.new(
			position.X - area.position.X,
			0,
			position.Z - area.position.Z
		)
		if delta.Magnitude <= 18 then
			area.expiresAt = tick() + (seconds or 150)
			return
		end
	end

	table.insert(state.drinkSearch.failedAreas, {
		position = position,
		expiresAt = tick() + (seconds or 150),
	})
end

function state.drinkMainWaterContainsXZ(part, x, z)
	if not part or not part:IsA("BasePart") then return false end

	local localPoint = part.CFrame:PointToObjectSpace(
		Vector3.new(x, part.Position.Y, z)
	)

	return math.abs(localPoint.X) <= part.Size.X * 0.5
		and math.abs(localPoint.Z) <= part.Size.Z * 0.5
end

function state.drinkMainWaterSurface(part, x, z)
	if not state.drinkMainWaterContainsXZ(part, x, z) then return nil end

	local top = part.Position.Y + part.Size.Y * 0.5
	local candidate = Vector3.new(x, top, z)

	-- MainWaterPart exists underneath huge portions of Savannah terrain.
	-- IMPORTANT: cast from FAR ABOVE the map. The old +55 ray could begin
	-- inside a hill and miss the covering terrain, accepting buried water.
	local castY = math.max(top + 1200, 1400)
	local terrainHit = workspace:Raycast(
		Vector3.new(x, castY, z),
		Vector3.new(0, -(castY - top + 1400), 0),
		terrainParams
	)

	if terrainHit then
		-- The first visible Terrain surface is water -> genuinely exposed.
		if terrainHit.Material == Enum.Material.Water then
			return terrainHit.Position
		end

		-- First visible surface is solid terrain above MainWaterPart.
		-- The water is buried and must NEVER be used.
		if terrainHit.Position.Y > top + 1.5 then
			return nil
		end
	end

	-- No covering Terrain was found above the MainWaterPart surface.
	return candidate
end

function state.drinkIsBuriedUnderTerrain(root)
	if not root then return false end

	-- Cast from far above so we see the actual top surface of Terrain.
	local x, z = root.Position.X, root.Position.Z
	local castY = math.max(root.Position.Y + 700, 1200)

	local hit = workspace:Raycast(
		Vector3.new(x, castY, z),
		Vector3.new(0, -(castY - root.Position.Y + 900), 0),
		terrainParams
	)

	if not hit or hit.Material == Enum.Material.Water then
		return false
	end

	-- If solid Terrain is materially ABOVE the HRP, the animal is under the map.
	return hit.Position.Y >= root.Position.Y + 4
end

function state.drinkLandingCovered(position)
	if not position then return true end

	local castY = math.max(position.Y + 700, 1200)
	local hit = workspace:Raycast(
		Vector3.new(position.X, castY, position.Z),
		Vector3.new(0, -(castY - position.Y + 900), 0),
		terrainParams
	)

	if not hit then
		return false
	end

	if hit.Material == Enum.Material.Water then
		return false
	end

	return hit.Position.Y > position.Y + 7
end

function state.drinkClearUndergroundMode()
	state.drinkSearch.undergroundMode = false
	state.drinkSearch.undergroundSince = 0
	state.drinkSearch.undergroundLastProgressAt = 0
	state.drinkSearch.undergroundLastWater = nil
end

function state.drinkFindUndergroundSpot(origin, character)
	if not isSavannahLife or not origin then return nil end

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	if not waterPart or not waterPart:IsA("BasePart") then return nil end

	local waterY = waterPart.Position.Y + waterPart.Size.Y * 0.5
	local angleOffset = (player.UserId % 360) * math.pi / 180

	local best
	local bestCover = math.huge

	-- Prefer the SHALLOWEST buried point near the player. We intentionally
	-- use buried MainWaterPart only when exposed water could not be found.
	for radius = 0, 520, 20 do
		local samples = radius == 0 and 1 or 16

		for index = 0, samples - 1 do
			local angle = angleOffset + index / samples * math.pi * 2
			local x = origin.X + math.cos(angle) * radius
			local z = origin.Z + math.sin(angle) * radius

			if state.drinkMainWaterContainsXZ(waterPart, x, z) then
				local waterPoint = Vector3.new(x, waterY, z)

				if not state.drinkAreaFailed(waterPoint) then
					local hit = workspace:Raycast(
						Vector3.new(x, math.max(origin.Y + 700, 1200), z),
						Vector3.new(0, -2200, 0),
						terrainParams
					)

					if hit and hit.Material ~= Enum.Material.Water then
						local cover = hit.Position.Y - waterY

						-- Must really be underground, but avoid extremely deep
						-- points when a shallower buried point is available.
						if cover >= 2 and cover < bestCover then
							bestCover = cover
							best = waterPoint
						end
					end
				end
			end
		end

		-- A shallow underground point is preferable to searching far away.
		if best and bestCover <= 18 then
			break
		end
	end

	if not best then return nil end

	local _, _, humanoid = characterParts()
	local lift = humanoid and math.max(humanoid.HipHeight, 1.5) or 2.5

	return {
		water = best,
		stand = best + Vector3.new(0, lift, 0),
		source = "UndergroundMainWaterPart",
		underground = true,
		coverDepth = bestCover,
	}
end

function state.drinkUndergroundSafety(character, root, humanoid, water)
	if not state.drinkSearch.undergroundMode then return false end
	if not character or not root or not humanoid then return true end

	local now = tick()
	local since = state.drinkSearch.undergroundSince or now
	local lastProgress = state.drinkSearch.undergroundLastProgressAt or since
	local previousWater = state.drinkSearch.undergroundLastWater

	-- Water gain proves that the hidden source is actually working.
	if type(water) == "number"
		and (previousWater == nil or water > previousWater + 0.05) then

		state.drinkSearch.undergroundLastWater = water
		state.drinkSearch.undergroundLastProgressAt = now
		lastProgress = now
	end

	-- Correct a bad ragdoll very quickly underground. It is okay to flip during
	-- descent, but never stay upside-down under Terrain.
	if state.drinkIsUpsideDown(root) then
		state.drinkUprightCharacter(
			character,
			root,
			state.drinkSearch.currentWaterPoint
		)

		task.wait(0.08)

		if state.drinkIsUpsideDown(root)
			and now - since >= 1.5 then

			state.drinkEmergencyEscape(
				character,
				root,
				"Agua subterranea: animal preso invertido; saindo antes de afogar"
			)
			return true
		end
	end

	-- If the hidden source doesn't increase Water, don't sit underground.
	if now - lastProgress >= 5.0 then
		state.drinkEmergencyEscape(
			character,
			root,
			"Agua subterranea sem progresso por 5s; abortando"
		)
		return true
	end

	-- Independent health failsafe: underground drinking should never consume a
	-- meaningful amount of HP.
	local maxHealth = math.max(humanoid.MaxHealth, 1)
	if state.drinkSearch.waterHealth == nil then
		state.drinkSearch.waterHealth = humanoid.Health
		state.drinkSearch.waterHealthAt = now
	else
		local lost = state.drinkSearch.waterHealth - humanoid.Health
		if lost >= maxHealth * 0.03 then
			state.drinkEmergencyEscape(
				character,
				root,
				"Agua subterranea: perdeu vida; escape anti-afogamento"
			)
			return true
		end
	end

	-- Hard ceiling even if something strange keeps changing Water.
	-- Normal drinking should finish well before this; if not, leave and retry.
	if now - since >= 22 then
		state.drinkEmergencyEscape(
			character,
			root,
			"Agua subterranea: limite de seguranca de 22s atingido"
		)
		return true
	end

	return false
end

function state.drinkFindBank(waterPosition)
	if not waterPosition then return nil end

	for radius = 4, 64, 4 do
		for index = 0, 15 do
			local angle = index / 16 * math.pi * 2
			local x = waterPosition.X + math.cos(angle) * radius
			local z = waterPosition.Z + math.sin(angle) * radius

			local hit = workspace:Raycast(
				Vector3.new(x, waterPosition.Y + 120, z),
				Vector3.new(0, -240, 0),
				terrainParams
			)

			if hit
				and hit.Material ~= Enum.Material.Water
				and math.abs(hit.Position.Y - waterPosition.Y) <= 11 then
				return hit.Position
			end
		end
	end
end

function state.drinkSolidTerrainHit(x, z, castY)
	if not state.drinkSolidTerrainParams then
		state.drinkSolidTerrainParams =
			RaycastParams.new()

		state.drinkSolidTerrainParams.FilterType =
			Enum.RaycastFilterType.Include

		state.drinkSolidTerrainParams.FilterDescendantsInstances = {
			workspace.Terrain,
		}

		state.drinkSolidTerrainParams.IgnoreWater = true
	end

	return workspace:Raycast(
		Vector3.new(x, castY, z),
		Vector3.new(0, -1800, 0),
		state.drinkSolidTerrainParams
	)
end

function state.drinkMainWaterExposedAt(waterPart, x, z, castY)
	if not waterPart
		or not waterPart:IsA("BasePart")
		or not state.drinkMainWaterContainsXZ(
			waterPart,
			x,
			z
		) then
		return false, nil
	end

	local waterY =
		waterPart.Position.Y
		+ waterPart.Size.Y * 0.5

	local hit =
		state.drinkSolidTerrainHit(
			x,
			z,
			castY
		)

	-- Do not interpret missing Terrain as a safe river.
	if not hit then
		return false, nil
	end

	-- MainWaterPart is visible here only when the solid Terrain floor is
	-- meaningfully BELOW the water surface. Terrain above/at the surface means
	-- MainWaterPart is buried and is rejected.
	return hit.Position.Y <= waterY - 0.35,
		hit
end

function state.drinkFindMainWaterBank(
	waterPosition,
	origin,
	waterPart,
	character
)
	if typeof(waterPosition) ~= "Vector3"
		or typeof(origin) ~= "Vector3"
		or not waterPart
		or not waterPart:IsA("BasePart") then
		return nil
	end

	local waterY =
		waterPart.Position.Y
		+ waterPart.Size.Y * 0.5

	local flat =
		Vector3.new(
			waterPosition.X - origin.X,
			0,
			waterPosition.Z - origin.Z
		)

	local distance = flat.Magnitude
	if distance <= 1 then
		return nil
	end

	local direction = flat.Unit
	local castY =
		math.max(
			origin.Y,
			waterY
		) + 420

	-- Candidate itself must be truly exposed MainWaterPart.
	local candidateExposed =
		state.drinkMainWaterExposedAt(
			waterPart,
			waterPosition.X,
			waterPosition.Z,
			castY
		)

	if not candidateExposed then
		return nil
	end

	local originExposed, originHit =
		state.drinkMainWaterExposedAt(
			waterPart,
			origin.X,
			origin.Z,
			castY
		)

	-- Large bodies can have HRP X/Z slightly over MainWaterPart while standing
	-- on the lip. In that case, use the nearest dry Terrain bank locally.
	if originExposed or not originHit then
		local localBank =
			state.drinkFindBank(
				waterPosition
			)

		if localBank then
			local localDistance =
				Vector3.new(
					localBank.X - origin.X,
					0,
					localBank.Z - origin.Z
				).Magnitude

			if localDistance <= 72 then
				return localBank,
					Vector3.new(
						waterPosition.X,
						waterY,
						waterPosition.Z
					)
			end
		end

		return nil
	end

	local step =
		math.clamp(
			distance / 80,
			3,
			9
		)

	local lastDryT = 0
	local lastDryHit = originHit
	local firstWetT
	local firstWetHit

	local t = step

	while t <= distance + 0.001 do
		local point =
			origin + direction * t

		local exposed, hit =
			state.drinkMainWaterExposedAt(
				waterPart,
				point.X,
				point.Z,
				castY
			)

		if exposed then
			firstWetT = t
			firstWetHit = hit
			break
		elseif hit then
			lastDryT = t
			lastDryHit = hit
		end

		t += step
	end

	-- Exact sampled point is already validated exposed.
	if not firstWetT then
		firstWetT = distance
	end

	if not lastDryHit then
		return nil
	end

	-- Resolve the FIRST dry -> exposed-water boundary on THIS side of the river.
	local low = math.max(0, lastDryT)
	local high = firstWetT
	local lowHit = lastDryHit

	for _ = 1, 9 do
		local mid =
			(low + high) * 0.5

		local point =
			origin + direction * mid

		local exposed, hit =
			state.drinkMainWaterExposedAt(
				waterPart,
				point.X,
				point.Z,
				castY
			)

		if exposed then
			high = mid
		elseif hit then
			low = mid
			lowHit = hit
		else
			-- Missing Terrain is not accepted as water.
			low = mid
		end
	end

	if not lowHit then
		return nil
	end

	-- One precomputed bank point. No movement refinement after arrival.
	local bankBackoff =
		CROC.isCharacter(character)
			and math.clamp(state.movementFootprint(character) * 0.20, 1.8, 3.4)
			or 0.80

	local standDistance = math.max(0, low - bankBackoff)

	local standXZ =
		origin
		+ direction * standDistance

	local standHit =
		state.drinkSolidTerrainHit(
			standXZ.X,
			standXZ.Z,
			castY
		)
		or lowHit

	if not standHit
		or standHit.Position.Y
			<= waterY - 0.20 then
		return nil
	end

	-- Face a point just INSIDE the water on the same near-side boundary.
	local waterDistance =
		math.min(
			distance,
			high + 0.85
		)

	local waterXZ =
		origin
		+ direction * waterDistance

	local exposedAtEdge =
		state.drinkMainWaterExposedAt(
			waterPart,
			waterXZ.X,
			waterXZ.Z,
			castY
		)

	if not exposedAtEdge then
		waterXZ =
			origin
			+ direction * high
	end

	return standHit.Position,
		Vector3.new(
			waterXZ.X,
			waterY,
			waterXZ.Z
		)
end

function state.drinkFindAccessibleSpot(origin, character)
	if not origin then return nil end

	state.drinkForgetExpiredFailures()

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	local isAquatic = isAquaticCharacter(character)
	local isCroc = CROC.isCharacter(character)
	local angleOffset = (player.UserId % 360) * math.pi / 180

	local function considerWaterPoint(waterPoint, source)
		if not waterPoint or state.drinkAreaFailed(waterPoint) then return nil end

		-- Crocodile is aquatic, but for drinking it intentionally remains on
		-- REAL Terrain at the bank. Hippo/other aquatic animals keep the old
		-- water-surface behavior.
		if isAquatic and not isCroc then
			return {
				water = waterPoint,
				stand = waterPoint + Vector3.new(0, state.aquaticWaterStandOffset(character), 0),
				source = source,
			}
		end

		local bank
		local finalWater = waterPoint

		if source == "MainWaterPart"
			and waterPart
			and waterPart:IsA("BasePart") then

			bank, finalWater =
				state.drinkFindMainWaterBank(
					waterPoint,
					origin,
					waterPart,
					character
				)
		else
			-- Puddles/Terrain Water keep the v92 behavior unchanged.
			bank =
				state.drinkFindBank(
					waterPoint
				)
		end

		if not bank then
			return nil
		end

		local _, _, humanoid = characterParts()
		local lift =
			humanoid
				and math.max(
					humanoid.HipHeight,
					1.5
				)
				or 2.5

		return {
			water = finalWater or waterPoint,
			stand = bank
				+ Vector3.new(
					0,
					lift,
					0
				),
			source = source,
		}
	end

	-- v94: nearby RIVER pass.
	-- MainWaterPart is used only as a sampling hint. Each candidate must pass
	-- solid-Terrain exposure validation AND near-side shoreline calculation.
	if isSavannahLife
		and waterPart
		and waterPart:IsA("BasePart") then

		for radius = 0, 300, 10 do
			local samples =
				radius == 0
					and 1
					or 24

			for index = 0, samples - 1 do
				local angle =
					angleOffset
					+ index / samples
						* math.pi * 2

				local x =
					origin.X
					+ math.cos(angle)
						* radius

				local z =
					origin.Z
					+ math.sin(angle)
						* radius

				local mainPoint =
					state.drinkMainWaterSurface(
						waterPart,
						x,
						z
					)

				if mainPoint then
					local found =
						considerWaterPoint(
							mainPoint,
							"MainWaterPart"
						)

					if found then
						return found
					end
				end
			end
		end
	end

	-- v125: dense LOCAL exposed-water pass.
	-- This runs before the wide 0-900 scan so a nearby puddle/river wins.
	for radius = 0, 420, 12 do
		local samples =
			radius == 0
				and 1
				or 32

		for index = 0, samples - 1 do
			local angle =
				angleOffset
					+ index / samples
						* math.pi * 2

			local x =
				origin.X
					+ math.cos(angle)
						* radius

			local z =
				origin.Z
					+ math.sin(angle)
						* radius

			local castY =
				math.max(
					origin.Y + 500,
					900
				)

			local terrainHit =
				workspace:Raycast(
					Vector3.new(
						x,
						castY,
						z
					),
					Vector3.new(
						0,
						-(castY + 350),
						0
					),
					terrainParams
				)

			if terrainHit
				and terrainHit.Material
					== Enum.Material.Water then

				local found =
					considerWaterPoint(
						terrainHit.Position,
						"Terrain"
					)

				if found then
					return found
				end
			end

			if waterPart
				and waterPart:IsA(
					"BasePart"
				) then

				local mainPoint =
					state.drinkMainWaterSurface(
						waterPart,
						x,
						z
					)

				if mainPoint then
					local found =
						considerWaterPoint(
							mainPoint,
							"MainWaterPart"
						)

					if found then
						return found
					end
				end
			end
		end
	end

	-- Existing v92 scanner remains intact below.
	-- Expanded exposed-water scan. A terrain ray must hit Water as the FIRST
	-- terrain surface, so buried MainWaterPart is still rejected.
	-- v65: regular search now reaches ~900 studs before the sparse long-range pass.
	for radius = 0, 900, 30 do
		local samples = radius == 0 and 1 or (radius <= 360 and 16 or 20)

		for index = 0, samples - 1 do
			local angle = angleOffset + index / samples * math.pi * 2
			local x = origin.X + math.cos(angle) * radius
			local z = origin.Z + math.sin(angle) * radius

			local castY = math.max(origin.Y + 700, 1200)
			local terrainHit = workspace:Raycast(
				Vector3.new(x, castY, z),
				Vector3.new(0, -(castY + 500), 0),
				terrainParams
			)

			if terrainHit and terrainHit.Material == Enum.Material.Water then
				local found = considerWaterPoint(terrainHit.Position, "Terrain")
				if found then return found end
			end

			-- MainWaterPart fallback, but ONLY after checking that this X/Z
			-- actually belongs to the part and that Terrain is not covering it.
			if waterPart and waterPart:IsA("BasePart") then
				local mainPoint = state.drinkMainWaterSurface(waterPart, x, z)
				if mainPoint then
					local found = considerWaterPoint(mainPoint, "MainWaterPart")
					if found then return found end
				end
			end
		end
	end

	-- v125: far search is emergency-only for normal land animals.
	local currentWater =
		character
			and tonumber(
				character:GetAttribute(
					"Water"
				)
			)
			or 100

	local allowFarSurfaceSearch =
		isCroc
			or currentWater <= 45

	if allowFarSurfaceSearch then
		for radius = 960, 1500, 60 do
			for index = 0, 15 do
				local angle =
					angleOffset
						+ index / 16
							* math.pi * 2

				local x =
					origin.X
						+ math.cos(angle)
							* radius

				local z =
					origin.Z
						+ math.sin(angle)
							* radius

				local castY =
					math.max(
						origin.Y + 700,
						1200
					)

				local terrainHit =
					workspace:Raycast(
						Vector3.new(
							x,
							castY,
							z
						),
						Vector3.new(
							0,
							-(castY + 500),
							0
						),
						terrainParams
					)

				if terrainHit
					and terrainHit.Material
						== Enum.Material.Water then

					local found =
						considerWaterPoint(
							terrainHit.Position,
							"Terrain"
						)

					if found then
						return found
					end
				end

				if waterPart
					and waterPart:IsA(
						"BasePart"
					) then

					local mainPoint =
						state.drinkMainWaterSurface(
							waterPart,
							x,
							z
						)

					if mainPoint then
						local found =
							considerWaterPoint(
								mainPoint,
								"MainWaterPart"
							)

						if found then
							return found
						end
					end
				end
			end
		end
	end
	-- Savannah fallback: use the known Swim water region if local scanning
	-- cannot find a usable source.
	if isSavannahLife
		and state.questSwimPosition
		and (
			state.questSwimActive
				or currentWater <= 35
		) then

		local center = state.questSwimPosition

		for radius = 0, 520, 20 do
			local samples = radius == 0 and 1 or 20
			for index = 0, samples - 1 do
				local angle = angleOffset + index / samples * math.pi * 2
				local x = center.X + math.cos(angle) * radius
				local z = center.Z + math.sin(angle) * radius

				local hit = workspace:Raycast(
					Vector3.new(x, 1200, z),
					Vector3.new(0, -2200, 0),
					terrainParams
				)

				if hit and hit.Material == Enum.Material.Water then
					local found = considerWaterPoint(hit.Position, "SavannahSafeWater")
					if found then return found end
				end
			end
		end
	end

end

function state.drinkAbandonCurrent(reason)
	state.drinkProgressReset()

	local point =
		state.drinkSearch.currentWaterPoint
		or drinkingSourcePosition
	if point then
		state.drinkMarkFailed(point, 150)
	end

	state.drinkSearch.currentWaterPoint = nil
	state.drinkSearch.promptStopAt = nil
	state.drinkSearch.promptStopTime = nil
	state.drinkSearch.failedCount = (state.drinkSearch.failedCount or 0) + 1
	state.drinkClearUndergroundMode()
	drinkingSourcePosition = nil
	drinkingStuckSince = nil
	lastDrinkWatchdogWater = nil
	removeSwimBarrier()

	runtimeMessage = reason or "Agua invalida; procurando outro local"

	-- After several failed sources, stop monopolizing the survival controller.
	-- This lets Auto Eat work while Auto Drink cools down, then water search
	-- resumes automatically a few seconds later.
	if state.drinkSearch.failedCount >= 3 then
		state.drinkSearch.failedCount = 0
		state.drinkSearch.retryAfter = tick() + 7
		drinkingToFull = false
		runtimeMessage = "3 pontos de agua falharam; liberando comida e tentando agua de novo em 7s"
	end
end

local function grassIsAwayFromOtherPlayers(position, minimumDistance)
	minimumDistance = minimumDistance or 35
	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player then
			local otherCharacter = otherPlayer.Character
			local otherRoot = otherCharacter and otherCharacter:FindFirstChild("HumanoidRootPart")
			local otherHumanoid = otherCharacter and otherCharacter:FindFirstChildOfClass("Humanoid")
			if otherRoot and (not otherHumanoid or otherHumanoid.Health > 0) then
				local horizontalDistance = (Vector3.new(position.X, 0, position.Z)
					- Vector3.new(otherRoot.Position.X, 0, otherRoot.Position.Z)).Magnitude
				if horizontalDistance < minimumDistance then return false end
			end
		end
	end
	return true
end

local grassRetryIgnorePosition
local grassRetryIgnoreUntil = 0
local grassRetryIgnoreRadius = 7

local function grassCandidateTemporarilyIgnored(position)
	return grassRetryIgnorePosition ~= nil
		and tick() < grassRetryIgnoreUntil
		and (
			Vector3.new(
				position.X - grassRetryIgnorePosition.X,
				0,
				position.Z - grassRetryIgnorePosition.Z
			).Magnitude
				<= (
					grassRetryIgnoreRadius
						or 7
				)
		)
end

local function temporarilyIgnoreGrass(
	position,
	seconds,
	radius
)
	grassRetryIgnorePosition =
		position

	grassRetryIgnoreUntil =
		tick() + (seconds or 3)

	grassRetryIgnoreRadius =
		math.max(
			4,
			tonumber(radius) or 7
		)
end

function state.grassTerrainHitAt(
	position,
	castHeight
)
	if typeof(position) ~= "Vector3" then
		return nil
	end

	local height =
		tonumber(castHeight) or 70

	local hit =
		workspace:Raycast(
			Vector3.new(
				position.X,
				math.max(
					position.Y + height,
					height
				),
				position.Z
			),
			Vector3.new(
				0,
				-(height * 2.4),
				0
			),
			terrainParams
		)

	if hit
		and hit.Material
			== Enum.Material.Grass
		and hit.Normal.Y >= 0.42 then

		return hit
	end

	return nil
end

function state.grassCandidateVerified(
	origin,
	position
)
	if typeof(origin) ~= "Vector3"
		or typeof(position) ~= "Vector3" then

		return false,
			nil,
			0
	end

	if grassCandidateTemporarilyIgnored(
		position
	) then
		return false,
			nil,
			0
	end

	if not state.autoFoodPositionAllowed(
		position
	) then
		return false,
			nil,
			0
	end

	local centerHit =
		state.grassTerrainHitAt(
			position,
			80
		)

	if not centerHit then
		return false,
			nil,
			0
	end

	-- Validate the PATCH around the point. One Grass voxel on the dirt/grass
	-- border is not enough to justify a route.
	local offsets = {
		Vector3.new(0, 0, 0),
		Vector3.new(3.5, 0, 0),
		Vector3.new(-3.5, 0, 0),
		Vector3.new(0, 0, 3.5),
		Vector3.new(0, 0, -3.5),
		Vector3.new(5.5, 0, 0),
		Vector3.new(-5.5, 0, 0),
		Vector3.new(0, 0, 5.5),
		Vector3.new(0, 0, -5.5),
	}

	local grassSamples = 0
	local accumulated =
		Vector3.zero

	for _, offset in ipairs(
		offsets
	) do
		local sampleHit =
			state.grassTerrainHitAt(
				centerHit.Position
					+ offset,
				70
			)

		if sampleHit then
			grassSamples += 1
			accumulated +=
				sampleHit.Position
		end
	end

	-- A real local feeding patch needs at least 5/9 Grass samples.
	if grassSamples < 5 then
		return false,
			nil,
			grassSamples
	end

	local verifiedCenter =
		accumulated
			/ grassSamples

	return true,
		verifiedCenter,
		grassSamples
end

local function findNearestGrass(origin)
	local rings = {
		{ 4, 20 },
		{ 7, 24 },
		{ 10, 24 },
		{ 14, 28 },
		{ 20, 28 },
		{ 28, 28 },
		{ 40, 32 },
		{ 56, 32 },
		{ 76, 32 },
		{ 96, 36 },
		{ 118, 36 },
	}

	local angleOffset =
		((player.UserId % 31) / 31)
			* (
				math.pi * 2 / 36
			)

	-- Rings are distance ordered. Within the first ring that contains usable
	-- grass, select the strongest patch instead of the first random ray hit.
	for _, ring in ipairs(rings) do
		local radius = ring[1]
		local samples = ring[2]

		local bestPoint
		local bestSamples = -1
		local bestDistance =
			math.huge

		for index = 0, samples - 1 do
			local angle =
				angleOffset
					+ index / samples
						* math.pi * 2

			local probe =
				origin
					+ Vector3.new(
						math.cos(angle)
							* radius,
						0,
						math.sin(angle)
							* radius
					)

			local valid,
				verifiedPoint,
				patchSamples =
					state.grassCandidateVerified(
						origin,
						probe
					)

			if valid and verifiedPoint then
				local distance =
					Vector3.new(
						verifiedPoint.X
							- origin.X,
						0,
						verifiedPoint.Z
							- origin.Z
					).Magnitude

				if patchSamples > bestSamples
					or (
						patchSamples == bestSamples
						and distance < bestDistance
					) then

					bestPoint =
						verifiedPoint

					bestSamples =
						patchSamples

					bestDistance =
						distance
				end
			end
		end

		if bestPoint then
			return bestPoint,
				bestDistance,
				bestSamples
		end
	end

	return nil
end

local function findDistantGrass(origin)
	local angleOffset =
		(player.UserId % 360)
			* math.pi / 180

	for _, radius in ipairs({
		150,
		190,
		240,
		300,
		370,
		440,
	}) do
		local bestPoint
		local bestSamples = -1

		for index = 0, 23 do
			local angle =
				angleOffset
					+ index / 24
						* math.pi * 2

			local probe =
				origin
					+ Vector3.new(
						math.cos(angle)
							* radius,
						0,
						math.sin(angle)
							* radius
					)

			local valid,
				verifiedPoint,
				patchSamples =
					state.grassCandidateVerified(
						origin,
						probe
					)

			if valid
				and verifiedPoint
				and patchSamples > bestSamples then

				bestPoint =
					verifiedPoint

				bestSamples =
					patchSamples
			end
		end

		if bestPoint then
			return bestPoint
		end
	end

	return nil
end

local function moveToGrass(
	grassPosition,
	speedOverride
)
	local character,
		root =
		characterParts()

	if not character or not root then
		return false,
			"no_character"
	end

	local valid,
		verifiedPoint =
			state.grassCandidateVerified(
				root.Position,
				grassPosition
			)

	if not valid
		or not verifiedPoint then

		return false,
			"invalid_grass"
	end

	grassPosition =
		verifiedPoint

	local routeStart =
		root.Position

	local startDistance =
		Vector3.new(
			grassPosition.X
				- routeStart.X,
			0,
			grassPosition.Z
				- routeStart.Z
		).Magnitude

	-- Normal Auto Eat never accepts a "local" route that is hundreds of studs
	-- away. Distant emergency search is handled separately.
	local emergencyRoute =
		startDistance > 125

	if emergencyRoute
		and (
			tonumber(
				character:GetAttribute(
					"Food"
				)
			) or 100
		) > 35 then

		return false,
			"too_far"
	end

	local lastTerrainCheckAt = 0

	local options = {
		purpose = "food",
		tolerance = 3.0,
		speedScale = 1,
		constantSpeed = true,

		maxDuration =
			math.clamp(
				startDistance
					/ math.max(
						state.safeMovementSpeed(
							character
						),
						8
					)
					* 3
					+ 7,
				8,
				emergencyRoute
					and 55
					or 28
			),

		routeCheckInterval = 0.07,

		routeCheck = function(
			liveCharacter,
			liveRoot
		)
			if not liveCharacter
				or not liveRoot then

				return true,
					"grass_character_lost"
			end

			-- Savannah itself is the final authority.
			if state.grassEatAvailable(
				liveCharacter
			) then
				return true,
					"grass_prompt"
			end

			local now =
				tick()

			if now - lastTerrainCheckAt
				>= 0.30 then

				lastTerrainCheckAt =
					now

				local stillValid =
					state.grassCandidateVerified(
						liveRoot.Position,
						grassPosition
					)

				if not stillValid then
					return true,
						"grass_invalid"
				end
			end

			local currentToTarget =
				Vector3.new(
					grassPosition.X
						- liveRoot.Position.X,
					0,
					grassPosition.Z
						- liveRoot.Position.Z
				).Magnitude

			local movedFromStart =
				Vector3.new(
					liveRoot.Position.X
						- routeStart.X,
					0,
					liveRoot.Position.Z
						- routeStart.Z
				).Magnitude

			-- Hard anti-tour guard. A 20-stud grass target may require a small
			-- obstacle detour; it may NOT turn into a 300-stud sightseeing trip.
			local maximumDetour =
				startDistance
					+ math.max(
						28,
						startDistance * 0.45
					)

			local maximumTravel =
				math.max(
					55,
					startDistance * 1.75
						+ 25
				)

			if currentToTarget
					> maximumDetour
				or movedFromStart
					> maximumTravel then

				return true,
					"grass_detour"
			end

			return false
		end,
	}

	if tonumber(speedOverride)
		and speedOverride > 0 then

		options.maxSpeed =
			speedOverride
	end

	local moved =
		safeMoveToPosition(
			grassPosition,
			8,
			grassPosition,
			options
		)

	local reason =
		state.safeMove.routeInterruptReason

	if reason == "grass_prompt" then
		return true,
			"prompt"
	end

	if reason == "grass_invalid"
		or reason == "grass_detour" then

		return false,
			reason
	end

	return moved,
		moved
			and "position"
			or (
				reason
					or "blocked"
			)
end

local ignoredCarcasses = {} -- [carcaça] = tick() em que o bloqueio expira

local function ignoreCarcass(carcass, seconds)
	if not carcass then return end
	ignoredCarcasses[carcass] = tick() + (seconds or 120)
end

local function carcassIsIgnored(carcass)
	local expiresAt = ignoredCarcasses[carcass]
	if not expiresAt then return false end
	if tick() >= expiresAt then
		ignoredCarcasses[carcass] = nil
		return false
	end
	return true
end

local function isPositionUnderwater(position)
	-- Raycasta de cima pra baixo no ponto exato E em 4 pontos ao redor
	-- (pega carcaça na beiradinha da água, não só afundada).
	local offsets = {
		Vector3.new(0, 0, 0),
		Vector3.new(6, 0, 0), Vector3.new(-6, 0, 0),
		Vector3.new(0, 0, 6), Vector3.new(0, 0, -6),
	}
	for _, offset in ipairs(offsets) do
		local hit = workspace:Raycast(position + offset + Vector3.new(0, 12, 0), Vector3.new(0, -24, 0), terrainParams)
		if hit and hit.Material == Enum.Material.Water then return true end
	end
	return false
end

local function detectAvailableFood(character)
	if not GameUtils or not AnimalConfig or not character:FindFirstChild("Head") then return nil end
	local animalType = character:GetAttribute("AnimalType")
	local animalName = character:GetAttribute("AnimalName")
	local configForAnimal = animalType and animalName and AnimalConfig[animalType] and AnimalConfig[animalType][animalName]
	if not configForAnimal then return nil end
	local ok, result = pcall(GameUtils.CanEatDrink.DetectMeatGrassWater, character, configForAnimal)
	return ok and result or nil
end

function state.drinkAcquirePromptAfterMove(
	spot,
	character,
	root,
	humanoid,
	waterBefore
)
	if not spot
		or not character
		or not root
		or not humanoid then

		return false,
			root
	end

	local previousBusy =
		state.busy

	state.busy = true

	-- MoveTo remains authoritative until it is explicitly cancelled.
	-- Kill it before prompt acquisition so the animal cannot turn around and
	-- start following another target during this handshake.
	state.releaseMovementNow(
		character,
		true
	)

	if state.questSetW then
		pcall(
			state.questSetW,
			false
		)
	end

	-- Orientation only. NO shoreline movement/refinement.
	if spot.water then
		local face =
			Vector3.new(
				spot.water.X
					- root.Position.X,
				0,
				spot.water.Z
					- root.Position.Z
			)

		if face.Magnitude > 0.20 then
			pcall(function()
				root.CFrame =
					CFrame.lookAt(
						root.Position,
						root.Position
							+ face.Unit,
						Vector3.yAxis
					)
			end)
		end
	end

	root.AssemblyLinearVelocity =
		Vector3.new(
			0,
			root.AssemblyLinearVelocity.Y,
			0
		)

	root.AssemblyAngularVelocity =
		Vector3.zero

	local promptLatched =
		state.drinkSearch.promptStopAt
			and state.drinkSearch.promptStopTime
			and tick()
				- state.drinkSearch.promptStopTime
				<= 2.5
			and (
				Vector3.new(
					root.Position.X
						- state.drinkSearch.promptStopAt.X,
					0,
					root.Position.Z
						- state.drinkSearch.promptStopAt.Z
				).Magnitude <= 18
			)

	local deadline =
		tick() + 2.40

	local acquired = false

	repeat
		character,
			root,
			humanoid =
				characterParts()

		if not character
			or not root
			or not humanoid then

			break
		end

		local currentWater =
			tonumber(
				character:GetAttribute(
					"Water"
				)
			) or waterBefore or 0

		if currentWater
			> (
				tonumber(
					waterBefore
				) or currentWater
			) + 0.01 then

			state.drinkProgressConfirm(
				currentWater
			)

			acquired = true
			break
		end

		local gamePrompt =
			detectAvailableFood(
				character
			) == "Drink"
				or (
					state.drinkGamePromptAvailable
					and state.drinkGamePromptAvailable(
						character
					)
				)

		local visualPrompt =
			state.drinkVisualPromptVisible
			and state.drinkVisualPromptVisible()

		if gamePrompt
			or visualPrompt
			or promptLatched then

			if visualPrompt then
				state.drinkLatchVisualPrompt()
			end

			drinkingSourcePosition =
				root.Position

			blockClientSubState = false
			setSubState(
				"Drinking"
			)
			blockClientSubState = false

			-- Prompt itself is sufficient to hand control to the sustain loop.
			acquired = true
			break
		end

		task.wait(0.10)
	until tick() >= deadline

	state.busy =
		previousBusy == true

	return acquired,
		root
end

function state.waitForGrassEatPrompt(
	character,
	timeout
)
	local deadline =
		tick() + (timeout or 0.45)

	while state.alive
		and tick() <= deadline do

		if character ~= player.Character
			or not character
			or not character.Parent then

			return false
		end

		if detectAvailableFood(character)
			== "Eat" then

			return true
		end

		task.wait(0.055)
	end

	return false
end

function state.eatVisualPromptVisible()
	local playerGui =
		player:FindFirstChildOfClass(
			"PlayerGui"
		)

	if not playerGui then
		return false
	end

	local camera =
		workspace.CurrentCamera

	local viewport =
		camera
			and camera.ViewportSize
			or Vector2.new(
				1280,
				720
			)

	for _, object in ipairs(
		playerGui:GetDescendants()
	) do
		if (
			object:IsA("TextLabel")
			or object:IsA("TextButton")
			or object:IsA("TextBox")
		)
			and object.Visible
			and object.TextTransparency < 0.95 then

			local lower =
				tostring(
					object.Text or ""
				):lower()

			local eatText =
				lower:find(
					"para comer",
					1,
					true
				)
				or lower:find(
					"to eat",
					1,
					true
				)

			if eatText then
				local centerX =
					object.AbsolutePosition.X
					+ object.AbsoluteSize.X
						* 0.5

				local centerY =
					object.AbsolutePosition.Y
					+ object.AbsoluteSize.Y
						* 0.5

				if centerY
						>= viewport.Y * 0.66
					and centerX
						>= viewport.X * 0.18
					and centerX
						<= viewport.X * 0.82 then

					return true
				end
			end
		end
	end

	return false
end

function state.grassEatAvailable(
	character
)
	if not character then
		return false
	end

	return detectAvailableFood(
		character
	) == "Eat"
		or state.eatVisualPromptVisible()
end

local function faceGrassPoint(root, grassPosition)
	if not root
		or typeof(grassPosition) ~= "Vector3" then
		return
	end

	local character =
		player.Character

	if not character
		or not root:IsDescendantOf(character) then
		return
	end

	-- v126:
	-- If Savannah already says Eat is available, the CURRENT facing is already
	-- accepted by the game's interaction detector. Rotating AFTER that detection
	-- can turn the animal away from the grass that produced the prompt.
	local eatAlreadyAvailable =
		detectAvailableFood(character)
			== "Eat"
		or (
			state.eatVisualPromptVisible
				and state.eatVisualPromptVisible()
		)

	if eatAlreadyAvailable then
		root.AssemblyAngularVelocity =
			Vector3.zero

		return
	end

	local flat =
		Vector3.new(
			grassPosition.X
				- root.Position.X,
			0,
			grassPosition.Z
				- root.Position.Z
		)

	if flat.Magnitude <= 0.15 then
		return
	end

	local desired =
		flat.Unit

	local currentForward =
		Vector3.new(
			root.CFrame.LookVector.X,
			0,
			root.CFrame.LookVector.Z
		)

	if currentForward.Magnitude <= 0.05 then
		return
	end

	currentForward =
		currentForward.Unit

	local alignment =
		currentForward:Dot(
			desired
		)

	-- MoveTo/AutoRotate already faced the animal while approaching the patch.
	-- If the stored grass point is now far to the side/behind, it is stale.
	-- Never perform the old 90-180 degree snap toward that stale coordinate.
	if alignment < 0.26 then
		root.AssemblyAngularVelocity =
			Vector3.zero

		return
	end

	-- Only a small final correction is allowed inside the same forward sector.
	local crossY =
		currentForward.X * desired.Z
			- currentForward.Z * desired.X

	local angle =
		math.atan2(
			crossY,
			alignment
		)

	local clampedAngle =
		math.clamp(
			angle,
			-math.rad(28),
			math.rad(28)
		)

	local c =
		math.cos(
			clampedAngle
		)

	local s =
		math.sin(
			clampedAngle
		)

	local corrected =
		Vector3.new(
			currentForward.X * c
				- currentForward.Z * s,
			0,
			currentForward.X * s
				+ currentForward.Z * c
		)

	if corrected.Magnitude <= 0.05 then
		return
	end

	pcall(function()
		root.CFrame =
			CFrame.lookAt(
				root.Position,
				root.Position
					+ corrected.Unit,
				Vector3.yAxis
			)
	end)

	root.AssemblyAngularVelocity =
		Vector3.zero
end

local function startGrassEatingIfAvailable(character, root, grassPosition)
	if not character or not root then return false end

	local detected = detectAvailableFood(character)
	if detected ~= "Eat" then
		return false
	end

	if grassPosition then
		faceGrassPoint(root, grassPosition)
	end

	-- Stop walking before starting the interaction.
	local velocity = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(
		0,
		velocity.Y,
		0
	)

	-- Prevent residual physics rotation between confirmed Eat and the E press.
	root.AssemblyAngularVelocity =
		Vector3.zero

	-- E is only the visual interaction path. The server sub-state remote is
	-- authoritative for actual eating, so do not risk toggling Eat back off.
	blockClientSubState = false
	setSubState("Eating")
	blockClientSubState = false
	return true
end

local function nearestCarcass(root)
	local best, bestRoot, distance = nil, nil, math.huge

	local function consider(object, part)
		if carcassIsIgnored(object) then return end
		if isPositionUnderwater(part.Position) then
			ignoreCarcass(object, 180)
			return
		end
		local current = (part.Position - root.Position).Magnitude
		if current < distance then best, bestRoot, distance = object, part, current end
	end

	local function scan(container)
		for _, object in ipairs(container:GetDescendants()) do
			if object:IsA("Model") then
				local part = object:FindFirstChild("HumanoidRootPart") or object:FindFirstChildWhichIsA("BasePart", true)
				if part then consider(object, part) end
			end
		end
	end

	local storage = workspace:FindFirstChild("CarcassesStorageModel")
	if storage then scan(storage) end

	-- Fallback: Dino Life (ou qualquer jogo) pode guardar as carcacas em
	-- outro lugar/nome. Só "carcass"/"carcaca" — "dead" sozinho pegava
	-- cenário decorativo tipo "DeadTree"/"DeadLog" e moveva em árvores.
	if not best then
		for _, object in ipairs(workspace:GetDescendants()) do
			if object:IsA("Model")
				and object.Parent ~= storage
				and (object.Name:lower():find("carcass") or object.Name:lower():find("carcaca")) then
				local part = object:FindFirstChild("HumanoidRootPart") or object:FindFirstChildWhichIsA("BasePart", true)
				if part then consider(object, part) end
			end
		end
	end

	return best, bestRoot
end

local function baboonAntHillIsIgnored(antHill)
	local expiresAt = BABOON.failedAntHills[antHill]
	if not expiresAt then return false end

	if tick() >= expiresAt or not antHill or not antHill.Parent then
		BABOON.failedAntHills[antHill] = nil
		return false
	end

	return true
end

local function baboonIgnoreAntHill(antHill, seconds)
	if antHill then
		BABOON.failedAntHills[antHill] = tick() + (seconds or 90)
	end
end

local function baboonAntHillPart(model)
	if not model or not model.Parent then return nil end

	if model:IsA("BasePart") then
		return model
	end

	if model:IsA("Model") then
		return model.PrimaryPart
			or model:FindFirstChild("HumanoidRootPart")
			or model:FindFirstChildWhichIsA("BasePart", true)
	end

	return nil
end

local function nearestBaboonAntHill(root)
	if not root then return nil, nil, math.huge end

	local mapAssets = workspace:FindFirstChild("MapAssets")
	local folder = mapAssets and mapAssets:FindFirstChild("AntHills")
	if not folder then return nil, nil, math.huge end

	local best, bestPart, bestDistance = nil, nil, math.huge
	local seen = {}

	-- The user-provided path contains multiple AntHill models. Scan direct
	-- children first, then descendants as a compatibility fallback.
	local function consider(object)
		if not object or seen[object] then return end
		seen[object] = true

		if baboonAntHillIsIgnored(object) then return end

		local part = baboonAntHillPart(object)
		if not part then return end

		-- Don't intentionally feed from an anthill submerged by water.
		if isPositionUnderwater(part.Position) then
			baboonIgnoreAntHill(object, 120)
			return
		end

		local distance = (part.Position - root.Position).Magnitude
		if distance < bestDistance then
			best = object
			bestPart = part
			bestDistance = distance
		end
	end

	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("Model") or child:IsA("BasePart") then
			consider(child)
		end
	end

	if not best then
		for _, object in ipairs(folder:GetDescendants()) do
			if object:IsA("Model") then
				consider(object)
			end
		end
	end

	return best, bestPart, bestDistance
end

local function chooseBaboonFood(root)
	if not root then return nil end

	-- IMPORTANT: once a target has been selected, do NOT compare distances
	-- again until that target succeeds, disappears, or is explicitly failed.
	-- This prevents Carcass <-> AntHill oscillation.
	if BABOON.targetObject and BABOON.targetPart
		and BABOON.targetObject.Parent
		and BABOON.targetPart.Parent then

		return {
			kind = BABOON.targetKind,
			object = BABOON.targetObject,
			part = BABOON.targetPart,
			distance = (BABOON.targetPart.Position - root.Position).Magnitude,
			locked = true,
		}
	end

	BABOON.clearTarget()

	local carcass, carcassPart = nearestCarcass(root)
	local carcassDistance = carcassPart
		and (carcassPart.Position - root.Position).Magnitude
		or math.huge

	local antHill, antHillPart, antHillDistance = nearestBaboonAntHill(root)

	local selected
	if carcass and carcassPart and carcassDistance <= antHillDistance then
		selected = {
			kind = "Carcass",
			object = carcass,
			part = carcassPart,
			distance = carcassDistance,
		}
	elseif antHill and antHillPart then
		selected = {
			kind = "AntHill",
			object = antHill,
			part = antHillPart,
			distance = antHillDistance,
		}
	end

	if selected then
		BABOON.targetKind = selected.kind
		BABOON.targetObject = selected.object
		BABOON.targetPart = selected.part
		BABOON.targetStartedAt = tick()
	end

	return selected
end


-- Só pousa em cima do Terrain de VERDADE do Roblox (nunca em cima de
-- árvores/rochas/qualquer objeto) e nunca na água — usado quando um
-- carnívoro não acha carcaça por perto e precisa explorar outra área
-- de um jeito seguro, sem risco de mover em cima de cenário.
local terrainOnlyRayParams = RaycastParams.new()
terrainOnlyRayParams.FilterType = Enum.RaycastFilterType.Include
terrainOnlyRayParams.FilterDescendantsInstances = { workspace.Terrain }

local function findSafeTerrainSpot(origin, minRadius, maxRadius)
	for _ = 1, 12 do
		local angle = math.random() * math.pi * 2
		local radius = minRadius + math.random() * (maxRadius - minRadius)
		local probeXZ = origin + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		local hit = workspace:Raycast(probeXZ + Vector3.new(0, 120, 0), Vector3.new(0, -400, 0), terrainOnlyRayParams)
		if hit and hit.Material ~= Enum.Material.Water then
			return hit.Position + Vector3.new(0, 3, 0)
		end
	end
	return nil
end

local function giraffeTreeIsIgnored(tree)
	local expiresAt = GIRAFFE.failedTrees[tree]
	if not expiresAt then return false end

	if tick() >= expiresAt or not tree or not tree.Parent then
		GIRAFFE.failedTrees[tree] = nil
		return false
	end

	return true
end

local function giraffeIgnoreTree(tree, seconds)
	if tree then
		GIRAFFE.failedTrees[tree] = tick() + (seconds or 60)
	end
end

local function giraffeLeavesParts(leaves)
	local parts = {}
	if not leaves then return parts end

	if leaves:IsA("BasePart") then
		table.insert(parts, leaves)
	end

	for _, object in ipairs(leaves:GetDescendants()) do
		if object:IsA("BasePart") then
			table.insert(parts, object)
		end
	end

	return parts
end

local function giraffeTreeLeafState(tree)
	if not tree or not tree.Parent then
		return nil
	end

	local leaves = tree:FindFirstChild("Leaves")
	if not leaves then
		return nil
	end

	local parts = giraffeLeavesParts(leaves)
	if #parts == 0 then
		return nil
	end

	local visible = {}
	local allDepleted = true

	for _, part in ipairs(parts) do
		-- The Savannah tree depletion signal supplied by the user:
		-- every Leaves MeshPart at Transparency == 1 means this tree is empty.
		if part.Transparency < 0.999 then
			allDepleted = false
			table.insert(visible, part)
		end
	end

	return {
		tree = tree,
		leaves = leaves,
		parts = parts,
		visibleParts = visible,
		depleted = allDepleted,
	}
end

local function giraffeBestVisibleLeaf(tree, root)
	local stateInfo = giraffeTreeLeafState(tree)
	if not stateInfo or stateInfo.depleted then
		return nil, stateInfo
	end

	local bestPart
	local bestDistance = math.huge
	local origin = root and root.Position

	for _, part in ipairs(stateInfo.visibleParts) do
		local distance = origin
			and (part.Position - origin).Magnitude
			or 0

		if distance < bestDistance then
			bestPart = part
			bestDistance = distance
		end
	end

	return bestPart, stateInfo
end

local function giraffeTreeAnchorPart(tree, leafPart)
	if not tree then return leafPart end

	local trunk = tree:FindFirstChild("Trunk")
	if trunk then
		if trunk:IsA("BasePart") then
			return trunk
		end

		local trunkPart = trunk:FindFirstChildWhichIsA("BasePart", true)
		if trunkPart then
			return trunkPart
		end
	end

	if tree:IsA("Model") and tree.PrimaryPart then
		return tree.PrimaryPart
	end

	return tree:FindFirstChildWhichIsA("BasePart", true) or leafPart
end

local function giraffeCharacterReachProfile(character, root)
	if not character or not root then return nil end

	local highestY = root.Position.Y
	local lowestY = root.Position.Y

	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("BasePart") then
			local halfY = object.Size.Y * 0.5
			highestY = math.max(
				highestY,
				object.Position.Y + halfY
			)
			lowestY = math.min(
				lowestY,
				object.Position.Y - halfY
			)
		end
	end

	return {
		topAboveRoot = math.max(highestY - root.Position.Y, 4),
		rootAboveBottom = math.max(root.Position.Y - lowestY, 1.5),
		bodyHeight = math.max(highestY - lowestY, 6),
	}
end

local function giraffeGroundAtXZ(x, z, referenceY)
	local castY = math.max((referenceY or 0) + 180, 300)

	local hit = workspace:Raycast(
		Vector3.new(x, castY, z),
		Vector3.new(0, -650, 0),
		terrainOnlyRayParams
	)

	if not hit or hit.Material == Enum.Material.Water then
		return nil
	end

	return hit.Position
end

local function giraffeLeafLowestY(part)
	if not part or not part:IsA("BasePart") then
		return math.huge
	end

	return part.Position.Y - part.Size.Y * 0.5
end

local function giraffeLeafHorizontalRadius(part)
	if not part or not part:IsA("BasePart") then
		return 0
	end

	return math.sqrt(
		(part.Size.X * 0.5) ^ 2
			+ (part.Size.Z * 0.5) ^ 2
	)
end

local function giraffeReachableApproach(
	tree,
	leafPart,
	character,
	root,
	startIndex
)
	if not tree or not leafPart or not character or not root then
		return nil
	end

	local profile = giraffeCharacterReachProfile(character, root)
	if not profile then return nil end

	local anchor = giraffeTreeAnchorPart(tree, leafPart)
	if not anchor then return nil end

	local base = anchor.Position
	local lowestLeafY = giraffeLeafLowestY(leafPart)
	local leafRadius = giraffeLeafHorizontalRadius(leafPart)
	local firstIndex = math.floor(tonumber(startIndex) or 0) % 8

	-- Check several sides around the trunk because one side can be blocked or
	-- lower/higher than another on sloped terrain.
	for offset = 0, 7 do
		local index = (firstIndex + offset) % 8
		local angle = index / 8 * math.pi * 2
		local radius = (index % 2 == 0) and 4.5 or 6.5

		local x = base.X + math.cos(angle) * radius
		local z = base.Z + math.sin(angle) * radius
		local ground = giraffeGroundAtXZ(x, z, base.Y)

		if ground then
			-- Project this exact Giraffe's top/head height onto the candidate
			-- ground. This automatically adapts to different growth percentages.
			local projectedRootY = ground.Y + profile.rootAboveBottom
			local reachableTopY = projectedRootY
				+ profile.topAboveRoot
				+ GIRAFFE.reachVerticalMargin

			local centerHorizontal = Vector3.new(
				leafPart.Position.X - ground.X,
				0,
				leafPart.Position.Z - ground.Z
			).Magnitude

			-- Large leaf meshes can extend several studs toward the animal, so
			-- compare against the nearest edge instead of only the mesh center.
			local effectiveHorizontal = math.max(
				centerHorizontal - leafRadius,
				0
			)

			if lowestLeafY <= reachableTopY
				and effectiveHorizontal <= GIRAFFE.reachHorizontal then

				return {
					ground = ground,
					reachableTopY = reachableTopY,
					lowestLeafY = lowestLeafY,
					horizontal = effectiveHorizontal,
					approachIndex = index,
				}
			end
		end
	end

	return nil
end

local function giraffeBestReachableLeaf(tree, character, root, startIndex)
	local info = giraffeTreeLeafState(tree)
	if not info or info.depleted then
		return nil, info, nil
	end

	local bestPart
	local bestApproach
	local bestScore = math.huge

	for _, part in ipairs(info.visibleParts) do
		local approach = giraffeReachableApproach(
			tree,
			part,
			character,
			root,
			startIndex
		)

		if approach then
			local verticalSlack = math.max(
				approach.reachableTopY - approach.lowestLeafY,
				0
			)

			-- Prefer comfortably reachable leaves over marginally reachable ones.
			local score = approach.horizontal
				- math.min(verticalSlack, 10) * 0.12
				+ (part.Position - root.Position).Magnitude * 0.02

			if score < bestScore then
				bestScore = score
				bestPart = part
				bestApproach = approach
			end
		end
	end

	return bestPart, info, bestApproach
end


local function giraffeGroundNearTree(tree, leafPart, root, approachIndex)
	if not tree or not leafPart or not root then return nil end

	local anchor = giraffeTreeAnchorPart(tree, leafPart)
	if not anchor then return nil end

	local base = anchor.Position
	local outward = Vector3.new(
		root.Position.X - base.X,
		0,
		root.Position.Z - base.Z
	)

	if outward.Magnitude < 0.5 then
		outward = Vector3.new(1, 0, 0)
	else
		outward = outward.Unit
	end

	-- Reposition attempts stay on the SAME tree and rotate around its trunk.
	-- This fixes a bad interaction angle without prematurely switching trees.
	local turn = ((approachIndex or 0) % 4) * (math.pi / 2)
	local cosA, sinA = math.cos(turn), math.sin(turn)
	local rotated = Vector3.new(
		outward.X * cosA - outward.Z * sinA,
		0,
		outward.X * sinA + outward.Z * cosA
	)

	local desiredXZ = base + rotated * 5
	local hit = workspace:Raycast(
		Vector3.new(desiredXZ.X, math.max(base.Y + 150, 250), desiredXZ.Z),
		Vector3.new(0, -500, 0),
		terrainOnlyRayParams
	)

	if not hit or hit.Material == Enum.Material.Water then
		return nil
	end

	return hit.Position
end

local function nearestGiraffeTree(root)
	if not root then return nil end

	local character = player.Character
	if not character then return nil end

	-- A locked tree remains locked only while at least one visible leaf is
	-- reachable. If the lower leaves are gone and only unreachable high leaves
	-- remain, move to another tree.
	if GIRAFFE.targetTree and GIRAFFE.targetTree.Parent then
		local leafPart, info, approach = giraffeBestReachableLeaf(
			GIRAFFE.targetTree,
			character,
			root
		)

		if info
			and not info.depleted
			and leafPart
			and approach
			and state.autoFoodPositionAllowed(
				approach.ground
			) then
			GIRAFFE.targetLeaves = info.leaves
			GIRAFFE.targetLeafPart = leafPart

			return {
				tree = GIRAFFE.targetTree,
				leaves = info.leaves,
				leafPart = leafPart,
				approach = approach,
				distance = (leafPart.Position - root.Position).Magnitude,
				locked = true,
			}
		end

		if info and info.depleted then
			runtimeMessage = "Giraffe: current tree is fully depleted"
		elseif info and not info.depleted then
			giraffeIgnoreTree(GIRAFFE.targetTree, 75)
			runtimeMessage = "Giraffe: remaining leaves are too high to reach; switching tree"
		end

		GIRAFFE.clearTarget()
	end

	local mapAssets = workspace:FindFirstChild("MapAssets")
	local mainAssets = mapAssets and mapAssets:FindFirstChild("MainAssets")
	if not mainAssets then return nil end

	local best
	local bestDistance = math.huge

	for _, tree in ipairs(mainAssets:GetChildren()) do
		if not giraffeTreeIsIgnored(tree) then
			local leafPart, info, approach = giraffeBestReachableLeaf(
				tree,
				character,
				root
			)

			if info
				and not info.depleted
				and leafPart
				and approach
				and state.autoFoodPositionAllowed(
					approach.ground
				) then

				local anchor = giraffeTreeAnchorPart(tree, leafPart)
				local distancePart = anchor or leafPart
				local distance = (distancePart.Position - root.Position).Magnitude

				if distance < bestDistance then
					bestDistance = distance
					best = {
						tree = tree,
						leaves = info.leaves,
						leafPart = leafPart,
						approach = approach,
						distance = distance,
					}
				end
			end
		end
	end

	if best then
		GIRAFFE.targetTree = best.tree
		GIRAFFE.targetLeaves = best.leaves
		GIRAFFE.targetLeafPart = best.leafPart
		GIRAFFE.targetStartedAt = tick()
		GIRAFFE.repositionAttempts = 0
	end

	return best
end

local RAGDOLL_STATES = {
	[Enum.HumanoidStateType.Physics] = true,
	[Enum.HumanoidStateType.FallingDown] = true,
	[Enum.HumanoidStateType.Ragdoll] = true,
	[Enum.HumanoidStateType.Freefall] = true,
	[Enum.HumanoidStateType.GettingUp] = true,
}

local activeCarcass
local carcassEatBusy = false

function state.carcassPhysicalDistance(character, root, carcassRoot)
	if not character or not root or not carcassRoot then
		return math.huge, math.huge
	end

	local head = character:FindFirstChild("Head", true)
	if not (head and head:IsA("BasePart")) then
		head = root
	end

	local headDistance =
		(head.Position - carcassRoot.Position).Magnitude

	local horizontalRootDistance = Vector3.new(
		root.Position.X - carcassRoot.Position.X,
		0,
		root.Position.Z - carcassRoot.Position.Z
	).Magnitude

	return headDistance, horizontalRootDistance
end

function state.carcassCloseEnough(character, root, carcassRoot)
	local headDistance, horizontalRootDistance =
		state.carcassPhysicalDistance(character, root, carcassRoot)

	-- Deliberately stricter than the remote's possible reach.
	-- The animal must visibly stand beside the carcass.
	return headDistance <= 8
		and horizontalRootDistance <= 8
end

function state.faceCarcass(root, carcassRoot)
	if not root or not carcassRoot then return end

	local flat = Vector3.new(
		carcassRoot.Position.X - root.Position.X,
		0,
		carcassRoot.Position.Z - root.Position.Z
	)

	if flat.Magnitude <= 0.15 then return end

	pcall(function()
		root.CFrame = CFrame.lookAt(
			root.Position,
			root.Position + flat.Unit,
			Vector3.yAxis
		)
	end)
end

local function approachCarcass(carcassRoot, distance)
	local character, root = characterParts()
	if not character or not root then return false end
	local approachDirection = Vector3.new(root.Position.X - carcassRoot.Position.X, 0, root.Position.Z - carcassRoot.Position.Z)
	if approachDirection.Magnitude < 0.5 then
		approachDirection = root.CFrame.LookVector * -1
	end
	approachDirection = approachDirection.Unit
	local standTarget = carcassRoot.Position + approachDirection * distance
	local moved = safeMoveToPosition(
		standTarget,
		9,
		carcassRoot.Position,
		{
			purpose = "food",

			-- v72: tolerance must be SMALLER than the requested standoff.
			-- v71 used 8 studs, so a 5/2-stud target could be considered
			-- reached without the carnivore moving at all.
			tolerance = 1.25,
			speedScale = 1,
			constantSpeed = true,
			maxDuration = 220,
		}
	)

	local liveCharacter, liveRoot = characterParts()
	if liveCharacter and liveRoot and carcassRoot.Parent then
		state.faceCarcass(liveRoot, carcassRoot)
	end

	return moved
end

local function eatCarcass(carcass, carcassRoot)
	if state.questGrowthReset.exclusive then return end
	if carcassEatBusy or not carcass or not carcassRoot then return end
	local character, root, humanoid = characterParts()
	if not character or not root or not humanoid then return end
	carcassEatBusy = true
	activeCarcass = carcass

	-- ALWAYS approach physically before eating. The game/remote may technically
	-- allow interaction from farther away, but MMB Hub refuses to eat until the
	-- carnivore is visibly beside the carcass.
	for attempt = 1, 3 do
		character, root, humanoid = characterParts()

		if not character
			or not root
			or not humanoid
			or not carcass.Parent
			or not carcassRoot.Parent then
			break
		end

		if state.carcassCloseEnough(character, root, carcassRoot)
			and detectAvailableFood(character) == "Eat" then
			break
		end

		local standDistance =
			attempt == 1 and 3.25
			or (attempt == 2 and 2.0 or 1.25)

		runtimeMessage = string.format(
			"Approaching carcass (%d/3)",
			attempt
		)

		approachCarcass(carcassRoot, standDistance)
		task.wait(0.18)
	end

	character, root, humanoid = characterParts()

	if not character
		or not root
		or not humanoid
		or not carcass.Parent
		or not carcassRoot.Parent
		or not state.carcassCloseEnough(character, root, carcassRoot)
		or detectAvailableFood(character) ~= "Eat" then

		runtimeMessage =
			"Could not reach carcass eating range; trying another"

		if carcass.Parent then
			ignoreCarcass(carcass, 20)
		end

		if activeCarcass == carcass then
			activeCarcass = nil
		end

		carcassEatBusy = false
		return
	end

	state.faceCarcass(root, carcassRoot)

	-- Se autoEat foi desligado nesse meio tempo (ex: o script está saindo
	-- da água por causa do autoDrink), aborta e não segura a posição —
	-- senão essa rotina briga com o movimento de saída da água.
	if not state.autoEat then
		carcassEatBusy = false
		return
	end

	-- Se mesmo depois do movimento o animal ficou nadando, a carcaça está
	-- na água (ou embaixo dela) e essa detecção de "underwater" pode ter
	-- falhado antes (ex: correnteza moveu a carcaça). Ignora e desiste.
	if humanoid:GetState() == Enum.HumanoidStateType.Swimming then
		runtimeMessage = "Carcaça na água; ignorando e procurando outra"
		ignoreCarcass(carcass, 180)
		if activeCarcass == carcass then activeCarcass = nil end
		carcassEatBusy = false
		return
	end

	-- Não ancora (isso pode travar animação/física e conflitar com o servidor).
	-- Em vez disso segura a posição perto da carcaça zerando a velocidade e
	-- corrigindo se o animal escorregar, igual à barreira de natação.
	local holdPosition = root.Position

	setSubState("Eating")

	-- Fire ONLY after the physical-distance gate above passed.
	if CarcassRemote
		and state.carcassCloseEnough(character, root, carcassRoot) then
		pcall(
			CarcassRemote.FireServer,
			CarcassRemote,
			carcass
		)
	end

	runtimeMessage = "Eating carcass at close range"

	local startFood = character:GetAttribute("Food") or 0
	local foodEverRose = false
	local deadline = tick() + 6
	while tick() < deadline do
		task.wait(0.3)
		character, root, humanoid = characterParts()
		if not character or not root or not humanoid then break end
		if not carcass.Parent then break end -- carcaça sumiu (foi consumida)

		-- Autodrink pode ter assumido o controle pra sair da água — solta
		-- imediatamente pra não brigar com o movimento.
		if state.questGrowthReset.exclusive or not state.autoEat then
			runtimeMessage = state.questGrowthReset.exclusive
				and "Growth reset: eating routine suspended"
				or "Comer pausado (outra rotina assumiu)"
			break
		end

		-- Caiu na água durante o ciclo (ex: maré/correnteza): aborta e ignora.
		if humanoid:GetState() == Enum.HumanoidStateType.Swimming then
			runtimeMessage = "Carcaça na água; ignorando e procurando outra"
			ignoreCarcass(carcass, 180)
			if activeCarcass == carcass then activeCarcass = nil end
			break
		end

		-- Se o jogo está oferecendo "Drink" em vez de "Eat" aqui, é sinal
		-- de que a carcaça está na beiradinha da água. Troca de carcaça.
		if detectAvailableFood(character) == "Drink" then
			runtimeMessage = "Carcaça na beira da água (oferecendo beber); trocando"
			ignoreCarcass(carcass, 180)
			if activeCarcass == carcass then activeCarcass = nil end
			break
		end

		local curFood = character:GetAttribute("Food") or 0
		if curFood > startFood then
			startFood = curFood
			foodEverRose = true
			deadline = tick() + 4 -- ainda subindo, estende o prazo
		end
		local targetFood = (
			state.autoQuests
			and (state.questCarnivoreFeeding or state.questBaboonFeeding)
			and not preSwitchFoodTarget
		)
			and 100
			or (preSwitchFoodTarget or 92)
		if curFood >= targetFood then break end

		root.AssemblyLinearVelocity = Vector3.new(
			0,
			root.AssemblyLinearVelocity.Y,
			0
		)
		if (root.Position - holdPosition).Magnitude > 6 then
			state.safeNudgeToward(root, holdPosition, 0.30)
		end

		if RAGDOLL_STATES[humanoid:GetState()] then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end

		-- If either the carcass or animal drifted away, physically close the
		-- gap again BEFORE another remote call.
		if not state.carcassCloseEnough(character, root, carcassRoot) then
			runtimeMessage =
				"Carcass moved; re-approaching"

			approachCarcass(carcassRoot, 1.5)
			task.wait(0.15)

			character, root, humanoid = characterParts()

			if not character
				or not root
				or not humanoid
				or not state.carcassCloseEnough(
					character,
					root,
					carcassRoot
				) then
				break
			end

			holdPosition = root.Position
			state.faceCarcass(root, carcassRoot)
		end

		if CarcassRemote
			and state.carcassCloseEnough(
				character,
				root,
				carcassRoot
			) then
			pcall(
				CarcassRemote.FireServer,
				CarcassRemote,
				carcass
			)
		end

		setSubState("Eating")
	end

	character, root = characterParts()
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	-- Watchdog: se passou o tempo todo tentando e a comida nunca subiu nem
	-- um pouco, essa carcaça não é comível daqui (posição ruim, presa em
	-- algo, etc). Ignora por um tempo pra não ficar insistindo pra sempre.
	if not foodEverRose and carcass.Parent then
		runtimeMessage = "Não consegui comer essa carcaça; ignorando e trocando"
		ignoreCarcass(carcass, 90)
	end

	if not carcass.Parent then activeCarcass = nil end
	if activeCarcass == carcass and not foodEverRose then activeCarcass = nil end
	carcassEatBusy = false
end
-- ============================================================
-- v75: CARCASS INTERCEPTION DURING SPAWN SEARCH ROUTES
-- A carnivore must not walk past a usable carcass just because the current
-- search destination is MirageSpawn/another spawn. Long routes are split into
-- short physical legs; between legs we scan and eat any nearby carcass first.
-- ============================================================
function state.carcassOnSearchRoute(root, destination)
	if not root then return nil, nil end

	local carcass, carcassRoot =
		nearestCarcass(root)

	if not carcass or not carcassRoot then
		return nil, nil
	end

	local toCarcass = Vector3.new(
		carcassRoot.Position.X - root.Position.X,
		0,
		carcassRoot.Position.Z - root.Position.Z
	)

	local carcassDistance = toCarcass.Magnitude

	-- "On the way" means genuinely nearby. Do not abandon the current route
	-- for a carcass hundreds of studs off to the side.
	if carcassDistance > 110 then
		return nil, nil
	end

	if typeof(destination) == "Vector3" then
		local toDestination = Vector3.new(
			destination.X - root.Position.X,
			0,
			destination.Z - root.Position.Z
		)

		if toDestination.Magnitude > 25
			and toCarcass.Magnitude > 35 then

			local alignment =
				toCarcass.Unit:Dot(
					toDestination.Unit
				)

			-- Allow side carcasses, but avoid a large backtrack to something
			-- clearly behind the animal.
			if alignment < -0.20 then
				return nil, nil
			end
		end
	end

	return carcass, carcassRoot
end

function state.carnivoreSearchFoodTarget(character)
	if not character then return 92 end

	if state.autoQuests
		and state.questCarnivoreFeeding
		and not preSwitchFoodTarget then
		return 100
	end

	return preSwitchFoodTarget or 92
end

function state.moveToCarcassSearchSpawn(destination)
	if not destination
		or not destination.Parent
		or typeof(destination.Position) ~= "Vector3" then
		return false, "invalid_destination"
	end

	local finalPosition =
		destination.Position

	local routeStartedAt = tick()
	local routeStartPosition
	local resumeCount = 0
	local maxCarcassInterrupts = 8

	while state.alive
		and state.autoEat
		and not state.questGrowthReset.exclusive
		and not criticalRecoveryActive do

		local character, root =
			characterParts()

		if not character or not root then
			return false, "no_character"
		end

		if not destination.Parent then
			return false, "destination_gone"
		end

		if not routeStartPosition then
			routeStartPosition =
				root.Position
		end

		local water =
			tonumber(
				character:GetAttribute("Water")
			) or 100

		-- Do not reference `drinkingToFull` here: this function is declared
		-- before that local exists in lexical scope.
		if state.autoDrink
			and water <= 72 then
			return false, "water_priority"
		end

		local food =
			tonumber(
				character:GetAttribute("Food")
			) or 100

		local targetFood =
			state.carnivoreSearchFoodTarget(
				character
			)

		if food >= targetFood then
			return true, "fed"
		end

		local flat =
			Vector3.new(
				finalPosition.X - root.Position.X,
				0,
				finalPosition.Z - root.Position.Z
			)

		local remaining =
			flat.Magnitude

		if remaining <= 18 then
			return true, "arrived"
		end

		-- Check once immediately before starting/resuming the continuous route.
		local immediateCarcass, immediateRoot =
			state.carcassOnSearchRoute(
				root,
				finalPosition
			)

		if immediateCarcass and immediateRoot then
			runtimeMessage =
				"Carcass found before route; eating"

			eatCarcass(
				immediateCarcass,
				immediateRoot
			)

			task.wait(0.10)

			resumeCount += 1

			if resumeCount >= maxCarcassInterrupts then
				return false, "too_many_carcass_interrupts"
			end

			continue
		end

		-- The callback stores the carcass and asks SafeMove to stop ONLY when
		-- there is genuinely something to eat. Normal route checks never stop it.
		state.carcassRouteInterrupt = nil

		local checkLastPosition =
			root.Position

		local checkLastMovedAt =
			tick()

		local moved =
			safeMoveToPosition(
				finalPosition,
				8,
				nil,
				{
					purpose = "food",
					tolerance = 18,
					speedScale = 1,
					maxDuration = 360,
					routeCheckInterval = 0.35,

					routeCheck = function(
						liveCharacter,
						liveRoot
					)
						if not destination.Parent then
							return true, "destination_gone"
						end

						if not state.autoEat
							or state.questGrowthReset.exclusive
							or criticalRecoveryActive then

							return true, "interrupted"
						end

						local liveWater =
							tonumber(
								liveCharacter:GetAttribute(
									"Water"
								)
							) or 100

						if state.autoDrink
							and liveWater <= 72 then
							return true, "water_priority"
						end

						local liveFood =
							tonumber(
								liveCharacter:GetAttribute(
									"Food"
								)
							) or 100

						if liveFood >=
							state.carnivoreSearchFoodTarget(
								liveCharacter
							) then

							return true, "fed"
						end

						local movedSinceCheck =
							Vector3.new(
								liveRoot.Position.X
									- checkLastPosition.X,
								0,
								liveRoot.Position.Z
									- checkLastPosition.Z
							).Magnitude

						if movedSinceCheck >= 2 then
							checkLastPosition =
								liveRoot.Position

							checkLastMovedAt =
								tick()
						elseif tick()
							- checkLastMovedAt
							>= 2.5 then

							-- Verification only. SafeMove's own obstacle/stall
							-- controller remains responsible for recovery.
							state.carcassRouteLastSlowAt =
								tick()

							state.carcassRouteLastSlowPosition =
								liveRoot.Position

							checkLastMovedAt =
								tick()
						end

						local carcass, carcassRoot =
							state.carcassOnSearchRoute(
								liveRoot,
								finalPosition
							)

						if carcass and carcassRoot then
							state.carcassRouteInterrupt = {
								carcass = carcass,
								root = carcassRoot,
								detectedAt = tick(),
							}

							return true, "carcass"
						end

						return false
					end,
				}
			)

		local interruptReason =
			state.safeMove.routeInterruptReason

		local interrupt =
			state.carcassRouteInterrupt

		state.carcassRouteInterrupt = nil

		character, root =
			characterParts()

		if not character or not root then
			return false, "no_character"
		end

		-- Continuous SafeMove completed normally.
		if moved then
			local remainingAfter =
				Vector3.new(
					finalPosition.X - root.Position.X,
					0,
					finalPosition.Z - root.Position.Z
				).Magnitude

			if remainingAfter <= 22 then
				return true, "arrived"
			end

			-- Verification: a "successful" move that did not actually reach the
			-- spawn is abnormal. Retry once from the real current position.
			resumeCount += 1

			if resumeCount >= maxCarcassInterrupts then
				return false, "success_without_arrival"
			end

			runtimeMessage =
				"Route verification: destination not reached; continuing"

			task.wait(0.05)
			continue
		end

		if interruptReason == "carcass"
			and interrupt
			and interrupt.carcass
			and interrupt.root
			and interrupt.carcass.Parent
			and interrupt.root.Parent then

			local distance =
				(
					interrupt.root.Position
					- root.Position
				).Magnitude

			runtimeMessage =
				string.format(
					"Carcass intercepted on continuous route (%.0f studs)",
					distance
				)

			eatCarcass(
				interrupt.carcass,
				interrupt.root
			)

			task.wait(0.10)

			resumeCount += 1

			if resumeCount >= maxCarcassInterrupts then
				return false, "too_many_carcass_interrupts"
			end

			-- Resume the SAME Mirage/spawn destination from current position.
			continue
		end

		if interruptReason == "fed" then
			return true, "fed"
		elseif interruptReason == "water_priority" then
			return false, "water_priority"
		elseif interruptReason == "destination_gone" then
			return false, "destination_gone"
		elseif interruptReason == "interrupted" then
			return false, "interrupted"
		end

		-- SafeMove itself reported blocked/error/timeout.
		local routeDistance =
			routeStartPosition
			and Vector3.new(
				root.Position.X
					- routeStartPosition.X,
				0,
				root.Position.Z
					- routeStartPosition.Z
			).Magnitude
			or 0

		local totalTime =
			tick() - routeStartedAt

		state.carcassRouteLastFailure = {
			spawn = destination.Name,
			distanceMoved = routeDistance,
			duration = totalTime,
			position = root.Position,
			safeMoveError =
				state.safeMove.routeCheckError,
		}

		runtimeMessage =
			string.format(
				"Spawn route blocked after %.0f studs (%.1fs)",
				routeDistance,
				totalTime
			)

		return false, "blocked"
	end

	return false, "interrupted"
end



