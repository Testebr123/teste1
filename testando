			)
			statusRuntime.Text = state.hudEnglishStatus(runtimeMessage)
			if state.escapeTerrain
				and not state.questGrowthReset.exclusive
				and not (
					state.drinkTest
					and state.drinkTest.active
				)
				and state.drinkIsBuriedUnderTerrain(
					root
				)
				and not state.busy
				and not criticalRecoveryActive then

				-- Escape Terrain is an emergency vertical clip, not a jump loop.
				criticalRecoveryActive = true

				local escaped =
					state.drinkTestHardEject(
						"Escape Terrain watchdog"
					)

				if escaped then
					state.drinkTestRestoreEnvironment()
					criticalRecoveryActive = false
					state.questForceFastRecheckUntil =
						tick() + 20
				end
			end

			if root.Position.Y < config.dangerY
				and not state.busy
				and not state.questGrowthReset.exclusive then
				if isDinoLife then
					task.spawn(escapeDinoToSafety, "terra firme (saiu do void)")
				else
					task.spawn(ensureOnSolidGround, getSafeFarmPosition(), "terra firme (saiu do void)")
				end
			end
		end
		task.wait(0.5)
	end
end)
