		self:Fix("full-drink", "completed Drink latch cleared", function()
			drinkingToFull = false
			drinkingSourcePosition = nil
			drinkingStuckSince = nil
			state.drinkProgressReset()
			state.survivalArbiterComplete("water")
			return true
		end)
	end

	local staleGiraffeRecovery =
		GIRAFFE
		and GIRAFFE.exclusiveRecovery
		and GIRAFFE.exclusiveRecovery.active
		and isGiraffeCharacter(context.character)
		and state.giraffeFoodRecoveryStillNeeded
		and not state.giraffeFoodRecoveryStillNeeded(context.character)

	if self:Mature("giraffe-recovery-satisfied", staleGiraffeRecovery, 0.4) then
		self:Fix("giraffe-recovery-satisfied", "stale Giraffe Pride recovery released", function()
			local token = GIRAFFE.exclusiveRecovery.token
			state.giraffeExclusiveRecoveryFinish(
				token,
				false,
				"Giraffe Food satisfied; stale Pride recovery released"
			)
			state.questForceFastRecheckUntil = tick() + 15
			return true
		end)
	end

	local eatOrphan = eatingToFull
		and context.food >= 99.5
		and not activeCarcassCommitted
		and not carcassEatBusy
	if self:Mature("full-eat", eatOrphan, 1) then
		self:Fix("full-eat", "completed Eat latch cleared", function()
			eatingToFull = false
			eatingSourcePosition = nil
			eatingStuckSince = nil
			state.survivalArbiterComplete("food")
			return true
		end)
	end

	local questOrphan = not state.autoQuests
		and (
			state.questMotionMoving
			or state.autoRunMoveOwnsInput
			or state.questLandKeyDown
			or state.questTravelActive
		)
	if self:Mature("quest-orphan", questOrphan, 1.5) then
		self:Fix("quest-orphan", "orphan quest movement stopped", function()
			state.questMotionMoving = false
			state.questMotionMode = nil
			state.autoRunMoveOwnsInput = false
			state.questTravelActive = false
			state.questLandInputActive = false
			state.questSetW(false)
			if state.questSetLandPermanentW then state.questSetLandPermanentW(false) end
			if state.heavyWalk.owner == "autoRun" then state.heavyWalkStop(player.Character) end
			return true
		end)
	end

	if state.survivalArbiter.owner == "food" and not state.autoEat then
		self:Fix("food-owner-disabled", "Food ownership cleared after toggle OFF", function()
			state.survivalArbiterReset("Auto Eat disabled")
			return true
		end)
	elseif state.survivalArbiter.owner == "water" and not state.autoDrink then
		self:Fix("water-owner-disabled", "Water ownership cleared after toggle OFF", function()
			state.survivalArbiterReset("Auto Drink disabled")
			return true
		end)
	end

	local staleHeavyWalk = not safeMove.active
		and not state.autoRunMoveOwnsInput
		and state.heavyWalk.owner ~= nil
		and tick() - (state.heavyWalk.lastInstructionAt or 0) > 2
	if self:Mature("heavyWalk-orphan", staleHeavyWalk, 1) then
		self:Fix("heavyWalk-orphan", "orphan movement motor stopped", function()
			state.heavyWalkStop(player.Character)
			return true
		end)
	end

	local carcassOrphan = carcassEatBusy
		and not activeCarcass
		and not eatingToFull
		and not (safeMove.active and safeMove.reason == "food")
	if self:Mature("carcass-orphan", carcassOrphan, 25) then
		self:Fix("carcass-orphan", "orphan carcass worker release requested", function()
			state.carcassController.cancelRequested = true
			state.carcassController.token += 1
			return true
		end)
	end

	local groupOrphan = state.questGroup.createInFlight
		and tick() - (state.questGroup.lastCreateAttemptAt or 0) > 30
	if self:Mature("group-orphan", groupOrphan, 2) then
		self:Fix("group-orphan", "stale Group creation transaction released", function()
			state.questGroup.createInFlight = false
			state.questGroup.createFailures = (state.questGroup.createFailures or 0) + 1
			return true
		end)
	end

	if criticalRecoveryActive
		and not DAMAGE.active
		and not forcingPostDrinkMove
		and not state.drinkTest.active then
		pcall(state.questReleaseStaleRecoveryLock)
	end

	ai.MovementManager:Reconcile(context)
end
