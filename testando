					character:GetAttribute(
						"Water"
					)
				) or 100

			if preSwitchFoodTarget
				and food < preSwitchFoodTarget then

				state.growthTopUpForceFood(
					character,
					food,
					water,
					preSwitchFoodTarget
				)

				runtimeMessage =
					string.format(
						"Slot switch safety: actively feeding %s (%d%% -> %d%%)",
						isGiraffeCharacter(character)
							and "Giraffe"
							or tostring(
								character:GetAttribute(
									"AnimalName"
								) or "animal"
							),
						math.floor(food),
						math.floor(
							preSwitchFoodTarget
						)
					)

			elseif preSwitchWaterTarget
				and water < preSwitchWaterTarget then

				state.growthTopUpForceWater(
					character,
					food,
					water,
					preSwitchWaterTarget
				)

			else
				state.growthTopUpResetWatch()
			end
		end)

		task.wait(0.45)
	end
end)

function state.slotSwitchCurrentIsElephant(character)
	character =
		character
		or player.Character

	local animalName =
		character
		and character:GetAttribute(
			"AnimalName"
		)

	local key =
		state.questAnimalKey(
			animalName
		)

	return key == "elephant"
		or key:find(
			"elephant",
			1,
			true
		) ~= nil
end

function state.slotSwitchTarget()
	refreshCompletionSpawns()

	local spawns = workspace:FindFirstChild("Spawns")

	-- PLAYER SELECTION WINS on every supported game. The old Savannah rule
	-- silently ignored Reset Spawn and forced PrideRockSpawn1, which made the
	-- final slot layout impossible to guarantee.
	local customSpawn = state.resolveResetSpawn()
	if customSpawn and customSpawn.Parent then
		return customSpawn.Position,
			state.spawnLocationLabel(customSpawn),
			customSpawn,
			false
	end

	-- A real player selection is sticky. If its Part is temporarily missing from
	-- replication, NEVER silently replace it with PrideRockSpawn1/NestRock3. That
	-- would park/switch the slot at the wrong location. Wait for the selected Part
	-- to resolve again instead.
	if type(state.resetSpawnFullName) == "string"
		and state.resetSpawnFullName ~= "" then

		return nil,
			"Selected Reset Spawn unavailable: " .. tostring(state.resetSpawnFullName),
			nil,
			false
	end

	-- Default Savannah reset/parking point. Strict validation is retained only
	-- for this default so a missing marker never parks slots at a random place.
	if isSavannahLife then
		local pride = spawns and spawns:FindFirstChild("PrideRockSpawn1", true)

		if pride and pride:IsA("BasePart") and pride.Parent then
			return pride.Position, "PrideRockSpawn1", pride, true
		end

		return nil, "PrideRockSpawn1 REQUIRED", nil, true
	end

	local spawnName = isDinoLife and "NestRock3" or "PrideRockSpawn1"
	local namedSpawn = spawns and spawns:FindFirstChild(spawnName, true)
	local target = namedSpawn and namedSpawn.Position or getSafeFarmPosition()
	local label = namedSpawn and spawnName or "default slot switch point"

	return target, label, namedSpawn, false
end

function state.atSlotSwitchPoint()
	local character, root =
		characterParts()

	if not character or not root then
		return false
	end

	local target, label, targetPart, strictPride =
		state.slotSwitchTarget()

	if typeof(target) ~= "Vector3" then
		return false
	end

	if strictPride
		and (
			not targetPart
				or not targetPart.Parent
				or targetPart.Name ~= "PrideRockSpawn1"
		) then
		return false
	end

	local flatDistance =
		Vector3.new(
			root.Position.X - target.X,
			0,
			root.Position.Z - target.Z
		).Magnitude

	local elephant =
		state.slotSwitchCurrentIsElephant(
			character
		)

	local maxDistance =
		elephant
			and 10
			or 14

	if flatDistance > maxDistance then
		return false
	end

	return state.normalizeDryLandState(
		character,
		root
	)
end

function state.moveBeforeSlotChange()
	-- IMPORTANT:
	-- Dino Life DOES keep the normal per-slot staging rule.
	-- When the CURRENT slot reaches 100%, move that completed slot to the selected
	-- Reset Point / Dino default switch point BEFORE changing to the next slot.
	--
	-- What is disabled in Dino is only the FINAL ALL-SLOTS parking audit that
	-- respawns every saved slot/animal again after Growth is already complete.
	-- Slot staging is NOT the same job as generic dry-ground recovery.
	-- ensureOnSolidGround() intentionally stops as soon as dry Terrain is found,
	-- which can report success while the animal is still hundreds of studs away
	-- from the actual slot-switch point. For slot changes the destination itself
	-- is authoritative: reach it, then confirm dry/safe ground there.
	local target, label, targetPart, strictPride =
		state.slotSwitchTarget()

	local initialCharacter =
		player.Character

	local elephant =
		state.slotSwitchCurrentIsElephant(
			initialCharacter
		)

	if typeof(target) ~= "Vector3" then
		runtimeMessage =
			strictPride
				and "Slot switch BLOCKED: PrideRockSpawn1 not found"
				or "Slot staging failed: invalid switch target"
		return false
	end

	if strictPride
		and (
			not targetPart
				or not targetPart.Parent
				or targetPart.Name ~= "PrideRockSpawn1"
		) then
		runtimeMessage =
			"Slot switch BLOCKED: exact PrideRockSpawn1 is required"
		return false
	end

	-- Slot staging is an exclusive Slots transaction, NOT Safety recovery. It also
	-- owns the interaction state: a completed animal must STOP eating/drinking before
	-- Reset Point locomotion begins. No opportunistic pulse is allowed during staging.
	state.slotStagingOpportunisticEat = false
	state.slotSwitchStagingActive = true
	state.slotSwitchStagingTarget = target
	state.slotSwitchLastBlockReason = nil

	-- Tear down every normal Survival interaction owner now that slot-switch vitals
	-- have already passed their safety threshold. This is deliberately local to the
	-- staging transaction and does not change the user's Auto Eat/Drink toggles.
	eatingToFull = false
	drinkingToFull = false
	eatingSourcePosition = nil
	drinkingSourcePosition = nil
	eatingTargetReachedAt = nil
	eatingStuckSince = nil
	state.questGiraffeFeeding = false
	state.questBaboonFeeding = false
	state.questCarnivoreFeeding = false
	if GIRAFFE then GIRAFFE.cancel() end
	if BABOON then BABOON.cancel() end
	state.carcassController.cancelRequested = true
	state.carcassController.token += 1
	clearActiveCarcass(true)
	state.survivalArbiterComplete("food")
	state.survivalArbiterComplete("water")

	if state.questMoveInteract then
		state.questMoveInteract.grassGraceUntil = 0
		state.questMoveInteract.drinkGraceUntil = 0
	end

	state.forceStopEatingSubState(initialCharacter, "Reset Point slot staging takeover")

	-- Take over stale locomotion left by the just-finished Quest/Growth route. Real
	-- Safety is never stolen; growthStep already refuses to enter staging during a
	-- critical recovery. All other semantic leases are safe to release because Food
	-- and Water already passed the slot-switch safety thresholds above.
	local ai = state.MMBAI
	local manager = ai and ai.MovementManager
	if manager and manager.lease and manager.lease.owner ~= "Slots"
		and manager.lease.owner ~= "Safety" then

		pcall(
			manager.CancelOwner,
			manager,
			manager.lease.owner,
			"Reset Point slot staging takeover",
			true
		)
	end

	if state.safeMove and state.safeMove.active
		and state.safeMove.reason ~= "slot_switch"
		and state.safeMove.reason ~= "safety" then

		state.safeMove.cancelToken += 1
		state.safeMove.active = false
		state.safeMove.target = nil
		state.safeMove.reason = nil
		state.safeMove.owner = nil
		state.busy = false
	end

	local staged = false

	local maxAttempts =
		elephant
			and 5
			or 3

	for attempt = 1, maxAttempts do
		local character, root = characterParts()
		if not character or not root then
			break
		end

		-- Never start a Reset Point route while the native Eating state is still
		-- latched. Reasserting Walking is cheap/idempotent and closes a server-frame race.
		state.forceStopEatingSubState(character, "Reset Point route attempt")

		-- Kill any stale Food/Water/Zone/Run MoveTo before staging. This does not
		-- disable the user's survival toggles; it only releases current movement.
		state.releaseMovementNow(character, true)
		blockClientSubState = false

		if state.atSlotSwitchPoint() then
			staged = true
			break
		end

		local inVoid = root.Position.Y < config.dangerY
		local buried =
			not isDinoLife
			and state.drinkIsBuriedUnderTerrain(root)

		runtimeMessage = string.format(
			elephant
				and "ELEPHANT staging: %s (%d/%d)"
				or "Slot staging: moving to %s (%d/%d)",
			tostring(label or "switch point"),
			attempt,
			maxAttempts
		)

		-- Even when PrideRockSpawn1 is mandatory, NEVER bypass the PrideRock
		-- avoidance circle. Elephant follows the same geometric avoidance as
		-- every other animal; only the staging destination/priority is special.
		local moved = safeMoveToPosition(
			target,
			7,
			nil,
			{
				purpose = "slot_switch",
				tolerance =
					elephant
						and 8
						or 11,


				-- Only void/buried recovery is allowed to use vertical transit.
				vertical = inVoid or buried,

				-- IMPORTANT: never stop merely because dry Terrain is underneath us.
				-- Slot staging must reach the actual switch point.
				stopOnDryGround = false,
				constantSpeed = true,
				forceMoveToLand = not (inVoid or buried),
				allowDuringGrowthReset = true,

				-- The selected Reset Point may be across a river. This is intentional
				-- transit, so river Safety must not cancel the slot route mid-crossing.
				allowWaterTransit = true,
				waterTransitKind = "slot_switch",
				maxDuration = 240,
			}
		)

		task.wait(0.20)

		-- Never trust the movement return value by itself. The slot switch point
		-- plus dry-ground validation is the final proof.
		if state.atSlotSwitchPoint() then
			staged = true
			break
		end

		if not moved then
			task.wait(0.20)
		end
	end

	state.slotSwitchStagingActive = false
	state.slotSwitchStagingTarget = nil
	state.slotStagingOpportunisticEat = false

	if staged then
		runtimeMessage = "Slot staging confirmed at " .. tostring(label or "switch point")
	else
		local _, root = characterParts()
		local distanceText = "unknown"
		if root then
			local flatDistance = Vector3.new(
				root.Position.X - target.X,
				0,
				root.Position.Z - target.Z
			).Magnitude
			distanceText = string.format("%.1f", flatDistance)
		end

		runtimeMessage = string.format(
			"Slot staging failed after %d routes; distance=%s%s",
			maxAttempts,
			distanceText,
			state.slotSwitchLastBlockReason
				and (" · " .. tostring(state.slotSwitchLastBlockReason))
				or ""
		)
	end

	return staged
end

function state.prepareCurrentSlotForSwitch(reason)
	local character, root =
		characterParts()

	if not character or not root then
		return false
	end

	state.releaseMovementNow(character, true)
	blockClientSubState = false

	if state.atSlotSwitchPoint() then
		return true
	end

	runtimeMessage = reason
		or "Staging current animal before slot switch"

	local moved = state.moveBeforeSlotChange()
	return moved == true and state.atSlotSwitchPoint()
end

function state.slotParkingEntryKey(entry)
	if type(entry) ~= "table" then
		return nil
	end

	local unique =
		entry.UniqueCharacterName
			or entry.CharacterUniqueName

	if type(unique) == "string"
		and unique ~= "" then
		return "U:" .. unique
	end

	local name = entry.CharacterName
	if type(name) == "string"
		and name ~= "" then
		return "N:" .. name .. "|" .. tostring(entry.AnimalName or "")
	end

	return nil
end

function state.slotParkingCharacterMatchesEntry(character, entry)
	if not character or type(entry) ~= "table" then
		return false
	end

	local expectedName = entry.CharacterName
	local expectedUnique =
		entry.UniqueCharacterName
			or entry.CharacterUniqueName

	local currentName =
		character:GetAttribute("CharacterName")

	local currentUnique =
		character:GetAttribute("UniqueCharacterName")
			or character:GetAttribute("CharacterUniqueName")

	if type(expectedName) == "string"
		and expectedName ~= ""
		and currentName == expectedName then
		return true
	end

	if type(expectedUnique) == "string"
		and expectedUnique ~= ""
		and (
			currentUnique == expectedUnique
				or currentName == expectedUnique
		) then
		return true
	end

	local resolved =
		state.questFindCurrentSavedEntry
		and state.questFindCurrentSavedEntry(
			savedCharacters(),
			character
		)
		or nil

	if resolved then
		local a = state.slotParkingEntryKey(entry)
		local b = state.slotParkingEntryKey(resolved)
		if a and b and a == b then
			return true
		end
	end

	return false
end

function state.slotParkingAuditAbort(message)
	local audit = state.slotParkingAudit
	if not audit then
		return
	end

	audit.active = false
	audit.busy = false
	audit.entries = nil
	audit.index = 1
	audit.retryAt = 0
	audit.reason = nil
	audit.startFarmCoins = false
	audit.attemptsByKey = {}
	audit.indexStartedAt = 0
	audit.lastProgressAt = 0

	state.growthBusy = false
	state.farmCoins = false
	state.slotStagingOpportunisticEat = false
	criticalRecoveryActive = false

	if state.safeMove
		and state.safeMove.active
		and state.safeMove.reason == "slot_switch" then
		state.safeMove.cancelToken += 1
		state.safeMove.active = false
		state.safeMove.target = nil
		state.safeMove.reason = nil
		state.busy = false
	end

	state.releaseMovementNow(player.Character, true)
	state.applySurvivalDefaults(false)

	runtimeMessage =
		message
			or "Final parking audit aborted safely; controls unlocked"

	if renders then
		for _, key in ipairs({
			"growExisting", "growAllSlots", "growNew",
			"farmCoins", "autoQuests", "autoEat", "autoDrink"
		}) do
			if renders[key] then
				renders[key]()
			end
		end
	end
end

function state.slotParkingAuditFinish(success, message)
	local audit = state.slotParkingAudit
	if not audit then return end

	local startCoins = success == true and audit.startFarmCoins == true

	audit.active = false
	audit.busy = false
	audit.entries = nil
	audit.index = 1
	audit.retryAt = 0
	audit.reason = nil
	audit.startFarmCoins = false
	audit.attemptsByKey = {}
	audit.indexStartedAt = 0
	audit.lastProgressAt = 0

	state.growthBusy = false
	state.farmCoins = startCoins
	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil
	questTravelWanted = false

	if state.questSetW then state.questSetW(false) end
	if state.questSetLandPermanentW then
		pcall(state.questSetLandPermanentW, false)
	end

	criticalRecoveryActive = false
	state.applySurvivalDefaults(false)

	runtimeMessage = message
		or (
			success
				and (startCoins
					and "All slots parked at Reset Point; AFK Coin Farm started"
					or "All slots parked at Reset Point")
				or "Slot parking audit stopped; retry required"
		)

	if renders then
		for _, key in ipairs({
			"growExisting", "growAllSlots", "growNew", "farmCoins",
			"autoQuests", "autoEat", "autoDrink"
		}) do
			if renders[key] then renders[key]() end
		end
	end
end

function state.slotParkingAuditRun()
	local audit = state.slotParkingAudit
	if not audit or not audit.active or audit.busy then
		return
	end

	audit.busy = true
	audit.attemptsByKey =
		type(audit.attemptsByKey) == "table"
			and audit.attemptsByKey
			or {}
	audit.lastProgressAt = tick()

	state.growthBusy = true
	state.farmCoins = false

	while state.alive and audit.active do
		if audit.startFarmCoins == true
			and state.questSeenAny == true
			and not isDinoLife then

			local pendingSpecific, requiredAnimal =
				state.questHasIncompleteSpecificAnimalQuest(
					getAllQuests(),
					savedCharacters()
				)

			if pendingSpecific then
				state.slotParkingAuditFinish(
					false,
					"Parking paused: specific-animal quest has priority"
				)

				state.autoQuests = true
				state.farmCoins = false
				state.questActionablePending = true
				state.questMovementPriorityPending = true
				state.questForceFastRecheckUntil = tick() + 20
				questStatusText =
					"Specific-animal quest first: "
					.. tostring(requiredAnimal)
				runtimeMessage =
					"Parking stopped before next slot: completing required animal mission first"

				if renders and renders.autoQuests then
					renders.autoQuests()
				end
				return
			end
		end

		local entries = audit.entries or {}
		local index = tonumber(audit.index) or 1
		local entry = entries[index]

		if not entry then
			state.slotParkingAuditFinish(
				true,
				audit.startFarmCoins
					and "Parking complete: every unique saved slot verified at Reset Point -> AFK Coin Farm"
					or "Parking complete: every unique saved slot verified at Reset Point"
			)
			return
		end

		local entryKey =
			state.slotParkingEntryKey(entry)
			or ("INDEX:" .. tostring(index))

		if audit.indexStartedAt <= 0 then
			audit.indexStartedAt = tick()
		end

		if tick() - audit.indexStartedAt >= 300 then
			state.slotParkingAuditAbort(
				"Parking audit stopped: one slot made no verifiable progress for 5 minutes; controls unlocked"
			)
			return
		end

		local expectedLabel =
			entry.CharacterName
				or entry.UniqueCharacterName
				or entry.CharacterUniqueName
				or entry.AnimalName
				or "slot"

		local current = player.Character
		local currentMatches =
			state.slotParkingCharacterMatchesEntry(current, entry)

		if not currentMatches then
			if current
				and current:FindFirstChild("HumanoidRootPart") then

				if not state.atSlotSwitchPoint() then
					runtimeMessage =
						string.format(
							"Parking audit: staging current slot before %s (%d/%d)",
							tostring(expectedLabel),
							index,
							#entries
						)

					if not state.prepareCurrentSlotForSwitch(
						"Parking audit: moving current slot to Reset Point"
					) then
						local attempts =
							(audit.attemptsByKey[entryKey] or 0) + 1
						audit.attemptsByKey[entryKey] = attempts

						if attempts >= 4 then
							state.slotParkingAuditAbort(
								"Parking audit stopped: current slot could not be staged safely; controls unlocked"
							)
							return
						end

						task.wait(0.75)
						continue
					end
				end

				if state.slotGuardianMarkPlanned then
					state.slotGuardianMarkPlanned(
						"final slot parking switch",
						24
					)
				end

				if ResetRemote then
					pcall(ResetRemote.InvokeServer, ResetRemote)
				end
				task.wait(2.25)
			end

			runtimeMessage =
				string.format(
					"Parking audit: loading %s (%d/%d)",
					tostring(expectedLabel),
					index,
					#entries
				)

			local spawned =
				spawnSlot(entry, true, true)

			if not spawned then
				local attempts =
					(audit.attemptsByKey[entryKey] or 0) + 1
				audit.attemptsByKey[entryKey] = attempts

				if attempts >= 3 then
					state.slotParkingAuditAbort(
						"Parking audit stopped: slot "
						.. tostring(expectedLabel)
						.. " could not be confirmed after 3 attempts; controls unlocked"
					)
					return
				end

				task.wait(1.5)
				continue
			end

			local confirmDeadline = tick() + 4
			repeat
				current = player.Character
				if state.slotParkingCharacterMatchesEntry(current, entry) then
					currentMatches = true
					break
				end
				task.wait(0.20)
			until tick() >= confirmDeadline

			if not currentMatches then
				local attempts =
					(audit.attemptsByKey[entryKey] or 0) + 1
				audit.attemptsByKey[entryKey] = attempts

				if attempts >= 3 then
					state.slotParkingAuditAbort(
						"Parking audit stopped: spawned slot identity never stabilized; controls unlocked"
					)
					return
				end

				task.wait(1.0)
				continue
			end
		end

		runtimeMessage =
			string.format(
				"Parking audit: %s -> Reset Point (%d/%d)",
				tostring(expectedLabel),
				index,
				#entries
			)

		if not state.prepareCurrentSlotForSwitch(
			"Parking audit: positioning slot at selected/default Reset Point"
		) then
			local attempts =
				(audit.attemptsByKey[entryKey] or 0) + 1
			audit.attemptsByKey[entryKey] = attempts

			if attempts >= 4 then
				state.slotParkingAuditAbort(
					"Parking audit stopped: "
					.. tostring(expectedLabel)
					.. " could not be verified at Reset Point; controls unlocked"
				)
				return
			end

			task.wait(0.75)
			continue
		end

		if not state.atSlotSwitchPoint() then
			local attempts =
				(audit.attemptsByKey[entryKey] or 0) + 1
			audit.attemptsByKey[entryKey] = attempts

			if attempts >= 4 then
				state.slotParkingAuditAbort(
					"Parking audit stopped: Reset Point confirmation kept failing; controls unlocked"
				)
				return
			end

			task.wait(0.50)
			continue
		end

		audit.attemptsByKey[entryKey] = nil
		audit.index = index + 1
		audit.indexStartedAt = 0
		audit.lastProgressAt = tick()

		runtimeMessage =
			string.format(
				"Parking audit: %s verified (%d/%d)",
				tostring(expectedLabel),
				index,
				#entries
			)

		while entries[audit.index] do
			local nextKey =
				state.slotParkingEntryKey(entries[audit.index])
			if nextKey and nextKey == entryKey then
				audit.index += 1
			else
				break
			end
		end

		if entries[audit.index] then
			if state.slotGuardianMarkPlanned then
				state.slotGuardianMarkPlanned(
					"final slot parking next slot",
					24
				)
			end

			if ResetRemote then
				pcall(ResetRemote.InvokeServer, ResetRemote)
			end
			task.wait(2.25)
		end
	end

	if audit.active then
		state.slotParkingAuditAbort(
			"Parking audit interrupted; controls unlocked"
		)
	end
end

function state.slotParkingAuditStart(reason, startFarmCoins)
	local audit = state.slotParkingAudit
	if not audit then return false end

	-- Dino Life: disable ONLY the FINAL ALL-SLOTS parking audit.
	--
	-- Normal per-slot staging is preserved:
	-- CURRENT slot reaches 100% -> move current completed slot to Reset Point
	-- -> switch to next slot.
	--
	-- What we do NOT do in Dino:
	-- after every Growth slot is finished, respawn EVERY saved animal/slot again
	-- just to audit/park all of them one-by-one.
	if isDinoLife then
		audit.active = false
		audit.busy = false
		audit.entries = nil
		audit.index = 1
		audit.retryAt = 0
		audit.reason = nil
		audit.startFarmCoins = false
		audit.attemptsByKey = {}
		audit.indexStartedAt = 0
		audit.lastProgressAt = 0
		state.growthBusy = false
		state.farmCoins = startFarmCoins == true
		criticalRecoveryActive = false
		state.applySurvivalDefaults(false)
		runtimeMessage = startFarmCoins == true
			and "Dino Life: final all-slot audit skipped; AFK Coin Farm continuing"
			or "Dino Life: final all-slot parking audit skipped"
		if renders then
			for _, key in ipairs({
				"growExisting", "growAllSlots", "growNew",
				"farmCoins", "autoEat", "autoDrink"
			}) do
				if renders[key] then renders[key]() end
			end
		end
		return true
	end

	-- Second-line protection for the quest -> parking -> AFK handoff. Any parking
	-- pass that is about to start AFK Coin after a real Auto Quest session must
	-- wait for resolvable specific-animal missions (Dog/Lion/etc.) to finish first.
	-- This also covers the post-quest Growth path, whose reason is "Growth complete".
	local questAwareParking =
		startFarmCoins == true
		and state.questSeenAny == true
		and not isDinoLife

	if questAwareParking then
		local liveQuests = getAllQuests()
		local liveRecords = savedCharacters()
		local hasSpecific, specificAnimal =
			state.questHasIncompleteSpecificAnimalQuest(
				liveQuests,
				liveRecords
			)

		if hasSpecific then
			state.farmCoins = false
			state.autoQuests = true
			state.questActionablePending = true
			state.questMovementPriorityPending = true
			state.questForceFastRecheckUntil = tick() + 20
			questStatusText =
				"Specific-animal quest first: " .. tostring(specificAnimal)
			runtimeMessage =
				"Parking deferred: finish specific-animal quest before auditing slots"

			if renders and renders.autoQuests then
				renders.autoQuests()
			end

			return false
		end
	end

	if audit.active then
		if startFarmCoins == true then
			audit.startFarmCoins = true
		end
		return true
	end

	local rawRecords = savedCharacters()

	-- Final parking works with UNIQUE saved slots. Duplicate replication entries
	-- are ignored so the audit can never reset/spawn the same slot repeatedly.
	local records = {}
	local seenParkingKeys = {}

	for _, entry in ipairs(rawRecords) do
		local key = state.slotParkingEntryKey(entry)
		if key then
			if not seenParkingKeys[key] then
				seenParkingKeys[key] = true
				records[#records + 1] = entry
			end
		else
			records[#records + 1] = entry
		end
	end

	if #records == 0 then
		audit.active = true
		audit.busy = false
		audit.entries = nil
		audit.index = 1
		audit.reason = reason or "waiting for SavedCharacters"
		audit.startFarmCoins = startFarmCoins == true
		audit.attemptsByKey = {}
		audit.indexStartedAt = 0
		audit.lastProgressAt = tick()
		state.farmCoins = false
		state.growthBusy = true
		runtimeMessage = "Parking audit: SavedCharacters unavailable; retrying before AFK"

		mmbTaskDelay(2.0, function()
			if not state.alive or not audit.active or audit.entries then return end
			audit.active = false
			state.slotParkingAuditStart(reason, startFarmCoins)
		end)

		return true
	end

	-- Park the currently active slot first so it is never reset away before being
	-- verified. Remaining slots keep deterministic CharacterName order.
	local current = player.Character
	local currentName = current and current:GetAttribute("CharacterName")
	if type(currentName) == "string" and currentName ~= "" then
		for i, entry in ipairs(records) do
			if entry.CharacterName == currentName then
				table.remove(records, i)
				table.insert(records, 1, entry)
				break
			end
		end
	end

	audit.active = true
	audit.busy = false
	audit.entries = records
	audit.index = 1
	audit.retryAt = 0
	audit.reason = reason or "growth complete"
	audit.startFarmCoins = startFarmCoins == true
	audit.attemptsByKey = {}
	audit.indexStartedAt = 0
	audit.lastProgressAt = tick()

	state.farmCoins = false
	state.growthBusy = true
	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil
	questTravelWanted = false

	if state.safeMove and state.safeMove.active then
		state.safeMove.cancelToken += 1
	end
	if state.questSetW then state.questSetW(false) end
	if state.questSetLandPermanentW then
		pcall(state.questSetLandPermanentW, false)
	end

	-- Kill stale survival ROUTES only; user toggles remain unchanged and are
	-- restored automatically after the final slot is parked.
	eatingToFull = false
	drinkingToFull = false
	eatingSourcePosition = nil
	drinkingSourcePosition = nil
	eatingTargetReachedAt = nil
	clearActiveCarcass(true)
	state.questCarnivoreFeeding = false
	state.questBaboonFeeding = false
	state.questGiraffeFeeding = false
	BABOON.cancel()
	GIRAFFE.cancel()
	state.survivalArbiterComplete("food")
	state.survivalArbiterComplete("water")
	state.releaseMovementNow(player.Character, true)

	runtimeMessage = string.format(
		"Final parking audit: verifying %d saved slots at Reset Point",
		#records
	)

	task.spawn(state.slotParkingAuditRun)
	return true
end

function state.growthStep()
	if not state.aiModuleOperational("GrowSlots") then return end
	if not state.aiMovementOperational("Growth") then return end
	if state.herbivoreFoodRecovery
		and state.herbivoreFoodRecovery.active
		and state.herbivoreFoodRecovery.character
			== player.Character then

		return
	end

	if GIRAFFE.exclusiveRecovery
		and GIRAFFE.exclusiveRecovery.active
		and isGiraffeCharacter(
			player.Character
		) then

		return
	end

	if state.questGrowthReset.exclusive then return end
	if state.slotParkingAudit and state.slotParkingAudit.active then return end

	if state.busy
		and state.autoGrowCurrentSlotComplete(player.Character)
		and state.safeMove
		and state.safeMove.active
		and (state.safeMove.reason == "quest"
			or state.safeMove.reason == "growth_home") then
		state.safeMove.cancelToken += 1
		state.safeMove.active = false
		state.safeMove.reason = nil
		state.busy = false
		state.releaseMovementNow(player.Character, true)
		state.questForceFastRecheckUntil = tick() + 15
	end

	-- v5.3: a completed Auto-Grow slot with safe vitals is already a pending Slots
	-- transaction even before moveBeforeSlotChange() raises slotSwitchStagingActive.
	-- Kill a passive/committed carnivore Food route here so state.busy cannot make
	-- growthStep return and let carcass patrol restart between Reset Point attempts.
	do
		local completedCharacter = player.Character
		if completedCharacter
			and state.autoGrowModeActive()
			and state.autoGrowCurrentSlotComplete(completedCharacter) then

			local completedFood =
				tonumber(completedCharacter:GetAttribute("Food")) or 100
			local completedWater =
				tonumber(completedCharacter:GetAttribute("Water")) or 100
			local completedThreshold =
				isCarnivoreCharacter(completedCharacter) and 50 or 60

			if completedFood > completedThreshold
				and completedWater > completedThreshold then

				local foodMoveActive =
					state.safeMove
					and state.safeMove.active
					and state.safeMove.reason == "food"

				if carcassEatBusy
					or activeCarcass ~= nil
					or foodMoveActive then

					state.carcassController.cancelRequested = true
					state.carcassController.token += 1
					clearActiveCarcass(true)
					carcassEatBusy = false
					eatingToFull = false
					eatingSourcePosition = nil
					eatingTargetReachedAt = nil
					eatingStuckSince = nil
					state.questCarnivoreFeeding = false

					if foodMoveActive then
						state.safeMove.cancelToken += 1
						state.safeMove.active = false
						state.safeMove.target = nil
						state.safeMove.reason = nil
						state.safeMove.owner = nil
						state.busy = false
					end

					state.survivalArbiterComplete("food")
					runtimeMessage =
						"Growth 100%: carcass patrol cancelled; Reset Point has priority"
				end
			end
		end
	end

	if state.farmCoins
		or state.growthBusy
		or state.busy
		or not (
			state.growExisting
			or state.growAllSlots
			or state.growNew
		) then
		return
	end
	-- Se uma rotina crítica (saída de água/void) estiver no controle do
	-- personagem, o growthStep NÃO pode religar autoEat/autoDrink nem fazer
	-- nada — senão as duas rotinas brigam pra mover o personagem pra
	-- lugares diferentes ao mesmo tempo (isso já matou um Rex no Dino Life).
	if criticalRecoveryActive then return end
	state.applySurvivalDefaults(
		false
	)
	if renders then
		if renders.autoEat then renders.autoEat() end
		if renders.autoDrink then renders.autoDrink() end
	end
	local character = player.Character
	if not character then return end

	local growth = character:GetAttribute("GrowthPercentage")
	if type(growth) ~= "number" then return end

	local growthComplete = isGrowthComplete(growth)

	-- Pride Rock is a HOME rule only while the slot is still growing. Once it
	-- reaches 100%, Reset Point + slot switch outrank every Pride/Quest destination.
	if not growthComplete then
		local growthRoot =
			character:FindFirstChild("HumanoidRootPart")

		if growthRoot
			and state.growthPrideRestrictionActive(
				character
			)
			and not state.growthPrideInside(
				character,
				growthRoot
			) then

			local growthWater =
				tonumber(
					character:GetAttribute("Water")
				) or 100

			if not drinkingToFull
				and not forcingPostDrinkMove
				and not criticalRecoveryActive
				and growthWater > 75 then

				state.growthPride.returnRequested = true
				runtimeMessage =
					"Growth herbivore: Pride Rock required while slot is below 100%"
				return
			end
		end

		return
	end

	-- v106 slot-switch rule:
	-- Carnivores only need Food + Water ABOVE 50%.
	-- Herbivores/other animals only need Food + Water ABOVE 60%.
	-- No more waiting for ~100% before changing slots.
	local food =
		tonumber(
			character:GetAttribute("Food")
		) or 100

	local water =
		tonumber(
			character:GetAttribute("Water")
		) or 100

	local slotSafeThreshold =
		isCarnivoreCharacter(character)
			and 50
			or 60

	-- "Above" means 51/61 is the first accepted integer target.
	local slotSafeTarget =
		slotSafeThreshold + 1

	local foodSafe =
		food > slotSafeThreshold

	local waterSafe =
		water > slotSafeThreshold

	-- Truly critical Water may save the slot first. Otherwise Food is serviced
	-- before normal thirst so a completed Giraffe at 43% Food cannot be stranded
	-- behind a non-critical Drink owner.
	if not waterSafe
		and water <= 45 then

		state.growthTopUpForceWater(
			character,
			food,
			water,
			slotSafeTarget
		)

		runtimeMessage =
			string.format(
				"Slot switch safety: critical Water %d%% -> >%d%%",
				math.floor(water),
				slotSafeThreshold
			)

		return

	elseif not foodSafe then
		state.growthTopUpForceFood(
			character,
			food,
			water,
			slotSafeTarget
		)

		runtimeMessage =
			string.format(
				"Slot switch safety: Food %d%% -> >%d%%",
				math.floor(food),
				slotSafeThreshold
			)

		return

	elseif not waterSafe then
		state.growthTopUpForceWater(
			character,
			food,
			water,
			slotSafeTarget
		)

		runtimeMessage =
			string.format(
				"Slot switch safety: Water %d%% -> >%d%%",
				math.floor(water),
				slotSafeThreshold
			)

		return

	else
		preSwitchFoodTarget = nil
		preSwitchWaterTarget = nil

		state.growthTopUp.active = false
		state.growthTopUp.startedAt = nil
		state.growthTopUpResetWatch()
	end

	-- User may disable Auto Grow while Food/Water safety was being serviced.
	-- Never continue into Reset Point / slot switching after the owner is OFF.
	if not state.autoGrowModeActive() then
		state.growthTopUp.active = false
		state.growthTopUp.startedAt = nil
		state.growthTopUpResetWatch()
		preSwitchFoodTarget = nil
		preSwitchWaterTarget = nil
		state.growthBusy = false
		runtimeMessage = "Auto Grow disabled; pending slot switch cancelled"
		return
	end

	-- Slot staging must never fight the game's native Eating state. Giraffe can
	-- reach 100% while the HUD still says "stop eating" even after GIRAFFE.busy
	-- was cleared, so release the server sub-state unconditionally here.
	state.forceStopEatingSubState(
		character,
		"completed slot staging"
	)
	eatingToFull = false
	eatingSourcePosition = nil
	eatingTargetReachedAt = nil
	eatingStuckSince = nil
	state.questGiraffeFeeding = false
	GIRAFFE.cancel()

	local completedName = character:GetAttribute("CharacterName")
	local completedAnimal = character:GetAttribute("AnimalName")
	local previousEntry
	for _, candidate in ipairs(savedCharacters()) do
		if candidate.CharacterName == completedName then
			previousEntry = candidate
			break
		end
	end
	if type(completedName) == "string" and completedName ~= "" then
		sessionCompletedSlots[completedName] = true
	end
	state.growthBusy = true

	if state.questGrowthConcurrentActive() then
		state.questSwimActive = false
		state.questSwimReady = false
		state.questTravelActive = false
		state.questLandInputActive = false
		state.questMotionMoving = false
		state.questMotionMode = nil
		questTravelWanted = false
		state.questSetW(false)
		if state.questSetLandPermanentW then
			state.questSetLandPermanentW(false)
		end
		removeSwimBarrier()
	end

	state.growthTopUp.active = false
	state.growthTopUp.startedAt = nil
	state.growthTopUpResetWatch()
	preSwitchFoodTarget = nil
	preSwitchWaterTarget = nil

	-- 1+2+3: para de comer/beber e move pro PrideRockSpawn1 ANTES de
	-- qualquer troca de slot, seja crescendo existentes ou criando novos.
	-- Se não conseguir CONFIRMAR terra firme (sem void, sem água), aborta
	-- essa tentativa e deixa o próximo ciclo do growthStep tentar de novo
	-- — nunca troca de slot estando dentro do void ou da água.
	local landedSafely =
		state.moveBeforeSlotChange()
	if not landedSafely then
		runtimeMessage =
			state.slotSwitchLastBlockReason
				and ("Slot staging delayed: " .. tostring(state.slotSwitchLastBlockReason))
				or "Reset Point not reached; delaying slot switch"
		state.applySurvivalDefaults(
			false
		)
		if renders then
			if renders.autoEat then renders.autoEat() end
			if renders.autoDrink then renders.autoDrink() end
		end
		state.growthBusy = false
		return
	end
	task.wait(0.5)

	if not state.autoGrowModeActive() then
		state.growthBusy = false
		runtimeMessage = "Auto Grow disabled at Reset Point; slot switch cancelled"
		return
	end

	local entry
	if state.growExisting or state.growAllSlots then
		local automaticAll = state.growExistingAutomaticAll == true
		local manualAll = state.growAllSlots == true
		local allAnimals = automaticAll or manualAll

		if automaticAll then
			runtimeMessage =
				"AUTO Grow Existing: scanning ALL animal species for slots below 100%"
		elseif manualAll then
			runtimeMessage =
				"Grow All Slots: scanning ALL animal species for slots below 100%"
		else
			runtimeMessage =
				"Abrindo lista de " .. tostring(completedAnimal or "animais")
		end

		if state.slotGuardianMarkPlanned then
			state.slotGuardianMarkPlanned(
				"intentional script reset",
				24
			)
		end
		if ResetRemote then pcall(ResetRemote.InvokeServer, ResetRemote) end
		task.wait(2.5)

		local refreshed = savedCharacters()

		entry = allAnimals
			and nextExistingSlot(nil, refreshed, true)
			or nextExistingSlot(completedAnimal, refreshed, false)
		if not previousEntry then
			for _, candidate in ipairs(refreshed) do
				if candidate.CharacterName == completedName then
					previousEntry = candidate
					break
				end
			end
		end
	end
	if entry then
		if state.growExistingAutomaticAll then
			questStatusText = string.format(
				"AUTO Grow All: %s · %s%%",
				tostring(entry.AnimalName or "Animal"),
				tostring(entry.GrowthPercentage or "?")
			)
			runtimeMessage =
				"Automatic Grow Existing switched species to continue every saved slot below 100%"

		elseif state.growAllSlots then
			questStatusText = string.format(
				"Grow All Slots: %s · %s%%",
				tostring(entry.AnimalName or "Animal"),
				tostring(entry.GrowthPercentage or "?")
			)
			runtimeMessage =
				"Grow All Slots switched species to continue every saved slot below 100%"
		end

		local spawnedNextGrowthSlot = spawnSlot(entry, true)

		if spawnedNextGrowthSlot then
			state.rearmSurvivalAfterSlotSpawn(
				"Grow Existing Slots spawned next slot"
			)
		end

		if spawnedNextGrowthSlot and state.autoQuests then
			state.questZoneLastMoveAt = 0
			state.questZoneLastTarget = nil
			state.questZonePriority.active = false
			state.questZonePriority.zone = nil
			state.questZonePriority.resolved = false
			state.questSwimActive = false
			state.questSwimReady = false
			state.questForceFastRecheckUntil = tick() + 25
			runtimeMessage = "Next Growth slot active; returning to pending Zone/Swim quests"
		end

	elseif state.growNew then
		local totalSlots = #savedCharacters()
		if totalSlots >= state.growthTopUp.maxSlots then
			local startCoinsAfterParking = not state.autoQuests
			state.growExisting, state.growNew = false, false
			state.growExistingAutomaticAll = false
			state.growAllSlots = false
			state.farmCoins = false

			if state.autoQuests then
				state.questForceFastRecheckUntil = tick() + 25
				questStatusText = "Grow New complete; finishing remaining quests"
				runtimeMessage = "Slot limit reached; quests finish before final parking audit"
			else
				runtimeMessage =
					"Slot limit reached; parking every saved slot before next automation"

				state.slotParkingAuditStart(
					"Grow New Slots complete",
					startCoinsAfterParking
				)
			end
		else
			runtimeMessage = "Criando novo slot"
			local spawnedNewGrowthSlot =
				state.createNextSlot()

			if spawnedNewGrowthSlot then
				state.rearmSurvivalAfterSlotSpawn(
					"Grow New Slots spawned new slot"
				)
			end

			if state.autoQuests then
				state.questZoneLastMoveAt = 0
				state.questZoneLastTarget = nil
				state.questSwimReady = false
				state.questForceFastRecheckUntil = tick() + 25
			end
		end
	elseif state.growExisting or state.growAllSlots then
		local postQuestGrow = state.questPostGrowAll == true
		local startCoinsAfterParking = (not state.autoQuests) or postQuestGrow

		if state.growExistingAutomaticAll then
			questStatusText = "AUTO Grow All complete -> parking every slot"
		elseif state.growAllSlots then
			questStatusText = "Grow All Slots complete -> parking every slot"
		elseif postQuestGrow then
			questStatusText = "All existing slots 100% -> parking every slot"
		else
			questStatusText = "Growth complete -> parking every slot"
		end

		state.questPostGrowAll = false
		state.growExisting = false
		state.growAllSlots = false
		state.growNew = false
		state.growExistingAutomaticAll = false
		state.farmCoins = false

		if state.autoQuests and not postQuestGrow then
			state.questForceFastRecheckUntil = tick() + 25
			questStatusText = "All Growth slots 100%; finishing remaining quests"
			runtimeMessage = "Auto Grow complete; quests finish before final parking audit"
		else
			state.slotParkingAuditStart(
				"Growth complete",
				startCoinsAfterParking
			)
		end
	end
	state.applySurvivalDefaults(
		false
	)
	if renders then
		for _, key in ipairs({
			"growExisting", "growAllSlots", "growNew",
			"farmCoins", "autoEat", "autoDrink"
		}) do
			if renders[key] then renders[key]() end
		end
	end
	state.growthBusy = false
end

