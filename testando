		or 0

function state.slotNameNormalize(name)
	if type(name) ~= "string" then
		return ""
	end

	return name:lower()
end

function state.slotNameLocalSafe(candidate)
	if type(candidate) ~= "string" then
		return false, "not_string"
	end

	local length = #candidate
	if length < 4 or length > 14 then
		return false, "length"
	end

	-- New slot names are intentionally letters-only.
	if candidate:find("[^A-Za-z]") then
		return false, "characters"
	end

	local lower =
		candidate:lower()

	-- Avoid obviously malformed generated output.
	if lower:find("(.)%1%1") then
		return false, "repeated_letters"
	end

	for _, fragment in ipairs(
		state.slotNameBlockedFragments
	) do
		if lower:find(
			fragment,
			1,
			true
		) then
			return false,
				"blocked_fragment:"
					.. fragment
		end
	end

	return true
end

function state.slotNamePassesRobloxFilter(candidate)
	local key =
		state.slotNameNormalize(
			candidate
		)

	if key == "" then
		return false, "empty"
	end

	local cached =
		state.slotNameFilterCache[
			key
		]

	if cached ~= nil then
		return cached == true,
			cached == true
				and nil
				or "roblox_filter"
	end

	-- Most normal LocalScripts cannot call the full filtering API. If the
	-- current executor/client cannot either, stop retrying the unavailable API
	-- and rely on the controlled generator + local deny-list.
	if state.slotNameFilterUnavailable then
		return true, "filter_unavailable_local_validation_only"
	end

	local okFilter, filterResult =
		pcall(
			TextService.FilterStringAsync,
			TextService,
			candidate,
			player.UserId
		)

	if not okFilter
		or not filterResult then

		state.slotNameFilterUnavailable = true
		return true,
			"filter_unavailable_local_validation_only"
	end

	local okBroadcast, filtered =
		pcall(
			filterResult.GetNonChatStringForBroadcastAsync,
			filterResult
		)

	if not okBroadcast
		or type(filtered) ~= "string" then

		state.slotNameFilterUnavailable = true
		return true,
			"filter_unavailable_local_validation_only"
	end

	local accepted =
		filtered == candidate
		and not filtered:find(
			"#",
			1,
			true
		)

	state.slotNameFilterCache[
		key
	] = accepted

	return accepted,
		accepted
			and nil
			or "roblox_filter"
end

function state.slotNameUsedSet()
	local now = tick()
	local used = {}

	local function add(name)
		if type(name) == "string"
			and name ~= "" then

			used[
				name:lower()
			] = true
		end
	end

	-- Check EVERY saved animal/slot, irrespective of species.
	for _, entry in ipairs(
		savedCharacters()
	) do
		if type(entry) == "table" then
			add(entry.CharacterName)
			add(entry.UniqueCharacterName)
			add(entry.CharacterUniqueName)
		end
	end

	-- SavedCharacters can lag one replication step behind the live character.
	local character =
		player.Character

	if character then
		add(
			character:GetAttribute(
				"CharacterName"
			)
		)
		add(
			character:GetAttribute(
				"UniqueCharacterName"
			)
		)
		add(
			character:GetAttribute(
				"CharacterUniqueName"
			)
		)
	end

	-- In-flight reservation closes the race between CreateRemote and the next
	-- SavedCharacters replication.
	for lowerName, expiresAt in pairs(
		state.slotNameReserved
	) do
		if tonumber(expiresAt)
			and expiresAt > now then

			used[lowerName] = true
		else
			state.slotNameReserved[
				lowerName
			] = nil
		end
	end

	-- Rejected names stay quarantined for this session window.
	for lowerName, expiresAt in pairs(
		state.slotNameRejected
	) do
		if tonumber(expiresAt)
			and expiresAt > now then

			used[lowerName] = true
		else
			state.slotNameRejected[
				lowerName
			] = nil
		end
	end

	return used
end

function state.slotNameReserve(
	candidate,
	seconds
)
	local key =
		state.slotNameNormalize(
			candidate
		)

	if key == "" then
		return
	end

	state.slotNameReserved[
		key
	] = tick()
		+ math.max(
			10,
			tonumber(seconds) or 90
		)
end

function state.slotNameRelease(candidate)
	local key =
		state.slotNameNormalize(
			candidate
		)

	if key ~= "" then
		state.slotNameReserved[
			key
		] = nil
	end
end

function state.slotNameReject(
	candidate,
	seconds
)
	local key =
		state.slotNameNormalize(
			candidate
		)

	if key == "" then
		return
	end

	state.slotNameReserved[
		key
	] = nil

	state.slotNameRejected[
		key
	] = tick()
		+ math.max(
			60,
			tonumber(seconds) or 900
		)
end

function state.slotNameAcceptable(
	candidate,
	used
)
	local key =
		state.slotNameNormalize(
			candidate
		)

	if key == ""
		or (
			used
			and used[key]
		) then

		return false,
			"duplicate"
	end

	local localSafe, localReason =
		state.slotNameLocalSafe(
			candidate
		)

	if not localSafe then
		return false,
			localReason
	end

	local filterSafe, filterReason =
		state.slotNamePassesRobloxFilter(
			candidate
		)

	if not filterSafe then
		return false,
			filterReason
	end

	return true
end

function state.slotNameProceduralCandidate(sequence)
	local starts =
		state.slotNameProceduralStarts

	local middles =
		state.slotNameProceduralMiddles

	local endings =
		state.slotNameProceduralEnds

	local total =
		#starts
		* #middles
		* #endings

	if total <= 0 then
		return nil
	end

	sequence =
		math.max(
			0,
			math.floor(
				tonumber(sequence) or 0
			)
		)

	-- Deterministic-but-account-specific permutation. No math.random dependency,
	-- and consecutive slots do not always share the same root.
	local index =
		(
			player.UserId * 131
				+ sequence * 977
				+ math.floor(
					tick() * 10
				)
		) % total

	local startIndex =
		(index % #starts) + 1

	local middleIndex =
		(
			math.floor(
				index / #starts
			) % #middles
		) + 1

	local endIndex =
		(
			math.floor(
				index
					/ (
						#starts
						* #middles
					)
			) % #endings
		) + 1

	return starts[startIndex]
		.. middles[middleIndex]
		.. endings[endIndex]
end

function state.uniqueSlotName()
	local used =
		state.slotNameUsedSet()

	local seenThisPass = {}

	local function tryCandidate(candidate)
		local key =
			state.slotNameNormalize(
				candidate
			)

		if key == ""
			or seenThisPass[key] then

			return nil
		end

		seenThisPass[key] = true

		local accepted =
			state.slotNameAcceptable(
				candidate,
				used
			)

		if not accepted then
			return nil
		end

		state.slotNameReserve(
			candidate,
			120
		)

		return candidate
	end

	-- 1) Prefer the curated list exactly as supplied. Duplicates such as Solaris
	-- / Vitalis are naturally skipped because uniqueness is case-insensitive.
	for _, name in ipairs(
		state.slotNamePool
	) do
		local accepted =
			tryCandidate(
				name
			)

		if accepted then
			return accepted
		end
	end

	-- 2) Procedural fallback. 15 roots * 12 middle options * 10 endings = 1800
	-- combinations, far above the supported slot count.
	local totalProcedural =
		#state.slotNameProceduralStarts
		* #state.slotNameProceduralMiddles
		* #state.slotNameProceduralEnds

	state.slotNameSequence += 1

	for attempt = 0, totalProcedural - 1 do
		local candidate =
			state.slotNameProceduralCandidate(
				state.slotNameSequence
					+ attempt
			)

		local accepted =
			tryCandidate(
				candidate
			)

		if accepted then
			state.slotNameSequence +=
				attempt

			return accepted
		end
	end

	return nil
end

function state.slotNameFindSaved(candidate)
	if type(candidate) ~= "string"
		or candidate == "" then

		return nil
	end

	local wanted =
		candidate:lower()

	for _, entry in ipairs(
		savedCharacters()
	) do
		if type(entry) == "table" then
			local name =
				entry.CharacterName

			if type(name) == "string"
				and name:lower() == wanted then

				return entry
			end
		end
	end

	return nil
end

function state.createNextSlot()
	if not CreateRemote
		or not ResetRemote then

		return false
	end

	local character =
		player.Character

	if not character then
		return false
	end

	if not state.atSlotSwitchPoint()
		and not state.prepareCurrentSlotForSwitch(
			"Growth: staging current animal before creating next slot"
		) then

		return false
	end

	-- Capture species data BEFORE ResetRemote removes the live character.
	local animalName =
		character:GetAttribute(
			"AnimalName"
		) or "Elephant"

	local gender =
		state.newSlotGender
			or character:GetAttribute(
				"Gender"
			)
			or "Female"

	local skin =
		character:GetAttribute(
			"Skin"
		) or "Default"

	if state.slotGuardianMarkPlanned then
		state.slotGuardianMarkPlanned(
			"intentional script reset",
			24
		)
	end

	pcall(
		ResetRemote.InvokeServer,
		ResetRemote
	)

	task.wait(2)

	-- A filtered/rejected candidate must not kill Grow New Slots. Try another
	-- validated unique name inside the SAME creation transaction.
	for attempt = 1, 6 do
		local characterName =
			state.uniqueSlotName()

		if not characterName then
			runtimeMessage =
				"Grow New Slots: no safe unique name available"

			return false
		end

		local entry = {
			CharacterName =
				characterName,
			AnimalName =
				animalName,
			Gender =
				gender,
			Skin =
				skin,
			GrowthPercentage =
				0,
		}

		runtimeMessage =
			string.format(
				"Grow New Slots: creating %s (%s)",
				characterName,
				animalName
			)

		local callOk, remoteResult =
			pcall(
				CreateRemote.InvokeServer,
				CreateRemote,
				entry.CharacterName,
				entry.AnimalName,
				entry.Gender,
				entry.Skin
			)

		-- An explicit false is treated as a server/name rejection.
		if not callOk
			or remoteResult == false then

			state.slotNameReject(
				characterName,
				900
			)

			runtimeMessage =
				string.format(
					"Name %s was rejected; generating another safe name",
					characterName
				)

			task.wait(0.35)
			continue
		end

		-- Do not guess that creation succeeded. Confirm the exact CharacterName in
		-- SavedCharacters before moving on, preventing duplicate/phantom slots.
		local created
		local deadline =
			tick() + 6

		repeat
			task.wait(0.25)

			created =
				state.slotNameFindSaved(
					characterName
				)
		until created
			or tick() >= deadline

		if not created then
			state.slotNameReject(
				characterName,
				900
			)

			runtimeMessage =
				string.format(
					"Name %s was not accepted by the game; trying another",
					characterName
				)

			continue
		end

		-- Keep the reservation alive until SavedCharacters has fully stabilized.
		state.slotNameReserve(
			characterName,
			60
		)

		local spawned =
			spawnSlot(
				created,
				true
			)

		if spawned then
			return true
		end

		-- The slot exists, so NEVER create another name here. A spawn failure is
		-- a separate replication/menu issue and the normal Growth retry handles it.
		runtimeMessage =
			"New slot "
			.. characterName
			.. " exists, but spawning it was not confirmed yet"

		return false
	end

	runtimeMessage =
		"Grow New Slots: all safe-name attempts were rejected; will retry"

	return false
end

function state.prepareGrowthAutomationHandoff(reason)
	if not state.autoGrowModeActive() then
		return false
	end

	-- When Quests already ended, no Quest locomotion/latch from the old pipeline
	-- may survive into a newly-selected Growth mode. This is the exact transition
	-- that previously required a full Roblox restart to make Eat/Drink work again.
	if not state.autoQuests then
		-- Mirror the normal Auto Quests OFF cleanup even when Quests disabled
		-- themselves after completion. Otherwise stale quest intent can survive the
		-- automatic handoff even though the UI toggle is already OFF.
		state.questActionablePending = false
		state.questMovementPriorityPending = false
		state.questMovementPriorityVerified = true
		state.questMovementPriorityLastSnapshotAt = tick()
		state.questZonePriority.active = false
		state.questZonePriority.zone = nil
		state.questZonePriority.resolved = true
		state.questZoneLastMoveAt = 0
		state.questZoneLastTarget = nil
		if state.questClearReturnZone then
			pcall(state.questClearReturnZone)
		end
		questTargetZoneName = nil

		questTravelWanted = false
		state.questTravelActive = false
		state.questLandInputActive = false
		state.questMotionMoving = false
		state.questMotionMode = nil
		state.questSwimActive = false
		state.questSwimReady = false
		state.autoRunMoveOwnsInput = false

		if state.questSetW then
			pcall(state.questSetW, false)
		end

		if state.questSetLandPermanentW then
			pcall(state.questSetLandPermanentW, false)
		end

		if state.safeMove
			and state.safeMove.active
			and state.safeMove.reason == "quest" then

			state.safeMove.cancelToken += 1
			state.safeMove.active = false
			state.safeMove.target = nil
			state.safeMove.reason = nil
			state.safeMove.owner = nil
			state.safeMove.manualLabel = nil
			state.safeMove.landQuestW = false
			state.busy = false
		end

		if state.heavyWalk
			and state.heavyWalk.owner == "autoRun"
			and state.heavyWalkStop then

			pcall(
				state.heavyWalkStop,
				player.Character
			)
		end
	end

	state.enableSurvivalForAutomation(
		reason or "Auto Grow"
	)

	if state.questReleaseStaleRecoveryLock then
		pcall(state.questReleaseStaleRecoveryLock)
	end

	return state.autoEat == true
		or state.autoDrink == true
		or (
			state.aquaticRiverEscape
			and state.aquaticRiverEscape.survivalSuspended
		)
end

function state.rearmSurvivalAfterSlotSpawn(reason)
	if not state.survivalAutomationRequested() then
		return false
	end

	local character = player.Character
	if not character then
		return false
	end

	if state.questSlotsNormalizeControl then
		pcall(
			state.questSlotsNormalizeControl,
			character
		)
	end

	-- Every interaction target/latch below belonged to the outgoing slot.
	-- A freshly spawned slot must start with a clean Survival transaction.
	drinkingToFull = false
	eatingToFull = false
	drinkingSourcePosition = nil
	drinkingStuckSince = nil
	lastDrinkWatchdogWater = nil
	eatingSourcePosition = nil
	eatingTargetReachedAt = nil
	eatingStuckSince = nil
	blockClientSubState = false

	clearActiveCarcass(true)
	BABOON.cancel()
	GIRAFFE.cancel()

	if state.drinkProgressReset then
		state.drinkProgressReset()
	end

	if state.drinkSearch then
		state.drinkSearch.currentWaterPoint = nil
		state.drinkSearch.failedCount = 0
		state.drinkSearch.retryAfter = 0
		state.drinkSearch.surfaceTransitActive = false
		state.drinkSearch.surfaceTransitFoundSpot = nil
	end

	if state.survivalArbiterReset then
		state.survivalArbiterReset(
			(reason or "slot spawn") .. " fresh Survival state"
		)
	end

	local herbRecovery = state.herbivoreFoodRecovery
	if herbRecovery
		and herbRecovery.active
		and herbRecovery.character ~= character
		and state.herbivoreFoodRecoveryFinish then

		pcall(
			state.herbivoreFoodRecoveryFinish,
			herbRecovery.token,
			false,
			"Old-slot herbivore recovery released after spawn"
		)
	end

	local giraffeRecovery =
		GIRAFFE
		and GIRAFFE.exclusiveRecovery

	if giraffeRecovery
		and giraffeRecovery.active
		and giraffeRecovery.character ~= character
		and state.giraffeExclusiveRecoveryFinish then

		pcall(
			state.giraffeExclusiveRecoveryFinish,
			giraffeRecovery.token,
			false,
			"Old-slot Giraffe recovery released after spawn"
		)
	end

	if state.drinkTest
		and state.drinkTest.active
		and state.drinkTest.character ~= character then

		state.drinkTest.cancelRequested = true
	end

	if not state.safeMove.active
		and not carcassEatBusy
		and not CROC.approachBusy
		and not forcingPostDrinkMove
		and not DAMAGE.active
		and not (state.drinkTest and state.drinkTest.active) then

		state.busy = false
	end

	if state.questReleaseStaleRecoveryLock then
		pcall(state.questReleaseStaleRecoveryLock)
	end

	state.enableSurvivalForAutomation(
		reason or "slot spawn"
	)

	local ai = state.MMBAI
	if ai and ai.Enabled == true then
		local registry = ai.ModuleRegistry
		if registry and type(registry.ResetRuntime) == "function" then
			pcall(
				registry.ResetRuntime,
				registry,
				"AutoEat",
				"fresh character/slot"
			)

			pcall(
				registry.ResetRuntime,
				registry,
				"AutoDrink",
				"fresh character/slot"
			)
		end

		local watchdog = ai.WatchdogManager
		if watchdog
			and type(watchdog.ResetModuleProbe) == "function" then

			pcall(
				watchdog.ResetModuleProbe,
				watchdog,
				"AutoEat",
				tick()
			)

			pcall(
				watchdog.ResetModuleProbe,
				watchdog,
				"AutoDrink",
				tick()
			)
		end
	end

	mmbTaskDefer(function()
		task.wait(0.08)

		if player.Character ~= character then
			return
		end

		if state.autoDrink then
			pcall(autoDrinkStep)
		end

		if state.autoEat then
			pcall(autoEatStep)
		end
	end)

	return true
end


state.growthBusy = false
function state.coinFarmRememberCurrentSlot()
	if not state.farmCoins then
		return
	end

	local character =
		player.Character

	local root =
		character
		and character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not character
		or not character.Parent
		or not root then
		return
	end

	local current =
		state.questFindCurrentSavedEntry(
			savedCharacters(),
			character
		)

	if not current then
		return
	end

	state.coinFarmLastSlot = {
		CharacterName =
			current.CharacterName,
		UniqueCharacterName =
			current.UniqueCharacterName,
		AnimalName =
			current.AnimalName,
		Gender =
			current.Gender,
		Skin =
			current.Skin,
	}

	state.coinFarmCharacterMissingSince =
		nil
end

function state.coinFarmFindRememberedSlot(records)
	local remembered =
		state.coinFarmLastSlot

	if type(remembered)
		~= "table" then
		return nil
	end

	records =
		records
		or savedCharacters()

	for _, entry in ipairs(
		records
	) do
		if type(entry)
			== "table" then

			local sameUnique =
				type(
					remembered.UniqueCharacterName
				) == "string"
				and remembered.UniqueCharacterName
					~= ""
				and entry.UniqueCharacterName
					== remembered.UniqueCharacterName

			local sameName =
				type(
					remembered.CharacterName
				) == "string"
				and remembered.CharacterName
					~= ""
				and entry.CharacterName
					== remembered.CharacterName

			if sameUnique
				or sameName then
				return entry
			end
		end
	end

	return nil
end

function state.coinFarmIntentionalCharacterSwitch()
	local coop =
		state.questGroup
		and state.questGroup.coop

	return state.coinFarmSwitching
		or questSwitchingAnimal
		or state.growthBusy
		or state.questGrowthReset.exclusive
		or state.questGrowthReset.busy
		or (
			coop
			and coop.helperSwitching
		)
end

function state.coinFarmMenuRecoveryStep()
	if not state.farmCoins then
		state.coinFarmCharacterMissingSince =
			nil

		state.coinFarmMenuRecovering =
			false

		return
	end

	if state.coinFarmIntentionalCharacterSwitch() then
		state.coinFarmCharacterMissingSince =
			nil
		return
	end

	local character =
		player.Character

	local root =
		character
		and character:FindFirstChild(
			"HumanoidRootPart"
		)

	local humanoid =
		character
		and character:FindFirstChildOfClass(
			"Humanoid"
		)

	local liveCharacter =
		character
		and character.Parent
		and root
		and humanoid
		and humanoid.Health > 0

	if liveCharacter then
		state.coinFarmCharacterMissingSince =
			nil

		state.coinFarmMenuRecovering =
			false

		state.coinFarmRememberCurrentSlot()
		return
	end

	if state.coinFarmMenuRecovering
		or tick()
			< (
				state.coinFarmMenuRetryAt
				or 0
			) then
		return
	end

	state.coinFarmCharacterMissingSince =
		state.coinFarmCharacterMissingSince
		or tick()

	-- Ignore short normal replication gaps. A real menu state has to persist.
	if tick()
		- state.coinFarmCharacterMissingSince
		< 2.75 then
		return
	end

	local records =
		savedCharacters()

	local target =
		state.coinFarmFindRememberedSlot(
			records
		)

	if not target
		and type(
			state.coinFarmPreferredAnimal
		) == "string"
		and state.coinFarmPreferredAnimal
			~= ""
		and state.coinFarmFindPreferredSlot then

		target =
			state.coinFarmFindPreferredSlot(
				records,
				state.coinFarmPreferredAnimal
			)
	end

	if not target then
		state.coinFarmMenuRetryAt =
			tick() + 5

		runtimeMessage =
			"AFK Coin: character missing; previous saved slot not resolved"

		return
	end

	state.coinFarmMenuRecovering =
		true

	state.coinFarmCharacterMissingSince =
		nil

	local targetName =
		tostring(
			target.CharacterName
				or target.UniqueCharacterName
				or target.AnimalName
				or "slot"
		)

	runtimeMessage =
		"AFK Coin: unexpected menu detected; restoring same slot -> "
		.. targetName

	questStatusText =
		"AFK Coin Farm: restoring "
		.. targetName

	task.spawn(function()
		-- We are already on/missing the character. Do NOT call ResetRemote here.
		local spawned =
			spawnSlot(
				target,
				true
			)

		state.coinFarmMenuRecovering =
			false

		if spawned then
			state.coinFarmMenuRetryAt =
				0

			state.coinFarmCharacterMissingSince =
				nil

			state.applySurvivalDefaults(
				false
			)

			state.coinFarmRememberCurrentSlot()

			runtimeMessage =
				"AFK Coin: same slot restored after unexpected menu"

			questStatusText =
				"AFK Coin Farm: slot restored"
		else
			state.coinFarmMenuRetryAt =
				tick() + 5

			runtimeMessage =
				"AFK Coin: menu recovery spawn not confirmed; retrying"
		end

		if renders then
			if renders.autoEat then
				pcall(
					renders.autoEat
				)
			end

			if renders.autoDrink then
				pcall(
					renders.autoDrink
				)
			end
		end
	end)
end

function state.coinFarmUniqueAnimals(records)
	records = records or savedCharacters()

	local byKey = {}
	for _, entry in ipairs(records) do
		if type(entry) == "table"
			and type(entry.AnimalName) == "string"
			and entry.AnimalName ~= "" then

			local key = state.questAnimalKey(entry.AnimalName)
			if key ~= "" and not byKey[key] then
				byKey[key] = entry.AnimalName
			end
		end
	end

	local animals = {}
	for _, animalName in pairs(byKey) do
		animals[#animals + 1] = animalName
	end

	table.sort(animals, function(a, b)
		return a:lower() < b:lower()
	end)

	return animals
end

function state.coinFarmFindPreferredSlot(records, animalName)
	if type(animalName) ~= "string" or animalName == "" then
		return nil
	end

	records = records or savedCharacters()
	local wanted = state.questAnimalKey(animalName)
	local best
	local bestGrowth = -math.huge

	for _, entry in ipairs(records) do
		if type(entry) == "table"
			and type(entry.AnimalName) == "string"
			and state.questAnimalKey(entry.AnimalName) == wanted then

			local growth = tonumber(entry.GrowthPercentage) or 0
			if growth <= 1 then
				growth *= 100
			end

			-- If the user owns many slots of the same animal, use ONE slot only:
			-- prefer the most-grown one because AFK Coin does not need to rotate
			-- through duplicate species.
			if not best
				or growth > bestGrowth
				or (
					growth == bestGrowth
					and tostring(entry.CharacterName or "")
						< tostring(best.CharacterName or "")
				) then

				best = entry
				bestGrowth = growth
			end
		end
	end

	return best
end

function state.coinFarmRenderPreferred()
	if renders and renders.coinFarmAnimal then
		pcall(renders.coinFarmAnimal)
	end
end

function state.coinFarmRequestPreferredSwitch(reason)
	if not state.farmCoins then
		state.coinFarmSwitchPending = false
		state.coinFarmSwitchReason = nil
		return
	end

	local preferred = state.coinFarmPreferredAnimal

	if type(preferred) ~= "string" or preferred == "" then
		state.coinFarmSwitchPending = false
		state.coinFarmSwitchReason = nil

		local character = player.Character
		local currentAnimal = character
			and character:GetAttribute("AnimalName")
			or "current animal"

		questStatusText =
			"AFK Coin Farm: keeping current animal -> "
			.. tostring(currentAnimal)

		runtimeMessage =
			"No AFK Coin animal selected; keeping the animal active when Coin Farm started"
		return
	end

	state.coinFarmSwitchPending = true
	state.coinFarmSwitchReason = reason or "AFK Coin Farm started"
	state.coinFarmRetryAt = 0

	questStatusText =
		"AFK Coin Farm: preferred animal -> "
		.. preferred
end

function state.coinFarmTryPreferredSwitch()
	if state.questGroup
		and state.questGroup.coop
		and (
			state.questGroup.coop.helperActive
			or state.questGroup.coop.helperSwitching
		) then
		return
	end

	if not state.farmCoins
		or not state.coinFarmSwitchPending
		or state.coinFarmSwitching
		or tick() < (state.coinFarmRetryAt or 0) then
		return
	end

	local preferred = state.coinFarmPreferredAnimal
	if type(preferred) ~= "string" or preferred == "" then
		state.coinFarmSwitchPending = false
		return
	end

	local character = player.Character
	local currentAnimal = character
		and character:GetAttribute("AnimalName")

	if type(currentAnimal) == "string"
		and state.questAnimalKey(currentAnimal)
			== state.questAnimalKey(preferred) then

		state.coinFarmSwitchPending = false
		state.coinFarmSwitchReason = nil

		questStatusText =
			"AFK Coin Farm: "
			.. preferred
			.. " selected"

		runtimeMessage =
			"AFK Coin preferred animal already active: "
			.. preferred
		return
	end

	-- Never fight Eat/Drink, damage recovery, Growth reset, a quest switch,
	-- or another movement controller. The preferred species remains pending.
	if state.growthBusy
		or state.busy
		or questSwitchingAnimal
		or criticalRecoveryActive
		or DAMAGE.active
		or state.questGrowthReset.exclusive
		or state.questGrowthReset.busy
		or drinkingToFull
		or eatingToFull
		or carcassEatBusy
		or BABOON.busy
		or GIRAFFE.busy
		or CROC.approachBusy
		or forcingPostDrinkMove then
		return
	end

	local target = state.coinFarmFindPreferredSlot(
		savedCharacters(),
		preferred
	)

	-- The selector only lists existing species, but a slot can be removed after
	-- selection. Fail safely: clear the stale preference and keep current animal.
	if not target then
		state.coinFarmPreferredAnimal = nil
		state.coinFarmSwitchPending = false
		state.coinFarmSwitchReason = nil

		runtimeMessage =
			"Selected AFK Coin animal no longer has a saved slot; keeping current animal"
		questStatusText =
			"AFK Coin Farm: Current animal (saved selection unavailable)"

		state.coinFarmRenderPreferred()
		return
	end

	state.coinFarmSwitching = true
	state.coinFarmSwitchPending = false

	local requestedAnimal = preferred
	local previousAutoEat = state.autoEat
	local previousAutoDrink = state.autoDrink

	-- Prevent survival loops from trying to operate on the disappearing
	-- character during the short Reset -> Spawn transition.
	state.autoEat = false
	state.autoDrink = false
	blockClientSubState = false
	state.questSetW(false)
	DAMAGE.cooldownUntil = math.max(
		DAMAGE.cooldownUntil or 0,
		tick() + 20
	)

	runtimeMessage =
		"AFK Coin Farm: switching to preferred animal "
		.. requestedAnimal

	questStatusText =
		"AFK Coin Farm: switching -> "
		.. requestedAnimal

	task.spawn(function()
		if not state.prepareCurrentSlotForSwitch(
			"AFK Coin: staging current animal before preferred-slot switch"
		) then
			state.coinFarmSwitching = false
			state.coinFarmSwitchPending = true
			state.coinFarmRetryAt = tick() + 3
			state.autoEat = previousAutoEat
			state.autoDrink = previousAutoDrink
			runtimeMessage = "AFK Coin switch postponed: staging failed"
			return
		end

		if ResetRemote then
			if state.slotGuardianMarkPlanned then
				state.slotGuardianMarkPlanned(
					"intentional script reset",
					24
				)
			end
			pcall(ResetRemote.InvokeServer, ResetRemote)
			task.wait(1.35)
		end

		-- Even if Coin Farm/selection changed while the menu was open, always
		-- finish spawning something so the player is never left slotless.
		local spawned = spawnSlot(target, true)

		state.coinFarmSwitching = false

		if state.farmCoins then
			state.applySurvivalDefaults(false)
		else
			state.autoEat = previousAutoEat
			state.autoDrink = previousAutoDrink
		end

		if renders then
			if renders.autoEat then renders.autoEat() end
			if renders.autoDrink then renders.autoDrink() end
		end

		if spawned then
			if state.farmCoins then
				state.coinFarmRememberCurrentSlot()
			end

			if state.farmCoins
				and type(state.coinFarmPreferredAnimal) == "string"
				and state.questAnimalKey(state.coinFarmPreferredAnimal)
					~= state.questAnimalKey(requestedAnimal) then

				-- User changed the dropdown during the switch. Complete this
				-- spawn first, then honor the NEW choice on the next pass.
				state.coinFarmSwitchPending = true
				state.coinFarmRetryAt = tick() + 1
				runtimeMessage =
					"AFK Coin animal selection changed; applying new preference"
			else
				state.coinFarmSwitchPending = false
				questStatusText =
					"AFK Coin Farm: "
					.. requestedAnimal
				runtimeMessage =
					"AFK Coin preferred animal active: "
					.. requestedAnimal
			end
		elseif state.farmCoins then
			state.coinFarmSwitchPending = true
			state.coinFarmRetryAt = tick() + 10
			runtimeMessage =
				"AFK Coin preferred animal spawn was not confirmed; retrying later"
		end
	end)
end


function state.growthPrideReturnStep()
	if state.herbivoreFoodRecovery
		and state.herbivoreFoodRecovery.active
		and state.herbivoreFoodRecovery.character
			== player.Character then

		return
	end

	if GIRAFFE.exclusiveRecovery
		and GIRAFFE.exclusiveRecovery.active
		and isGiraffeCharacter(
			player.Character
		) then

		return
	end

	if state.slotParkingAudit and state.slotParkingAudit.active then return end

	local character, root =
		characterParts()

	if not character or not root then
		return
	end

	if not state.growthPrideRestrictionActive(
		character
	) then
		if state.growthPride.returning
			and state.safeMove
			and state.safeMove.active
			and state.safeMove.reason == "growth_home" then

			state.safeMove.cancelToken += 1
			state.releaseMovementNow(
				character,
				true
			)
		end

		state.growthPride.returning = false
		state.growthPride.returnRequested = false
		return
	end

	if state.growthPrideInside(
		character,
		root
	) then
		state.growthPride.returning = false
		state.growthPride.returnRequested = false
		return
	end

	local water =
		tonumber(
			character:GetAttribute("Water")
		) or 100

	-- ONLY allowed reason to remain outside Pride during Growth: drinking.
	-- Let Auto Drink leave, drink, and complete its dry-bank exit first.
	if (
		state.autoDrink
		and (
			drinkingToFull
			or water <= 75
		)
	)
		or forcingPostDrinkMove
		or criticalRecoveryActive
		or DAMAGE.active
		or state.questGrowthReset.exclusive
		or state.growthBusy
		or questSwitchingAnimal then
		return
	end

	-- A stale Food route is NOT allowed to hold a growing herbivore outside the
	-- Pride home. Cancel only Food movement; water remains the sole exception.
	if state.safeMove
		and state.safeMove.active
		and state.safeMove.reason == "food" then
		state.safeMove.cancelToken += 1
		state.releaseMovementNow(character, true)
	end

	-- Do not fight another movement controller. As soon as it releases, Pride
	-- home wins unless that controller was the water exception above.
	if state.busy
		or state.growthPride.returning
		or tick()
			- (state.growthPride.lastReturnAt or 0)
			< 1.2 then
		return
	end

	state.growthPride.returning = true
	state.growthPride.returnRequested = false
	state.growthPride.lastReturnAt = tick()

	runtimeMessage =
		"Growth herbivore: returning to Pride Rock home"

	task.spawn(function()
		safeMoveToPosition(
			state.growthPride.home,
			10,
			nil,
			{
				purpose = "growth_home",
				forceMoveToLand = true,
				tolerance = 18,
				speedScale = 1,
				maxDuration = 360,
				routeCheckInterval = 0.20,
				routeCheck = function()
					local liveCharacter, liveRoot =
						characterParts()

					if not liveCharacter then
						return true, "growth_home_character_changed"
					end

					local liveGrowth =
						tonumber(liveCharacter:GetAttribute("GrowthPercentage"))

					if state.autoGrowModeActive()
						and liveGrowth
						and isGrowthComplete(liveGrowth) then
						return true, "growth_100_reset"
					end

					if not state.growthPrideRestrictionActive(liveCharacter) then
						return true, "growth_home_released"
					end

					if liveCharacter
						and liveRoot
						and state.growthPrideInside(
							liveCharacter,
							liveRoot
						) then
						return true, "pride_entered"
					end

					return false
				end,
			}
		)

		task.wait(0.15)

		local liveCharacter, liveRoot =
			characterParts()

		state.growthPride.returning = false

		if liveCharacter
			and liveRoot
			and state.growthPrideInside(
				liveCharacter,
				liveRoot
			) then

			runtimeMessage =
				"Growth herbivore: Pride Rock home confirmed"
		else
			state.growthPride.returnRequested = true
		end
	end)
end

task.spawn(function()
	while state.alive do
		pcall(
			state.growthPrideReturnStep
		)
		task.wait(0.55)
	end
end)

state.growthTopUp = state.growthTopUp or {
	active = false,
	startedAt = nil,

	-- Slot-switch survival top-up watchdog.
	mode = nil,
	lastFood = nil,
	lastWater = nil,
	lastProgressAt = 0,
	lastKickAt = 0,
	lastRouteResetAt = 0,
	lastGiraffeRetryAt = 0,

	timeout = 90,
	maxSlots = 40,
}


function state.growthTopUpResetWatch()
	local topUp = state.growthTopUp
	if not topUp then
		return
	end

	topUp.mode = nil
	topUp.lastFood = nil
	topUp.lastWater = nil
	topUp.lastProgressAt = 0
	topUp.lastKickAt = 0
	topUp.lastRouteResetAt = 0
	topUp.lastGiraffeRetryAt = 0
end

function state.growthTopUpReleaseCompletedGrowthMovement(character)
	if not character then
		return
	end

	-- Growth 100 means growth_home has no authority anymore.
	state.growthPride.returnRequested = false
	state.growthPride.returning = false

	if state.safeMove
		and state.safeMove.active
		and (
			state.safeMove.reason == "growth_home"
				or state.safeMove.reason == "quest"
		) then

		state.safeMove.cancelToken += 1
		state.safeMove.active = false
		state.safeMove.target = nil
		state.safeMove.reason = nil
		state.safeMove.manualLabel = nil
		state.busy = false

		state.releaseMovementNow(
			character,
			true
		)
	end

	if state.heavyWalk
		and state.heavyWalk.owner == "autoRun"
		and state.heavyWalkStop then

		pcall(
			state.heavyWalkStop,
			character
		)
	end

	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil

	if state.questSetW then
		pcall(
			state.questSetW,
			false
		)
	end

	if state.questSetLandPermanentW then
		pcall(
			state.questSetLandPermanentW,
			false
		)
	end
end

function state.growthTopUpForceFood(
	character,
	food,
	water,
	target
)
	if GIRAFFE.exclusiveRecovery
		and GIRAFFE.exclusiveRecovery.active
		and isGiraffeCharacter(character) then

		return false
	end

	if not character
		or not state.autoGrowModeActive() then
		return false
	end

	local topUp = state.growthTopUp
	local now = tick()

	topUp.active = true
	topUp.mode = "food"
	topUp.startedAt = topUp.startedAt or now

	food = tonumber(food) or 100
	water = tonumber(water) or 100
	target = tonumber(target) or 61

	preSwitchFoodTarget = target
	preSwitchWaterTarget = nil

	-- A Grow automation cannot wait for a disabled Auto Eat while slot switching
	-- is impossible. This does not create a second food implementation; it simply
	-- arms the existing Auto Eat controller for the required safety transaction.
	state.autoEat = true

	state.growthTopUpReleaseCompletedGrowthMovement(
		character
	)

	-- Food owns slot-switch top-up unless Water is genuinely critical.
	-- Normal Water <=75 must not keep Giraffe blocked at Food 43%.
	if state.survivalArbiter
		and state.survivalArbiter.owner == "water"
		and water > 45 then

		state.survivalArbiterComplete(
			"water"
		)

		drinkingToFull = false
		drinkingSourcePosition = nil
		drinkingStuckSince = nil

		if state.safeMove
			and state.safeMove.active
			and state.safeMove.reason == "water" then

			state.safeMove.cancelToken += 1
			state.safeMove.active = false
			state.safeMove.target = nil
			state.safeMove.reason = nil
			state.busy = false

			state.releaseMovementNow(
				character,
				true
			)
		end
	end

	-- If Water is critical, let Drink save the slot first. Growth will return to
	-- Food top-up immediately afterwards.
	if water <= 45
		and state.autoDrink then

		drinkingToFull = true
		return false
	end

	drinkingToFull = false

	if state.survivalArbiter
		and state.survivalArbiter.owner ~= "food" then

		-- Complete a stale non-critical owner, then explicitly acquire Food.
		if state.survivalArbiter.owner then
			state.survivalArbiterComplete(
				state.survivalArbiter.owner
			)
		end

		state.survivalArbiter.handoffNotBefore = 0
	end

	if state.survivalArbiterAcquire then
		state.survivalArbiterAcquire(
			"food",
			food,
			water,
			"Slot switch safety top-up"
		)
	end

	if topUp.lastFood == nil
		or food > topUp.lastFood + 0.01 then

		topUp.lastFood = food
		topUp.lastProgressAt = now
		topUp.lastRouteResetAt = 0
	else
		topUp.lastProgressAt =
			topUp.lastProgressAt > 0
				and topUp.lastProgressAt
				or now
	end

	local noProgress =
		now - topUp.lastProgressAt

	local giraffe =
		isGiraffeCharacter(
			character
		)

	-- Giraffe-specific self-heal:
	-- if a tree worker/food route exists but Food has not moved for long enough,
	-- release that one attempt and let the normal Giraffe selector choose another
	-- reachable tree. This prevents a dead tree/old target from blocking the slot.
	if giraffe
		and noProgress >= 9
		and now - (topUp.lastGiraffeRetryAt or 0) >= 5 then

		topUp.lastGiraffeRetryAt = now

		if GIRAFFE.busy
			or GIRAFFE.targetTree then

			GIRAFFE.cancel()
		end

		if state.safeMove
			and state.safeMove.active
			and state.safeMove.reason == "food" then

			state.safeMove.cancelToken += 1
			state.safeMove.active = false
			state.safeMove.target = nil
			state.safeMove.reason = nil
			state.busy = false
			state.releaseMovementNow(
				character,
				true
			)
		end

		-- After an extended top-up stall, expire temporary tree blacklists once.
		-- The reach solver will still reject genuinely impossible leaves.
		if noProgress >= 16 then
			for tree in pairs(
				GIRAFFE.failedTrees
			) do
				GIRAFFE.failedTrees[tree] = nil
			end
		end
	end

	-- Generic dead food route recovery.
	if noProgress >= 10
		and state.safeMove
		and state.safeMove.active
		and state.safeMove.reason == "food"
		and now - (topUp.lastRouteResetAt or 0) >= 6 then

		topUp.lastRouteResetAt = now

		state.safeMove.cancelToken += 1
		state.safeMove.active = false
		state.safeMove.target = nil
		state.safeMove.reason = nil
		state.busy = false

		state.releaseMovementNow(
			character,
			true
		)
	end

	-- Kick the authoritative Auto Eat controller immediately instead of waiting
	-- for the next one-second scheduler pass.
	if not state.busy
		and not GIRAFFE.busy
		and not BABOON.busy
		and not carcassEatBusy
		and now - (topUp.lastKickAt or 0) >= 0.65 then

		topUp.lastKickAt = now

		mmbTaskDefer(function()
			task.wait(0.03)

			local liveCharacter =
				player.Character

			if liveCharacter == character
				and state.autoGrowModeActive()
				and preSwitchFoodTarget ~= nil
				and (
					tonumber(
						liveCharacter:GetAttribute(
							"Food"
						)
					) or 100
				) < preSwitchFoodTarget then

				pcall(
					autoEatStep
				)
			end
		end)
	end

	return true
end

function state.growthTopUpForceWater(
	character,
	food,
	water,
	target
)
	if GIRAFFE.exclusiveRecovery
		and GIRAFFE.exclusiveRecovery.active
		and isGiraffeCharacter(character) then

		return false
	end

	if not character
		or not state.autoGrowModeActive() then
		return false
	end

	local topUp = state.growthTopUp
	local now = tick()

	topUp.active = true
	topUp.mode = "water"
	topUp.startedAt = topUp.startedAt or now

	preSwitchFoodTarget = nil
	preSwitchWaterTarget = target

	state.autoDrink = true

	state.growthTopUpReleaseCompletedGrowthMovement(
		character
	)

	eatingToFull = false
	GIRAFFE.cancel()
	BABOON.cancel()

	if state.survivalArbiter
		and state.survivalArbiter.owner == "food" then

		state.survivalArbiterComplete(
			"food"
