ai:RegisterModule("GrowSlots", {
	owner = "Growth",
	priority = 62,
	dependencies = { "Character", "AutoEat", "AutoDrink", "Slots" },
	conflicts = { "Safety" },
	enabled = function()
		return state.growthModeActive() and ai.Capabilities.Current.growth == true
	end,
	expectedProgress = function(context)
		return context.characterAlive
			and context.growth < 99.999
			and context.food > 60
			and context.water > 60
			and not state.questSlots.busy
			and not questSwitchingAnimal
			and "GrowthPercentage"
			or false
	end,
	currentProgress = function(context) return context.growth end,
	healthCheck = function(context, runtime)
		if not context.characterAlive then
			return { healthy = true, waiting = true, reason = "slot/respawn transition" }
		end
		if context.food <= 60 and not state.autoEat then
			return { healthy = false, reason = "Growth is hungry but Auto Eat is OFF" }
		end
		if context.water <= 60 and not state.autoDrink then
			return { healthy = false, reason = "Growth is thirsty but Auto Drink is OFF" }
		end
		if context.food <= 60 or context.water <= 60 then
			return { healthy = true, waiting = true, reason = "waiting for survival" }
		end
		if state.questSlots.busy or questSwitchingAnimal or state.slotParkingAudit.active then
			return { healthy = true, waiting = true, reason = "verified slot transaction" }
		end
		local expected = state.questExpectedSlot
		if type(expected) == "table"
			and expected.characterName
			and tostring(context.slot) ~= tostring(expected.characterName) then
			return { healthy = true, waiting = true, reason = "waiting for expected Growth slot" }
		end
		local lease = ai.MovementManager.lease
		if lease and lease.owner ~= "Growth" then
			if ai.MovementManager:IsOwnerEnabled(lease.owner, context) then
				return { healthy = true, waiting = true, reason = "Growth suspended by " .. lease.owner }
			end
			return { healthy = false, reason = "Growth blocked by disabled movement owner" }
		end
		if isSavannahLife and state.growthPrideRestrictionActive(context.character)
			and not state.autoQuests and typeof(context.position) == "Vector3" then
			local distance = Vector3.new(
				context.position.X - state.growthPride.home.X,
				0,
				context.position.Z - state.growthPride.home.Z
			).Magnitude
			if distance > state.growthPride.radius
				and not context.goingToFood and not context.goingToWater
				and not (state.safeMove.active and state.safeMove.reason == "growth_home") then
				return { healthy = false, reason = "Growth outside home without a Growth route" }
			end
		end
		return { healthy = true }
	end,
	dynamicTimeout = function(context)
		local footprint = math.clamp(state.movementFootprint(context.character), 2, 32)
		local base = 75 + footprint * 2.5
		if (tonumber(context.growthRate) or 0) > 0 then base += 80 end
		if ai.MovementManager.lease and ai.MovementManager.lease.owner ~= "Growth" then
			base += 45
		end
		return math.clamp(base, 80, 260)
	end,
	recover = function(level, reason, context)
		if context.food <= 60 or context.water <= 60 then
			return "survival must progress first"
		elseif level == 1 then
			return "Growth vitals, slot and character revalidated"
		elseif level == 2 then
			ai:RequestWorker("GrowSlots", reason)
			return "Growth worker requested"
		elseif level == 3 then
			state.growthPride.returnRequested = false
			state.growthPride.returning = false
			ai:RequestWorker("GrowSlots", reason, 0.2)
			return "Growth destination recalculated"
		elseif level == 4 then
			cancelSafePurpose("growth_home", "slot_switch", "spawn")
			ai:RequestWorker("GrowSlots", reason, 0.3)
			return "Growth controller locally rebuilt"
		elseif level == 5 then
			local choice = context.water < context.food and "AutoDrink" or "AutoEat"
			ai:RequestWorker(choice, "Growth yielded to survival")
			return "Growth yielded temporarily to survival"
		elseif level == 6 then
			if not state.safeMove.active
				and not state.questSlots.busy
				and not questSwitchingAnimal then
				state.growthBusy = false
			end
			ai:RequestWorker("GrowSlots", reason, 0.2)
			return "Growth substate released without changing slot"
		elseif level == 7 then
			ai:RequestWorker("GrowSlots", "Growth pipeline rebuild", 0.2)
			return "Growth pipeline queued"
		end
		if context.growth >= 99.999 then
			ai:RequestWorker("Slots", "verified 100% Growth slot handoff")
		elseif isSavannahLife and state.growthPrideRestrictionActive(context.character) then
			state.growthPride.returnRequested = true
		end
		ai:RequestWorker("GrowSlots", "game-specific Growth fallback", 0.2)
		return "safe game adapter fallback queued"
	end,
	resume = function()
		if state.growthModeActive() then ai:RequestWorker("GrowSlots", "resume Growth") end
	end,
})

ai:RegisterModule("AutoQuests", {
