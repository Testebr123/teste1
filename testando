function state.adjustMovementAcceleration(character, value)
	value = tonumber(value)

	if not value or value <= 0 then
		return nil
	end

	-- Flying animals advertise their flight ceiling, and Crocodile advertises
	-- its fast underwater/swimming ceiling. Neither value is a valid land speed.
	-- For movement automation, both are capped to 50% of live Acceleration.
	if state.isFlyingMovementCharacter(character)
		or CROC.isCharacter(character) then

		return value * 0.50
	end

	return value
end

function state.movementGrowthRatio(character)
	if not character then return 1 end

	local growth =
		tonumber(
			character:GetAttribute(
				"GrowthPercentage"
			)
		)

	if growth == nil then
		return 1
	end

	if growth > 1 then
		growth /= 100
	end

	return math.clamp(growth, 0, 1)
end

function state.rawMovementAcceleration(character)
	character = character or player.Character

	local candidates = {}

	local function add(value)
		value = tonumber(value)
		if value and value > 0 then
			table.insert(candidates, value)
		end
	end

	if character then
		add(
			character:GetAttribute(
				"Acceleration"
			)
		)
	end

	local model =
		workspace:FindFirstChild(
			player.Name
		)

	if model and model ~= character then
		add(
			model:GetAttribute(
				"Acceleration"
			)
		)
	end

	if #candidates == 0 then
		return nil
	end

	-- After a slot reset one replication source can briefly keep the adult
	-- Acceleration. The lower live value is always the safer current ceiling.
	local acceleration = candidates[1]
	for index = 2, #candidates do
		acceleration =
			math.min(
				acceleration,
				candidates[index]
			)
	end

	return state.adjustMovementAcceleration(
		character,
		acceleration
	)
end

function state.dynamicMovementSpeed(character, mode)
	character = character or player.Character

	local acceleration =
		state.rawMovementAcceleration(
			character
		)

	local growth =
		state.movementGrowthRatio(
			character
		)

	local growthScale =
		0.30 + 0.70 * growth

	local modeScale =
		mode == "Swimming"
			and 0.82
			or 1.00

	if acceleration
		and acceleration > 0 then

		-- Acceleration is treated as a ceiling, never copied directly to speed.
		-- This is recalculated continuously, so a baby speeds up as it grows.
		local target =
			acceleration
			* growthScale
			* modeScale
			* 0.90

		return math.min(
			target,
			acceleration * 0.92
		),
			acceleration,
			growth
	end

	-- Conservative fallback while the new slot's attributes replicate.
	local humanoid =
		character
		and character:FindFirstChildOfClass(
			"Humanoid"
		)

	local fallback =
		humanoid
		and tonumber(humanoid.WalkSpeed)
		or (
			state.isFlyingMovementCharacter(character)
				and 12
				or 16
		)

	fallback = math.max(1, fallback)

	return fallback
		* growthScale
		* modeScale
		* 0.90,
		0,
		growth
end

function state.safeMovementSpeed(character)
	local speed =
		state.dynamicMovementSpeed(
			character,
			"Land"
		)

	return math.max(1, speed)
end

function state.safeNudgeToward(root, targetPosition, speedScale)
	if not root or typeof(targetPosition) ~= "Vector3" then return false end

	local character = player.Character

	if state.isHeavyGroundMover(character) then
		local humanoid =
			character
			and character:FindFirstChildOfClass("Humanoid")

		local flatMove =
			Vector3.new(
				targetPosition.X - root.Position.X,
				0,
				targetPosition.Z - root.Position.Z
			)

		if flatMove.Magnitude <= 0.15 then
			return true
		end

		if humanoid then
			local requestedSpeed =
				state.safeMovementSpeed(character)
				* math.clamp(
					tonumber(speedScale) or 0.35,
					0.05,
					1
				)

			local moved =
				state.heavyWalkStep(
					character,
					root,
					humanoid,
					flatMove.Unit,
					requestedSpeed,
					flatMove.Magnitude,
					targetPosition,
					"nudge",
					nil
				)

			if moved then
				setSubState("Walking")
				return true
			end
		end
	end

	local flat = Vector3.new(
		targetPosition.X - root.Position.X,
		0,
		targetPosition.Z - root.Position.Z
	)

	if flat.Magnitude <= 0.15 then return true end

	local maximum =
		state.safeMovementSpeed(player.Character)
		* math.clamp(tonumber(speedScale) or 0.35, 0.05, 1)

	local speed = math.min(
		maximum,
		math.max(3, flat.Magnitude * 1.6)
	)

	local velocity = root.AssemblyLinearVelocity
	local direction = flat.Unit

	root.AssemblyLinearVelocity = Vector3.new(
		direction.X * speed,
		velocity.Y,
		direction.Z * speed
	)

	return true
end

