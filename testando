		local _, food, water = self:Vitals(context)
		local physicalHazard = context.inVoid
			or context.buried
			or context.dinoRockTrapped
			or context.dinoShorelineFoodDeadlock
			or (context.dangerousWater and not context.intentionalWaterTransit)
			or (tonumber(context.healthRate) or 0) < -0.8
		if not physicalHazard and food > 45 and water > 45 then
			-- Intentional post-damage protection/heal window: stable waiting is valid.
			progressed = true
		end
	end

