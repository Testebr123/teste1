-- ============================================================
-- Virtual in-game Jump (Space)
-- Use the game's normal input path first. Direct Humanoid.Jump is only a
-- fallback when VirtualInputManager itself is unavailable/fails.
-- ============================================================
local lastVirtualJumpAt = 0

function state.virtualJump(character, humanoid, reason, cooldown)
	if state.drinkPromptHoldActive
		and state.drinkPromptHoldActive()
		and state.drinkVisualPromptVisible
		and state.drinkVisualPromptVisible() then
		return false
	end

	if not character or not humanoid or humanoid.Health <= 0 then
		return false
	end

	cooldown = tonumber(cooldown) or 0.85
	if tick() - lastVirtualJumpAt < cooldown then
		return false
	end

	local currentState = humanoid:GetState()
	if currentState == Enum.HumanoidStateType.Swimming
		or currentState == Enum.HumanoidStateType.Jumping
		or currentState == Enum.HumanoidStateType.Freefall then
		return false
	end

	-- If FloorMaterial exists and reports Air, don't spam Space in midair.
	if humanoid.FloorMaterial == Enum.Material.Air then
		return false
	end

	lastVirtualJumpAt = tick()

	local ok = pcall(function()
		local vim = game:GetService("VirtualInputManager")

		vim:SendKeyEvent(
			true,
			Enum.KeyCode.Space,
			false,
			game
		)
		task.wait(0.055)
		vim:SendKeyEvent(
			false,
			Enum.KeyCode.Space,
			false,
			game
		)
	end)

	if not ok then
		-- Compatibility fallback only if the virtual key path failed.
		pcall(function()
			humanoid.Jump = true
		end)
	end

	return true
end

-- ============================================================
-- MOVEMENT-ONLY NAVIGATION
-- Position moving is no longer used. Every automatic relocation is
-- physical movement capped by the character's live Acceleration attribute.
-- ============================================================
local MOVE_TOLERANCE = 14
local lastSafeMoveAt = 0

function state.safeMovementAnimalKey(character)
	local animal =
		character
		and character:GetAttribute("AnimalName")

	if type(animal) ~= "string" then
		return ""
	end

	return animal:lower():gsub("[^%w]", "")
end

function state.isCrocOrHippoMovementCharacter(character)
	if not character then return false end

	local key =
		state.safeMovementAnimalKey(character)

	return key == "hippo"
		or key:find("croc", 1, true) ~= nil
end

function state.movementBodySize(character)
	if not character then
		return Vector3.new(4, 4, 4)
	end

	local ok, size = pcall(character.GetExtentsSize, character)
	if ok and typeof(size) == "Vector3" then
		return size
	end
	return Vector3.new(4, 4, 4)
end

function state.movementFootprint(character)
	local size = state.movementBodySize(character)
	return math.max(size.X, size.Z)
end

function state.isHeavyGroundMover(character)
	if not character or state.isFlyingMovementCharacter(character) then
		return false
	end

	local key = state.safeMovementAnimalKey(character)
	local namedHeavy =
		key == "elephant"
		or key == "giraffe"
		or key == "hippo"
		or key == "lion"
		or key == "tiger"
		or key == "buffalo"
		or key == "wildebeest"
		or key:find("rhino", 1, true) ~= nil
		or key:find("croc", 1, true) ~= nil

	if namedHeavy then return true end
	local size = state.movementBodySize(character)
	return math.max(size.X, size.Z) >= 7.25 or size.Y >= 7.75
end

function state.movementProbeHeight(character)
	if not state.isHeavyGroundMover(character) then return 2.5 end
	local size = state.movementBodySize(character)
	return math.clamp(size.Y * 0.42, 3.8, 8.5)
end

function state.heavyObstacleProbe(
	character,
	root,
	direction,
	probeDistance
)
	if not character or not root or typeof(direction) ~= "Vector3" or direction.Magnitude <= 0.05 then return nil end
	local forward = Vector3.new(direction.X,0,direction.Z)
	if forward.Magnitude <= 0.05 then return nil end
	forward = forward.Unit
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignored = {character,workspace.Terrain}
	params.FilterDescendantsInstances = ignored
	params.IgnoreWater = true
	pcall(function()
		params.RespectCanCollide = true
	end)

	local function castBlocking(origin, ray)
		for _ = 1, 10 do
			params.FilterDescendantsInstances = ignored
			local hit = workspace:Raycast(origin, ray, params)
			if not hit then return nil end
			local instance = hit.Instance
			if instance
				and instance:IsA("BasePart")
				and instance.CanCollide == false then
				table.insert(ignored, instance)
			else
				return hit
			end
		end
		return nil
	end

	local right = Vector3.new(-forward.Z,0,forward.X)
	local halfWidth = math.clamp(state.movementFootprint(character)*0.42,2.6,8.5)
	local verticalSpread = math.clamp(state.movementBodySize(character).Y*0.20,1.4,4.5)
	local baseOrigin = root.Position + Vector3.new(0,math.clamp(state.movementProbeHeight(character)*0.55,1.5,4.5),0)
	local nearest
	-- 3 body-width lanes x 3 vertical layers = 9 rays.
	for _, lateral in ipairs({-halfWidth,0,halfWidth}) do
		for _, vertical in ipairs({-verticalSpread,0,verticalSpread}) do
			local hit = castBlocking(baseOrigin+right*lateral+Vector3.new(0,vertical,0),forward*probeDistance)
			if hit and (not nearest or hit.Distance<nearest.Distance) then nearest=hit end
		end
	end
	if not nearest then state.safeMove.heavyObstacleSign=nil; return nil end
	local function corridorClearance(sign)
		local a=math.rad(68*sign); local c,s=math.cos(a),math.sin(a)
		local side=Vector3.new(forward.X*c-forward.Z*s,0,forward.X*s+forward.Z*c).Unit
		local length=probeDistance*1.35; local nearestSide=length
		for _, lateral in ipairs({-halfWidth*0.72,0,halfWidth*0.72}) do
			local hit=castBlocking(baseOrigin+right*lateral,side*length)
			if hit then nearestSide=math.min(nearestSide,hit.Distance) end
		end
		return nearestSide
	end
	local leftClear,rightClear=corridorClearance(-1),corridorClearance(1)
	state.safeMove.heavyObstacleSign=leftClear>=rightClear and -1 or 1
	return nearest
end

function state.movementRootClearance(character)
	if not character then return 3 end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return 3 end
	local lowest = math.huge
	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("BasePart") then
			lowest = math.min(lowest, object.Position.Y - object.Size.Y * 0.5)
		end
	end
	if lowest == math.huge then return 3 end
	return math.clamp(root.Position.Y - lowest, 2.2, 10)
end

function state.aquaticWaterStandOffset(character)
	local clearance = state.movementRootClearance(character)
	local key = state.safeMovementAnimalKey(character)
	if key == "hippo" then
		return math.clamp(clearance + 0.35, 2.8, 7.5)
	end
	return math.clamp(clearance + 0.20, 2.5, 8)
end

function state.heavyWalkStop(character)
	local walk = state.heavyWalk
	if not walk then return end

	if walk.walkSpeedConnection then
		pcall(
			walk.walkSpeedConnection.Disconnect,
			walk.walkSpeedConnection
		)
		walk.walkSpeedConnection = nil
	end

	local activeCharacter =
		character or walk.character

	local humanoid =
		activeCharacter
			and activeCharacter:FindFirstChildOfClass("Humanoid")
			or walk.humanoid

	local root =
		activeCharacter
			and activeCharacter:FindFirstChild("HumanoidRootPart")
			or walk.root

	if humanoid then
		if root then
			pcall(
				humanoid.MoveTo,
				humanoid,
				root.Position
			)
		end

		pcall(
			humanoid.Move,
			humanoid,
			Vector3.zero,
			false
		)

		pcall(function()
			if walk.originalWalkSpeed then
				humanoid.WalkSpeed =
					walk.originalWalkSpeed
			end

			if walk.originalHipHeight ~= nil then
				humanoid.HipHeight =
					walk.originalHipHeight
			end

			humanoid.PlatformStand =
				walk.platformStand == true

			humanoid.AutoRotate =
				walk.autoRotate ~= false
		end)
	end

	if activeCharacter
		and activeCharacter.Parent then
		activeCharacter:SetAttribute(
			"MovementDisabled",
			walk.movementDisabled == true
		)
	end

	walk.character = nil
	walk.humanoid = nil
	walk.root = nil
	walk.originalWalkSpeed = nil
	walk.originalHipHeight = nil
	walk.targetWalkSpeed = nil
	walk.movementDisabled = nil
	walk.autoRotate = nil
	walk.platformStand = nil
	walk.owner = nil
	walk.ownerToken = nil
	walk.lastInstructionAt = 0
	walk.lastMoveToAt = 0
	walk.lastMoveToPoint = nil
	walk.lastHeading = nil
end

function state.heavyWalkPrepare(
	character,
	humanoid,
	root,
	targetWalkSpeed,
	owner,
	ownerToken
)
	if not character
		or not humanoid
		or not root
		or (
			owner ~= "autoRun"
				and owner ~= "manual"
				and owner ~= "safeMove"
				and not state.isHeavyGroundMover(
					character
				)
		) then

		return false
	end

	local walk = state.heavyWalk

	owner =
		type(owner) == "string"
			and owner
			or "unknown"

	local ownerChanged =
		walk.character == character
			and walk.owner ~= nil
			and (
				walk.owner ~= owner
				or (
					ownerToken ~= nil
						and walk.ownerToken ~= ownerToken
				)
			)

	if ownerChanged then
		state.heavyWalkStop(
			walk.character
		)
		walk = state.heavyWalk
	end

	if walk.character
		and walk.character ~= character then
		state.heavyWalkStop(
			walk.character
		)
		walk = state.heavyWalk
	end

	local newCharacter =
		walk.character ~= character
			or walk.humanoid ~= humanoid

	if newCharacter then
		if walk.walkSpeedConnection then
			pcall(
				walk.walkSpeedConnection.Disconnect,
				walk.walkSpeedConnection
			)
			walk.walkSpeedConnection = nil
		end

		walk.character = character
		walk.humanoid = humanoid
		walk.root = root

		walk.originalWalkSpeed =
			humanoid.WalkSpeed

		walk.originalHipHeight =
			humanoid.HipHeight

		walk.movementDisabled =
			character:GetAttribute(
				"MovementDisabled"
			)

		walk.autoRotate =
			humanoid.AutoRotate

		walk.platformStand =
			humanoid.PlatformStand

		walk.lastMoveToAt = 0
		walk.lastMoveToPoint = nil
		walk.lastHeading = nil

		-- Same principle as IY loopspeed:
		-- if the game changes WalkSpeed, restore the requested value.
		walk.walkSpeedConnection =
			humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
				if not state.alive
					or state.heavyWalk.character ~= character
					or state.heavyWalk.humanoid ~= humanoid then
					return
				end

				local wanted =
					tonumber(
						state.heavyWalk.targetWalkSpeed
					)

				if wanted
					and wanted > 0
					and math.abs(
						humanoid.WalkSpeed - wanted
					) > 0.05 then

					pcall(function()
						humanoid.WalkSpeed = wanted
					end)
				end
			end)
	end

	walk.owner = owner
	walk.ownerToken = ownerToken
	walk.lastInstructionAt = tick()

	walk.targetWalkSpeed =
		math.max(
			1,
			tonumber(targetWalkSpeed)
				or state.safeMovementSpeed(character)
		)

	pcall(function()
		humanoid.PlatformStand = false

		local worldSteeringOwner =
			owner == "autoRun"
				or owner == "manual"
				or owner == "safeMove"
				or owner == "nudge"

		humanoid.AutoRotate =
			not worldSteeringOwner

		if math.abs(
			humanoid.WalkSpeed
				- walk.targetWalkSpeed
		) > 0.05 then
			humanoid.WalkSpeed =
				walk.targetWalkSpeed
		end

		-- Crocodile's long, low body catches on terrain seams and steep beach
		-- transitions. Give it only a tiny temporary ground clearance while the
		-- automation is walking on land; restore the exact original HipHeight
		-- in heavyWalkStop().
		if walk.originalHipHeight ~= nil then
			local wantedHipHeight =
				walk.originalHipHeight
				+ (
					CROC.isCharacter(character)
						and 0.28
						or 0
				)

			if math.abs(
				humanoid.HipHeight
					- wantedHipHeight
			) > 0.03 then
				humanoid.HipHeight =
					wantedHipHeight
			end
		end
	end)

	character:SetAttribute(
		"MovementDisabled",
		false
	)

	return true
end

function state.moveToWorldSteer(
	character,
	root,
	direction
)
	if not character
		or not root
		or typeof(direction) ~= "Vector3" then
		return false
	end

	local flat =
		Vector3.new(
			direction.X,
			0,
			direction.Z
		)

	if flat.Magnitude <= 0.05 then
		return false
	end

	local heading =
		flat.Unit

	-- WORLD-SPACE steering only. Position is preserved exactly.
	pcall(function()
		root.CFrame =
			CFrame.lookAt(
				root.Position,
				root.Position + heading,
				Vector3.yAxis
			)
	end)

	root.AssemblyAngularVelocity =
		Vector3.zero

	return true
end

function state.heavyWalkStep(
	character,
	root,
	humanoid,
	direction,
	walkSpeed,
	remainingDistance,
	finalTarget,
	owner,
	ownerToken
)
	if not character
		or not root
		or not humanoid
		or typeof(direction) ~= "Vector3" then
		return false
	end

	local flat =
		Vector3.new(
			direction.X,
			0,
			direction.Z
		)

	if flat.Magnitude <= 0.05 then
		return true
	end

	if not state.heavyWalkPrepare(
		character,
		humanoid,
		root,
		walkSpeed,
		owner,
		ownerToken
	) then
		return false
	end

	-- v117: exact smooth v115 steering cadence.
	-- Route/avoidance already selected the heading; never dilute it here.
	local heading = flat.Unit
	local remaining =
		tonumber(remainingDistance)

	local leadDistance =
		remaining
			and math.clamp(
				remaining,
				2.5,
				18
			)
			or 18

	local movePoint

	if owner == "autoRun"
		and typeof(finalTarget) == "Vector3" then

		-- v121: AutoRun's circle/bypass point is already a FIXED world-space
		-- target. Send that exact point to Humanoid:MoveTo instead of converting
		-- it back into another moving point in front of the animal.
		movePoint =
			Vector3.new(
				finalTarget.X,
				root.Position.Y,
				finalTarget.Z
			)

	elseif typeof(finalTarget) == "Vector3"
		and remaining
		and remaining <= 18 then

		movePoint =
			Vector3.new(
				finalTarget.X,
				root.Position.Y,
				finalTarget.Z
			)
	else
		movePoint =
			root.Position
				+ heading * leadDistance
	end

	local steerDelta =
		Vector3.new(
			movePoint.X - root.Position.X,
			0,
			movePoint.Z - root.Position.Z
		)

	if steerDelta.Magnitude > 0.05 then
		state.moveToWorldSteer(
			character,
			root,
			steerDelta
		)
	else
		state.moveToWorldSteer(
			character,
			root,
			heading
		)
	end

	local walk =
		state.heavyWalk

	walk.lastInstructionAt =
		tick()

	local pointChanged =
		not walk.lastMoveToPoint
			or (
				walk.lastMoveToPoint
					- movePoint
			).Magnitude >= 1.25

	if pointChanged
		or tick()
			- (
				walk.lastMoveToAt or 0
			) >= 0.10 then

		walk.lastMoveToAt =
			tick()

		walk.lastMoveToPoint =
			movePoint

		pcall(
			humanoid.MoveTo,
			humanoid,
			movePoint
		)
	end

	return true
end

function state.releaseMovementNow(character, zeroHorizontal)
	if state.heavyWalk
		and state.heavyWalk.character then

		pcall(
			state.heavyWalkStop,
			character
				or state.heavyWalk.character
		)
	end

	pcall(function()
		local env = (getgenv and getgenv()) or _G
		local release = env and env.keyrelease
		if type(release) == "function" then release(0x57) end
	end)
	pcall(function()
		game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.W, false, game)
	end)
	state.questLandKeyDown = false
	state.questLandLastPulseAt = 0
	state.questLandLastRefreshAt = 0
	state.questLandRefreshingW = false
	character = character or player.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if humanoid then
		pcall(humanoid.Move, humanoid, Vector3.zero, false)
		pcall(function()
			humanoid.PlatformStand = false
			humanoid.AutoRotate = true
		end)
	end
	if root and zeroHorizontal ~= false then
		local velocity = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
		root.AssemblyAngularVelocity = Vector3.zero
	end
end

