function state.slotSwitchTarget()
	-- Same staging point used by Grow Slots.
	local spawnName =
		isDinoLife
			and "NestRock3"
			or "PrideRockSpawn1"

	local spawns =
		workspace:FindFirstChild("Spawns")

	local namedSpawn =
