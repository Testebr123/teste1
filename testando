			state.questMotionMode = swimMove and "Swimming" or "Land"

			local wantsLandW = landMove and state.questLandInputActive
			state.questSetW(wantsLandW)

			if trackedCharacter ~= character
				or not center
				or wasSwimming ~= swimMove
				or (not swimMove and (root.Position - center).Magnitude > 80) then

				trackedCharacter = character
				wasSwimming = swimMove
				center = swimMove and state.questSwimPosition or root.Position
				angle = 0
			end

			if tick() - (state.questLastSubStateAt or 0) >= (swimMove and 0.35 or 0.75) then
				state.questLastSubStateAt = tick()
				blockClientSubState = false
				setSubState(swimMove and "Swimming" or (state.questMoveSubState or "Running"))
				blockClientSubState = false
			end

			local speed = getQuestMoveSpeed(character)
			local moveRadius = swimMove and 22 or radius
			angle += (speed / moveRadius) * 0.05

			local target = Vector3.new(
				center.X + math.cos(angle) * moveRadius,
				root.Position.Y,
				center.Z + math.sin(angle) * moveRadius
			)

			local flat = Vector3.new(
				target.X - root.Position.X,
				0,
				target.Z - root.Position.Z
			)

			if flat.Magnitude > 0.1 then
				local direction = flat.Unit
				local velocity = root.AssemblyLinearVelocity

				-- Land Distance needs genuine movement input, not only HRP velocity.
				-- Face the direction of travel so the virtual W input agrees with the
				-- circular path instead of fighting it.
				if landMove and state.questLandInputActive then
					pcall(function()
						root.CFrame = CFrame.lookAt(
							root.Position,
							root.Position + direction,
							Vector3.yAxis
						)
					end)
				end

				-- Preserve Y so swimming physics can keep the animal at the
				-- proper depth. Drinking pulses never zero this velocity.
				root.AssemblyLinearVelocity = Vector3.new(
					direction.X * speed,
					velocity.Y,
					direction.Z * speed
				)
				wasMoving = true
			end
		else
			state.questMotionMoving = false
			state.questMotionMode = nil
			state.questSetW(false)

			if wasMoving and root then
			local velocity = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
			wasMoving = false
			wasSwimming = false
			center = nil
			blockClientSubState = false
			end
		end

		task.wait(0.05)
	end
end)

shared.__uiRootCleanup = function()
	state.alive = false
	state.questMotionMoving = false
	state.questMotionMode = nil
	state.questSetW(false)
	removeSwimBarrier()
	if DAMAGE.connection then DAMAGE.connection:Disconnect(); DAMAGE.connection = nil end
	for _, connection in ipairs(connections) do connection:Disconnect() end
	gui:Destroy()
	shared.__uiRootCleanup = nil
end
