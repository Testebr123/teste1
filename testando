shared.__uiRootCleanup = function()
	-- Preserve the user's automation intent for the next execution.
	shared.__mmbHubResume = {
		autoQuests =
			state.autoQuests == true,

		autoClaimQuests =
			state.autoClaimQuests == true,

		autoEat =
			state.autoEat == true,

		autoDrink =
			state.autoDrink == true,

		autoDrinkPreferredMode =
			state.autoDrinkPreferredMode,

		coinFarmAllowAutoQuests =
			state.coinFarmAllowAutoQuests == true,

		growthPrideEnabled =
			state.growthPrideEnabled ~= false,

		autoEatManualDisabled = state.autoEatManualDisabled == true,
		autoDrinkManualDisabled = state.autoDrinkManualDisabled == true,
	}

	state.alive = false

	-- Stop any SafeMove immediately. In-flight quest-slot tasks also check
	-- state.alive before every Reset/Create/Spawn stage.
	if state.safeMove then
		state.safeMove.cancelToken += 1
	end

	state.questSlots.busy = false
	questSwitchingAnimal = false

	local cleanupCharacter =
		player.Character

	if cleanupCharacter then
		pcall(state.heavyWalkStop, cleanupCharacter)
		pcall(state.releaseMovementNow, cleanupCharacter, true)
		pcall(state.questSlotsNormalizeControl, cleanupCharacter)
	end

	local cleanupWater = workspace:FindFirstChild("MainWaterPart")
	if state.drinkTest
		and state.drinkTest.collisionSnapshot
		and state.drinkTest.character
		and state.drinkTest.character.Parent then

		local cleanupHumanoid =
			state.drinkTest.character:
				FindFirstChildOfClass(
					"Humanoid"
				)

		if cleanupHumanoid then
			pcall(
				state.drinkTestSetTransitPhysics,
				state.drinkTest.character,
				cleanupHumanoid,
				false
			)
		end

		pcall(
			state.drinkTestGhostCharacter,
			state.drinkTest.character,
			false
		)
	end

	if cleanupWater and cleanupWater:IsA("BasePart") then
		cleanupWater.CanCollide = false
	end
	state.questMotionMoving = false
	state.questMotionMode = nil
	state.questSetW(false)
	removeSwimBarrier()
	if DAMAGE.connection then DAMAGE.connection:Disconnect(); DAMAGE.connection = nil end
	for _, connection in ipairs(connections) do connection:Disconnect() end
	gui:Destroy()
	shared.__uiRootCleanup = nil
end
