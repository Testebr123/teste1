local function forcePostDrinkTeleport(wasUnderground)
	if forcingPostDrinkTeleport then return end

	forcingPostDrinkTeleport = true
	criticalRecoveryActive = true

	-- Hard lock before the drinking state is released.
	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil
	if state.questSetW then state.questSetW(false) end

	runtimeMessage = wasUnderground
		and "Agua cheia; SAINDO de baixo do Terrain antes de liberar Auto Run"
		or "Agua cheia; saindo da agua antes de liberar quests"

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	if waterPart and waterPart:IsA("BasePart") then
		waterPart.CanCollide = false
	end

	local function confirmedOutside()
		local _, root = characterParts()
		if not root then return false end
		if root.Position.Y < config.dangerY then return false end
		if isStandingInWater(root) then return false end
		if not isDinoLife and state.drinkIsBuriedUnderTerrain(root) then
			return false
		end
		return true
	end

	local escaped = false

	if isDinoLife then
		local _, root = characterParts()

		if root and root.Position.Y < config.dangerY then
			escaped = escapeDinoToSafety("void depois de beber")
		else
			local nestRock1 = findNestRock1()

			if nestRock1 then
				escaped = ensureOnSolidGround(
					nestRock1.Position,
					"NestRock1 (saindo da agua)"
				)
			elseif root then
				for _, spawnPart in ipairs(DAMAGE.getNearestSafeSpawns(root)) do
					if ensureOnSolidGround(
						spawnPart.Position,
						spawnPart.Name .. " (saindo da agua)"
					) then
						escaped = true
						break
					end
				end
			end
		end
	else
		refreshCompletionSpawns()

		local candidates = {}
		local _, root = characterParts()

		if selectedCompletionSpawn and selectedCompletionSpawn.Parent then
			table.insert(candidates, selectedCompletionSpawn.Position)
		end

		if root then
			local sorted = {}

			for _, part in ipairs(completionSpawnParts) do
				if part and part.Parent then
					table.insert(sorted, part)
				end
			end

			table.sort(sorted, function(a, b)
				return (a.Position - root.Position).Magnitude
					< (b.Position - root.Position).Magnitude
			end)

			for _, part in ipairs(sorted) do
				table.insert(candidates, part.Position)
			end
		end

		table.insert(candidates, config.farm)

		for _, position in ipairs(candidates) do
			if ensureOnSolidGround(
				position,
				wasUnderground
					and "terra firme ACIMA do Terrain"
					or "ponto de saida da agua"
			) then
				escaped = true
				break
			end
		end
	end

	resetEatingSearch(nil)
	drinkingSourcePosition = nil

	-- Final independent proof. A successful TP call is not enough.
	if escaped and confirmedOutside() then
		state.drinkClearUndergroundMode()

		state.autoEat, state.autoDrink = true, true
		if renders then
			if renders.autoEat then renders.autoEat() end
			if renders.autoDrink then renders.autoDrink() end
		end

		criticalRecoveryActive = false
		forcingPostDrinkTeleport = false
		state.questForceFastRecheckUntil = tick() + 25

		runtimeMessage = wasUnderground
			and "Saiu do Terrain CONFIRMADO; Auto Run liberado"
			or "Saiu da agua; quests liberadas"
		return
	end

	-- Fail closed. Never let Run start under Terrain.
	forcingPostDrinkTeleport = false

	local liveCharacter, liveRoot = characterParts()
	if liveCharacter and liveRoot then
		state.drinkEmergencyEscape(
			liveCharacter,
			liveRoot,
			"Pos-bebida ainda sob Terrain; escape anti-afogamento forcado"
		)
	else
		criticalRecoveryActive = false
	end
end

local drinkingStuckSince
-- Segura a posição com alta frequência enquanto bebe no Dino Life. O
-- autoDrinkStep só roda 1x/segundo — frequência baixa demais pra evitar o
-- jitter físico de ficar em pé numa água com CanCollide=true (que estava
-- causando dano de queda). Essa rotina corrige a cada 0.25s até encher.
local dinoDrinkHoldBusy = false
local function holdDinoDrinkPosition(targetPosition)
	if dinoDrinkHoldBusy then return end
	dinoDrinkHoldBusy = true

	local promptMissingSince = nil
	local anchorXZ = nil

	while drinkingToFull and state.autoDrink and not criticalRecoveryActive do
		local character, root, humanoid = characterParts()
		if not character or not root or not humanoid then break end

		local water = character:GetAttribute("Water") or 100
		if water >= (preSwitchWaterTarget or 98) then break end

		local detected = detectAvailableFood(character)

		if detected == "Drink" then
			-- Posição válida não significa orientação segura.
			-- Corrige ragdoll invertido antes de segurar a posição.
			promptMissingSince = nil

			if state.drinkIsUpsideDown(root) then
				state.drinkUprightCharacter(character, root, nil)
			end

			if not anchorXZ then
				anchorXZ = Vector3.new(root.Position.X, 0, root.Position.Z)
			end
			drinkingSourcePosition = root.Position
			runtimeMessage = "Dino: prompt detectado; bebendo"

			local velocity = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(0, math.clamp(velocity.Y, -2, 2), 0)
			root.AssemblyAngularVelocity = Vector3.zero

			-- Só segura X/Z se escorregar bastante. O Y atual é SEMPRE preservado,
			-- eliminando o efeito de ficar flickando para cima/baixo.
			if anchorXZ then
				local horizontalOffset = Vector3.new(
					root.Position.X - anchorXZ.X,
					0,
					root.Position.Z - anchorXZ.Z
				)
				if horizontalOffset.Magnitude > 3.5 then
					root.CFrame = CFrame.new(
						anchorXZ.X,
						root.Position.Y,
						anchorXZ.Z
					) * root.CFrame.Rotation
				end
			end

			character:SetAttribute("MovementDisabled", false)
			setSubState("Drinking")
		else
			-- O prompt pode piscar por alguns frames. Não teleporta imediatamente.
			if not promptMissingSince then promptMissingSince = tick() end
			if tick() - promptMissingSince >= 1.5 then
				break
			end

			local velocity = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(0, math.clamp(velocity.Y, -2, 2), 0)
			root.AssemblyAngularVelocity = Vector3.zero
			setSubState("Drinking")
		end

		task.wait(0.15)
	end

	dinoDrinkHoldBusy = false
end

local lastDrinkWatchdogWater

function state.drinkEmergencyEscape(character, root, reason)
	if not character or not root then return false end

	local badPoint = state.drinkSearch.currentWaterPoint
		or drinkingSourcePosition
		or root.Position

	state.drinkMarkFailed(badPoint, 300)

	-- These are now the REAL locals, not accidental globals.
	criticalRecoveryActive = true
	drinkingToFull = false
	drinkingSourcePosition = nil
	drinkingStuckSince = nil
	lastDrinkWatchdogWater = nil

	state.questTravelActive = false
	state.questLandInputActive = false
	state.questMotionMoving = false
	state.questMotionMode = nil
	if state.questSetW then state.questSetW(false) end

	state.drinkSearch.currentWaterPoint = nil
	state.drinkSearch.failedCount = 0
	state.drinkSearch.retryAfter = tick() + 8
	state.drinkSearch.upsideDownSince = nil
	state.drinkSearch.waterHealth = nil
	state.drinkSearch.waterHealthAt = 0

	removeSwimBarrier()

	local waterPart = workspace:FindFirstChild("MainWaterPart")
	if waterPart and waterPart:IsA("BasePart") then
		waterPart.CanCollide = false
	end

	runtimeMessage = reason or "ANTI-AFOGAMENTO: escapando para cima do Terrain"

	local function confirmedAboveTerrain()
		local _, liveRoot = characterParts()
		if not liveRoot then return false end
		if liveRoot.Position.Y < config.dangerY then return false end
		if isStandingInWater(liveRoot) then return false end
		if not isDinoLife and state.drinkIsBuriedUnderTerrain(liveRoot) then
			return false
		end
		return true
	end

	refreshCompletionSpawns()

	local candidates = {}
	local _, liveRoot = characterParts()

	if selectedCompletionSpawn and selectedCompletionSpawn.Parent then
		table.insert(candidates, selectedCompletionSpawn.Position)
	end

	if liveRoot then
		local sorted = {}
		for _, part in ipairs(completionSpawnParts) do
			if part and part.Parent then
				table.insert(sorted, part)
			end
		end

		table.sort(sorted, function(a, b)
			return (a.Position - liveRoot.Position).Magnitude
				< (b.Position - liveRoot.Position).Magnitude
		end)

		for _, part in ipairs(sorted) do
			table.insert(candidates, part.Position)
		end
	end

	table.insert(candidates, config.farm)

	for round = 1, 3 do
		for _, position in ipairs(candidates) do
			runtimeMessage = string.format(
				"ANTI-AFOGAMENTO: tentando sair do Terrain (%d/3)",
				round
			)

			ragdollTeleport(position, 8)
			task.wait(0.35)

			if confirmedAboveTerrain() then
				state.drinkClearUndergroundMode()
				criticalRecoveryActive = false
				state.questForceFastRecheckUntil = tick() + 25
				runtimeMessage = "ANTI-AFOGAMENTO: ACIMA do Terrain confirmado"
				return true
			end
		end

		if DAMAGE and type(DAMAGE.teleportToSafety) == "function" then
			pcall(DAMAGE.teleportToSafety)
			task.wait(0.45)

			if confirmedAboveTerrain() then
				state.drinkClearUndergroundMode()
				criticalRecoveryActive = false
				state.questForceFastRecheckUntil = tick() + 25
				runtimeMessage = "ANTI-AFOGAMENTO: spawn seguro confirmado"
				return true
			end
		end
	end

	-- Keep the lock and retry. Do NOT resume movement under Terrain.
	runtimeMessage = "CRITICO: ainda sob Terrain; Auto Run BLOQUEADO; repetindo escape"

	task.delay(1.0, function()
		if not state.alive then return end

		local liveCharacter, retryRoot = characterParts()
		if liveCharacter and retryRoot then
			state.drinkEmergencyEscape(
				liveCharacter,
				retryRoot,
				"Repetindo escape anti-afogamento"
			)
		else
			criticalRecoveryActive = false
		end
	end)

	return false
end


local function virtualDrinkKick()
	local character, root = characterParts()
	if not character or not root then return end

	local detected = detectAvailableFood(character)
	local dinoPromptAlreadyVisible = isDinoLife and detected == "Drink"

	if dinoPromptAlreadyVisible then
		runtimeMessage = "Dino: beber travou, mas prompt esta ativo; reativando sem TP"
		drinkingSourcePosition = root.Position
	else
		runtimeMessage = "Beber travado; forcando com tecla E"

		if isDinoLife then
			local landing = DINO_DRINK_POSITION + Vector3.new(0, surfaceStandOffset(character), 0)
			ragdollTeleport(landing)
			local _, newRoot = characterParts()
			if newRoot then drinkingSourcePosition = newRoot.Position end
			CROC.dinoLastTeleportAt = tick()
		elseif CROC.isCharacter(character) then
			drinkingSourcePosition = nil
			removeSwimBarrier()
			local _, waterPart = CROC.getWaterSurfaceY()
			if waterPart then waterPart.CanCollide = true end
			CROC.approachDrink()
		elseif drinkingSourcePosition then
			state.drinkAbandonCurrent("Watchdog: fonte sem progresso; trocando de agua")
			return
		end

		task.wait(0.2)
	end

	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
		task.wait(0.05)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
	end)
	task.wait(0.15)

	-- No Dino, se o prompt já estava visível, não desliga/reLiga Auto Drink.
	-- Esse toggle era outra fonte de interrupção e jitter.
	if not dinoPromptAlreadyVisible then
		state.autoDrink = false
		if renders and renders.autoDrink then renders.autoDrink() end
		task.wait(0.2)
		state.autoDrink = true
		if renders and renders.autoDrink then renders.autoDrink() end
	end

	setSubState("Drinking")
	if isDinoLife then
		task.spawn(holdDinoDrinkPosition, drinkingSourcePosition or root.Position)
	end
	drinkingStuckSince = nil
end

local function autoDrinkStep()
	if state.questGrowthReset.exclusive then return end
	if not state.autoDrink or criticalRecoveryActive then return end

	local character, root, humanoid = characterParts()
	if not character or not root or not humanoid then return end

	local earlyWater = character:GetAttribute("Water") or 100

	-- Baboon food must NEVER block thirst handling. Cancel its logical ownership
	-- before checking state.busy; if a one-shot AntHill TP is still settling,
	-- Auto Drink will take over on the next scan instead of restarting food.
	if isBaboonCharacter(character) and earlyWater <= 75 then
		state.questBaboonFeeding = false
		eatingToFull = false
		eatingSourcePosition = nil
		activeCarcass = nil
		BABOON.cancel()
		eatingStuckSince = nil
		blockClientSubState = false
	end

	if state.busy then return end

	if state.drinkPostureWatch(character, root, humanoid) then
		return
	end

	local currentAnimalName = CROC.getAnimalName(character)
	if not isGiraffeCharacter(character)
		and (GIRAFFE.busy or GIRAFFE.targetTree) then
		state.questGiraffeFeeding = false
		GIRAFFE.cancel()
	end

	if not isBaboonCharacter(character) and (BABOON.busy or BABOON.targetObject) then
		state.questBaboonFeeding = false
		BABOON.cancel()
	end

	if currentAnimalName ~= CROC.lastDrinkAnimalName then
		-- Never leave MainWaterPart solid after switching away from Hippo/Croc.
		local waterPart = workspace:FindFirstChild("MainWaterPart")
		if waterPart and waterPart:IsA("BasePart") then
			waterPart.CanCollide = false
		end

		drinkingToFull = false
		drinkingSourcePosition = nil
		drinkingStuckSince = nil
		lastDrinkWatchdogWater = nil
		state.drinkSearch.currentWaterPoint = nil
		state.drinkSearch.failedCount = 0
		state.drinkSearch.retryAfter = 0
		state.drinkSearch.upsideDownSince = nil
		state.drinkSearch.waterHealth = nil
		state.drinkSearch.waterHealthAt = 0
		state.drinkClearUndergroundMode()
		removeSwimBarrier()
		CROC.lastDrinkAnimalName = currentAnimalName
		CROC.dinoLastTeleportAt = nil
	end

	local water = earlyWater

	if not state.questSwimActive
		and tick() < (state.drinkSearch.retryAfter or 0) then
		drinkingToFull = false
		return
	end

	-- Swim quest: água nunca pode interromper o deslocamento.
	-- Só tenta beber quando realmente precisa e com pulsos bem espaçados;
	-- isso evita alternar Drinking/Swimming o tempo inteiro e causar "flick".
	if state.questSwimActive then
		drinkingToFull = false
		drinkingSourcePosition = nil
		drinkingStuckSince = nil
		lastDrinkWatchdogWater = water
		removeSwimBarrier()

		if water <= 58
			and tick() - (state.questSwimLastDrinkAt or 0) >= 1.6
			and detectAvailableFood(character) == "Drink" then

			state.questSwimLastDrinkAt = tick()
			runtimeMessage = string.format("Swim: quick drink while moving (%d%%)", math.floor(water))

			local _, liveRoot = characterParts()
			local keepVelocity = liveRoot and liveRoot.AssemblyLinearVelocity
			local aquaticDrink = isAquaticCharacter(character)

			-- Hippo/Croc still get the special solid water while drinking.
			-- In a Swim quest this is temporary: turn it back off immediately
			-- after the pulse so it cannot stop the swimming movement.
			if aquaticDrink then
				setAquaticWaterCollision(character, true)
			end

			setSubState("Drinking")
			pcall(function()
				VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
				task.wait(0.025)
				VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
			end)
			task.wait(0.035)

			if aquaticDrink then
				setAquaticWaterCollision(character, false)
			end

			if liveRoot and keepVelocity then
				liveRoot.AssemblyLinearVelocity = keepVelocity
			end
			setSubState("Swimming")
		end
		return
	end

	if water <= 75 then
		drinkingToFull = true
		eatingToFull = false
		eatingSourcePosition = nil
		activeCarcass = nil
		state.questBaboonFeeding = false
		state.questGiraffeFeeding = false
		BABOON.cancel()
		GIRAFFE.cancel()
		blockClientSubState = false
		runtimeMessage = isBaboonCharacter(character)
			and "Baboon: Water <= 75%; drinking has priority"
			or "Indo beber agua"
	end
	if drinkingToFull and water >= (preSwitchWaterTarget or 98) then
		local wasUnderground = state.drinkSearch.undergroundMode

		-- CRITICAL: lock movement BEFORE drinkingToFull becomes false.
		criticalRecoveryActive = true
		state.questTravelActive = false
		state.questLandInputActive = false
		state.questMotionMoving = false
		state.questMotionMode = nil
		if state.questSetW then state.questSetW(false) end

		drinkingToFull = false
		state.drinkSearch.currentWaterPoint = nil
		state.drinkSearch.failedCount = 0
		state.drinkSearch.retryAfter = 0
		state.drinkSearch.upsideDownSince = nil
		state.drinkSearch.waterHealth = nil
		state.drinkSearch.waterHealthAt = 0

		-- Do NOT clear undergroundMode yet. It is cleared only after a position
		-- above Terrain has been positively confirmed.
		removeSwimBarrier()

		if isAquaticCharacter(character) then
			setAquaticWaterCollision(character, false)
		end

		task.spawn(forcePostDrinkTeleport, wasUnderground)
		return
	end
	if not drinkingToFull then return end

	if state.drinkSearch.undergroundMode then
		if state.drinkUndergroundSafety(character, root, humanoid, water) then
			return
		end
	end

	-- Buried water is invalid unless we deliberately entered the protected
	-- Savannah drought fallback mode.
	-- Do this before prompt/watchdog logic so we react on the very next scan.
	if not isDinoLife
		and not state.drinkSearch.undergroundMode
		and state.drinkIsBuriedUnderTerrain(root) then
		state.drinkEmergencyEscape(
			character,
			root,
			"Watchdog agua: Terrain acima do personagem; abortando fonte"
		)
		return
	end

	if not isAquaticCharacter(character)
		and state.drinkSearch.currentWaterPoint
		and root.Position.Y < state.drinkSearch.currentWaterPoint.Y - 7 then

		state.drinkEmergencyEscape(
			character,
			root,
			"Watchdog agua: personagem afundou demais; abortando fonte"
		)
		return
	end

	if lastDrinkWatchdogWater == nil or water > lastDrinkWatchdogWater then
		lastDrinkWatchdogWater = water
		drinkingStuckSince = tick()
		state.drinkSearch.failedCount = 0

		if state.drinkSearch.undergroundMode then
			state.drinkSearch.undergroundLastProgressAt = tick()
			state.drinkSearch.undergroundLastWater = water
		end
	elseif not drinkingStuckSince then
		drinkingStuckSince = tick()
	end
	if drinkingStuckSince and tick() - drinkingStuckSince >= 6 then
		lastDrinkWatchdogWater = water
		drinkingStuckSince = tick()

		if not isDinoLife
			and not CROC.isCharacter(character)
			and detectAvailableFood(character) ~= "Drink" then
			state.drinkAbandonCurrent("Agua sem prompt/progresso; descartando ponto e procurando outro")
			return
		end

		virtualDrinkKick()
		return
	end

	-- Se o prompt já está disponível, não reposiciona nem deixa outra rotina
	-- assumir o personagem: simplesmente mantém a posição e bebe.
	local drinkDetectedNow = detectAvailableFood(character)
	if drinkDetectedNow == "Drink" then
		drinkingSourcePosition = root.Position

		-- Não congele o ragdoll se ele chegou de ponta-cabeça.
		if state.drinkIsUpsideDown(root) then
			state.drinkUprightCharacter(
				character,
				root,
				state.drinkSearch.currentWaterPoint
			)
		else
			root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
			root.AssemblyAngularVelocity = Vector3.zero
		end

		runtimeMessage = "Prompt de agua detectado; bebendo"
		setSubState("Drinking")
		if isDinoLife then
			task.spawn(holdDinoDrinkPosition, root.Position)
		end
		return
	end

	if isDinoLife then
		local waterPart = workspace:FindFirstChild("MainWaterPart")
		if waterPart and waterPart:IsA("BasePart") then waterPart.CanCollide = true end

		-- REGRA PRINCIPAL: se o prompt já aparece, a posição atual é válida.
		-- Não teleporta de novo e não tenta empurrar o personagem para outra altura.
		local detected = detectAvailableFood(character)
		if detected == "Drink" then
			drinkingSourcePosition = root.Position
			CROC.dinoLastTeleportAt = nil
			runtimeMessage = "Dino: prompt de beber detectado; mantendo posicao"
			setSubState("Drinking")
			task.spawn(holdDinoDrinkPosition, root.Position)
			return
		end

		-- Depois de um TP, dá alguns segundos para o prompt aparecer/estabilizar.
		-- Antes o autoDrinkStep rodava de novo 1s depois e teleportava no MESMO
		-- ponto repetidamente, mesmo quando o animal ainda estava assentando.
		if drinkingSourcePosition and (root.Position - drinkingSourcePosition).Magnitude <= 20 then
			local elapsed = tick() - (CROC.dinoLastTeleportAt or tick())
			if elapsed < 4 then
				runtimeMessage = string.format(
					"Dino: aguardando prompt estabilizar (%.1fs)",
					math.max(0, 4 - elapsed)
				)
				setSubState("Drinking")
				return
			end
		end

		local dinoLandingPosition = DINO_DRINK_POSITION + Vector3.new(0, surfaceStandOffset(character), 0)
		runtimeMessage = "Dino: posicionando na agua"
		ragdollTeleport(dinoLandingPosition)

		-- Usa a posição REAL depois do pouso como referência, não o alvo teórico.
		local _, landedRoot = characterParts()
		drinkingSourcePosition = landedRoot and landedRoot.Position or dinoLandingPosition
		CROC.dinoLastTeleportAt = tick()

		task.wait(0.25)
		for _ = 1, 3 do
			setSubState("Drinking")
			task.wait(0.15)
		end
		return
	end


	if CROC.isCharacter(character) then
		setAquaticWaterCollision(character, true)

		if drinkingSourcePosition and (root.Position - drinkingSourcePosition).Magnitude <= 14 then
			runtimeMessage = "Croco: na margem; bebendo"
			setSubState("Drinking")
			return
		end

		CROC.approachDrink()
		return
	end

	local isAquatic = isAquaticCharacter(character)

	if drinkingSourcePosition and (root.Position - drinkingSourcePosition).Magnitude <= 16 then
		if not state.drinkSearch.undergroundMode
			and state.drinkIsBuriedUnderTerrain(root) then
			state.drinkEmergencyEscape(
				character,
				root,
				"Fonte lembrada ficou sob Terrain; saindo"
			)
			return
		end

		local detectedHere = detectAvailableFood(character)

		if detectedHere == "Drink" then
			runtimeMessage = "Bebendo ate encher"

			if isAquatic then
				setAquaticWaterCollision(character, true)
			end

			if state.drinkIsUpsideDown(root) then
				state.drinkUprightCharacter(
					character,
					root,
					state.drinkSearch.currentWaterPoint
				)
			end

			setSubState("Drinking")
			return
		end

		-- We reached the selected water but the game itself says Drink is not
		-- available. Give physics/prompt a short grace period, then blacklist it.
		if drinkingStuckSince and tick() - drinkingStuckSince >= 3.5 then
			state.drinkAbandonCurrent("Poca/agua nao utilizavel; mudando para outra fonte")
			return
		end
	end

	-- Mode 1: prefer exposed/above-Terrain water whenever it exists.
	local spot = state.drinkFindAccessibleSpot(root.Position, character)

	-- Mode 2: drought fallback. If no exposed source exists, deliberately use
	-- MainWaterPart below Terrain with aggressive anti-drowning protections.
	if not spot and isSavannahLife then
		spot = state.drinkFindUndergroundSpot(root.Position, character)

		if spot then
			runtimeMessage = string.format(
				"Seca: sem agua exposta; usando agua subterranea protegida (%.0f studs)",
				spot.coverDepth or 0
			)
		end
	end

	if not spot then
		state.drinkSearch.failedCount = (state.drinkSearch.failedCount or 0) + 1
		runtimeMessage = "Nenhuma agua exposta nem subterranea utilizavel encontrada"

		if state.drinkSearch.failedCount >= 2 then
			state.drinkSearch.failedCount = 0
			state.drinkSearch.retryAfter = tick() + 10
			drinkingToFull = false
			runtimeMessage = "Busca de agua falhou; Auto Run liberado por 10s"
		end
		return
	end

	-- Final pre-TP validation only for normal exposed drinking. Underground
	-- fallback is intentionally underneath Terrain and has its own watchdog.
	if not spot.underground
		and not isAquatic
		and state.drinkLandingCovered(spot.stand) then
		state.drinkMarkFailed(spot.water, 300)
		state.drinkSearch.currentWaterPoint = nil
		runtimeMessage = "Fonte rejeitada: ponto de bebida esta sob Terrain"
		return
	end

	state.drinkSearch.currentWaterPoint = spot.water

	if spot.underground then
		state.drinkSearch.undergroundMode = true
		state.drinkSearch.undergroundSince = tick()
		state.drinkSearch.undergroundLastProgressAt = tick()
		state.drinkSearch.undergroundLastWater = water
		state.drinkSearch.waterHealth = humanoid.Health
		state.drinkSearch.waterHealthAt = tick()
		runtimeMessage = "Descendo para MainWaterPart subterranea com watchdog anti-afogamento"
	else
		state.drinkClearUndergroundMode()
		runtimeMessage = "Indo para agua exposta (" .. tostring(spot.source) .. ")"
	end

	local landed
	if isAquatic then
		setAquaticWaterCollision(character, true)
		landed = ragdollTeleport(spot.stand, 6, spot.water)
	else
		-- Land animals stand on REAL terrain beside the water and face it.
		landed = ragdollTeleport(spot.stand, 6, spot.water)
	end

	if not landed then
		state.drinkAbandonCurrent("Falhou ao chegar na fonte; procurando outra")
		return
	end

	task.wait(0.45)

	local _, newRoot = characterParts()
	if not newRoot then
		state.drinkAbandonCurrent("Personagem sumiu ao chegar na agua; procurando outra")
		return
	end

	if not spot.underground and state.drinkIsBuriedUnderTerrain(newRoot) then
		state.drinkEmergencyEscape(
			character,
			newRoot,
			"BUG DE AGUA: personagem caiu sob Terrain; escapando imediatamente"
		)
		return
	end

	-- Land animals should remain around the bank/water surface. If the HRP
	-- somehow sank deeply below the selected water, treat it as the same bug.
	if not spot.underground
		and not isAquatic
		and state.drinkSearch.currentWaterPoint
		and newRoot.Position.Y < state.drinkSearch.currentWaterPoint.Y - 7 then

		state.drinkEmergencyEscape(
			character,
			newRoot,
			"BUG DE AGUA: animal afundou abaixo da fonte; escapando"
		)
		return
	end

	local detectedAfterArrival = detectAvailableFood(character)
	if detectedAfterArrival ~= "Drink" then
		local flat = Vector3.new(
			spot.water.X - newRoot.Position.X,
			0,
			spot.water.Z - newRoot.Position.Z
		)
		if flat.Magnitude > 0.5 then
			pcall(function()
				character:PivotTo(
					CFrame.lookAt(
						newRoot.Position,
						newRoot.Position + flat.Unit,
						Vector3.yAxis
					)
				)
			end)
		end

		if spot.underground then
			local promptDeadline = tick() + 4.0

			repeat
				if state.drinkUndergroundSafety(
					character,
					newRoot,
					humanoid,
					water
				) then
					return
				end

				setSubState("Drinking")
				task.wait(0.25)
				detectedAfterArrival = detectAvailableFood(character)
			until detectedAfterArrival == "Drink" or tick() >= promptDeadline
		else
			task.wait(0.35)
			detectedAfterArrival = detectAvailableFood(character)
		end
	end

	if detectedAfterArrival ~= "Drink" then
		if spot.underground then
			state.drinkEmergencyEscape(
				character,
				newRoot,
				"Agua subterranea sem prompt Drink; saindo imediatamente"
			)
		else
			state.drinkAbandonCurrent(
				"Fonte chegou sem prompt Drink; ponto bloqueado por 150s"
			)
		end
		return
	end

	drinkingSourcePosition = newRoot.Position
	drinkingStuckSince = tick()
	lastDrinkWatchdogWater = water
	state.drinkSearch.failedCount = 0

	if spot.underground then
		state.drinkSearch.undergroundSince = tick()
		state.drinkSearch.undergroundLastProgressAt = tick()
		state.drinkSearch.undergroundLastWater = water
	end

	if state.drinkIsUpsideDown(newRoot) then
		state.drinkUprightCharacter(character, newRoot, spot.water)
	end

	-- Barrier only after the game confirms the source is actually drinkable.
	-- We never freeze the animal beside an invalid puddle anymore.
	if isAquatic then
		updateSwimBarrier(newRoot, true)
	end

	runtimeMessage = spot.underground
		and "Agua subterranea valida; bebendo com watchdog ativo"
		or "Fonte exposta valida confirmada; bebendo"
	setSubState("Drinking")
end

local function isInsideTerrain(character, root)
	if not character or not root then return false end
	local region = Region3.new(root.Position - Vector3.new(2,2,2), root.Position + Vector3.new(2,2,2)):ExpandToGrid(4)
	local ok, _, occupancy = pcall(function()
		local materials, values = workspace.Terrain:ReadVoxels(region, 4)
		return materials, values
	end)
	return ok and occupancy and occupancy[1][1][1] > 0.55
end

local function resolveReplication()
	if shared._playerDataReplication and type(shared._playerDataReplication.GetKeyData) == "function" then
		return shared._playerDataReplication
	end
	for _, root in ipairs({ ReplicatedStorage, player:FindFirstChild("PlayerScripts"), player:FindFirstChild("PlayerGui") }) do
		local module = root and root:FindFirstChild("PlayerDataReplication", true)
		if module and module:IsA("ModuleScript") then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" and type(result.GetKeyData) == "function" then
				shared._playerDataReplication = result
				return result
			end
		end
	end
end

local function savedCharacters()
	local replication = resolveReplication()
	if not replication then runtimeMessage = "Dados de slots nao encontrados"; return {} end
	local ok, records = pcall(replication.GetKeyData, "SavedCharacters")
	if (not ok or type(records) ~= "table") and type(replication.GetData) == "function" then
		local dataOk, data = pcall(replication.GetData)
		if dataOk and type(data) == "table" then
			records = data.SavedCharacters
			ok = type(records) == "table"
		end
	end
	if not ok or type(records) ~= "table" then
		runtimeMessage = "Falha ao ler SavedCharacters"
		return {}
	end

	local normalized = {}
	for key, entry in pairs(records) do
		if type(entry) == "table" then
			if not entry.CharacterName and type(key) == "string" then
				entry.CharacterName = key
			end
			table.insert(normalized, entry)
		end
	end
	table.sort(normalized, function(a, b)
		return tostring(a.CharacterName or "") < tostring(b.CharacterName or "")
	end)
	return normalized
end

local function motherNameFor(entry)
	if type(entry) ~= "table" or (entry.GrowthPercentage or 1) > 0.01 then return nil end
	local remote = ReplicatedStorage:FindFirstChild("BabySpawnsRequestMotherNamesRemoteFunction")
	if not remote then return nil end
	local ok, result = pcall(remote.InvokeServer, remote, entry.AnimalName)
	if not ok then return nil end
	if type(result) == "string" then return result end
	if type(result) == "table" then
		for _, value in pairs(result) do
			if type(value) == "string" then return value end
			if type(value) == "table" then return value.PlayerName or value.Name or value.Username end
		end
	end
end

local function spawnSlot(entry, skipSafeTeleport)
	local uniqueName = type(entry) == "table"
		and (entry.UniqueCharacterName or entry.CharacterName)
	if not SpawnRemote or not uniqueName then return false end

	local expectedName = entry.CharacterName
	local expectedAnimal = entry.AnimalName

	state.questExpectedSlot = {
		uniqueName = entry.UniqueCharacterName or entry.CharacterName,
		characterName = expectedName,
		animalName = expectedAnimal,
		requestedAt = tick(),
	}

	runtimeMessage = "Trocando para " .. tostring(expectedName)

	local mother = motherNameFor(entry)
	local oldCharacter = player.Character
	local ok = pcall(function()
		if mother then
			SpawnRemote:InvokeServer(uniqueName, mother)
		else
			SpawnRemote:InvokeServer(uniqueName)
		end
	end)

	if not ok then
		state.questExpectedSlot = nil
		runtimeMessage = "Spawn falhou: " .. tostring(expectedName)
		return false
	end

	local deadline = tick() + 16
	local changedSince
	local matched

	repeat
		task.wait(0.25)

		local candidate = player.Character
		local root = candidate and candidate:FindFirstChild("HumanoidRootPart")

		if candidate and root then
			if candidate ~= oldCharacter then
				changedSince = changedSince or tick()
			end

			local charName = candidate:GetAttribute("CharacterName")
			local animalName = candidate:GetAttribute("AnimalName")

			local nameMatches = charName == expectedName
			local animalMatches = type(expectedAnimal) == "string"
				and state.questAnimalKey(animalName) == state.questAnimalKey(expectedAnimal)

			if nameMatches or animalMatches then
				matched = candidate
				break
			end

			-- New Character but attributes are still loading.
			if candidate ~= oldCharacter
				and changedSince
				and tick() - changedSince >= 2 then
				matched = candidate
				break
			end
		end
	until tick() >= deadline

	if not matched then
		state.questExpectedSlot = nil
		runtimeMessage = "Spawn nao confirmou o slot " .. tostring(expectedName)
		return false
	end

	task.wait(1)
	state.questExpectedSlot = nil

	if not skipSafeTeleport then
		ragdollTeleport(getSafeFarmPosition())
	end

	runtimeMessage = "Slot ativo: " .. tostring(expectedName)
	return true
end

local slotIndex = 0
local sessionCompletedSlots = {}
local function isGrowthComplete(value)
	value = tonumber(value)
	if value == nil then return false end
	if value <= 1 then return value >= 0.999 end
	return value >= 99.9
end

local function nextExistingSlot(animalName, records, includeAllAnimals)
	records = records or savedCharacters()
	if #records == 0 then return nil end

	local currentCharacter = player.Character
	local currentName = currentCharacter
		and currentCharacter:GetAttribute("CharacterName")

	for _ = 1, #records do
		slotIndex = slotIndex % #records + 1
		local entry = records[slotIndex]
		local name = type(entry) == "table"
			and entry.CharacterName

		local animalAllowed =
			includeAllAnimals == true
			or (
				type(entry) == "table"
				and not state.questIsFlyingAnimalName(entry.AnimalName)
				and (
					not animalName
					or entry.AnimalName == animalName
				)
			)

		if type(name) == "string"
			and name ~= ""
			and name ~= currentName
			and not sessionCompletedSlots[name]
			and animalAllowed
			and not isGrowthComplete(entry.GrowthPercentage) then

			runtimeMessage = includeAllAnimals
				and string.format(
					"AUTO Grow All: next %s slot -> %s (%s%%)",
					tostring(entry.AnimalName or "animal"),
					name,
					tostring(entry.GrowthPercentage or "?")
				)
				or string.format(
					"Testando slot: %s (salvo: %s)",
					name,
					tostring(entry.GrowthPercentage or "?")
				)

			return entry
		end
	end
end


