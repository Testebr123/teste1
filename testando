	-- v99: only the underground Underground Drink opts into this.
	-- SafeMove still changes position only through velocity.
	local rawVerticalTransit =
		options.rawVerticalTransit == true

	local riverApproach =
		options.riverApproach == true

	-- Explicit Move To in Savannah Life and Dino Life may cross rivers normally.
	-- This disables only the route-level "water ahead -> steer away" behavior;
	-- rocks/hills/stall handling remain active and Safety can recover after a real
	-- no-progress timeout through intentionalWaterTransitActive().
	local allowIntentionalWaterTransit =
		options.allowWaterTransit == true
		or (
			(isSavannahLife or isDinoLife)
			and purpose == "manual"
