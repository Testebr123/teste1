function state.antiAfkPulse(reason)
	if not state.alive then return false end

	local virtualUserWorked = pcall(function()
		VirtualUser:CaptureController()
		local camera = workspace.CurrentCamera
		local cameraCFrame = camera and camera.CFrame or CFrame.new()

		-- Classic Roblox idle-reset input. Keep the click at (0, 0) so it does not
		-- target HUD buttons or alter any movement controller.
		VirtualUser:Button2Down(Vector2.zero, cameraCFrame)
		task.wait(0.055)
		VirtualUser:Button2Up(Vector2.zero, cameraCFrame)
	end)

	-- Madium already executes VirtualInputManager elsewhere in the Hub. Use a
	-- one-pixel mouse nudge as an independent fallback because VirtualUser can
	-- return without error while still failing to reset Roblox inactivity.
	local mouseNudged = false
	local virtualInputCallOk = pcall(function()
		if UserInputService.MouseEnabled then
			local vim = game:GetService("VirtualInputManager")
			local mouse = UserInputService:GetMouseLocation()
			vim:SendMouseMoveEvent(mouse.X + 1, mouse.Y, game)
			task.wait()
			vim:SendMouseMoveEvent(mouse.X, mouse.Y, game)
			mouseNudged = true
		end
	end)
	local virtualInputWorked = virtualInputCallOk and mouseNudged

	state.antiAfkLastPulseAt = tick()

	if virtualUserWorked or virtualInputWorked then
		state.antiAfkLastSuccessAt = state.antiAfkLastPulseAt
		state.antiAfkLastMethod = virtualUserWorked and "VirtualUser" or "VirtualInputManager"

		if reason == "idled" then
			runtimeMessage = "Anti-AFK acionado"
		end

		return true
	end

	if reason == "idled" then
		runtimeMessage = "Anti-AFK: input virtual indisponivel"
	end

	return false
end

-- Keep the native Roblox idle signal as an immediate backup. Do not let a
-- connector/executor-specific event failure kill the rest of the Hub.
pcall(function()
	table.insert(connections, player.Idled:Connect(function()
		state.antiAfkPulse("idled")
	end))
end)

-- Proactive layer: one tiny input per minute is enough to prevent the inactivity
-- window without adding any per-frame work or touching character movement.
task.spawn(function()
	while state.alive do
		task.wait(60)
		if not state.alive then break end
		state.antiAfkPulse("watchdog")
	end
end)

-- ============================================================
-- AUTOMATIC PERMANENT NOON (no UI toggle)
-- Keeps local client lighting at 12:00 and removes the game's extra night
-- darkening effect. Re-executing the Hub cleanly replaces the previous lock.
-- ============================================================
do
	local env = (getgenv and getgenv()) or _G
	local key = "__WAVEAI_NOON_LOCK"
	local bind = "WaveAI_Noonday"
	local lighting = game:GetService("Lighting")
	local previousNoon = rawget(env, key)

	if type(previousNoon) == "table"
		and type(previousNoon.Disable) == "function" then
		pcall(previousNoon.Disable, previousNoon)
	end

	pcall(function()
		RunService:UnbindFromRenderStep(bind)
	end)

	local noonState = {
		Active = true,
		Applying = false,
		LastGameTime = lighting.ClockTime,
	}

	state.noonController = noonState
	rawset(env, key, noonState)

	local function forceNoon()
		if not noonState.Active
			or math.abs(lighting.ClockTime - 12) < 0.001 then
			return
		end

		noonState.Applying = true
		lighting.ClockTime = 12
		noonState.Applying = false
	end

	noonState.ClockConnection =
		lighting:GetPropertyChangedSignal("ClockTime"):Connect(function()
			if noonState.Applying or not noonState.Active then
				return
			end

			local receivedTime = lighting.ClockTime
			if math.abs(receivedTime - 12) >= 0.001 then
				noonState.LastGameTime = receivedTime
			end

			forceNoon()
		end)

	noonState.ChildConnection = lighting.ChildAdded:Connect(function(child)
		if noonState.Active
			and child.Name == "MakeNightDarkerColorCorrection" then
			pcall(function()
				child:Destroy()
			end)
		end
	end)

	function noonState:Disable()
		if not self.Active then
			return
		end

		self.Active = false

		if self.ClockConnection then
			pcall(function()
				self.ClockConnection:Disconnect()
			end)
		end

		if self.ChildConnection then
			pcall(function()
				self.ChildConnection:Disconnect()
			end)
		end

		pcall(function()
			RunService:UnbindFromRenderStep(bind)
		end)

		pcall(function()
			lighting.ClockTime = self.LastGameTime
		end)

		if rawget(env, key) == self then
			rawset(env, key, nil)
		end
	end

	pcall(function()
		RunService:BindToRenderStep(
			bind,
			Enum.RenderPriority.Last.Value,
			forceNoon
		)
	end)

	forceNoon()

	local darkEffect = lighting:FindFirstChild("MakeNightDarkerColorCorrection")
	if darkEffect then
		pcall(function()
			darkEffect:Destroy()
		end)
	end
end

-- ============================================================
-- MMB SAFE ANTI-LAG
-- Optimization adapted from the user's WaveAI preset.
-- Streaming is intentionally reduced while Anti-lag is ON (64 / 128) and
-- restored exactly when it is disabled. Highlight, collision/query/transparency
-- and gameplay geometry/properties remain untouched.
-- ============================================================
state.antiLagController = {
	Active = false,
	Records = {},
	Saved = setmetatable({}, { __mode = "k" }),
	Connections = {},
	LightingValues = {
		GlobalShadows = false,
		ShadowSoftness = 0,
		EnvironmentDiffuseScale = 0,
		EnvironmentSpecularScale = 0,
		PrioritizeLightingQuality = true,
		Ambient = Color3.fromRGB(160, 160, 160),
		OutdoorAmbient = Color3.fromRGB(160, 160, 160),
		Brightness = 1,
	},
	DisabledClasses = {
		ParticleEmitter = true,
		Trail = true,
		Beam = true,
		Smoke = true,
		Fire = true,
		Sparkles = true,
		Clouds = true,
	},

	-- Savannah weather blocker. HeavyRain can re-enable emitters every
	-- RenderStepped and LightRain can call ParticleEmitter:Emit() from Heartbeat,
	-- so property-only anti-lag is not sufficient. These fields hold the original
	-- module functions so toggling Anti-lag OFF restores the live weather system.
	WeatherHeavyRain = nil,
	WeatherLightRain = nil,
	WeatherHeavyEnable = nil,
	WeatherLightEnable = nil,
	WeatherSoundFadeTime = nil,
	WeatherModulesHooked = false,
	WeatherLockMap = setmetatable({}, { __mode = "k" }),
}

pcall(function()
	state.antiLagController.LightingValues.LightingStyle =
		Enum.LightingStyle.Soft
end)

-- Weather objects are created both under CurrentCamera and Terrain.
-- Keep this name filter separate from generic particles so rain/lightning
-- containers are also handled even when the container itself is not an emitter.
function state.antiLagIsWeatherObject(object)
	if not object then return false end
	local name = object.Name:lower()

	return object:IsA("Clouds")
		or name == "clouds"
		or name == "__rainemitter"
		or name == "rainstraight"
		or name == "raintopdown"
		or name:find("lightrainsharedattachment", 1, true) ~= nil
		or name:find("rainoccludedattachment", 1, true) ~= nil
		or name:find("lightning", 1, true) ~= nil
end

function state.antiLagSetAndSave(object, property, value)
	local controller = state.antiLagController
	if not controller or not controller.Active or not object then
		return false
	end

	local properties = controller.Saved[object]
	if not properties then
		properties = {}
		controller.Saved[object] = properties
	end

	local record = properties[property]
	if not record then
		local success, original = pcall(function()
			return object[property]
		end)

		local env = (getgenv and getgenv()) or _G
		local getHidden = env and rawget(env, "gethiddenproperty")
		if not success and type(getHidden) == "function" then
			success, original = pcall(getHidden, object, property)
		end

		if not success then
			return false
		end

		record = {
			Object = object,
			Property = property,
			Value = original,
			UseHiddenSetter = false,
		}
		properties[property] = record
		controller.Records[#controller.Records + 1] = record
	end

	local success = pcall(function()
		object[property] = value
	end)

	if not success then
		local env = (getgenv and getgenv()) or _G
		local setHidden = env and rawget(env, "sethiddenproperty")
		if type(setHidden) == "function" then
			success = pcall(setHidden, object, property, value)
			if success then
				record.UseHiddenSetter = true
			end
		end
	end

	return success == true
end

function state.antiLagOptimize(object)
	local controller = state.antiLagController
	if not controller or not controller.Active or not object then
		return
	end

	-- Savannah weather may create containers/attachments in CurrentCamera or
	-- Terrain whose children are the actual emitters. Handle both the named
	-- container and every visual descendant without destroying/reparenting it.
	if state.antiLagIsWeatherObject(object) then
		if object:IsA("ParticleEmitter")
			or object:IsA("Trail")
			or object:IsA("Beam")
			or object:IsA("Smoke")
			or object:IsA("Fire")
			or object:IsA("Sparkles")
			or object:IsA("Light")
			or object:IsA("Clouds") then

			state.antiLagSetAndSave(object, "Enabled", false)
		elseif object:IsA("Attachment") then
			-- Attachment.Visible is client-side/editor visualization only, but hiding
			-- it is harmless; child emitters are disabled below.
			state.antiLagSetAndSave(object, "Visible", false)
		elseif object:IsA("BasePart") then
			-- Some rain systems use an invisible/near-camera carrier part. Hide the
			-- carrier visually without touching CanCollide/CanQuery/Transparency.
			state.antiLagSetAndSave(object, "LocalTransparencyModifier", 1)
			state.antiLagSetAndSave(object, "CastShadow", false)
		end

		for _, descendant in ipairs(object:GetDescendants()) do
			if descendant:IsA("ParticleEmitter")
				or descendant:IsA("Trail")
				or descendant:IsA("Beam")
				or descendant:IsA("Smoke")
				or descendant:IsA("Fire")
				or descendant:IsA("Sparkles")
				or descendant:IsA("Light")
				or descendant:IsA("Clouds") then

				state.antiLagSetAndSave(descendant, "Enabled", false)
			elseif descendant:IsA("Attachment")
				and state.antiLagIsWeatherObject(descendant) then

				state.antiLagSetAndSave(descendant, "Visible", false)
			end
		end
	end

	-- Do NOT disable Highlight. The Hub/ESP may intentionally create one.
	if object:IsA("PostEffect")
		or object:IsA("Light")
		or controller.DisabledClasses[object.ClassName] then

		state.antiLagSetAndSave(object, "Enabled", false)
		if object:IsA("ParticleEmitter") then
			pcall(function() object:Clear() end)
		end
		return
	end

	if object:IsA("Atmosphere") then
		state.antiLagSetAndSave(object, "Density", 0)
		state.antiLagSetAndSave(object, "Haze", 0)
		state.antiLagSetAndSave(object, "Glare", 0)
		return
	end

	if object:IsA("Sky") then
		state.antiLagSetAndSave(object, "CelestialBodiesShown", false)
		state.antiLagSetAndSave(object, "StarCount", 0)
		return
	end

	if object:IsA("Terrain") then
		-- Visual Terrain settings only. Material/water geometry stays intact.
		state.antiLagSetAndSave(object, "Decoration", false)
		state.antiLagSetAndSave(object, "WaterWaveSize", 0)
		state.antiLagSetAndSave(object, "WaterWaveSpeed", 0)
		state.antiLagSetAndSave(object, "WaterReflectance", 0)
		return
	end

	if object:IsA("BasePart") then
		state.antiLagSetAndSave(object, "CastShadow", false)

		if object:IsA("MeshPart") or object:IsA("PartOperation") then
			state.antiLagSetAndSave(
				object,
				"RenderFidelity",
				Enum.RenderFidelity.Performance
			)
		end
	end
end

-- Hard weather blocker for Savannah Life. The game modules themselves can
-- recreate/re-emit rain after Enabled=false, so disable at the source and keep
-- Clouds/Atmosphere pinned while Anti-lag is active. All hooks are reversible.
function state.antiLagWeatherLockProperties(object, targets)
	local controller = state.antiLagController
	if not controller or not controller.Active or not object then return end

	local existing = controller.WeatherLockMap[object]
	if existing then
		existing.Apply()
		return
	end

	local record = { Busy = false }
	local function apply()
		if not controller.Active or record.Busy or not object.Parent then return end
		record.Busy = true
		for property, target in pairs(targets) do
			-- Save through the normal reversible property controller first.
			state.antiLagSetAndSave(object, property, target)
			pcall(function()
				if object[property] ~= target then
					object[property] = target
				end
			end)
		end
		record.Busy = false
	end

	record.Apply = apply
	controller.WeatherLockMap[object] = record

	for property in pairs(targets) do
		pcall(function()
			controller.Connections[#controller.Connections + 1] =
				object:GetPropertyChangedSignal(property):Connect(apply)
		end)
	end

	apply()
end

function state.antiLagWeatherLockClouds()
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	local clouds = terrain and terrain:FindFirstChildOfClass("Clouds")
	if clouds then
		state.antiLagWeatherLockProperties(clouds, {
			Enabled = false,
			Cover = 0,
			Density = 0,
		})
	end
end

function state.antiLagWeatherLockAtmosphere()
	local lighting = game:GetService("Lighting")
	local atmosphere = lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		state.antiLagWeatherLockProperties(atmosphere, {
			Density = 0,
			Haze = 0,
			Glare = 0,
		})
	end
end

function state.antiLagWeatherClearParticles()
	local roots = { workspace.CurrentCamera, workspace:FindFirstChildOfClass("Terrain") }
	for _, root in ipairs(roots) do
		if root then
			for _, object in ipairs(root:GetDescendants()) do
				if object:IsA("ParticleEmitter") then
					local name = object.Name:lower()
					if name == "rainstraight"
						or name == "raintopdown"
						or name == "rainsplash"
						or name == "hit"
						or name == "trail"
						or name == "watersplash" then
						state.antiLagSetAndSave(object, "Enabled", false)
						pcall(function() object:Clear() end)
					end
				end
			end
		end
	end
end

function state.antiLagWeatherTryInstall()
	local controller = state.antiLagController
	if not controller or not controller.Active then return false end

	if controller.WeatherModulesHooked
		and controller.WeatherHeavyRain
		and controller.WeatherLightRain then
		return true
	end

	local playerScripts = player:FindFirstChild("PlayerScripts")
	local sharedCore = playerScripts and playerScripts:FindFirstChild("AnimalGameSharedCore")
	local mapScripts = sharedCore and sharedCore:FindFirstChild("MapScripts")
	local rainHandler = mapScripts and mapScripts:FindFirstChild("RainHandler")
	local heavyModule = rainHandler and rainHandler:FindFirstChild("HeavyRain")
	local lightModule = rainHandler and rainHandler:FindFirstChild("LightRain")
	if not heavyModule or not lightModule then return false end

	local okHeavy, HeavyRain = pcall(require, heavyModule)
	local okLight, LightRain = pcall(require, lightModule)
	if not okHeavy or not okLight
		or type(HeavyRain) ~= "table"
		or type(LightRain) ~= "table" then
		return false
	end

	controller.WeatherHeavyRain = HeavyRain
	controller.WeatherLightRain = LightRain
	controller.WeatherHeavyEnable = HeavyRain.Enable
	controller.WeatherLightEnable = LightRain.Enable
	controller.WeatherSoundFadeTime = LightRain.SoundFadeTime
	controller.WeatherModulesHooked = true

	pcall(function() LightRain.SoundFadeTime = 0 end)

	-- HeavyRain's normal Enable path owns a RenderStepped loop. Replace it with a
	-- self-disabling stub while Anti-lag is active so that loop cannot be restarted.
	HeavyRain.Enable = function(self)
		pcall(function()
			local target = type(self) == "table" and self or HeavyRain
			target:Disable()
		end)
	end

	-- LightRain's Enable creates Heartbeat Emit loops. Block the entry point too.
	LightRain.Enable = function()
		pcall(function() LightRain.Disable() end)
	end

	pcall(function() HeavyRain:Disable() end)
	pcall(function() LightRain.Disable() end)
	state.antiLagWeatherClearParticles()
	state.antiLagWeatherLockClouds()
	state.antiLagWeatherLockAtmosphere()
	return true
end

function state.antiLagWeatherKeepDisabled()
	local controller = state.antiLagController
	if not controller or not controller.Active then return end

	state.antiLagWeatherTryInstall()

	local HeavyRain = controller.WeatherHeavyRain
	local LightRain = controller.WeatherLightRain
	if HeavyRain then pcall(function() HeavyRain:Disable() end) end
	if LightRain then pcall(function() LightRain.Disable() end) end

	state.antiLagWeatherLockClouds()
	state.antiLagWeatherLockAtmosphere()
end

function state.antiLagWeatherRestore()
	local controller = state.antiLagController
	if not controller then return end

	local HeavyRain = controller.WeatherHeavyRain
	local LightRain = controller.WeatherLightRain
	local heavyEnable = controller.WeatherHeavyEnable
	local lightEnable = controller.WeatherLightEnable
	local soundFadeTime = controller.WeatherSoundFadeTime
	local weather = workspace:GetAttribute("WeatherState")

	if HeavyRain and type(heavyEnable) == "function" then
		HeavyRain.Enable = heavyEnable
	end
	if LightRain and type(lightEnable) == "function" then
		LightRain.Enable = lightEnable
	end
	if LightRain and soundFadeTime ~= nil then
		pcall(function() LightRain.SoundFadeTime = soundFadeTime end)
	end

	controller.WeatherHeavyRain = nil
	controller.WeatherLightRain = nil
	controller.WeatherHeavyEnable = nil
	controller.WeatherLightEnable = nil
	controller.WeatherSoundFadeTime = nil
	controller.WeatherModulesHooked = false
	controller.WeatherLockMap = setmetatable({}, { __mode = "k" })

	-- Re-enter the game's current weather only AFTER our property records are
	-- restored by antiLagDisable(). This deferred function executes next cycle.
	task.defer(function()
		if weather == "Rain" and LightRain and type(lightEnable) == "function" then
			pcall(lightEnable)
		elseif weather == "ThunderStorm"
			and HeavyRain
			and type(heavyEnable) == "function" then
			pcall(function()
				if type(HeavyRain.SetIntensityRatio) == "function" then
					HeavyRain:SetIntensityRatio(1)
				end
				if type(HeavyRain.SetSpeedRatio) == "function" then
					HeavyRain:SetSpeedRatio(1)
				end
				heavyEnable(HeavyRain, TweenInfo.new(0.1))
			end)
		end
	end)
end

function state.antiLagDisable(silent)
	local controller = state.antiLagController
	if not controller then return end

	state.antiLag = false
	controller.Active = false

	for _, connection in ipairs(controller.Connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	controller.Connections = {}

	-- Restore original HeavyRain/LightRain Enable functions. The actual weather
	-- re-entry is deferred until the saved visual properties below are restored.
	state.antiLagWeatherRestore()

	local env = (getgenv and getgenv()) or _G
	local setHidden = env and rawget(env, "sethiddenproperty")

	for index = #controller.Records, 1, -1 do
		local record = controller.Records[index]
		if record and record.Object then
			if record.UseHiddenSetter and type(setHidden) == "function" then
				pcall(
					setHidden,
					record.Object,
					record.Property,
					record.Value
				)
			else
				pcall(function()
					record.Object[record.Property] = record.Value
				end)
			end
		end
	end

	controller.Records = {}
	controller.Saved = setmetatable({}, { __mode = "k" })

	if not silent then
		runtimeMessage = "Anti-lag disabled; original visual settings restored"
	end
end

function state.antiLagEnable(silent)
	local controller = state.antiLagController
	if not controller then return false end
	if controller.Active then
		state.antiLag = true
		return true
	end

	state.antiLag = true
	controller.Active = true
	controller.Records = {}
	controller.Saved = setmetatable({}, { __mode = "k" })
	controller.Connections = {}
	controller.WeatherLockMap = setmetatable({}, { __mode = "k" })

	local lighting = game:GetService("Lighting")
	local workspaceService = game:GetService("Workspace")

	for property, value in pairs(controller.LightingValues) do
		state.antiLagSetAndSave(lighting, property, value)
	end

	controller.Connections[#controller.Connections + 1] =
		workspaceService.DescendantAdded:Connect(function(object)
			if controller.Active then
				state.antiLagOptimize(object)
			end
		end)

	-- Weather scripts can replace CurrentCamera and immediately rebuild
	-- __RainEmitter before the next regular descendant event. Rescan that camera
	-- whenever Roblox swaps it so rain cannot come back while Anti-lag is ON.
	controller.Connections[#controller.Connections + 1] =
		workspaceService:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
			if not controller.Active then return end
			local camera = workspaceService.CurrentCamera
			if not camera then return end
			state.antiLagOptimize(camera)
			for _, object in ipairs(camera:GetDescendants()) do
				state.antiLagOptimize(object)
			end
		end)

	controller.Connections[#controller.Connections + 1] =
		lighting.DescendantAdded:Connect(function(object)
			if controller.Active then
				state.antiLagOptimize(object)
			end
		end)

	-- Block the actual Savannah weather modules in addition to visual properties.
	-- If PlayerScripts is still replicating, the lightweight heartbeat below retries.
	state.antiLagWeatherTryInstall()
	state.antiLagWeatherLockClouds()
	state.antiLagWeatherLockAtmosphere()

	local terrain = workspaceService:FindFirstChildOfClass("Terrain")
	if terrain then
		controller.Connections[#controller.Connections + 1] =
			terrain.ChildAdded:Connect(function(object)
				if not controller.Active then return end
				if object:IsA("Clouds") then
					task.defer(state.antiLagWeatherLockClouds)
				end
			end)
	end

	controller.Connections[#controller.Connections + 1] =
		lighting.ChildAdded:Connect(function(object)
			if controller.Active and object:IsA("Atmosphere") then
				task.defer(state.antiLagWeatherLockAtmosphere)
			end
		end)

	local weatherElapsed = 0
	controller.Connections[#controller.Connections + 1] =
		game:GetService("RunService").Heartbeat:Connect(function(delta)
			if not controller.Active then return end
			weatherElapsed += delta
			if weatherElapsed >= 0.5 then
				weatherElapsed = 0
				state.antiLagWeatherKeepDisabled()
			end
		end)

	-- Keep only the explicitly selected Lighting values pinned. This does not
	-- touch time-of-day, clock, fog distances or gameplay state.
	controller.Connections[#controller.Connections + 1] =
		lighting.Changed:Connect(function(property)
			if not controller.Active then return end
			local value = controller.LightingValues[property]
			if value ~= nil then
				local ok, current = pcall(function()
					return lighting[property]
				end)
				if not ok or current ~= value then
					state.antiLagSetAndSave(lighting, property, value)
				end
			end
		end)

	pcall(function()
		local gameSettings =
			UserSettings():GetService("UserGameSettings")
		state.antiLagSetAndSave(
			gameSettings,
			"SavedQualityLevel",
			Enum.SavedQualitySetting.QualityLevel1
		)
	end)

	pcall(function()
		local rendering = settings():GetService("RenderSettings")
		state.antiLagSetAndSave(
			rendering,
			"QualityLevel",
			Enum.QualityLevel.Level01
		)
		state.antiLagSetAndSave(
			rendering,
			"MeshPartDetailLevel",
			Enum.MeshPartDetailLevel.Level00
		)
	end)

	-- User-confirmed Anti-lag streaming profile. Keep this inside the reversible
	-- controller so disabling Anti-lag restores the exact values that existed
	-- before activation. No manual reset is required.
	pcall(function()
		if workspaceService.StreamingEnabled then
			state.antiLagSetAndSave(
				workspaceService,
				"StreamingMinRadius",
				64
			)
			state.antiLagSetAndSave(
				workspaceService,
				"StreamingTargetRadius",
				128
			)
		end
	end)

	task.spawn(function()
		local roots = { workspaceService, lighting }
		for _, root in ipairs(roots) do
			local descendants = root:GetDescendants()
			for index, object in ipairs(descendants) do
				if not state.alive or not controller.Active then
					return
				end
				state.antiLagOptimize(object)
				if index % 400 == 0 then
					task.wait()
				end
			end
		end
	end)

	if not silent then
		runtimeMessage = "Anti-lag enabled (streaming 64/128; rain/cloud modules blocked)"
	end

	return true
end

-- Restore the saved preference after a Hub reload. Activation is deferred so
-- the main script can finish establishing state before scanning descendants.
if state.antiLag then
	mmbTaskDefer(function()
		if state.alive and state.antiLag then
			state.antiLagEnable(true)
		end
	end)
end

function state.spawnLocationLabel(part)
	if not part then
		return "Unknown location"
	end

	local spawns =
		workspace:FindFirstChild(
			"Spawns"
		)

	local fullName =
		part:GetFullName()

	if spawns then
		local marker =
			spawns:GetFullName()
				.. "."

		fullName =
			fullName:gsub(
				"^"
					.. marker:gsub(
						"([%.%-])",
						"%%%1"
					),
				""
			)
	end

	return fullName
end

function state.resolveResetSpawn()
	if state.selectedResetSpawn
		and state.selectedResetSpawn.Parent then

		return state.selectedResetSpawn
	end

	state.selectedResetSpawn =
		nil

	local wanted =
		state.resetSpawnFullName

	if type(wanted)
		~= "string"
		or wanted == "" then

		return nil
	end

	for _, part in ipairs(
		completionSpawnParts
	) do
		if part
			and part.Parent
			and part:GetFullName()
				== wanted then

			state.selectedResetSpawn =
				part

			return part
		end
	end

	return nil
end

function state.setResetSpawn(part)
	if part
		and part:IsA(
			"BasePart"
		)
		and part.Parent then

		state.selectedResetSpawn =
			part

		state.resetSpawnFullName =
			part:GetFullName()
	else
		state.selectedResetSpawn =
			nil

		state.resetSpawnFullName =
			nil
	end

	if state.MMBAI and type(state.MMBAI.OnUserIntentChanged) == "function" then
		pcall(state.MMBAI.OnUserIntentChanged, state.MMBAI, "resetSpawnFullName", state.resetSpawnFullName)
	end
end

local function refreshCompletionSpawns()
	completionSpawnParts = {}
	local spawns = workspace:FindFirstChild("Spawns")
	if spawns then
		for _, object in ipairs(spawns:GetDescendants()) do
			if object:IsA("BasePart") then table.insert(completionSpawnParts, object) end
		end
	end
	table.sort(completionSpawnParts, function(a, b) return a:GetFullName() < b:GetFullName() end)
	if selectedMoveToSpawn and not selectedMoveToSpawn.Parent then selectedMoveToSpawn = nil end

	if state.selectedResetSpawn
		and not state.selectedResetSpawn.Parent then

		state.selectedResetSpawn =
			nil
	end

	state.resolveResetSpawn()
end
local function findAquaticNestRock()
	-- No Dino Life, AquaticNestRock1/2 ficam na água e servem só de PASSAGEM
	-- pra sair do void — não são o destino final.
	local spawns = workspace:FindFirstChild("Spawns")
	if not spawns then return nil end
	for _, object in ipairs(spawns:GetDescendants()) do
		if object:IsA("BasePart") and (object.Name == "AquaticNestRock1" or object.Name == "AquaticNestRock2") then
			return object
		end
	end
	return nil
end

local function findNestRock1()
	-- Destino final em terra firme de verdade.
	local spawns = workspace:FindFirstChild("Spawns")
	if not spawns then return nil end
	local part = spawns:FindFirstChild("NestRock1", true)
	if part and part:IsA("BasePart") then return part end
	return nil
end

-- CONFIGS não tem entrada pro GameId do Dino Life, então config.farm cai no
-- fallback (coordenadas do Savannah) — completamente inválido nesse mapa.
-- Essa função resolve um ponto seguro de verdade pra movimentos avulsos
-- (não é a rotina de escape do void — essa é a escapeDinoToSafety abaixo).
local function getSafeFarmPosition()
	if isDinoLife then
		local nestRock1 = findNestRock1()
		if nestRock1 then return nestRock1.Position end
		local aquatic = findAquaticNestRock()
		if aquatic then return aquatic.Position end
	end
	return config.farm
end

