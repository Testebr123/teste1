					42
				)

		data.title.TextColor3 =
			crocBlocked and COLOR_SUBTEXT
			or (selected and COLOR_ACCENT or COLOR_TEXT)

		data.radio.Text =
			crocBlocked and "×"
			or (selected and "●" or "○")

		data.radio.TextColor3 =
