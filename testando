shared.__uiRootCleanup = function()
	-- Preserve the user's automation intent for the next execution.
	shared.__mmbHubResume = {
		autoQuests =
			state.autoQuests == true,

		autoClaimQuests =
			state.autoClaimQuests == true,

		autoEat =
			state.autoEat == true,

		autoDrink =
			state.autoDrink == true,

		autoDrinkPreferredMode =
			state.autoDrinkPreferredMode,

		antiLag =
			state.antiLag == true,

		coinFarmAllowAutoQuests =
			state.coinFarmAllowAutoQuests == true,

		growthPrideEnabled =
			state.growthPrideEnabled ~= false,

		growthPrideUserSet =
			state.growthPrideUserSet == true,

		resetSpawnFullName =
			state.resetSpawnFullName,

		deathReports =
			state.slotGuardian
				and state.slotGuardian.deathReports
				or {},

		autoEatManualDisabled = state.autoEatManualDisabled == true,
		autoDrinkManualDisabled = state.autoDrinkManualDisabled == true,
	}

	-- Permanent noon is automatic (no button), but the old execution must release
	-- its RenderStep/Lighting connections before a re-executed Hub creates a new one.
	if state.noonController
		and state.noonController.Active
		and type(state.noonController.Disable) == "function" then
		pcall(state.noonController.Disable, state.noonController)
	end

	-- The resume snapshot above remembers whether Anti-lag was ON, but this old
	-- execution must restore every property before its UI/state is destroyed.
	if state.antiLagController and state.antiLagController.Active then
		pcall(state.antiLagDisable, true)
	end

	state.alive = false

	-- Stop any SafeMove immediately. In-flight quest-slot tasks also check
	-- state.alive before every Reset/Create/Spawn stage.
	if state.safeMove then
		state.safeMove.cancelToken += 1
	end

	state.questSlots.busy = false
	questSwitchingAnimal = false

	local cleanupCharacter =
		player.Character

	if cleanupCharacter then
		pcall(state.heavyWalkStop, cleanupCharacter)
		pcall(state.releaseMovementNow, cleanupCharacter, true)
		pcall(state.questSlotsNormalizeControl, cleanupCharacter)
	end

	local cleanupWater = workspace:FindFirstChild("MainWaterPart")
	if state.drinkTest
		and state.drinkTest.collisionSnapshot
		and state.drinkTest.character
		and state.drinkTest.character.Parent then

		local cleanupHumanoid =
			state.drinkTest.character:
				FindFirstChildOfClass(
					"Humanoid"
				)

		if cleanupHumanoid then
			pcall(
				state.drinkTestSetTransitPhysics,
				state.drinkTest.character,
				cleanupHumanoid,
				false
			)
		end

		pcall(
			state.drinkTestGhostCharacter,
			state.drinkTest.character,
			false
		)
	end

	if cleanupWater and cleanupWater:IsA("BasePart") then
		cleanupWater.CanCollide = false
	end
	state.questMotionMoving = false
	state.questMotionMode = nil
	state.questSetW(false)
	if state.questSetLandPermanentW then
		state.questSetLandPermanentW(false)
	end
	removeSwimBarrier()
	if DAMAGE.connection then DAMAGE.connection:Disconnect(); DAMAGE.connection = nil end
	for _, connection in ipairs(connections) do connection:Disconnect() end
	gui:Destroy()
	shared.__uiRootCleanup = nil
end
mmbTaskDefer(function()
	task.wait(0.20)

	if not state.alive then
		return
	end

	-- Startup must be movement-neutral. A previous/reloaded executor session can
	-- leave synthetic W logically held even when this fresh Hub has NO option ON.
	-- Release only the Hub's synthetic forward-input layer once; manual movement
	-- remains untouched afterwards.
	if state.questReleaseLandPermanentW then
		pcall(state.questReleaseLandPermanentW)
	end
	pcall(function()
		local env = (getgenv and getgenv()) or _G
		local release = env and env.keyrelease
		if type(release) == "function" then
			release(0x57)
		end
	end)
	pcall(function()
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
	end)
	state.questLandKeyDown = false

	-- A dead SafeMove/heavyWalk thread can also leave Humanoid:MoveTo targeting an
	-- old world position even after W is released. Cancel that target ONCE at
	-- startup; this is not a loop and does not fight normal player input later.
	pcall(function()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if humanoid and root then
			humanoid:MoveTo(root.Position)
			humanoid:Move(Vector3.zero, false)
		end
	end)

	state.questSlotsNormalizeControl(
		player.Character
	)

	if state.autoQuests then
		state.applySurvivalDefaults(false)
		state.questSeenAny = false
		state.questEmptyScans = 0
		state.questForceFastRecheckUntil =
			tick() + 25

		questStatusText =
			"Auto Quests resumed after script reload"

		runtimeMessage =
			"Auto Quests restored; rescanning Daily + Weekly"
	end

	if renders then
		for _, key in ipairs({
			"autoQuests",
			"autoClaimQuests",
			"autoEat",
			"autoDrink",
		}) do
			if renders[key] then
				pcall(renders[key])
			end
		end
	end
end)

