			and namedSpawn.Position
			or (
				selectedMoveToSpawn
				and selectedMoveToSpawn.Parent
				and selectedMoveToSpawn.Position
			)
			or getSafeFarmPosition()

	local label =
		namedSpawn
			and spawnName
			or "slot switch point"

	return target, label
end

function state.atSlotSwitchPoint()
	local character, root =
		characterParts()

	if not character or not root then
		return false
	end

	local target =
		state.slotSwitchTarget()

	if typeof(target) ~= "Vector3" then
		return false
	end

	local flatDistance =
		Vector3.new(
			root.Position.X - target.X,
			0,
			root.Position.Z - target.Z
		).Magnitude

	if flatDistance > 28 then
		return false
	end

	return state.normalizeDryLandState(
		character,
		root
	)
end

function state.moveBeforeSlotChange()
	-- Slot staging is NOT the same job as generic dry-ground recovery.
	-- ensureOnSolidGround() intentionally stops as soon as dry Terrain is found,
	-- which can report success while the animal is still hundreds of studs away
	-- from the actual slot-switch point. For slot changes the destination itself
	-- is authoritative: reach it, then confirm dry/safe ground there.
	local target, label =
		state.slotSwitchTarget()

	if typeof(target) ~= "Vector3" then
		runtimeMessage = "Slot staging failed: invalid switch target"
		return false
	end

	criticalRecoveryActive = true
	local staged = false

	for attempt = 1, 3 do
		local character, root = characterParts()
		if not character or not root then
			break
		end

		-- Kill any stale Food/Water/Zone/Run MoveTo before staging. This does not
		-- disable the user's survival toggles; it only releases current movement.
		state.releaseMovementNow(character, true)
		blockClientSubState = false

		if state.atSlotSwitchPoint() then
			staged = true
			break
		end

		local inVoid = root.Position.Y < config.dangerY
		local buried =
			not isDinoLife
			and state.drinkIsBuriedUnderTerrain(root)

		runtimeMessage = string.format(
			"Slot staging: moving to %s (%d/3)",
			tostring(label or "switch point"),
			attempt
		)

		local moved = safeMoveToPosition(
			target,
			7,
			nil,
			{
				purpose = "safety",
				tolerance = 18,

				-- Only void/buried recovery is allowed to use vertical transit.
				vertical = inVoid or buried,

				-- IMPORTANT: never stop merely because dry Terrain is underneath us.
				-- Slot staging must reach the actual switch point.
				stopOnDryGround = false,
				constantSpeed = true,
				forceMoveToLand = not (inVoid or buried),
				allowDuringGrowthReset = true,
				maxDuration = 240,
			}
		)

		task.wait(0.20)

		-- Never trust the movement return value by itself. The slot switch point
		-- plus dry-ground validation is the final proof.
		if state.atSlotSwitchPoint() then
			staged = true
			break
		end

		if not moved then
			task.wait(0.20)
		end
	end

	if not forcingPostDrinkMove then
		criticalRecoveryActive = false
	end

	if staged then
		runtimeMessage = "Slot staging confirmed at " .. tostring(label or "switch point")
	else
		local _, root = characterParts()
		local distanceText = "unknown"
		if root then
			local flatDistance = Vector3.new(
				root.Position.X - target.X,
				0,
				root.Position.Z - target.Z
			).Magnitude
			distanceText = string.format("%.1f", flatDistance)
		end

		runtimeMessage = "Slot staging failed after 3 routes; distance=" .. distanceText
	end

	return staged
end

function state.prepareCurrentSlotForSwitch(reason)
	local character, root =
		characterParts()

	if not character or not root then
		return false
	end

	state.releaseMovementNow(character, true)
	blockClientSubState = false

	if state.atSlotSwitchPoint() then
		return true
	end

	runtimeMessage = reason
		or "Staging current animal before slot switch"

	local moved = state.moveBeforeSlotChange()
	return moved == true and state.atSlotSwitchPoint()
end

local function growthStep()
	if state.questGrowthReset.exclusive then return end
	if state.farmCoins
		or growthBusy
		or state.busy
		or not (
			state.growExisting
			or state.growAllSlots
			or state.growNew
		) then
		return
	end
	-- Se uma rotina crítica (saída de água/void) estiver no controle do
	-- personagem, o growthStep NÃO pode religar autoEat/autoDrink nem fazer
	-- nada — senão as duas rotinas brigam pra mover o personagem pra
	-- lugares diferentes ao mesmo tempo (isso já matou um Rex no Dino Life).
	if criticalRecoveryActive then return end
	state.applySurvivalDefaults(
		false
	)
	if renders then
		if renders.autoEat then renders.autoEat() end
		if renders.autoDrink then renders.autoDrink() end
	end
	local character = player.Character
	if not character then return end

	local growthRoot =
		character:FindFirstChild("HumanoidRootPart")

	if growthRoot
		and state.growthPrideRestrictionActive(
			character
		)
		and not state.growthPrideInside(
			character,
			growthRoot
		) then

		local growthWater =
			tonumber(
				character:GetAttribute("Water")
			) or 100

		if not drinkingToFull
			and not forcingPostDrinkMove
			and not criticalRecoveryActive
			and growthWater > 75 then

			state.growthPride.returnRequested = true
			runtimeMessage =
				"Growth herbivore: Pride Rock required before slot handling"
			return
		end
	end

	local growth = character:GetAttribute("GrowthPercentage")
	if type(growth) ~= "number" or not isGrowthComplete(growth) then return end

	-- v106 slot-switch rule:
	-- Carnivores only need Food + Water ABOVE 50%.
	-- Herbivores/other animals only need Food + Water ABOVE 60%.
	-- No more waiting for ~100% before changing slots.
	local food =
		tonumber(
			character:GetAttribute("Food")
		) or 100

	local water =
		tonumber(
			character:GetAttribute("Water")
		) or 100

	local slotSafeThreshold =
		isCarnivoreCharacter(character)
			and 50
			or 60

	-- "Above" means 51/61 is the first accepted integer target.
	local slotSafeTarget =
		slotSafeThreshold + 1

	local foodSafe =
		food > slotSafeThreshold

	local waterSafe =
		water > slotSafeThreshold

	if not foodSafe then
		state.growthTopUp.active = true
		state.growthTopUp.startedAt =
			state.growthTopUp.startedAt
			or tick()

		preSwitchFoodTarget =
			slotSafeTarget

		preSwitchWaterTarget = nil

		-- Food remains first so drinking cannot interrupt a feeding attempt.
		drinkingToFull = false

		runtimeMessage =
			string.format(
				"Slot switch safety: Food %d%% -> >%d%%",
				math.floor(food),
				slotSafeThreshold
			)

		return

	elseif not waterSafe then
		state.growthTopUp.active = true
		state.growthTopUp.startedAt =
			state.growthTopUp.startedAt
			or tick()

		preSwitchFoodTarget = nil
		preSwitchWaterTarget =
			slotSafeTarget

		drinkingToFull = true

		runtimeMessage =
			string.format(
				"Slot switch safety: Water %d%% -> >%d%%",
				math.floor(water),
				slotSafeThreshold
			)

		return

	else
		preSwitchFoodTarget = nil
		preSwitchWaterTarget = nil

		state.growthTopUp.active = false
		state.growthTopUp.startedAt = nil
	end

	local completedName = character:GetAttribute("CharacterName")
	local completedAnimal = character:GetAttribute("AnimalName")
	local previousEntry
	for _, candidate in ipairs(savedCharacters()) do
		if candidate.CharacterName == completedName then
			previousEntry = candidate
			break
		end
	end
	if type(completedName) == "string" and completedName ~= "" then
		sessionCompletedSlots[completedName] = true
	end
	growthBusy = true
	state.growthTopUp.active = false
	state.growthTopUp.startedAt = nil
	preSwitchFoodTarget = nil
	preSwitchWaterTarget = nil

	-- 1+2+3: para de comer/beber e move pro PrideRockSpawn1 ANTES de
	-- qualquer troca de slot, seja crescendo existentes ou criando novos.
	-- Se não conseguir CONFIRMAR terra firme (sem void, sem água), aborta
	-- essa tentativa e deixa o próximo ciclo do growthStep tentar de novo
	-- — nunca troca de slot estando dentro do void ou da água.
	local landedSafely =
		state.moveBeforeSlotChange()
	if not landedSafely then
		runtimeMessage = "Não confirmei terra firme; adiando troca de slot"
		state.applySurvivalDefaults(
			false
		)
		if renders then
			if renders.autoEat then renders.autoEat() end
			if renders.autoDrink then renders.autoDrink() end
		end
		growthBusy = false
		return
	end
	task.wait(0.5)

	local entry
	if state.growExisting or state.growAllSlots then
		local automaticAll = state.growExistingAutomaticAll == true
		local manualAll = state.growAllSlots == true
		local allAnimals = automaticAll or manualAll

		if automaticAll then
			runtimeMessage =
				"AUTO Grow Existing: scanning ALL animal species for slots below 100%"
		elseif manualAll then
			runtimeMessage =
				"Grow All Slots: scanning ALL animal species for slots below 100%"
		else
			runtimeMessage =
				"Abrindo lista de " .. tostring(completedAnimal or "animais")
		end

		if ResetRemote then pcall(ResetRemote.InvokeServer, ResetRemote) end
		task.wait(2.5)

		local refreshed = savedCharacters()

		entry = allAnimals
			and nextExistingSlot(nil, refreshed, true)
			or nextExistingSlot(completedAnimal, refreshed, false)
		if not previousEntry then
			for _, candidate in ipairs(refreshed) do
				if candidate.CharacterName == completedName then
					previousEntry = candidate
					break
				end
			end
		end
	end
	if entry then
		if state.growExistingAutomaticAll then
			questStatusText = string.format(
				"AUTO Grow All: %s · %s%%",
				tostring(entry.AnimalName or "Animal"),
				tostring(entry.GrowthPercentage or "?")
			)
			runtimeMessage =
				"Automatic Grow Existing switched species to continue every saved slot below 100%"

		elseif state.growAllSlots then
			questStatusText = string.format(
				"Grow All Slots: %s · %s%%",
				tostring(entry.AnimalName or "Animal"),
				tostring(entry.GrowthPercentage or "?")
			)
			runtimeMessage =
				"Grow All Slots switched species to continue every saved slot below 100%"
		end

		spawnSlot(entry, true)

	elseif state.growNew then
		local totalSlots = #savedCharacters()
		if totalSlots >= state.growthTopUp.maxSlots then
			runtimeMessage = "Limite de " .. state.growthTopUp.maxSlots .. " slots atingido; ativando Farm Coins"
			state.growExisting, state.growNew = false, false
			state.growExistingAutomaticAll = false
			state.growAllSlots = false
			state.farmCoins = true
			if previousEntry then spawnSlot(previousEntry, true) end
		else
			runtimeMessage = "Criando novo slot"
			createNextSlot()
		end
	elseif state.growExisting or state.growAllSlots then
		if state.growExistingAutomaticAll then
			runtimeMessage =
				"AUTO Grow Existing complete: ALL animal slots are 100%; activating AFK Coin Farm"
			questStatusText =
				"AUTO Grow All complete -> AFK Coin Farm"
			state.growExistingAutomaticAll = false
			state.questPostGrowAll = false

		elseif state.growAllSlots then
			runtimeMessage =
				"Grow All Slots complete: ALL animal slots are 100%; activating AFK Coin Farm"
			questStatusText =
				"Grow All Slots complete -> AFK Coin Farm"

		elseif state.questPostGrowAll then
			runtimeMessage =
				"Todos os slots existentes estão 100%; ativando Farm Coins"
			state.questPostGrowAll = false

		else
			runtimeMessage =
				"Sem " .. tostring(completedAnimal or "animal")
				.. " incompleto; ativando Farm Coins"
		end

		if previousEntry then
			spawnSlot(previousEntry, true)
		end

		state.growExisting = false
		state.growAllSlots = false
		state.growNew = false
		state.growExistingAutomaticAll = false
		state.farmCoins = true
	end
	state.applySurvivalDefaults(
		false
	)
	if renders then
		for _, key in ipairs({
			"growExisting", "growAllSlots", "growNew",
			"farmCoins", "autoEat", "autoDrink"
		}) do
			if renders[key] then renders[key]() end
		end
	end
	growthBusy = false
end

